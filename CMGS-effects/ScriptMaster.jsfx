options:maxmem=33554432
// Declare a name for the shared memory
options:gmem=GM_SHM
options:gfx_idle
options:gfx_hz = 30
options:want_all_kb
options:no_meter


import CMGS-libs/mSL_Constants.jsfx-inc
import CMGS-libs/mSL_StM_Memory.jsfx-inc
import CMGS-libs/mSL_string_list_10000.jsfx-inc
import CMGS-libs/mSL_string_list_2000W.jsfx-inc
import CMGS-libs/mSL_string_list_2000X.jsfx-inc
import CMGS-libs/mSL_Strings.jsfx-inc
import CMGS-libs/ui-lib.jsfx-inc
import CMGS-libs/mSL_ui_LibJJ.jsfx-inc
import CMGS-libs/mSL_ui_Menus.jsfx-inc
import CMGS-libs/mSL_ui_Pads.jsfx-inc
import CMGS-libs/mSL_Scheduler.jsfx-inc
import CMGS-libs/mSL_gmem_map.jsfx-inc
import CMGS-libs/mSL_clip_lib.jsfx-inc
import CMGS-libs/ui-lib-JJ-GUI.jsfx-inc
import CMGS-libs/clip_lib_MIDI.jsfx-inc
import CMGS-libs/mSL_Utilities.jsfx-inc
import CMGS-libs/mSL_Dyn_Memory.jsfx-inc
import CMGS-libs/mSL_Utilities2.jsfx-inc
import CMGS-libs/mSL_FR_Vars_Access.jsfx-inc
import CMGS-libs/mSL_Comp_lib.jsfx-inc
import CMGS-libs/mSL_DeAsm.jsfx-inc

import CMGS-libs/ScriptMaster_Utilities.jsfx-inc
import CMGS-libs/ScriptMaster.jsfx-inc

// the theme images are loaded from REAPER/Data/CMGS-data/themes (uix_jtheme_load, ui-lib-JJ-GUI)

@init

ext_nodenorm = 1;
ext_noinit = 1;
gfx_ext_retina = 1;

