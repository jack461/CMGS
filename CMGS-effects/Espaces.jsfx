desc:Espaces - 128 Channels - v4.0 - 2026
// JJG
// (2026-11-25) Espaces : the new name of Diffusion-3. Diffusion-3.jsfx stays, a shell identical to this one but for
// its desc line, so that the projects made with Diffusion-3 still open (REAPER finds a plugin by its file) :
// any change here must be made in Diffusion-3.jsfx too.

<?
    // Define some constants
    PRJ_CNT = 16; // projector count (projucnt ; at most akousmax = 24, the projectors created)
    INP_CNT = 128;
    OUT_CNT = 128;
    NB_GSL = 64; // generic sliders (automatable) : Ctl 1 ... NB_GSL (2026-11-20 : they drive nothing yet)
    GSL_FIRST = 1; // the number of the first generic slider (the only sliders of Espaces : Ctl n = slider n)

    no_init = 0;
?>
//°°°  SLIDERS
// (2026-11-20 : the native sliders of the projector and global settings are gone : the modules "Global",
// "Projector A" ... "H" and "Projectors" set them, the module "Global" saves the global ones with the project)
// the generic sliders, automatable (hidden : key 'S' shows them in the panel of REAPER) ; they drive nothing yet
<? i = 0; loop(NB_GSL, printf("slider%d:slCtl%d=0<-1,1,0.001>-Ctl %d\n", GSL_FIRST + i, i+1, i+1); i += 1;); ?>


// the theme images are loaded from REAPER/Data/CMGS-data/themes (uix_jtheme_load, ui-lib-JJ-GUI)


//  Mem. size : 65536 * 64 * 12
options:maxmem=50331648
options:gmem=GM_SHM
options:gfx_idle
options:gfx_hz=30
options:want_all_kb
options:no_meter

@init

<? no_init = 1; ?>
ext_noinit = 1;
ext_midi_bus = 1;


<? include("CMGS-libs/Espaces.jsfx-inc"); ?>

