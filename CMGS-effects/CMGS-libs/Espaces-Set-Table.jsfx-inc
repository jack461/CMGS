                (ed_Tb_Peek() === ed_tkOff) ? ( ed_Tb_Next(); mst_Set(s, f, i, 0); ) :
                (ed_Tb_Peek() === crv_kCurve) ? ( ed_Tb_Next(); ((k = mst_Curve(#mst_kw)) >= 0) ? mst_Set(s, f, i, k + 1); );
                while ((ed_tberr === 0) && (((w = ed_Tb_Peek()) === mst_kCycle) || (w === mst_kDepth))) (
                    ed_Tb_Next();
