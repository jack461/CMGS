        t = -2; // (place, flip : -2 nothing named, -1 the path, 0 ... 3 the trajectory A ... D)
        while ((ed_tberr === 0) && ((w = ed_Tb_Peek()) !== ed_tbEnd) && mst_IsKey(w)) (
