                    ed_Tb_Err(2446, #ed_tbw);
                ) : (
                    p = s + ms_eCf + 4 * n;
                    p[0] = floor(ed_Tb_NumC("zone (configuration)", 1, conflsize - 1, 2443));
                    p[1] = ed_Tb_NumC("zone x", 0, 1, 2443);
                    p[2] = ed_Tb_NumC("zone y", 0, 1, 2443);
                    p[3] = ed_Tb_IsNum(ed_Tb_Peek()) ? ed_Tb_NumC("zone (weight)", 0.1, 10, 2443) : 1;
                    s[ms_eN] = n + 1; f[MS_NS + 1] = 1;
                );
            ) :
            ((w === ed_tkA) || (w === ed_tkB) || (w === ed_tkC) || (w === ed_tkD)) ? (
                t = (w === ed_tkA) ? 0 : (w === ed_tkB) ? 1 : (w === ed_tkC) ? 2 : 3;
                ((x = mst_Kind(#mst_kw)) >= 0) ? mst_Set(s, f, ms_sTrK + t, x);
            ) :
            (w === mst_kPath) ? (
                t = -1;
            ) :
            ((w === mst_kPlace) || (w === mst_kFlip)) ? (
                (t < -1) ? (
                    sprintf(#ed_tbw, "%s : A, B, C, D or path is expected before", #mst_kw);
                    ed_Tb_Err(2449, #ed_tbw);
                ) :
                (w === mst_kPlace) ? (
                    i = (t < 0) ? ms_sTx : ms_sPl + 4 * t;
                    mst_Set(s, f, i, ed_Tb_NumC("place (x)", -2, 2, 2443));
                    mst_Set(s, f, i + 1, ed_Tb_NumC("place (y)", -2, 2, 2443));
                    x = ed_Tb_NumC("place (turn)", -360, 360, 2443); x = floor(x + 0.5);
                    mst_Set(s, f, i + 2, x - 360 * floor((x + 180) / 360)); // (-180 ... 180, as the pad)
                    mst_Set(s, f, i + 3, ed_Tb_NumC("place (scale)", 0.1, 10, 2443));
                ) : (
                    // the bits of this flip in ms_sFlip (see ms_FlipBit), merged : f[ms_sFlip] the bits given
                    x = mst_Enum("flip", "None|X|Y|XY", 4);
                    (x >= 0) ? (
                        bx = 2 ^ ((t < 0) ? 0 : 2 + 2 * t);
                        s[ms_eSet + ms_sFlip] = (s[ms_eSet + ms_sFlip] & (-1 ~ (3 * bx))) | ((x & 1) ? bx : 0) | ((x & 2) ? 2 * bx : 0);
                        f[ms_sFlip] |= 3 * bx;
