);

// The analysis of "settings" and "D3_config" : the words tbl[0 ... itc-1] (a data block, or the arguments) ; returns 0,
// or the first error
function d3_Settings(tbl, itc)
local (state, un, rstate, c, i, pcnf, pt, px, ip, sum, sz, cglvol, ptaddr, sign, trx, xErr, currgrpv, padcnt, cfnumb, ptend, ptgrp, curgrp, grpcnt, lstcnf, auxwork, ptpro, addprx)
(
    // the blocks Edit : nothing read yet ; a file dropped on a module Edit : its first block goes there
    ed_tberr = 0; ed_tbmask = 0;
    d3_errLogged = 0; // (an error already written in the log : a block Edit, hppos 2426)
    ed_tbdrop = ((ed_mslTgt >= 0) && (time_precise() - ed_mslT < 10)) ? ed_mslTgt : -1;
    ed_mslTgt = -1;
    // (2026-11-24) the blocks Curve (mSL_Curves) and MetaSurface : nothing read yet ; a file dropped on a module Curves or
    // MetaSurface : its first block goes into the curve or the entry it shows
    crv_TbReset(); crv_tbError = 0; strcpy(#crv_tbHost, "Espaces settings");
    crv_tbDrop = ((crv_mslTgt >= 0) && (time_precise() - ed_mslT < 10)) ? crv_mslTgt : -1;
    mst_drop = ((ms_mslTgt >= 0) && (time_precise() - ed_mslT < 10)) ? ms_mslTgt : -1;
    crv_mslTgt = ms_mslTgt = -1;
    memset(mst_twOn, 0, MS_NLIB);
    xErr = 0;

    (itc > 0) ? (
        state = 1;
        sign = 1;
        ptr = 0;
        xErr=0;
        trx = 0;
        currgrpv = firstgroup;  // consider we are in 1st scene, 1st group
        un = 0;
        while ((state != 0) && (xErr === 0)) (
            (un === 0) ? (
                (ptr >= itc) ? (
                    curcod = -1;
