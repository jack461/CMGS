            ) :
            (w === mst_kGlide) ? (
                mst_Set(s, f, ms_sGlide, ed_Tb_NumC("glide", 1, 300, 2443));
                (ed_Tb_Peek() === ed_tkOn) ? ( ed_Tb_Next(); mst_Set(s, f, ms_sGMode, 1); ) :
                (ed_Tb_Peek() === ed_tkOff) ? ( ed_Tb_Next(); mst_Set(s, f, ms_sGMode, 0); );
            ) :
            (w === mst_kDyn) ? (
                (ed_Tb_Peek() === crv_kCurve) ? (
                    ed_Tb_Next();
                    ((k = mst_Curve("dyn")) >= 0) ? mst_Set(s, f, ms_sCurve, CRV_DYN + k);
                ) : (
                    ((x = mst_Enum("dyn", #mst_Ease, 10)) >= 0) ? mst_Set(s, f, ms_sCurve, x);
                );
                w = ed_Tb_Peek(); k = -1; i = 0; loop(4, (w === mst_kMd[i]) ? (k = i); i += 1;);
                ((ed_tberr === 0) && (k >= 0)) ? ( ed_Tb_Next(); mst_Set(s, f, ms_sDMode, k); );
            ) : (
                // modrot, modspeed, modmix : Off or Curve id, then cycle, depth
                j = (w === mst_kModR) ? 0 : (w === mst_kModS) ? 1 : 2;
