                    px = curcod; un = 0;
                ) :
                ((un === 'idnt') && ((curcod === kxw_closed) || (curcod === kxw_open))) ? (
                    i = (curcod === kxw_closed); un = 0;
                ) :
                ((un === 'char') && (curcod === ':')) ? (
                    un = 0; state = 64;
                ) : (
                    xErr = 2471; // trajectory : a "name", closed, open or ":" is expected
                );
                //===63===//


                );) : ((state<65) ? (


                //===64===//
                // trajectory : the coordinates x, y, z of a point (in [-10, 10] ; at most SP_MAXTRJ points), in sp_trTmp
                (((un === 'intg') || (un === 'numb')) && (curcod >= -10) && (curcod <= 10) && (ip < SP_MAXTRJ * 3)) ? (
                    sp_trTmp[ip] = curcod; ip += 1;
                    un = 0;
                    ((ip % 3) === 0) ? (state = 65);
                ) : (
                    xErr = 2472; // trajectory : a coordinate in [-10, 10] is expected (or more than 1024 points)
                );
                //===64===//


                ) : ((state<66) ? (


                //===65===//
                // trajectory : "," (the next point) or ";" (the end : the trajectory replaces the former one)
                ((un === 'char') && (curcod === ',')) ? (
                    un = 0; state = 64;
                ) :
                ((un === 'char') && (curcod === ';')) ? (
                    memcpy(sp_trP + c * SP_MAXTRJ * 3, sp_trTmp, ip);
                    sp_trN[c] = floor(ip / 3); sp_trC[c] = i;
                    // its name (characters as numbers, see sp_NmSet)
                    pt = sp_trNm + c * SP_NMLEN;
                    sz = (px >= 0) ? min(SP_NMLEN - 1, strlen(px)) : 0;
                    sum = 0; loop(sz, pt[sum] = str_getchar(px, sum, 'cu'); sum += 1;);
                    pt[sz] = 0;
                    sp_libSeq += 1; // (the paths built again : sp_Gfx)
                    un = 0; state = 1;
                ) : (
                    xErr = 2473; // trajectory : "," or ";" expected after a point
                );
                //===65===//


                ) : (


                (state<67) ? (


                //===66===//
                // hppos frame (2026-11-18) : a b (the cube of the coordinates, a < b, the same for the 3 axes : 0 1, -1 1,
                // -5 5 ...), or Metres (or Meters : the coordinates in metres, in [0, X] x [0, Y] x [0, Z] : the size)
                ((un === 'intg') || (un === 'numb')) ? (
                    hp_GeoT[1] = curcod;
                    un = 0; state = 68;
                ) :
                ((un === 'idnt') && ((curcod === kxw_Metres) || (curcod === kxw_Meters))) ? (
                    hp_GeoT[0] = 2; hp_GeoT[7] |= 1;
                    un = 0; state = 54;
                ) : (
                    xErr = 2423; // hppos frame : "a b" (a < b) or Metres expected
                );
                //===66===//


                ) : (state<68) ? (


                //===67===//
                // hppos size : X Y Z (the real dimensions of the cube, in metres : its homothety ; each > 0)
                (((un === 'intg') || (un === 'numb')) && (curcod > 0)) ? (
                    hp_GeoT[3 + ip] = curcod; ip += 1;
                    un = 0;
                    (ip >= 3) ? (hp_GeoT[7] |= 2; state = 54;);
                ) : (
                    xErr = 2424; // hppos size : three numbers X Y Z, > 0, expected
                );
                //===67===//


                ) : (state<69) ? (


                //===68===//
                // hppos frame : b (> a)
                (((un === 'intg') || (un === 'numb')) && (curcod > hp_GeoT[1])) ? (
                    hp_GeoT[0] = 1; hp_GeoT[2] = curcod; hp_GeoT[7] |= 1;
                    un = 0; state = 54;
                ) : (
                    xErr = 2423; // hppos frame : "a b" (a < b) or Metres expected
                );
                //===68===//


                ) : (


                //===69===//
                // (2026-11-19 : was 69) no state : 98 an unknown keyword, 97 an unexpected character, else internal
                xErr = (state === 98) ? 0298 : (state === 97) ? 0297 : 0269;
                //===69===//


                );


                );););


            );););););););



        );

        (xErr) ? (
            trx ? (
                sprintf(#s, "State %d - %d/%d - Input: %s Type: %s", state, ptr, itc, mSL_edit_value(#u, curcod),
                    mSL_edit_value(#u2, mSL_v_type));
                mSL_log(SysLogBox, #s);
            );
            // (2026-11-19) the error in the log, as in Interstys : its code, the word, its explanation (not twice : a
            // block Edit, hppos 2426 wrote it) ; the word noted for "? n" (mSL Console)
            !d3_errLogged ? (
                (un === 'feof') ? (strcpy(#d3_sew, "(the end)"); c = itc + 1;) : (
                    (un === 'char') ? sprintf(#d3_sew, "%c", curcod) :
                    (curcod === d3_kwInterstys) ? strcpy(#d3_sew, "Interstys") : mSL_edit_value(#d3_sew, curcod);
                    c = ptr;
                );
                ((xErr === 0298) && (curcod === d3_kwInterstys)) ? (
                    sprintf(#s, "ERR: %04d    Espaces settings (word %d) : Interstys : settings of Interstys, not of Espaces",
                        xErr, c);
                ) : (
                    sprintf(#s, "ERR: %04d    Espaces settings (word %d) : %s : %s", xErr, c, #d3_sew, d3_StErrMsg(xErr));
                );
                mSL_log(SysLogBox, #s);
                sprintf(#s, "word %d : %s", c, #d3_sew);
                mSL_ErrNote(xErr, #s);
            );
        );



    );
    // the blocks Edit read without error (and the configuration too) : staged for the editors ; (2026-11-24) the curves set,
    // the MetaSurfaces staged (ms_Frame) ; an error : nothing of them
    ((xErr === 0) && (ed_tberr === 0) && (crv_tbError === 0)) ? (
        ed_Tb_Stage();
        crv_TbCommit();
        mst_Stage();
    ) : (
        crv_TbReset();
    );
    xErr; // 0, or the first error (an error of a block Edit too)
);


// The mSL "settings" (opcode 118, see the evaluator ; until 2026-11-18 "table", still a synonym) : a data block, or the
// words given as arguments (mSL_stArgs, its word -1 : their count) ; returns 0, or the first error
function Set_Table(tbl)
(
    // (2026-11-21) a block GUI of its own : the rubric GUI (mSL_GUI) ; otherwise the settings of Espaces, where a part
    // GUI may be in any place (d3_Settings, state 1)
    // (2026-11-22 : GUI first and a word that is not a block of Espaces after its keys : a key misspelled, error 1640)
    jg_Own(tbl, jg_Only(tbl) || !d3_IsKeyword(jg_stopw)) ? jg_Settings(tbl) : d3_Settings(tbl, tbl[-1]);
);

// "D3_config" (opcode 138 : the former name of the configuration) : the same analysis ; the evaluator gives a data block
// (argc : its count), or the arguments themselves (argv : on the stack, copied into mSL_stArgs as for "settings")
function mSL_138(argc, argv)
(
    mSL_bl_check(argv) ? d3_Settings(argv, argv[-1]) :
    ((argc >= 1) && (argc <= mSL_stArgsMax) && (mSL_stArgs > 0)) ? (
        mSL_stArgs[0] = argc;
        memcpy(mSL_stArgs + 1, argv, argc);
        d3_Settings(mSL_stArgs + 1, argc);
    ) : (
        sprintf(#s, "D3_config : argc=%d, argv=%d", argc, argv);
        mSL_log(SysLogBox, #s);
        mSL_errX = 2438;
    );
);
