
/*
    Espaces Configuration Analysis

    The mSL "settings" (opcode 118 ; until 2026-11-18 "table", still a synonym) and "D3_config" (opcode 138, the former
    name of the configuration) : one analysis, d3_Settings (2026-11-18 : before, "table" read only the blocks Edit, and
    "D3_config" only the configuration), of a data block or of the words given as arguments (settings(`conf, 16, `:, 1,
    `>, 1) ; see the evaluator, mSL_stArgs) : the keywords of the configuration (clear, conf, set, prop, pload, actions,
    scene, group, hppos, source, trajectory, bgcolor ... end) and the blocks "Edit A" ... "Edit D" (ed_Tb_Edit), in any
    order. The configuration is applied as it is read ; the blocks Edit only if everything is read without error.
    (2026-11-24) The blocks "Curve" (the curves of the modules Curves, mSL_Curves : crv_TbCurve) and "MetaSurface" (the
    library of the MetaSurfaces : mst_Meta, below), as the blocks Edit : only if everything is read without error.
*/

@init

/*
    The blocks Edit of "settings" (2026-11-10 ; until 2026-11-18 the only content of "table") : the configurations of
    the modules "Edit A" ... "Edit D" (see Espaces-Edit.jsfx-inc), as written by their export "configuration (mSL
    settings)" :

        settings(data(
            Edit A  name "Etoile"  kind Trajectory  closed On  smooth On  free Off
                point 0.5 0 0  bend 0.1 -0.05 0
                point -0.25 0.5 0
                ...
        ));

    A block Edit X (X : A, B, C, D, or 1 ... 4 ; a file dropped on a module Edit : its first block goes into this
    module), then keys in any order : name "text" ; kind Speakers | Sources | Trajectory ; closed, smooth, free : On |
    Off (or 1 | 0) ; point x y z [bend dx dy dz] (no number : the points are numbered 1, 2, 3 ... in their order,
    ED_MAXP at most ; the coordinates up to ED_FAR ; the bend of the segment from this point to the next one : the
    shift of its middle). The keys absent leave the configuration as it is ; the points, if any, replace all its
    points. The commas and semicolons are ignored. A block ends at the end, at the next Edit, or at a keyword of the
    configuration (d3_IsKeyword). The first error (2486 ... 2491) stops the analysis : no block Edit changes.
    This function comes before the evaluator (that calls it), the editors after it : a table is read in work areas
    (ed_tf2, ed_tpt2, ed_tnm2), then, without error, staged (ed_tq, ed_tf, ed_tpt, ed_tnm : several tables before the
    next frame add up ; all allocated by Espaces-Edit), and ed_Frame takes them in @gfx (kept for Undo). Only
    globals here : no function of the editors.
*/
ed_tbEnd = -(10^30);    // after the last word
ed_tbtbl = ed_tbn = ed_tbptr = ed_tberr = ed_tbmask = 0; // (ed_tbmask : the editors named in the table, 2 ^ e)
d3_errLogged = 0; // (2026-11-19) 1 : the error of the analysis is already in the log (see d3_Settings)
// (2026-11-19) the first word of the settings of Interstys : more than 8 characters, its symbol can not be written back
// (mSL_symbol2) ; recognized for the message of the error 0298
d3_kwInterstys = mSL_symbol("Interstys");
ed_tbdrop = -1;         // the module Edit where a file was dropped (its first block goes there)
ed_mslTgt = -1; ed_mslT = 0; // set by the drop of an mSL file (Espaces, @gfx) : the module Edit under the mouse, the time
ed_tkEdit = mSL_symbol("Edit");
ed_tkName = mSL_symbol("name"); ed_tkKind = mSL_symbol("kind"); ed_tkPoint = mSL_symbol("point"); ed_tkBend = mSL_symbol("bend");
ed_tkClosed = mSL_symbol("closed"); ed_tkSmooth = mSL_symbol("smooth"); ed_tkFree = mSL_symbol("free");
ed_tkOn = mSL_symbol("On"); ed_tkOff = mSL_symbol("Off");
ed_tkSpk = mSL_symbol("Speakers"); ed_tkSrc = mSL_symbol("Sources"); ed_tkTrj = mSL_symbol("Trajectory");
ed_tkA = mSL_symbol("A"); ed_tkB = mSL_symbol("B"); ed_tkC = mSL_symbol("C"); ed_tkD = mSL_symbol("D");

// the first error stops the analysis
function ed_Tb_Err(code, msg)
(
    (ed_tberr === 0) ? (
        ed_tberr = code;
        sprintf(#ed_tbm, "ERR: %04d    Espaces settings (word %d) : %s", code, ed_tbptr, msg); // (2026-11-24 : "Espaces", as the others)
        mSL_log(SysLogBox, #ed_tbm);
        mSL_ErrNote(code, msg); // (2026-11-19, for "? n" in the mSL Console)
        d3_errLogged = 1;
    );
    code;
);

// the next word (the commas and semicolons are skipped), ed_tbEnd after the last one
function ed_Tb_Peek() local(w)
(
    w = ed_tbEnd;
    while ((ed_tbptr < ed_tbn) && (((w = ed_tbtbl[ed_tbptr]) === mSL_cstComma) || (w === ';' + mSL_CharConst))) (
        ed_tbptr += 1; w = ed_tbEnd;
    );
    w;
);
function ed_Tb_Next() local(w)
(
    w = ed_Tb_Peek();
    (ed_tbptr < ed_tbn) ? (ed_tbptr += 1);
    w;
);

// a number in [vmin, vmax] (a "-" word before it changes its sign) ; 0 and an error otherwise (code : 2490 for Edit)
function ed_Tb_NumC(key, vmin, vmax, code) local(w, s)
(
    s = 1;
    ((w = ed_Tb_Next()) === mSL_cstMinus) ? ( s = -1; w = ed_Tb_Next(); );
    ((abs(w) < mSL_CharConst) && !mSL_isString(w) && (w * s >= vmin) && (w * s <= vmax)) ? w * s : (
        sprintf(#ed_tbw, "%s : %s is not a value in [%g, %g]", key, (w === ed_tbEnd) ? "the end" : mSL_edit_value(#ed_tbv, w), vmin, vmax);
        ed_Tb_Err(code, #ed_tbw);
        0;
    );
);
function ed_Tb_Num(key, vmin, vmax) ( ed_Tb_NumC(key, vmin, vmax, 2490); );
// (2026-11-24) a number, or the sign of one, is the next word
function ed_Tb_IsNum(w) ( (w === mSL_cstMinus) || ((abs(w) < mSL_CharConst) && !mSL_isString(w)); );

// On | Off, or 1 | 0
function ed_Tb_Bool(key) local(w)
(
    w = ed_Tb_Peek();
    (w === ed_tkOn) ? ( ed_Tb_Next(); 1; ) :
    (w === ed_tkOff) ? ( ed_Tb_Next(); 0; ) :
    (ed_Tb_Num(key, 0, 1) != 0);
);

// a keyword of the configuration (the state 1 of d3_Settings : keep them in step) : it ends a block Edit
function d3_IsKeyword(w)
(
    (w === kxw_conf) || (w === kxw_diff) || (w === kxw_group) || (w === kxw_scene) || (w === kxw_end) ||
    (w === kxw_vol) || (w === kxw_vadj) || (w === kxw_morpht) || (w === kxw_opmod) || (w === kxw_rdelay) ||
    (w === kxw_clear) || (w === kxw_pad) || (w === kxw_defaultconf) || (w === kxw_remove) || (w === kxw_prop) ||
    (w === kxw_pload) || (w === kxw_actions) || (w === kxw_hppos) || (w === kxw_source) || (w === kxw_trajectory) ||
    (w === kxw_bgcolor) || (w === jg_kGUI) || // (2026-11-21 : a part GUI, mSL_GUI)
    (w === crv_kCurve) || (w === mst_kMeta); // (2026-11-24 : the blocks Curve, mSL_Curves, and MetaSurface, below)
);

// A block Edit (its word read) : read in the work area of its editor (ed_tf2, ed_tpt2, ed_tnm2 ; the blocks of the same
// editor in a table add up : their points follow one another) ; returns its editor, or -1
function ed_Tb_Edit() local(w, e, f, pts, p, k)
(
    w = ed_Tb_Next();
    e = (w === ed_tkA) ? 0 : (w === ed_tkB) ? 1 : (w === ed_tkC) ? 2 : (w === ed_tkD) ? 3 :
        ((abs(w) < mSL_CharConst) && !mSL_isString(w) && (w === floor(w)) && (w >= 1) && (w <= ED_NV)) ? w - 1 : -1;
    (e < 0) ? (
        sprintf(#ed_tbw, "Edit %s : A, B, C or D expected", (w === ed_tbEnd) ? "(the end)" : mSL_edit_value(#ed_tbv, w));
        ed_Tb_Err(2486, #ed_tbw);
    ) : (
        // a file dropped on a module Edit : its first block goes there
        (ed_tbdrop >= 0) ? ( e = ed_tbdrop; ed_tbdrop = -1; );
        f = ed_tf2 + e * 8;
        pts = ed_tpt2 + e * ED_MAXP * ED_PS;
        !(ed_tbmask & (2 ^ e)) ? (
            ed_tbmask |= 2 ^ e;
            memset(f, 0, 8); memset(pts, 0, ED_MAXP * ED_PS);
        );
        while ((ed_tberr === 0) && ((w = ed_Tb_Peek()) !== ed_tbEnd) && (w !== ed_tkEdit) && !d3_IsKeyword(w)) (
            ed_Tb_Next();
            (w === ed_tkName) ? (
                w = ed_Tb_Next();
                mSL_isString(w) ? ( strcpy(ed_tnm2[e], w); f[0] |= 1; ) :
                ((w > mSL_Sym_Low) && (w < mSL_Sym_High)) ? ( mSL_edit_value(ed_tnm2[e], w); f[0] |= 1; ) :
                ed_Tb_Err(2487, "name : a \"text\" expected");
            ) :
            (w === ed_tkKind) ? (
                w = ed_Tb_Next();
                k = (w === ed_tkSpk) ? 0 : (w === ed_tkSrc) ? 1 : (w === ed_tkTrj) ? 2 : -1;
                (k < 0) ? (
                    sprintf(#ed_tbw, "kind %s : Speakers, Sources or Trajectory expected", (w === ed_tbEnd) ? "(the end)" : mSL_edit_value(#ed_tbv, w));
                    ed_Tb_Err(2488, #ed_tbw);
                ) : ( f[1] = k; f[0] |= 2; );
            ) :
            (w === ed_tkClosed) ? ( f[2] = ed_Tb_Bool("closed"); f[0] |= 4; ) :
            (w === ed_tkSmooth) ? ( f[3] = ed_Tb_Bool("smooth"); f[0] |= 8; ) :
            (w === ed_tkFree) ? ( f[4] = ed_Tb_Bool("free"); f[0] |= 16; ) :
            (w === ed_tkPoint) ? (
                // the next point (its number : its rank)
                (f[5] >= ED_MAXP) ? (
                    sprintf(#ed_tbw, "Edit %c : more than %d points", 'A' + e, ED_MAXP);
                    ed_Tb_Err(2491, #ed_tbw);
                ) : (
                    p = pts + f[5] * ED_PS;
                    p[0] = ed_Tb_Num("point x", -ED_FAR, ED_FAR);
                    p[1] = ed_Tb_Num("point y", -ED_FAR, ED_FAR);
                    p[2] = ed_Tb_Num("point z", -ED_FAR, ED_FAR);
                    (ed_Tb_Peek() === ed_tkBend) ? (
                        ed_Tb_Next();
                        p[4] = ed_Tb_Num("bend x", -100, 100); p[5] = ed_Tb_Num("bend y", -100, 100); p[6] = ed_Tb_Num("bend z", -100, 100);
                    );
                    f[5] += 1;
                    f[0] |= 32;
                );
            ) : (
                sprintf(#ed_tbw, "%s : a key (name, kind, closed, smooth, free, point), Edit or a keyword expected", mSL_edit_value(#ed_tbv, w));
                ed_Tb_Err(2489, #ed_tbw);
            );
        );
    );
    (ed_tberr === 0) ? e : -1;
);

// the blocks Edit read without error (and the whole analysis too) : staged for the editors (ed_Frame : ed_TbTake), the
// keys given added (several analyses before ed_Frame add up)
function ed_Tb_Stage() local(e, f, g)
(
    e = 0;
    loop(ED_NV,
        (ed_tbmask & (2 ^ e)) ? (
            f = ed_tf2 + e * 8; g = ed_tf + e * 8;
            !ed_tq[e] ? memset(g, 0, 8);
            (f[0] & 1) ? strcpy(ed_tnm[e], ed_tnm2[e]);
            (f[0] & 2) ? (g[1] = f[1]);
            (f[0] & 4) ? (g[2] = f[2]);
            (f[0] & 8) ? (g[3] = f[3]);
            (f[0] & 16) ? (g[4] = f[4]);
            (f[0] & 32) ? (
                g[5] = f[5];
                memcpy(ed_tpt + e * ED_MAXP * ED_PS, ed_tpt2 + e * ED_MAXP * ED_PS, ED_MAXP * ED_PS);
            );
            g[0] |= f[0];
            ed_tq[e] = 1;
        );
        e += 1;
    );
);

/*
    (2026-11-24) The blocks MetaSurface of "settings" : an entry of the library of the MetaSurfaces (MS1 ... MS32, see
    Espaces-MetaSurface), as written by its export :

        MetaSurface 3  name "Nuage"
            zone 12 0.2 0.3 1  zone 15 0.7 0.25 1.5  zone 21 0.5 0.8
            aspect 1.5  surface Rect  band 0.08  proj 1
            spread 0.15  power 0  shape 0  stretch 1  offset 0  rotation 0.25  angle 0
            volume 0  latency 80  rule Fixed  attack 2  release 4
            brush Path  duration 20  mode Loop  speed Path  radius 0.6
            A Circle  place 0 0 0 1  flip None
            B T12  place 0.1 0 45 0.8  flip X
            C Edit B ...  D None ...  path place 0 0 0 1  flip None
            chain AB  mix 0.25  glide 10 Off  dyn Curve "Montee" In
            modrot Off  cycle Path  depth 1  modspeed Curve 5  cycle 8  depth 0.5  modmix Off  cycle Path  depth 1

    MetaSurface n (1 ... 32 ; a file dropped on a view MetaSurface A ... D : its first block goes into the entry this view
    shows), then keys in any order : name "text" ; zone c x y [w] (the configuration c at x, y : 0 ... 1, x to the right, y
    down ; its weight w, 0.1 ... 10, 1 by default ; the zones of the blocks of an entry follow one another, MS_MAXC at most ;
    given, they replace all its configurations) ; the settings of the pad, numbers (mst_TbInit : aspect, band, proj ...) or
    words (surface Rect|Disk, rule Fixed|Distance, brush Mouse|Path, mode Once|Loop|Back|Reverse, speed Path|Points, chain
    AB|ABC|ABCD) ; A ... D the kind of the trajectory : None Circle Square Star Spiral Central, Edit A ... D, T1 ... T128
    (or T 12) ; place x y turn scale, flip None|X|Y|XY (left - right, up - down) : the trajectory named before (A ... D), or
    the whole path (path) ; glide t [On|Off] (the mode Glide) ; dyn Linear|Quad|Cubic|Quartic|Quintic|Exp|Circle|Sine|
    Elastic|Bounce, or Curve id (a curve : its number, or its name, a curve of the application or of a block Curve before),
    then [In|Out|InOut|OutIn] ; modrot, modspeed, modmix : Off or Curve id, then [cycle Path|seconds] [depth d]. The keys
    absent leave the entry as it is. The block ends at the first word that is not one of its keys. The first error (2441,
    2443 ... 2449) stops the analysis. Read in a work area (mst_tw, mst_twF, mst_twOn : the values, the keys given, the
    entries of this analysis), staged without any error in the analysis (mst_ts, mst_tsF ; mst_tq[e] : to take ; several
    analyses before the next frame add up), taken by ms_Frame (ms_TbTake, @gfx). Allocated by Espaces-MetaSurface.
*/
mst_kMeta = mSL_symbol("MetaSurface");
mst_drop = -1; ms_mslTgt = -1; // (the entry where a file was dropped ; set by the drop : that of the view under the mouse)
mst_kZone = mSL_symbol("zone"); mst_kPath = mSL_symbol("path"); mst_kPlace = mSL_symbol("place"); mst_kFlip = mSL_symbol("flip");
mst_kGlide = mSL_symbol("glide"); mst_kDyn = mSL_symbol("dyn"); mst_kCycle = mSL_symbol("cycle"); mst_kDepth = mSL_symbol("depth");
mst_kModR = mSL_symbol("modrot"); mst_kModS = mSL_symbol("modspeed"); mst_kModM = mSL_symbol("modmix");
mst_kPathW = mSL_symbol("Path"); mst_kT = mSL_symbol("T");
mst_kKd = make_array(6);
mst_kKd[0] = mSL_symbol("None"); mst_kKd[1] = mSL_symbol("Circle"); mst_kKd[2] = mSL_symbol("Square");
mst_kKd[3] = mSL_symbol("Star"); mst_kKd[4] = mSL_symbol("Spiral"); mst_kKd[5] = mSL_symbol("Central");
mst_kMd = make_array(4);
mst_kMd[0] = mSL_symbol("In"); mst_kMd[1] = mSL_symbol("Out"); mst_kMd[2] = mSL_symbol("InOut"); mst_kMd[3] = mSL_symbol("OutIn");
#mst_Ease = "Linear|Quad|Cubic|Quartic|Quintic|Exp|Circle|Sine|Elastic|Bounce"; // (the curves of s3d_EaseNames)
// the keys of the settings : their word, the setting, the bounds, the list of words (0 : a number ; the value : its rank +
// mst_Of) ; built at the first block (the settings ms_s... : defined later, by Espaces-MetaSurface)
MST_KMX = 24; mst_kc = 0; mst_ok = 0;
mst_W = make_array(MST_KMX); mst_I = make_array(MST_KMX); mst_Lo = make_array(MST_KMX); mst_Hi = make_array(MST_KMX);
mst_L = make_array(MST_KMX); mst_Ln = make_array(MST_KMX); mst_Of = make_array(MST_KMX);
function mst_K(key, k, lo, hi, list, n, of)
(
    mst_W[mst_kc] = mSL_symbol(key); mst_I[mst_kc] = k; mst_Lo[mst_kc] = lo; mst_Hi[mst_kc] = hi;
    mst_L[mst_kc] = list; mst_Ln[mst_kc] = n; mst_Of[mst_kc] = of;
    mst_kc += 1;
);
function mst_TbInit()
(
    mst_kc = 0;
    mst_K("aspect", ms_sAspect, 0.5, 4, 0, 0, 0);     mst_K("surface", ms_sSurf, 0, 0, "Rect|Disk", 2, 0);
    mst_K("band", ms_sBand, 0, 0.5, 0, 0, 0);         mst_K("proj", ms_sProj, 1, projucnt, 0, 0, 0);
    mst_K("spread", ms_sSpread, 0.01, 1, 0, 0, 0);    mst_K("power", ms_sPower, -1, 1, 0, 0, 0);
    mst_K("shape", ms_sShape, 0, 2, 0, 0, 0);         mst_K("stretch", ms_sStretch, 0.1, 10, 0, 0, 0);
    mst_K("offset", ms_sOffset, 0, 2, 0, 0, 0);       mst_K("rotation", ms_sRot, -4, 4, 0, 0, 0);
    mst_K("angle", ms_sAngle, -360, 360, 0, 0, 0);    mst_K("volume", ms_sVol, -60, 12, 0, 0, 0);
    mst_K("latency", ms_sLat, 5, 2000, 0, 0, 0);      mst_K("rule", ms_sLatMode, 0, 0, "Fixed|Distance", 2, 0);
    mst_K("attack", ms_sAtt, 0.01, 60, 0, 0, 0);      mst_K("release", ms_sRel, 0.01, 60, 0, 0, 0);
    mst_K("brush", ms_sPath, 0, 0, "Mouse|Path", 2, 0); mst_K("duration", ms_sDur, 0.5, 600, 0, 0, 0);
    mst_K("mode", ms_sLoop, 0, 0, "Once|Loop|Back|Reverse", 4, 0); mst_K("speed", ms_sSpeedM, 0, 0, "Path|Points", 2, 0);
    mst_K("radius", ms_sRad, 0.05, 1, 0, 0, 0);       mst_K("chain", ms_sTrN, 0, 0, "AB|ABC|ABCD", 3, 2);
    mst_K("mix", ms_sMix, 0, 1, 0, 0, 0);
    mst_ok = 1;
);

// a word of the list (n texts separated by |) : its rank ; -1 and an error otherwise
function mst_Enum(key, list, n) local(w, i, k, l, st, p)
(
    w = ed_Tb_Next(); k = -1;
    i = 0; st = 0; l = strlen(list);
    while ((k < 0) && (i < n)) (
        p = st; while ((p < l) && (str_getchar(list, p, 'cu') !== '|')) ( p += 1; );
        strcpy_substr(#mst_it, list, st, p - st);
        (mSL_symbol(#mst_it) === w) ? (k = i);
        st = p + 1; i += 1;
    );
    (k < 0) ? (
        sprintf(#ed_tbw, "%s : %s is not one of %s", key, (w === ed_tbEnd) ? "(the end)" : mSL_edit_value(#ed_tbv, w), list);
        ed_Tb_Err(2444, #ed_tbw);
    );
    k;
);
// the setting k of the work area s given (f : its keys)
function mst_Set(s, f, k, x) ( s[ms_eSet + k] = x; f[k] = 1; );
// a curve : Curve n (1 ... CRV_MX) or Curve "name" (a curve of the application, or of a block Curve read before) ; its index,
// or -1 and an error (the word Curve read)
function mst_Curve(key) local(w, k)
(
    w = ed_Tb_Next(); k = -1;
    ((abs(w) < mSL_CharConst) && !mSL_isString(w) && (w === floor(w)) && (w >= 1) && (w <= CRV_MX)) ? (k = w - 1) :
    crv_TbText(#mst_tx, w) ? (k = crv_TbFind(#mst_tx));
    (k < 0) ? (
        sprintf(#ed_tbw, "%s : Curve %s : a number 1 ... %d, or the name of a curve (defined before), is expected", key,
            (w === ed_tbEnd) ? "(the end)" : mSL_edit_value(#ed_tbv, w), CRV_MX);
        ed_Tb_Err(2447, #ed_tbw);
    );
    k;
);
// the kind of a trajectory (see above) : SP_KED + e (Edit A ... D), SP_KLIB + i (the library) ; -1 and an error otherwise
function mst_Kind(key) local(w, k, i)
(
    w = ed_Tb_Next(); k = -1;
    i = 0; loop(6, (w === mst_kKd[i]) ? (k = i); i += 1;);
    (k < 0) ? (
        (w === ed_tkEdit) ? (
            w = ed_Tb_Next();
            k = (w === ed_tkA) ? SP_KED : (w === ed_tkB) ? SP_KED + 1 : (w === ed_tkC) ? SP_KED + 2 : (w === ed_tkD) ? SP_KED + 3 : -1;
        ) :
        (w === mst_kT) ? (
            i = ed_Tb_NumC(key, 1, SP_NTRJ, 2448);
            (ed_tberr === 0) ? (k = SP_KLIB + floor(i) - 1);
        ) : (
            // T1 ... T128 : one word
            i = 1; while ((k < 0) && (i <= SP_NTRJ)) ( sprintf(#mst_tx, "T%d", i); (mSL_symbol(#mst_tx) === w) ? (k = SP_KLIB + i - 1); i += 1; );
        );
    );
    ((k < 0) && (ed_tberr === 0)) ? (
        sprintf(#ed_tbw, "%s : %s is not a trajectory (None, Circle, Square, Star, Spiral, Central, Edit A ... D, T1 ... T%d)", key,
            (w === ed_tbEnd) ? "(the end)" : mSL_edit_value(#ed_tbv, w), SP_NTRJ);
        ed_Tb_Err(2448, #ed_tbw);
    );
    k;
);
// a key of a block MetaSurface
function mst_IsKey(w) local(i, r)
(
    r = (w === ed_tkName) || (w === mst_kZone) || (w === ed_tkA) || (w === ed_tkB) || (w === ed_tkC) || (w === ed_tkD) ||
        (w === mst_kPath) || (w === mst_kPlace) || (w === mst_kFlip) || (w === mst_kGlide) || (w === mst_kDyn) ||
        (w === mst_kModR) || (w === mst_kModS) || (w === mst_kModM);
    i = 0; while (!r && (i < mst_kc)) ( (w === mst_W[i]) ? (r = 1); i += 1; );
    r;
);

// A block MetaSurface (its word read) : read in the work area of its entry ; returns the entry, or -1
function mst_Meta() local(w, e, s, f, i, j, k, t, x, n, p, c, bx)
(
    !mst_ok ? mst_TbInit();
    w = ed_Tb_Next();
    e = ((abs(w) < mSL_CharConst) && !mSL_isString(w) && (w === floor(w)) && (w >= 1) && (w <= MS_NLIB)) ? w - 1 : -1;
    (e < 0) ? (
        sprintf(#ed_tbw, "MetaSurface %s : a number 1 ... %d is expected", (w === ed_tbEnd) ? "(the end)" : mSL_edit_value(#ed_tbv, w), MS_NLIB);
