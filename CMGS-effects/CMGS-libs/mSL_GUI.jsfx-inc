    (k === 27) ? sprintf(#jg_mnu, "#The tabs bar|%sAs the style (Classic : shown ; Soft : when the mouse comes near the top)|%sAlways shown|%sShown when the mouse comes near the top",
        jg_Tk(v, 0), jg_Tk(v, 1), jg_Tk(v, 2));
