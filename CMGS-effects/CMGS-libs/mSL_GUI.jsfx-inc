        sprintf(#jg_mnu, "#Actions|Show GUI settings (in the System Log)|Export GUI settings...|%sPreview of the palette|%s|Save as default (the current look, its style)|Factory defaults (Classic, Outline, Pastel, tabs always, gaps 40 x 4, frame Rect, thick none)",
            jg_prev ? "!" : "",
            jg_hasdef ? (jg_defStyle ? "Reset to default (its style : Soft)" : "Reset to default (its style : Classic)") :
                "#Reset to default (none saved)");
        m = jg_Menu(#jg_mnu);
        (m === 2) ? (
            sprintf(#jg_msg, "settings(data( %s ));", jg_Text(#jg_w));
            mSL_log(SysLogBox, #jg_msg);
        ) :
        (m === 3) ? jg_XpAsk() :
        (m === 4) ? (jg_prev = !jg_prev) :
        (m === 5) ? jg_Restore() : (m === 6) ? jg_SaveDef() : (m === 7) ? jg_Factory();
    );
    ui_GFXdoNow |= 1;
);

// The drag of the cells of values (potentiometers, ui_jdrag : horizontal coarse, vertical fine)
function jg_DragPad(blockId, c) local(k, d)
(
    (ui_jdrag_can_start() && ((k = jg_CellVal(c)) >= 0)) ? (
        jg_Range(k);
        ui_jdrag_start(blockId, c, jg_Get(k), jg_lo, jg_hi, min(600, max(120, (jg_hi - jg_lo) * 12)), 2);
    );
    d = ui_jdrag(blockId);
    ((d & 1) && ((k = jg_CellVal(ui_jdrag_cell)) >= 0)) ? jg_Set(k, ui_jdrag_v);
    d;
);

// (2026-11-22) The cell i of the pad of the module (its cells have roles, see part 1) : chg its value changed (the mode
// "selected"), ina without effect in the current look (the mode "disabled" : its clics kept, ui_jpad_ct_dim)
function jg_Mark(i, chg, ina) local(d)
(
    d = pad_JGS + pad_JGS[ui_jpad_cells];
    d[i] = (d[i] & (-1 ~ (ui_jpad_ct_selec | ui_jpad_ct_dim))) | (chg ? ui_jpad_ct_selec : 0) | (ina ? ui_jpad_ct_dim : 0);
);
// the value k changed (not its default)
function jg_Chg(k) ( jg_Get(k) !== jg_Def(k); );

// The labels of the preview of the palette (pad_JGV : the modes, the roles, the identity series)
function jg_Preview() local(l, r, m, p)
(
    mSL_setStrArray(pad_JGV_Labs, JG_VSIZ);
    strcpy(pad_JGV_Labs[0], "Cell Type");
    strcpy(pad_JGV_Labs[1], "Rest"); strcpy(pad_JGV_Labs[2], "Hover"); strcpy(pad_JGV_Labs[3], "Pressed");
    strcpy(pad_JGV_Labs[4], "Selected"); strcpy(pad_JGV_Labs[5], "Disabled"); strcpy(pad_JGV_Labs[6], "Locked");
    l = 1; loop(10,
        r = jg_PvRole(l);
        strcpy(pad_JGV_Labs[7 * l], jg_RoleName(r));
        m = 0; loop(6,
            strcpy(pad_JGV_Labs[7 * l + 1 + m], jg_Na(r, m) ? "-" :
                (r === 1) ? "Menu..." : (r === 2) ? "Loop On" : (r === 3) ? "View B" : (r === 4) ? "Speed 1.25" :
                (r === 5) ? "Line 2" : (r === 6) ? "Playing" : (r === 7) ? "Remove" : (r === 8) ? "Pos 3.42 s" :
                (r === 10) ? "Err: 0136" : "");
            m += 1;
        );
        l += 1;
    );
    strcpy(pad_JGV_Labs[77], "Identity");
    m = 0; loop(6, sprintf(pad_JGV_Labs[78 + m], "Proj %c", 'A' + m); m += 1;);
    // (2026-11-22) the adjustments of the role jg_adjR in the current family ; the line of that role : selected
    p = jg_Adj(ui_jp_fam, jg_adjR);
    sprintf(pad_JGV_Labs[84], "Adjust: %s", jg_RoleName(jg_adjR));
    sprintf(pad_JGV_Labs[85], (p[0] > 0) ? "Hue +%d" : "Hue %d", p[0]);
    sprintf(pad_JGV_Labs[86], (p[1] > 0) ? "Light +%d %%" : "Light %d %%", p[1]);
    sprintf(pad_JGV_Labs[87], (p[2] > 0) ? "Chroma +%d %%" : "Chroma %d %%", p[2]);
    strcpy(pad_JGV_Labs[88], "Reset role"); strcpy(pad_JGV_Labs[89], "Reset palette"); strcpy(pad_JGV_Labs[90], "");
    l = 1; loop(10, ui_jpad_mark(pad_JGV, 7 * l, jg_PvRole(l) === jg_adjR, 0); l += 1;);
    m = 0; loop(3, ui_jpad_mark(pad_JGV, 85 + m, p[m] !== 0, 0); m += 1;);
);
// The measures of the palette (uix_jp_measure, ui-lib-JJ-GUI), into s : the least contrast of a text (good from 4.5,
// fair from 3), the least difference between two roles (good from 10, fair from 6), between a role and the background
// (good from 15, fair from 9 ; the variation Text : none)
function jg_Qual(v, a, b) ( (v >= a) ? "good" : (v >= b) ? "fair" : "poor"; );
function jg_Measures(s)
(
    sprintf(s, "Text contrast %.1f:1 %s (%s)    Roles apart %.1f %s (%s / %s)", uix_jp_mTxt, jg_Qual(uix_jp_mTxt, 4.5, 3),
        jg_RoleName(uix_jp_mTxtR), uix_jp_mDe, jg_Qual(uix_jp_mDe, 10, 6), jg_RoleName(uix_jp_mDeA), jg_RoleName(uix_jp_mDeB));
    (uix_jp_mBg < 999) ? (
        sprintf(#jg_t2, "    Background %.1f %s (%s)", uix_jp_mBg, jg_Qual(uix_jp_mBg, 15, 9), jg_RoleName(uix_jp_mBgR));
        strcat(s, #jg_t2);
    );
    s;
);

// (2026-11-22) The adjustments of a role (the last line of the preview) : the range of the value i (0 the hue, 1 the
// lightness, 2 the chroma) : jg_lo, jg_hi, the menu of its values #jg_vl (jg_vn of them)
function jg_AdjRange(i)
(
    (i === 0) ? (jg_lo = -180; jg_hi = 180; strcpy(#jg_vl, "-180|-120|-90|-60|-45|-30|-15|0|15|30|45|60|90|120|180"); jg_vn = 15;) :
    (i === 1) ? (jg_lo = -30; jg_hi = 30; strcpy(#jg_vl, "-30|-20|-15|-10|-5|0|5|10|15|20|30"); jg_vn = 11;) :
    (jg_lo = -100; jg_hi = 100; strcpy(#jg_vl, "-100|-75|-50|-25|-10|0|10|25|50|75|100"); jg_vn = 11;);
);
// A clic on the preview (not a drag) : the line of a role chooses it ; the last line : the role adjusted (right : a menu ;
// left : the next one), its hue, lightness, chroma (Shift : 0 ; right : the menu of the values), reset the role, the palette
function jg_PvCell(c, ev) local(rc, sh, l, i, p, m, v)
(
    rc = ev & ui_jpad_ev_rmc; sh = mouse_cap & 8;
    l = floor(c / 7);
    ((l >= 1) && (l <= 10)) ? (
        jg_adjR = jg_PvRole(l);
    ) :
    (c === 84) ? (
        rc ? (
            strcpy(#jg_mnu, "#The role adjusted (in the palette " ); strcat(#jg_mnu, jg_FamName(ui_jp_fam)); strcat(#jg_mnu, ")");
            l = 1; loop(10, strcat(#jg_mnu, "|"); strcat(#jg_mnu, jg_Tk(jg_adjR, jg_PvRole(l))); strcat(#jg_mnu, jg_RoleName(jg_PvRole(l))); l += 1;);
            ((m = jg_Menu(#jg_mnu)) >= 2) ? jg_adjR = jg_PvRole(m - 1);
        ) : (
            l = 1; i = 1; loop(10, (jg_PvRole(i) === jg_adjR) ? l = i; i += 1;);
            jg_adjR = jg_PvRole(sh ? ((l + 8) % 10) + 1 : (l % 10) + 1);
        );
    ) :
    ((c >= 85) && (c <= 87) && ((p = jg_Adj(ui_jp_fam, jg_adjR)) > 0)) ? (
        i = c - 85;
        sh ? (
            p[i] = 0; uix_jp_dirty = 1;
        ) : rc ? (
            jg_AdjRange(i);
            strcpy(#jg_mnu, "");
            m = 0;
            loop(jg_vn,
                v = jg_Int(jg_Nth(#jg_vl, m, #jg_it));
                (m > 0) ? strcat(#jg_mnu, "|");
                (v === p[i]) ? strcat(#jg_mnu, "!");
                strcat(#jg_mnu, sprintf(#jg_it2, (v > 0) ? "+%d" : "%d", v));
                m += 1;
            );
            ((m = jg_Menu(#jg_mnu)) > 0) ? (p[i] = jg_Int(jg_Nth(#jg_vl, m - 1, #jg_it)); uix_jp_dirty = 1;);
        );
    ) :
    (c === 88) ? (
        jg_AdjSet(ui_jp_fam, jg_adjR, 0, 0, 0);
    ) :
    (c === 89) ? (
        sprintf(#jg_it, "#Reset the adjustments of all the roles in the palette %s|Do it|Cancel", jg_FamName(ui_jp_fam));
        (jg_Menu(#jg_it) === 2) ? jg_AdjClear(ui_jp_fam);
    );
    ui_GFXdoNow |= 1;
);
// The drag of the adjustments (the cells 85, 86, 87 of the preview : potentiometers, ui_jdrag ; its owner : not that of the
// pad of the module)
function jg_PvDrag(blockId, c) local(o, i, p, d)
(
    o = blockId + 0.5;
    (ui_jdrag_can_start() && (c >= 85) && (c <= 87) && ((p = jg_Adj(ui_jp_fam, jg_adjR)) > 0)) ? (
        i = c - 85; jg_AdjRange(i);
        ui_jdrag_start(o, c, p[i], jg_lo, jg_hi, (i === 0) ? 600 : (i === 1) ? 240 : 400, 2);
    );
    d = ui_jdrag(o);
    ((d & 1) && (ui_jdrag_cell >= 85) && (ui_jdrag_cell <= 87) && ((p = jg_Adj(ui_jp_fam, jg_adjR)) > 0)) ? (
        p[ui_jdrag_cell - 85] = ui_jdrag_v; uix_jp_dirty = 1;
    );
    d;
);

// The module "GUI"
function show_GUI_Pad(blockId)
local(h1, h2, hl, hneed, zzmi, zz, dr, c, i, sf, fr, vr, pv, f)
(
    h1 = uix_jpadHeight(5);
    h2 = uix_jpadHeight(13); hl = ui_jd_vtext + 6; // (the preview of the palette, the line of its measures)
    hneed = h1 + ui_jd_ctgr + 8;
    // (the preview : when asked, if the palette exists and if the module has the room)
    pv = jg_prev && (uix_jp_tab > 0) && (ui_height() >= hneed + h2 + hl + 4);
    pv ? hneed += h2 + hl + 4;
    jg_XpFrame(); // (2026-11-23 : Export GUI settings, the prompt closed, the file written)
    (ui_height() >= hneed) ? (
        ui_split_top(hneed);
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    ui_color(Col_Frame);
                    ui_border();
                ui_pop();
            );
            control_group("GUI : the look of the application");
            ui_pad(0, ui_cg_pad_top, 0, ui_cg_pad_bottom);
            ui_split_top(h1);
                ui_pad(1, 2, 2, 2);
                mSL_setStrArray(pad_JGS_Labs, JG_PSIZ);
                i = 0; loop(JG_PSIZ, strcpy(pad_JGS_Labs[i], ""); i += 1;);
                sf = ui_jstyle; fr = sf && (ui_jg_frame > 0); vr = jg_Var(); f = ui_jp_fam;
                // the whole look
                strcpy(pad_JGS_Labs[0], "Theme: "); strcat(pad_JGS_Labs[0], jg_ThemeName(uix_jtheme));
                (ui_jg_bgk === 0) ? strcpy(pad_JGS_Labs[1], "Background: theme") :
                    sprintf(pad_JGS_Labs[1], (ui_jg_bgk > 0) ? "Background +%d %%" : "Background %d %%", ui_jg_bgk);
                sprintf(pad_JGS_Labs[2], "Size %d %%", ui_jzoom_pc(ui_jzoomK));
                strcpy(pad_JGS_Labs[3], sf ? "Style: Soft" : "Style: Classic");
                strcpy(pad_JGS_Labs[4], (ui_jg_tabs === 1) ? "Tabs bar: always" : (ui_jg_tabs === 2) ? "Tabs bar: hover" : "Tabs bar: style");
                // the palette
                strcpy(pad_JGS_Labs[5], "Palette: "); strcat(pad_JGS_Labs[5], jg_FamName(f));
                (ui_jp_hue < 0) ? strcpy(pad_JGS_Labs[6], "Hue: theme") : sprintf(pad_JGS_Labs[6], "Hue %d", ui_jp_hue);
                sprintf(pad_JGS_Labs[7], "Chroma %d %%", ui_jp_chroma);
                sprintf(pad_JGS_Labs[8], "Light %d %%", ui_jp_light);
                strcpy(pad_JGS_Labs[9], ui_jp_danger ? "Danger: palette" : "Danger: red");
                // the modes
                sprintf(pad_JGS_Labs[10], "Selection %d %%", jg_Get(9));
                sprintf(pad_JGS_Labs[11], "Hover %d %%", ui_jp_hover);
                sprintf(pad_JGS_Labs[12], "Disabled %d %%", ui_jp_dis);
                sprintf(pad_JGS_Labs[13], "Contrast %d %%", jg_Get(17));
                (ui_jg_fadet === 0) ? strcpy(pad_JGS_Labs[14], "Fade time: none") : sprintf(pad_JGS_Labs[14], "Fade time %d s", ui_jg_fadet);

                // the cells of the pads
                strcpy(pad_JGS_Labs[15], (vr === 3) ? "Variation: Outline" : (vr === 2) ? "Variation: Text" : (vr === 1) ? "Variation: Faded" : "Variation: Std");
                sprintf(pad_JGS_Labs[16], "Pads text %d %%", ui_jg_ptext);
                strcpy(pad_JGS_Labs[17], ui_jg_bold ? "Pads bold: On" : "Pads bold: Off");
                sprintf(pad_JGS_Labs[18], "Gap X %d", ui_jg_gapx);
                sprintf(pad_JGS_Labs[19], "Gap Y %d", ui_jg_gapy);
                // their fill
                (ui_jg_cround < 0) ? strcpy(pad_JGS_Labs[20], "Corners: pads") : sprintf(pad_JGS_Labs[20], "Corners %d", ui_jg_cround);
                sprintf(pad_JGS_Labs[21], "Fade %d", ui_jpad_fade);
                strcpy(pad_JGS_Labs[22], ui_jg_extend ? "Extend: On" : "Extend: Off");
                sprintf(pad_JGS_Labs[24], "Tab count %d", dcbTabsCount); // (2026-11-23, mSL_Tabs)
                // the frames
                strcpy(pad_JGS_Labs[25], (ui_jg_frame === 1) ? "Frame: Rect" : (ui_jg_frame === 2) ? "Frame: Round" : "Frame: None");
                sprintf(pad_JGS_Labs[26], "Radius %d", ui_jg_radius);
                (ui_jg_thick === 0) ? strcpy(pad_JGS_Labs[27], "Thick: none") : sprintf(pad_JGS_Labs[27], "Thick %d", ui_jg_thick);
                strcpy(pad_JGS_Labs[28], (ui_jg_fcol === 0) ? "Frame Color: Cell" : (ui_jg_fcol === 2) ? "Frame Color: Darker" :
                    (ui_jg_fcol === 3) ? "Frame Color: Grey" : "Frame Color: Lighter");
                sprintf(pad_JGS_Labs[29], "Opacity %d %%", jg_Get(6));
                // the texts, the actions
                sprintf(pad_JGS_Labs[30], "Fonts %d %%", ui_jg_fonts);
                sprintf(pad_JGS_Labs[31], "Faders text %d %%", ui_jg_ftext);
                strcpy(pad_JGS_Labs[32], ui_jg_fbold ? "Faders bold: On" : "Faders bold: Off");
                sprintf(pad_JGS_Labs[33], "Faders width %d %%", ui_jg_fwidth);
                strcpy(pad_JGS_Labs[34], "Actions");
                // (a value changed : selected ; a cell without effect in the current look : disabled ; the palette draws them)
                jg_Mark(0, uix_jtheme !== 0, 0);
                jg_Mark(1, jg_Chg(19), 0);
                jg_Mark(2, ui_jzoomK !== ui_jzoomDef, 0);
                jg_Mark(3, sf, 0);
                jg_Mark(4, jg_Chg(27), 0);
                jg_Mark(5, jg_Chg(20), 0);
                jg_Mark(6, jg_Chg(21), (f === 0) || (f === 7));
                jg_Mark(7, jg_Chg(22), 0);
                jg_Mark(8, jg_Chg(23), 0);
                jg_Mark(9, jg_Chg(24), f === 7);
                jg_Mark(10, jg_Chg(9), 0);
                jg_Mark(11, jg_Chg(25), 0);
                jg_Mark(12, jg_Chg(26), 0);
                jg_Mark(13, jg_Chg(17), vr < 2);
                jg_Mark(14, jg_Chg(28), 0);
                jg_Mark(15, jg_Chg(13), 0); // (2026-11-22 : changed from the factory default, Outline)
                jg_Mark(16, jg_Chg(12), 0);
                jg_Mark(17, jg_Chg(11), 0);
                jg_Mark(18, jg_Chg(0), 0);
                jg_Mark(19, jg_Chg(1), 0);
                jg_Mark(20, jg_Chg(7), sf && ((vr === 1) || (vr === 2))); // (Classic : the border, the fill of a selected cell in Text ; Outline : its frame)
                jg_Mark(21, jg_Chg(8), (vr === 0) || (vr === 3) || ui_jg_extend);
                jg_Mark(22, jg_Chg(10), (vr === 0) || (vr === 3));
                jg_Mark(24, dcbTabsCount !== tbs_Def, 0);
                jg_Mark(25, jg_Chg(2), !sf);
                jg_Mark(26, jg_Chg(3), !(fr && (ui_jg_frame === 2) && ((vr !== 0) || (ui_jg_cround <= 0)))); // (Std : the frame follows the corners)
                jg_Mark(27, jg_Chg(4), sf && !fr && (vr !== 3)); // (Classic : the border of the cells, 0 none ; Outline : the frame of a selected cell)
                jg_Mark(28, jg_Chg(5), !fr);
                jg_Mark(29, jg_Chg(6), !fr);
                jg_Mark(30, jg_Chg(14), 0);
                jg_Mark(31, jg_Chg(15), 0);
                jg_Mark(32, jg_Chg(18), 0);
                jg_Mark(33, jg_Chg(16), 0);
                zz = control_jpad(pad_JGS);
                c = ui_jpad_cell_at();
                dr = jg_DragPad(blockId, c); // the cells of values : a drag
                (zz > 0) ? (
                    ui_GFXdoNow |= 4;
                    ((zz & (ui_jpad_ev_lmc | ui_jpad_ev_rmc)) && !((zz & ui_jpad_ev_lmc) && (dr & 2))) ? (
                        jg_PadCell(pad_JGS[ui_jpad_last] - 1, zz);
                    );
                );
            ui_pop();
            pv ? (
                // the preview of the palette : the roles in their 6 modes, the identity series ; then its measures
                ui_split_top(h2);
                    ui_pad(1, 2, 2, 2);
                    jg_Preview();
                    zz = control_jpad(pad_JGV);
                    c = ui_jpad_cell_at();
                    dr = jg_PvDrag(blockId, c); // the adjustments : a drag
                    ((zz > 0) && (zz & (ui_jpad_ev_lmc | ui_jpad_ev_rmc)) && !((zz & ui_jpad_ev_lmc) && (dr & 2))) ? (
                        ui_GFXdoNow |= 4;
                        jg_PvCell(pad_JGV[ui_jpad_last] - 1, zz);
                    );
                ui_pop();
                ui_split_top(hl);
                    ui_pad(6, 0, 4, 0);
                    ui_pcolor(ui_jcolor_text); ui_align(0, 0.5);
                    ui_text(jg_Measures(#jg_ms));
                ui_pop();
            );
        ui_pop();
    );
);

