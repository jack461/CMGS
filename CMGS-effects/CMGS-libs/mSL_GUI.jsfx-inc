//====== GUI : THE MODULE ======

// The pad (5 lines of 7, 2026-11-22 : a column per subject ; the cells numbered column by column) : the whole look : 0 Theme,
// 1 Background (shade), 2 Display size, 3 Style, 4 Tabs bar ; the palette : 5 Palette, 6 Hue, 7 Chroma, 8 Light, 9 Danger ;
// the modes : 10 Selection, 11 Hover, 12 Disabled, 13 Contrast (the variation Text), 14 Fade time (2026-11-23) ; the cells of the pads :
// 15 Variation, 16 Pads text, 17 Pads bold, 18 Gap X, 19 Gap Y ; their fill : 20 Corners, 21 Fade, 22 Extend, 23 empty,
// 24 Tab count (2026-11-23, mSL_Tabs) ; the frames : 25 Frame, 26 Radius, 27 Thick, 28 Frame Color, 29 Opacity ; the texts : 30 Fonts, 31 Faders
// text, 32 Faders bold, 33 Faders width ; 34 Actions (2026-11-23 : a menu ; Show GUI settings, Export GUI settings, Preview,
// the defaults ; until then the cells Log settings and Preview, and Defaults)
// The cell c : its value (k : jg_Get) ; -2 the style, -4 Actions, -5 the theme, -6 the display size,
// -7 the preview, -8 the count of the tabs ; -1 none
function jg_CellK(c)
(
    (c === 0) ? -5 : (c === 1) ? 19 : (c === 2) ? -6 : (c === 3) ? -2 : (c === 4) ? 27 :
    (c === 5) ? 20 : (c === 6) ? 21 : (c === 7) ? 22 : (c === 8) ? 23 : (c === 9) ? 24 :
    (c === 10) ? 9 : (c === 11) ? 25 : (c === 12) ? 26 : (c === 13) ? 17 : (c === 14) ? 28 :
    (c === 15) ? 13 : (c === 16) ? 12 : (c === 17) ? 11 : (c === 18) ? 0 : (c === 19) ? 1 :
    (c === 20) ? 7 : (c === 21) ? 8 : (c === 22) ? 10 : (c === 24) ? -8 :
    (c === 25) ? 2 : (c === 26) ? 3 : (c === 27) ? 4 : (c === 28) ? 5 : (c === 29) ? 6 :
    (c === 30) ? 14 : (c === 31) ? 15 : (c === 32) ? 18 : (c === 33) ? 16 : (c === 34) ? -4 : -1;
);
// the value k : a number (a potentiometer ; the others : a choice in a short list)
function jg_IsNum(k)
(
    (k >= 0) && (k !== 2) && (k !== 5) && (k !== 10) && (k !== 11) && (k !== 13) && (k !== 18) && (k !== 20) && (k !== 24) && (k !== 27);
);
// the cell c : its value if it is a number ; -1 otherwise
function jg_CellVal(c) local(k) ( k = jg_CellK(c); jg_IsNum(k) ? k : -1; );
// the choices of the value k (not a number) : their count, the current one
