    (k === 7) ? (jg_lo = -1; jg_hi = 20; strcpy(#jg_vl, "-1|0|2|3|4|5|6|8|10|12|16"); jg_vn = 11;) :
    (k === 8) ? (jg_lo = 0; jg_hi = 80; strcpy(#jg_vl, "0|10|20|30|40|50|60|80"); jg_vn = 8;) :
    (k === 9) ? (jg_lo = 0; jg_hi = 80; strcpy(#jg_vl, "0|10|20|25|35|50|65|80"); jg_vn = 8;) :
    ((k === 12) || (k === 14)) ? (jg_lo = 80; jg_hi = 150; strcpy(#jg_vl, "80|90|100|110|120|130|140|150"); jg_vn = 8;) :
    (k === 15) ? (jg_lo = 70; jg_hi = 150; strcpy(#jg_vl, "70|80|90|100|110|120|130|140|150"); jg_vn = 9;) :
    (k === 19) ? (jg_lo = -80; jg_hi = 80; strcpy(#jg_vl, "-80|-60|-40|-30|-20|-10|0|10|20|30|40|60|80"); jg_vn = 13;) :
    (k === 17) ? (jg_lo = 10; jg_hi = 80; strcpy(#jg_vl, "10|20|25|35|45|55|65|80"); jg_vn = 8;) :
    (k === 16) ? (jg_lo = 50; jg_hi = 200; strcpy(#jg_vl, "50|60|70|80|90|100|110|120|130|150|175|200"); jg_vn = 12;) :
    (k === 21) ? (jg_lo = -1; jg_hi = 359; strcpy(#jg_vl, "-1|0|30|60|90|120|150|180|210|240|270|300|330"); jg_vn = 13;) :
    (k === 28) ? (jg_lo = 0; jg_hi = 60; strcpy(#jg_vl, "0|1|2|3|5|8|10|15|20|30|45|60"); jg_vn = 12;) :
