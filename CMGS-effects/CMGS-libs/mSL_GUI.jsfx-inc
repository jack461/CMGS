    (k === 10) ? sprintf(#jg_mnu, "#The fade (Faded)|%sAround the text (Fade)|%sUp to the edges of the cell (its frame)",
        jg_Tk(v, 0), jg_Tk(v, 1)) :
    (k === 11) ? sprintf(#jg_mnu, "#The text of the cells of the pads|%sNormal|%sBold", jg_Tk(v, 0), jg_Tk(v, 1)) :
    (k === 18) ? sprintf(#jg_mnu, "#The labels of the faders|%sNormal|%sBold", jg_Tk(v, 0), jg_Tk(v, 1)) :
    (k === 13) ? sprintf(#jg_mnu, "#The variation (the cells of the pads)|%sStd : filled with their color|%sFaded : their color around their text, faded|%sText : their color in their text|%sOutline : as Text, a selected cell framed",
        jg_Tk(v, 0), jg_Tk(v, 1), jg_Tk(v, 2), jg_Tk(v, 3)) :
    (k === 20) ? (
        sprintf(#jg_mnu, "#The palette (the cells with a role)|%sTheme : the colors of the theme|%sMono : one hue|%sAnalog : neighbouring hues|%sComplement : the commands and the data opposite",
            jg_Tk(v, 0), jg_Tk(v, 1), jg_Tk(v, 2), jg_Tk(v, 3));
        sprintf(#jg_it, "|%sSpectrum : six hues around the circle|%sMuted : neighbouring hues, little saturated|%sPastel : light cells, dark text|%sContrast : fixed hues, distinct with a color blindness",
            jg_Tk(v, 4), jg_Tk(v, 5), jg_Tk(v, 6), jg_Tk(v, 7));
