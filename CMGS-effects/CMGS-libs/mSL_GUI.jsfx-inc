// the item i of the list "a|b|c" into s ; returns s
function jg_Nth(list, i, s) local(n, k, a, c)
(
    n = strlen(list); k = a = 0;
    while ((k < n) && (i > 0)) ( (str_getchar(list, k, 'cu') === '|') ? (i -= 1; a = k + 1;); k += 1; );
    k = a; while ((k < n) && (str_getchar(list, k, 'cu') !== '|')) (k += 1;);
