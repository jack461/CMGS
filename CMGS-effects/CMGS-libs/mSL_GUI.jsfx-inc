/*
    mSL_GUI.jsfx-inc  (2026-11-21)
    The rubric "GUI" of the CMGS applications : small settings of the look (the pads, drawn by control_jpad, mSL_ui_Pads :
    the globals ui_jg_*, ui_jpad_fade, ui_jpad_selmix, ui_jvariant ; the style ui_jstyle ; the texts and the faders,
    ui-lib-JJ-GUI : ui_jg_fonts, ui_jg_ftext, ui_jg_fwidth) :
      the whole look
        theme k     the theme : its number (0 ... 11) or its name, as a string : "Default", "Black", "Tron", "Light Cyan",
                    "Orange", "Blue", "Dark Cyan", "Dark Green", "Dark Red", "Light Amber", "Neon Green", "Light Magenta"
                    (as the sub-menu "Theme" of the panes ; saved by the host)
        shade n     the background : darker (-80 ... -1 %) or lighter (1 ... 80 %), 0 : as the theme ; the texts that have
                    the color of the theme are made readable on it (ui_jg_bgk, see update_theme in ui-lib-JJ-GUI)
        size n      the display size (50 ... 200 % : the nearest of 50, 60, 70, 80, 90, 100, 120, 150, 200 ; as the sub-menu
                    "Display size" ; saved by the host)
        style k     Classic or Soft (as the sub-menu "Style" of the panes ; saved by the host, serialBlock[Pr7_UiStyle]) :
                    the borders of the cells, the sliders, the tabs bar
        tabcount n  (2026-11-23) the count of the tabs of the application (1 ... 16, mSL_Tabs) : more tabs, empty ; fewer : only
                    the empty tabs are removed (the last ones first, then those in between : the following ones take their
                    places), otherwise error 1643 and nothing changes ; saved by the host (with the tabs), not part of the
                    default of the user nor of Show GUI settings ; also the sub-menu "Number of tabs" of the Studio menu
        tabs k      (2026-11-22) the tabs bar : Style (as the style : Classic always shown, Soft shown when the mouse
                    comes near the top of the window, for 10 seconds after it left it), Always (shown), Hover (shown when
                    the mouse comes near the top)
        variant k   the cells of the pads (as the sub-menu "Variation" of the panes) : Std (filled with their color),
                    Faded (their color around their text, faded), Text (their color in their text, made readable on the
                    background ; a selected cell : Faded ; the classic style : filled up to its border), Outline
                    (2026-11-22 : as Text, a selected cell keeps its text and gets a frame of Thick + 1 units) ; by
                    default, as the style (Classic : Std, Soft : Faded)
        fonts n     the size of all the texts (80 ... 150 %) : the tabs bar, the logs, the titles and the messages of the
                    modules, the pads, the faders ... ; above 100 %, the lines get higher too (ui_jtext_set)
      the palette (2026-11-22, step 2 : the cells that have a role, see ui_jpad_rl_action in mSL_ui_Pads ; the palette is
      computed by uix_jp_make, ui-lib-JJ-GUI)
        palette k   the family : Theme (the colors of the theme), Mono (one hue), Analog (neighbouring hues), Complement
                    (the commands and the data on opposite sides of the circle), Spectrum (six hues around the circle),
                    Muted (neighbouring hues, little saturated), Pastel (light cells, dark text), Contrast (fixed hues,
                    distinct with a color blindness)
        hue n       the base hue (0 ... 359 degrees) ; -1 or Theme : that of the theme (the families Theme, Contrast : no effect)
        chroma n    the saturation (0 ... 100 %)
        light n     the lightness (0 ... 100 %)
        danger k    the cells Danger : Red, or Palette (a hue of the palette) ; the cells Alert : orange, or a hue
        adjust ...  (2026-11-22) the adjustments of a role in a family, by the user : adjust [family] role h l c (the hue
                    -180 ... 180 degrees, the lightness -30 ... 30 %, the chroma -100 ... 100 % of that of the palette ;
                    the family : the current one by default ; the roles : Action, Choice, Navigation, Value, Object,
                    State, Danger, Alert, Information, Empty) ; adjust [family] reset : all the roles of the family ;
                    adjust reset all : all the families ; also on the last line of the preview of the module
        hover n     the mode "hover" (the mouse on the cell) : its strength (0 ... 100 %)
        disabled n  the mode "disabled" : its strength (0 ... 100 %)
        fadetime n  (2026-11-23) the cells that fade (the sensors, the clips of the Game Master ...) : the time of their
                    return to rest after the mode "selected" (0 ... 60 seconds ; 0 : at once ; ui_jg_fadet, mSL_ui_Pads)
                    (the mode "selected" : select, below)
      the texts
        ptext n     the text of the cells of the pads : its size (80 ... 150 % of the texts ; above 100 %, the lines of
                    the pads get higher ; a text too wide for its cell is made smaller by ui_text)
        bold k      the text of the cells of the pads : Off, On (bold)
        ftext n     the labels of the faders : the size of their text (70 ... 150 % of the texts ; above 100 %, the
                    faders get higher)
        fbold k     the labels of the faders : Off, On (bold)
        fwidth n    the labels of the faders : the width they get (50 ... 200 % ; the fader gets the rest)
      the cells of the pads
        gapx n      the room added between the cells, horizontally (0 ... 200 units) : the colored rectangle shrinks (never
                    narrower than its text), the cell keeps its place and its clics, the pad its size
        gapy n      the same, vertically (0 ... 10 units)
        corners n   the variation Std : the radius of the corners of the rectangular cells (0 ... 20 units ; -1 : as
                    each pad draws them)
        fade n      the variation Faded : the width of the fade around the text (0 ... 80 pixels)
        extend k    the variation Faded : On, the fade goes up to the edges of the cell (its frame), whatever its width
        select n    the variations Faded and Text : a selected cell made lighter (0 ... 80 %) ; the cells with a role (all
                    the variations) : the strength of their mode "selected" (twice this value)
        contrast n  the variation Text : the least difference of luminance between the text of a cell and the background
                    (10 ... 80 % ; the color of the cell is made lighter or darker until then)
      the frames of the cells (the soft style)
        frame k     a frame around each cell that has a text : None, Rect, Round ; the variation Std : the frame
                    follows the corners of the cell (Corners), Rect or Round, and Round gives its radius to the cells
                    without corners
        radius n    the radius of its corners (0 ... 20 units ; Round)
        thick n     its thickness (1 ... 4 units) ; 0 : no frame, and in the classic style no border around the cells of
                    the pads (the other parts of the classic style unchanged)
        color k     its color : Cell (that of the cell), Lighter, Darker, Grey
        opacity n   its opacity (5 ... 100 %)
      defaults      all of them back to their factory defaults (2026-11-22, the user's choice : style Classic, tabs
                    Always, palette Pastel, variant Outline, gapx 40, gapy 4, frame Rect, corners -1 (as each pad), thick
                    0 (none), the others as until then ; the theme and the size unchanged)
      default ...   (2026-11-22) the keys that follow define the default of the user (not applied : all the keys above,
                    except theme and size ; style included ; adjust : the adjustments of the default ; defaults : no
                    default of the user any more) ; it starts from the factory defaults (style Classic)
      restore       the look back to the default of the user (or to the factory defaults if there is none) : the theme and the
                    display size unchanged, its style imposed ; also the menu of the cell Actions of the module
                    (Save as default, Reset to default, Factory defaults). Show GUI settings writes it after the current look :
                    "... default style Soft variant Outline ..." (saved with the project)
    Given by the module "GUI" (a pad : potentiometers and menus) or by the mSL settings, in a call of its own :
        settings(data( GUI fonts 110 variant Text bold On frame Round radius 6 color Lighter ));
    (the host's Set_Table hands a block that starts with the word GUI to jg_Settings ; the keys absent do not change).
    Saved with the project (and with the presets) : jg_Serialize, the last record of @serialize (JG_NF numbers, all
    integers : exact in the single precision of file_var) ; Interstys : its typed record 'gui1' (jg_Pack, jg_Unpack).
    An older project, without them : the defaults.
    Errors 1640 ... 1642 (the System Log : "ERR: 1640    GUI settings (word n) : ...").

    The file has two parts, selected by the preprocessor variable "jg_part" (as mSL_Console) :
        jg_part = 1 : in @init, while make_array works (static memory), after mSL_Utilities (mSL_symbol, mSL_log),
                      mSL_ui_Pads, ui-lib-JJ-GUI and the colors, BEFORE the host's Set_Table : the state, the settings,
                      the record, the pad of the module
        jg_part = 2 : after keepBlockInfos (the host's panes) ; functions only : the module (show_GUI_Pad)
    The host : declares the module "GUI" (blockGUI) and calls show_GUI_Pad(blockGUI) in its dispatcher ; its Set_Table
    starts with jg_IsGUI(tbl) ? jg_Settings(tbl) ; its @serialize ends with jg_Serialize().
*/

<? jg_part != 1 ? _suppress = 1; ?>

//====== GUI : THE STATE, THE SETTINGS, THE RECORD ======
// The values (jg_Get, jg_Set ; saved in this order) : 0 gapx, 1 gapy, 2 frame, 3 radius, 4 thick, 5 color, 6 opacity,
// 7 corners, 8 fade, 9 select, 10 extend, 11 bold, 12 ptext, 13 variant, 14 fonts, 15 ftext, 16 fwidth, 17 contrast,
// 18 fbold, 19 shade ; (2026-11-22, the palette) 20 palette, 21 hue, 22 chroma, 23 light, 24 danger, 25 hover, 26 disabled ;
// 27 tabs (the tabs bar, ui_jg_tabs in ui-lib-JJ-GUI) ; (2026-11-23) 28 fadetime (the cells that fade, ui_jg_fadet) ;
// the theme, the size and the style are saved by the host (jg_SetTheme, jg_SetSize, jg_SetStyle)
JG_NF = 29;
JG_MAGIC = 47181;           // the record of @serialize
jg_kGUI = mSL_symbol("GUI");
jg_kEnd = mSL_symbol("End");
jg_kEof = mSL_symbol("EofMark");
jg_kGapx = mSL_symbol("gapx");
jg_kGapy = mSL_symbol("gapy");
jg_kFrame = mSL_symbol("frame");
jg_kRadius = mSL_symbol("radius");
jg_kThick = mSL_symbol("thick");
jg_kColor = mSL_symbol("color");
jg_kOpacity = mSL_symbol("opacity");
jg_kCorners = mSL_symbol("corners");
jg_kFade = mSL_symbol("fade");
jg_kSelect = mSL_symbol("select");
jg_kExtend = mSL_symbol("extend");
jg_kBold = mSL_symbol("bold");
jg_kPtext = mSL_symbol("ptext");
jg_kFonts = mSL_symbol("fonts");
jg_kFtext = mSL_symbol("ftext");
jg_kFwidth = mSL_symbol("fwidth");
jg_kContrast = mSL_symbol("contrast");
jg_kFbold = mSL_symbol("fbold");
jg_kTheme = mSL_symbol("theme");
jg_kSize = mSL_symbol("size");
jg_kShade = mSL_symbol("shade");
jg_kStyle = mSL_symbol("style");
jg_kVariant = mSL_symbol("variant");
jg_kDefaults = mSL_symbol("defaults");
jg_kNone = mSL_symbol("None"); jg_kRect = mSL_symbol("Rect"); jg_kRound = mSL_symbol("Round");
jg_kCell = mSL_symbol("Cell"); jg_kLighter = mSL_symbol("Lighter"); jg_kDarker = mSL_symbol("Darker");
jg_kGrey = mSL_symbol("Grey");
jg_kClassic = mSL_symbol("Classic"); jg_kSoft = mSL_symbol("Soft");
jg_kStd = mSL_symbol("Std"); jg_kFaded = mSL_symbol("Faded"); jg_kText = mSL_symbol("Text"); jg_kOutline = mSL_symbol("Outline");
jg_kOff = mSL_symbol("Off"); jg_kOn = mSL_symbol("On");
// (2026-11-22) the palette
jg_kPalette = mSL_symbol("palette"); jg_kHue = mSL_symbol("hue"); jg_kChroma = mSL_symbol("chroma");
jg_kLight = mSL_symbol("light"); jg_kDanger = mSL_symbol("danger"); jg_kHover = mSL_symbol("hover");
jg_kDisabled = mSL_symbol("disabled");
jg_kFadet = mSL_symbol("fadetime"); // (2026-11-23)
jg_kTabCnt = mSL_symbol("tabcount"); // (2026-11-23)
jg_kTabs = mSL_symbol("tabs"); jg_kStyleV = mSL_symbol("Style"); jg_kAlways = mSL_symbol("Always"); jg_kHoverV = mSL_symbol("Hover");
jg_kThemeV = mSL_symbol("Theme"); jg_kMono = mSL_symbol("Mono"); jg_kAnalog = mSL_symbol("Analog");
jg_kComplement = mSL_symbol("Complement"); jg_kSpectrum = mSL_symbol("Spectrum"); jg_kMuted = mSL_symbol("Muted");
jg_kPastel = mSL_symbol("Pastel"); jg_kContrastV = mSL_symbol("Contrast");
jg_kRed = mSL_symbol("Red"); jg_kPaletteV = mSL_symbol("Palette");
jg_kAdjust = mSL_symbol("adjust"); jg_kReset = mSL_symbol("reset"); jg_kAll = mSL_symbol("all");
jg_kDefault = mSL_symbol("default"); jg_kRestore = mSL_symbol("restore");
// (2026-11-22) The default of the user (see jg_SaveDef) : jg_hasdef 1 if there is one ; its values (jg_defv : JG_NF words, as
// jg_Get), its style (jg_defStyle) ; the adjustments of its roles at uix_jp_tab + JP_ADJD ; jg_tgt 1 : the keys analyzed
// define it (after the key default, see jg_Run)
jg_hasdef = 0; jg_defStyle = 0; jg_tgt = 0;
jg_defv = make_array(32);
jg_kRAction = mSL_symbol("Action"); jg_kRChoice = mSL_symbol("Choice"); jg_kRNav = mSL_symbol("Navigation");
jg_kRValue = mSL_symbol("Value"); jg_kRObject = mSL_symbol("Object"); jg_kRState = mSL_symbol("State");
jg_kRDanger = mSL_symbol("Danger"); jg_kRInfo = mSL_symbol("Information"); jg_kREmpty = mSL_symbol("Empty");
jg_kRAlert = mSL_symbol("Alert");
jg_tbl = jg_itc = jg_ptr = jg_err = 0;

// (2026-11-22) The adjustments of the roles by the user, by family (the palette) : for the family f (0 ... 7) and the role k
// (1 ... 10, see ui_jpad_rl_action in mSL_ui_Pads), 3 integers : the hue (-180 ... 180 degrees), the lightness (-30 ...
// 30 %), the chroma (-100 ... 100 % of that of the palette) ; in the table of the palette (uix_jp_tab + JP_ADJ ; applied by
// uix_jp_role, ui-lib-JJ-GUI) ; saved after the values of the record (jg_Serialize ; Interstys : its record 'gui2')
JG_NROLE = 10;
jg_adjR = 1; // the role adjusted in the module (not saved)
function jg_Adj(f, k) ( ((uix_jp_tab > 0) && (f >= 0) && (f < 8) && (k >= 0) && (k < 16)) ? uix_jp_tab + JP_ADJ + 3 * (16 * f + k) : 0; );
// (those of the default of the user, see jg_SaveDef)
function jg_AdjD(f, k) ( ((uix_jp_tab > 0) && (f >= 0) && (f < 8) && (k >= 0) && (k < 16)) ? uix_jp_tab + JP_ADJD + 3 * (16 * f + k) : 0; );
function jg_AdjSet(f, k, h, l, c) local(p)
(
    ((p = jg_tgt ? jg_AdjD(f, k) : jg_Adj(f, k)) > 0) ? (
        p[0] = max(-180, min(180, floor(h + 0.5))); p[1] = max(-30, min(30, floor(l + 0.5)));
        p[2] = max(-100, min(100, floor(c + 0.5)));
        uix_jp_dirty = 1; ui_GFXdoNow |= 1;
    );
);
function jg_AdjClear(f) local(k) ( k = 0; loop(16, jg_AdjSet(f, k, 0, 0, 0); k += 1;); );
function jg_AdjAny(f, k) local(p) ( ((p = jg_Adj(f, k)) > 0) && ((p[0] !== 0) || (p[1] !== 0) || (p[2] !== 0)); );
function jg_AdjAnyD(f, k) local(p) ( ((p = jg_AdjD(f, k)) > 0) && ((p[0] !== 0) || (p[1] !== 0) || (p[2] !== 0)); );
// the count of the roles adjusted (all the families ; d : those of the default of the user)
function jg_AdjN() local(i, n) ( n = i = 0; loop(128, jg_AdjAny(i >> 4, i & 15) ? n += 1; i += 1;); n; );
function jg_AdjND() local(i, n) ( n = i = 0; loop(128, jg_AdjAnyD(i >> 4, i & 15) ? n += 1; i += 1;); n; );
// the adjustments copied : d 1 the current ones into those of the default, 0 the reverse
function jg_AdjCopy(d) local(i, a, b)
(
    (uix_jp_tab > 0) ? (
        a = uix_jp_tab + (d ? JP_ADJ : JP_ADJD); b = uix_jp_tab + (d ? JP_ADJD : JP_ADJ);
        i = 0; loop(384, b[i] = a[i]; i += 1;);
        uix_jp_dirty = 1;
    );
);

// The factory defaults (2026-11-22, the user's choice : tabs Always, palette Pastel, variation Outline, gapx 40, gapy 4,
// frame Rect, corners as each pad, thick 0 ; no adjustment of the roles ; the style unchanged here : also called by the load
// of a project, before the values saved, the style being restored by the host ; jg_Factory : the style Classic too)
function jg_Defaults() local(f, t)
(
    t = jg_tgt; jg_tgt = 0; f = 0; loop(8, jg_AdjClear(f); f += 1;); jg_tgt = t; // (the current adjustments)
    ui_jg_gapx = 40; ui_jg_gapy = 4; ui_jg_frame = 1; ui_jg_radius = 6; ui_jg_thick = 0; ui_jg_fcol = 1; ui_jg_falpha = 0.7;
    ui_jg_cround = -1; ui_jpad_fade = 40; ui_jpad_selmix = 0.35; ui_jg_extend = 0; ui_jg_bold = 0; ui_jg_ptext = 100;
    ui_jvariant = 3; ui_jg_ftext = 100; ui_jg_fwidth = 100; ui_jg_tcontrast = 0.35;
    ui_jg_fbold = 0; ui_jg_bgk = 0; ui_jg_tabs = 1; ui_jg_fadet = 10;
    ui_jp_fam = 6; ui_jp_hue = -1; ui_jp_chroma = 50; ui_jp_light = 50; ui_jp_danger = 0; ui_jp_hover = 60; ui_jp_dis = 70;
    uix_jp_dirty = 1; // (the palette, see uix_jp_make in ui-lib-JJ-GUI)
    (ui_jg_fonts !== 100) ? ui_jtext_set(100);
    ui_lib_JJ_updSiz(); // (the lines of the pads and of the faders)
    ui_GFXdoNow |= 1;
);

// The value k (0 ... JG_NF - 1 ; integers), set (in its range)
function jg_Get(k)
(
    (k === 0) ? ui_jg_gapx : (k === 1) ? ui_jg_gapy : (k === 2) ? ui_jg_frame : (k === 3) ? ui_jg_radius :
    (k === 4) ? ui_jg_thick : (k === 5) ? ui_jg_fcol : (k === 6) ? floor(ui_jg_falpha * 100 + 0.5) :
    (k === 7) ? ui_jg_cround : (k === 8) ? ui_jpad_fade : (k === 9) ? floor(ui_jpad_selmix * 100 + 0.5) :
    (k === 10) ? ui_jg_extend : (k === 11) ? ui_jg_bold : (k === 12) ? ui_jg_ptext : (k === 13) ? ui_jvariant :
    (k === 14) ? ui_jg_fonts : (k === 15) ? ui_jg_ftext : (k === 16) ? ui_jg_fwidth :
    (k === 17) ? floor(ui_jg_tcontrast * 100 + 0.5) : (k === 18) ? ui_jg_fbold : (k === 19) ? ui_jg_bgk :
    (k === 20) ? ui_jp_fam : (k === 21) ? ui_jp_hue : (k === 22) ? ui_jp_chroma : (k === 23) ? ui_jp_light :
    (k === 24) ? ui_jp_danger : (k === 25) ? ui_jp_hover : (k === 26) ? ui_jp_dis : (k === 27) ? ui_jg_tabs :
    (k === 28) ? ui_jg_fadet : 0;
);
function jg_Set(k, v)
(
    v = floor(v + 0.5);
    (k === 0) ? (ui_jg_gapx = max(0, min(200, v))) :
    (k === 1) ? (ui_jg_gapy = max(0, min(10, v))) :
    (k === 2) ? (ui_jg_frame = max(0, min(2, v))) :
    (k === 3) ? (ui_jg_radius = max(0, min(20, v))) :
    (k === 4) ? (ui_jg_thick = max(0, min(4, v))) : // (0 : no frame, no classic border, see control_jpad)
    (k === 5) ? (ui_jg_fcol = max(0, min(3, v))) :
    (k === 6) ? (ui_jg_falpha = max(5, min(100, v)) / 100) :
    (k === 7) ? (ui_jg_cround = max(-1, min(20, v))) :
    (k === 8) ? (ui_jpad_fade = max(0, min(80, v))) :
    (k === 9) ? (ui_jpad_selmix = max(0, min(80, v)) / 100) :
    (k === 10) ? (ui_jg_extend = (v != 0)) :
    (k === 11) ? (ui_jg_bold = (v != 0)) :
    (k === 12) ? (ui_jg_ptext = max(80, min(150, v)); ui_lib_JJ_updSiz();) : // (the lines of the pads, ui-lib-JJ-GUI)
    (k === 13) ? (ui_jvariant = max(-1, min(3, v))) :
    (k === 14) ? (v = max(80, min(150, v)); (v !== ui_jg_fonts) ? ui_jtext_set(v)) :
    (k === 15) ? (ui_jg_ftext = max(70, min(150, v)); ui_lib_JJ_updSiz();) : // (the lines of the faders)
    (k === 16) ? (ui_jg_fwidth = max(50, min(200, v))) :
    (k === 17) ? (ui_jg_tcontrast = max(10, min(80, v)) / 100) :
    (k === 18) ? (ui_jg_fbold = (v != 0)) :
    (k === 19) ? (ui_jg_bgk = max(-80, min(80, v))) :
    (k === 20) ? (ui_jp_fam = max(0, min(7, v))) :
    (k === 21) ? (ui_jp_hue = max(-1, min(359, v))) :
    (k === 22) ? (ui_jp_chroma = max(0, min(100, v))) :
    (k === 23) ? (ui_jp_light = max(0, min(100, v))) :
    (k === 24) ? (ui_jp_danger = (v != 0)) :
    (k === 25) ? (ui_jp_hover = max(0, min(100, v))) :
    (k === 26) ? (ui_jp_dis = max(0, min(100, v))) :
    (k === 27) ? (ui_jg_tabs = max(0, min(2, v))) :
    (k === 28) ? (ui_jg_fadet = max(0, min(60, v)));
    uix_jp_dirty = 1; // (the palette made again : the background, the selection, the palette)
    ui_GFXdoNow |= 1;
);
// The default of the value k
function jg_Def(k)
(
    (k === 0) ? 40 : (k === 1) ? 4 :
    (k === 2) ? 1 : (k === 3) ? 6 : (k === 4) ? 0 : (k === 5) ? 1 : (k === 6) ? 70 : (k === 7) ? -1 : (k === 8) ? 40 :
    (k === 9) ? 35 : (k === 12) ? 100 : (k === 13) ? 3 : (k === 14) ? 100 : (k === 15) ? 100 : (k === 16) ? 100 :
    (k === 17) ? 35 : (k === 20) ? 6 : (k === 21) ? -1 : (k === 22) ? 50 : (k === 23) ? 50 : (k === 25) ? 60 :
    (k === 26) ? 70 : (k === 27) ? 1 : (k === 28) ? 10 : 0;
);
// (2026-11-22) The palette : the name of the family f (0 ... 7), its symbol
JG_NFAM = 8;
function jg_FamName(f)
(
    (f === 1) ? "Mono" : (f === 2) ? "Analog" : (f === 3) ? "Complement" : (f === 4) ? "Spectrum" : (f === 5) ? "Muted" :
    (f === 6) ? "Pastel" : (f === 7) ? "Contrast" : "Theme";
);
function jg_FamSym(f)
(
    (f === 1) ? jg_kMono : (f === 2) ? jg_kAnalog : (f === 3) ? jg_kComplement : (f === 4) ? jg_kSpectrum :
    (f === 5) ? jg_kMuted : (f === 6) ? jg_kPastel : (f === 7) ? jg_kContrastV : jg_kThemeV;
);
// the symbol of the role k
function jg_RoleSym(k)
(
    (k === 1) ? jg_kRAction : (k === 2) ? jg_kRChoice : (k === 3) ? jg_kRNav : (k === 4) ? jg_kRValue :
    (k === 5) ? jg_kRObject : (k === 6) ? jg_kRState : (k === 7) ? jg_kRDanger : (k === 8) ? jg_kRInfo :
    (k === 9) ? jg_kREmpty : (k === 10) ? jg_kRAlert : -1;
);
// the name of the role k (see ui_jpad_rl_action in mSL_ui_Pads)
function jg_RoleName(k)
(
    (k === 1) ? "Action" : (k === 2) ? "Choice" : (k === 3) ? "Navigation" : (k === 4) ? "Value" : (k === 5) ? "Object" :
    (k === 6) ? "State" : (k === 7) ? "Danger" : (k === 8) ? "Information" : (k === 9) ? "Empty" : (k === 10) ? "Alert" : "-";
);
