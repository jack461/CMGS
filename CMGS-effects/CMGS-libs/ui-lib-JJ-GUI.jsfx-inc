/*
    The bitmap themes (3 to 11) : their PNG images are in REAPER/Data/CMGS-data/themes (a path relative to the
    "Data" folder of REAPER). gfx_loadimg does nothing in @init : the image of the current theme is loaded here,
    in @gfx, when the theme changes ; uix_jtheme_img, reset in @init, forces a new load after a recompilation.
    The images keep the slots of the former "filename:" lines : 0, 2 to 9 (slot 1 is the reserved screen of ui-lib,
    uix_control_reserved_screen). A missing image (CMGS-data not installed) has a null width : the caller then uses
    the theme "default". Returns the slot of the image, or -1.
*/
function uix_jtheme_load() local(slot, w, h)
(
    slot = (uix_jtheme == 3) ? 0 : ((uix_jtheme >= 4) && (uix_jtheme <= 11)) ? uix_jtheme - 2 : -1;
    (slot >= 0) ? (
        (uix_jtheme_img != uix_jtheme) ? (
            uix_jtheme_img = uix_jtheme;
            sprintf(#uix_jtheme_path, "CMGS-data/themes/theme-%s.png",
                (slot == 0) ? "cyan" : (slot == 2) ? "dark-orange" : (slot == 3) ? "dark-blue" :
                (slot == 4) ? "dark-cyan" : (slot == 5) ? "dark-green" : (slot == 6) ? "dark-red" :
                (slot == 7) ? "amber" : (slot == 8) ? "dark-neon-green" : "magenta");
            gfx_loadimg(slot, #uix_jtheme_path);
        );
        w = h = 0;
        gfx_getimgdim(slot, w, h);
        (w <= 0) ? slot = -1;
    );
    slot;
);


// (2026-11-21) The background darker or lighter (rubric GUI : ui_jg_bgk) : its color, after the change (uix_jbg_r, _g, _b :
// 0 ... 1) ; a veil (black or white) over the image of the themes Tron and bitmap, or their plain color changed
function uix_jbg_color() local(k, w, r, g, b, od)
(
    k = max(-0.9, min(0.9, ui_jg_bgk / 100)); w = (k > 0);
    (uix_control_theme === 3) ? (
        // the image of the theme : a pixel of its tile (see control_start)
        od = gfx_dest; gfx_dest = uix_control_theme_buffer; gfx_x = gfx_y = 80; r = g = b = 0; gfx_getpixel(r, g, b);
        gfx_dest = od;
    ) : (uix_control_theme === 2) ? (
        r = g = b = 70 / 255;
    ) : (
        r = (gfx_clear & 255) / 255; g = ((gfx_clear >> 8) & 255) / 255; b = ((gfx_clear >> 16) & 255) / 255;
    );
    uix_jbg_r = r + abs(k) * (w - r); uix_jbg_g = g + abs(k) * (w - g); uix_jbg_b = b + abs(k) * (w - b);
);
// the background (uix_jbg_r ...) moved by d toward white (dark) or black (light) : a packed color
function uix_jbg_shift(d) local(w, r, g, b)
(
    w = ((0.299 * uix_jbg_r + 0.587 * uix_jbg_g + 0.114 * uix_jbg_b) < 0.5);
    r = uix_jbg_r + d * (w - uix_jbg_r); g = uix_jbg_g + d * (w - uix_jbg_g); b = uix_jbg_b + d * (w - uix_jbg_b);
    ((0|(r * 255 + 0.5)) << 16) | ((0|(g * 255 + 0.5)) << 8) | (0|(b * 255 + 0.5));
);
function uix_jbg_draw() local(k)
(
    k = max(-0.9, min(0.9, ui_jg_bgk / 100));
    ((uix_control_theme === 2) || (uix_control_theme === 3)) ? (
        gfx_set(k > 0, k > 0, k > 0, abs(k)); // (the veil)
        gfx_rect(0, 0, gfx_w, gfx_h);
    ) : (
        uix_jbg_color(); // (the plain color : drawn, and the clear color of the next frames)
        gfx_set(uix_jbg_r, uix_jbg_g, uix_jbg_b, 1);
        gfx_rect(0, 0, gfx_w, gfx_h);
        gfx_clear = (0|(uix_jbg_r * 255 + 0.5)) + 256 * (0|(uix_jbg_g * 255 + 0.5)) + 65536 * (0|(uix_jbg_b * 255 + 0.5));
    );
    gfx_a = 1;
);

/*
   (2026-11-22) The palette (rubric GUI, step 2) : the colors of the cells that have a role (see ui_jpad_rl_action in
   mSL_ui_Pads), computed in OKLCH (the same perceived lightness for all the roles), from the theme, its background (made
   darker or lighter : ui_jg_bgk) and the settings of the module GUI (mSL_GUI) :
     ui_jp_fam      the family : 0 Theme (the action cells in the color of the buttons of the theme, the other roles its
                    neighbours), 1 Mono (one hue : the roles by their lightness), 2 Analog (neighbouring hues), 3 Complement
                    (the commands on one side of the circle, the data opposite, the signals between), 4 Spectrum (six hues
                    around the circle), 5 Muted (neighbouring hues, little saturated), 6 Pastel (light cells, dark text),
                    7 Contrast (fixed hues, Okabe-Ito : distinct with a color blindness)
     ui_jp_hue      the base hue (0 ... 359 degrees) ; -1 : that of the theme (the family Theme : always)
     ui_jp_chroma   the saturation (0 ... 100 %)
     ui_jp_light    the lightness (0 ... 100 %)
     ui_jp_danger   0 : the cells Danger in red ; 1 : in a hue of the palette
     ui_jp_hover    the strength of the mode "hover" (0 ... 100 %) ; "selected" : ui_jpad_selmix x 2 ; "disabled" : ui_jp_dis
   The table uix_jp_tab (JP_TABSIZE words, made by mSL_GUI, part 1 : uix_jp_init) : for the role k (1 ... 15) and the mode
   m (0 rest, 1 hover, 2 pressed, 3 selected, 4 disabled, 5 locked), at 8 k + m the fill, + 128 its text, + 256 the text
   on the background (the variation Text) ; the identity series (16 colors, the role Object) the same from 384 ; the data
   of the families from 896 ; the pads with roles (uix_jhv_tab, see mSL_ui_LibJJ) from 1040 ; (2026-11-22) the adjustments
   of the roles by the user from JP_ADJ (1152 : for the family f and the role k, at 3 (16 f + k) : the hue in degrees, the
   lightness in %, the chroma in % of that of the palette ; see jg_AdjSet in mSL_GUI). Made again by update_theme
   when uix_jp_dirty (a setting, the theme, the background, the variation changed). The measures (uix_jp_measure) : the
   least contrast of a text, the least difference between two roles, between a role and the background.
*/
JP_TABSIZE = 1920; JP_ADJ = 1152; JP_ADJD = 1536; // (JP_ADJD : the adjustments of the default of the user, see jg_SaveDef in mSL_GUI)
ui_jp_fam = 0; ui_jp_hue = -1; ui_jp_chroma = 50; ui_jp_light = 50; ui_jp_danger = 0; ui_jp_hover = 60; ui_jp_dis = 70;
uix_jp_dirty = 1; uix_jp_vr = -1; uix_jp_vtx = 0; uix_jp_itx = 0;
uix_jp_mTxt = uix_jp_mDe = uix_jp_mBg = 0; uix_jp_mTxtR = uix_jp_mDeA = uix_jp_mDeB = uix_jp_mBgR = 0;

// sRGB <-> linear ; the cube root (of a negative number too)
function uix_jp_lin(c) ( (c <= 0.04045) ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4; );
function uix_jp_delin(c) ( c = max(0, min(1, c)); (c <= 0.0031308) ? 12.92 * c : 1.055 * (c ^ (1 / 2.4)) - 0.055; );
function uix_jp_cbrt(x) ( (x >= 0) ? x ^ (1 / 3) : -((-x) ^ (1 / 3)); );
