function uix_jp_lab(c) local(r, g, b, x, y, z)
(
    r = uix_jp_lin(((c >> 16) & 255) / 255); g = uix_jp_lin(((c >> 8) & 255) / 255); b = uix_jp_lin((c & 255) / 255);
    x = uix_jp_cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    y = uix_jp_cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    z = uix_jp_cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    uix_jp_oL = 0.2104542553 * x + 0.7936177850 * y - 0.0040720468 * z;
    uix_jp_oa = 1.9779984951 * x - 2.4285922050 * y + 0.4505937099 * z;
    uix_jp_ob = 0.0259040371 * x + 0.7827717662 * y - 0.8086757660 * z;
);
// in OKLCH : uix_jp_cL, uix_jp_cC, uix_jp_cH (degrees)
function uix_jp_lch(c)
(
    uix_jp_lab(c);
    uix_jp_cL = uix_jp_oL; uix_jp_cC = sqrt(sqr(uix_jp_oa) + sqr(uix_jp_ob));
    uix_jp_cH = atan2(uix_jp_ob, uix_jp_oa) * 180 / $pi; (uix_jp_cH < 0) ? uix_jp_cH += 360;
);
// OKLab -> linear sRGB (uix_jp_lr, uix_jp_lg, uix_jp_lb) ; 1 if in the gamut
function uix_jp_tolin(ll, aa, bb) local(x, y, z)
(
    x = ll + 0.3963377774 * aa + 0.2158037573 * bb; x = x * x * x;
    y = ll - 0.1055613458 * aa - 0.0638541728 * bb; y = y * y * y;
    z = ll - 0.0894841775 * aa - 1.2914855480 * bb; z = z * z * z;
    uix_jp_lr = 4.0767416621 * x - 3.3077115913 * y + 0.2309699292 * z;
    uix_jp_lg = -1.2684380046 * x + 2.6097574011 * y - 0.3413193965 * z;
    uix_jp_lb = -0.0041960863 * x - 0.7034186147 * y + 1.7076147010 * z;
    (uix_jp_lr >= -0.0001) && (uix_jp_lr <= 1.0001) && (uix_jp_lg >= -0.0001) && (uix_jp_lg <= 1.0001) &&
        (uix_jp_lb >= -0.0001) && (uix_jp_lb <= 1.0001);
);
// OKLCH -> a packed color ; out of the gamut : the chroma reduced (the same lightness, the same hue)
function uix_jp_mk(ll, cc, hh) local(ca, sa, lo, hi, md)
(
    ll = max(0, min(1, ll)); cc = max(0, cc);
    ca = cos(hh * $pi / 180); sa = sin(hh * $pi / 180);
    !uix_jp_tolin(ll, cc * ca, cc * sa) ? (
        lo = 0; hi = cc;
        loop(20, md = (lo + hi) / 2; uix_jp_tolin(ll, md * ca, md * sa) ? (lo = md) : (hi = md););
        uix_jp_tolin(ll, lo * ca, lo * sa);
    );
    ((0|(uix_jp_delin(uix_jp_lr) * 255 + 0.5)) << 16) | ((0|(uix_jp_delin(uix_jp_lg) * 255 + 0.5)) << 8) |
        (0|(uix_jp_delin(uix_jp_lb) * 255 + 0.5));
);
// the luminance (WCAG) ; the contrast of two colors (1 ... 21) ; the text (light or dark) the most readable on c
function uix_jp_lum(c)
(
    0.2126 * uix_jp_lin(((c >> 16) & 255) / 255) + 0.7152 * uix_jp_lin(((c >> 8) & 255) / 255) +
        0.0722 * uix_jp_lin((c & 255) / 255);
);
function uix_jp_ctr(c1, c2) local(x, y) ( x = uix_jp_lum(c1); y = uix_jp_lum(c2); (max(x, y) + 0.05) / (min(x, y) + 0.05); );
function uix_jp_best(c) ( (uix_jp_ctr(0xF6F7F8, c) >= uix_jp_ctr(0x121314, c)) ? 0xF6F7F8 : 0x121314; );
// the difference of two colors (in OKLab, x 100)
function uix_jp_dist(c1, c2) local(l1, a1, b1)
(
    uix_jp_lab(c1); l1 = uix_jp_oL; a1 = uix_jp_oa; b1 = uix_jp_ob;
    uix_jp_lab(c2);
    100 * sqrt(sqr(l1 - uix_jp_oL) + sqr(a1 - uix_jp_oa) + sqr(b1 - uix_jp_ob));
);
// a text in the color (ll, cc, hh), readable on the background (contrast 4.5 at least : lighter on a dark background,
// darker on a light one)
function uix_jp_tbg(ll, cc, hh) local(c, i, go)
(
    cc = min(cc, 0.17); go = 1; i = 0;
    while (go && (i < 50)) (
        c = uix_jp_mk(ll, cc, hh);
        (uix_jp_ctr(c, uix_jp_bgc) >= 4.5) ? (go = 0) : (ll = max(0, min(1, ll + uix_jp_dir * 0.02)); i += 1;);
    );
    go ? uix_jp_best(uix_jp_bgc) : c;
);
// the lightness of the color (uix_jp_cL) at least d away from that of the background
function uix_jp_sep(d) ( (abs(uix_jp_cL - uix_jp_bgL) < d) ? uix_jp_cL = uix_jp_bgL + ((uix_jp_bgL < 0.5) ? d : -d); );
// the fixed colors of the family Contrast (Okabe-Ito) : action, choice, navigation, value, object, state, danger, other
function uix_jp_oi(i)
(
    (i === 0) ? 0x0072B2 : (i === 1) ? 0xE69F00 : (i === 2) ? 0x56B4E9 : (i === 3) ? 0x009E73 : (i === 4) ? 0xCC79A7 :
    (i === 5) ? 0xF0E442 : (i === 6) ? 0xD55E00 : 0x8E7CC3;
);
// a fixed color, its lightness and its chroma following the settings
function uix_jp_fix(c)
(
    uix_jp_lch(c);
    uix_jp_cL = max(0.22, min(0.94, uix_jp_cL + (uix_jp_v - 0.5) * 0.3)); uix_jp_cC *= (0.5 + uix_jp_s);
    uix_jp_sep(0.1);
);
// the color of the buttons of the theme (the family Theme, the base hue "theme")
function uix_jp_btn()
(
    (uix_control_theme === 3) ? (uix_control_pcolor_from_theme(240, 50, 1) & 0xffffff) :
    (uix_control_theme === 2) ? 0x4A9CBD : (uix_control_theme === 1) ? (uix_black_light & 0xffffff) : 0x40668C;
);
// the least difference between the color c and the roles 1 ... n at rest (already in the table)
function uix_jp_near(c, n) local(j, d, m)
(
    m = 999; j = 1;
    loop(n, d = uix_jp_dist(c, uix_jp_tab[8 * j]); (d < m) ? m = d; j += 1;);
    m;
);
// the base color of the role rk (1 ... 15) : uix_jp_cL, uix_jp_cC, uix_jp_cH
function uix_jp_role(rk) local(f, i, p)
(
    f = max(0, min(7, ui_jp_fam));
    (rk === 8) ? (
        // Information : close to the background, the text of the theme
        uix_jp_cL = uix_jp_bgL + uix_jp_dir * (uix_jp_dark ? 0.09 : 0.07); uix_jp_cC = min(0.02, uix_jp_baseC * 0.3);
        uix_jp_cH = uix_jp_h0;
    ) : (rk === 9) ? (
        // Empty : hardly visible
        uix_jp_cL = uix_jp_bgL + uix_jp_dir * 0.035; uix_jp_cC = 0.008; uix_jp_cH = uix_jp_h0;
    ) : (rk === 7) ? (
