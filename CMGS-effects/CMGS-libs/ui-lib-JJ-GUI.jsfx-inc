function uix_jp_ident(i) local(f, j, a)
(
    f = max(0, min(7, ui_jp_fam)); j = i & 7;
    (f === 1) ? (
        uix_jp_cL = 0.34 + 0.5 * j / 7; uix_jp_cC = uix_jp_baseC * ((i >= 8) ? 0.55 : 1); uix_jp_cH = uix_jp_h0;
        uix_jp_sep(0.1);
    ) : (f === 7) ? (
        uix_jp_fix(uix_jp_oi(j)); (i >= 8) ? uix_jp_cL = max(0.2, min(0.95, uix_jp_cL - 0.12));
    ) : (
        a = (i >= 8) ? -0.08 : (j & 1) ? -0.03 : 0.03;
        uix_jp_cL = max(0.15, min(0.95, uix_jp_baseL + a)); uix_jp_cC = uix_jp_baseC;
        uix_jp_cH = uix_jp_h0 + 45 * j + ((i >= 8) ? 22.5 : 0);
        uix_jp_sep(0.1);
    );
);
// the 6 modes of the color (uix_jp_cL, uix_jp_cC, uix_jp_cH) into base[8 k + m] (+ 128 the text on it, + 256 the text on the
// background) ; info : the text of the theme
function uix_jp_modes(base, k, info) local(kh, ks, kd, m, ll, cc, hh, p, c)
(
    kh = max(0, min(100, ui_jp_hover)) / 100; ks = max(0, min(1.6, ui_jpad_selmix * 2)); kd = max(0, min(100, ui_jp_dis)) / 100;
    m = 0;
    loop(6,
        ll = uix_jp_cL; cc = uix_jp_cC; hh = uix_jp_cH;
        (m === 1) ? ( ll += uix_jp_dir * 0.08 * kh; ) :                              // hover
        (m === 2) ? ( ll -= uix_jp_dir * 0.09; cc = cc * 1.1 + 0.01; ) :             // pressed
        (m === 3) ? ( ll += uix_jp_dir * 0.1 * ks; cc = cc * (1 + 0.7 * ks) + 0.02 * ks; ) : // selected
        (m === 4) ? ( ll += (uix_jp_bgL - ll) * 0.6 * kd; cc *= (1 - 0.85 * kd); ) :  // disabled
        (m === 5) ? ( cc *= 0.5; );                                                   // locked
        p = 8 * k + m;
        base[p] = c = uix_jp_mk(ll, cc, hh);
        // (the text of the informations : kept down to a contrast of 3, its color may be adjusted by the user)
        base[128 + p] = (info && (uix_jp_ctr(uix_jp_itx, c) >= 3)) ? uix_jp_itx : uix_jp_best(c);
        // (the text on the background : only for the variation Text, uix_jp_vtx : the slowest one)
        base[256 + p] = info ? uix_jp_itx : uix_jp_vtx ? uix_jp_tbg(ll, cc, hh) : base[128 + p];
        m += 1;
    );
    p = 8 * k; base[p + 6] = base[p + 7] = base[p]; base[p + 134] = base[p + 135] = base[p + 128];
    base[p + 262] = base[p + 263] = base[p + 256];
);
// the measures : the least contrast of the texts (uix_jp_mTxt, its role uix_jp_mTxtR), the least difference between two
// roles (uix_jp_mDe : uix_jp_mDeA, uix_jp_mDeB), between a role and the background (uix_jp_mBg : uix_jp_mBgR ; the variation
// Text : none) ; in the variation Text, the colors of the texts
function uix_jp_measure() local(t, vr, k, j, r, d)
(
    t = uix_jp_tab; vr = (ui_jvariant >= 0) ? min(3, ui_jvariant) : (ui_jstyle != 0); uix_jp_vr = vr;
    uix_jp_mTxt = 99; uix_jp_mTxtR = 0;
    k = 1; loop(10,
        (k !== 9) ? (
            r = (vr >= 2) ? uix_jp_ctr(t[256 + 8 * k], uix_jp_bgc) : uix_jp_ctr(t[128 + 8 * k], t[8 * k]);
            (r < uix_jp_mTxt) ? (uix_jp_mTxt = r; uix_jp_mTxtR = k;);
        );
        k += 1;
    );
    uix_jp_mDe = 999; uix_jp_mDeA = uix_jp_mDeB = 0;
    // (the roles 1 ... 7 and 10, Alert)
    k = 1; loop(7,
        j = k + 1; loop(8 - k,
            (j === 8) ? (j = 10);
            d = (vr >= 2) ? uix_jp_dist(t[256 + 8 * k], t[256 + 8 * j]) : uix_jp_dist(t[8 * k], t[8 * j]);
            (d < uix_jp_mDe) ? (uix_jp_mDe = d; uix_jp_mDeA = k; uix_jp_mDeB = j;);
            j += 1;
        );
        k += 1;
    );
    uix_jp_mBg = 999; uix_jp_mBgR = 0;
    (vr < 2) ? (
        k = 1; loop(8, (k === 8) ? (k = 10); d = uix_jp_dist(t[8 * k], uix_jp_bgc); (d < uix_jp_mBg) ? (uix_jp_mBg = d; uix_jp_mBgR = k;); k += 1;);
    );
);
// The palette made again (update_theme, when uix_jp_dirty)
function uix_jp_make() local(t, f, k, v, s, ll, cc, hh, c)
(
    (uix_jp_tab > 0) ? (
        t = uix_jp_tab; f = max(0, min(7, ui_jp_fam));
        uix_jp_vtx = ((ui_jvariant >= 0) ? min(3, ui_jvariant) : (ui_jstyle != 0)) >= 2; // (the variations Text, Outline)
        // the background (that of the theme, made darker or lighter : uix_jbg_color), the texts of the theme
        uix_jbg_color();
        uix_jp_bgc = ((0|(uix_jbg_r * 255 + 0.5)) << 16) | ((0|(uix_jbg_g * 255 + 0.5)) << 8) | (0|(uix_jbg_b * 255 + 0.5));
        uix_jp_lab(uix_jp_bgc); uix_jp_bgL = uix_jp_oL;
        uix_jp_dark = (uix_jp_bgL < 0.6); uix_jp_dir = uix_jp_dark ? 1 : -1;
        uix_jp_txt = ui_jcolor_text & 0xffffff;
        (uix_jp_ctr(uix_jp_txt, uix_jp_bgc) < 4.5) ? uix_jp_txt = uix_jp_best(uix_jp_bgc);
        // the base : its lightness, its chroma, its hue
        uix_jp_lch(uix_jp_btn()); ll = uix_jp_cL; cc = uix_jp_cC; hh = uix_jp_cH;
        v = uix_jp_v = max(0, min(100, ui_jp_light)) / 100; s = uix_jp_s = max(0, min(100, ui_jp_chroma)) / 100;
        uix_jp_h0 = ((f === 0) || (ui_jp_hue < 0)) ? hh : ui_jp_hue;
        (f === 0) ? (
            uix_jp_baseL = max(0.2, min(0.92, ll + (v - 0.5) * 0.5)); uix_jp_baseC = cc * 2 * s;
        ) : (f === 6) ? (
            uix_jp_baseL = max(0.62, min(0.93, 0.80 + (v - 0.5) * 0.24)); uix_jp_baseC = 0.025 + 0.08 * s;
        ) : (
            uix_jp_baseL = 0.30 + 0.58 * v; uix_jp_baseC = 0.02 + 0.18 * s;
        );
        (f === 5) ? uix_jp_baseC *= 0.45;
        (abs(uix_jp_baseL - uix_jp_bgL) < 0.12) ? uix_jp_baseL = uix_jp_bgL + ((uix_jp_bgL < 0.5) ? 0.12 : -0.12);
        // (2026-11-22) the text of the informations : on a dark background, a light tint of the base hue (white was too harsh)
        uix_jp_itx = uix_jp_txt;
        uix_jp_dark ? (
            c = uix_jp_mk(0.9, 0.035, uix_jp_h0);
            (uix_jp_ctr(c, uix_jp_bgc) >= 4.5) ? uix_jp_itx = c;
        );
        // the adjustments of the role Information (the family f) : its text too (the hue, the lightness ; the chroma added :
        // 0.12 for 100 %)
        k = uix_jp_tab + JP_ADJ + 3 * (16 * f + 8);
        ((k[0] !== 0) || (k[1] !== 0) || (k[2] !== 0)) ? (
            uix_jp_lch(uix_jp_itx);
            uix_jp_itx = uix_jp_mk(max(0, min(1, uix_jp_cL + k[1] / 100)), max(0, uix_jp_cC + 0.12 * k[2] / 100), uix_jp_h0 + k[0]);
        );
        // the roles 1 ... 15 (11 ... 15 : free, the base), the identity series
        k = 1; loop(15, uix_jp_role(k); uix_jp_modes(t, k, (k === 8)); k += 1;);
        k = 0; loop(16, uix_jp_ident(k); uix_jp_modes(t + 384, k, 0); k += 1;);
        uix_jp_measure();
    );
    uix_jp_vr = (ui_jvariant >= 0) ? min(3, ui_jvariant) : (ui_jstyle != 0); // (also without a palette : made once)
    uix_jp_dirty = 0;
);
// the data of the families (6 values : action, choice, navigation, value, object, state) : hue offsets (degrees), lightness
// offsets, chroma factors
function uix_jp_f6(p, a, b, c, d, e, g) ( p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = g; );
// The table of the palette (JP_TABSIZE words : mSL_GUI, part 1, in @init ; 0 : no palette, the roles not drawn)
function uix_jp_init(tab) local(p, f)
(
    (tab > 0) ? (
        uix_jp_tab = tab; uix_jhv_tab = tab + 1040; uix_jhvN = 0; uix_jhv_cur = -1;
        p = tab + 896;
        uix_jp_f6(p, 0, 30, 60, -40, -75, 105); uix_jp_f6(p + 6, 0, -0.04, 0.04, 0, -0.05, 0.12); p += 18;   // 0 Theme
        uix_jp_f6(p, 0, 0, 0, 0, 0, 0); uix_jp_f6(p + 6, 0, -0.07, 0.07, -0.14, 0.14, 0.21); p += 18;        // 1 Mono
        uix_jp_f6(p, 0, 25, 50, -35, -65, 85); uix_jp_f6(p + 6, 0, -0.03, 0.03, 0, -0.04, 0.12); p += 18;    // 2 Analog
        uix_jp_f6(p, 0, 30, -30, 180, 210, 95); uix_jp_f6(p + 6, 0, -0.04, 0.04, 0, -0.05, 0.12); p += 18;   // 3 Complement
        uix_jp_f6(p, 0, 60, 120, 180, 240, 300); uix_jp_f6(p + 6, 0, 0, 0, 0, 0, 0); p += 18;                // 4 Spectrum
        uix_jp_f6(p, 0, 35, 70, -40, -80, 120); uix_jp_f6(p + 6, 0, -0.04, 0.04, 0, -0.05, 0.06); p += 18;   // 5 Muted
        uix_jp_f6(p, 0, 60, 120, 180, 240, 300); uix_jp_f6(p + 6, 0, 0, 0, 0, 0, 0); p += 18;                // 6 Pastel
        uix_jp_f6(p, 0, 0, 0, 0, 0, 0); uix_jp_f6(p + 6, 0, 0, 0, 0, 0, 0);                                  // 7 Contrast (fixed)
        f = 0; loop(8, uix_jp_f6(tab + 896 + 18 * f + 12, 1, 1, 1, 1, 1, 1); f += 1;);
        uix_jp_f6(tab + 896 + 18 + 12, 1, 0.85, 0.85, 0.7, 0.7, 1.3); // (Mono : the chroma by role)
        // (2026-11-22) State, lighter and less saturated (more pastel) in the families Theme, Analog, Complement
        tab[896 + 12 + 5] = tab[896 + 36 + 12 + 5] = tab[896 + 54 + 12 + 5] = 0.7;
        uix_jp_dirty = 1;
    );
);

function update_theme() local(main, img)
(
    main = main_screen(uix_jG_menuscr);
    ui_spec_jd_ctgr = 0;

    (uix_jtheme == 1) ? (
        control_start(main, "black");
    ) :
    (uix_jtheme == 2) ? (
        ui_spec_jd_ctgr = 6;
        control_start(main, "tron");
    ) :
    ((img = uix_jtheme_load()) >= 0) ? (
        control_start(main, "bitmap-simple", img);
    ) : (
        control_start(main, "default");
    );
    // the same font size in all the themes (the theme "black" sets 20) ; their font faces differ
    ui_fontsize(uix_default_fontsize);

    // did we change the theme ?
    uix_jtheme_prev != uix_jtheme ? (
        // if so, recompute the colors we will be using
        ui_GFXdoNow |= 1;
        ui_GFXReason = 42;
        AAAA_chg_jtheme += 1;
        uix_jtheme_prev = uix_jtheme;
        prev_control_theme = uix_control_theme;
        ui_jcolor_text = ui_jcolor_text0 = uix_theme_pcolor("text");
        uix_jbg_k = -1000; // (the texts and the background again, see below)
        uix_jp_dirty = 1; // (the palette again, see below)
        ui_jcolor_draw = ui_jcolor_draw0 = uix_theme_pcolor("draw");
        ui_jcolor_draw_bg = uix_theme_pcolor("bg-enabled");
        ui_jcolor_border = ui_jcolor_border0 = uix_theme_pcolor("border");
        uix_control_width_prev += 1; // make sure to reset

        ui_lib_JJ_updSiz();

    );
    // (2026-11-21) the background darker or lighter (rubric GUI : ui_jg_bgk) : the color of the texts made readable on it ;
    // the veil (or the plain color) drawn first, over the background of the theme ; not over the background imposed by the
    // host (a "live" tab : uix_gfx_clear)
    (uix_jbg_k !== ui_jg_bgk) ? (
        uix_jbg_k = ui_jg_bgk;
        (ui_jg_bgk != 0) ? (
            uix_jbg_color();
            ui_jcolor_text = uix_jcontrast(ui_jcolor_text0, uix_jbg_r, uix_jbg_g, uix_jbg_b, 0.45);
            // the drawings (the filled part of the faders ...) and the borders : readable too (their opacity kept)
            ui_jcolor_draw = uix_jcontrast(ui_jcolor_draw0 & 0xffffff, uix_jbg_r, uix_jbg_g, uix_jbg_b, 0.3) +
                16777216 * floor(ui_jcolor_draw0 / 16777216);
            ui_jcolor_border = uix_jcontrast(ui_jcolor_border0 & 0xffffff, uix_jbg_r, uix_jbg_g, uix_jbg_b, 0.2) +
                16777216 * floor(ui_jcolor_border0 / 16777216);
            // the track of the faders : the background, a little brighter on a dark one (a little darker on a light one)
            uix_jbg_track = uix_jbg_shift(0.09); uix_jbg_trackb = uix_jbg_shift(0.18);
        ) : (
            ui_jcolor_text = ui_jcolor_text0; ui_jcolor_draw = ui_jcolor_draw0; ui_jcolor_border = ui_jcolor_border0;
        );
        ui_GFXdoNow |= 1;
    );
    // (2026-11-22) the palette of the cells with a role (rubric GUI, step 2 : uix_jp_make) : made again when a setting, the
    // theme, the background or the variation (the measures) changed ; before uix_jbg_draw (it changes gfx_clear) ; at the
    // start of the frame : its pads get the new colors
    (((ui_jvariant >= 0) ? min(3, ui_jvariant) : (ui_jstyle != 0)) !== uix_jp_vr) ? uix_jp_dirty = 1;
    uix_jp_dirty ? uix_jp_make();
    uix_jbg_on = (ui_jg_bgk != 0) && (uix_gfx_clear < 0);
    uix_jbg_on ? (
        uix_jbg_draw();
        ui_pcolor(ui_jcolor_text); // (the default color of the texts, given by control_start)
    );
);


