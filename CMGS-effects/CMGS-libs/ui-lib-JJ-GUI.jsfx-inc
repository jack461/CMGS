/*

    Standard GUI Interface

    using :
	ui-lib.jsfx-inc
	ui-lib-JJ.jsfx-inc

*/


@init


ui_lib_JJ_inited = 0;
uix_jtheme_ctlsiz = 0;
uix_jtheme = 0;
ui_jstyle = 0; // 0 : classic look ; 1 : "soft" look (no frames, soft cells, thin sliders, hidden tabs bar) - saved by the host ; the cells of the pads : see ui_jvariant (mSL_ui_Pads)
uix_jtheme_prev = -1;
uix_jtheme_img = -1; // the bitmap theme whose image is loaded (-1 : none ; see uix_jtheme_load)
uix_jtheme_menu = 0;
uix_jtheme_rtc_code = 0; // theme menu return code
uix_jtheme_rtc_max = 3;
ui_jshow_color = ui_jcolor_text;
ui_jd_tboxh = 0;

/*
    Display size : ui-lib draws everything in "ui units", scaled by the retina scaling (screen pixels per unit) ;
    uix_zoom multiplies it (see ui_start in ui-lib) : the texts, the pads, the sliders, the menus, the graphics and the
    mouse follow together ; the code that draws itself must use ui_left_retina() ... or uix_drawconfig_current[9]
    (ui_retina()), and compare the window size with ui units through ui_jscale() (gfx_w / ui_jscale())
    ui_jzoomCnt sizes, of index ui_jzoomK (ui_jzoom_pc : 50 % ... 200 %) ; each plugin saves its size in percent
    (serialBlock[Pr7_UiSize], 0 : the default size) ; the sub-menu "Display size" of the menu of the modules
    (ui_jzoom_menu_items, ui_jzoom_menu_tick, ui_jzoom_menu_click) and the keys (GM_Size_Keys) change it
*/
ui_jzoomCnt = 9; // 50 60 70 80 90 100 120 150 200 %
ui_jzoomDef = 5; // 100 %
ui_jzoomK = ui_jzoomDef;
ui_jzoomItem0 = -1; // the item "50 %" in the menu of the modules of the plugin (ui_jzoom_menu_items)
ui_jfontk = 1.1; // the fonts at 100 % (uix_fontk, see ui_jzoom_set ; 1 for the compact size of ui_lib_JJ_GUI_init)
// (2026-11-21) The rubric GUI (mSL_GUI) : the size of all the texts (percent ; the fonts, and above 100 % the heights of
// the lines, see ui_jtext_set) ; the labels of the faders (slider_ctl, slider_ctl_led) : the size of their text, the
// width they get (percent of ui_js_slValSize), bold
ui_jg_fonts = 100;
ui_jg_ftext = 100;
ui_jg_fwidth = 100;
ui_jg_fbold = 0;   // the labels of the faders in bold (1)
ui_jg_bgk = 0;     // the background : darker (-80 ... -1 %) or lighter (1 ... 80 %) ; 0 : as the theme (see update_theme)
uix_jbg_k = 0; ui_jcolor_text0 = 0; // (the color of the texts given by the theme, before ui_jg_bgk)
ui_jcolor_draw0 = ui_jcolor_border0 = 0; // (the same : the color of the drawings, of the borders)
uix_jbg_on = 0;    // the background is changed (ui_jg_bgk, not a "live" tab) : the faders follow it (uix_jbg_track ...)
uix_jbg_track = uix_jbg_trackb = 0; // their track : the background a little brighter ; its edge
ui_jstd = 1;      // the size given to ui_lib_JJ_GUI_init : 1 standard, 0 compact
ui_jd_vtext0 = 20; // the height of a line of text at 100 % (ui_jd_vtext : with ui_jg_fonts)

function ui_jzoom_pc(k)
(
    (k <= 0) ? 50 : (k === 1) ? 60 : (k === 2) ? 70 : (k === 3) ? 80 : (k === 4) ? 90 : (k === 5) ? 100 :
    (k === 6) ? 120 : (k === 7) ? 150 : 200;
);

function ui_jzoom_set(k)
(
    ui_jzoomK = max(0, min(ui_jzoomCnt - 1, 0|k));
    uix_zoom = ui_jzoom_pc(ui_jzoomK) / 100;
    // the fonts : ui_jfontk at 100 %, reduced less than the rest (50 % : 0.71 of their size at 100 %, 70 % : 0.87),
    // and enlarged less (150 % : 1.28, 200 % : 1.52)
    uix_fontk = ui_jfontk * (ui_jg_fonts / 100) * (uix_zoom ^ (-0.4));
    uix_font_dirty = 1;
    uix_jl_gfx_w = -1; // the sizes of the tabs bar are computed again (my_menu_bar_classic)
    ui_GFXdoNow |= 1; ui_GFXReason = 46;
);

// the index of the size "pc" (in percent : the nearest one ; 0 or less : the index "def")
function ui_jzoom_find(pc, def) local(k, b)
(
    (pc <= 0) ? def : (
        b = 0; k = 1;
        loop(ui_jzoomCnt - 1, (abs(ui_jzoom_pc(k) - pc) < abs(ui_jzoom_pc(b) - pc)) ? b = k; k += 1;);
        b;
    );
);

// screen pixels per ui unit (as ui_retina() after ui_start, usable everywhere)
function ui_jscale()
(
    (gfx_ext_retina ? gfx_ext_retina : 1) * ((uix_zoom > 0) ? uix_zoom : 1);
);

// the sub-menu "Display size" in the strings "names" of the menu of the modules, after the entry "itdsp" ;
// returns the last entry
function ui_jzoom_menu_items(names, itdsp)
(
    names[(itdsp += 1)] = ">Display size";
    ui_jzoomItem0 = itdsp + 1;
    names[(itdsp += 1)] = "!&2 50 %";
    names[(itdsp += 1)] = "!&2 60 %";
    names[(itdsp += 1)] = "!&2 70 %";
    names[(itdsp += 1)] = "!&2 80 %";
    names[(itdsp += 1)] = "!&2 90 %";
    names[(itdsp += 1)] = "!&2 100 %";
    names[(itdsp += 1)] = "!&2 120 %";
    names[(itdsp += 1)] = "!&2 150 %";
    names[(itdsp += 1)] = "!&2< 200 %";
    itdsp;
);

// ticks the current size in the items "p" of the menu
function ui_jzoom_menu_tick(p)
(
    (ui_jzoomItem0 > 0) ? str_setchar(p[ui_jzoomItem0 + ui_jzoomK], 1, '!');
);

// the item "kit" chosen in the menu : 1 if it is a size (then set)
function ui_jzoom_menu_click(kit)
(
    ((ui_jzoomItem0 > 0) && (kit >= ui_jzoomItem0) && (kit < ui_jzoomItem0 + ui_jzoomCnt)) ? (
        ui_jzoom_set(kit - ui_jzoomItem0);
        1;
    ) : 0;
);

// Cmd + '-' : smaller ; Cmd + '+' (or '=') : larger ; Cmd + '0' : 100 % ; the same in all the plugins (see mSL_ui_LibJJ,
// Keyboard) ; returns 1 if the key has been used
function GM_Size_Keys()
(
    (GM_key_mods() & 4) ? (
        GM_key_take('-') ? (ui_jzoom_set(ui_jzoomK - 1); 1) :
        (GM_key_take('+') || GM_key_take('=')) ? (ui_jzoom_set(ui_jzoomK + 1); 1) :
        GM_key_take('0') ? (ui_jzoom_set(ui_jzoomDef); 1) : 0;
    ) : 0;
);

function ui_version(v,s,u)
(
    (v<<16)|(s<<8)|u;
);


function ui_color(rgb)
(
    ui_color((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff, 1);
);


function ui_lib_JJ_updSiz()
(
    // Update some secondary values
    ui_jd_tboxh = ui_jd_tboxs = ui_jd_vtext + ui_jd_delta2; // text box size
    // (2026-11-21) the labels of the faders and the text of the pads larger (rubric GUI : ui_jg_ftext, ui_jg_ptext, above
    // 100 %) : their lines get higher (ui_text makes a text smaller to fit the height of its box)
    ui_jd_slidh = floor(ui_jd_vtext * max(1, ui_jg_ftext / 100) + 0.5) + ui_jd_delta0; // slider height
    ui_jd_menuh = floor(ui_jd_vtext * max(1, ui_jg_ptext / 100) + 0.5) + ui_jd_delta3; // main tabulation bar height (its tabs : a pad)
    ui_jd_padline = floor(ui_jd_vtext * max(1, ui_jg_ptext / 100) + 0.5) + ui_jd_delta4; // pad line height
    ui_jd_padb2 = ui_jd_padb + ui_jd_delta2; // integated pads
    ui_jd_bboxs = ui_jd_padTBox1 * 2 + ui_jd_padTBox2 * 2; // box group border
    ui_jd_ctgr = ui_cg_lab_height + ui_cg_pad_top + ui_cg_pad_bottom + ui_spec_jd_ctgr; // add. size for the group label
    ui_jd_min_block = 2 * ui_jd_tboxs; // some arbitrary minimum
    uix_jsl_val = 0; // global slider result
    // (the width of the window in ui units : it depends on the display size)
    uix_jsiz_menu_bar_item_width = min(ui_jd_delta20, max(ui_jd_delta10, 0|(gfx_w / ui_jscale() / uix_jG_menuscrSz)));
    ui_cg_lab_height = uix_jtheme_ctlsiz[uix_jtheme];
);

function uix_jpadHeight(k) // height of a Pad with "k" rows
(
    ui_jd_padline * k - ui_jd_padinter + ui_jd_padb2;
);

function uix_jBoxHeight(k) // height of a show box with "k" lines
(
    ui_jd_tboxs * k + ui_jd_bboxs;
);


// the heights that follow the height of a line of text (ui_jd_vtext) : the group labels, per theme
function uix_jctlsiz() local(ii)
(
    ii = 0; loop(16, uix_jtheme_ctlsiz[ii] = ui_jd_vtext + (ui_jstd ? 13 : 12); ii += 1;);
    uix_jtheme_ctlsiz[0] = ui_cg_lab_height = ui_jd_vtext + (ui_jstd ? 16 : 12);
    uix_jtheme_ctlsiz[1] = ui_jd_vtext + (ui_jstd ? 23 : 26); // Black
    uix_jtheme_ctlsiz[2] = ui_jd_vtext + 36; // Tron
);

// (2026-11-21) The size of all the texts (rubric GUI : "fonts", 80 ... 150 %) : the fonts (uix_fontk) ; above 100 %, the
// heights of the lines too (ui_jd_vtext and the sizes that follow it : the boxes, the sliders, the pads, the tabs bar)
function ui_jtext_set(pc)
(
    ui_jg_fonts = max(50, min(200, pc));
    uix_fontk = ui_jfontk * (ui_jg_fonts / 100) * (uix_zoom ^ (-0.4));
    ui_jd_vtext = floor(ui_jd_vtext0 * max(1, ui_jg_fonts / 100) + 0.5);
    uix_jctlsiz();
    ui_lib_JJ_updSiz();
    uix_font_dirty = 1;
    uix_jl_gfx_w = -1; // the sizes of the tabs bar are computed again (my_menu_bar_classic)
    ui_GFXdoNow |= 1;
);

/*
    the dimensions of the interface, in ui units : size 2, the standard one (Helvetica 15), used by the plugins of the
    Game Master ; size 1, a compact one (Arial 13), kept for the small plugins (MIDI_In, SmoothMultiLimiter) ;
    the display size (uix_zoom, see ui_jzoom_set) scales them all
*/
function ui_lib_JJ_GUI_init(size)
local (ii, std)
(
    (ui_lib_JJ_inited == 0) ? (
        // The "theme" menu
        uix_jtheme_menu = 0;
        uix_jG_menuscr = make_array(32); // up to 31 main tabs
        uix_jG_menuscr[ii=0] = "Main";
        uix_jG_menuscr[ii+=1] = -1;
        uix_jtheme_ctlsiz = make_array(16); // up to 16 themes
        uix_cz = make_array(UIX_CZS * UIX_CZMAX); // (2026-11-21) the cursor zones (see ui_cursor_zone, mSL_ui_LibJJ)
        // (2026-11-24) the heights of the modules chosen by the user (see ui_jheight, ui_jmh_lines)
        uix_jmhH = make_array(UIX_JMHN); uix_jmhR = make_array(UIX_JMHN);
        uix_jmhLo = make_array(UIX_JMHN); uix_jmhHi = make_array(UIX_JMHN);
        memset(uix_jmhH, 0, UIX_JMHN); memset(uix_jmhR, -10, UIX_JMHN);
        // (2026-11-21) the tabs bar and its button "Back", drawn as pads (the look of the pads, rubric GUI) ; no border :
        // each tab keeps the width of its zone of clics (uix_jsiz_menu_bar_item_width)
        uix_jtabs_pad = make_jpad(ui_jpad_ty_sel | ui_jpad_mk_labs | ui_jpad_mk_colors, 1, 32, 32);
        uix_jtabs_pad[ui_jpad_border] = 0;
        uix_jback_pad = make_jpad(ui_jpad_ty_act | ui_jpad_mk_labs | ui_jpad_mk_colors, 1, 1, 1);
        uix_jback_pad[ui_jpad_border] = 0;
        ui_lib_JJ_inited = 1;
    );
    ui_jstd = std = (size == 2);
    ui_jfontk = std ? 1.1 : 1;
    uix_fontk = ui_jfontk * (ui_jg_fonts / 100) * (uix_zoom ^ (-0.4));

    ui_jdefault_fontface = #FONT;
    strcpy(ui_jdefault_fontface, std ? "Helvetica" : "Arial");
    ui_jdefault_fontsize = std ? 15 : 13;
    ui_jd_vtext0 = std ? 20 : 19; // text vertical size (at 100 %)
    ui_jd_vtext = floor(ui_jd_vtext0 * max(1, ui_jg_fonts / 100) + 0.5); // (with the size of the texts, rubric GUI)
    ui_jd_padb = 4; // pad line border
    ui_cg_pad_top = std ? 2 : 1;
    ui_cg_pad_bottom = 1;
    ui_bx_min_w = std ? 170 : 132;
    ui_jd_padTBox1 = 2;
    ui_jd_padTBox2 = 2;
    ui_jd_padinter = 4;
    ui_jd_padTopDec = 4;
    ui_jd_padTopDec2 = 0|(ui_jd_padTopDec * 3 / 4);
    ui_js_slValSize = std ? 152 : 128; // width of the slider text
    uix_javail_Wheight = 0; // avail window height - used by window displayers
    uix_javail_Bwidth = 0; // used by box displayers
    uix_javail_Bheight = 0; // avail box height - used by box displayers
    ui_jcolor_inactive_grey = 0xA9A9A9 ;
    uix_req_w = std ? 150 : 120; // "show" min width for a text box
    uix_jtheme_prev = -1;
    uix_jG_menuscrSz = std ? 8 : 7;
    uix_jsiz_menu_bar_item_width = std ? 98 : 80;
    ui_jd_delta0 = 0;
    ui_jd_delta2 = std ? 3 : 2;
    ui_jd_delta3 = 8;
    ui_jd_delta4 = std ? 11 : 9;
    ui_jd_delta10 = std ? 52 : 42;
    ui_jd_delta20 = std ? 90 : 75;
    // the height of the group labels, per theme
    uix_jctlsiz();

    uix_default_fontsize = ui_jdefault_fontsize;
    uix_default_fontface = ui_jdefault_fontface;

    ui_lib_JJ_updSiz();

);


// Editing a slider value with the "control.prompt" screen (same as "rename tab").
// The prompt is asynchronous : the slider is identified by (label, mini, maxi, def) and by its position
// (uix_jsl_x, uix_jsl_y, set by slider_ctl / slider_ctl_led : several modules may show the same parameter),
// and the edited value is taken into account the next time this slider is displayed.
uix_jsl_ed_pending = 0;

function slider_ctl_edit(label, val, mini, maxi, def)
(
    sprintf(#uix_jsl_ed_tmp, label, val);
    sprintf(#uix_jsl_ed_title, "New value for  %s", #uix_jsl_ed_tmp);
    sprintf(#uix_jsl_ed_orig, "%g", val);
    strcpy(#uix_jsl_ed_text, #uix_jsl_ed_orig);
    uix_jsl_ed_lab = label; uix_jsl_ed_min = mini; uix_jsl_ed_max = maxi; uix_jsl_ed_def = def;
    uix_jsl_ed_x = uix_jsl_x; uix_jsl_ed_y = uix_jsl_y;
    uix_jsl_ed_pending = 1;
    ui_screen_open("control.prompt");
    ui_screen_arg(0, #uix_jsl_ed_text);
    ui_screen_arg(1, #uix_jsl_ed_title);
);

// returns 1 if this slider has been edited, the new value is in uix_jsl_ed_val
function slider_ctl_edited(label, var, mini, maxi, def)
local (r)
(
    r = 0;
    (uix_jsl_ed_pending && (ui_screen() != "control.prompt") && (uix_jsl_ed_lab == label)
            && (uix_jsl_ed_min == mini) && (uix_jsl_ed_max == maxi) && (uix_jsl_ed_def == def)
            && (uix_jsl_ed_x == uix_jsl_x) && (uix_jsl_ed_y == uix_jsl_y)) ? (
        uix_jsl_ed_pending = 0;
        // unchanged text (or "cancel") : nothing to do
        (strcmp(#uix_jsl_ed_text, #uix_jsl_ed_orig) != 0) ? (
            uix_jsl_ed_val = ui_parsenumber(#uix_jsl_ed_text, var);
            uix_jsl_ed_val = max(min(mini, maxi), min(max(mini, maxi), uix_jsl_ed_val));
            r = 1;
        );
    );
    r;
);

function slider_ctl(label, var, mini, maxi, slope, def, rnd)
local (r, w, k, ssv, ssx, ssvd)
(
    ui_split_top(ui_jd_slidh);
        ui_pad(5,0,5,0);
        uix_jsl_x = ui_left(); uix_jsl_y = ui_top(); // position of this slider (see slider_ctl_edit)
        uix_jsl_val = ssv = ssx = var;
        // value edited in the prompt ?
        slider_ctl_edited(label, var, mini, maxi, def) ? ssv = uix_jsl_ed_val;
        r = 0;
        ui_hover() ? (
            ui_click(2) ? r |= 8;
        );
        // (2026-11-21) the label : its width, the size of its text (rubric GUI : ui_jg_fwidth, ui_jg_ftext)
        k = (ui_jg_fwidth !== 100) ? max(20, min(floor(ui_js_slValSize * ui_jg_fwidth / 100), ui_width() - 40)) : ui_js_slValSize;
        ui_split_left(k);
            (ui_jg_ftext !== 100) ? ui_fontsize(ui_fontsize(0) * ui_jg_ftext / 100);
            ui_jg_fbold ? ui_fontbold(1);
            ui_align(0, 0.5); //
            // compute the "display value"
            ssvd = ssv + ((ssv>0)?(rnd/100):(ssv<0)?(-rnd/100):0);
            ui_textnumber(ssvd, label);
            // did we clicked inside the label ?
            ui_hover() ? (
                ui_click(1) ? (
                    r |= 4;
                    // edit the value
                    slider_ctl_edit(label, ui_jround(ssv, rnd), mini, maxi, def);
                );
                ui_click(2) ? r |= 8;
            );
        ui_pop();
        ui_pad(3,4,0,4); // was (3,2,0,2)
        // ssv = control_slider_x(ssv, mini, maxi, slope, def);
        ssv = uix_control_slider_h(ssv, mini, maxi, slope, 1, def, 0); //save one call level
        (r |=(ssv != ssx)) ? (
        ssvv = ssv;
            uix_jsl_val = var = ssvvr = ui_jround(ssv, rnd);
            ui_GFXdoNow |= 1;
            ui_GFXReason = 43;
        );
    ui_pop();
    r;
);

function slider_ctl_led(label, var, mini, maxi, slope, def, rnd, led1, led2)
local (r, z, w, k, ssv, ssx, ssvd)
(
    ui_split_top(ui_jd_slidh);
        ui_pad(5,0,5,0);
        uix_jsl_x = ui_left(); uix_jsl_y = ui_top(); // position of this slider (see slider_ctl_edit)
        uix_jsl_val = ssv = ssx = var;
        // value edited in the prompt ?
        slider_ctl_edited(label, var, mini, maxi, def) ? ssv = uix_jsl_ed_val;
        r = 0;
        ui_hover() ? (
            ui_click(2) ? r |= 8;
        );
        // (2026-11-21) the label : its width, the size of its text (rubric GUI : ui_jg_fwidth, ui_jg_ftext)
        k = (ui_jg_fwidth !== 100) ? max(20, min(floor(ui_js_slValSize * ui_jg_fwidth / 100), ui_width() - 40)) : ui_js_slValSize;
        ui_split_left(k);
            (ui_jg_ftext !== 100) ? ui_fontsize(ui_fontsize(0) * ui_jg_ftext / 100);
            ui_jg_fbold ? ui_fontbold(1);
            ui_align(0, 0.5); //
            (led1 != 0) ? (
                ui_split_left(14);
                    ui_pad(0,3,0,3);
                    // led1[ui_jled_c_on] = gmem[RandomSColors + min(7,max(0,0|led1[ui_jled_alt]))];
                    r |= (show_jled(led1, led1[ui_jled_status], -1)) << 4 ;
                ui_pop();
            );
            // compute the "display value"
            ssvd = ssv + ((ssv>0)?(rnd/100):(ssv<0)?(-rnd/100):0);
            ui_textnumber(ssvd, label);
            // did we clicked inside the label ?
            ui_hover() ? (
                ui_click(1) ? (
                    r |= 4;
                    // edit the value
                    slider_ctl_edit(label, ui_jround(ssv, rnd), mini, maxi, def);
                );
                ui_click(2) ? r |= 8;
            );
        ui_pop();
        ui_pad(0,4,0,4);  // was (0,2,0,2);
        (led2 != 0) ? (
            ui_split_left(18);
                r |= (show_jled(led2, led2[ui_jled_status], -1)) << 8;
            ui_pop();
        ) : (
            ui_pad(3,0,0,0);
        );
        // ssv = control_slider_x(ssv, mini, maxi, slope, def);
        ssv = uix_control_slider_h(ssv, mini, maxi, slope, 1, def, 0);
        (z=(ssv != ssx)) ? (
        ssvv = ssv;
            uix_jsl_val = var = ssvvr = ui_jround(ssv, rnd);
            ui_GFXdoNow |= 1;
            ui_GFXReason = 44;
        );
    ui_pop();
    r|z;
);

function ui_screen_switch(id) local(screen)
(
    uix_click_block();
    uix_key_clear();
    screen = (uix_screenstack + uix_screenstack_step*uix_screenstack_currentlayer);
    screen[0] = id;
);

function main_screen(said)
(
    said[0];
);


function uix_jmy_theme_menu() local(z)
(
    (uix_jtheme_menu != 0) ? (
        z = control_jmenu(uix_jtheme_menu);
        (z != 0) ? (
            (z <= uix_jtheme_rtc_max) ? (
                uix_jtheme = z - 1; ui_GFXdoNow |= 1; ui_GFXReason = 45;
            ) : (
                uix_jtheme_rtc_code = z; // taken into account outside
            );
        );
    );
);


// (2026-11-21) The tabs bar drawn as a pad (control_jpad : the style, the variation, the frames, the gaps, the texts of
// the rubric GUI) : the current tab selected, in the accent color of the theme ; the others in a grey tinted by it
function uix_jtab_other() local(a)
(
    a = uix_theme_accent();
    ((0|(((a >> 16) & 255) * 0.35 + 140 * 0.65)) << 16) | ((0|(((a >> 8) & 255) * 0.35 + 140 * 0.65)) << 8) |
        (0|((a & 255) * 0.35 + 140 * 0.65));
);
// the count of tabs of "said" (ended by -1) shown in the width aw (each one tw wide)
function uix_jtabs_count(said, aw, tw) local(n)
(
    n = 0; while ((said[n] != -1) && (aw > tw)) ( aw -= tw; n += 1; );
    n;
);
// the n first tabs in the current rectangle ; returns the tab clicked (0 ...), -1 : none
function uix_jtabs_draw(said, n) local(p, labs, cols, cdefs, i, str, ast, acc, oth, ev)
(
    p = uix_jtabs_pad;
    labs = p + p[ui_jpad_labs]; cols = p + p[ui_jpad_clrs]; cdefs = p + p[ui_jpad_cells];
    acc = uix_theme_accent(); oth = uix_jtab_other();
    n = max(1, min(32, n));
    i = 0;
    loop(n,
        str = said[i];
        labs[i] = ((altTabsNames != 0) && ((ast = altTabsNames[i]) != 0) && (strlen(ast) != 0)) ? ast : str;
        cols[i] = (str == ui_screen()) ? acc : oth;
        cdefs[i] = (cdefs[i] & (-1 ~ ui_jpad_ct_selec)) | ((str == ui_screen()) ? ui_jpad_ct_selec : 0);
        ui_jpad_role(p, i, ui_jpad_rl_nav); // (2026-11-22 : the palette, rubric GUI ; the current tab : selected)
        i += 1;
    );
    ev = control_jpad(p, 1, n, 1);
    ((ev & ui_jpad_ev_lmc) && (p[ui_jpad_last] >= 1)) ? p[ui_jpad_last] - 1 : -1;
);
// the button "Back" (a secondary screen) in the current rectangle ; 1 if clicked
function uix_jback_draw() local(p, ev)
(
    p = uix_jback_pad;
    (p + p[ui_jpad_labs])[0] = "Back";
    (p + p[ui_jpad_clrs])[0] = uix_jtab_other();
    ui_jpad_role(p, 0, ui_jpad_rl_action); // (2026-11-22 : the palette, rubric GUI)
    ev = control_jpad(p);
    (ev & ui_jpad_ev_lmc) ? 1 : 0;
);

function my_menu_bar_classic(said)
local(tw, aw, n, k, xcol)
(
    (gfx_w != uix_jl_gfx_w) ? (
        uix_jl_gfx_w = gfx_w;
        ui_lib_JJ_updSiz();
    );
    tw = uix_jsiz_menu_bar_item_width; // text width
    ui_split_top(ui_jd_menuh);
        uix_jmy_theme_menu();
        ui_pcolor(ui_jcolor_border);
        ui_pad(5,2); ui_border();
        ui_pcolor(ui_jcolor_text);
        aw = ui_width();

        // (2026-11-21) the tabs : a pad (see uix_jtabs_draw ; until then, buttons of the theme)
        ((n = uix_jtabs_count(said, aw, tw)) > 0) ? (
            ui_split_left(n * tw);
                (((k = uix_jtabs_draw(said, n)) >= 0) && (said[k] != ui_screen())) ? (
                    uix_jmbsel = k; // selected tabulation
                    ui_screen_switch(said[k]);
                    ui_GFXdoNow |= 1;
                    ui_GFXReason = 40;
                );
            ui_pop();
        );

        (ui_screen_level() > 0) ? (
            ui_split_right(tw);
                uix_jback_draw() ? (
                    ui_screen_close();
                    ui_GFXdoNow |= 1;
                    ui_GFXReason = 41;
                );
            ui_pop();
        );

        ui_pad(2,2); ui_border(); // ui_pad(1,1);

        xcol = ui_jcolor_inactive_grey;
        ((BPlc+BLpc) > 0) ? (
            AAAPxcol = xcol = displayColorsA[AAAPicol=0|(((displayColorsSiz-1)*BLpc)/(BPlc+BLpc))];
        );
        ui_show_error(xcol);

    ui_pop();

    uix_javail_Wheight = ui_height(); // New available height in the window
);


// ===== "Soft" look (ui_jstyle) : the tabs bar is hidden ; it is shown, transparent, over the panes,
// when the mouse comes near the top of the window, and disappears ui_jbar_delay seconds after the mouse left it.
// my_menu_bar_soft (called instead of the classic bar, before the panes) handles the visibility and the clics,
// and gives the bar the priority on the clics ; my_menu_bar_overlay (at the end of @gfx) draws it over the panes.
ui_jbar_until = 0; // the bar is visible until this time
ui_jbar_delay = 10; // in seconds (the time to come back to the bar after leaving it)
ui_jbar_shown = 0; // the bar is visible
ui_jbar_was = 0; // it was visible at the previous display
ui_jbar_in = 0; // the mouse was over the bar at the previous display
// (2026-11-22, the rubric GUI : the key tabs, see mSL_GUI) the tabs bar : 0 as the style (Classic : always shown ; Soft :
// shown when the mouse comes near the top of the window), 1 always shown, 2 shown when the mouse comes near the top
ui_jg_tabs = 0;
function uix_jbar_auto() ( (ui_jg_tabs === 1) ? 0 : (ui_jg_tabs === 2) ? 1 : (ui_jstyle != 0); );

function my_menu_bar_soft(said)
local(str, tw, ii, aw, h, ww, inb)
(
    (gfx_w != uix_jl_gfx_w) ? (
        uix_jl_gfx_w = gfx_w;
        ui_lib_JJ_updSiz();
    );
    h = ui_jd_menuh;
    ww = gfx_w / uix_drawconfig_current[9]; // width of the window (ui coordinates) : the bar is at the top of the window
    // visibility : mouse near the top of the window, or a secondary screen opened (for the "Back" button)
    inb = (uix_mouse_y >= 0) && (uix_mouse_y < h) && (uix_mouse_x >= 0) && (uix_mouse_x < ww);
    (inb || (ui_screen_level() > 0)) ? (
        ui_jbar_until = time_precise() + ui_jbar_delay;
    );
    ui_jbar_shown = (time_precise() < ui_jbar_until);
    // refresh the screen while the mouse is over the bar (the tab under the mouse), once more when it leaves it,
    // and when the bar appears or disappears (out of the bar, the periodic refreshes see the end of the delay)
    (inb || ui_jbar_in || (ui_jbar_shown != ui_jbar_was)) ? ui_GFXdoNow |= 1;
    ui_jbar_was = ui_jbar_shown;
    ui_jbar_in = inb;
    ui_jbar_shown ? (
        ui_push();
            ui_set_rect(0, 0, ww, h); // absolute position : the top of the window
            uix_jmy_theme_menu(); // right clic on the bar
            ui_pad(5,2);
            tw = uix_jsiz_menu_bar_item_width;
            aw = ui_width();
            ii = 0;
            while ((str = said[ii]) != -1) (
                (aw > tw) ? (
                    aw -= tw;
                    (ii == 0) ? ui_split_left(tw) : ui_split_next();
                    (ui_click() && (str != ui_screen())) ? (
                        uix_jmbsel = ii; // selected tabulation
                        ui_screen_switch(str);
                        ui_GFXdoNow |= 1;
                        ui_GFXReason = 40;
                    );
                );
                ii += 1;
            );
            ui_pop();
            (ui_screen_level() > 0) ? (
                ui_split_right(tw);
                    ui_click() ? (
                        ui_screen_close();
                        ui_GFXdoNow |= 1;
                        ui_GFXReason = 41;
                    );
                ui_pop();
            );
            // the bar has the priority : the panes drawn below do not see the clics made on it
            ui_hover() ? uix_click_block();
        ui_pop();
    );
    uix_javail_Wheight = ui_height(); // the panes use the whole height
);

// (2026-11-22) The tip of a cell (Alt and the mouse on it : #uix_jtip_s, see uix_jtip_set in mSL_ui_Pads) : near the mouse,
// over everything (called by my_menu_bar_overlay)
function uix_jtip_draw() local(rs, w, h, x, y, m)
(
    rs = uix_drawconfig_current[9];
    uix_setgfxfont();
    w = h = 0; gfx_measurestr(#uix_jtip_s, w, h);
    m = floor(4 * rs);
    x = max(0, min(gfx_w - w - 2 * m - 1, mouse_x + floor(14 * rs)));
    y = mouse_y + floor(18 * rs); (y + h + 2 * m > gfx_h) ? y = max(0, mouse_y - h - 2 * m - floor(6 * rs));
    gfx_set(0.08, 0.08, 0.09, 0.92); gfx_rect(x, y, w + 2 * m, h + 2 * m);
    gfx_set(0.6, 0.6, 0.62, 1); gfx_rect(x, y, w + 2 * m, h + 2 * m, 0);
    gfx_set(0.96, 0.96, 0.97, 1); gfx_x = x + m; gfx_y = y + m; gfx_drawstr(#uix_jtip_s);
    gfx_a = 1;
);

// Draws the "soft" tabs bar over the panes (to call at the end of @gfx, at the top level)
function my_menu_bar_overlay(said)
local(tw, n, aw, h, bgc, ww)
(
    (uix_jbar_auto() && ui_jbar_shown) ? (
        h = ui_jd_menuh;
        ww = gfx_w / uix_drawconfig_current[9]; // width of the window (ui coordinates)
        bgc = (ui_pcontrast(ui_jcolor_text) == uix_pblack) ? 0x202020 : 0xF2F2F2; // dark under a light text, and conversely
        ui_push();
            ui_set_rect(0, 0, ww, h); // absolute position : the top of the window, over the panes
            ui_pcolor(bgc, 0.85);
            ui_fill();
            ui_pad(5,2);
            tw = uix_jsiz_menu_bar_item_width;
            aw = ui_width();
            // (2026-11-21) the tabs : a pad (see uix_jtabs_draw ; the clics were taken by my_menu_bar_soft)
            ((n = uix_jtabs_count(said, aw, tw)) > 0) ? (
                ui_split_left(n * tw);
                    uix_jtabs_draw(said, n);
                ui_pop();
            );
            (ui_screen_level() > 0) ? (
                ui_split_right(tw);
                    uix_jback_draw();
                ui_pop();
            );
        ui_pop();
    );
    uix_jtip ? uix_jtip_draw(); // (2026-11-22 : the tip of a cell, Alt)
);

function my_menu_bar(said)
(
    uix_jbar_auto() ? my_menu_bar_soft(said) : my_menu_bar_classic(said); // (2026-11-22 : ui_jg_tabs, as the style by default)
);

// Next (d = 1) or previous (d = -1) tabulation of the menu bar "said" (uix_jG_menuscr, ended by -1),
// from the screen displayed (as a clic on the tab : uix_jmbsel ; uix_jmbprv keeps the previous one)
function ui_jtab_step(said, d)
local (n, cur)
(
    n = cur = 0;
    while (said[n] != -1) (
        (said[n] == ui_screen()) ? cur = n;
        n += 1;
    );
    (n > 1) ? (
        uix_jmbprv = cur;
        uix_jmbsel = (cur + n + d) % n;
        ui_screen_switch(said[uix_jmbsel]);
        ui_GFXdoNow |= 1;
    );
);

// Tab : next tabulation ; Shift + Tab : previous one, the same in all the plugins (see mSL_ui_LibJJ, Keyboard)
// returns 1 if the key has been used
function GM_Tab_Keys()
(
    ((GM_key_mods() & 8) && GM_key_take(9)) ? (ui_jtab_step(uix_jG_menuscr, -1); 1) :
    GM_key_take(9) ? (ui_jtab_step(uix_jG_menuscr, 1); 1) : 0;
);


function ui_split_topratio(ratio, mini) (
    ui_split_top(max(mini,ratio*uix_drawconfig_current[19]));
);

function ui_split_leftratio(ratio,mini) (
    ui_split_left(max(mini,ratio*uix_drawconfig_current[18]));
);

// the border between two panes dragged (ui_jborders) : its index (-1 : none), its tab, the count of the panes ; the last
// clic on a border (a double clic : the two panes equal)
uix_jbdK = -1; uix_jbdTab = 0; uix_jbdN = 0; uix_jbdLK = -1; uix_jbdLT = 0;
// (2026-11-24) the heights of the modules chosen by the user, by module number (0 ... UIX_JMHN - 1 ; see ui_jheight) : the
// height (0 : automatic), the frame (gfx_executed) where the module asked it, its bounds ; the line dragged (ui_jmh_lines) :
// its module (0 : none), its pane, the mouse and the height at its start ; the last clic on a line (a double clic) ; the
// pane (screen pixels)
UIX_JMHN = 512; uix_jmhH = uix_jmhR = uix_jmhLo = uix_jmhHi = 0;
uix_jmhK = 0; uix_jmhP = -1; uix_jmhY0 = uix_jmhH0 = 0; uix_jmhLK = 0; uix_jmhLT = 0; uix_jmhPL = uix_jmhPW = uix_jmhPB = 0;

/*
    (2026-11-21) The borders between the n panes of a tab (p : their widths, relative ; tab : its number ; the rect : the
    tab ; the tabs of mSL_Panes and of the GamePlayer, genericTabSet) : under the mouse
    (3 pixels on each side), a double arrow ; a left drag moves the border (the widths of its two panes, their sum kept ;
    80 pixels at least each) ; a double clic : the two panes equal. The clic on a border is not seen by the modules
    (uix_click_block). Called before the panes (ph 0 : the clics, the drag), then after them (ph 1 : the cursor zones, over
    those of the modules)
*/
function ui_jborders(n, p, tab, ph)
local(L, T, W, H, S, c, k, i, xb, hz, a, b, pm, x, r)
(
    L = ui_left(); T = ui_top(); W = max(1, ui_width()); H = ui_height(); r = ui_retina();
    S = 0; k = 0; loop(n, S += max(1, p[k]); k += 1;);
    hz = 3;
    (ph === 0) ? (
        // a drag going on (the same tab, the same panes) : the border follows the mouse
        (uix_jbdK >= 0) ? (
            ((uix_mcap & 1) && (uix_jbdTab === tab) && (uix_jbdN === n) && (uix_jbdK < n - 1)) ? (
                k = uix_jbdK;
                c = 0; i = 0; loop(k, c += max(1, p[i]); i += 1;);
                a = max(1, p[k]); b = max(1, p[k + 1]);
                pm = 80 * S / W;
                x = max(pm, min(a + b - pm, (uix_mouse_x - L) / W * S - c));
                (a + b > 2 * pm) ? (p[k] = x; p[k + 1] = a + b - x;);
                ui_cursor_drag(6);
                ui_GFXdoNow |= 4;
            ) : (
                uix_jbdK = -1;
            );
        );
        // a clic on a border : a drag ; a double clic : the two panes equal
        (uix_click1 && (uix_jbdK < 0) && (uix_mouse_y >= T) && (uix_mouse_y < T + H)) ? (
            c = 0; k = 0;
            loop(n - 1,
                c += max(1, p[k]);
                xb = L + W * c / S;
                ((uix_jbdK < 0) && (abs(uix_mouse_x - xb) <= hz)) ? (
                    ((uix_jbdLK === k) && (time_precise() - uix_jbdLT < 0.4)) ? (
                        a = (max(1, p[k]) + max(1, p[k + 1])) / 2; p[k] = p[k + 1] = a;
                        uix_jbdLK = -1;
                    ) : (
                        uix_jbdK = k; uix_jbdTab = tab; uix_jbdN = n;
                        uix_jbdLK = k; uix_jbdLT = time_precise();
                    );
                    uix_click_block(); // (the modules under it do not see this clic)
                    ui_cursor_drag(6);
                    ui_GFXdoNow |= 4;
                );
                k += 1;
            );
        );
    ) : (
        // the cursor zones of the borders
        c = 0; k = 0;
        loop(n - 1,
            c += max(1, p[k]);
            xb = L + W * c / S;
            ui_cursor_zone((xb - hz) * r, T * r, 2 * hz * r, H * r, 6, -1);
            k += 1;
        );
    );
);


/*
    (2026-11-24) The height of a module, chosen by the user (the 5 applications : the panes of mSL_Panes, of Interstys and of
    the GamePlayer). The module m (its number, as for keepBlockInfos) asks its whole height : ui_jheight(m, hdef, hmin, hmax)
    (hdef : its automatic height ; hmin : its least ; hmax : the room left in the pane, ui_height()) ; the height of the
    user (uix_jmhH[m] ; 0 : none) or hdef, in [hmin, hmax]. The module is then, for this frame, a module whose height may
    change (uix_jmhR[m] = gfx_executed ; uix_jmhLo, uix_jmhHi : its bounds) : the line under it can be dragged (ui_jmh_lines).
    The heights : in the units of ui-lib (they follow the display size) ; saved with the project (ui_jmh_serialize,
    mSL_Serialize). (A double clic on the line : uix_jmhH[m] -1, the automatic height.)
*/
function ui_jheight(m, hdef, hmin, hmax)
local(h)
(
    ((m > 0) && (m < UIX_JMHN) && (uix_jmhH > 0)) ? (
        (uix_jmhH[m] < 0) ? (uix_jmhH[m] = 0);
        hmax = max(hmin, hmax);
        uix_jmhR[m] = gfx_executed; uix_jmhLo[m] = hmin; uix_jmhHi[m] = hmax;
        h = (uix_jmhH[m] > 0) ? uix_jmhH[m] : hdef;
        max(hmin, min(hmax, h));
    ) : hdef;
);

/*
    (2026-11-24) A module whose variable part keeps its height itself (a waveform, a graph : hp[0], 0 for its default vdef ;
    also changed by the keys + and - of the module, saved with the module) : its whole height is hf + that part. The line
    under it dragged sets hp[0] (in [vmin, vmax], the module in the room left in the pane, ui_height()) ; a double clic :
    hp[0] = 0 (the default). Returns the height of the part (to call before the module takes its place, as ui_jheight).
*/
function ui_jheightv(m, hf, hp, vdef, vmin, vmax)
local(v)
(
    v = (hp[0] > 0) ? hp[0] : vdef;
    ((m > 0) && (m < UIX_JMHN) && (uix_jmhH > 0)) ? (
        (uix_jmhH[m] > 0) ? (
            v = hp[0] = max(vmin, min(vmax, uix_jmhH[m] - hf)); uix_jmhH[m] = 0;
        ) :
        (uix_jmhH[m] < 0) ? (
            hp[0] = 0; v = vdef; uix_jmhH[m] = 0;
        );
        uix_jmhR[m] = gfx_executed; uix_jmhLo[m] = hf + vmin;
        uix_jmhHi[m] = max(hf + vmin, min(hf + vmax, ui_height()));
    );
    v;
);

/*
    (2026-11-24) The lines under the modules of a pane whose height may change (ui_jheight, in the frame drawn before) : the
    rect, the pane ; desc, its modules (nm words : their numbers, then their places, top * 10000 + height, in screen pixels,
    see keepBlockInfos) ; pn, the pane (a number of the host). Under the mouse (3 pixels on each side of a line ; a module
    down to the bottom of the pane : from 3 to 12 pixels above its bottom, the zone of the window being resized by the
    system is at its bottom), arrows up - down ; a left drag moves the line (the height of the module above it, in its bounds ; the next modules follow) ; a
    double clic : its automatic height. The clic on a line is not seen by the modules (uix_click_block). Called before the
    modules of the pane (ph 0 : the clics, the drag), then after them (ph 1 : the cursor zones, over those of the modules)
*/
function ui_jmh_lines(desc, nm, pn, ph)
local(i, k, u, y, h, r, hz, f, zm, zd, b)
(
    r = ui_retina(); hz = 3 * r;
    (ph === 0) ? (
        uix_jmhPL = ui_left_retina(); uix_jmhPW = ui_width_retina(); uix_jmhPB = ui_top_retina() + ui_height_retina();
        // a drag going on (this pane) : the line follows the mouse
        ((uix_jmhK > 0) && (uix_jmhP === pn)) ? (
            (uix_mcap & 1) ? (
                k = uix_jmhK;
                uix_jmhH[k] = max(uix_jmhLo[k], min(uix_jmhHi[k], (uix_jmhH0 + mouse_y - uix_jmhY0) / r));
                ui_cursor_drag(7);
                ui_GFXdoNow |= 4;
            ) : (
                uix_jmhK = 0;
            );
        );
        // a clic on a line : a drag ; a double clic : the automatic height
        (uix_click1 && (uix_jmhK <= 0) && (mouse_x >= uix_jmhPL) && (mouse_x < uix_jmhPL + uix_jmhPW)) ? (
            f = 0; i = 0;
            loop(nm - 1,
                k = desc[i];
                (!f && (k > 0) && (k < UIX_JMHN) && (uix_jmhR[k] >= gfx_executed - 1)) ? (
                    u = desc[i + nm]; h = u % 10000; y = floor(u / 10000) + h;
                    // (the zone of the line : its middle, its half height)
                    b = (y > uix_jmhPB - 2 * hz); zm = b ? y - 2.5 * hz : y; zd = b ? 1.5 * hz : hz;
                    ((u > 0) && (abs(mouse_y - zm) <= zd)) ? (
                        f = 1;
                        ((uix_jmhLK === k) && (time_precise() - uix_jmhLT < 0.4)) ? (
                            uix_jmhH[k] = -1; uix_jmhLK = 0; // (ui_jheight, ui_jheightv : the automatic height)
                        ) : (
                            uix_jmhK = k; uix_jmhP = pn; uix_jmhY0 = mouse_y; uix_jmhH0 = h;
                            uix_jmhLK = k; uix_jmhLT = time_precise();
                            ui_cursor_drag(7);
                        );
                        uix_click_block(); // (the modules under it do not see this clic)
                        ui_GFXdoNow |= 4;
                    );
                );
                i += 1;
            );
        );
    ) : (
        // the cursor zones of the lines (the modules drawn in this frame)
        i = 0;
        loop(nm - 1,
            k = desc[i];
            ((k > 0) && (k < UIX_JMHN) && (uix_jmhR[k] === gfx_executed)) ? (
                u = desc[i + nm]; y = floor(u / 10000) + (u % 10000);
                b = (y > uix_jmhPB - 2 * hz); zm = b ? y - 2.5 * hz : y; zd = b ? 1.5 * hz : hz;
                (u > 0) ? ui_cursor_zone(uix_jmhPL, zm - zd, uix_jmhPW, 2 * zd, 7, -1);
            );
            i += 1;
        );
    );
);

function ui_split_rightratio(ratio,mini) (
    ui_split_right(max(mini,ratio*uix_drawconfig_current[18]));
);

function ui_new_column(wid)
local(wok)
(
    wok = ui_width() >= ui_bx_min_w -10;
    (wid == 0) ? ui_split_next() :
    (wid > 0) ? (
        ui_split_leftratio(wid,ui_bx_min_w);
    ) : (
        ui_split_rightratio(-wid,ui_bx_min_w);
    );
    (wok && (ui_height() > ui_jd_tboxs - 10)) ? (
        ui_pcolor(ui_jcolor_border);
        ui_pad(ui_jd_delta2, 0, ui_jd_delta2, 0); ui_border(); ui_pad(2, ui_jd_padTBox2, 2, ui_jd_padTBox2);
    ) ;
    uix_javail_Bwidth = ui_width();
    uix_javail_Bheight = ui_height();
);

/*
function ui_new_column()
(
    ui_new_column(0);
);
*/

split_leftratio = 0.35; // label width ratio

function ui_show(label, value1, value2, value3, value4, fmt)
(
    (uix_javail_Bwidth >= uix_req_w && uix_javail_Bheight >= ui_jd_tboxh) ? (
        uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
            ui_pad(0,1,0,0);
            ui_split_leftratio(split_leftratio);
                ui_pcolor(ui_jshow_color);
                ui_pad(3,0); ui_pad(0,ui_jd_padTopDec2,0,0); ui_align(0, 0.5); ui_text(label);
            ui_pop();
                ui_pcolor(ui_jcolor_border);
                ui_pad(3,0); ui_border(); ui_pad(0,ui_jd_padTopDec2,0,0); ui_align(0.5, 0.5);
                ui_pcolor(ui_jshow_color);
                value1 += (value1 > 0) ? 0.000001 : (value1 < 0) ? -0.000001 : 0;
                value2 += (value2 > 0) ? 0.000001 : (value2 < 0) ? -0.000001 : 0;
                value3 += (value3 > 0) ? 0.000001 : (value3 < 0) ? -0.000001 : 0;
                value4 += (value4 > 0) ? 0.000001 : (value4 < 0) ? -0.000001 : 0;
                ui_textnumber(value1, value2, value3, value4, fmt);
        ui_pop();
    );
    ui_jshow_color = ui_jcolor_text;
    ui_jd_tboxh = ui_jd_tboxs;
);



function ui_show(label, value1, value2, value3, fmt)
(
    (uix_javail_Bwidth >= uix_req_w && uix_javail_Bheight >= ui_jd_tboxh) ? (
        uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
            ui_pad(0,1,0,0);
            ui_split_leftratio(split_leftratio);
                ui_pcolor(ui_jshow_color);
                ui_pad(3,0); ui_pad(0,ui_jd_padTopDec2,0,0); ui_align(0, 0.5); ui_text(label);
            ui_pop();
                ui_pcolor(ui_jcolor_border);
                ui_pad(3,0); ui_border(); ui_pad(0,ui_jd_padTopDec2,0,0); ui_align(0.5, 0.5);
                ui_pcolor(ui_jshow_color);
                value1 += (value1 > 0) ? 0.000001 : (value1 < 0) ? -0.000001 : 0;
                value2 += (value2 > 0) ? 0.000001 : (value2 < 0) ? -0.000001 : 0;
                value3 += (value3 > 0) ? 0.000001 : (value3 < 0) ? -0.000001 : 0;
                ui_textnumber(value1, value2, value3, fmt);
        ui_pop();
    );
    ui_jshow_color = ui_jcolor_text;
    ui_jd_tboxh = ui_jd_tboxs;
);


function ui_show(label, value1, value2, fmt)
(
