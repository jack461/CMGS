function ui_show(label, value, fmt)
(
    (uix_javail_Bwidth >= uix_req_w && uix_javail_Bheight >= ui_jd_tboxh) ? (
        uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
            ui_pad(0,1,0,0);
            ui_split_leftratio(split_leftratio);
                ui_pcolor(ui_jshow_color);
