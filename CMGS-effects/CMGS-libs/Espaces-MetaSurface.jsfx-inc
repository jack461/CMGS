// The triangulation of the configurations of the entry e for the view v (Bowyer-Watson ; the points in the metric of the
// surface : x times its aspect) ; aligned configurations, or two only : their order along their line
function ms_Triangulate(v, e) local(n, a, i, j, k, nt, ne, t, p, q, dup, ok, u, w, x, y, cx, cy, tri, hul, nh, d, dm, i0, i1)
(
    n = ms_N(e); a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    tri = ms_tri + v * MS_TMAX * 3; hul = ms_hul + v * MS_MAXC * 4;
    ms_ntri[v] = 0; ms_nhul[v] = 0; ms_lin[v] = 0;
    i = 0; loop(n, ms_X[i] = ms_Cv(e, i, 1) * a; ms_Y[i] = ms_Cv(e, i, 2); i += 1;);
    (n >= 3) ? (
        // the super triangle, around the surface
        cx = a / 2; cy = 0.5;
        ms_X[n] = cx - 100; ms_Y[n] = cy - 100; ms_X[n + 1] = cx + 100; ms_Y[n + 1] = cy - 100;
        ms_X[n + 2] = cx; ms_Y[n + 2] = cy + 100;
        t = ms_wt; t[0] = n; t[1] = n + 1; t[2] = n + 2; ms_Circ(0); nt = 1;
        p = 0;
        loop(n,
            // (a configuration at the place of a previous one : left out, its share stays 0)
            dup = 0; i = 0; loop(p, ((abs(ms_X[i] - ms_X[p]) < 0.000001) && (abs(ms_Y[i] - ms_Y[p]) < 0.000001)) ? dup = 1; i += 1;);
            !dup ? (
                // the triangles whose circumcircle contains the point : removed, their edges kept
                ne = 0; k = 0;
                loop(nt,
                    t = ms_wt + 7 * k;
                    (t[6] && (sqr(ms_X[p] - t[3]) + sqr(ms_Y[p] - t[4]) < t[5])) ? (
                        t[6] = 0;
                        (ne < MS_WTN * 3 - 3) ? (
                            ms_ed[2 * ne] = t[0]; ms_ed[2 * ne + 1] = t[1];
                            ms_ed[2 * ne + 2] = t[1]; ms_ed[2 * ne + 3] = t[2];
                            ms_ed[2 * ne + 4] = t[2]; ms_ed[2 * ne + 5] = t[0];
                            ne += 3;
                        );
                    );
                    k += 1;
                );
                // the edges of the cavity (those of a single removed triangle) joined to the point
                i = 0;
                loop(ne,
                    ok = 1; j = 0;
                    loop(ne,
                        ((j !== i) && (((ms_ed[2 * j] === ms_ed[2 * i]) && (ms_ed[2 * j + 1] === ms_ed[2 * i + 1])) ||
                            ((ms_ed[2 * j] === ms_ed[2 * i + 1]) && (ms_ed[2 * j + 1] === ms_ed[2 * i])))) ? ok = 0;
                        j += 1;
                    );
                    (ok && (nt < MS_WTN)) ? (
                        t = ms_wt + 7 * nt; t[0] = ms_ed[2 * i]; t[1] = ms_ed[2 * i + 1]; t[2] = p; ms_Circ(nt); nt += 1;
                    );
                    i += 1;
                );
                // the list without the removed triangles
                j = 0; k = 0;
                loop(nt, t = ms_wt + 7 * k; t[6] ? ((j !== k) ? memcpy(ms_wt + 7 * j, t, 7); j += 1;); k += 1;);
                nt = j;
            );
            p += 1;
        );
        // the triangles without a point of the super triangle, not flat
        k = 0;
        loop(nt,
            t = ms_wt + 7 * k;
            ((t[0] < n) && (t[1] < n) && (t[2] < n) && (t[5] < 10^29) && (ms_ntri[v] < MS_TMAX)) ? (
                q = tri + 3 * ms_ntri[v]; q[0] = t[0]; q[1] = t[1]; q[2] = t[2];
                ms_ntri[v] += 1;
            );
            k += 1;
        );
        // the edges of the hull : those of a single triangle
        nh = 0; k = 0;
        loop(ms_ntri[v] * 3,
            u = tri[3 * floor(k / 3) + (k % 3)]; w = tri[3 * floor(k / 3) + ((k + 1) % 3)];
            ok = 1; j = 0;
            loop(ms_ntri[v] * 3,
                ((j !== k) && (((tri[3 * floor(j / 3) + (j % 3)] === u) && (tri[3 * floor(j / 3) + ((j + 1) % 3)] === w)) ||
                    ((tri[3 * floor(j / 3) + (j % 3)] === w) && (tri[3 * floor(j / 3) + ((j + 1) % 3)] === u)))) ? ok = 0;
                j += 1;
            );
            (ok && (nh < MS_MAXC * 2)) ? (hul[2 * nh] = u; hul[2 * nh + 1] = w; nh += 1;);
            k += 1;
        );
        ms_nhul[v] = nh;
    );
    // no triangle (two configurations, or all on a line) : their order along the line of the two farthest ones
    ((ms_ntri[v] === 0) && (n >= 2)) ? (
        ms_lin[v] = 1;
        dm = -1; i0 = i1 = 0; i = 0;
        loop(n, j = i + 1; loop(n - i - 1, d = sqr(ms_X[i] - ms_X[j]) + sqr(ms_Y[i] - ms_Y[j]); (d > dm) ? (dm = d; i0 = i; i1 = j;); j += 1;); i += 1;);
        d = sqrt(max(0.000000000001, dm));
        ms_l0[v] = i0; ms_ldx[v] = (ms_X[i1] - ms_X[i0]) / d; ms_ldy[v] = (ms_Y[i1] - ms_Y[i0]) / d;
        i = 0;
        loop(n,
            x = (ms_X[i] - ms_X[i0]) * ms_ldx[v] + (ms_Y[i] - ms_Y[i0]) * ms_ldy[v];
            // (insertion by abscissa)
            j = i;
            while ((j > 0) && (ms_ta[v * MS_MAXC + j - 1] > x)) (
                ms_ta[v * MS_MAXC + j] = ms_ta[v * MS_MAXC + j - 1]; ms_ord[v * MS_MAXC + j] = ms_ord[v * MS_MAXC + j - 1]; j -= 1;
            );
            ms_ta[v * MS_MAXC + j] = x; ms_ord[v * MS_MAXC + j] = i;
            i += 1;
        );
    );
    ms_tkE[v] = e; ms_tkS[v] = ms_seq[e];
);

// The coordinates of the point X, Y (the metric of the surface) among the configurations of the view v (its triangulation) :
// ms_cn of them (0 ... 3), the indices ms_c0 ... ms_c2, the coordinates ms_b0 ... ms_b2 (sum 1) : in a triangle, its
// barycentric coordinates ; outside the hull, those of the nearest point of its nearest edge ; on a line, between the two
// neighbours (beyond its ends : the end one) ; one configuration : itself
function ms_Coords(v, e, X, Y) local(n, tri, hul, k, t, ax, ay, bx, by, cx, cy, d, l1, l2, l3, found, dm, u, w, ex, ey, ll, xa, i, o, ta)
(
    n = ms_N(e); ms_cn = 0;
    (n === 1) ? (
        ms_cn = 1; ms_c0 = 0; ms_b0 = 1;
    ) : ms_lin[v] ? (
        o = ms_ord + v * MS_MAXC; ta = ms_ta + v * MS_MAXC;
        xa = (X - ms_X0[v]) * ms_ldx[v] + (Y - ms_Y0[v]) * ms_ldy[v];
        (xa <= ta[0]) ? (ms_cn = 1; ms_c0 = o[0]; ms_b0 = 1;) :
        (xa >= ta[n - 1]) ? (ms_cn = 1; ms_c0 = o[n - 1]; ms_b0 = 1;) : (
            i = 0; while ((i < n - 2) && (xa > ta[i + 1])) (i += 1;);
            ll = (xa - ta[i]) / max(0.000000000001, ta[i + 1] - ta[i]);
            ms_cn = 2; ms_c0 = o[i]; ms_b0 = 1 - ll; ms_c1 = o[i + 1]; ms_b1 = ll;
        );
    ) : (n >= 3) ? (
        tri = ms_tri + v * MS_TMAX * 3;
        found = 0; k = 0;
        while (!found && (k < ms_ntri[v])) (
            t = tri + 3 * k;
            ax = ms_PX[t[0]]; ay = ms_PY[t[0]]; bx = ms_PX[t[1]]; by = ms_PY[t[1]]; cx = ms_PX[t[2]]; cy = ms_PY[t[2]];
            d = (by - cy) * (ax - cx) + (cx - bx) * (ay - cy);
            (abs(d) > 0.000000000001) ? (
                l1 = ((by - cy) * (X - cx) + (cx - bx) * (Y - cy)) / d;
                l2 = ((cy - ay) * (X - cx) + (ax - cx) * (Y - cy)) / d;
                l3 = 1 - l1 - l2;
                ((l1 >= -0.000000001) && (l2 >= -0.000000001) && (l3 >= -0.000000001)) ? (
                    found = 1; ms_cn = 3;
                    ms_c0 = t[0]; ms_b0 = max(0, l1); ms_c1 = t[1]; ms_b1 = max(0, l2); ms_c2 = t[2]; ms_b2 = max(0, l3);
                );
            );
            k += 1;
        );
        // outside the hull : the nearest point of its edges
        (!found && (ms_nhul[v] > 0)) ? (
            hul = ms_hul + v * MS_MAXC * 4;
            dm = 10^30; k = 0;
            loop(ms_nhul[v],
                u = hul[2 * k]; w = hul[2 * k + 1];
                ex = ms_PX[w] - ms_PX[u]; ey = ms_PY[w] - ms_PY[u];
                ll = max(0, min(1, ((X - ms_PX[u]) * ex + (Y - ms_PY[u]) * ey) / max(0.000000000001, ex * ex + ey * ey)));
                d = sqr(X - ms_PX[u] - ll * ex) + sqr(Y - ms_PY[u] - ll * ey);
                (d < dm) ? (dm = d; ms_cn = 2; ms_c0 = u; ms_b0 = 1 - ll; ms_c1 = w; ms_b1 = ll;);
                k += 1;
            );
        );
    );
);
// The places of the configurations of the entry e in the metric of the surface (ms_PX, ms_PY ; ms_X0, ms_Y0 : the origin of
// the line of the view v) ; the triangulation made again if needed
ms_PX = make_array(MS_MAXC); ms_PY = make_array(MS_MAXC); ms_X0 = make_array(MS_NV); ms_Y0 = make_array(MS_NV);
function ms_Places(v, e) local(n, a, i)
(
    ((ms_tkE[v] !== e) || (ms_tkS[v] !== ms_seq[e])) ? ms_Triangulate(v, e);
    n = ms_N(e); a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    i = 0; loop(n, ms_PX[i] = ms_Cv(e, i, 1) * a; ms_PY[i] = ms_Cv(e, i, 2); i += 1;);
    ms_lin[v] ? (ms_X0[v] = ms_PX[ms_l0[v]]; ms_Y0[v] = ms_PY[ms_l0[v]];);
);

// The brush of the view v : its centre (ms_cx, ms_cy, in the metric of the surface), its angle (ms_th, radians), its radius
// (ms_BR, in heights of the surface : Spread x the diagonal), the scales of its axes (ms_ax, ms_ay : Stretch, the same area)
function ms_Brush(v, e) local(a, off)
(
    a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    // (step 3 : during a fade-in or a fade-out, the spread follows the envelope)
    ms_BR = max(0.005, ms_S(e, ms_sSpread) * ((ms_st[v] === 0) ? 1 : ms_env[v])) * sqrt(a * a + 1);
    // (the angle from the vertical, clockwise : 0 up, 90 to the right ; ms_th from the x axis, y down)
    ms_th = (ms_S(e, ms_sAngle) / 360 + ms_ph[v]) * 2 * $pi - $pi / 2;
    off = max(0, min(2, ms_S(e, ms_sOffset))) * ms_BR; // (2026-11-23, the user : up to 200 %)
    ms_cx = ms_bx[v] * a + off * cos(ms_th); ms_cy = ms_by[v] + off * sin(ms_th);
    ms_ax = sqrt(max(0.1, min(10, ms_S(e, ms_sStretch)))); ms_ay = 1 / ms_ax;
);
// The shares of the configurations under the brush of the view v (ms_sh + v * MS_MAXC) and its coverage (ms_cov[v]) : the
// mean of the shares of its samples inside the surface, weighted by its energy ; the share of a sample : its coordinates
// (ms_Coords) each one b -> sin^2(pi b / 2) (the law of the Hyper Slider : on a line, cos^2 and sin^2 of mergeconf), times
// the weight of its configuration, normalized
function ms_Shares(v, e) local(n, a, sh, P, S, j, k, r, pw, phi, rho, lx, ly, X, Y, wg, all, win, s0, s1, s2, sn, ct, st)
(
    n = ms_N(e); a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    sh = ms_sh + v * MS_MAXC; memset(sh, 0, MS_MAXC);
    ms_Places(v, e); ms_Brush(v, e);
    P = ms_S(e, ms_sPower); S = max(0, min(2, ms_S(e, ms_sShape)));
    ct = cos(ms_th); st = sin(ms_th);
    all = win = 0;
    j = 0;
    loop(MS_RINGS,
        r = (j + 0.5) / MS_RINGS; pw = ms_Prof(r, P) * r;
        k = 0;
        loop(MS_RAYS,
            phi = 2 * $pi * (k + 0.5 * (j & 1)) / MS_RAYS; rho = ms_Rho(phi, S);
            lx = r * rho * cos(phi) * ms_ax * ms_BR; ly = r * rho * sin(phi) * ms_ay * ms_BR;
            X = ms_cx + lx * ct - ly * st; Y = ms_cy + lx * st + ly * ct;
            wg = pw * rho * rho;
            all += wg;
            ((n > 0) && ms_InUV(e, X / a, Y, 0)) ? (
                win += wg;
                ms_Coords(v, e, X, Y);
                s0 = (ms_cn >= 1) ? sqr(sin($pi * ms_b0 / 2)) * ms_Cv(e, ms_c0, 3) : 0;
                s1 = (ms_cn >= 2) ? sqr(sin($pi * ms_b1 / 2)) * ms_Cv(e, ms_c1, 3) : 0;
                s2 = (ms_cn >= 3) ? sqr(sin($pi * ms_b2 / 2)) * ms_Cv(e, ms_c2, 3) : 0;
                sn = s0 + s1 + s2;
                (sn > 0) ? (
                    (ms_cn >= 1) ? sh[ms_c0] += wg * s0 / sn;
                    (ms_cn >= 2) ? sh[ms_c1] += wg * s1 / sn;
                    (ms_cn >= 3) ? sh[ms_c2] += wg * s2 / sn;
                );
            );
            k += 1;
        );
        j += 1;
    );
    (win > 0) ? (k = 0; loop(n, sh[k] /= win; k += 1;));
    ms_cov[v] = (all > 0) ? win / all : 0;
);
// (2026-11-24, step 3) The modulator j (0 the rotation, 1 the speed, 2 the mix) of the view v (entry e) : its phase (the
// cycle Path : the place of the brush on the path, the part of its length, ms_marc ; else its own phase, ms_mph, ms_ModStep),
// its value depth x F(phase) (off, or no curve : 0)
function ms_ModPh(v, e, j) ( (ms_S(e, ms_sMod + 3 * j + 1) > 0) ? ms_mph[3 * v + j] : ms_marc[v]; );
function ms_ModV(v, e, j) local(k)
(
    k = ms_S(e, ms_sMod + 3 * j) - 1;
    ((k >= 0) && crv_Ex(k)) ? ms_S(e, ms_sMod + 3 * j + 2) * crv_F(k, ms_ModPh(v, e, j)) : 0;
);
function ms_ModOn(e, j) local(k) ( k = ms_S(e, ms_sMod + 3 * j) - 1; (k >= 0) && crv_Ex(k); );
// The brush of the view v moved by the time (its rotation ; 2026-11-24 : modulated), its shares computed ; returns 1 if it
// turns
function ms_Update(v, e) local(t, rot)
(
    t = time_precise(); rot = ms_S(e, ms_sRot) * (1 + ms_ModV(v, e, 0)); // (2026-11-24, step 3 : modulated)
    ((ms_lt[v] > 0) && (t > ms_lt[v]) && !ms_pz[v]) ? ms_ph[v] += rot * min(0.5, t - ms_lt[v]); // (paused : it stays)
    ms_ph[v] -= floor(ms_ph[v]);
    ms_lt[v] = t;
    ms_Shares(v, e);
    (rot != 0) && !ms_pz[v];
);
// The brush of the view v drawn (screen pixels : the surface at ms_gx ...) : yellow (in Play, not sounding : step 3 makes
// it green), its contour, the contour where its energy is half, its centre, the place of the mouse ; held : dashed
// A line drawn inside the rectangle of the view (ms_vx, ms_vy, ms_vrw, ms_vrh : the part outside it cut ; Liang-Barsky)
function ms_Line(x0, y0, x1, y1) local(dx, dy, t0, t1, p, q, k, r, ok)
(
    dx = x1 - x0; dy = y1 - y0; t0 = 0; t1 = 1; ok = 1;
    k = 0;
    loop(4,
        (k === 0) ? (p = -dx; q = x0 - ms_vx;) : (k === 1) ? (p = dx; q = ms_vx + ms_vrw - 1 - x0;) :
        (k === 2) ? (p = -dy; q = y0 - ms_vy;) : (p = dy; q = ms_vy + ms_vrh - 1 - y0;);
        (p == 0) ? (
            (q < 0) ? ok = 0;
        ) : (
            r = q / p;
            (p < 0) ? ((r > t1) ? ok = 0 : (r > t0) ? t0 = r;) : ((r < t0) ? ok = 0 : (r < t1) ? t1 = r;);
        );
        k += 1;
    );
    (ok && (t0 <= t1)) ? gfx_line(x0 + t0 * dx, y0 + t0 * dy, x0 + t1 * dx, y0 + t1 * dy, 1);
);
// (2026-11-23, the user) A line t pixels wide inside the view (parallel lines, ms_Line)
function ms_TLine(x0, y0, x1, y1, t) local(d, nx, ny, k, n, o)
(
    d = sqrt(sqr(x1 - x0) + sqr(y1 - y0));
    (d > 0.01) ? (
        nx = (y0 - y1) / d; ny = (x1 - x0) / d;
        n = max(1, ceil(t / 0.7));
        k = 0;
        loop(n,
            o = (n > 1) ? (k / (n - 1) - 0.5) * (t - 1) : 0;
            ms_Line(x0 + nx * o, y0 + ny * o, x1 + nx * o, y1 + ny * o);
            k += 1;
        );
    );
);
// The color of the halo of the view v, its opacity al : yellow (not sounding), green (sounding, or fading ; step 3) ;
// 2026-11-23 (the user : the path well visible, the brush less) : darker on the light themes (ms_hlt, set by ms_Draw)
function ms_HaloSet(v, al)
(
    (ms_st[v] > 0) ? (ms_hlt ? gfx_set(0, 0.58, 0.2, al) : gfx_set(0.25, 0.95, 0.4, al)) :
        (ms_hlt ? gfx_set(0.85, 0.5, 0, al) : gfx_set(1, 0.85, 0.1, al));
);
// The brush of the view v drawn : its contour and the contour where its energy is half (held : dashed), over a wider line
// of the background (2026-11-23) ; its centre, the place of the mouse (a cross)
function ms_DrawBrush(v, e) local(a, k, phi, rho, r, lx, ly, X, Y, px, py, qx, qy, ct, st, rs, r50, P, S, m, al, w, pass, hd, q)
(
    a = max(0.5, min(4, ms_S(e, ms_sAspect))); rs = uix_drawconfig_current[9];
    ms_Brush(v, e); // (the brush of this view : ms_Frame computed those of all the views)
    P = ms_S(e, ms_sPower); S = max(0, min(2, ms_S(e, ms_sShape)));
    ct = cos(ms_th); st = sin(ms_th);
    r50 = 1 - 0.5 ^ (1 / (8 ^ max(-1, min(1, P)))); // (the radius where the energy is half that of the centre)
    hd = ms_Held(v);
    m = 0;
    loop(2,
        r = (m === 0) ? 1 : r50; al = (m === 0) ? 1 : 0.6;
        w = (m === 0) ? max(2, floor(1.5 * rs + 0.5)) : max(1, floor(rs + 0.5));
        // the points of the contour (screen pixels)
        k = 0;
        loop(49,
            phi = 2 * $pi * k / 48; rho = ms_Rho(phi, S);
            lx = r * rho * cos(phi) * ms_ax * ms_BR; ly = r * rho * sin(phi) * ms_ay * ms_BR;
            X = ms_cx + lx * ct - ly * st; Y = ms_cy + lx * st + ly * ct;
            ms_bq[2 * k] = ms_gx[v] + X / a * ms_gw[v]; ms_bq[2 * k + 1] = ms_gy[v] + Y * ms_gh[v];
            k += 1;
        );
        pass = 0;
        loop(2,
            (pass === 0) ? gfx_set(ms_bgr, ms_bgg, ms_bgb, 0.6 * al) : ms_HaloSet(v, al);
            k = 1;
            loop(48,
                (!hd || (k & 1)) ? ms_TLine(ms_bq[2 * k - 2], ms_bq[2 * k - 1], ms_bq[2 * k], ms_bq[2 * k + 1], (pass === 0) ? w + 2 : w);
                k += 1;
            );
            pass += 1;
        );
        m += 1;
    );
    // the centre of the brush, the place of the mouse (when the offset moves the centre away from it : a line)
    px = ms_gx[v] + ms_cx / a * ms_gw[v]; py = ms_gy[v] + ms_cy * ms_gh[v];
    qx = ms_gx[v] + ms_bx[v] * ms_gw[v]; qy = ms_gy[v] + ms_by[v] * ms_gh[v];
    ((abs(px - qx) + abs(py - qy)) > 2) ? (ms_HaloSet(v, 0.6); ms_TLine(qx, qy, px, py, max(1, floor(rs + 0.5))););
    ((px - 5 * rs >= ms_vx) && (py - 5 * rs >= ms_vy) && (px + 5 * rs < ms_vx + ms_vrw) && (py + 5 * rs < ms_vy + ms_vrh)) ? (
        gfx_set(ms_bgr, ms_bgg, ms_bgb, 0.7); gfx_circle(px, py, 3 * rs + 1.5, 1, 1);
        ms_HaloSet(v, 1); gfx_circle(px, py, 3 * rs, 1, 1);
    );
    q = 6 * rs; w = max(2, floor(1.5 * rs + 0.5));
    gfx_set(ms_bgr, ms_bgg, ms_bgb, 0.6);
    ms_TLine(qx - q - 1, qy, qx + q + 1, qy, w + 2); ms_TLine(qx, qy - q - 1, qx, qy + q + 1, w + 2);
    ms_HaloSet(v, 1);
    ms_TLine(qx - q, qy, qx + q, qy, w); ms_TLine(qx, qy - q, qx, qy + q, w);
);

// The brush of the view v under the mouse (mx, my : screen pixels) : 1 its cross (the place of the mouse), 2 its shape (inside
// its contour, or near it), 0 none
function ms_BrushHit(v, e, mx, my) local(a, rs, qx, qy, X, Y, dx, dy, ct, st, lx, ly, phi, r)
(
    a = max(0.5, min(4, ms_S(e, ms_sAspect))); rs = uix_drawconfig_current[9];
    ms_Brush(v, e);
    qx = ms_gx[v] + ms_bx[v] * ms_gw[v]; qy = ms_gy[v] + ms_by[v] * ms_gh[v];
    (sqr(mx - qx) + sqr(my - qy) <= sqr(7 * rs)) ? 1 : (
        X = (mx - ms_gx[v]) / max(1, ms_gw[v]) * a; Y = (my - ms_gy[v]) / max(1, ms_gh[v]);
        dx = X - ms_cx; dy = Y - ms_cy; ct = cos(ms_th); st = sin(ms_th);
        lx = (dx * ct + dy * st) / (ms_ax * ms_BR); ly = (dy * ct - dx * st) / (ms_ay * ms_BR);
        phi = atan2(ly, lx);
        r = sqrt(lx * lx + ly * ly) / ms_Rho(phi, max(0, min(2, ms_S(e, ms_sShape))));
        (r <= 1 + 6 * rs / max(1, ms_BR * ms_gh[v])) ? 2 : 0;
    );
);
// Shift + clic on the cell Rotation : Off, then back to the rotation before
function ms_RotToggle(e) local(r)
(
    r = ms_S(e, ms_sRot);
    (r != 0) ? (ms_SSet(e, ms_sRotMem, r); ms_SSet(e, ms_sRot, 0);) :
    (ms_S(e, ms_sRotMem) != 0) ? ms_SSet(e, ms_sRot, ms_S(e, ms_sRotMem));
);

// ---- Step 5 : the trajectories

// A point x, y of the frame of the editors (the plane of the trajectories, -1 ... 1) in the surface of the entry e (ms_cu,
// ms_cv), and back (ms_cx2, ms_cy2) : the surface in the square [-1, 1], its long side across it, centred ; x to the right,
// y forward (up in the view from the top) : v down
function ms_XY2U(e, x, y) local(a)
(
    a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    (a >= 1) ? (ms_cu = (x + 1) / 2; ms_cv = (1 - y * a) / 2;) : (ms_cu = (x / a + 1) / 2; ms_cv = (1 - y) / 2;);
);
function ms_U2XY(e, u, v) local(a)
(
    a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    (a >= 1) ? (ms_cx2 = 2 * u - 1; ms_cy2 = (1 - 2 * v) / a;) : (ms_cx2 = (2 * u - 1) * a; ms_cy2 = 1 - 2 * v;);
);
// (2026-11-23, the user) The placement of the path on the surface of the entry e (ms_sTx ... ms_sTk), in the metric of the
// surface (x in heights, y down) : ms_tfx, ms_tfy the shift, ms_tfc, ms_tfs the rotation (clockwise), ms_tfk the scale,
// ms_tfa the aspect
function ms_TfGet(e) local(k)
(
    ms_tfa = max(0.5, min(4, ms_S(e, ms_sAspect)));
    ms_tfx = ms_S(e, ms_sTx) * ms_tfa; ms_tfy = -ms_S(e, ms_sTy);
    ms_tfc = cos(ms_S(e, ms_sTa) * $pi / 180); ms_tfs = sin(ms_S(e, ms_sTa) * $pi / 180);
    k = ms_S(e, ms_sTk); ms_tfk = (k > 0) ? max(0.1, min(10, k)) : 1;
    // (2026-11-24) its flips, before the rotation (ms_tffx, ms_tffy : 1 or -1)
    ms_tffx = (ms_S(e, ms_sFlip) & 1) ? -1 : 1; ms_tffy = (ms_S(e, ms_sFlip) & 2) ? -1 : 1;
);
// (2026-11-24) The bit of the flip ax (0 left - right, 1 up - down) of the whole path (t < 0) or of the trajectory t
function ms_FlipBit(t, ax) ( 2 ^ ((t < 0) ? ax : 2 + 2 * t + ax); );
// a point u, v of the path (ms_XY2U) placed on the surface (ms_TfGet done) : ms_cu, ms_cv ; and back, a point of the
// surface into the frame of the path (then ms_U2XY : the frame of the editors)
function ms_TfFwd(u, v) local(dx, dy)
(
    dx = (u - 0.5) * ms_tfa * ms_tffx; dy = (v - 0.5) * ms_tffy;
    ms_cu = 0.5 + (ms_tfx + ms_tfk * (ms_tfc * dx - ms_tfs * dy)) / ms_tfa;
    ms_cv = 0.5 + ms_tfy + ms_tfk * (ms_tfs * dx + ms_tfc * dy);
);
function ms_TfInv(u, v) local(dx, dy)
(
    dx = (u - 0.5) * ms_tfa - ms_tfx; dy = v - 0.5 - ms_tfy;
    ms_cu = 0.5 + ms_tffx * (ms_tfc * dx + ms_tfs * dy) / ms_tfk / ms_tfa;
    ms_cv = 0.5 + ms_tffy * (ms_tfc * dy - ms_tfs * dx) / ms_tfk;
);
// (2026-11-24) The setting of the component i (0 x, 1 y, 2 turn, 3 scale) of the placement edited by the view v : that of
// the whole path (ms_sTx ...), or that of the trajectory placed (ms_plc : A ... D)
function ms_PlI(v, i) ( ((ms_plc[v] < 0) ? ms_sTx : ms_sPl + 4 * ms_plc[v]) + i; );
// (2026-11-24) The weights of the trajectories A ... D of the view v (entry e) now, in W : those of the mix along the chain
// (sp_WMix, Espaces-Spatial) ; during a glide, from those where it started to those of the mix (linear in time ; paused :
// it waits ; after its time : the mix)
function ms_WCur(v, e, W) local(u, k, w0, t)
(
    // (2026-11-24, step 3 : the mix modulated)
    sp_WMix(ms_S(e, ms_sTrN), max(0, min(1, ms_S(e, ms_sMix) + ms_ModV(v, e, 2))), W);
    ms_glOn[v] ? (
        t = ms_pz[v] ? ms_pzt[v] : time_precise();
        u = (t - ms_glT0[v]) / max(0.001, ms_glDur[v]);
        (u < 1) ? (
            u = max(0, u); w0 = ms_glW0 + 4 * v;
            k = 0; loop(4, W[k] = w0[k] + u * (W[k] - w0[k]); k += 1;);
        ) : (
            ms_glOn[v] = 0;
        );
    );
);
// A glide of the view v starts (before its new mix is written) : from its current trajectory to the one of its mix, in the
// time of the cell Glide (1 ... 300 s)
function ms_GlStart(v, e)
(
    ms_WCur(v, e, ms_wq);
    memcpy(ms_glW0 + 4 * v, ms_wq, 4);
    ms_glT0[v] = time_precise(); ms_glDur[v] = max(1, min(300, ms_S(e, ms_sGlide))); ms_glOn[v] = 1;
);
// A glide to the trajectory t (Cmd + clic on A ... D, as in the views Space) : the mix on it (beyond the chain : the chain
// grows to it)
function ms_GlideTo(v, e, t)
(
    ms_GlStart(v, e);
    (t < ms_S(e, ms_sTrN)) ? ms_SSet(e, ms_sMix, t / max(1, ms_S(e, ms_sTrN) - 1)) : (ms_SSet(e, ms_sTrN, t + 1); ms_SSet(e, ms_sMix, 1););
);
// The placements of the trajectories A ... D of the entry e in the frame of the editors (the format of the spatial
// projectors, sp_TpQ : SP_TPW words each, in ms_tpb) : the displacement of the barycentre (x, y : parts of the width and of
// the height of the surface, y up), the scale, the turn (clockwise : - Rz)
function ms_TpBuild(e) local(a, wd, hd, t, q, p)
(
    a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    wd = (a >= 1) ? 2 : 2 * a; hd = (a >= 1) ? 2 / a : 2;
    t = 0;
    loop(4,
        q = ms_tpb + t * SP_TPW; memset(q, 0, SP_TPW);
        p = ms_sPl + 4 * t;
        q[sp_tpX] = ms_S(e, p) * wd; q[sp_tpY] = ms_S(e, p + 1) * hd;
        q[sp_tpRz] = - ms_S(e, p + 2) * $pi / 180;
        q[sp_tpS] = (ms_S(e, p + 3) > 0) ? max(0.05, min(20, ms_S(e, p + 3))) : 1;
        // (the flips : a half turn around y, left - right ; around x, up - down ; as the inclinations of the views Space)
        q[sp_tpRy] = (ms_S(e, ms_sFlip) & ms_FlipBit(t, 0)) ? $pi : 0;
        q[sp_tpRx] = (ms_S(e, ms_sFlip) & ms_FlipBit(t, 1)) ? $pi : 0;
        t += 1;
    );
);
// The key of the path of the view v (the weights now in ms_wq) : 1 if it changed since it was built (kept)
function ms_PathKey(v, e) local(q, k, d, r)
(
    q = ms_pkq;
    q[0] = e; q[1] = sp_libSeq; q[2] = ms_S(e, ms_sAspect); q[3] = ms_S(e, ms_sRad);
    k = 0; loop(4, q[4 + k] = ms_S(e, ms_sTrK + k); q[8 + k] = ms_wq[k]; k += 1;);
    q[12] = ms_S(e, ms_sTx); q[13] = ms_S(e, ms_sTy); q[14] = ms_S(e, ms_sTa); q[15] = ms_S(e, ms_sTk);
    k = 0; loop(16, q[16 + k] = ms_S(e, ms_sPl + k); k += 1;);
    q[32] = ms_plc[v]; q[33] = ms_S(e, ms_sFlip);
    r = ms_pkv + v * MS_PKN; d = 0;
    k = 0; loop(34, (q[k] !== r[k]) ? (d = 1); k += 1;);
    d ? memcpy(r, q, 34);
    d;
);
// The points s3d_trj (n, closed cl : the first point again at the end) into the path at o (u, v ; their distances from the
// start, in the metric of the surface) placed on the surface (ms_TfGet done) ; returns its count
function ms_PathPut(e, pu, pv, pd, o, n, cl) local(a, L, k, i)
(
    a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    L = 0; k = 0; i = 0;
    (n > 0) ? loop(n + ((cl && (n > 1)) ? 1 : 0),
        ms_XY2U(e, s3d_trj[3 * (i % n)], s3d_trj[3 * (i % n) + 1]);
        ms_TfFwd(ms_cu, ms_cv);
        pu[o + k] = ms_cu; pv[o + k] = ms_cv;
        (k > 0) ? (L += sqrt(sqr((pu[o + k] - pu[o + k - 1]) * a) + sqr(pv[o + k] - pv[o + k - 1])));
        pd[o + k] = L;
        k += 1; i += 1;
    );
    ms_plen = L;
    k;
);
// The path of the view v (entry e) built again if needed (2026-11-24 : the trajectories A ... D blended by the weights of the
// mix or of a glide, each one placed, as the spatial projectors, sp_MkBlend, in the plane x, y of the editors ; then placed
// on the surface, ms_TfFwd) ; during the placement of a trajectory (ms_plc), it alone (ms_qu, ms_qv ; drawn gold) and its
// pivot (ms_pvu, ms_pvv)
function ms_PathLoad(v, e) local(n, o, cl, otsc, otrz, otrx, ottx, otty, ottz, oopt, t)
(
    ms_WCur(v, e, ms_wq);
    ms_PathKey(v, e) ? (
        ms_TpBuild(e);
        otsc = s3d_tsc; otrz = s3d_trz; otrx = s3d_trx; ottx = s3d_ttx; otty = s3d_tty; ottz = s3d_ttz; oopt = s3d_opt;
        s3d_tsc = 1; s3d_trz = s3d_trx = 0; s3d_ttx = s3d_tty = s3d_ttz = 0;
        s3d_opt = s3d_opt & (0x7FFFFFFF - s3d_oClamp);
        sp_MkBlend(ms_S(e, ms_sTrK), ms_S(e, ms_sTrK + 1), ms_S(e, ms_sTrK + 2), ms_S(e, ms_sTrK + 3), ms_wq, ms_S(e, ms_sRad), ms_tpb);
        n = min(SP_MAXTRJ, s3d_ntrj); cl = s3d_trjclosed;
        ms_TfGet(e);
        o = v * MS_PMAX;
        ms_pn[v] = ms_PathPut(e, ms_pu, ms_pv, ms_pd, o, n, cl); ms_ptot[v] = ms_plen;
        ms_qn[v] = 0;
        ((t = ms_plc[v]) >= 0) ? (
            sp_MkSlot(ms_S(e, ms_sTrK + t), t, ms_S(e, ms_sRad), ms_tpb);
            n = min(SP_MAXTRJ, s3d_ntrj); cl = s3d_trjclosed;
            ms_qn[v] = ms_PathPut(e, ms_qu, ms_qv, ms_qd, o, n, cl);
            ms_XY2U(e, sp_pvx, sp_pvy); ms_TfFwd(ms_cu, ms_cv); ms_pvu[v] = ms_cu; ms_pvv[v] = ms_cv;
        );
        s3d_tsc = otsc; s3d_trz = otrz; s3d_trx = otrx; s3d_ttx = ottx; s3d_tty = otty; s3d_ttz = ottz; s3d_opt = oopt;
    );
);
// The place at the progress s (0 ... 1) along the path of the view v : ms_cu, ms_cv (bp 1 : the same time between its
// points ; 0 : a constant speed along it)
function ms_PathAt(v, s, bp) local(o, n, i, f, t, L, g)
(
    o = v * MS_PMAX; n = ms_pn[v];
    (n === 1) ? (ms_cu = ms_pu[o]; ms_cv = ms_pv[o];) : (n >= 2) ? (
        bp ? (
            f = max(0, min(1, s)) * (n - 1); i = min(n - 2, floor(f)); t = f - i;
        ) : (
            L = max(0, min(1, s)) * ms_ptot[v]; i = 0;
            while ((i < n - 2) && (ms_pd[o + i + 1] < L)) (i += 1;);
            g = ms_pd[o + i + 1] - ms_pd[o + i]; t = (g > 0) ? (L - ms_pd[o + i]) / g : 0;
        );
        ms_cu = ms_pu[o + i] + t * (ms_pu[o + i + 1] - ms_pu[o + i]);
        ms_cv = ms_pv[o + i] + t * (ms_pv[o + i + 1] - ms_pv[o + i]);
    );
);
// (2026-11-24) The part of the length of the path of the view v (built) at the progress s placed by ms_PathAt(v, s, bp)
function ms_ArcOf(v, s, bp) local(o, n, f, i, t)
(
    o = v * MS_PMAX; n = ms_pn[v];
    ((n < 2) || (ms_ptot[v] <= 0)) ? 0 : !bp ? max(0, min(1, s)) : (
        f = max(0, min(1, s)) * (n - 1); i = min(n - 2, floor(f)); t = f - i;
        (ms_pd[o + i] + t * (ms_pd[o + i + 1] - ms_pd[o + i])) / ms_ptot[v];
    );
);
// The motion started (from the start of the path ; Loop reverse : from its end) if it is not running
function ms_MoveStart(v) ( !ms_mv[v] ? (ms_mv[v] = 1; ms_mx[v] = 0; ms_mlt[v] = time_precise(); ms_mlp[v] = -1; memset(ms_mph + 3 * v, 0, 3);); );
// (2026-11-23) The place s (0 ... 1, the part of the duration) on the path for the progress x (in durations) of the motion
// lp (0 Once, 1 Loop, 2 Back and forth, 3 Loop reverse) ; its direction : ms_dir (1 forward, -1 backward)
function ms_SOf(lp, x) local(y)
(
    (lp === 0) ? (ms_dir = 1; max(0, min(1, x))) :
    (lp === 1) ? (ms_dir = 1; x - floor(x)) :
    (lp === 3) ? (ms_dir = -1; 1 - (x - floor(x))) :
    (y = x / 2 - floor(x / 2); ms_dir = (y < 0.5) ? 1 : -1; (y < 0.5) ? 2 * y : 2 - 2 * y);
);
// (2026-11-23, the user) The pause of the view v (on 1, 0 : off) : the motion along the path and the rotation of the brush
// stopped where they are, the sound going on (the shares do not change) ; off : they go on from there
function ms_PauseSet(v, on) local(t)
(
    t = time_precise();
    (on && !ms_pz[v]) ? (ms_pz[v] = 1; ms_pzt[v] = t;) :
    (!on && ms_pz[v]) ? (ms_pz[v] = 0; ms_lt[v] = t; ms_mlt[v] = t; ms_glT0[v] += t - ms_pzt[v];); // (a glide waits too)
);

// The path of the view v (entry e, built : ms_PathLoad ; lt : a light background), 2026-11-23 (the user : hardly visible) :
// a line in a color seen on all the themes (a dark magenta on the light ones, a light one on the dark ones) over a wider
// line of the background ; its start (a dot) ; its direction (an arrow at its middle ; Loop reverse : backwards)
function ms_PathDraw(v, e, lt) local(o, i, rs, w, m, x0, y0, x1, y1, cr, cg, cb, dx, dy, d, px, py)
(
    o = v * MS_PMAX; rs = uix_drawconfig_current[9];
    w = max(2, floor(1.3 * rs + 0.5)); // (2026-11-23 : a little thinner and lighter, the brush over it stays readable)
    cr = lt ? 0.62 : 1; cg = lt ? 0.06 : 0.5; cb = lt ? 0.52 : 0.95;
    m = 0;
    loop(2,
        (m === 0) ? gfx_set(ms_bgr, ms_bgg, ms_bgb, 0.5) : gfx_set(cr, cg, cb, 0.75);
        x0 = ms_gx[v] + ms_pu[o] * ms_gw[v]; y0 = ms_gy[v] + ms_pv[o] * ms_gh[v];
        i = 1;
        loop(ms_pn[v] - 1,
            x1 = ms_gx[v] + ms_pu[o + i] * ms_gw[v]; y1 = ms_gy[v] + ms_pv[o + i] * ms_gh[v];
            // (the points closer than 2 pixels : one segment ; a recording has one point every 50 ms)
            ((abs(x1 - x0) + abs(y1 - y0) >= 2) || (i === ms_pn[v] - 1)) ? (
                ms_TLine(x0, y0, x1, y1, (m === 0) ? w + 2 : w);
                x0 = x1; y0 = y1;
            );
            i += 1;
        );
        m += 1;
    );
    // the start
    px = ms_gx[v] + ms_pu[o] * ms_gw[v]; py = ms_gy[v] + ms_pv[o] * ms_gh[v];
    ((px - 5 * rs >= ms_vx) && (py - 5 * rs >= ms_vy) && (px + 5 * rs < ms_vx + ms_vrw) && (py + 5 * rs < ms_vy + ms_vrh)) ? (
        gfx_set(ms_bgr, ms_bgg, ms_bgb, 0.8); gfx_circle(px, py, 3.5 * rs + 1, 1, 1);
        gfx_set(cr, cg, cb, 1); gfx_circle(px, py, 3.5 * rs, 1, 1);
    );
    // the direction : an arrow at the middle of the path
    (ms_ptot[v] > 0.001) ? (
        ms_PathAt(v, 0.49, 0); x0 = ms_gx[v] + ms_cu * ms_gw[v]; y0 = ms_gy[v] + ms_cv * ms_gh[v];
        ms_PathAt(v, 0.51, 0); x1 = ms_gx[v] + ms_cu * ms_gw[v]; y1 = ms_gy[v] + ms_cv * ms_gh[v];
        dx = x1 - x0; dy = y1 - y0; d = sqrt(dx * dx + dy * dy);
        (((ms_mv[v] ? ms_mdr[v] : (ms_S(e, ms_sLoop) === 3) ? -1 : 1)) < 0) ? (dx = -dx; dy = -dy;); // (the direction now)
        px = (x0 + x1) / 2; py = (y0 + y1) / 2;
        ((d > 0.01) && (px - 8 * rs >= ms_vx) && (py - 8 * rs >= ms_vy) && (px + 8 * rs < ms_vx + ms_vrw) && (py + 8 * rs < ms_vy + ms_vrh)) ? (
            dx /= d; dy /= d;
            gfx_set(cr, cg, cb, 1);
            gfx_triangle(px + dx * 6 * rs, py + dy * 6 * rs, px - dx * 4 * rs - dy * 4.5 * rs, py - dy * 4 * rs + dx * 4.5 * rs,
                px - dx * 4 * rs + dy * 4.5 * rs, py - dy * 4 * rs - dx * 4.5 * rs);
        );
    );
    // (2026-11-24) the trajectory placed alone (cell Place, Alt + clic on A ... D) : gold, its pivot (a red cross)
    (ms_plc[v] >= 0) ? (
        o = v * MS_PMAX; w = max(1, floor(rs + 0.5));
        gfx_set(0.85, 0.65, 0.13, 0.95);
        x0 = ms_gx[v] + ms_qu[o] * ms_gw[v]; y0 = ms_gy[v] + ms_qv[o] * ms_gh[v];
        i = 1;
        loop(ms_qn[v] - 1,
            x1 = ms_gx[v] + ms_qu[o + i] * ms_gw[v]; y1 = ms_gy[v] + ms_qv[o + i] * ms_gh[v];
            ((abs(x1 - x0) + abs(y1 - y0) >= 2) || (i === ms_qn[v] - 1)) ? (ms_TLine(x0, y0, x1, y1, w); x0 = x1; y0 = y1;);
            i += 1;
        );
        px = ms_gx[v] + ms_pvu[v] * ms_gw[v]; py = ms_gy[v] + ms_pvv[v] * ms_gh[v];
        gfx_set(0.95, 0.15, 0.1, 1);
        ms_TLine(px - 7 * rs, py, px + 7 * rs, py, max(2, w)); ms_TLine(px, py - 7 * rs, px, py + 7 * rs, max(2, w));
    );
    // a placement turned or scaled with the mouse (ms_PlMouse) : its centre, a line to the mouse
    ((ms_qk[v] > 1) && (ms_qcx - 7 * rs >= ms_vx) && (ms_qcy - 7 * rs >= ms_vy) && (ms_qcx + 7 * rs < ms_vx + ms_vrw) &&
        (ms_qcy + 7 * rs < ms_vy + ms_vrh)) ? (
        gfx_set(cr, cg, cb, 0.95);
        gfx_circle(ms_qcx, ms_qcy, 4 * rs, 0, 1);
        ms_Line(ms_qcx - 6 * rs, ms_qcy, ms_qcx + 6 * rs, ms_qcy); ms_Line(ms_qcx, ms_qcy - 6 * rs, ms_qcx, ms_qcy + 6 * rs);
        gfx_set(cr, cg, cb, 0.5); ms_Line(ms_qcx, ms_qcy, mouse_x, mouse_y);
    );
);

// (2026-11-24, the user) The recording of the view v drawn as it goes (lt : a light background) : its points (the places of
// the brush, every MS_RDT s) as a red line over a wider line of the background, the last one a dot
function ms_RecDraw(v, lt) local(rb, n, i, rs, w, m, x0, y0, x1, y1)
(
    rb = ms_rb + v * SP_MAXTRJ * 2; n = ms_rn[v]; rs = uix_drawconfig_current[9];
    w = max(2, floor(1.3 * rs + 0.5));
    m = 0;
    loop(2,
        (m === 0) ? gfx_set(ms_bgr, ms_bgg, ms_bgb, 0.5) : (lt ? gfx_set(0.8, 0.1, 0.1, 0.9) : gfx_set(1, 0.35, 0.3, 0.9));
        x0 = ms_gx[v] + rb[0] * ms_gw[v]; y0 = ms_gy[v] + rb[1] * ms_gh[v];
        i = 1;
        loop(n - 1,
            x1 = ms_gx[v] + rb[2 * i] * ms_gw[v]; y1 = ms_gy[v] + rb[2 * i + 1] * ms_gh[v];
            ((abs(x1 - x0) + abs(y1 - y0) >= 2) || (i === n - 1)) ? (ms_TLine(x0, y0, x1, y1, (m === 0) ? w + 2 : w); x0 = x1; y0 = y1;);
            i += 1;
        );
        m += 1;
    );
    ((x0 - 4 * rs >= ms_vx) && (y0 - 4 * rs >= ms_vy) && (x0 + 4 * rs < ms_vx + ms_vrw) && (y0 + 4 * rs < ms_vy + ms_vrh)) ?
        gfx_circle(x0, y0, 3 * rs, 1, 1);
);

// (2026-11-24) The place at the part s (0 ... 1) of the length of the path of the view v (built, 2 points at least) : ms_kpu,
// ms_kpv (the surface), the direction of its segment in pixels ms_kdx, ms_kdy (a search by halves : the lengths increase)
function ms_PathTg(v, s) local(o, L, lo, hi, md, g, t)
(
    o = v * MS_PMAX;
    L = max(0, min(1, s)) * ms_ptot[v];
    lo = 0; hi = ms_pn[v] - 1;
    while (hi - lo > 1) ( md = floor((lo + hi) / 2); (ms_pd[o + md] < L) ? (lo = md) : (hi = md); );
    g = ms_pd[o + lo + 1] - ms_pd[o + lo]; t = (g > 0) ? max(0, min(1, (L - ms_pd[o + lo]) / g)) : 0;
    ms_kpu = ms_pu[o + lo] + t * (ms_pu[o + lo + 1] - ms_pu[o + lo]);
    ms_kpv = ms_pv[o + lo] + t * (ms_pv[o + lo + 1] - ms_pv[o + lo]);
    ms_kdx = (ms_pu[o + lo + 1] - ms_pu[o + lo]) * ms_gw[v]; ms_kdy = (ms_pv[o + lo + 1] - ms_pv[o + lo]) * ms_gh[v];
);
// (2026-11-24, the user : "which parts of the path will be slower or faster") The marks of the curve edited (the module
// "Curves A" ... used last, crv_MarkE) on the path of the view v (built ; lt : a light background) ; the x of the curve is
// the part of the length of the path from its start (as tr_Resample reads it) :
//  - the density of the curve : MS_CTK ticks across the path where the resampling would place the points (its depth now,
//    tr_rdep) ; close ticks : the brush slow there (Speed : points), apart : fast ;
//  - the points of the curve (small dots ; the types HEnv, QWave, HWave : each place of the complete form) ;
//  - the x under the mouse in the graph of the editor : a ring ;
//  - the selected points : larger (Goldenrod as in the editor ; the mirrors of the other types : circles), their numbers
//    (8 selected at most).
// Nothing when no editor is shown, or when its curve has no point selected and the mouse is not over its graph.
function ms_CrvMarks(v, lt) local(E, k, b, ty, n, p, sf, sok, nsel, i, j, m, g, t, lo, f, s, px, py, d, nx, ny, rs, w, sl, cr, tw, th)
(
    E = crv_MarkE();
    k = (E >= 0) ? crv_ed[E * CRV_ES] : -1;
    ((k >= 0) && crv_Ex(k) && (ms_ptot[v] > 0.0001)) ? (
        b = crv_B(k); ty = b[crv_fT]; n = b[crv_fN]; p = b + crv_fP;
        sf = crv_edSel + E * CRV_PMX; sok = (crv_ed[E * CRV_ES + 11] === k);
        nsel = 0; i = 0; loop(n, (sok && sf[i]) ? (nsel += 1); i += 1;);
        ((nsel > 0) || (crv_hovX[E] >= 0)) ? (
            rs = uix_drawconfig_current[9]; w = max(1, floor(rs + 0.5));
            cr = lt ? 0.1 : 0.95; // (the ticks, the ring : black or white)
            // the density integrated (as tr_Resample), then the ticks at its equal parts (not at the ends)
            ms_cgd[0] = 0;
            i = 1; loop(MS_CGK, ms_cgd[i] = ms_cgd[i - 1] + 2 ^ (tr_rdep * crv_F(k, (i - 0.5) / MS_CGK)); i += 1;);
            gfx_set(cr, cr, cr, 0.8);
            lo = 0; j = 1;
            loop(MS_CTK - 1,
                t = ms_cgd[MS_CGK] * j / MS_CTK;
                while ((lo < MS_CGK - 1) && (ms_cgd[lo + 1] < t)) (lo += 1;);
                g = ms_cgd[lo + 1] - ms_cgd[lo]; f = (g > 0) ? max(0, min(1, (t - ms_cgd[lo]) / g)) : 0;
                s = (lo + f) / MS_CGK;
                ms_PathTg(v, s);
                px = ms_gx[v] + ms_kpu * ms_gw[v]; py = ms_gy[v] + ms_kpv * ms_gh[v];
                d = sqrt(ms_kdx * ms_kdx + ms_kdy * ms_kdy);
                (d > 0.0001) ? ( nx = -ms_kdy / d; ny = ms_kdx / d; ) : ( nx = 0; ny = 1; );
                ms_TLine(px - nx * 5 * rs, py - ny * 5 * rs, px + nx * 5 * rs, py + ny * 5 * rs, w);
                j += 1;
            );
            // the points of the curve, the selected ones last (over the others)
            m = 0;
            loop(2,
                i = 0;
                loop(n,
                    sl = (sok && sf[i]) ? 1 : 0;
                    (sl === m) ? (
                        g = crv_Us(ty, p[3 * i]);
                        j = 0;
                        loop(g,
                            ms_PathTg(v, crv_up[j]);
                            px = ms_gx[v] + ms_kpu * ms_gw[v]; py = ms_gy[v] + ms_kpv * ms_gh[v];
                            ((px - 8 * rs >= ms_vx) && (py - 8 * rs >= ms_vy) && (px + 8 * rs < ms_vx + ms_vrw) && (py + 8 * rs < ms_vy + ms_vrh)) ? (
                                sl ? (
                                    gfx_set(lt ? 0.1 : 0.05, lt ? 0.1 : 0.05, lt ? 0.1 : 0.05, 0.9);
                                    gfx_circle(px, py, 5.5 * rs + 1, (j === 0), 1);
                                    gfx_set(0.855, 0.647, 0.125, 1); // (Goldenrod)
                                    gfx_circle(px, py, 5.5 * rs, (j === 0), 1);
                                    (j > 0) ? gfx_circle(px, py, 5.5 * rs - 1, 0, 1);
                                    ((j === 0) && (nsel <= 8)) ? (
                                        sprintf(#ms_lbl, "P%d", i + 1);
                                        gfx_measurestr(#ms_lbl, tw, th);
                                        gfx_set(lt ? 0.15 : 0.9, lt ? 0.15 : 0.9, lt ? 0.15 : 0.9, 0.95);
                                        gfx_x = min(px + 7 * rs, ms_vx + ms_vrw - tw - 2); gfx_y = py - 7 * rs - th;
                                        gfx_drawstr(#ms_lbl);
                                    );
                                ) : (
                                    gfx_set(lt ? 0.1 : 0.05, lt ? 0.1 : 0.05, lt ? 0.1 : 0.05, 0.8);
                                    gfx_circle(px, py, 2.5 * rs + 1, 1, 1);
                                    gfx_set(0.196, 0.804, 0.196, 1); // (Limegreen)
                                    gfx_circle(px, py, 2.5 * rs, 1, 1);
                                );
                            );
                            j += 1;
                        );
                    );
                    i += 1;
                );
                m += 1;
            );
            // the x under the mouse in the graph of the editor : a ring (each place)
            (crv_hovX[E] >= 0) ? (
                g = crv_Us(ty, crv_hovX[E]);
                j = 0;
                loop(g,
                    ms_PathTg(v, crv_up[j]);
                    px = ms_gx[v] + ms_kpu * ms_gw[v]; py = ms_gy[v] + ms_kpv * ms_gh[v];
                    ((px - 9 * rs >= ms_vx) && (py - 9 * rs >= ms_vy) && (px + 9 * rs < ms_vx + ms_vrw) && (py + 9 * rs < ms_vy + ms_vrh)) ? (
                        gfx_set(cr, cr, cr, 0.95);
                        gfx_circle(px, py, 7 * rs, 0, 1); gfx_circle(px, py, 7 * rs - 1, 0, 1);
                        (rs > 1) ? gfx_circle(px, py, 7 * rs - 2, 0, 1);
                    );
                    j += 1;
                );
            );
        );
    );
);

// (2026-11-23) The path of the view v (entry e) centred on the surface (fit 1 : scaled first to fill 90 % of it)
function ms_PlFit(v, e, fit) local(o, i, u0, u1, v0, v1, k)
(
    k = 0;
    loop(fit ? 2 : 1,
        ms_PathLoad(v, e);
        (ms_pn[v] > 0) ? (
            o = v * MS_PMAX; u0 = v0 = 10^9; u1 = v1 = -(10^9);
            i = 0;
            loop(ms_pn[v],
                u0 = min(u0, ms_pu[o + i]); u1 = max(u1, ms_pu[o + i]); v0 = min(v0, ms_pv[o + i]); v1 = max(v1, ms_pv[o + i]);
                i += 1;
            );
            (fit && (k === 0)) ? (
                ms_SSet(e, ms_sTk, max(0.1, min(10, ((ms_S(e, ms_sTk) > 0) ? ms_S(e, ms_sTk) : 1) * 0.9 / max(0.001, max(u1 - u0, v1 - v0)))));
            ) : (
                ms_SSet(e, ms_sTx, max(-1, min(1, ms_S(e, ms_sTx) - ((u0 + u1) / 2 - 0.5))));
                ms_SSet(e, ms_sTy, max(-1, min(1, ms_S(e, ms_sTy) + ((v0 + v1) / 2 - 0.5))));
            );
        );
        k += 1;
    );
);

// The configuration of the entry e under the mouse (mx, my : screen pixels) in the view v : its index, or -1
function ms_Pick(v, e, mx, my) local(b, i, p, d, dm, k, rs)
(
    b = ms_E(e); rs = uix_drawconfig_current[9];
    k = -1; dm = sqr(9 * rs);
    i = 0;
    loop(b[ms_eN],
        p = ms_C(e, i);
        d = sqr(mx - (ms_gx[v] + p[1] * ms_gw[v])) + sqr(my - (ms_gy[v] + p[2] * ms_gh[v]));
        (d <= dm) ? (dm = d; k = i;);
        i += 1;
    );
    k;
);

// The drawing of the view v (x, y, w, h : screen pixels) : its image, drawn again when needed, then the configurations
function ms_Draw(v, x, y, w, h) local(vw, e, b, n, k, i, p, px, py, rs, sz, lt, cs, c, tw, th, sel, hov)
(
    vw = ms_vw + v * MS_VS; e = vw[ms_vE]; b = ms_E(e); n = b[ms_eN];
    w = max(16, w|0); h = max(16, h|0);
    ms_vx = x; ms_vy = y; ms_vrw = w; ms_vrh = h; // (the rectangle of the view : the brush drawn inside it, ms_Line)
    uix_jbg_color(); ms_bgr = uix_jbg_r; ms_bgg = uix_jbg_g; ms_bgb = uix_jbg_b; // (the background of the theme, its shade)
    rs = uix_drawconfig_current[9];
    ms_csf = floor(6 * max(1, rs)); // (the cells of the gradients ; coarser while a configuration is dragged)
    cs = ms_drag ? 2 * ms_csf : ms_csf;
    k = ms_ik + v * MS_IKS;
    ((k[0] !== e) || (k[1] !== ms_seq[e]) || (k[2] !== w) || (k[3] !== h) || (k[4] !== ms_bgr + 2 * ms_bgg + 4 * ms_bgb) ||
        (k[5] !== cs) || (k[6] !== ms_gw[v] + 10000 * ms_S(e, ms_sSurf)) || (k[7] !== ms_gb[v])) ? (
        k[0] = e; k[1] = ms_seq[e]; k[2] = w; k[3] = h; k[4] = ms_bgr + 2 * ms_bgg + 4 * ms_bgb; k[5] = cs;
        k[6] = ms_gw[v] + 10000 * ms_S(e, ms_sSurf); k[7] = ms_gb[v];
        ms_Render(v, e, w, h, cs);
    );
    gfx_x = x; gfx_y = y;
    gfx_a = 1; gfx_mode = 2; // (the alpha of the image ignored)
    gfx_blit(MS_IMG + v, 1, 0);
    gfx_mode = 0;
    // the configurations : a square in their color, their number (and name, and weight if not 1)
    sz = max(3, floor(4.5 * rs));
    lt = (0.299 * ms_bgr + 0.587 * ms_bgg + 0.114 * ms_bgb) > 0.5;
    ms_hlt = lt;
    sel = vw[ms_vSel]; hov = ms_hov[v];
    i = 0;
    loop(n,
        p = ms_C(e, i); c = p[0];
        px = floor(ms_gx[v] + p[1] * ms_gw[v]); py = floor(ms_gy[v] + p[2] * ms_gh[v]);
        ms_Colors(c, lt);
        ((i === sel) || (i === hov)) ? (
            gfx_set(lt ? 0 : 1, lt ? 0 : 1, lt ? 0 : 1, (i === sel) ? 0.9 : 0.5);
            gfx_rect(px - sz - 2 * rs, py - sz - 2 * rs, 2 * sz + 4 * rs + 1, 2 * sz + 4 * rs + 1, 0);
        );
        gfx_set(ms_kr, ms_kg, ms_kb, 1);
        gfx_rect(px - sz, py - sz, 2 * sz + 1, 2 * sz + 1);
        gfx_set(lt ? 0.15 : 0.9, lt ? 0.15 : 0.9, lt ? 0.15 : 0.9, 0.9);
        gfx_rect(px - sz, py - sz, 2 * sz + 1, 2 * sz + 1, 0);
        sprintf(#ms_lbl, "%d", c);
        (strlen(cf_Name(c, #ms_t2)) > 0) ? (strcat(#ms_lbl, " "); strcat(#ms_lbl, #ms_t2););
        (abs(p[3] - 1) > 0.001) ? (sprintf(#ms_t2, " x%.2f", p[3]); strcat(#ms_lbl, #ms_t2););
        // (Play) its share under the brush
        (ms_Shown(v) && (ms_sh[v * MS_MAXC + i] >= 0.005)) ? (
            sprintf(#ms_t2, "  %d %%", floor(100 * ms_sh[v * MS_MAXC + i] + 0.5)); strcat(#ms_lbl, #ms_t2);
        );
        (conflist[c] <= 0) ? strcat(#ms_lbl, " (undefined)");
        gfx_measurestr(#ms_lbl, tw, th);
        gfx_x = min(px + sz + 4 * rs, x + w - tw - 2); gfx_y = py - th / 2;
        gfx_drawstr(#ms_lbl);
        i += 1;
    );
    // (step 5) the path of the brush (the brush on the path ; 2026-11-23 : in Edit too, where it is placed)
    ms_S(e, ms_sPath) ? (
        ms_PathLoad(v, e);
        (ms_pn[v] > 1) ? (
            ms_PathDraw(v, e, lt);
            ms_CrvMarks(v, lt); // (2026-11-24, the user : the curve edited, its points on the path)
        );
    );
    // (2026-11-24, the user) a recording : its trace as it goes
    (ms_rec[v] && (ms_rn[v] > 1)) ? ms_RecDraw(v, lt);
    // (Play) the brush
    ms_Shown(v) ? ms_DrawBrush(v, e);
    // an empty surface : what to do
    (n === 0) ? (
        strcpy(#ms_lbl, (vw[ms_vMode] === 0) ? "Right clic : add a configuration here" : "Edit : place configurations here");
        gfx_set(lt ? 0.2 : 0.85, lt ? 0.2 : 0.85, lt ? 0.2 : 0.85, 0.85);
        gfx_measurestr(#ms_lbl, tw, th);
        gfx_x = floor(ms_gx[v] + (ms_gw[v] - tw) / 2); gfx_y = floor(ms_gy[v] + (ms_gh[v] - th) / 2);
        gfx_drawstr(#ms_lbl);
    );
);

// The menu of the configurations defined (those with a name first, as the module Conf Editor ; then all of them, by
// hundreds in sub-menus when there are more than 40), the configuration cur checked, after the title ttl (an item "#...") :
// the configuration chosen, or 0
function ms_ConfMenu(ttl, cur) local(n, k, b, e, c, m, sub, i, nn, nl, j, v, w)
(
    strcpy(#ms_mnu, ttl);
    i = 2;
    n = 0; k = 1; loop(conflsize - 2, (conflist[k] > 0) ? n += 1; k += 1;);
    sub = (n > 40);
    nn = 0; k = 1;
    loop(CE_COPY, ((conflist[k] > 0) && ((w = cf_W(k)) > 0) && (w[2] > 0)) ? (ce_srt[nn] = k; nn += 1;); k += 1;);
    j = 1;
    loop(nn - 1,
        v = ce_srt[j]; k = j;
        while ((k > 0) && (ce_NmCmp(cf_wts[ce_srt[k - 1]], cf_wts[v]) > 0)) (ce_srt[k] = ce_srt[k - 1]; k -= 1;);
        ce_srt[k] = v;
        j += 1;
    );
    nl = min(nn, 100);
    (nl > 0) ? (
        sprintf(#ms_it, "|>Named (%d)", nn); strcat(#ms_mnu, #ms_it);
        j = 0;
        loop(nl,
            k = ce_srt[j];
            cf_Name(k, #ms_t2);
            c = str_getchar(#ms_t2, 0, 'cu');
            sprintf(#ms_it, "|%s%s%s%s  (%d)", (j === nl - 1) ? "<" : "", (k === cur) ? "!" : "",
                ((c === '#') || (c === '!') || (c === '<') || (c === '>')) ? " " : "", #ms_t2, k);
            strcat(#ms_mnu, #ms_it); ms_map[i] = k; i += 1;
            j += 1;
        );
    );
    (n === 0) ? (
        strcat(#ms_mnu, "|#No configuration defined"); ms_map[i] = 0; i += 1;
    ) : (
        b = 0;
        while ((b < conflsize - 1) && (strlen(#ms_mnu) < 11000)) (
            e = min(conflsize - 2, b + 99);
            c = 0; k = max(1, b); loop(e - max(1, b) + 1, (conflist[k] > 0) ? c += 1; k += 1;);
            (c > 0) ? (
                sub ? (sprintf(#ms_it, "|>%d ... %d", max(1, b), e); strcat(#ms_mnu, #ms_it););
                k = max(1, b); m = 0;
                loop(e - max(1, b) + 1,
                    (conflist[k] > 0) ? (
                        m += 1;
                        sprintf(#ms_it, "|%s%s%d%s%s", (sub && (m === c)) ? "<" : "", (k === cur) ? "!" : "", k,
                            (strlen(cf_Name(k, #ms_t2)) > 0) ? "  " : "", #ms_t2);
                        strcat(#ms_mnu, #ms_it); ms_map[i] = k; i += 1;
                    );
                    k += 1;
                );
            );
            b += 100;
        );
    );
    gfx_x = mouse_x; gfx_y = mouse_y;
    m = gfx_showmenu(#ms_mnu);
    prv_MenuEnd(m > 0);
    ((m >= 2) && (m < i)) ? ms_map[m] : 0;
);

// The menu of the library (the entry cur checked) after the title ttl : the entry chosen, or -1
function ms_LibMenu(ttl, cur) local(e, m)
(
    strcpy(#ms_mnu, ttl);
    e = 0;
    loop(MS_NLIB,
        ms_Label(e, #ms_t2);
        sprintf(#ms_it, "|%s%s%s", (e === cur) ? "!" : "", #ms_t2, (ms_N(e) > 0) ? "" : "  (empty)");
        strcat(#ms_mnu, #ms_it);
        e += 1;
    );
    gfx_x = mouse_x; gfx_y = mouse_y;
    m = gfx_showmenu(#ms_mnu);
    prv_MenuEnd(m > 0);
    (m >= 2) ? m - 2 : -1;
);

// The menu of the configuration i of the view v (right clic on it)
function ms_CfMenu(v, e, i) local(p, m, c, w)
(
    p = ms_C(e, i); w = p[3];
    cf_Name(p[0], #ms_t2);
    sprintf(#ms_mnu, "#Configuration %d  %s|Another configuration...|>Weight (the extent of its zone)", p[0], #ms_t2);
    sprintf(#ms_it, "|%s0.25|%s0.5|%s0.75|%s1|%s1.5|%s2|%s3|<%s4||Remove", (w === 0.25) ? "!" : "", (w === 0.5) ? "!" : "",
        (w === 0.75) ? "!" : "", (w === 1) ? "!" : "", (w === 1.5) ? "!" : "", (w === 2) ? "!" : "", (w === 3) ? "!" : "",
        (w === 4) ? "!" : "");
    strcat(#ms_mnu, #ms_it);
    gfx_x = mouse_x; gfx_y = mouse_y;
    m = gfx_showmenu(#ms_mnu);
    prv_MenuEnd(m > 0);
    (m === 2) ? (
        ((c = ms_ConfMenu("#Another configuration here", p[0])) > 0) ? (p[0] = c; ms_seq[e] += 1;);
    ) :
    ((m >= 3) && (m <= 10)) ? (
        p[3] = (m === 3) ? 0.25 : (m === 4) ? 0.5 : (m === 5) ? 0.75 : (m === 6) ? 1 : (m === 7) ? 1.5 : (m === 8) ? 2 :
            (m === 9) ? 3 : 4;
        ms_seq[e] += 1;
    ) :
    (m === 11) ? (
        ms_Del(e, i); ms_VSet(v, ms_vSel, -1);
    );
);

// ====== Step 3 : the sound

/*
    A view in Play drives the projector of its MetaSurface (ms_ownp[v] ; ms_own[p] : the view + 1) from its first start
    (a clic) until it leaves Play or chooses another projector (released : ms_relq[p], @block loads its configuration
    again) ; meanwhile the projector is in the manual mode, active, and silent when the MetaSurface does not sound. Its
    configurations (outdiff x configuration x indiff, as confload, with the work areas of this file) give a list of the
    coefficients used by any of them (ms_Build : K entries, each one its index in the matrix and the N gains ; a block of
    the dynamic memory, retired by cf_Retire), built again when the configurations, their blocks, the projector or its
    diffusions change. Each run of @gfx (ms_Frame, even when the window is closed) : the envelope (Off, Fade-in, On,
    Fade-out : ms_st ; ms_env 0 ... 1, the spread and the volume), the shares, then the publication for @block when they
    or the amplitude changed (ms_Publish : the shares in a double buffer, the amplitude A = envelope x volume x
    sqrt(coverage), the time of the interpolation, a sequence number written last). @block (ms_BlockHook, in the loop of the
    projectors, Espaces) : the matrix of the projector (prx_pcons) = A sqrt(sum w_i g_i^2) for each entry of the list,
    then its interpolation (buildiff) in that time ; the loads of a configuration ignored ; released : its configuration
    loaded again.
*/
MS_NPRJ = projucnt;
ms_st = make_array(MS_NV); ms_env = make_array(MS_NV); ms_et0 = make_array(MS_NV); ms_e0 = make_array(MS_NV);
ms_imm = make_array(MS_NV); ms_turn = make_array(MS_NV);
ms_ownp = make_array(MS_NV);
ms_own = make_array(MS_NPRJ + 1); ms_relq = make_array(MS_NPRJ + 1);
// the publication (@gfx -> @block) : the list, its generation, the amplitude, the time, the sequence ; the shares (2 buffers)
// (2026-11-23 : EEL2 ignores the case of the names : ms_pG was ms_pg, a color of ms_Colors, now ms_pGn ; the same day
// ms_pl -> ms_pd (it was ms_pL), MS_WT -> MS_WTN (it was ms_wt), ms_R -> ms_BR (it was ms_r))
ms_pL = make_array(MS_NV); ms_pGn = make_array(MS_NV); ms_pA = make_array(MS_NV); ms_pT = make_array(MS_NV);
ms_pSeq = make_array(MS_NV); ms_pW = make_array(MS_NV * 2 * MS_MAXC);
ms_bSeq = make_array(MS_NV); ms_bG = make_array(MS_NV); // (@block : the last sequence, the last generation merged)
// the last values published (their changes), the key of the list built (entry, count, projector, blocks)
ms_lA = make_array(MS_NV); ms_lW = make_array(MS_NV * MS_MAXC); ms_lX = make_array(MS_NV); ms_lY = make_array(MS_NV);
ms_lk = make_array(MS_NV * 4);
i__k = 0; loop(MS_NV, ms_lk[4 * i__k] = -1; i__k += 1;);
// the work areas of ms_Build (a matrix composed, the diffusion of the inputs transposed, the entries of the list)
MS_KMAX = 4096;
ms_dense = make_array(matrsiz); ms_inT = make_array(matrsiz); ms_kmap = make_array(matrsiz); ms_klist = make_array(matrsiz);
// (Step 4) The simulation for the views "Space A" ... "D" (Espaces-Space3D, sx_Show) : the projector p shown by a view
// Space, the target of a MetaSurface whose brush is shown and which does not sound (Edit with Brush shown ; Play, not
// started, or stopped) : ms_simV[p] the view + 1 (0 : none ; the first view of the projector), the coefficients of its list
// (ms_simK + v * MS_KMAX : their indices in the matrix) and the energies the brush would give them (ms_simE : sum w_i g_i^2),
// ms_simN[v] of them ; the view Space shows them instead of the matrix of the projector (crosses and halos), "simulated"
ms_simV = make_array(MS_NPRJ + 1);
ms_simK = make_array(MS_NV * MS_KMAX); ms_simE = make_array(MS_NV * MS_KMAX); ms_simN = make_array(MS_NV);
// (Step 5) The trajectories : the path of each view (its points in the surface, u, v, and their distances from the start
// along it ; ms_pn of them, ms_ptot its length ; built again when its source, the library or the editors (sp_libSeq), the
// aspect or the entry change), the motion (ms_mv 1 : the brush follows the path ; ms_msim : simulated, no sound ; ms_mpr :
// the place on the path 0 ... 1), the recording (ms_rec 1 : the place of the brush
// every 50 ms into ms_rb, ms_rn points ; at its end, a trajectory of the library) ; the backdrop of the editors Edit A ...
// D (ms_edE[k] : the entry + 1 whose path is the editor k ; its zones in the image MS_IMGE + k, ms_edW x ms_edH nodes,
// flipped as the editor asks, ms_edFl ; its aspect ms_edA ; its configurations ms_edU, ms_edV, ms_edN of them)
MS_PMAX = SP_MAXTRJ + 2;
ms_pu = make_array(MS_NV * MS_PMAX); ms_pv = make_array(MS_NV * MS_PMAX); ms_pd = make_array(MS_NV * MS_PMAX);
ms_pn = make_array(MS_NV); ms_ptot = make_array(MS_NV);
// (2026-11-24) the key of each path (ms_PathKey : MS_PKN values each ; the first -1 : built at the first use), the weights
// now (ms_wq), the placements of A ... D in the frame of the editors (ms_tpb) ; the glide of each view (ms_glOn running,
// from ms_glT0 during ms_glDur, from the weights ms_glW0) ; the trajectory placed (ms_plc : -1 the whole path, 0 ... 3 A ...
// D), its path alone (ms_qu, ms_qv, ms_qd, ms_qn points) and its pivot (ms_pvu, ms_pvv)
MS_PKN = 40;
ms_pkv = make_array(MS_NV * MS_PKN); ms_pkq = make_array(MS_PKN);
i__k = 0; loop(MS_NV, ms_pkv[i__k * MS_PKN] = -1; i__k += 1;);
ms_wq = make_array(4); ms_tpb = make_array(4 * SP_TPW);
ms_glOn = make_array(MS_NV); ms_glT0 = make_array(MS_NV); ms_glDur = make_array(MS_NV); ms_glW0 = make_array(4 * MS_NV);
ms_plc = make_array(MS_NV);
i__k = 0; loop(MS_NV, ms_plc[i__k] = -1; i__k += 1;);
ms_qu = make_array(MS_NV * MS_PMAX); ms_qv = make_array(MS_NV * MS_PMAX); ms_qd = make_array(MS_NV * MS_PMAX);
ms_qn = make_array(MS_NV); ms_pvu = make_array(MS_NV); ms_pvv = make_array(MS_NV);
ms_plen = 0;
ms_mv = make_array(MS_NV); ms_msim = make_array(MS_NV); ms_mpr = make_array(MS_NV);
// (2026-11-23, the motion integrated : ms_mx the progress in durations, ms_mlt the time of the last step, ms_mlp the mode seen
// at the last step, -1 : none ; ms_mdr the direction, 1 or -1 ; the start time ms_mt0 and the time elapsed ms_mel are gone)
ms_mx = make_array(MS_NV); ms_mlt = make_array(MS_NV); ms_mlp = make_array(MS_NV); ms_mdr = make_array(MS_NV);
// (2026-11-23, the user) the placement of the path in the key of each path (ms_PathLoad) ; the pause (ms_pz 1, since ms_pzt :
// the motion and the rotation stopped, ms_PauseSet) ; Play / Edit as a bypass (ms_Bypass : the state kept when the view
// left Play, ms_bpS sounding, ms_bpM moving, ms_bpI simulated, ms_bpE the progress of the motion ; ms_lm the mode of the view
// at the previous run of @gfx, -1 : none yet)
ms_pz = make_array(MS_NV); ms_pzt = make_array(MS_NV);
ms_bpS = make_array(MS_NV); ms_bpM = make_array(MS_NV); ms_bpI = make_array(MS_NV); ms_bpE = make_array(MS_NV);
ms_lm = make_array(MS_NV);
i__k = 0; loop(MS_NV, ms_lm[i__k] = -1; i__k += 1;);
MS_RDT = 0.05;
ms_rec = make_array(MS_NV); ms_rn = make_array(MS_NV); ms_rt0 = make_array(MS_NV); ms_rlt = make_array(MS_NV);
ms_rb = make_array(MS_NV * SP_MAXTRJ * 2);
// (2026-11-24, the user) the marks of the curve edited on the path (ms_CrvMarks) : the density of the curve integrated
// (MS_CGK steps), the ticks of the points the resampling would place (MS_CTK parts)
MS_CGK = 256; MS_CTK = 48;
ms_cgd = make_array(MS_CGK + 1);
// (2026-11-24, step 3) the modulators : the place of the brush on the path (the part of its length), the phases of the
// modulators of each view (3 each : their cycles in seconds), the time of their last step
ms_marc = make_array(MS_NV); ms_mph = make_array(3 * MS_NV); ms_mpt = make_array(MS_NV);
MS_IMGE = 76;               // MS_IMGE ... MS_IMGE + 3 : the backdrops of Edit A ... D
i__k = 0; loop(4, ui_reserve_image(MS_IMGE + i__k); i__k += 1;);
ms_edT = make_array(4); // (2026-11-24 : the trajectory A ... D that is the editor)
ms_edE = make_array(4); ms_edA = make_array(4); ms_edW = make_array(4); ms_edH = make_array(4); ms_edFl = make_array(4);
ms_edN = make_array(4); ms_edU = make_array(4 * MS_MAXC); ms_edV = make_array(4 * MS_MAXC);
// (the key of each backdrop drawn : entry, seq, flips, aspect, the placement of the path, the background ; 2026-11-23 :
// the box of the backdrop in the frame of the editor, ms_edX0 ... ms_edY1 : the surface placed under the path)
MS_EKS = 16;
ms_edK = make_array(4 * MS_EKS);
ms_edX0 = make_array(4); ms_edY0 = make_array(4); ms_edX1 = make_array(4); ms_edY1 = make_array(4);
// (2026-11-23) the placement of the path in the frame of the editors, W(p) = k R p + t (ms_eFk, ms_eFc = cos, ms_eFs = sin,
// ms_eFx, ms_eFy) : for the camera of an editor that follows its MetaSurface (Espaces-Edit, ed_CamBuild)
ms_eFk = make_array(4); ms_eFx = make_array(4); ms_eFy = make_array(4);
// (2026-11-24 : the flips) its matrix Q (orthogonal : a rotation, or a reflection), W(p) = k Q p + t, Q = [a b ; c d]
ms_eQa = make_array(4); ms_eQb = make_array(4); ms_eQc = make_array(4); ms_eQd = make_array(4);

// The diffusion of the inputs ind (its block) transposed into ms_inT (as confload : the gain from the input p to the channel l)
function ms_InT(ind) local(k, p, tg)
(
    memset(ms_inT, 0, matrsiz);
    k = ind + 1;
    while ((p = k[0] - 1) >= 0) (
        k += 1;
        while ((tg = k[0]) > 0) ( ms_inT[(tg - 1) * chmax + p] += k[1]; k += 2; );
        k += 1;
    );
);
// The block of gains chcnf (0 : none) composed with the diffusions ind (ms_inT ready), oud into ms_dense (as confload)
function ms_Compose(chcnf, ind, oud) local(pcf, src, dstx, tg, g, k, p, a, ql)
(
    memset(ms_dense, 0, matrsiz);
    (chcnf > 0) ? (
        pcf = chcnf + 1;
        ((ind === 0) && (oud === 0)) ? (
            while ((src = pcf[0] - 1) >= 0) (
                dstx = ms_dense + src * chmax; pcf += 1;
                while ((tg = pcf[0]) > 0) ( dstx[tg - 1] = pcf[1]; pcf += 2; );
                pcf += 1;
            );
        ) : (
            while ((src = pcf[0] - 1) >= 0) (
                pcf += 1;
                while ((tg = pcf[0]) > 0) (
                    g = pcf[1];
                    ql = (oud > 0) ? cf_Src(oud, tg) : 0;
                    p = 0;
                    loop((ind > 0) ? chinmax : 1,
                        a = (ind > 0) ? ms_inT[src * chmax + p] : 1;
                        (a != 0) ? (
                            dstx = ms_dense + ((ind > 0) ? p : src) * chmax;
                            (oud > 0) ? (
                                k = ql;
                                while ((k > 0) && (k[0] > 0)) ( dstx[k[0] - 1] += a * g * k[1]; k += 2; );
                            ) : (
                                dstx[tg - 1] += a * g;
                            );
                        );
                        p += 1;
                    );
                    pcf += 2;
                );
                pcf += 1;
            );
        );
    );
);
// The block of gains of the configuration c (0 : not defined)
function ms_CfBlk(c) ( ((c > 0) && (c < conflsize) && (conflist[c] > 0)) ? conflist[c] : 0; );
// The key of the list of the entry e for the projector p (its configurations, their blocks, the diffusions of p)
function ms_Key(e, p) local(n, i, c, h)
(
    n = ms_N(e); h = 0; i = 0;
    loop(n, c = ms_Cv(e, i, 0); h += (i + 1) * (c * 7919 + ms_CfBlk(c)); i += 1;);
    h + 7 * cf_Blk(serialBlock[Pr7_PrjInD + p - 1]) + 13 * cf_Blk(serialBlock[Pr7_PrjOutD + p - 1]);
);
// The list of the coefficients of the configurations of the entry e for the projector p : a block [K, N, then K x (index,
// N gains)] (0 : no memory)
function ms_Build(v, e, p) local(n, i, ind, oud, nk, L, j, k, ok)
(
    n = ms_N(e);
    ind = cf_Blk(serialBlock[Pr7_PrjInD + p - 1]); oud = cf_Blk(serialBlock[Pr7_PrjOutD + p - 1]);
    (ind > 0) ? ms_InT(ind);
    memset(ms_kmap, 0, matrsiz); nk = 0; ok = 1;
    i = 0;
    loop(n,
        ms_Compose(ms_CfBlk(ms_Cv(e, i, 0)), ind, oud);
        k = 0;
        loop(matrsiz,
            ((ms_dense[k] != 0) && (ms_kmap[k] === 0)) ? (
                (nk < MS_KMAX) ? (ms_klist[nk] = k; nk += 1; ms_kmap[k] = nk;) : (ok = 0);
            );
            k += 1;
        );
        i += 1;
    );
    L = mSL_Dyn_Alloc(2 + max(1, nk) * (1 + n), 'msl1', 0);
    (L > 0) ? (
        L[0] = nk; L[1] = n;
        j = 0; loop(nk, L[2 + j * (1 + n)] = ms_klist[j]; j += 1;);
        i = 0;
        loop(n,
            ms_Compose(ms_CfBlk(ms_Cv(e, i, 0)), ind, oud);
            j = 0; loop(nk, L[2 + j * (1 + n) + 1 + i] = ms_dense[ms_klist[j]]; j += 1;);
            i += 1;
        );
        !ok ? (sprintf(#ms_msg, "MetaSurface MS%d : more than %d coefficients, the others ignored", e + 1, MS_KMAX); mSL_log(SysLogBox, #ms_msg););
    ) : (
        sprintf(#ms_msg, "MetaSurface MS%d : no memory for its coefficients", e + 1); mSL_log(SysLogBox, #ms_msg);
    );
    L;
);

// The view v takes the projector p (refused if another view drives it) : its manual mode, active ; returns 1
function ms_Take(v, p) local(o, pro)
(
    o = ms_own[p] - 1;
    ((o >= 0) && (o !== v)) ? (
        sprintf(#ms_msg, "MetaSurface : the projector %d is driven by the view MetaSurface %c", p, 'A' + o); mSL_log(SysLogBox, #ms_msg);
        0;
    ) : (
        ms_own[p] = v + 1; ms_ownp[v] = p; ms_relq[p] = 0;
        pro = projectors + (p - 1) * projsize;
        (pro[prx_flgopmod] & (rndmodon | hypmodon)) ? updtopmod(pro, 1, 0); // (manual : no random, no Hyper Slider)
        (pro[prx_savprjst] === prx__statoff) ? updpstatus(pro, prx__statactive, 0);
        1;
    );
);
// The view v releases its projector (@block loads its configuration again) ; its sound stopped
function ms_Release(v) local(p)
(
    p = ms_ownp[v];
    (p > 0) ? (
        ms_own[p] = 0; ms_relq[p] = 1; ms_ownp[v] = 0;
        (ms_pL[v] > 0) ? (cf_Retire(ms_pL[v]); ms_pL[v] = 0;);
        ms_lk[4 * v] = -1;
    );
    ms_st[v] = 0; ms_env[v] = 0;
);
// Start (fade 1 : with a fade-in ; 0 : at once) and stop (fade 1 : with a fade-out ; 0 : at once) the view v
function ms_Start(v, e, fade) local(p)
(
    p = ms_S(e, ms_sProj);
    ((ms_N(e) > 0) && (p >= 1) && (p <= MS_NPRJ)) ? (
        ms_Take(v, p) ? (
            fade ? (ms_st[v] = 1; ms_e0[v] = ms_env[v]; ms_et0[v] = time_precise();) : (ms_st[v] = 2; ms_env[v] = 1; ms_imm[v] = 1;);
            ms_PauseSet(v, 0); // (2026-11-23 : a start ends the pause)
            ms_S(e, ms_sPath) ? ms_MoveStart(v); // (step 5 : the brush on the path, from its start unless it already moves)
        );
    ) : (
        sprintf(#ms_msg, "MetaSurface MS%d : no configuration, or no projector", e + 1); mSL_log(SysLogBox, #ms_msg);
    );
);
function ms_Stop(v, fade)
(
    fade ? (ms_st[v] = 3; ms_e0[v] = ms_env[v]; ms_et0[v] = time_precise();) : (ms_st[v] = 0; ms_env[v] = 0; ms_imm[v] = 1;);
);
// A clic that starts or stops (left : with a fade ; right : at once)
function ms_Toggle(v, e, fade) ( ((ms_st[v] === 0) || (ms_st[v] === 3)) ? ms_Start(v, e, fade) : ms_Stop(v, fade); );
// (2026-11-23, the user) Play / Edit as a bypass : leaving Play (play 0), the state of the view v kept (sounding or not, the
// motion along the path and its time) ; back in Play (play 1), it goes on at once from there (the pause kept)
function ms_Bypass(v, e, play) local(t, p)
(
    t = time_precise();
    play ? (
        ms_bpM[v] ? (ms_mv[v] = 1; ms_msim[v] = ms_bpI[v]; ms_mx[v] = ms_bpE[v]; ms_mlt[v] = t;);
        ms_bpS[v] ? (
            p = ms_S(e, ms_sProj);
            ((ms_N(e) > 0) && (p >= 1) && (p <= MS_NPRJ)) ? (
                ms_Take(v, p) ? (ms_st[v] = 2; ms_env[v] = 1; ms_imm[v] = 1;);
            );
        );
        ms_bpS[v] = ms_bpM[v] = ms_bpI[v] = 0;
    ) : (
        ms_bpS[v] = (ms_st[v] === 1) || (ms_st[v] === 2);
        ms_bpM[v] = ms_mv[v]; ms_bpI[v] = ms_msim[v];
        ms_bpE[v] = ms_mx[v];
    );
);
// The envelope of the view v at the time t (Attack, Release : seconds ; linear)
function ms_Env(v, e, t)
(
    (ms_st[v] === 1) ? (
        ms_env[v] = min(1, ms_e0[v] + (t - ms_et0[v]) / max(0.01, ms_S(e, ms_sAtt)));
        (ms_env[v] >= 1) ? ms_st[v] = 2;
    ) : (ms_st[v] === 3) ? (
        ms_env[v] = max(0, ms_e0[v] - (t - ms_et0[v]) / max(0.01, ms_S(e, ms_sRel)));
        (ms_env[v] <= 0) ? ms_st[v] = 0;
    ) : (ms_st[v] === 2) ? (ms_env[v] = 1) : (ms_env[v] = 0);
);
// The publication of the view v (projector p) for @block : the list built again if needed ; the shares, the amplitude,
// the time of the interpolation, when they changed (immediate : 5 ms ; fixed : Latency ; per distance : Latency for each
// tenth of the diagonal moved ; 40 ms at least, the steps of @gfx smoothed)
// The list of the view v (entry e, projector p) built again if needed (see ms_Key) ; returns 1 if it was
function ms_List(v, e, p) local(k, n, L)
(
    k = ms_lk + 4 * v; n = ms_N(e);
    ((k[0] !== e) || (k[1] !== n) || (k[2] !== p) || (k[3] !== ms_Key(e, p))) ? (
        L = ms_Build(v, e, p);
        (ms_pL[v] > 0) ? cf_Retire(ms_pL[v]);
        ms_pL[v] = L; ms_pGn[v] += 1;
        k[0] = e; k[1] = n; k[2] = p; k[3] = ms_Key(e, p);
        1;
    ) : 0;
);
function ms_Publish(v, e, p) local(k, n, L, amp, T, d, ch, sh, buf, i, a, lat)
(
    n = ms_N(e);
    ch = ms_List(v, e, p);
    sh = ms_sh + v * MS_MAXC;
    amp = (ms_st[v] === 0) ? 0 : ms_env[v] * 10 ^ (ms_S(e, ms_sVol) / 20) * sqrt(max(0, ms_cov[v]));
    (abs(amp - ms_lA[v]) > 0.0001) ? ch = 1;
    i = 0; loop(n, (abs(sh[i] - ms_lW[v * MS_MAXC + i]) > 0.0001) ? ch = 1; i += 1;);
    ms_imm[v] ? ch = 1;
    ch ? (
        lat = max(0.005, ms_S(e, ms_sLat) / 1000);
        a = max(0.5, min(4, ms_S(e, ms_sAspect)));
        d = sqrt(sqr((ms_bx[v] - ms_lX[v]) * a) + sqr(ms_by[v] - ms_lY[v])) / (0.1 * sqrt(a * a + 1));
        T = ms_imm[v] ? 0.005 : max(0.04, ms_S(e, ms_sLatMode) ? lat * d : lat);
        ms_imm[v] = 0;
        buf = ms_pW + (v * 2 + ((ms_pSeq[v] + 1) & 1)) * MS_MAXC;
        i = 0; loop(n, buf[i] = sh[i]; ms_lW[v * MS_MAXC + i] = sh[i]; i += 1;);
        ms_pA[v] = ms_lA[v] = amp; ms_pT[v] = min(10, T);
        ms_lX[v] = ms_bx[v]; ms_lY[v] = ms_by[v];
        ms_pSeq[v] += 1; // (written last : @block reads the buffer of this sequence)
    );
);
// The motion of the view v at the time t : the progress (Once : at the end, the brush stays there, the sound fades out ;
// Loop ; Back and forth ; 2026-11-23 : Loop reverse, from the end to the start), the brush on the path ; a motion without
// sound and without simulation : stopped. 2026-11-23 (the user) : the progress ms_mx (in durations) grows with the time
// (paused : it stays ; a new duration : only the speed changes) ; a new mode while it moves : the brush stays where it is
// on the path, only its direction follows the new mode (Back and forth : the same direction)
function ms_Motion(v, e, t) local(x, s, lp, d, w, f)
(
    (ms_mv[v] && (ms_st[v] === 0) && !ms_msim[v]) ? ms_mv[v] = 0;
    ms_mv[v] ? (
        lp = ms_S(e, ms_sLoop);
        ((ms_mlp[v] >= 0) && (ms_mlp[v] !== lp)) ? (
            s = ms_SOf(ms_mlp[v], ms_mx[v]); d = ms_dir;
            ms_mx[v] = (lp === 0) ? s : (lp === 1) ? min(0.999999, s) : (lp === 3) ? min(0.999999, 1 - s) : ((d > 0) ? s : 2 - s);
        );
        ms_mlp[v] = lp;
        // (2026-11-24, step 3) the speed modulated : x (1 + depth x F) ; below 0, the brush goes back (Once : not before the
        // start)
        f = 1 + ms_ModV(v, e, 1);
        ms_mx[v] += (ms_pz[v] ? 0 : max(0, t - ms_mlt[v])) / max(0.1, ms_S(e, ms_sDur)) * f;
        (lp === 0) ? (ms_mx[v] = max(0, ms_mx[v]));
        ms_mlt[v] = t;
        x = ms_mx[v];
        s = ms_SOf(lp, x);
        ((lp === 0) && (x >= 1)) ? (ms_mv[v] = 0; ms_msim[v] = 0; ((ms_st[v] === 1) || (ms_st[v] === 2)) ? ms_Stop(v, 1););
        ms_mpr[v] = s; ms_mdr[v] = (f < 0) ? -ms_dir : ms_dir;
        ms_PathLoad(v, e);
        // (2026-11-24) the dynamics, as the views Space : the place on the path from the time by the curve and its mode
        (ms_pn[v] > 0) ? (
            w = sp_Ease(ms_S(e, ms_sCurve), ms_S(e, ms_sDMode), s);
            ms_PathAt(v, w, ms_S(e, ms_sSpeedM));
            ms_bx[v] = ms_cu; ms_by[v] = ms_cv;
            // (2026-11-24, the user) the brush in the graph of the module Curves : the part of the length of the path
            // (a magenta line, the letter of the view)
            (ms_pn[v] > 1) ? (
                ms_marc[v] = ms_ArcOf(v, w, ms_S(e, ms_sSpeedM)); // (the phase of the modulators in the cycle Path)
                crv_PhSet(4 * v, ms_marc[v], 0xD040C0, 'A' + v, "", -1);
            );
        );
    );
);
// The recording of the view v : started ; ended (the points become a trajectory of the library : the first one empty, named
// "MSn rec" ; the path of the MetaSurface, its duration that of the recording, the same time between its points)
function ms_RecStart(v) ( ms_rec[v] = 1; ms_rn[v] = 0; ms_rt0[v] = time_precise(); ms_rlt[v] = -1; );
function ms_RecEnd(v, e) local(i, k, n, q, rb)
(
    ms_rec[v] = 0; n = ms_rn[v];
    (n >= 2) ? (
        i = -1; k = 0; while ((i < 0) && (k < SP_NTRJ)) ((sp_trN[k] <= 0) ? i = k; k += 1;);
        (i >= 0) ? (
            q = sp_trP + i * SP_MAXTRJ * 3; rb = ms_rb + v * SP_MAXTRJ * 2;
            ms_TfGet(e); // (the placement of the path undone : the path placed gives the recording again)
            k = 0;
            loop(n,
                ms_TfInv(rb[2 * k], rb[2 * k + 1]); ms_U2XY(e, ms_cu, ms_cv);
                q[3 * k] = ms_cx2; q[3 * k + 1] = ms_cy2; q[3 * k + 2] = 0;
                k += 1;
            );
            sp_trN[i] = n; sp_trC[i] = 0;
            sprintf(#ms_t4, "MS%d rec", e + 1); sp_NmSet(i, #ms_t4);
            sp_libSeq += 1;
            // (2026-11-24) the trajectory A, without placement, alone (the mix on A), linear : the path plays the recording
            ms_SSet(e, ms_sTrK, SP_KLIB + i);
            k = 0; loop(3, ms_SSet(e, ms_sPl + k, 0); k += 1;); ms_SSet(e, ms_sPl + 3, 1);
            ms_SSet(e, ms_sFlip, ms_S(e, ms_sFlip) & (-1 ~ (ms_FlipBit(0, 0) | ms_FlipBit(0, 1))));
            ms_SSet(e, ms_sMix, 0); ms_glOn[v] = 0; ms_SSet(e, ms_sCurve, 0); ms_SSet(e, ms_sDMode, 0);
            ms_SSet(e, ms_sDur, max(0.1, (n - 1) * MS_RDT)); ms_SSet(e, ms_sSpeedM, 1);
            sprintf(#ms_msg, "MetaSurface MS%d : recorded, %d points, %.1f s : the trajectory T%d, in A", e + 1, n, (n - 1) * MS_RDT, i + 1);
        ) : (
            sprintf(#ms_msg, "MetaSurface MS%d : the library of trajectories is full (%d)", e + 1, SP_NTRJ);
        );
        mSL_log(SysLogBox, #ms_msg);
    );
);
// The recording at the time t : the place of the brush every MS_RDT seconds (full : ended)
function ms_RecStep(v, e, t) local(rb)
(
    (ms_rec[v] && ((ms_rlt[v] < 0) || (t - ms_rlt[v] >= MS_RDT))) ? (
        ms_rlt[v] = (ms_rlt[v] < 0) ? t : ms_rlt[v] + MS_RDT;
        rb = ms_rb + v * SP_MAXTRJ * 2;
        rb[2 * ms_rn[v]] = ms_bx[v]; rb[2 * ms_rn[v] + 1] = ms_by[v]; ms_rn[v] += 1;
        (ms_rn[v] >= SP_MAXTRJ) ? ms_RecEnd(v, e);
    );
);
// (2026-11-24) The placement of the trajectory t (0 ... 3) of the entry e, in the frame of the editors, for the path of the
// editor k (as the spatial projectors : p -> c + d + R S (p - c), c the barycentre of its points, sp_edP) : ms_slc, ms_sls
// (the rotation), ms_slk (the scale), ms_slcx, ms_slcy (the barycentre), ms_sldx, ms_sldy (the displacement) ; ms_SlId :
// none ; ms_SlFwd, ms_SlInv : a point placed, and back (ms_slx, ms_sly)
function ms_SlId() ( ms_slc = ms_slk = ms_slfx = ms_slfy = 1; ms_sls = ms_slcx = ms_slcy = ms_sldx = ms_sldy = 0; );
function ms_SlGet(e, t, k) local(a, wd, hd, p, n, i, q, r)
(
    a = max(0.5, min(4, ms_S(e, ms_sAspect)));
    wd = (a >= 1) ? 2 : 2 * a; hd = (a >= 1) ? 2 / a : 2;
    p = ms_sPl + 4 * t;
    ms_sldx = ms_S(e, p) * wd; ms_sldy = ms_S(e, p + 1) * hd;
    r = - ms_S(e, p + 2) * $pi / 180; ms_slc = cos(r); ms_sls = sin(r);
    ms_slk = (ms_S(e, p + 3) > 0) ? max(0.05, min(20, ms_S(e, p + 3))) : 1;
    ms_slfx = (ms_S(e, ms_sFlip) & ms_FlipBit(t, 0)) ? -1 : 1; ms_slfy = (ms_S(e, ms_sFlip) & ms_FlipBit(t, 1)) ? -1 : 1;
    n = sp_edN[k]; q = sp_edP + k * SP_MAXTRJ * 3;
    ms_slcx = ms_slcy = 0;
    i = 0; loop(n, ms_slcx += q[3 * i]; ms_slcy += q[3 * i + 1]; i += 1;);
    (n > 0) ? (ms_slcx /= n; ms_slcy /= n;);
);
function ms_SlFwd(x, y) local(dx, dy)
(
    dx = (x - ms_slcx) * ms_slfx; dy = (y - ms_slcy) * ms_slfy;
    ms_slx = ms_slcx + ms_sldx + ms_slk * (ms_slc * dx - ms_sls * dy);
    ms_sly = ms_slcy + ms_sldy + ms_slk * (ms_sls * dx + ms_slc * dy);
);
function ms_SlInv(x, y) local(dx, dy)
(
    dx = x - ms_slcx - ms_sldx; dy = y - ms_slcy - ms_sldy;
    ms_slx = ms_slcx + ms_slfx * (ms_slc * dx + ms_sls * dy) / ms_slk;
    ms_sly = ms_slcy + ms_slfy * (ms_slc * dy - ms_sls * dx) / ms_slk;
);
// (2026-11-23) The backdrop of an editor : the zones of the entry e under the path (the placement undone : ms_TfGet done ;
// Follow : none) into the image img, nx x ny nodes over X0 ... X1, Y0 ... Y1 of the frame of the editor (y up ; the node
// i, j at x = X0 + (X1 - X0) i / nx, y = Y1 - (Y1 - Y0) j / ny) : the background of the editors (s3d_bgr ...) everywhere,
// the zones computed on the nodes i0 ... i1, j0 ... j1 only (the box of the surface), mixed with it (55 % of the zones ; the
// edge of the surface smoothed over a node). The editor maps it onto the plane z = 0 as its camera sees it (ed_MsBack :
// gfx_transformblit, any view, zoom, move, turn)
function ms_ZonesEd(e, img, nx, ny, X0, Y0, X1, Y1, i0, i1, j0, j1) local(n, a, i, j, x, y, u, w, dk, sp, hw, d, cov, lt, er, r)
(
    n = ms_N(e); a = max(0.5, min(4, ms_S(e, ms_sAspect))); dk = ms_S(e, ms_sSurf);
    lt = (0.299 * s3d_bgr + 0.587 * s3d_bgg + 0.114 * s3d_bgb) > 0.5; er = lt ? 1 : 0;
    // a node, in the metric of the surface (the frame of the editors : 2 / a or 2 per height ; the scale of the placement)
    sp = max((X1 - X0) / nx, (Y1 - Y0) / ny) * ((a >= 1) ? a / 2 : 0.5) * ms_tfk * ms_slk; // (2026-11-24 : and its trajectory)
    ms_gmin = 3 * sp; hw = 1.2 * sp;
    gfx_setimgdim(img, nx + 1, ny + 1);
    gfx_dest = img;
    gfx_set(s3d_bgr, s3d_bgg, s3d_bgb, 1); gfx_mode = 0;
    gfx_rect(0, 0, nx + 1, ny + 1);
    j = max(0, j0);
    loop(min(ny, j1) - max(0, j0) + 1,
        i = max(0, i0);
        loop(min(nx, i1) - max(0, i0) + 1,
            x = X0 + (X1 - X0) * i / nx; y = Y1 - (Y1 - Y0) * j / ny;
            ms_SlFwd(x, y); ms_XY2U(e, ms_slx, ms_sly); ms_TfFwd(ms_cu, ms_cv); u = ms_cu; w = ms_cv;
            // the distance to the edge of the surface (inside : > 0)
            dk ? (
                r = sqrt(sqr((u - 0.5) * 2) + sqr((w - 0.5) * 2)); d = (1 - r) * min(a / 2, 0.5);
            ) : (
                d = min(min(u * a, (1 - u) * a), min(w, 1 - w));
            );
            cov = max(0, min(1, 0.5 + d / hw)) * 0.55;
            (cov > 0) ? (
                ms_NodeColor(e, n, a, u, w, lt, er, er, er);
                ms_r = s3d_bgr + cov * (ms_r - s3d_bgr); ms_g = s3d_bgg + cov * (ms_g - s3d_bgg); ms_b = s3d_bgb + cov * (ms_b - s3d_bgb);
                gfx_x = i; gfx_y = j; gfx_setpixel(ms_r, ms_g, ms_b);
            );
            i += 1;
        );
        j += 1;
    );
);
// The backdrops of the editors Edit A ... D (each run of @gfx) : for each one, the first view whose MetaSurface follows its
// path ; the placement of its path in the frame of the editors (ms_eFk ... : the camera Follow) ; its zones drawn again in
// its image when needed (entry, changes, aspect, shape, the placement of the path, the background, Follow ; only for an
// editor shown : ed_seen) ; its configurations. 2026-11-23 : the surface placed under the path (the placement undone :
// turned, moved, scaled the other way) or as it is (Follow) ; the image : the box of the surface in the frame of the editor,
// 256 nodes on its long side, and a margin as wide as the box on each side (ms_edX0 ... ms_edY1 : the whole image)
function ms_EdBack() local(k, v, vw, e, a, nx, ny, q, i, od, x0, y0, x1, y1, bk, fw, st, d, res, ex0, ey0, ex1, ey1, t, j)
(
    od = gfx_dest;
    bk = s3d_bgr + 2 * s3d_bgg + 4 * s3d_bgb;
    k = 0;
    loop(4,
        // (2026-11-24) the first view whose MetaSurface has the editor k as a trajectory of its chain (A ... D) : its entry + 1,
        // that trajectory (ms_edT)
        ms_edE[k] = 0;
        v = 0;
        loop(MS_NV,
            vw = ms_vw + v * MS_VS; e = vw[ms_vE];
            j = 0;
            loop(max(2, min(4, ms_S(e, ms_sTrN))),
                ((ms_edE[k] === 0) && (ms_S(e, ms_sTrK + j) === SP_KED + k)) ? (ms_edE[k] = e + 1; ms_edT[k] = j;);
                j += 1;
            );
            v += 1;
        );
        (ms_edE[k] > 0) ? (
            e = ms_edE[k] - 1; a = max(0.5, min(4, ms_S(e, ms_sAspect))); t = ms_edT[k];
            ms_TfGet(e); ms_SlGet(e, t, k);
            // (2026-11-23) the placement in the frame of the editors (2026-11-24 : that of the trajectory, then that of the
            // whole path) : the images of (0, 0) and (1, 0)
            ms_SlFwd(0, 0); ms_XY2U(e, ms_slx, ms_sly); ms_TfFwd(ms_cu, ms_cv); ms_U2XY(e, ms_cu, ms_cv); x0 = ms_cx2; y0 = ms_cy2;
            ms_SlFwd(1, 0); ms_XY2U(e, ms_slx, ms_sly); ms_TfFwd(ms_cu, ms_cv); ms_U2XY(e, ms_cu, ms_cv); x1 = ms_cx2; y1 = ms_cy2;
            ms_SlFwd(0, 1); ms_XY2U(e, ms_slx, ms_sly); ms_TfFwd(ms_cu, ms_cv); ms_U2XY(e, ms_cu, ms_cv);
            // (2026-11-24 : the flips make it a reflection : its matrix Q, orthogonal, W(p) = k Q p + t)
            d = max(0.000001, sqrt(sqr(x1 - x0) + sqr(y1 - y0))); ms_eFk[k] = d;
            ms_eQa[k] = (x1 - x0) / d; ms_eQc[k] = (y1 - y0) / d; ms_eQb[k] = (ms_cx2 - x0) / d; ms_eQd[k] = (ms_cy2 - y0) / d;
            ms_eFx[k] = x0; ms_eFy[k] = y0;
            // Follow (the state of the editor, ed_sFollow) : the surface as it is (the placement drawn by the camera)
            st = ed_St(k); fw = st[ed_sFollow];
            fw ? (ms_tfx = ms_tfy = ms_tfs = 0; ms_tfc = ms_tfk = ms_tffx = ms_tffy = 1; ms_SlId(););
            q = ms_edK + MS_EKS * k;
            ((ed_seen[k] >= gfx_executed - 2) &&
                ((q[0] !== e) || (q[1] !== ms_seq[e]) || (q[3] !== a + 10 * ms_S(e, ms_sSurf)) ||
                (q[4] !== ms_S(e, ms_sTx)) || (q[5] !== ms_S(e, ms_sTy)) || (q[6] !== ms_S(e, ms_sTa)) ||
                (q[7] !== ms_S(e, ms_sTk)) || (q[8] !== bk) || (q[9] !== fw) || (q[10] !== ms_slk) || (q[11] !== ms_slc) ||
                (q[12] !== ms_sls) || (q[13] !== ms_sldx + 3 * ms_sldy) || (q[14] !== ms_slcx + 3 * ms_slcy) ||
                (q[15] !== ms_S(e, ms_sFlip) + 10 * fw))) ? (
                q[0] = e; q[1] = ms_seq[e]; q[2] = 0; q[3] = a + 10 * ms_S(e, ms_sSurf);
                q[4] = ms_S(e, ms_sTx); q[5] = ms_S(e, ms_sTy); q[6] = ms_S(e, ms_sTa); q[7] = ms_S(e, ms_sTk); q[8] = bk; q[9] = fw;
                q[10] = ms_slk; q[11] = ms_slc; q[12] = ms_sls; q[13] = ms_sldx + 3 * ms_sldy; q[14] = ms_slcx + 3 * ms_slcy;
                q[15] = ms_S(e, ms_sFlip) + 10 * fw;
                // the box of the 4 corners of the surface in the frame of the editor
                x0 = y0 = 10^9; x1 = y1 = -(10^9);
                i = 0;
                loop(4,
                    ms_TfInv(i & 1, (i >> 1) & 1); ms_U2XY(e, ms_cu, ms_cv); ms_SlInv(ms_cx2, ms_cy2);
                    x0 = min(x0, ms_slx); x1 = max(x1, ms_slx); y0 = min(y0, ms_sly); y1 = max(y1, ms_sly);
                    i += 1;
                );
                d = max(0.01, max(x1 - x0, y1 - y0)); res = 256 / d; // (nodes per unit)
                ex0 = x0 - d; ey0 = y0 - d; ex1 = x1 + d; ey1 = y1 + d;
                nx = ceil((ex1 - ex0) * res); ny = ceil((ey1 - ey0) * res);
                ms_ZonesEd(e, MS_IMGE + k, nx, ny, ex0, ey0, ex1, ey1,
                    floor((x0 - ex0) * res) - 1, ceil((x1 - ex0) * res) + 1, floor((ey1 - y1) * res) - 1, ceil((ey1 - y0) * res) + 1);
                gfx_dest = od; gfx_mode = 0;
                ms_edW[k] = nx; ms_edH[k] = ny; ms_edA[k] = a;
                ms_edX0[k] = ex0; ms_edY0[k] = ey0; ms_edX1[k] = ex1; ms_edY1[k] = ey1;
                ui_GFXdoNow |= 4;
            );
            // the configurations, in the frame of the editor
            ms_edN[k] = ms_N(e);
            i = 0;
            loop(ms_edN[k],
                ms_TfInv(ms_Cv(e, i, 1), ms_Cv(e, i, 2)); ms_U2XY(e, ms_cu, ms_cv); ms_SlInv(ms_cx2, ms_cy2);
                ms_edU[k * MS_MAXC + i] = ms_slx; ms_edV[k * MS_MAXC + i] = ms_sly;
                i += 1;
            );
        );
        k += 1;
    );
);

// The simulation of the view v (step 4) : the energy that the brush would give to each coefficient of its list (the shares,
// no amplitude) ; returns 1 if there is a list
function ms_Sim(v, e) local(L, K, N, j, q, s, i, g, sh, kk, ee)
(
    L = ms_pL[v]; ms_simN[v] = 0;
    (L > 0) ? (
        K = min(MS_KMAX, L[0]); N = L[1]; sh = ms_sh + v * MS_MAXC;
        kk = ms_simK + v * MS_KMAX; ee = ms_simE + v * MS_KMAX;
        j = 0;
        loop(K,
            q = L + 2 + j * (1 + N);
            s = 0; i = 0; loop(N, g = q[1 + i]; s += sh[i] * g * g; i += 1;);
            kk[j] = q[0]; ee[j] = s;
            j += 1;
        );
        ms_simN[v] = K;
    );
    L > 0;
);
// (2026-11-24, step 3) The phases of the modulators of the view v (entry e) at the time t (the cycles in seconds ; paused :
// they stay) ; in Play, their playheads in the graph of their curve (module Curves ; the cycle Path : that of the brush)
function ms_ModStep(v, e, t) local(j, cy, dt, k, q, vw)
(
    dt = ((ms_mpt[v] > 0) && !ms_pz[v]) ? max(0, min(0.5, t - ms_mpt[v])) : 0;
    ms_mpt[v] = t;
    vw = ms_vw + v * MS_VS;
    j = 0;
    loop(3,
        cy = ms_S(e, ms_sMod + 3 * j + 1); k = ms_S(e, ms_sMod + 3 * j) - 1; q = 3 * v + j;
        (cy > 0) ? (
            ms_mph[q] += dt / max(0.05, cy); ms_mph[q] -= floor(ms_mph[q]);
            ((k >= 0) && vw[ms_vMode]) ? crv_PhSet(4 * v + 1 + j, ms_mph[q], (j === 0) ? 0xE08020 : (j === 1) ? 0x2090E0 : 0x30B040,
                'A' + v, (j === 0) ? " rot" : (j === 1) ? " speed" : " mix", k);
        );
        j += 1;
    );
);
// (2026-11-24, step 4 of the curves) The entry e staged by the settings (mst_Stage, Espaces-Set-Table) : its settings,
// its name, its configurations (the zones) ; a line in the log (and the configurations it places that are not defined)
function ms_TbTake(e) local(b, s, g, k, n, i, c, v, vw)
(
    b = ms_E(e); s = mst_ts + e * MS_ES; g = mst_tsF + e * MST_TF;
    k = 0;
    loop(MS_NS,
        g[k] ? (
            (k === ms_sFlip) ? (b[ms_eSet + k] = (b[ms_eSet + k] & (-1 ~ g[k])) | (s[ms_eSet + k] & g[k])) :
                (b[ms_eSet + k] = s[ms_eSet + k]);
        );
        k += 1;
    );
    g[ms_sAngle] ? (b[ms_eSet + ms_sAngle] = ms_Wrap360(b[ms_eSet + ms_sAngle]));
    g[ms_sRot] ? (b[ms_eSet + ms_sRotMem] = 0);
    g[MS_NS] ? memcpy(b + ms_eName, s + ms_eName, MS_NMLEN);
    g[MS_NS + 1] ? (
        n = b[ms_eN] = s[ms_eN];
        memset(b + ms_eCf, 0, 4 * MS_MAXC); memcpy(b + ms_eCf, s + ms_eCf, 4 * n);
    );
    b[ms_eUsed] = 1;
    ms_ClampAll(e);
    n = b[ms_eN];
    v = 0; loop(MS_NV, vw = ms_vw + v * MS_VS; ((vw[ms_vE] === e) && (vw[ms_vSel] >= n)) ? (vw[ms_vSel] = -1); v += 1;);
    ms_seq[e] += 1;
    ms_Label(e, #ms_xl);
    sprintf(#ms_xm, "MetaSurface %s : read from settings (%d configuration%s)", #ms_xl, n, (n > 1) ? "s" : "");
    mSL_log(SysLogBox, #ms_xm);
    strcpy(#ms_xm, ""); c = 0; i = 0;
    loop(n,
        k = ms_Cv(e, i, 0);
        (ms_CfBlk(k) <= 0) ? ( c += 1; (c <= 12) ? strcat(#ms_xm, sprintf(#ms_xv, " %d", k)); );
        i += 1;
    );
