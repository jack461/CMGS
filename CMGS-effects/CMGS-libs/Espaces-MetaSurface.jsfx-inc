                i = floor(100 * s[ms_PlI(v, 1)] + 0.5); sprintf(pad_MSV_Labs[41], (i > 0) ? "%s y +%d %%" : "%s y %d %%", #ms_t3, i);
                sprintf(pad_MSV_Labs[42], "%s turn %d deg", #ms_t3, floor(s[ms_PlI(v, 2)] + 0.5));
                sprintf(pad_MSV_Labs[43], "%s scale %.2f", #ms_t3, (s[ms_PlI(v, 3)] > 0) ? s[ms_PlI(v, 3)] : 1);
                i = ms_S(e, ms_sFlip) & (ms_FlipBit(ms_plc[v], 0) | ms_FlipBit(ms_plc[v], 1));
                strcpy(pad_MSV_Labs[44], (i === 0) ? "Placement" : (i === ms_FlipBit(ms_plc[v], 0)) ? "Placement : flip x" :
                    (i === ms_FlipBit(ms_plc[v], 1)) ? "Placement : flip y" : "Placement : flip x y");
                (ms_plc[v] < 0) ? strcpy(pad_MSV_Labs[45], "Place : path") : sprintf(pad_MSV_Labs[45], "Placing %c", 'A' + ms_plc[v]);
                i = 40; loop(6, pad_MSV_Colrs[i] = Col_P1; i += 1;);
                (ms_plc[v] >= 0) ? (pad_MSV_Colrs[45] = Color_Goldenrod);
                // line 7 (2026-11-24, step 3) : the modulators, their curve and cycle, their depth
                i = 0;
                loop(3,
                    ms_ModLbl(pad_MSV_Labs[48 + 2 * i], e, i);
                    sprintf(pad_MSV_Labs[49 + 2 * i], (s[ms_sMod + 3 * i + 2] > 0) ? "%s depth +%.2f" : "%s depth %.2f",
                        (i === 0) ? "Rot" : (i === 1) ? "Speed" : "Mix", s[ms_sMod + 3 * i + 2]);
                    pad_MSV_Colrs[48 + 2 * i] = Col_P1;
                    pad_MSV_Colrs[49 + 2 * i] = ms_ModOn(e, i) ? Col_P1 : Col_Inactive;
                    i += 1;
                );
                i = vw[ms_vSel]; // (the selection, again)
                pad_MSV_Colrs[0] = pad_MSV_Colrs[1] = pad_MSV_Colrs[3] = pad_MSV_Colrs[4] = Col_P1;
                pad_MSV_Colrs[2] = Col_InfoA;
                pad_MSV_Colrs[5] = Col_P1;
                pad_MSV_Colrs[6] = ((i >= 0) && (i < n)) ? Col_P1 : Col_Inactive;
                pad_MSV_Colrs[7] = Col_P1;
                // the roles (GUI rubric) : the MetaSurface (Navigation), the mode (Choice : Play lit), the count
                // (Information), the aspect (Choice), the band (Value), the projector (Choice ; no effect yet : dim), the
                // weight of the selection (Value ; none : dim), Actions (Action)
                // (2026-11-24) line 4 : Brush, A ... D (Choice), Mix, Glide (Value), Dyn (Choice) ; line 5 : Duration (Value), the
                // mode, Speed (Choice), Radius (Value), Simulate, Record (Choice), Restart (Action), the counter ; line 6 : x, y,
                // turn, scale (Value), Placement (Action), Place (Choice)
                // (2026-11-24) line 7 : the curve of each modulator (Choice), its depth (Value)
                ui_jpad_roles_set(pad_MSV, 0, "ncicvcvavvvvvvvcvvcvvcc.cccccvvcvccvccasvvvvac..cvcvcv..");
                d3_Pad_Modes(pad_MSV, pad_MSV_Labs, pad_MSV_Colrs, MS_PSIZ);
                ui_jpad_mark(pad_MSV, 1, vw[ms_vMode], 0);
                ui_jpad_mark(pad_MSV, 15, vw[ms_vMode] ? !ms_att[v] : vw[ms_vBrush], 0); // (Play : held lit ; Edit : shown lit)
                ui_jpad_mark(pad_MSV, 5, ms_ownp[v] > 0, 0); // (the projector driven : lit)
                ui_jpad_mark(pad_MSV, 21, ms_st[v] > 0, !vw[ms_vMode]); // (sounding : lit)
                ui_jpad_mark(pad_MSV, 22, ms_pz[v], 0); // (paused : lit)
                ui_jpad_mark(pad_MSV, 24, s[ms_sPath], 0); // (on the path : lit)
                ui_jpad_mark(pad_MSV, 30, s[ms_sGMode] || ms_glOn[v], 0); // (the mode Glide, a glide running : lit)
                ui_jpad_mark(pad_MSV, 36, ms_msim[v], !vw[ms_vMode] || !s[ms_sPath]); // (simulated : lit)
                ui_jpad_mark(pad_MSV, 37, ms_rec[v], !ms_rec[v] && (!vw[ms_vMode] || s[ms_sPath])); // (recording : lit)
                ui_jpad_mark(pad_MSV, 39, ms_mv[v], !ms_mv[v]);
                i = 0; loop(3, ui_jpad_mark(pad_MSV, 48 + 2 * i, ms_ModOn(e, i), 0); ui_jpad_mark(pad_MSV, 49 + 2 * i, 0, !ms_ModOn(e, i)); i += 1;);
                i = 0; loop(4, (ms_plc[v] === i) ? (ui_jpad_role(pad_MSV, 25 + i, ui_jpad_rl_alert); ui_jpad_mark(pad_MSV, 25 + i, 0, 0);); i += 1;);
                zz = control_jpad(pad_MSV);
                c = ui_jpad_cell_at();
                dr = ms_Drag(blockId, v, c);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4;
                    ((zz & (ui_jpad_ev_lmc | ui_jpad_ev_rmc)) && !((zz & ui_jpad_ev_lmc) && (dr & 2))) ? (
                        ms_PadCell(v, pad_MSV[ui_jpad_last] - 1, zz);
                    );
                );
            ui_pop();
            // the view
            ui_pad(2, 3, 2, 2);
            x = ui_left_retina(); y = ui_top_retina(); w = ui_width_retina(); h = ui_height_retina(); // (screen pixels)
            ms_Mouse(v, x, y, w, h, uix_scroll_y) ? uix_scroll_y = 0;
            // (the brush : its rotation, its shares, its envelope, computed by ms_Frame) a brush that turns, a fade : drawn at
            // each run (see must_do_gfx)
            (ms_turn[v] || (ms_st[v] === 1) || (ms_st[v] === 3) || ms_mv[v] || ms_rec[v] || ms_glOn[v]) ? uix_janim = 1;
            ms_Draw(v, x, y, w, h);
        ui_pop();
    );
);

// (2026-11-24) The entries saved before (record 'msf1' : MS_OES words, MS_ONS settings) : read into ms_old, then each one
// into the entry e (the defaults of the new settings ; its path, ms_sTraj, becomes the trajectory A)
MS_OES = 200; MS_ONS = 32;
ms_old = make_array(MS_NLIB * MS_OES);
function ms_Migrate(e) local(o, b, k)
(
    o = ms_old + e * MS_OES; b = ms_E(e);
    memset(b, 0, MS_ES);
    ms_SetDefaults(e);
    b[ms_eUsed] = o[0]; b[ms_eN] = o[1];
    memcpy(b + ms_eSet, o + 2, ms_sTk + 1);                     // (the settings 0 ... 25)
    memcpy(b + ms_eName, o + 2 + MS_ONS, MS_NMLEN);
    memcpy(b + ms_eCf, o + 2 + MS_ONS + MS_NMLEN, 4 * MS_MAXC);
    k = o[2 + ms_sTraj];
    ((k >= 1) && (k <= SP_NTRJ)) ? (b[ms_eSet + ms_sTrK] = SP_KLIB + k - 1) :
    ((k >= 129) && (k <= 132)) ? (b[ms_eSet + ms_sTrK] = SP_KED + k - 129);
);
// Save / load with the project : the library and the views (record 'msf2' : MS_NLIB, MS_ES, MS_NV * MS_VS ; 'msf1', the
// entries before 2026-11-24 : migrated)
function ms_Serialize() local(e, vw)
(
    (file_avail(0) >= 0) ? (
        // ===LOAD===
        (file_avail(0) > 0) ? (
            memset(ser_hdr, 0, 4);
            load_mem(0, ser_hdr, 4);
            ((ser_hdr[1] === MS_NLIB) && (ser_hdr[3] === MS_NV * MS_VS) &&
                (((ser_hdr[0] === 'msf2') && (ser_hdr[2] === MS_ES)) || ((ser_hdr[0] === 'msf1') && (ser_hdr[2] === MS_OES)))) ? (
                (ser_hdr[0] === 'msf2') ? load_mem(0, ms_lib, MS_NLIB * MS_ES) : (
                    load_mem(0, ms_old, MS_NLIB * MS_OES);
                    e = 0; loop(MS_NLIB, ms_Migrate(e); e += 1;);
                );
                load_mem(0, ms_vw, MS_NV * MS_VS);
                e = 0; loop(MS_NLIB, ms_seq[e] += 1; e += 1;);
                // the brush of each view (step 2 ; saved since 2026-11-23 : ms_vInit 1)
                e = 0;
                loop(MS_NV,
                    vw = ms_vw + e * MS_VS;
                    vw[ms_vInit] ? (ms_bx[e] = vw[ms_vBx]; ms_by[e] = vw[ms_vBy]; ms_att[e] = vw[ms_vAtt];);
                    e += 1;
                );
                mSL_log(SysLogBox, "MetaSurfaces : loaded");
            );
        );
    ) : (
        // ===SAVE===
        e = 0; loop(MS_NV, vw = ms_vw + e * MS_VS; vw[ms_vBx] = ms_bx[e]; vw[ms_vBy] = ms_by[e]; vw[ms_vAtt] = ms_att[e]; vw[ms_vInit] = 1; e += 1;);
        ser_hdr[0] = 'msf2'; ser_hdr[1] = MS_NLIB; ser_hdr[2] = MS_ES; ser_hdr[3] = MS_NV * MS_VS;
        save_mem(0, ser_hdr, 4);
        save_mem(0, ms_lib, MS_NLIB * MS_ES);
        save_mem(0, ms_vw, MS_NV * MS_VS);
    );
);
