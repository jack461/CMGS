    sprintf(#ms_xt, "chain %s  mix %s  glide %s %s  dyn %s %s", (s[ms_sTrN] === 3) ? "ABC" : (s[ms_sTrN] === 4) ? "ABCD" : "AB",
        ed_Fmt(#ed_f1, s[ms_sMix]), ed_Fmt(#ed_f2, (s[ms_sGlide] > 0) ? s[ms_sGlide] : 10), s[ms_sGMode] ? "On" : "Off", #ms_xw,
        (s[ms_sDMode] === 1) ? "Out" : (s[ms_sDMode] === 2) ? "InOut" : (s[ms_sDMode] === 3) ? "OutIn" : "In");
    xpt_Block(#ms_xt, 8);
    j = 0;
    loop(3,
        k = s[ms_sMod + 3 * j] - 1;
        (k >= 0) ? ms_XpCrv(#ms_xw, k) : strcpy(#ms_xw, "Off");
        (s[ms_sMod + 3 * j + 1] > 0) ? ed_Fmt(#ed_f1, s[ms_sMod + 3 * j + 1]) : strcpy(#ed_f1, "Path");
        sprintf(#ms_xt, "%s %s  cycle %s  depth %s", (j === 0) ? "modrot" : (j === 1) ? "modspeed" : "modmix", #ms_xw, #ed_f1,
            ed_Fmt(#ed_f2, s[ms_sMod + 3 * j + 2]));
        xpt_Block(#ms_xt, 8);
        j += 1;
    );
);
function ms_XpErr(code, msg)
(
    sprintf(#ms_xm, "ERR: %04d    MetaSurface : export : %s", code, msg);
    mSL_log(SysLogBox, #ms_xm);
    mSL_ErrNote(code, msg);
    code;
);
function ms_Export(e) local(c, i, j, k, t, cnt, s, p)
(
    cnt = 0; i = 0;
    loop(MS_NLIB, ms_xuM[i] = (i === e) || ((e < 0) && ((ms_N(i) > 0) || (strlen(ms_Name(i, #ms_xe)) > 0))); cnt += ms_xuM[i]; i += 1;);
    (cnt === 0) ? ms_XpErr(2450, "no MetaSurface used (a configuration or a name)") :
    ((c = xpt_Ready()) !== 0) ? (
        ms_XpErr(2450, (c === 1) ? "no auxiliary script (CMGS-auxiliary.eel) : nothing is written" :
            (c === 2) ? "the auxiliary script CMGS-auxiliary.eel must be started again (an old version)" :
            "the auxiliary script is busy : try again");
    ) : (
        // what they use : their curves, their trajectories of the library, the paths of their editors
        memset(ms_xuC, 0, CRV_MX); memset(ms_xuT, 0, SP_NTRJ); memset(ms_xuE, 0, 4);
        i = 0;
        loop(MS_NLIB,
            ms_xuM[i] ? (
                s = ms_E(i) + ms_eSet;
                k = s[ms_sCurve] - CRV_DYN; ((k >= 0) && crv_Ex(k)) ? (ms_xuC[k] = 1);
                j = 0; loop(3, k = s[ms_sMod + 3 * j] - 1; ((k >= 0) && crv_Ex(k)) ? (ms_xuC[k] = 1); j += 1;);
                t = 0;
                loop(4,
                    k = s[ms_sTrK + t];
                    (k >= SP_KLIB) ? ( (sp_trN[k - SP_KLIB] > 0) ? (ms_xuT[k - SP_KLIB] = 1); ) :
                    (k >= SP_KED) ? ( p = ed_St(k - SP_KED); (p[ed_sN] > 0) ? (ms_xuE[k - SP_KED] = 1); );
                    t += 1;
                );
            );
            i += 1;
        );
        // the names : of the file (its name, or MetaSurface), of the messages of the script (its name, or MS3)
        (e >= 0) ? (
            (strlen(ms_Name(e, #ms_xn)) === 0) ? strcpy(#ms_xn, "MetaSurface");
            sprintf(#ms_xk, "MS%d", e + 1);
            (strlen(ms_Name(e, #ms_xp)) > 0) ? ed_MslName(#ms_xp, #ms_xp) : strcpy(#ms_xp, #ms_xk);
        ) : (
            strcpy(#ms_xn, "MetaSurfaces"); strcpy(#ms_xk, "library"); strcpy(#ms_xp, #ms_xn);
        );
        xpt_Clean(#ms_xn);
        xpt_FileName(#ms_xf, #ms_xn, "esp", #ms_xk);
        xpt_Date(#ms_xd, 1);
        xpt_Begin();
        (e >= 0) ? sprintf(#ms_xt, "print(\"%s : MetaSurface MS%d d'Espaces, exportee le %s.\");", #ms_xp, e + 1, #ms_xd) :
            sprintf(#ms_xt, "print(\"MetaSurfaces : %d MetaSurface%s d'Espaces, exportee%s le %s.\");", cnt, (cnt > 1) ? "s" : "",
                (cnt > 1) ? "s" : "", #ms_xd);
        xpt_Line(#ms_xt);
        xpt_Line("");
        xpt_Line(sprintf(#ms_xt, "%c*", '/'));
        (e >= 0) ? (
            xpt_Line("  Deposee sur une vue MetaSurface (A ... D), la MetaSurface remplace celle que la vue montre ; ailleurs dans");
            xpt_Line("  Espaces : celle de meme numero (MS1 ... MS32).");
        ) : (
            xpt_Line("  Chaque MetaSurface remplace celle de meme numero (MS1 ... MS32) ; deposee sur une vue MetaSurface (A ... D), la");
            xpt_Line("  premiere remplace celle que la vue montre.");
        );
        xpt_Line("  Avant les MetaSurfaces, ce qu'elles utilisent : les courbes (une courbe nommee remplace la courbe de meme nom, ou");
        xpt_Line("  prend la premiere courbe libre ; sans nom : la courbe de meme numero), les trajectoires de la bibliotheque");
        xpt_Line("  (trajectory n : elles remplacent celles de meme numero), les chemins des editeurs Edit A ... D (ils remplacent");
        xpt_Line("  leur configuration ; touche z sur le module : Undo). Les configurations (zone c x y poids) ne sont pas dans ce");
        xpt_Line("  fichier : celles du projet de memes numeros.");
        xpt_Line(sprintf(#ms_xt, "*%c", '/'));
        xpt_Line("");
        xpt_Line("var r = settings(data(");
        i = 0; loop(CRV_MX, ms_xuC[i] ? crv_XpCurve(i); i += 1;);
        i = 0; loop(SP_NTRJ, ms_xuT[i] ? tr_XpLines(i); i += 1;);
        i = 0; loop(4, ms_xuE[i] ? ed_XpLines(i); i += 1;);
        i = 0; loop(MS_NLIB, ms_xuM[i] ? ms_XpEntry(i); i += 1;);
        xpt_Line("));");
        sprintf(#ms_xt, "print(sprintf(0, \"%s : settings %%d (0 : OK)\", r));", #ms_xp);
        xpt_Line(#ms_xt);
        xpt_Ov ? ms_XpErr(2450, "the text is too long : nothing is written") : (
            xpt_Who = 'msf';
            xpt_Send(#ms_xf);
            sprintf(#ms_xm, "MetaSurface : export of %d MetaSurface%s : %s", cnt, (cnt > 1) ? "s" : "", #ms_xf);
            mSL_log(SysLogBox, #ms_xm);
            0;
        );
    );
);
function ms_XpPoll() local(r)
(
    ((r = xpt_PollFor('msf')) !== 0) ? (
        (r > 0) ? (
            sprintf(#ms_xm, "MetaSurface : export : %s written in the folder of the project", #ms_xf);
            mSL_log(SysLogBox, #ms_xm);
        ) : (
            ms_XpErr(2451, sprintf(#ms_xv, "the file %s can't be written", #ms_xf));
        );
    );
);

// Each run of @gfx (even when the window is closed) : for each view, its projector released if it left Play or chose
// another one ; its envelope ; its shares (its brush shown) ; its publication (it drives a projector) ; (2026-11-24, step 4)
// the entries read by the settings, the exports written
function ms_Frame() local(v, vw, e, p, t)
(
    e = 0; loop(MS_NLIB, mst_tq[e] ? ( mst_tq[e] = 0; ms_TbTake(e); ); e += 1;);
    ms_XpPoll();
    t = time_precise();
    v = 0;
    loop(MS_NV,
        vw = ms_vw + v * MS_VS; e = vw[ms_vE];
        // (2026-11-23, the user) Play / Edit as a bypass : the state kept when the view leaves Play, taken again at its return
        ((ms_lm[v] >= 0) && (ms_lm[v] !== vw[ms_vMode])) ? ms_Bypass(v, e, vw[ms_vMode]);
        ms_lm[v] = vw[ms_vMode];
        p = ms_ownp[v];
        ((p > 0) && (!vw[ms_vMode] || (ms_S(e, ms_sProj) !== p))) ? ms_Release(v);
        ms_Env(v, e, t);
        ms_ModStep(v, e, t); // (2026-11-24, step 3)
        // (step 5) the brush on the path (the mode Path : while it sounds, or simulated) ; the recording
        (vw[ms_vMode] && ms_S(e, ms_sPath)) ? ms_Motion(v, e, t) : (ms_mv[v] = ms_msim[v] = 0);
        ms_rec[v] ? (vw[ms_vMode] ? ms_RecStep(v, e, t) : ms_RecEnd(v, e));
        ms_turn[v] = ms_Shown(v) ? ms_Update(v, e) : 0;
        ((p = ms_ownp[v]) > 0) ? ms_Publish(v, e, p);
        v += 1;
    );
    // (step 5) the backdrops of the editors
    ms_EdBack();
    // (step 4) the simulation for the views Space
    memset(ms_simV, 0, MS_NPRJ + 1);
    v = 0;
    loop(MS_NV,
        vw = ms_vw + v * MS_VS; e = vw[ms_vE]; p = ms_S(e, ms_sProj);
        (ms_Shown(v) && (p >= 1) && (p <= MS_NPRJ) && (ms_N(e) > 0) && (ms_simV[p] === 0) &&
            !((ms_ownp[v] === p) && (ms_st[v] > 0))) ? (
            ms_List(v, e, p);
            ms_Sim(v, e) ? ms_simV[p] = v + 1;
        );
        v += 1;
    );
);
// @block, in the loop of the projectors (the projector prid, its block ppro) : the matrix of a projector driven by a view
// (a new publication : merged, its interpolation in the time published ; the loads of a configuration ignored) ; a
// projector released : its configuration loaded again. Returns 1 when its matrix changed (cfchng)
function ms_BlockHook(prid, ppro) local(v, L, K, N, cons, buf, A, j, q, s, i, g, r, blkw)
(
    r = 0;
    ((prid >= 1) && (prid <= MS_NPRJ)) ? (
        ms_relq[prid] ? (
            ms_relq[prid] = 0;
            prvchcnf = -1; // (the cache of confload : the matrix is no more that of the configuration)
            ppro[prx_cnfupdt] = (ppro[prx_ptrconf] > 0);
            ppro[prx_savpmrph] = -1; // (the time of the interpolation of the projector computed again from its Morph)
        ) : ((v = ms_own[prid] - 1) >= 0) ? (
            ppro[prx_cnfupdt] = 0;
            ((ms_pSeq[v] !== ms_bSeq[v]) && ((L = ms_pL[v]) > 0)) ? (
                ms_bSeq[v] = ms_pSeq[v];
                cons = ppro[prx_pcons];
                (ms_pGn[v] !== ms_bG[v]) ? (memset(cons, 0, matrsiz); ms_bG[v] = ms_pGn[v];); // (a new list : the others to 0)
                K = L[0]; N = L[1]; A = ms_pA[v];
                buf = ms_pW + (v * 2 + (ms_pSeq[v] & 1)) * MS_MAXC;
                j = 0;
                loop(K,
                    q = L + 2 + j * (1 + N);
                    s = 0; i = 0; loop(N, g = q[1 + i]; s += buf[i] * g * g; i += 1;);
                    cons[q[0]] = A * sqrt(s);
                    j += 1;
                );
                blkw = max(16, ms_pT[v] * srate);
                ppro[prx_steps] = blkw; ppro[prx_coefinc] = 2 / (blkw * (blkw + 1)); ppro[prx_index] = 0;
                r = 1;
            );
        );
    );
    r;
);

// (2026-11-23, the user) The placement of the path with the mouse (the brush on the path, Edit or Play) : Cmd + left drag,
// moved (x, y) ; Cmd + Shift + left drag, scaled ; Cmd + right drag, turned ; Cmd + Shift + right drag, turned and scaled ;
// the whole path around the centre of its placement (the centre of the surface moved by x, y), or (2026-11-24) the
// trajectory placed (ms_plc, cell Place) around its pivot (its barycentre displaced ; its move in the frame of the path :
// the placement of the whole path undone). Returns 1 while a drag goes on (the other uses of the mouse ignored)
function ms_PlMouse(v, e, mx, my, inside) local(cx, cy, d0, d1, k, ag, i0, t, dx, dy)
(
    t = ms_plc[v]; i0 = ms_PlI(v, 0);
    ((uix_click1 || uix_click2) && inside && (mouse_cap & 4) && ms_S(e, ms_sPath)) ? (
        ms_qk[v] = (uix_click1 ? 1 : 3) + ((mouse_cap & 8) ? 1 : 0); // (1 moved, 2 scaled, 3 turned, 4 turned and scaled)
        ms_qb = uix_click1 ? 1 : 2; // (the button held)
        ms_qx0 = mx; ms_qy0 = my;
        ms_qtx = ms_S(e, i0); ms_qty = ms_S(e, i0 + 1); ms_qta = ms_S(e, i0 + 2);
        ms_qtk = (ms_S(e, i0 + 3) > 0) ? ms_S(e, i0 + 3) : 1;
        (t < 0) ? (
            ms_qcx = ms_gx[v] + (0.5 + ms_qtx) * ms_gw[v]; ms_qcy = ms_gy[v] + (0.5 - ms_qty) * ms_gh[v];
        ) : (
            ms_qcx = ms_gx[v] + ms_pvu[v] * ms_gw[v]; ms_qcy = ms_gy[v] + ms_pvv[v] * ms_gh[v];
        );
    );
    (ms_qk[v] > 0) ? (
        (uix_mcap & ms_qb) ? (
            k = ms_qk[v]; cx = ms_qcx; cy = ms_qcy;
            (k === 1) ? (
                (t < 0) ? (
                    ms_SSet(e, i0, max(-2, min(2, ms_qtx + (mx - ms_qx0) / max(1, ms_gw[v]))));
                    ms_SSet(e, i0 + 1, max(-2, min(2, ms_qty - (my - ms_qy0) / max(1, ms_gh[v]))));
                ) : (
                    // (the move on the screen, in the metric of the surface, brought into the frame of the path)
                    ms_TfGet(e);
                    dx = (mx - ms_qx0) / max(1, ms_gh[v]); dy = (my - ms_qy0) / max(1, ms_gh[v]);
                    ms_SSet(e, i0, max(-2, min(2, ms_qtx + ms_tffx * (ms_tfc * dx + ms_tfs * dy) / ms_tfk / ms_tfa)));
                    ms_SSet(e, i0 + 1, max(-2, min(2, ms_qty - ms_tffy * (ms_tfc * dy - ms_tfs * dx) / ms_tfk)));
                );
                ui_cursor_drag(8);
            ) : (
                d0 = sqrt(sqr(ms_qx0 - cx) + sqr(ms_qy0 - cy)); d1 = sqrt(sqr(mx - cx) + sqr(my - cy));
                ((k === 2) || (k === 4)) ? ms_SSet(e, i0 + 3, max(0.1, min(10, ms_qtk * d1 / max(8, d0))));
                ((k === 3) || (k === 4)) ? (
                    // (the screen : y down, an angle growing clockwise, as the turns)
                    // (a trajectory under a flip of the whole path : its turn the other way)
                    (t >= 0) ? ms_TfGet(e);
                    ag = ms_qta + (atan2(my - cy, mx - cx) - atan2(ms_qy0 - cy, ms_qx0 - cx)) * 180 / $pi * ((t < 0) ? 1 : ms_tffx * ms_tffy);
                    ag -= 360 * floor((ag + 180) / 360);
                    ms_SSet(e, i0 + 2, floor(ag * 10 + 0.5) / 10);
                );
                ui_cursor_drag((k === 2) ? 12 : 2);
            );
            ui_GFXdoNow |= 4;
        ) : (
            ms_qk[v] = 0; ui_GFXdoNow |= 4;
        );
    );
    ms_qk[v] > 0;
);

// The mouse over the view v (x, y, w, h : screen pixels ; wheel : the wheel since the last frame) ; returns 1 when the wheel
// was used. First the brush held (Play : not on the mouse ; Edit : shown) : a press on its cross moves it (Play : a clic,
// not moved, attaches it again to the mouse, at its place) ; on its shape, its Offset and its Angle follow (the centre of the
// brush around the cross) ; then the mode : Edit, the configurations ; Play, the brush follows the mouse
function ms_Mouse(v, x, y, w, h, wheel) local(vw, e, b, mx, my, inside, p, c, i, rs, used, a, bd, u, q, hit, bp, tx, ty, vx, vy, off, pg)
(
    vw = ms_vw + v * MS_VS; e = vw[ms_vE]; b = ms_E(e);
    rs = uix_drawconfig_current[9];
    ms_Geo(v, e, x, y, w, h);
    mx = mouse_x; my = mouse_y;
    inside = (mx >= x) && (my >= y) && (mx < x + w) && (my < y + h);
    a = max(0.5, min(4, ms_S(e, ms_sAspect))); bd = max(0, ms_S(e, ms_sBand));
    u = (mx - ms_gx[v]) / max(1, ms_gw[v]); q = (my - ms_gy[v]) / max(1, ms_gh[v]);
    // a view not drawn in the previous frame (another tab, another module) : no drag going on
    (ms_seen[v] < gfx_executed - 1) ? (ms_md[v] = 0; ms_bd[v] = 0; ms_qk[v] = 0;);
    ms_seen[v] = gfx_executed;
    ms_hov[v] = inside ? ms_Pick(v, e, mx, my) : -1;
    // (2026-11-23) the placement of the path : Cmd + drags
    pg = ms_PlMouse(v, e, mx, my, inside);
    // ---- the brush held
    hit = (inside && ms_Held(v)) ? ms_BrushHit(v, e, mx, my) : 0;
    ((hit === 1) && vw[ms_vMode] && ms_S(e, ms_sPath)) ? hit = 0; // (step 5 : on the path, its cross is not moved)
    (uix_click1 && inside && !pg && !(uix_mcap & 2) && !(mouse_cap & 16) && (hit > 0)) ? (
        ms_bd[v] = hit; ms_bmv = 0; ms_mx0 = mx; ms_my0 = my;
        ms_gvx = ms_cx - u * a; ms_gvy = ms_cy - q;
        ms_md[v] = 0;
    );
    bp = (ms_bd[v] > 0);
    (bp && (uix_mcap & 1)) ? (
        (!ms_bmv && (abs(mx - ms_mx0) + abs(my - ms_my0) > 3)) ? ms_bmv = 1;
        ms_bmv ? (
            (ms_bd[v] === 1) ? (
                // the cross : the place of the brush (inside the surface and its band)
                ms_Clamp(e, u, q, bd); ms_bx[v] = ms_cu; ms_by[v] = ms_cv;
                ui_cursor_drag(8);
            ) : (
                // the shape : its centre from the cross, Offset (in radii, 2 at most) and Angle (from the vertical, clockwise)
                tx = u * a + ms_gvx; ty = q + ms_gvy;
                vx = tx - ms_bx[v] * a; vy = ty - ms_by[v];
                ms_Brush(v, e);
                off = min(2, sqrt(vx * vx + vy * vy) / max(0.0001, ms_BR));
                ms_SSet(e, ms_sOffset, floor(100 * off + 0.5) / 100);
                (off > 0.005) ? ms_SSet(e, ms_sAngle, ms_Wrap360(floor(ms_Wrap360(atan2(vx, -vy) * 180 / $pi - 360 * ms_ph[v]) + 0.5)));
                ui_cursor_drag(2);
            );
            ui_GFXdoNow |= 4;
        );
    ) : bp ? (
        // released : a clic on the cross of the brush held (Play) attaches it again to the mouse
        ((ms_bd[v] === 1) && !ms_bmv && vw[ms_vMode]) ? ms_att[v] = 1;
        ms_bd[v] = 0; ui_GFXdoNow |= 4;
    );
    // ---- the mode
    (vw[ms_vMode] === 0) ? (
        // Edit : a press of the left button (not with the right one), not on the brush
        (uix_click1 && !bp && !pg) ? (
            (inside && !(uix_mcap & 2)) ? (
                ms_md[v] = 1; ms_dmv = 0; ms_dc = ms_hov[v]; ms_mx0 = mx; ms_my0 = my; ms_dalt = mouse_cap & 16;
                vw[ms_vSel] = ms_dc;
                (ms_dc >= 0) ? (ms_w0 = ms_Cv(e, ms_dc, 3));
                ui_GFXdoNow |= 4;
            ) : (
                ms_md[v] = -1;
            );
        ) : ((uix_mcap & 1) && (ms_md[v] === 1) && (ms_dc >= 0) && (ms_dc < b[ms_eN])) ? (
            (!ms_dmv && (abs(mx - ms_mx0) + abs(my - ms_my0) > 3)) ? ms_dmv = 1;
            ms_dmv ? (
                p = ms_C(e, ms_dc);
                ms_dalt ? (
                    // Alt : its weight (up : larger ; 80 pixels : x 2)
                    p[3] = max(0.1, min(10, ms_w0 * 2 ^ ((ms_my0 - my) / (80 * rs))));
                    ui_cursor_drag(12);
                ) : (
                    ms_Clamp(e, u, q, 0); p[1] = ms_cu; p[2] = ms_cv;
                    ui_cursor_drag(8);
                );
                ms_drag = 1;
                ms_seq[e] += 1; ui_GFXdoNow |= 4;
            );
        ) : !(uix_mcap & 1) ? (
            (ms_md[v] !== 0) ? (ms_md[v] = 0; ms_drag = 0; ui_GFXdoNow |= 4;);
        );
        // a right clic (Shift + right clic : the Studio menu, left to the host) : on a configuration, its menu ; on the
        // surface, add one there
        (uix_click2 && inside && !pg && !(mouse_cap & 8)) ? (
            ((i = ms_hov[v]) >= 0) ? (
                vw[ms_vSel] = i;
                ms_CfMenu(v, e, i);
            ) : ms_InUV(e, u, q, 0) ? (
                (b[ms_eN] >= MS_MAXC) ? (
                    sprintf(#ms_msg, "MetaSurface MS%d : %d configurations at most", e + 1, MS_MAXC); mSL_log(SysLogBox, #ms_msg);
                ) : (
                    sprintf(#ms_t3, "#Add a configuration here (MS%d)", e + 1);
                    ((c = ms_ConfMenu(#ms_t3, 0)) > 0) ? (vw[ms_vSel] = ms_Add(e, c, u, q));
                );
            );
            ui_GFXdoNow |= 4;
        );
    ) : (
        // Play (2026-11-23, step 2) : the brush follows the mouse inside the surface and its band, unless it is held
        // (Alt + clic : held, or attached again ; a clic on its cross : attached again) ; the mouse elsewhere : it stays
        ms_md[v] = 0; ms_drag = 0;
        (uix_click1 && inside && !pg && (mouse_cap & 16)) ? (ms_att[v] = !ms_att[v]; ui_GFXdoNow |= 4;);
        // (step 3) a clic on the surface or its band (not Alt, not on the brush held) : left, start with a fade-in / stop
        // with a fade-out ; right (Shift + right : the Studio menu), start / stop at once (5 ms)
        ms_InUV(e, u, q, bd) ? (
            (uix_click1 && inside && !pg && !(uix_mcap & 2) && !(mouse_cap & 16) && !bp) ? (ms_Toggle(v, e, 1); ui_GFXdoNow |= 4;);
            (uix_click2 && inside && !pg && !(mouse_cap & 8)) ? (ms_Toggle(v, e, 0); ui_GFXdoNow |= 4;);
        );
        (ms_att[v] && !bp && !ms_S(e, ms_sPath) && ms_InUV(e, u, q, bd)) ? (ms_bx[v] = u; ms_by[v] = q;);
        inside ? uix_jmove = 1; // (drawn again when the mouse moves, see must_do_gfx)
    );
    // the wheel (the brush shown) : Spread (Shift : Power)
    (inside && (wheel != 0) && ms_Shown(v)) ? (
        (mouse_cap & 8) ? ms_SSet(e, ms_sPower, max(-1, min(1, ms_S(e, ms_sPower) + wheel / 1200))) :
            ms_SSet(e, ms_sSpread, max(0.01, min(1, ms_S(e, ms_sSpread) * exp(wheel / 1000))));
        used = 1; ui_GFXdoNow |= 4;
    );
    used;
);

// The rename of a MetaSurface (the prompt of ui-lib, see ed_Prompt)
function ms_Prompt(v)
(
    ms_pend = v + 1;
    ms_Name(ms_VGet(v, ms_vE), #ms_prm);
    ui_screen_open("control.prompt");
    ui_screen_arg(0, #ms_prm);
    ui_screen_arg(1, "The name of the MetaSurface");
);
function ms_Prompted()
(
    ((ms_pend > 0) && !(ui_screen() == "control.prompt")) ? (
        ms_SetName(ms_VGet(ms_pend - 1, ms_vE), #ms_prm);
        ms_pend = 0;
    );
);

// The pad of the views (shared : its labels are set before each drawing) : line 1 the surface, line 2 the brush (step 2),
// line 3 the sound (step 3), line 4 the trajectory (step 5), line 5 the placement of the path (2026-11-23) ; (2026-11-24,
// step 3 of the curves) line 7 the modulators
MS_PSIZ = 56; // (2026-11-24 : 7 lines)
pad_MSV = make_jpad(ui_jpad_ty_act | ui_jpad_mk_labs | ui_jpad_mk_colors, 7, 8, MS_PSIZ);
pad_MSV_Labs = pad_MSV + pad_MSV[ui_jpad_labs];
pad_MSV_Colrs = pad_MSV + pad_MSV[ui_jpad_clrs];
i__k = 0; loop(MS_PSIZ, pad_MSV_Colrs[i__k] = Col_Inactive; pad_MSV_Labs[i__k] = ""; i__k += 1;);

// The cells of values : 4 the band, 6 the weight of the configuration selected, 8 ... 14 the brush (Spread, Power, Shape,
// Stretch, Offset, Rotation, Angle), 16 Volume (dB), 17 Latency (ms), 19 Attack, 20 Release (s) : their value for a drag (ms_DV), back to the setting (ms_DSet), their range (ms_DRange :
// ms_lo, ms_hi ; 0 : not a cell of value), their default (ms_DDef), their menu (ms_ml[c] : its items, ms_vv : their values ;
// 2026-11-23 : it was ms_mv, the name of the motion too) ; (2026-11-24) 29 Mix (%), 30 Glide (s), 32 Duration (s), 35 Radius
// (%), 40 ... 43 the placement of the whole path or of the trajectory placed (x %, y %, turn, scale : the setting ms_PlI)
function ms_DV(v, e, c) local(i)
(
    i = ms_VGet(v, ms_vSel);
    (c === 4) ? 100 * ms_S(e, ms_sBand) : (c === 6) ? max(0.1, min(10, ms_Cv(e, i, 3))) :
    (c === 8) ? 100 * ms_S(e, ms_sSpread) : (c === 9) ? 100 * ms_S(e, ms_sPower) : (c === 10) ? 100 * ms_S(e, ms_sShape) :
    (c === 11) ? max(0.1, min(10, ms_S(e, ms_sStretch))) : (c === 12) ? 100 * ms_S(e, ms_sOffset) :
    (c === 13) ? 100 * ms_S(e, ms_sRot) : (c === 14) ? ms_S(e, ms_sAngle) :
    (c === 16) ? ms_S(e, ms_sVol) : (c === 17) ? max(5, ms_S(e, ms_sLat)) : (c === 19) ? max(0.01, ms_S(e, ms_sAtt)) :
    (c === 20) ? max(0.01, ms_S(e, ms_sRel)) :
    (c === 29) ? 100 * ms_S(e, ms_sMix) : (c === 30) ? max(1, min(300, ms_S(e, ms_sGlide))) :
    (c === 32) ? max(0.5, ms_S(e, ms_sDur)) : (c === 35) ? 100 * ms_S(e, ms_sRad) :
    ((c === 40) || (c === 41)) ? 100 * ms_S(e, ms_PlI(v, c - 40)) : (c === 42) ? ms_S(e, ms_PlI(v, 2)) :
    (c === 43) ? ((ms_S(e, ms_PlI(v, 3)) > 0) ? max(0.1, min(10, ms_S(e, ms_PlI(v, 3)))) : 1) :
    // (2026-11-24, step 3) the depths of the modulators (%)
    ((c === 49) || (c === 51) || (c === 53)) ? 100 * ms_S(e, ms_sMod + 3 * ((c - 49) / 2) + 2) : 0;
);
function ms_DSet(v, e, c, x) local(i, k)
(
    i = ms_VGet(v, ms_vSel);
    (c === 4) ? (ms_SSet(e, ms_sBand, max(0, min(50, floor(x + 0.5))) / 100); ms_seq[e] += 1;) :
