ms_xuC = make_array(CRV_MX); ms_xuT = make_array(SP_NTRJ); ms_xuE = make_array(4); ms_xuM = make_array(MS_NLIB);
// the kind k of a trajectory as a word of the settings (mst_Kind)
function ms_XpKind(dst, k)
(
    (k < SP_KED) ? sx_Nth("None|Circle|Square|Star|Spiral|Central", max(0, k), dst) :
    (k < SP_KLIB) ? sprintf(dst, "Edit %c", 'A' + k - SP_KED) : sprintf(dst, "T%d", k - SP_KLIB + 1);
    dst;
);
// the curve k as a reference : Curve "name", or Curve n
function ms_XpCrv(dst, k) ( (strlen(crv_nm[k]) > 0) ? sprintf(dst, "Curve \"%s\"", crv_nm[k]) : sprintf(dst, "Curve %d", k + 1); dst; );
// the flips of a trajectory t (-1 : the path) : None, X, Y, XY
function ms_XpFlip(s, t) local(x, y)
(
    x = (s[ms_sFlip] & ms_FlipBit(t, 0)) ? 1 : 0; y = (s[ms_sFlip] & ms_FlipBit(t, 1)) ? 2 : 0;
    (x + y === 3) ? "XY" : (x + y === 2) ? "Y" : (x + y === 1) ? "X" : "None";
);
// an angle in (-180, 180]
function ms_XpTurn(a) local(x) ( x = floor(a + 0.5); x - 360 * floor((x + 180) / 360); );
function ms_XpEntry(e) local(s, i, n, p, t, k, j)
(
    s = ms_E(e) + ms_eSet;
    sprintf(#ms_xt, "MetaSurface %d", e + 1);
    (strlen(ms_Name(e, #ms_xe)) > 0) ? strcat(#ms_xt, sprintf(#ms_xv, "  name \"%s\"", ed_MslName(#ms_xw, #ms_xe)));
    xpt_Block(#ms_xt, 4);
    n = ms_N(e);
    (n > 0) ? (
        strcpy(#ms_xt, ""); i = 0;
        loop(n,
            p = ms_C(e, i);
            strcat(#ms_xt, sprintf(#ms_xv, "%szone %d %s %s %s", (i > 0) ? "  " : "", p[0], ed_Fmt(#ed_f1, p[1]), ed_Fmt(#ed_f2, p[2]),
                ed_Fmt(#ed_f3, p[3])));
            i += 1;
        );
        xpt_Block(#ms_xt, 8);
    );
    sprintf(#ms_xt, "aspect %s  surface %s  band %s  proj %d", ed_Fmt(#ed_f1, s[ms_sAspect]), s[ms_sSurf] ? "Disk" : "Rect",
        ed_Fmt(#ed_f2, s[ms_sBand]), s[ms_sProj]);
    xpt_Block(#ms_xt, 8);
    sprintf(#ms_xt, "spread %s  power %s  shape %s  stretch %s  offset %s  rotation %s  angle %s", ed_Fmt(#ed_f1, s[ms_sSpread]),
        ed_Fmt(#ed_f2, s[ms_sPower]), ed_Fmt(#ed_f3, s[ms_sShape]), ed_Fmt(#ed_f4, s[ms_sStretch]), ed_Fmt(#ed_f5, s[ms_sOffset]),
        ed_Fmt(#ed_f6, s[ms_sRot]), ed_Fmt(#ms_xw, s[ms_sAngle]));
    xpt_Block(#ms_xt, 8);
    sprintf(#ms_xt, "volume %s  latency %s  rule %s  attack %s  release %s", ed_Fmt(#ed_f1, s[ms_sVol]), ed_Fmt(#ed_f2, s[ms_sLat]),
        s[ms_sLatMode] ? "Distance" : "Fixed", ed_Fmt(#ed_f3, s[ms_sAtt]), ed_Fmt(#ed_f4, s[ms_sRel]));
    xpt_Block(#ms_xt, 8);
    sprintf(#ms_xt, "brush %s  duration %s  mode %s  speed %s  radius %s", s[ms_sPath] ? "Path" : "Mouse", ed_Fmt(#ed_f1, s[ms_sDur]),
        (s[ms_sLoop] === 0) ? "Once" : (s[ms_sLoop] === 2) ? "Back" : (s[ms_sLoop] === 3) ? "Reverse" : "Loop",
        s[ms_sSpeedM] ? "Points" : "Path", ed_Fmt(#ed_f2, s[ms_sRad]));
    xpt_Block(#ms_xt, 8);
    t = 0;
    loop(4,
        i = ms_sPl + 4 * t;
        sprintf(#ms_xt, "%c %s  place %s %s %d %s  flip %s", 'A' + t, ms_XpKind(#ms_xw, s[ms_sTrK + t]), ed_Fmt(#ed_f1, s[i]),
            ed_Fmt(#ed_f2, s[i + 1]), ms_XpTurn(s[i + 2]), ed_Fmt(#ed_f3, (s[i + 3] > 0) ? s[i + 3] : 1), ms_XpFlip(s, t));
        xpt_Block(#ms_xt, 8);
        t += 1;
    );
    sprintf(#ms_xt, "path place %s %s %d %s  flip %s", ed_Fmt(#ed_f1, s[ms_sTx]), ed_Fmt(#ed_f2, s[ms_sTy]), ms_XpTurn(s[ms_sTa]),
        ed_Fmt(#ed_f3, (s[ms_sTk] > 0) ? s[ms_sTk] : 1), ms_XpFlip(s, -1));
    xpt_Block(#ms_xt, 8);
    (s[ms_sCurve] >= CRV_DYN) ? ms_XpCrv(#ms_xw, s[ms_sCurve] - CRV_DYN) :
