/*

    =============================== Space3D : 3D view of a speaker set ===============================

    A perspective view of the room [-1,1]^3, with its speakers, sources, group center and trajectory,
    in the spirit of the "Position" view of GRM Spaces 3D.

    Axes (same as the GRM ".lay" layouts) :
        x : left (-1)   -> right (+1)
        y : back (-1)   -> front (+1)
        z : bottom (-1) -> top (+1)

    Usage :
        @init : next_free = s3d_init(base, maxspk, maxsrc, maxtrj, img);
                    img : index of an offscreen image (drawing is done in it, then blitted : clipping)
                speakers : s3d_spk[k * s3d_st + s3d_fx / s3d_fy / s3d_fz] = position,
                           s3d_spk[k * s3d_st + s3d_fg] = gain (0..1), s3d_fl = level (0..1) ; s3d_nspk
                sources  : idem in s3d_src, s3d_nsrc
                group center : s3d_gx, s3d_gy, s3d_gz, shown when s3d_gon
                trajectory : s3d_trj[k*3 + 0/1/2], s3d_ntrj points, s3d_trjclosed
        size of the memory needed from "base" : s3d_memsize(maxspk, maxsrc, maxtrj)
        @gfx  : s3d_mouse(x, y, w, h, wheel);  // orbit (left drag), zoom (wheel), pick (left click), menu (right click)
                    (2026-11-21) the orbit as held in the hand (s3d_orbit : horizontal around the vertical of the
                    screen, vertical around its horizontal ; the camera has a roll, s3d_roll) ; the levelling
                    (s3d_level, s3d_LevelStart, s3d_LevelStep : the face of the room nearest to the bottom of the
                    screen made horizontal) ; the presentations of the room (s3d_grids : the far faces, the planes,
                    the axes, the plane z, polar, nothing : s3d_PresSet, s3d_PresCur, s3d_presZ) ; the drags follow
                    the screen (the side near the eye follows the mouse)
                    the trajectory (as the cursors S, R, T of GRM Spaces) : Shift + drag = size,
                    Cmd + drag = rotation (horizontal : around z, vertical : tilt), Alt + drag = translation,
                    Shift + Alt + vertical drag = translation in depth (2026-11-21, up = farther) ;
                    s3d_tchanged != 0 when it was changed
                    controls for the play (horizontal drag) : Cmd + Alt = s3d_speed (turns per minute, -240 ... 240),
                    Cmd + Shift = s3d_mix (0 ... 1, see s3d_mkmorph) ; the value is shown during the drag
                    s3d_mtarget = 1 : Shift, Cmd and Alt drags act on the group of sources instead of the trajectory :
                    Shift = size (s3d_gsc), Cmd = yaw (horizontal) and pitch (vertical), Alt = roll (horizontal)
                    s3d_plmode = 1 (2026-11-19, set by the host : the placement of one trajectory, Espaces) : the
                    host puts the placement into s3d_tsc, s3d_trx, s3d_try, s3d_trz, s3d_ttx ... before s3d_mouse and
                    takes it back after, with the transform of the whole path (its parent : s3d_pgs, s3d_pgrx,
                    s3d_pgrz) ; the drags follow the screen (2026-11-21, s3d_plvec, s3d_plrot) : Alt in the plane of
                    the screen, Shift + Alt in depth, Cmd turned as held in the hand, Cmd + Alt (horizontal) turned
                    in the plane of the screen (instead of the speed) ; s3d_mtarget is ignored ; s3d_draw draws the
                    trajectory in gold, its pivot as a red cross (s3d_pvOn, s3d_pvx ...) and, during a drag of the
                    placement, the line #s3d_plLbl (written by the host)
                sources : s3d_place_sources(lay, n, spread) : the sources of the layout "lay" (x, y, z in [-1,1]) around
                    the group center, scaled by spread * s3d_gsc, rotated by s3d_groll (around y), s3d_gpitch
                    (around x), s3d_gyaw (around z), in the room frame (s3d_grel = 0) or in the frame of the
                    trajectory (s3d_grel = 1 : the front of the group follows the direction of the motion)
                    wheel : mouse_wheel, or uix_scroll_y with ui-lib (which clears mouse_wheel) ;
                    returns 1 when the wheel was used (the host may then clear it)
                s3d_draw(x, y, w, h);  // draws in the current gfx_dest (the screen, or a ui-lib clip screen)
                    background s3d_bgr, s3d_bgg, s3d_bgb (black), texts s3d_txr, s3d_txg, s3d_txb (white) : 0..1 ;
                    the grid, the cross and the halo get colors contrasting with the background (s3d_colors)
                    s3d_style = 1 : the gains are shown as crosses, the levels as halos (instead of balls)
                    sizes (2026-11-18, menu "Size of ...") : s3d_kSpk the balls of the speakers, s3d_kSrc those of the
                    sources (and the group center), s3d_kX the crosses (or the balls) of the gains : factors, 1 by
                    default, x 0.25 ... x 4 in the menu (s3d_kval : 25 values since 2026-11-19) ; the host may save them
                trajectories : s3d_mktraj(kind, cx, cy, cz, r) ; s3d_trjpos(u) : the point at u (0..1) of the path
                    s3d_mkmorph(ka, kb, w, cx, cy, cz, r) : interpolation between two trajectories (w = 0 : ka, 1 : kb)
                    kind "File" : a trajectory given by s3d_settraj (read with s3d_load_lay from a GRM Spaces
                    export : <Trajectory name="" closed="true" order=""> <P x="" y="" z="" end=""/> ...)
                dynamics : s3d_ease(curve, mode, t)
                s3d_changed != 0 when the camera or the options were changed by the user (to save them)

    Except s3d_init and s3d_load_lay (which may be called in @init), everything runs in @gfx :
    the s3d_* work globals are never touched by @block. @block may write the gains and levels.

    Mouse buttons (mouse_cap) : 1 left, 2 right, 4 Cmd, 8 Shift, 16 Alt, 32 Ctrl, 64 middle

*/

@init

// fields of a speaker / source entry
s3d_fx = 0; s3d_fy = 1; s3d_fz = 2;  // position
s3d_fg = 3;                          // gain (speakers)
s3d_fl = 4;                          // level (speakers)
s3d_fsx = 5; s3d_fsy = 6;            // projection on the screen
s3d_fsz = 7;                         // depth (<= 0 : not visible)
s3d_st = 8;                          // size of an entry

// display options (s3d_opt)
s3d_oGains = 1;             // the gains of the speakers : "Display Diffusers" in the menu
s3d_oLevels = 2;
s3d_oInfos = 4;
s3d_oAllInfos = 8;
s3d_oBox = 16;
s3d_oProj = 32;
s3d_oFade = 64;
s3d_oStars = 128;
s3d_oTraj = 256;            // display the trajectory
s3d_oClamp = 512;           // positions and trajectories limited to the room [-1,1]^3
s3d_oHideSrc = 1024;        // hide the sources, their group center and their projections ("Display Source" unchecked) ;
                            // an inverted bit : the options saved before it (e.g. Space3D-Demo, slider 0 ... 1023) show them

s3d_StarsNb = 250;
s3d_GridN = 12;             // grid divisions on each face
s3d_near = 0.05;            // near plane
s3d_Az3D = 0.45;            // the "3D view" camera
s3d_El3D = 0.30;
s3d_Dist3D = 4.2;
s3d_style = 0;              // 0 : gains and levels as balls ; 1 : gains as crosses, levels as halos
s3d_haloA = 0.9;            // opacity of the center of the halos (< 1 : the cross remains visible)
s3d_gdark = 0;              // the grid is darker than the background (with hysteresis, see s3d_colors)

// selection : type * 1024 + index
s3d_tSpk = 1;
s3d_tSrc = 2;


function s3d_memsize(maxspk, maxsrc, maxtrj)
(
    maxspk * s3d_st + maxsrc * s3d_st + 4 * maxtrj * 3 + s3d_StarsNb * 4 + 2 * (maxspk + maxsrc + 1) + 24;
);

function s3d_init(base, maxspk, maxsrc, maxtrj, img)
local(k, a, b)
(
    s3d_mspk = maxspk; s3d_msrc = maxsrc; s3d_mtrj = maxtrj;
    s3d_img = img;
    s3d_spk = base;                         base += maxspk * s3d_st;
    s3d_src = base;                         base += maxsrc * s3d_st;
    s3d_trj = base;                         base += maxtrj * 3;
    s3d_ftrj = base;                        base += maxtrj * 3;  // the "File" trajectory, before transformation
    s3d_ta = base;                          base += maxtrj * 3;  // the two trajectories of s3d_mkmorph
    s3d_tb = base;                          base += maxtrj * 3;
    s3d_stars = base;                       base += s3d_StarsNb * 4;
    s3d_okey = base;                        base += maxspk + maxsrc + 1;
    s3d_oid = base;                         base += maxspk + maxsrc + 1;
    s3d_poly = base;                        base += 24;   // a polygon of 12 points (s3d_disc)
    memset(s3d_spk, 0, base - s3d_spk);
    s3d_nspk = s3d_nsrc = s3d_ntrj = 0;
    s3d_plmode = 0; s3d_try = 0; strcpy(#s3d_plLbl, ""); // (a placement, see s3d_mouse : 2026-11-19)
    s3d_trjclosed = 1;
    s3d_nftrj = 0; s3d_ftclosed = 1;
    s3d_gon = 0; s3d_gx = s3d_gy = s3d_gz = 0;
    s3d_az = s3d_Az3D; s3d_el = s3d_El3D; s3d_dist = s3d_Dist3D;
    s3d_roll = 0; s3d_camId = 7; s3d_lvId = 0; // (2026-11-21 : the roll of the camera, the levelling ; see s3d_basis)
    s3d_pres = 0; s3d_presZ = 0; // (2026-11-21 : the presentation of the room, see s3d_grids)
    s3d_pgs = 1; s3d_pgrx = s3d_pgrz = 0; s3d_pvOn = 0; s3d_pvx = s3d_pvy = s3d_pvz = 0; // (a placement, see s3d_mouse)
    s3d_fov = 50 * $pi / 180;
    s3d_opt = s3d_oGains | s3d_oInfos | s3d_oBox | s3d_oTraj | s3d_oClamp;
    s3d_bgr = s3d_bgg = s3d_bgb = 0; // the background (black), and the color of the texts (white)
    s3d_txr = s3d_txg = s3d_txb = 1;
    s3d_sel = -1;
    s3d_mdown = s3d_rdown = 0;
    s3d_iw = s3d_ih = 0;
    s3d_changed = 0;
    // transformation of the trajectory : size, rotations (around z, tilt around x), translation
    s3d_tsc = 1; s3d_trz = s3d_trx = 0; s3d_ttx = s3d_tty = s3d_ttz = 0;
    s3d_tchanged = 0;
    // controls for the play
    s3d_speed = 3; s3d_mix = 0;
    s3d_dmode = 0; // current drag : 1 orbit, 2 translation, 3 rotation, 4 size, 5 speed, 6 mix, 7 sources, 8 a placement
                   // turned in the plane of the screen, 9 translation in depth
    // the group of sources : size, rotations (radians), frame (0 room, 1 trajectory), target of the drags
    s3d_gsc = 1; s3d_gyaw = s3d_gpitch = s3d_groll = 0; s3d_grel = 0; s3d_mtarget = 0;
    s3d_tdx = 0; s3d_tdy = 1; s3d_tdz = 0; // direction of the trajectory at the group center
    // the sizes : the balls of the speakers, of the sources, the crosses of the gains (factors)
    s3d_kSpk = s3d_kSrc = s3d_kX = 1;
    // the stars : random directions, far away
    k = 0;
    loop(s3d_StarsNb,
        a = rand(2 * $pi); b = asin(rand(2) - 1);
        s3d_stars[4*k] = 40 * cos(b) * cos(a);
        s3d_stars[4*k+1] = 40 * cos(b) * sin(a);
        s3d_stars[4*k+2] = 40 * sin(b);
        s3d_stars[4*k+3] = 0.2 + rand(0.8); // brightness
        k += 1;
    );
    base;
);


// The camera (an orbit around the center of the room) : its azimuth s3d_az, its elevation s3d_el, its roll s3d_roll (the
// right and the up of the screen turned around the line of sight, 2026-11-21), its distance s3d_dist : its place, its
// forward, right and up vectors (s3d_cp..., s3d_fw..., s3d_rg..., s3d_up...). The elevation is not limited : beyond the
// poles, the view continues upside down (s3d_el is kept in ]-pi, pi])
function s3d_basis()
local(ce, cr, sr, rx, ry, ux, uy, uz)
(
    s3d_el -= 2 * $pi * floor((s3d_el + $pi) / (2 * $pi));
    ce = cos(s3d_el);
    s3d_cpx = s3d_dist * ce * sin(s3d_az);
    s3d_cpy = - s3d_dist * ce * cos(s3d_az);
    s3d_cpz = s3d_dist * sin(s3d_el);
    // forward : towards the center
    s3d_fwx = - s3d_cpx / s3d_dist; s3d_fwy = - s3d_cpy / s3d_dist; s3d_fwz = - s3d_cpz / s3d_dist;
    // without the roll : the right horizontal, given by the azimuth only (forward x (0, 0, 1) would flip over the
    // poles) ; up = right x forward
    rx = cos(s3d_az); ry = sin(s3d_az);
    ux = ry * s3d_fwz; uy = - rx * s3d_fwz; uz = rx * s3d_fwy - ry * s3d_fwx;
    // the roll
    cr = cos(s3d_roll); sr = sin(s3d_roll);
    s3d_rgx = cr * rx + sr * ux; s3d_rgy = cr * ry + sr * uy; s3d_rgz = sr * uz;
    s3d_upx = cr * ux - sr * rx; s3d_upy = cr * uy - sr * ry; s3d_upz = cr * uz;
);

// The camera for a view of w x h pixels : s3d_basis, the focal length, the center of the screen
function s3d_camera(w, h)
(
    s3d_basis();
    s3d_foc = 0.5 * min(w, h) / tan(0.5 * s3d_fov);
    s3d_ox = 0.5 * w; s3d_oy = 0.5 * h;
    // depths of the room, for the fade out
    s3d_zmin = s3d_dist - 1.75; s3d_zmax = s3d_dist + 1.75;
);

// (2026-11-21) The azimuth, the elevation and the roll of the forward and up vectors s3d_fw..., s3d_up... (made
// orthonormal ; the elevation in [-pi/2, pi/2] : a view upside down has a roll of 180 degrees) ; the right again
function s3d_FromBasis()
local(l, d, ce, rx, ry, ux, uy, uz)
(
    l = sqrt(sqr(s3d_fwx) + sqr(s3d_fwy) + sqr(s3d_fwz));
    (l > 0.000001) ? (s3d_fwx /= l; s3d_fwy /= l; s3d_fwz /= l;);
    d = s3d_upx * s3d_fwx + s3d_upy * s3d_fwy + s3d_upz * s3d_fwz;
    s3d_upx -= d * s3d_fwx; s3d_upy -= d * s3d_fwy; s3d_upz -= d * s3d_fwz;
    l = sqrt(sqr(s3d_upx) + sqr(s3d_upy) + sqr(s3d_upz));
    (l > 0.000001) ? (s3d_upx /= l; s3d_upy /= l; s3d_upz /= l;);
    // right = forward x up
    s3d_rgx = s3d_fwy * s3d_upz - s3d_fwz * s3d_upy;
    s3d_rgy = s3d_fwz * s3d_upx - s3d_fwx * s3d_upz;
    s3d_rgz = s3d_fwx * s3d_upy - s3d_fwy * s3d_upx;
    s3d_el = asin(max(-1, min(1, - s3d_fwz)));
    ce = cos(s3d_el);
    // (looking straight up or down : the azimuth from the right of the screen, the roll 0)
    s3d_az = (ce > 0.0001) ? atan2(- s3d_fwx, s3d_fwy) : atan2(s3d_rgy, s3d_rgx);
    rx = cos(s3d_az); ry = sin(s3d_az);
    ux = ry * s3d_fwz; uy = - rx * s3d_fwz; uz = rx * s3d_fwy - ry * s3d_fwx;
    // up = cos(roll) up0 - sin(roll) right0
    s3d_roll = atan2(- (s3d_upx * rx + s3d_upy * ry), s3d_upx * ux + s3d_upy * uy + s3d_upz * uz);
);

// The forward and up vectors of the camera turned around the unit axis (kx, ky, kz) by the angle t (Rodrigues)
function s3d_camrot(kx, ky, kz, t)
local(c, s, d, x, y, z)
(
    c = cos(t); s = sin(t);
    x = s3d_fwx; y = s3d_fwy; z = s3d_fwz;
    d = (kx * x + ky * y + kz * z) * (1 - c);
    s3d_fwx = x * c + (ky * z - kz * y) * s + kx * d;
    s3d_fwy = y * c + (kz * x - kx * z) * s + ky * d;
    s3d_fwz = z * c + (kx * y - ky * x) * s + kz * d;
    x = s3d_upx; y = s3d_upy; z = s3d_upz;
    d = (kx * x + ky * y + kz * z) * (1 - c);
    s3d_upx = x * c + (ky * z - kz * y) * s + kx * d;
    s3d_upy = y * c + (kz * x - kx * z) * s + ky * d;
    s3d_upz = z * c + (kx * y - ky * x) * s + kz * d;
);

// (2026-11-21) The orbit of a drag of (dx, dy) pixels, as an object held in the hand : horizontal, around the vertical
// of the screen ; vertical, around its horizontal ; the side of the room near the eye follows the mouse (any view, even
// upside down : the room may lean, s3d_level makes it level again)
function s3d_orbit(dx, dy)
local(ax, ay, az)
(
    s3d_basis();
    s3d_camrot(s3d_upx, s3d_upy, s3d_upz, - dx * 0.008);
    ax = s3d_fwy * s3d_upz - s3d_fwz * s3d_upy; ay = s3d_fwz * s3d_upx - s3d_fwx * s3d_upz; az = s3d_fwx * s3d_upy - s3d_fwy * s3d_upx;
    s3d_camrot(ax, ay, az, - dy * 0.008);
    s3d_FromBasis();
    s3d_changed = 1;
);

/*
    (2026-11-21) The levelling ("aplomb", key 'a' in the 3D views of Espaces) : the face of the room nearest to the
    bottom of the screen becomes horizontal, the camera turned around the line of sight only (its azimuth and elevation
    seen kept), in s3d_LvTime seconds. s3d_LevelAngle : the angle (the camera set : s3d_basis, or that of a host), up
    turned towards the right (as s3d_camrot around the forward : the roll decreases by it) ; s3d_LevelStart(id) : for the
    camera id of a host (not 0 ; s3d_camId : the camera of s3d_mouse, s3d_menu) ; s3d_LevelStep(id) : at each frame, the
    angle to turn now (0 : none ; s3d_lvId : the camera levelled, 0 when done)
*/
s3d_LvTime = 0.3;
function s3d_LevelAngle()
local(ax, ay, az, tx, ty, tz, d)
(
    // the axis of the room nearest to the vertical of the screen, upwards
    ax = abs(s3d_upx); ay = abs(s3d_upy); az = abs(s3d_upz);
    tx = ty = tz = 0;
    ((ax >= ay) && (ax >= az)) ? (tx = sign(s3d_upx)) : (ay >= az) ? (ty = sign(s3d_upy)) : (tz = sign(s3d_upz));
    // on the plane of the screen : the new up
    d = tx * s3d_fwx + ty * s3d_fwy + tz * s3d_fwz;
    tx -= d * s3d_fwx; ty -= d * s3d_fwy; tz -= d * s3d_fwz;
    // the angle from up to it, around the forward
    atan2(s3d_fwx * (s3d_upy * tz - s3d_upz * ty) + s3d_fwy * (s3d_upz * tx - s3d_upx * tz) + s3d_fwz * (s3d_upx * ty - s3d_upy * tx),
          s3d_upx * tx + s3d_upy * ty + s3d_upz * tz);
);
function s3d_LevelStart(id)
local(a)
(
    a = s3d_LevelAngle();
    ((id != 0) && (abs(a) > 0.0005)) ? (s3d_lvId = id; s3d_lvT0 = time_precise(); s3d_lvA = a; s3d_lvD = 0;);
);
function s3d_LevelStep(id)
local(t, v, r)
(
    r = 0;
    ((id != 0) && (s3d_lvId === id)) ? (
        t = min(1, (time_precise() - s3d_lvT0) / s3d_LvTime);
        v = s3d_lvA * t * t * (3 - 2 * t);
        r = v - s3d_lvD; s3d_lvD = v;
        (t >= 1) ? (s3d_lvId = 0);
    );
    r;
);
// the camera of s3d_mouse (az, el, roll) : levelled from its own place, s3d_camId
function s3d_level()
(
    s3d_basis();
    s3d_LevelStart(s3d_camId);
);


// Project a point : result in s3d_px, s3d_py, s3d_pz (depth). Returns 0 when behind the camera.
function s3d_proj(x, y, z)
local(dx, dy, dz)
(
    dx = x - s3d_cpx; dy = y - s3d_cpy; dz = z - s3d_cpz;
    s3d_pz = dx * s3d_fwx + dy * s3d_fwy + dz * s3d_fwz;
    (s3d_pz > s3d_near) ? (
        s3d_px = s3d_ox + s3d_foc * (dx * s3d_rgx + dy * s3d_rgy + dz * s3d_rgz) / s3d_pz;
        s3d_py = s3d_oy - s3d_foc * (dx * s3d_upx + dy * s3d_upy + dz * s3d_upz) / s3d_pz;
        1;
    ) : 0;
);


function s3d_line(x1, y1, z1, x2, y2, z2)
local(ax, ay)
(
    s3d_proj(x1, y1, z1) ? (
        ax = s3d_px; ay = s3d_py;
        s3d_proj(x2, y2, z2) ? gfx_line(ax, ay, s3d_px, s3d_py, 1);
    );
);


// alpha factor of the fade out, for the depth z
function s3d_fade(z)
(
    (s3d_opt & s3d_oFade) ? 1 - 0.65 * max(0, min(1, (z - s3d_zmin) / (s3d_zmax - s3d_zmin))) : 1;
);


// A shaded ball : concentric circles moving towards the light (top left)
// a < 1 : translucent ball
function s3d_ball(x, y, r, cr, cg, cb, a)
local(n, k, t, rr, ai, hl)
(
    r = max(1, r);
    n = (r < 4) ? 1 : (r < 12) ? 4 : 8;
    ai = (a < 1) ? a * 0.3 : a;
    k = 0;
    loop(n,
        t = k / n;
        rr = r * (1 - 0.85 * t);
        hl = 0.45 * t * t * t;
        gfx_r = min(1, cr * (0.35 + 0.75 * t) + hl);
        gfx_g = min(1, cg * (0.35 + 0.75 * t) + hl);
        gfx_b = min(1, cb * (0.35 + 0.75 * t) + hl);
        gfx_a = (k === 0) ? a : ai;
        gfx_circle(x - 0.35 * r * t, y - 0.35 * r * t, rr, 1, 1);
        k += 1;
    );
    (r >= 6) ? (
        gfx_set(1, 1, 1, 0.5 * a);
        gfx_circle(x - 0.4 * r, y - 0.4 * r, 0.12 * r, 1, 1);
    );
);


// The color of hue h (degrees), saturation s, value v (0..1) : result in s3d_cr, s3d_cg, s3d_cb
function s3d_hsv(h, s, v)
local(i, f, p, q, t)
(
    h = (h - 360 * floor(h / 360)) / 60;
    i = floor(h); f = h - i;
    p = v * (1 - s); q = v * (1 - s * f); t = v * (1 - s * (1 - f));
    (i === 0) ? (s3d_cr = v; s3d_cg = t; s3d_cb = p;) :
    (i === 1) ? (s3d_cr = q; s3d_cg = v; s3d_cb = p;) :
    (i === 2) ? (s3d_cr = p; s3d_cg = v; s3d_cb = t;) :
    (i === 3) ? (s3d_cr = p; s3d_cg = q; s3d_cb = v;) :
    (i === 4) ? (s3d_cr = t; s3d_cg = p; s3d_cb = v;) :
                (s3d_cr = v; s3d_cg = p; s3d_cb = q;);
);


// The colors contrasting with the background s3d_bgr, s3d_bgg, s3d_bgb :
// the grid (s3d_grr...), the names of the faces (s3d_lbr...), the crosses (s3d_xr...), the halos (s3d_hr...)
function s3d_colors()
local(mx, mn, c, l, h, a, d1, d2, sp, hc, t, d, k, tr, tg, tb, f)
(
    mx = max(s3d_bgr, max(s3d_bgg, s3d_bgb)); mn = min(s3d_bgr, min(s3d_bgg, s3d_bgb));
    c = mx - mn; // chroma : the hue is meaningless when it is small
    l = 0.299 * s3d_bgr + 0.587 * s3d_bgg + 0.114 * s3d_bgb; // luminance
    h = (c <= 0) ? 0 :
        (mx === s3d_bgr) ? 60 * (s3d_bgg - s3d_bgb) / c :
        (mx === s3d_bgg) ? 60 * ((s3d_bgb - s3d_bgr) / c + 2) : 60 * ((s3d_bgr - s3d_bgg) / c + 4);
    (h < 0) ? h += 360;
    sp = min(1, c / 0.25);
    t = max(0, min(1, (l - 0.3) / 0.4)); t = t * t * (3 - 2 * t); // 0 : dark background, 1 : light
    // the grid : the background mixed with a green (neutral when the background is green), lighter or darker,
    // enough to have a difference of luminance of at least 0.35 ; lighter / darker : with a hysteresis, so that
    // a background varying around the middle does not make the grid flicker
    (!s3d_gdark && (l > 0.58)) ? (s3d_gdark = 1;) : (s3d_gdark && (l < 0.42)) ? (s3d_gdark = 0;);
    k = sp * max(0, 1 - abs(h - 120) / 60);
    !s3d_gdark ? (
        tr = 0.6 + 0.3 * k; tg = 1 - 0.1 * k; tb = 0.65 + 0.25 * k;
    ) : (
        tr = 0.05 * k; tg = 0.15 - 0.1 * k; tb = 0.05;
    );
    f = min(1, max(0.5, 0.35 / max(0.01, abs(0.299 * tr + 0.587 * tg + 0.114 * tb - l))));
    s3d_grr = s3d_bgr + f * (tr - s3d_bgr); s3d_grg = s3d_bgg + f * (tg - s3d_bgg); s3d_grb = s3d_bgb + f * (tb - s3d_bgb);
    !s3d_gdark ? (
        s3d_lbr = s3d_bgr + 0.45 * (1 - s3d_bgr); s3d_lbg = s3d_bgg + 0.45 * (1 - s3d_bgg);
        s3d_lbb = s3d_bgb + 0.45 * (1 - s3d_bgb);
    ) : (
        s3d_lbr = 0.45 * s3d_bgr; s3d_lbg = 0.45 * s3d_bgg; s3d_lbb = 0.45 * s3d_bgb;
    );
    // the cross : a hue between yellow (55) and blue (220), as far as possible from that of the background ;
    // on a grey background : yellow when dark, blue when light
    a = h + 180; (a >= 360) ? a -= 360;
    ((a >= 55) && (a <= 220)) ? (
        hc = a;
    ) : (
        d1 = abs(h - 55); d1 = min(d1, 360 - d1);
        d2 = abs(h - 220); d2 = min(d2, 360 - d2);
        hc = (d1 > d2) ? 55 : 220;
    );
    hc = sp * hc + (1 - sp) * (55 + 165 * t);
    s3d_hsv(hc, 0.85 + 0.15 * t, 1 - 0.4 * t);
    s3d_xr = s3d_cr; s3d_xg = s3d_cg; s3d_xb = s3d_cb;
    // the halo : an orange, moved away from the hue of the background when it is near
    d = h - 30; (d > 180) ? d -= 360; (d < -180) ? d += 360;
    s3d_hsv(30 + ((d > 0) ? -15 : 15) * max(0, 1 - abs(d) / 90) * sp, 0.9, 1 - 0.3 * t);
    s3d_hr = s3d_cr; s3d_hg = s3d_cg; s3d_hb = s3d_cb;
);


// The half width of the cross at the distance v (pixels, vertical) from its center : the vertical bar
// (a square of half side c at the center, widening obliquely to it from the half width w at a third of
// its half length vl, then pointed), or the horizontal arms (half length hl, the same profile) at this height
function s3d_xw(v, hl, vl, w, c)
local(f, b)
(
    v = abs(v);
    f = (v <= c) ? c : (v <= vl / 3) ? c + (w - c) * (v - c) / (vl / 3 - c) : (v < vl) ? 1.5 * w * (vl - v) / vl : -1;
    b = (v > c) ? -1 : (v > w) ? hl / 3 + (c - hl / 3) * (v - w) / (c - w) : hl - 2 * hl * v / (3 * w);
    max(f, b);
);


// A cross centered on (x, y) : horizontal bar of half length hl, vertical bar 2 times longer, half width w ;
// each bar : a pointed third at each end, a middle third widening obliquely towards the center.
// Drawn row by row (gfx_triangle leaves holes in thin triangles) : on each row the cross is one centered span,
// its coverage is computed on 4 sub-rows (antialiasing) ; color : gfx_r, gfx_g, gfx_b, opacity a
function s3d_cross(x, y, hl, w, a)
local(vl, c, j, j1, m0, m1, m2, m3, mn, mx, ia, ib, i, d)
(
    w = min(w, hl / 4);
    vl = 2 * hl;
    c = min(2 * w, 0.28 * hl); // half side of the center square
    j = floor(y - vl); j1 = floor(y + vl);
    while (j <= j1) (
        m0 = s3d_xw(j + 0.125 - y, hl, vl, w, c); m1 = s3d_xw(j + 0.375 - y, hl, vl, w, c);
        m2 = s3d_xw(j + 0.625 - y, hl, vl, w, c); m3 = s3d_xw(j + 0.875 - y, hl, vl, w, c);
        mn = min(min(m0, m1), min(m2, m3)); mx = max(max(m0, m1), max(m2, m3));
        (mx > 0) ? (
            // the pixels fully covered : one rectangle
            ia = ceil(x - mn); ib = floor(x + mn - 1);
            (ib >= ia) ? (
                gfx_a = a; gfx_rect(ia, j, ib - ia + 1, 1);
            ) : (
                ia = floor(x + 0.5); ib = ia - 1;
            );
            // the pixels of the edges : partial coverage
            i = floor(x - mx);
            while (i <= floor(x + mx)) (
                (i == ia) ? i = ib + 1;
                (i <= floor(x + mx)) ? (
                    d = abs(i + 0.5 - x) - 0.5;
                    gfx_a = a * 0.25 * (max(0, min(1, m0 - d)) + max(0, min(1, m1 - d))
                                      + max(0, min(1, m2 - d)) + max(0, min(1, m3 - d)));
                    (gfx_a > 0.002) ? gfx_rect(i, j, 1, 1);
                );
                i += 1;
            );
        );
        j += 1;
    );
);


// A halo of radius rd : opacity a at the center, decreasing linearly to 0 at the circumference
// (concentric discs, from the outside ; the color is set by the caller)
function s3d_halo(x, y, rd, a)
local(n, k, tp, tt)
(
    n = max(4, min(40, ceil(rd / 1.5)));
    tp = 0; k = 0;
    loop(n,
        tt = a * (k + 0.5) / n; // the opacity wanted inside this disc
        gfx_a = 1 - (1 - tt) / (1 - tp);
        gfx_circle(x, y, rd * (n - k) / n, 1, 1);
        tp = tt;
        k += 1;
    );
);


// A face of the room, normal to the axis ax (0 x, 1 y, 2 z), at s = -1 or +1
function s3d_face(ax, s)
local(i, t, lbl)
(
    gfx_set(s3d_grr, s3d_grg, s3d_grb, 1);
    i = 0;
    loop(s3d_GridN + 1,
        t = -1 + 2 * i / s3d_GridN;
        (ax === 0) ? (
            s3d_line(s, t, -1, s, t, 1); s3d_line(s, -1, t, s, 1, t);
        ) : (ax === 1) ? (
            s3d_line(t, s, -1, t, s, 1); s3d_line(-1, s, t, 1, s, t);
        ) : (
            s3d_line(t, -1, s, t, 1, s); s3d_line(-1, t, s, 1, t, s);
        );
        i += 1;
    );
    // the name of the face, at its center
    lbl = (ax === 0) ? ((s < 0) ? "L" : "R") : (ax === 1) ? ((s < 0) ? "Bk" : "F") : ((s < 0) ? "B" : "T");
    ((ax === 0) ? s3d_proj(s, 0, 0) : (ax === 1) ? s3d_proj(0, s, 0) : s3d_proj(0, 0, s)) ? (
        gfx_set(s3d_lbr, s3d_lbg, s3d_lbb, 0.8);
        gfx_measurestr(lbl, s3d_tw, s3d_th);
        gfx_x = s3d_px - s3d_tw / 2; gfx_y = s3d_py - s3d_th / 2;
        gfx_drawstr(lbl);
    );
);


// is the face (ax, s) a far face (seen from inside) ?
function s3d_farface(ax, s)
(
    s * ((ax === 0) ? s3d_cpx : (ax === 1) ? s3d_cpy : s3d_cpz) <= 0;
);


/*
    (2026-11-21) The presentations of the room (as the grids of the editors Edit A ... D, Espaces, whose drawing they
    were) : 0 Room (the far faces, their grid), 1 Planes (x = 0, y = 0, z = 0), 2 Axes (no grid), 3 Plane z (the plane
    z = zv, its square grid), 4 Polar z (the same, its circles and rays), 5 None (nothing, not even the axes) ; the axes
    over the grids (fainter over the room), an arrow at their end + 1. s3d_draw : s3d_PresCur (the option s3d_oBox off :
    None ; s3d_pres, the plane at the height s3d_presZ, set by the host)
*/
s3d_PresNames = "Room|Planes|Axes|Plane z|Polar z|None";

// The grid of the plane normal to the axis ax (0 x, 1 y, 2 z) at the coordinate c, limited to the room (the color is
// set ; the camera is set ; s3d_GridN lines)
function s3d_plane(ax, c)
local(i, t)
(
    i = 0;
    loop(s3d_GridN + 1,
        t = -1 + 2 * i / s3d_GridN;
        (ax === 0) ? (
            s3d_line(c, t, -1, c, t, 1); s3d_line(c, -1, t, c, 1, t);
        ) : (ax === 1) ? (
            s3d_line(t, c, -1, t, c, 1); s3d_line(-1, c, t, 1, c, t);
        ) : (
            s3d_line(t, -1, c, t, 1, c); s3d_line(-1, t, c, 1, t, c);
        );
        i += 1;
    );
);

// The polar grid of the plane z = c : the circles of radii k / d (k = 1 ... d), nr rays from the center, evenly spaced
// from the axis x (the color is set ; the camera is set)
function s3d_polar(c, d, nr)
local(k, j, r, a, ns, x0, y0, x1, y1)
(
    ns = 72; // (the segments of a circle)
    k = 1;
    loop(d,
        r = k / d;
        x0 = r; y0 = 0; j = 1;
        loop(ns,
            a = 2 * $pi * j / ns;
            x1 = r * cos(a); y1 = r * sin(a);
            s3d_line(x0, y0, c, x1, y1, c);
            x0 = x1; y0 = y1; j += 1;
        );
        k += 1;
    );
    j = 0;
    loop(nr,
        a = 2 * $pi * j / nr;
        s3d_line(0, 0, c, cos(a), sin(a), c);
        j += 1;
    );
);

// An arrow at the end +1 of an axis (ux, uy, uz : its unit vector), pointing outwards, and the name of the axis (the
// color is set ; the camera is set). An axis seen end-on : a ring, with a dot when its end +1 comes towards the eye,
// with a cross when it goes away.
function s3d_arrow(ux, uy, uz, lbl)
local(bx, by, bz, tx, ty, tz, dx, dy, d, l, cx, cy)
(
    s3d_proj(0.9 * ux, 0.9 * uy, 0.9 * uz) ? (
        bx = s3d_px; by = s3d_py; bz = s3d_pz;
        s3d_proj(ux, uy, uz) ? (
            tx = s3d_px; ty = s3d_py; tz = s3d_pz;
            dx = tx - bx; dy = ty - by; d = sqrt(dx * dx + dy * dy); // (the last tenth of the axis, on the screen)
            gfx_measurestr(lbl, s3d_tw, s3d_th);
            (d > 0.6) ? (
                l = min(11, 8 * d); dx /= d; dy /= d;
                cx = tx - dx * l; cy = ty - dy * l; // the base of the head, its tip at the end of the axis
                gfx_triangle(tx, ty, cx - dy * l * 0.45, cy + dx * l * 0.45, cx + dy * l * 0.45, cy - dx * l * 0.45);
                gfx_x = tx + dx * 9 - s3d_tw / 2; gfx_y = ty + dy * 9 - s3d_th / 2;
            ) : (
                gfx_circle(tx, ty, 5, 0, 1);
                (tz < bz) ? (
                    gfx_circle(tx, ty, 1.5, 1, 1);
                ) : (
                    gfx_line(tx - 3, ty - 3, tx + 3, ty + 3, 1); gfx_line(tx - 3, ty + 3, tx + 3, ty - 3, 1);
                );
                gfx_x = tx + 8; gfx_y = ty - 6 - s3d_th;
            );
            gfx_drawstr(lbl);
        );
    );
);

// The presentation g (0 ... 5) : zv the height of the plane z, div the squares per unit (the step 1 / div ; Polar z :
// the circles of radii k / div), nr the rays of Polar z (the camera is set ; the colors : s3d_colors)
function s3d_grids(g, zv, div, nr)
local(gn, ax, sg, aa)
(
    gn = s3d_GridN; s3d_GridN = 2 * div;
    (g === 0) ? (
        // the far faces of the room, their grid
        ax = 0;
        loop(3,
            sg = -1;
            loop(2, s3d_farface(ax, sg) ? s3d_face(ax, sg); sg += 2;);
            ax += 1;
        );
    ) : (g === 1) ? (
        // the planes x = 0, y = 0, z = 0
        gfx_set(0.55, 0.78, 1, 0.3);
        s3d_plane(0, 0); s3d_plane(1, 0); s3d_plane(2, 0);
    ) : ((g === 3) || (g === 4)) ? (
        // the plane z = zv : its square grid, or its circles and rays (Polar z)
        gfx_set(1, 0.85, 0.2, 0.5);
        (g === 3) ? s3d_plane(2, zv) : s3d_polar(zv, div, nr);
    ); // (Axes : no grid)
    (g <= 4) ? (
        // the axes, over the grid, an arrow at their end +1
        aa = (g === 0) ? 0.6 : 0.95;
        gfx_set(0.85, 0.3, 0.3, aa); s3d_line(-1, 0, 0, 1, 0, 0); s3d_arrow(1, 0, 0, "x");
        gfx_set(0.3, 0.8, 0.3, aa); s3d_line(0, -1, 0, 0, 1, 0); s3d_arrow(0, 1, 0, "y");
        gfx_set(0.35, 0.5, 1, aa); s3d_line(0, 0, -1, 0, 0, 1); s3d_arrow(0, 0, 1, "z");
        // Plane z, Polar z : where the axis z crosses the plane, a green dot
        ((g >= 3) && s3d_proj(0, 0, zv)) ? (gfx_set(0.3, 0.95, 0.3, 1); gfx_circle(s3d_px, s3d_py, 2, 1, 1););
    );
    s3d_GridN = gn;
);

// The presentation shown by s3d_draw : None when the option s3d_oBox is off (as before 2026-11-21, "Display Box"
// unchecked) ; s3d_PresSet : it becomes k (None : the option off)
function s3d_PresCur()
(
    !(s3d_opt & s3d_oBox) ? 5 : ((s3d_pres >= 0) && (s3d_pres < 5)) ? 0|s3d_pres : 0;
);
function s3d_PresSet(k)
(
    k = max(0, min(5, 0|k));
    s3d_pres = k;
    s3d_opt = (k === 5) ? (s3d_opt & (0x7FFFFFFF - s3d_oBox)) : (s3d_opt | s3d_oBox);
);


// The shadow of a point on the far face (ax, s) : a disc of radius r in the plane of the face
function s3d_disc(ax, s, x, y, z, r)
local(k, a, u, v, ok, p)
(
    ok = 1; k = 0;
    loop(12,
        a = 2 * $pi * k / 12; u = r * cos(a); v = r * sin(a);
        ok && ((ax === 0) ? s3d_proj(s, y + u, z + v) : (ax === 1) ? s3d_proj(x + u, s, z + v) : s3d_proj(x + u, y + v, s)) ? (
            s3d_poly[2*k] = s3d_px; s3d_poly[2*k+1] = s3d_py;
        ) : (
            ok = 0; // behind the camera
        );
        k += 1;
    );
    ok ? (
        p = s3d_poly;
        gfx_triangle(p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], p[9], p[10], p[11],
                     p[12], p[13], p[14], p[15], p[16], p[17], p[18], p[19], p[20], p[21], p[22], p[23]);
    );
);


// Draw the label of an object, at the right of the ball
function s3d_label(x, y, r, str)
(
    gfx_measurestr(str, s3d_tw, s3d_th);
    gfx_x = x + r + 3; gfx_y = y - s3d_th / 2;
    gfx_drawstr(str);
);


// Draw an object of the sorted list
function s3d_object(id)
local(ty, k, e, r, r0, rb, hl, g, fa, x, y)
(
    ty = (id / 1024) | 0; k = id - ty * 1024;
    e = (ty === s3d_tSpk) ? s3d_spk + k * s3d_st : s3d_src + k * s3d_st;
    x = e[s3d_fsx]; y = e[s3d_fsy];
    fa = s3d_fade(e[s3d_fsz]);
    (ty === s3d_tSpk) ? (
        rb = 0.035 * s3d_foc / e[s3d_fsz]; // (the size of the ball by default : that of the crosses)
        r0 = rb * s3d_kSpk;
        s3d_ball(x, y, r0, 1, 0.75, 0.05, fa);
        hl = 0; // half length of the cross
        g = e[s3d_fg];
        ((s3d_opt & s3d_oGains) && (g > 0.001)) ? (
            s3d_style ? (
                // a cross over the ball, more opaque for the higher gains
                hl = max(6, 3 * rb) * s3d_kX;
                gfx_set(s3d_xr, s3d_xg, s3d_xb, 1);
                s3d_cross(x, y, hl, max(1.5, 0.1 * hl), (0.45 + 0.55 * min(1, g)) * fa);
            ) : (
                r = (0.04 + 0.16 * min(1, g)) * s3d_foc / e[s3d_fsz] * s3d_kX;
                s3d_ball(x, y, r, 0.1, 0.35, 1, 0.75 * fa);
            );
        );
        g = min(1, e[s3d_fl]);
        ((s3d_opt & s3d_oLevels) && (g > 0.001)) ? (
            s3d_style ? (
                // a halo over the cross (translucent) ; the 4th power of the level marks more the differences
                gfx_set(s3d_hr, s3d_hg, s3d_hb, 1);
                s3d_halo(x, y, (0.08 + 1.92 * sqr(sqr(g))) * s3d_foc / e[s3d_fsz], s3d_haloA * fa);
            ) : (
                r = (0.04 + 0.16 * min(1, g)) * s3d_foc / e[s3d_fsz];
                s3d_ball(x, y, r, 0.2, 1, 0.3, 0.6 * fa);
            );
        );
        (s3d_opt & (s3d_oInfos | s3d_oAllInfos)) ? (
            gfx_set(s3d_txr, s3d_txg, s3d_txb, 0.9 * fa);
            ((s3d_opt & s3d_oAllInfos) && (e[s3d_fg] > 0.00001)) ? (
                sprintf(#s3d_lbl, "%d  %.1f dB", k + 1, 20 * log10(e[s3d_fg]));
            ) : (
                sprintf(#s3d_lbl, "%d", k + 1);
            );
            s3d_label(x, y, max(r0, hl), #s3d_lbl);
        );
    ) : (
        r = 0.03 * s3d_foc / e[s3d_fsz] * s3d_kSrc;
        s3d_ball(x, y, r, 0.1, 0.85, 1, fa);
        (s3d_opt & (s3d_oInfos | s3d_oAllInfos)) ? (
            gfx_set(0.7, 0.95, 1, 0.9 * fa);
            sprintf(#s3d_lbl, "%d", k + 1);
            s3d_label(x, y, r, #s3d_lbl);
        );
    );
);


// The selected object : axes through it, and its coordinates
function s3d_selection()
local(ty, k, e, x, y, z, d, x0)
(
    (s3d_sel >= 0) ? (
        ty = (s3d_sel / 1024) | 0; k = s3d_sel - ty * 1024;
        ((ty === s3d_tSpk) && (k < s3d_nspk)) || ((ty === s3d_tSrc) && (k < s3d_nsrc) && !(s3d_opt & s3d_oHideSrc)) ? (
            e = (ty === s3d_tSpk) ? s3d_spk + k * s3d_st : s3d_src + k * s3d_st;
            x = e[s3d_fx]; y = e[s3d_fy]; z = e[s3d_fz];
            d = 0.15;
            gfx_set(1, 0.9, 0.7, 0.9);
            s3d_line(x - d, y, z, x + d, y, z);
            s3d_line(x, y - d, z, x, y + d, z);
            s3d_line(x, y, z - d, x, y, z + d);
            s3d_proj(x, y, z) ? (
                gfx_set(s3d_txr, s3d_txg, s3d_txb, 1);
                x0 = s3d_px + 12; gfx_y = s3d_py + 8;
                gfx_measurestr("0", s3d_tw, s3d_th);
                sprintf(#s3d_lbl, "%s %d", (ty === s3d_tSpk) ? "speaker" : "source", k + 1);
                gfx_x = x0; gfx_drawstr(#s3d_lbl); gfx_y += s3d_th;
                sprintf(#s3d_lbl, "x : %.2f", x); gfx_x = x0; gfx_drawstr(#s3d_lbl); gfx_y += s3d_th;
                sprintf(#s3d_lbl, "y : %.2f", y); gfx_x = x0; gfx_drawstr(#s3d_lbl); gfx_y += s3d_th;
                sprintf(#s3d_lbl, "z : %.2f", z); gfx_x = x0; gfx_drawstr(#s3d_lbl); gfx_y += s3d_th;
                (ty === s3d_tSpk) ? (
                    sprintf(#s3d_lbl, "g : %.3f", e[s3d_fg]); gfx_x = x0; gfx_drawstr(#s3d_lbl);
                );
            );
        ) : (
            s3d_sel = -1;
        );
    );
);


// Project the speakers and the sources, and sort them : far objects first
function s3d_sort()
local(n, k, e, i, j, kk, ki)
(
    n = 0;
    k = 0;
    loop(s3d_nspk,
        e = s3d_spk + k * s3d_st;
        e[s3d_fsz] = 0;
        s3d_proj(e[s3d_fx], e[s3d_fy], e[s3d_fz]) ? (
            e[s3d_fsx] = s3d_px; e[s3d_fsy] = s3d_py; e[s3d_fsz] = s3d_pz;
            s3d_okey[n] = s3d_pz; s3d_oid[n] = s3d_tSpk * 1024 + k; n += 1;
        );
        k += 1;
    );
    k = 0;
    loop(s3d_nsrc,
        e = s3d_src + k * s3d_st;
        e[s3d_fsz] = 0; // (hidden sources : not drawn, nor picked)
        (!(s3d_opt & s3d_oHideSrc) && s3d_proj(e[s3d_fx], e[s3d_fy], e[s3d_fz])) ? (
            e[s3d_fsx] = s3d_px; e[s3d_fsy] = s3d_py; e[s3d_fsz] = s3d_pz;
            s3d_okey[n] = s3d_pz; s3d_oid[n] = s3d_tSrc * 1024 + k; n += 1;
        );
        k += 1;
    );
    // insertion sort, decreasing depth
    i = 1;
    loop(max(0, n - 1),
        kk = s3d_okey[i]; ki = s3d_oid[i];
        j = i - 1;
        while ((j >= 0) && (s3d_okey[j] < kk)) (
            s3d_okey[j+1] = s3d_okey[j]; s3d_oid[j+1] = s3d_oid[j];
            j -= 1;
        );
        s3d_okey[j+1] = kk; s3d_oid[j+1] = ki;
        i += 1;
    );
    s3d_nobj = n;
);


function s3d_draw(x, y, w, h)
local(k, e, ax, s, p, q, r, od, bx, by, bz)
(
    od = gfx_dest;
    w = max(16, w|0); h = max(16, h|0);
    ((w != s3d_iw) || (h != s3d_ih)) ? (
        gfx_setimgdim(s3d_img, w, h);
        s3d_iw = w; s3d_ih = h;
    );
    gfx_dest = s3d_img;
    gfx_mode = 0;
    gfx_set(s3d_bgr, s3d_bgg, s3d_bgb, 1);
    gfx_rect(0, 0, w, h);
    s3d_colors();
    s3d_camera(w, h);

    // the stars
    (s3d_opt & s3d_oStars) ? (
        k = 0;
        loop(s3d_StarsNb,
            e = s3d_stars + 4 * k;
            s3d_proj(s3d_cpx + e[0], s3d_cpy + e[1], s3d_cpz + e[2]) ? (
                gfx_set(1, 1, 1, e[3]);
                gfx_rect(s3d_px, s3d_py, 1 + (e[3] > 0.85), 1 + (e[3] > 0.85));
            );
            k += 1;
        );
    );

    // the room : its presentation (2026-11-21 : the far faces, the planes, the axes, the plane z ... ; s3d_grids)
    s3d_grids(s3d_PresCur(), s3d_presZ, 6, 24);

    // projection on the far faces (as GRM Spaces) : the shadows of the sources,
    // and lines from the barycenter of the sources to the faces
    ((s3d_opt & s3d_oProj) && (s3d_nsrc > 0) && !(s3d_opt & s3d_oHideSrc)) ? (
        bx = by = bz = 0;
        k = 0;
        loop(s3d_nsrc,
            e = s3d_src + k * s3d_st;
            bx += e[s3d_fx]; by += e[s3d_fy]; bz += e[s3d_fz];
            ax = 0;
            loop(3,
                s = -1;
                loop(2,
                    s3d_farface(ax, s) ? (
                        gfx_set(0.1, 0.25, 0.45, 0.7 * s3d_fade(s3d_dist));
                        s3d_disc(ax, s, e[s3d_fx], e[s3d_fy], e[s3d_fz], 0.035);
                    );
                    s += 2;
                );
                ax += 1;
            );
            k += 1;
        );
        bx /= s3d_nsrc; by /= s3d_nsrc; bz /= s3d_nsrc;
        ax = 0;
        loop(3,
            s = -1;
            loop(2,
                s3d_farface(ax, s) ? (
                    gfx_set(0.6, 0.6, 0.65, 0.8);
                    (ax === 0) ? s3d_line(bx, by, bz, s, by, bz) :
                    (ax === 1) ? s3d_line(bx, by, bz, bx, s, bz) : s3d_line(bx, by, bz, bx, by, s);
                    ((ax === 0) ? s3d_proj(s, by, bz) : (ax === 1) ? s3d_proj(bx, s, bz) : s3d_proj(bx, by, s)) ? (
                        gfx_set(0.2, 0.45, 0.75, 1);
                        gfx_circle(s3d_px, s3d_py, 2.5, 1, 1);
                    );
                );
                s += 2;
            );
            ax += 1;
        );
    );

    // the trajectory
    ((s3d_opt & s3d_oTraj) && (s3d_ntrj > 1)) ? (
        s3d_plmode ? gfx_set(1, 0.78, 0.15, 0.95) : gfx_set(0.95, 0.1, 0.1, 0.9); // (a placement : gold)
        k = 0;
        loop(s3d_ntrj - 1 + (s3d_trjclosed != 0),
            p = s3d_trj + 3 * k;
            q = s3d_trj + 3 * ((k + 1) % s3d_ntrj);
            s3d_line(p[0], p[1], p[2], q[0], q[1], q[2]);
            k += 1;
        );
    );

    // speakers and sources, far objects first
    s3d_sort();
    // the group center : drawn with the objects behind it
    k = 0;
    r = s3d_gon && !(s3d_opt & s3d_oHideSrc) && s3d_proj(s3d_gx, s3d_gy, s3d_gz);
    p = s3d_px; q = s3d_py; s = s3d_pz;
    loop(s3d_nobj,
        (r && (s3d_okey[k] < s)) ? (
            s3d_ball(p, q, 0.012 * s3d_foc / s * s3d_kSrc, 0.1, 0.75, 1, s3d_fade(s));
            r = 0;
        );
        s3d_object(s3d_oid[k]);
        k += 1;
    );
    r ? s3d_ball(p, q, 0.012 * s3d_foc / s * s3d_kSrc, 0.1, 0.75, 1, s3d_fade(s));

    s3d_selection();

    // (2026-11-21) a placement : its pivot (the barycentre of the trajectory placed, given by the host), a red cross
    (s3d_plmode && s3d_pvOn && s3d_proj(s3d_pvx, s3d_pvy, s3d_pvz)) ? (
        r = 7;
        gfx_set(0, 0, 0, 0.7);
        gfx_rect(s3d_px - r - 1, s3d_py - 2, 2 * r + 3, 5); gfx_rect(s3d_px - 2, s3d_py - r - 1, 5, 2 * r + 3);
        gfx_set(1, 0.1, 0.1, 1);
        gfx_rect(s3d_px - r, s3d_py - 1, 2 * r + 1, 3); gfx_rect(s3d_px - 1, s3d_py - r, 3, 2 * r + 1);
    );

    // the value changed by the current drag (a placement : the line #s3d_plLbl written by the host)
    (s3d_plmode && (s3d_dmode >= 2) && ((s3d_dmode <= 4) || (s3d_dmode === 8) || (s3d_dmode === 9))) ? (
        gfx_set(1, 0.85, 0.4, 1);
        gfx_x = 10; gfx_y = 8;
        gfx_drawstr(#s3d_plLbl);
    ) :
    (s3d_dmode >= 4) ? (
        (s3d_dmode === 9) ? sprintf(#s3d_lbl, "Position x %.2f  y %.2f  z %.2f", s3d_ttx, s3d_tty, s3d_ttz) :
        (s3d_dmode === 4) ? sprintf(#s3d_lbl, "Size x %.2f", s3d_tsc) :
        (s3d_dmode === 5) ? sprintf(#s3d_lbl, "Speed %.2f turns / min", s3d_speed) :
        (s3d_dmode === 7) ? sprintf(#s3d_lbl, "Sources : size x %.2f   yaw %d   pitch %d   roll %d",
                                    s3d_gsc, floor(s3d_gyaw * 180 / $pi + 0.5),
                                    floor(s3d_gpitch * 180 / $pi + 0.5), floor(s3d_groll * 180 / $pi + 0.5)) :
        sprintf(#s3d_lbl, "Mix A-B %d %%", floor(s3d_mix * 100 + 0.5));
        gfx_set(1, 0.85, 0.4, 1);
        gfx_x = 10; gfx_y = 8;
        gfx_drawstr(#s3d_lbl);
    );

    // copy to the screen (or to the ui-lib clip screen)
    gfx_dest = od;
    gfx_x = x; gfx_y = y;
    gfx_a = 1; gfx_mode = 2; // ignore the alpha of the image
    gfx_blit(s3d_img, 1, 0);
    gfx_mode = 0;
);


// Select the nearest object under the mouse (mx, my relative to the view)
function s3d_pick(mx, my)
local(k, e, d, bd)
(
    s3d_sel = -1; bd = 100; // squared distance max : 10 pixels
    k = 0;
    loop(s3d_nspk,
        e = s3d_spk + k * s3d_st;
        (e[s3d_fsz] > 0) && ((d = sqr(e[s3d_fsx] - mx) + sqr(e[s3d_fsy] - my)) < bd) ? (
            bd = d; s3d_sel = s3d_tSpk * 1024 + k;
        );
        k += 1;
    );
    k = 0;
    loop(s3d_nsrc,
        e = s3d_src + k * s3d_st;
        (e[s3d_fsz] > 0) && ((d = sqr(e[s3d_fsx] - mx) + sqr(e[s3d_fsy] - my)) < bd) ? (
            bd = d; s3d_sel = s3d_tSrc * 1024 + k;
        );
        k += 1;
    );
);


// The sizes (2026-11-18) : the factor i (0 ... s3d_kN - 1) : x 0.25 ... x 4 ; 2026-11-19 : 25 values (finer), by steps
// of 2^(1/6) (about 12 %), i = 12 : 1 (the 9 values before, by steps of sqrt(2), are among them)
s3d_kN = 25;
function s3d_kval(i)
(
    2 ^ ((i - 12) / 6);
);
// the sub-menu "title" of a size (the factor cur checked), added to #s3d_mnu
function s3d_kmenu(title, cur)
local(i, v)
(
    strcat(#s3d_mnu, "|>"); strcat(#s3d_mnu, title);
    i = 0;
    loop(s3d_kN,
        v = s3d_kval(i);
        sprintf(#s3d_kit, "|%s%sx %.2f", (i === s3d_kN - 1) ? "<" : "", (abs(cur - v) < 0.001) ? "!" : "", v);
        strcat(#s3d_mnu, #s3d_kit);
        i += 1;
    );
);

function s3d_menu()
local(c, b, k, v, g)
(
    // (2026-11-21) items 1 ... 5 the options (1 = bit 1 s3d_oGains, 2 = s3d_oHideSrc inverted : checked when not set,
    // 3 ... 5 = bit 2^(item-2)) ; 6 ... 11 the presentations (s3d_PresSet, a sub-menu) ; 12 ... 16 the options (bit
    // 2^(item-7) : s3d_oProj ... s3d_oClamp) ; 17 ... 20 the views (as the cell View of Espaces) ; 21 the levelling
    // (s3d_level) ; 22 ... 21 + 3 * s3d_kN : the sizes of the speakers, of the sources, of the crosses (s3d_kmenu) ;
    // the keys of the views of Espaces in parentheses
    g = s3d_PresCur();
    sprintf(#s3d_mnu, "%sDisplay Diffusers|%sDisplay Source|%sDisplay Levels|%sDisplay Infos|%sDisplay All Infos||>Presentation of the room (>)|%sThe far faces of the room|%sThe planes x = 0, y = 0, z = 0|%sThe axes only|%sThe plane z = %.2f|%sThe circles of the plane z = %.2f (polar)|<%sNothing (no axes)|",
        (s3d_opt & s3d_oGains) ? "!" : "", (s3d_opt & s3d_oHideSrc) ? "" : "!", (s3d_opt & s3d_oLevels) ? "!" : "",
        (s3d_opt & s3d_oInfos) ? "!" : "", (s3d_opt & s3d_oAllInfos) ? "!" : "",
        (g === 0) ? "!" : "", (g === 1) ? "!" : "", (g === 2) ? "!" : "", (g === 3) ? "!" : "", s3d_presZ,
        (g === 4) ? "!" : "", s3d_presZ, (g === 5) ? "!" : "");
    sprintf(#s3d_kit, "%sProjection on planes|%sFade out|%sStarfield|%sDisplay Trajectory (x)||%sLimit to the room (w)||Front view|Side view|Top view|3D view (v : the next one)|Level the view (a)|",
        (s3d_opt & s3d_oProj) ? "!" : "", (s3d_opt & s3d_oFade) ? "!" : "", (s3d_opt & s3d_oStars) ? "!" : "",
        (s3d_opt & s3d_oTraj) ? "!" : "", (s3d_opt & s3d_oClamp) ? "!" : "");
    strcat(#s3d_mnu, #s3d_kit);
    s3d_kmenu("Size of the speakers", s3d_kSpk);
    s3d_kmenu("Size of the sources", s3d_kSrc);
    s3d_kmenu("Size of the crosses (gains)", s3d_kX);
    gfx_x = mouse_x; gfx_y = mouse_y;
    c = gfx_showmenu(#s3d_mnu); s3d_mres = c; // (the result, for the host : e.g. uix_menu_end of ui-lib)
    (((c >= 1) && (c <= 5)) || ((c >= 12) && (c <= 16))) ? (
        b = (c === 1) ? s3d_oGains : (c === 2) ? s3d_oHideSrc : (c <= 5) ? 2 ^ (c - 2) : 2 ^ (c - 7);
        s3d_opt = (s3d_opt & b) ? s3d_opt - b : s3d_opt + b;
    ) :
    ((c >= 6) && (c <= 11)) ? s3d_PresSet(c - 6) :
    (c === 17) ? (s3d_az = 0; s3d_el = 0; s3d_roll = 0;) :           // front
    (c === 18) ? (s3d_az = $pi / 2; s3d_el = 0; s3d_roll = 0;) :     // side
    (c === 19) ? (s3d_az = 0; s3d_el = 1.55; s3d_roll = 0;) :        // top
    (c === 20) ? (s3d_az = s3d_Az3D; s3d_el = s3d_El3D; s3d_dist = s3d_Dist3D; s3d_roll = 0;) :
    (c === 21) ? s3d_level() :
    ((c >= 22) && (c < 22 + 3 * s3d_kN)) ? (
        k = c - 22; v = s3d_kval(k % s3d_kN);
        (k < s3d_kN) ? s3d_kSpk = v : (k < 2 * s3d_kN) ? s3d_kSrc = v : s3d_kX = v;
    );
    (c > 0) ? s3d_changed = 1;
);


// (2026-11-21) A placement (s3d_plmode) : the trajectory placed is then transformed by that of the whole path (the
// parent, given by the host : its size s3d_pgs, its tilt around x s3d_pgrx, its rotation around z s3d_pgrz : G =
// Rz Rx). s3d_plvec : the vector (x, y, z) of the room into the frame of the placement (G^-1, divided by the size when
// sc) : s3d_qx, s3d_qy, s3d_qz
function s3d_plvec(x, y, z, sc)
local(c, s, a)
(
    c = cos(s3d_pgrz); s = sin(s3d_pgrz);
    a = x * c + y * s; y = - x * s + y * c; x = a;
    c = cos(s3d_pgrx); s = sin(s3d_pgrx);
    a = y * c + z * s; z = - y * s + z * c; y = a;
    sc ? (a = 1 / max(0.01, s3d_pgs); x *= a; y *= a; z *= a;);
    s3d_qx = x; s3d_qy = y; s3d_qz = z;
);
// an angle (a choice of the Euler angles) brought near the old one (by turns), within +- 2 pi
function s3d_angnear(a, old)
(
    a += 2 * $pi * floor((old - a) / (2 * $pi) + 0.5);
    max(-2 * $pi, min(2 * $pi, a));
);
// The placement turned by t around the unit axis (kx, ky, kz) of the room, as held in the hand : its rotation R = Rz Ry
// Rx (s3d_trz, s3d_try, s3d_trx, as sp_TpBlend) becomes Q' R, Q' the rotation around the axis seen in the frame of the
// placement (G^-1 k) ; its angles again (of the two choices, the nearest to the old ones)
function s3d_plrot(kx, ky, kz, t)
local(cx, sx, cy, sy, cz, sz, r0, r1, r3, r4, r6, r7, r2, r5, r8, c, s, u, a, b, d, q00, q01, q02, q10, q11, q12, q20, q21, q22,
      m0, m1, m3, m4, m6, m7, m8, ex, ey, ez, fx, fy, fz)
(
    s3d_plvec(kx, ky, kz, 0); a = s3d_qx; b = s3d_qy; d = s3d_qz;
    cx = cos(s3d_trx); sx = sin(s3d_trx); cy = cos(s3d_try); sy = sin(s3d_try); cz = cos(s3d_trz); sz = sin(s3d_trz);
    r0 = cz * cy; r1 = cz * sy * sx - sz * cx; r2 = cz * sy * cx + sz * sx;
    r3 = sz * cy; r4 = sz * sy * sx + cz * cx; r5 = sz * sy * cx - cz * sx;
    r6 = - sy;    r7 = cy * sx;                r8 = cy * cx;
    c = cos(t); s = sin(t); u = 1 - c;
    q00 = c + a * a * u;     q01 = a * b * u - d * s; q02 = a * d * u + b * s;
    q10 = a * b * u + d * s; q11 = c + b * b * u;     q12 = b * d * u - a * s;
    q20 = a * d * u - b * s; q21 = b * d * u + a * s; q22 = c + d * d * u;
    m0 = q00 * r0 + q01 * r3 + q02 * r6; m1 = q00 * r1 + q01 * r4 + q02 * r7;
    m3 = q10 * r0 + q11 * r3 + q12 * r6; m4 = q10 * r1 + q11 * r4 + q12 * r7;
    m6 = q20 * r0 + q21 * r3 + q22 * r6; m7 = q20 * r1 + q21 * r4 + q22 * r7; m8 = q20 * r2 + q21 * r5 + q22 * r8;
    ey = asin(max(-1, min(1, - m6)));
    (cos(ey) > 0.000001) ? (
        ex = atan2(m7, m8); ez = atan2(m3, m0);
    ) : (
        ex = 0; ez = atan2(- m1, m4);
    );
    // the other choice (x + pi, pi - y, z + pi) ; the nearest one to the old angles
    fx = s3d_angnear(ex + $pi, s3d_trx); fy = s3d_angnear($pi - ey, s3d_try); fz = s3d_angnear(ez + $pi, s3d_trz);
    ex = s3d_angnear(ex, s3d_trx); ey = s3d_angnear(ey, s3d_try); ez = s3d_angnear(ez, s3d_trz);
    ((abs(fx - s3d_trx) + abs(fy - s3d_try) + abs(fz - s3d_trz)) < (abs(ex - s3d_trx) + abs(ey - s3d_try) + abs(ez - s3d_trz))) ? (
        ex = fx; ey = fy; ez = fz;
    );
    s3d_trx = ex; s3d_try = ey; s3d_trz = ez;
);

// Mouse : left drag = orbit (2026-11-21 : as held in the hand, s3d_orbit), left click = select, wheel = zoom, right
// click = menu (2026-11-13 : opened when the button is released, inside the view : a menu opened at the press leaves
// the right button "down" in mouse_cap). The drags follow the screen (2026-11-21) : the side near the eye follows the
// mouse. The buttons : mouse_cap, or s3d_mcap given by the host when s3d_hostcap is set (e.g. without the "ghost"
// buttons of ui-lib : uix_mouse_cap) ; s3d_menued : the menu was shown in this call (the host may end it : e.g.
// uix_menu_end(s3d_mres > 0)). The levelling of the camera s3d_camId goes on here (s3d_LevelStep).
function s3d_mouse(x, y, w, h, wheel)
local(mx, my, inside, used, dx, dy, f, v, b, sg)
(
    used = 0; s3d_menued = 0;
    (v = s3d_LevelStep(s3d_camId)) ? (s3d_roll -= v; s3d_changed = 1;);
    b = s3d_hostcap ? s3d_mcap : mouse_cap;
    mx = mouse_x - x; my = mouse_y - y;
    inside = (mx >= 0) && (my >= 0) && (mx < w) && (my < h);
    (b & 1) ? (
        (s3d_mdown === 0) ? (
            inside ? (
                s3d_mdown = 1; s3d_moved = 0;
                s3d_mx0 = s3d_lmx = mouse_x; s3d_my0 = s3d_lmy = mouse_y;
            ) : (
                s3d_mdown = -1; // pressed outside of the view
            );
        ) : (s3d_mdown === 1) ? (
            (abs(mouse_x - s3d_mx0) + abs(mouse_y - s3d_my0) > 3) ? s3d_moved = 1;
            s3d_moved ? (
                dx = mouse_x - s3d_lmx; dy = mouse_y - s3d_lmy;
                s3d_basis(); // (the camera : the drags follow the screen)
                (((mouse_cap & 20) === 20) && s3d_plmode) ? (
                    // a placement (s3d_plmode, set by the host) : Cmd + Alt = turned in the plane of the screen
                    // (horizontal : clockwise to the right)
                    s3d_dmode = 8;
                    s3d_plrot(s3d_fwx, s3d_fwy, s3d_fwz, dx * 0.01);
                    s3d_tchanged = 1;
                ) : ((mouse_cap & 20) === 20) ? (
                    // Cmd + Alt : speed ; quadratic scale, fine near 0
                    v = sign(s3d_speed) * sqrt(abs(s3d_speed) / 240);
                    v = max(-1, min(1, v + dx * 0.002));
                    s3d_speed = 240 * sign(v) * v * v;
                    s3d_dmode = 5;
                ) : ((mouse_cap & 12) === 12) ? (
                    // Cmd + Shift : mix of the trajectories A and B
                    s3d_mix = max(0, min(1, s3d_mix + dx * 0.003));
                    s3d_dmode = 6;
                ) : (s3d_mtarget && !s3d_plmode && (mouse_cap & 28)) ? (
                    // the group of sources
                    s3d_dmode = 7;
                    (mouse_cap & 8) ? (
                        s3d_gsc = max(0.05, min(10, s3d_gsc * exp(- dy * 0.01)));
                    ) : (mouse_cap & 4) ? (
                        s3d_gyaw -= dx * 0.01;
                        s3d_gpitch = max(-$pi, min($pi, s3d_gpitch + dy * 0.01));
                    ) : (
                        s3d_groll = max(-$pi, min($pi, s3d_groll + dx * 0.01));
                    );
                    s3d_gyaw -= 2 * $pi * floor((s3d_gyaw + $pi) / (2 * $pi));
                ) : (mouse_cap & 16) ? (
                    // Alt : translate the trajectory, in the plane of the screen ; Shift + Alt (2026-11-21) : in depth,
                    // along the line of sight (vertical : up = farther) ; a placement : in its frame (s3d_plvec : it
                    // follows the mouse, whatever the transform of the whole path)
                    (mouse_cap & 8) ? (
                        s3d_dmode = 9;
                        f = - dy * 0.005;
                        s3d_qx = f * s3d_fwx; s3d_qy = f * s3d_fwy; s3d_qz = f * s3d_fwz;
                    ) : (
                        s3d_dmode = 2;
                        f = s3d_dist / s3d_foc;
                        s3d_qx = f * (dx * s3d_rgx - dy * s3d_upx);
                        s3d_qy = f * (dx * s3d_rgy - dy * s3d_upy);
                        s3d_qz = f * (dx * s3d_rgz - dy * s3d_upz);
                    );
                    s3d_plmode ? s3d_plvec(s3d_qx, s3d_qy, s3d_qz, 1);
                    s3d_ttx = max(-4, min(4, s3d_ttx + s3d_qx));
                    s3d_tty = max(-4, min(4, s3d_tty + s3d_qy));
                    s3d_ttz = max(-4, min(4, s3d_ttz + s3d_qz));
                    s3d_tchanged = 1;
                ) : (mouse_cap & 4) ? (
                    s3d_dmode = 3;
                    s3d_plmode ? (
                        // a placement (2026-11-21) : turned as held in the hand (horizontal : around the vertical of
                        // the screen ; vertical : around its horizontal), its three inclinations together
                        s3d_plrot(s3d_upx, s3d_upy, s3d_upz, dx * 0.01);
                        s3d_plrot(s3d_rgx, s3d_rgy, s3d_rgz, dy * 0.01);
                    ) : (
                        // Cmd : rotate the trajectory (horizontal : around z ; vertical : tilt around its x), the side
                        // near the eye following the mouse (2026-11-21 : the senses given by the camera)
                        sg = (s3d_upz < 0) ? -1 : 1;
                        s3d_trz += sg * dx * 0.01;
                        sg = ((cos(s3d_trz) * s3d_rgx + sin(s3d_trz) * s3d_rgy) < 0) ? -1 : 1;
                        s3d_trx = max(-$pi, min($pi, s3d_trx + sg * dy * 0.01));
                    );
                    s3d_tchanged = 1;
                ) : (mouse_cap & 8) ? (
                    s3d_dmode = 4;
                    // Shift : size of the trajectory
                    s3d_tsc = max(0.05, min(10, s3d_tsc * exp(- dy * 0.01)));
                    s3d_tchanged = 1;
                ) : (
                    // the orbit, as held in the hand
                    s3d_dmode = 1;
                    s3d_orbit(dx, dy);
                );
            );
            s3d_lmx = mouse_x; s3d_lmy = mouse_y;
        );
