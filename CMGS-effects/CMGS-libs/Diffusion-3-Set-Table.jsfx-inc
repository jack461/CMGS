// The mSL "settings" (opcode 118, see the evaluator ; until 2026-11-18 "table", still a synonym) : a data block, or the
// words given as arguments (mSL_stArgs, its word -1 : their count) ; returns 0, or the first error
function Set_Table(tbl)
(
    // (2026-11-21) a block GUI of its own : the rubric GUI (mSL_GUI) ; otherwise the settings of Diffusion-3, where a part
    // GUI may be in any place (d3_Settings, state 1)
    // (2026-11-22 : GUI first and a word that is not a block of Diffusion-3 after its keys : a key misspelled, error 1640)
    jg_Own(tbl, jg_Only(tbl) || !d3_IsKeyword(jg_stopw)) ? jg_Settings(tbl) : d3_Settings(tbl, tbl[-1]);
);

// "D3_config" (opcode 138 : the former name of the configuration) : the same analysis ; the evaluator gives a data block
// (argc : its count), or the arguments themselves (argv : on the stack, copied into mSL_stArgs as for "settings")
function mSL_138(argc, argv)
(
    mSL_bl_check(argv) ? d3_Settings(argv, argv[-1]) :
    ((argc >= 1) && (argc <= mSL_stArgsMax) && (mSL_stArgs > 0)) ? (
        mSL_stArgs[0] = argc;
        memcpy(mSL_stArgs + 1, argv, argc);
        d3_Settings(mSL_stArgs + 1, argc);
    ) : (
        sprintf(#s, "D3_config : argc=%d, argv=%d", argc, argv);
        mSL_log(SysLogBox, #s);
        mSL_errX = 2438;
    );
);
