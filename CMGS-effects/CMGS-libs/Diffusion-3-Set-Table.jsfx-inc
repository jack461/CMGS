
/*
    Diffusion 3 Configuration Analysis

    The mSL "settings" (opcode 118 ; until 2026-11-18 "table", still a synonym) and "D3_config" (opcode 138, the former
    name of the configuration) : one analysis, d3_Settings (2026-11-18 : before, "table" read only the blocks Edit, and
    "D3_config" only the configuration), of a data block or of the words given as arguments (settings(`conf, 16, `:, 1,
    `>, 1) ; see the evaluator, mSL_stArgs) : the keywords of the configuration (clear, conf, set, prop, pload, actions,
    scene, group, hppos, source, trajectory, bgcolor ... end) and the blocks "Edit A" ... "Edit D" (ed_Tb_Edit), in any
    order. The configuration is applied as it is read ; the blocks Edit only if everything is read without error.
*/

@init

/*
    The blocks Edit of "settings" (2026-11-10 ; until 2026-11-18 the only content of "table") : the configurations of
    the modules "Edit A" ... "Edit D" (see Diffusion-3-Edit.jsfx-inc), as written by their export "configuration (mSL
    settings)" :

        settings(data(
            Edit A  name "Etoile"  kind Trajectory  closed On  smooth On  free Off
                point 0.5 0 0  bend 0.1 -0.05 0
                point -0.25 0.5 0
                ...
        ));

    A block Edit X (X : A, B, C, D, or 1 ... 4 ; a file dropped on a module Edit : its first block goes into this
    module), then keys in any order : name "text" ; kind Speakers | Sources | Trajectory ; closed, smooth, free : On |
    Off (or 1 | 0) ; point x y z [bend dx dy dz] (no number : the points are numbered 1, 2, 3 ... in their order,
    ED_MAXP at most ; the coordinates up to ED_FAR ; the bend of the segment from this point to the next one : the
    shift of its middle). The keys absent leave the configuration as it is ; the points, if any, replace all its
    points. The commas and semicolons are ignored. A block ends at the end, at the next Edit, or at a keyword of the
    configuration (d3_IsKeyword). The first error (2486 ... 2491) stops the analysis : no block Edit changes.
    This function comes before the evaluator (that calls it), the editors after it : a table is read in work areas
    (ed_tf2, ed_tpt2, ed_tnm2), then, without error, staged (ed_tq, ed_tf, ed_tpt, ed_tnm : several tables before the
    next frame add up ; all allocated by Diffusion-3-Edit), and ed_Frame takes them in @gfx (kept for Undo). Only
    globals here : no function of the editors.
*/
ed_tbEnd = -(10^30);    // after the last word
ed_tbtbl = ed_tbn = ed_tbptr = ed_tberr = ed_tbmask = 0; // (ed_tbmask : the editors named in the table, 2 ^ e)
d3_errLogged = 0; // (2026-11-19) 1 : the error of the analysis is already in the log (see d3_Settings)
// (2026-11-19) the first word of the settings of Interstys : more than 8 characters, its symbol can not be written back
// (mSL_symbol2) ; recognized for the message of the error 0298
d3_kwInterstys = mSL_symbol("Interstys");
ed_tbdrop = -1;         // the module Edit where a file was dropped (its first block goes there)
ed_mslTgt = -1; ed_mslT = 0; // set by the drop of an mSL file (Diffusion-3, @gfx) : the module Edit under the mouse, the time
ed_tkEdit = mSL_symbol("Edit");
ed_tkName = mSL_symbol("name"); ed_tkKind = mSL_symbol("kind"); ed_tkPoint = mSL_symbol("point"); ed_tkBend = mSL_symbol("bend");
ed_tkClosed = mSL_symbol("closed"); ed_tkSmooth = mSL_symbol("smooth"); ed_tkFree = mSL_symbol("free");
ed_tkOn = mSL_symbol("On"); ed_tkOff = mSL_symbol("Off");
ed_tkSpk = mSL_symbol("Speakers"); ed_tkSrc = mSL_symbol("Sources"); ed_tkTrj = mSL_symbol("Trajectory");
ed_tkA = mSL_symbol("A"); ed_tkB = mSL_symbol("B"); ed_tkC = mSL_symbol("C"); ed_tkD = mSL_symbol("D");

// the first error stops the analysis
function ed_Tb_Err(code, msg)
(
    (ed_tberr === 0) ? (
        ed_tberr = code;
        sprintf(#ed_tbm, "ERR: %04d    Diffusion settings (word %d) : %s", code, ed_tbptr, msg);
        mSL_log(SysLogBox, #ed_tbm);
        mSL_ErrNote(code, msg); // (2026-11-19, for "? n" in the mSL Console)
        d3_errLogged = 1;
    );
    code;
);

// the next word (the commas and semicolons are skipped), ed_tbEnd after the last one
function ed_Tb_Peek() local(w)
(
    w = ed_tbEnd;
    while ((ed_tbptr < ed_tbn) && (((w = ed_tbtbl[ed_tbptr]) === mSL_cstComma) || (w === ';' + mSL_CharConst))) (
        ed_tbptr += 1; w = ed_tbEnd;
    );
    w;
);
function ed_Tb_Next() local(w)
(
    w = ed_Tb_Peek();
    (ed_tbptr < ed_tbn) ? (ed_tbptr += 1);
    w;
);

// a number in [vmin, vmax] (a "-" word before it changes its sign) ; 0 and an error otherwise
function ed_Tb_Num(key, vmin, vmax) local(w, s)
(
    s = 1;
    ((w = ed_Tb_Next()) === mSL_cstMinus) ? ( s = -1; w = ed_Tb_Next(); );
    ((abs(w) < mSL_CharConst) && !mSL_isString(w) && (w * s >= vmin) && (w * s <= vmax)) ? w * s : (
        sprintf(#ed_tbw, "%s : %s is not a value in [%g, %g]", key, (w === ed_tbEnd) ? "the end" : mSL_edit_value(#ed_tbv, w), vmin, vmax);
        ed_Tb_Err(2490, #ed_tbw);
        0;
    );
);

// On | Off, or 1 | 0
function ed_Tb_Bool(key) local(w)
(
    w = ed_Tb_Peek();
    (w === ed_tkOn) ? ( ed_Tb_Next(); 1; ) :
    (w === ed_tkOff) ? ( ed_Tb_Next(); 0; ) :
    (ed_Tb_Num(key, 0, 1) != 0);
);

// a keyword of the configuration (the state 1 of d3_Settings : keep them in step) : it ends a block Edit
function d3_IsKeyword(w)
(
    (w === kxw_conf) || (w === kxw_diff) || (w === kxw_group) || (w === kxw_scene) || (w === kxw_end) ||
    (w === kxw_vol) || (w === kxw_vadj) || (w === kxw_morpht) || (w === kxw_opmod) || (w === kxw_rdelay) ||
    (w === kxw_clear) || (w === kxw_pad) || (w === kxw_defaultconf) || (w === kxw_remove) || (w === kxw_prop) ||
    (w === kxw_pload) || (w === kxw_actions) || (w === kxw_hppos) || (w === kxw_source) || (w === kxw_trajectory) ||
    (w === kxw_bgcolor) || (w === jg_kGUI); // (2026-11-21 : a part GUI, mSL_GUI)
);

// A block Edit (its word read) : read in the work area of its editor (ed_tf2, ed_tpt2, ed_tnm2 ; the blocks of the same
// editor in a table add up : their points follow one another) ; returns its editor, or -1
function ed_Tb_Edit() local(w, e, f, pts, p, k)
(
    w = ed_Tb_Next();
    e = (w === ed_tkA) ? 0 : (w === ed_tkB) ? 1 : (w === ed_tkC) ? 2 : (w === ed_tkD) ? 3 :
        ((abs(w) < mSL_CharConst) && !mSL_isString(w) && (w === floor(w)) && (w >= 1) && (w <= ED_NV)) ? w - 1 : -1;
    (e < 0) ? (
        sprintf(#ed_tbw, "Edit %s : A, B, C or D expected", (w === ed_tbEnd) ? "(the end)" : mSL_edit_value(#ed_tbv, w));
        ed_Tb_Err(2486, #ed_tbw);
    ) : (
        // a file dropped on a module Edit : its first block goes there
        (ed_tbdrop >= 0) ? ( e = ed_tbdrop; ed_tbdrop = -1; );
        f = ed_tf2 + e * 8;
        pts = ed_tpt2 + e * ED_MAXP * ED_PS;
        !(ed_tbmask & (2 ^ e)) ? (
            ed_tbmask |= 2 ^ e;
            memset(f, 0, 8); memset(pts, 0, ED_MAXP * ED_PS);
        );
        while ((ed_tberr === 0) && ((w = ed_Tb_Peek()) !== ed_tbEnd) && (w !== ed_tkEdit) && !d3_IsKeyword(w)) (
            ed_Tb_Next();
            (w === ed_tkName) ? (
                w = ed_Tb_Next();
                mSL_isString(w) ? ( strcpy(ed_tnm2[e], w); f[0] |= 1; ) :
                ((w > mSL_Sym_Low) && (w < mSL_Sym_High)) ? ( mSL_edit_value(ed_tnm2[e], w); f[0] |= 1; ) :
                ed_Tb_Err(2487, "name : a \"text\" expected");
            ) :
            (w === ed_tkKind) ? (
                w = ed_Tb_Next();
                k = (w === ed_tkSpk) ? 0 : (w === ed_tkSrc) ? 1 : (w === ed_tkTrj) ? 2 : -1;
                (k < 0) ? (
                    sprintf(#ed_tbw, "kind %s : Speakers, Sources or Trajectory expected", (w === ed_tbEnd) ? "(the end)" : mSL_edit_value(#ed_tbv, w));
                    ed_Tb_Err(2488, #ed_tbw);
                ) : ( f[1] = k; f[0] |= 2; );
            ) :
            (w === ed_tkClosed) ? ( f[2] = ed_Tb_Bool("closed"); f[0] |= 4; ) :
            (w === ed_tkSmooth) ? ( f[3] = ed_Tb_Bool("smooth"); f[0] |= 8; ) :
            (w === ed_tkFree) ? ( f[4] = ed_Tb_Bool("free"); f[0] |= 16; ) :
            (w === ed_tkPoint) ? (
                // the next point (its number : its rank)
                (f[5] >= ED_MAXP) ? (
                    sprintf(#ed_tbw, "Edit %c : more than %d points", 'A' + e, ED_MAXP);
                    ed_Tb_Err(2491, #ed_tbw);
                ) : (
                    p = pts + f[5] * ED_PS;
                    p[0] = ed_Tb_Num("point x", -ED_FAR, ED_FAR);
                    p[1] = ed_Tb_Num("point y", -ED_FAR, ED_FAR);
                    p[2] = ed_Tb_Num("point z", -ED_FAR, ED_FAR);
                    (ed_Tb_Peek() === ed_tkBend) ? (
                        ed_Tb_Next();
                        p[4] = ed_Tb_Num("bend x", -100, 100); p[5] = ed_Tb_Num("bend y", -100, 100); p[6] = ed_Tb_Num("bend z", -100, 100);
                    );
                    f[5] += 1;
                    f[0] |= 32;
                );
            ) : (
                sprintf(#ed_tbw, "%s : a key (name, kind, closed, smooth, free, point), Edit or a keyword expected", mSL_edit_value(#ed_tbv, w));
                ed_Tb_Err(2489, #ed_tbw);
            );
        );
    );
    (ed_tberr === 0) ? e : -1;
);

// the blocks Edit read without error (and the whole analysis too) : staged for the editors (ed_Frame : ed_TbTake), the
// keys given added (several analyses before ed_Frame add up)
function ed_Tb_Stage() local(e, f, g)
(
    e = 0;
    loop(ED_NV,
        (ed_tbmask & (2 ^ e)) ? (
            f = ed_tf2 + e * 8; g = ed_tf + e * 8;
            !ed_tq[e] ? memset(g, 0, 8);
            (f[0] & 1) ? strcpy(ed_tnm[e], ed_tnm2[e]);
            (f[0] & 2) ? (g[1] = f[1]);
            (f[0] & 4) ? (g[2] = f[2]);
            (f[0] & 8) ? (g[3] = f[3]);
            (f[0] & 16) ? (g[4] = f[4]);
            (f[0] & 32) ? (
                g[5] = f[5];
                memcpy(ed_tpt + e * ED_MAXP * ED_PS, ed_tpt2 + e * ED_MAXP * ED_PS, ED_MAXP * ED_PS);
            );
            g[0] |= f[0];
            ed_tq[e] = 1;
        );
        e += 1;
    );
);


/*
    hppos (2026-11-18) : the positions of the speakers, written in the frame the most convenient for the person who
    describes the installation, its real dimensions, the activation of each speaker :

        hppos  frame 0 1  size 8.9 12.5 4.5
               1 < 0.1841 1 0,  2 < 0.4952 1 0,  ...  4 < 1 0.7909 0 Off,  ... ;

    frame a b : the cube of the coordinates (a < b, the same for the 3 axes : 0 1, -1 1, -5 5 ...) ; frame Metres (or
    Meters) : the coordinates in metres, in [0, X] x [0, Y] x [0, Z] (the size is then needed) ; no frame : the former
    rule (the coordinates in [-5, 5], "the largest becomes 1"). size X Y Z : the real dimensions of the cube, in metres
    (its homothety ; none : a cube). Off after a position : an inactive speaker (the spatial laws leave it out ; On, the
    default). The statements add up : the speakers given are added, or replace those of the same numbers (several hppos
    can build a layout, as the sequences of 16 speakers of a file .am64) ; "hppos clear" empties the layout first (its
    positions, frame, size, activations ; the keyword "clear" of the configuration too). A number without "<" changes only
    its activation ("hppos 4 Off, 12 Off ;", settings(`hppos, 4, `Off)) ; frame and size alone change those of the layout
    ("hppos size 8.9 12.5 4.5 ;"). An hppos ends at ";", at the end of the words, or at the next keyword of the
    configuration (settings(`hppos, 2, `Off, `hppos, 4, `Off)). The values are kept as written (HP_Positions : number, x, y, z), the
    frame and the size in hp_Geo (0 the mode : 0 none, 1 a b, 2 Metres ; 1 2 a b ; 3 4 5 X Y Z, 0 : none), the
    activations in hp_Act (1 ... 128) : saved with the project (Diffusion-3-Configurations, record 9), written back by
    the exports. The coordinates must stay in the frame (2426 ; no frame : [-5, 5]).
*/

// the frame of the geometry g as a text (s) : "a b", "Metres", "none"
function hp_FrText(s, g)
(
    (g[0] === 1) ? sprintf(s, "%g %g", g[1], g[2]) : (g[0] === 2) ? strcpy(s, "Metres") : strcpy(s, "none");
    s;
);

// the position x y z of the speaker n in the frame of the geometry g ? 0, or 2426 (logged)
function hp_Check(g, n, x, y, z)
local(m, e, ok)
(
    m = g[0]; e = 0.000001;
    ok = (m === 1) ? ((x >= g[1] - e) && (x <= g[2] + e) && (y >= g[1] - e) && (y <= g[2] + e) && (z >= g[1] - e) && (z <= g[2] + e)) :
         (m === 2) ? ((x >= -e) && (x <= g[3] + e) && (y >= -e) && (y <= g[4] + e) && (z >= -e) && (z <= g[5] + e)) :
         ((abs(x) <= 5 + e) && (abs(y) <= 5 + e) && (abs(z) <= 5 + e));
    ok ? 0 : (
        (m === 1) ? sprintf(#hp_w2, "[%g, %g]", g[1], g[2]) :
        (m === 2) ? sprintf(#hp_w2, "[0, %g] x [0, %g] x [0, %g]", g[3], g[4], g[5]) : strcpy(#hp_w2, "[-5, 5]");
        sprintf(#hp_w, "ERR: 2426    hppos : the speaker %d (%g %g %g) is outside the frame %s", n, x, y, z, #hp_w2);
        mSL_log(SysLogBox, #hp_w);
        sprintf(#hp_w, "speaker %d (%g %g %g), frame %s", n, x, y, z, #hp_w2);
        mSL_ErrNote(2426, #hp_w); // (2026-11-19, for "? n" in the mSL Console)
        d3_errLogged = 1;
        2426;
    );
);

// the speakers in the log : their count, the frame, the size, the inactive ones
function hp_Log()
local(i, n, off)
(
    n = off = 0;
    (HP_Positions > 0) ? (
        i = 0;
        while (i < HP_Positions[-1]) (
            ((HP_Positions[i] >= 1) && (HP_Positions[i] <= 128)) ? (
                n += 1;
                (hp_Act[HP_Positions[i]] === 0) ? off += 1;
            );
            i += 4;
        );
    );
    (hp_Geo[3] > 0) ? sprintf(#hp_w3, "%g %g %g", hp_Geo[3], hp_Geo[4], hp_Geo[5]) : strcpy(#hp_w3, "none");
    sprintf(#hp_w, "hppos : %d speakers, frame %s, size %s, %d inactive", n, hp_FrText(#hp_w2, hp_Geo), #hp_w3, off);
    mSL_log(SysLogBox, #hp_w);
);

// The end of hppos : the entries read (tw : ne entries of 6 words : n, x, y, z, its activation (1 On, 0 Off, -1 not
// given), 1 when its position is given), the frame and the size given (hp_GeoT : as hp_Geo, its word 7 : the parts given,
// 1 frame, 2 size, 4 clear). The layout : the current one (none after clear), the positions given added (or replacing
// those of the same numbers), the frame and the size given ; a speaker given with its position is active, but Off.
// Checks : frame Metres needs a size (2425), every position of the layout in its frame (2426). Returns 0 (applied, a line
// in the log), or the error (nothing changed)
function hp_End(tw, ne)
local(i, e, c, pos, g, err, blk, ip, clr, old)
(
    err = 0; pos = 0; c = 0;
    clr = hp_GeoT[7] & 4;
    old = clr ? 0 : HP_Positions; // (the positions kept : none after clear)
    (old > 0) ? (i = 0; while (i < old[-1]) ( (old[i] >= 1) ? c = max(c, old[i]); i += 4; ););
    i = 0; loop(ne, e = tw + 6 * i; e[5] ? (pos += 1; c = max(c, e[0]);); i += 1;);
    // the new geometry : the current one (none after clear), with the parts given
    g = hp_GeoR;
    clr ? memset(g, 0, 8) : memcpy(g, hp_Geo, 8);
    (hp_GeoT[7] & 1) ? (g[0] = hp_GeoT[0]; g[1] = hp_GeoT[1]; g[2] = hp_GeoT[2];);
    (hp_GeoT[7] & 2) ? (g[3] = hp_GeoT[3]; g[4] = hp_GeoT[4]; g[5] = hp_GeoT[5];);
    ((g[0] === 2) && ((g[3] <= 0) || (g[4] <= 0) || (g[5] <= 0))) ? err = 2425; // frame Metres : the size is needed
    // the new positions : those kept, then those given
    blk = old;
    (!err && (pos > 0)) ? (
        blk = mSL_Dyn_Alloc((c+1)*4, 'hpps', mSL_StM_FlClear);
        (blk > 0) ? (
            (old > 0) ? memcpy(blk, old, min(old[-1], (c+1)*4));
            i = 0;
            loop(ne,
                e = tw + 6 * i;
                e[5] ? (ip = e[0] * 4; blk[ip] = e[0]; blk[ip+1] = e[1]; blk[ip+2] = e[2]; blk[ip+3] = e[3];);
                i += 1;
            );
        ) : (
            err = 2428; // hppos : no memory for the positions
        );
    );
    // every position of the layout in its frame
    (!err && (blk > 0)) ? (
        i = 0;
        while ((i < blk[-1]) && !err) (
            (blk[i] >= 1) ? (err = hp_Check(g, blk[i], blk[i+1], blk[i+2], blk[i+3]));
            i += 4;
        );
    );
    !err ? (
        (blk !== HP_Positions) ? (
            // protect it from the garbage collector (it was freed, then reused : garbage HP numbers ; 0 : none)
            (mm_usr_prot_hpps > 0) ? mm_usr_prot[mm_usr_prot_hpps] = blk;
            HP_Positions = blk;
        );
        clr ? memset(hp_Act, 1, 129);
        i = 0;
        loop(ne,
            e = tw + 6 * i;
            (e[4] >= 0) ? (hp_Act[e[0]] = e[4]) : (e[5] ? (hp_Act[e[0]] = 1));
            i += 1;
        );
        memcpy(hp_Geo, g, 8);
        hp_Seq += 1;
        sp_defSeq += 1; // (the speakers of the spatial projectors : sp_Gfx)
        hp_Log();
    ) : (
        ((blk > 0) && (blk !== old)) ? mSL_Dyn_Free(blk); // (the new block, not used)
    );
    err;
);

// (2026-11-19) The explanation of an error of the analysis of the settings (codes 0202 ... 0299 : written 202 ... before,
// as in CMGS-Erreurs.tsv ; 0269, 0297, 0298 : the former 69 ; 0299 : the former 99)
function d3_StErrMsg(c)
(
    (c === 0202) ? "this configuration number is already used" :
    (c === 0203) ? "conf : a configuration number is expected" :
    (c === 0204) ? "a channel number is expected" :
    (c === 0206) ? "a \">\" is expected" :
    (c === 0207) ? "actions : a line number in [1, 16] is expected" :
    (c === 0208) ? "actions : a command number in [0, 256] is expected" :
    (c === 0209) ? "a volume is expected after dB" :
    (c === 0210) ? "remove : conf or prop is expected" :
    (c === 0211) ? "group : a group number is expected" :
    (c === 0212) ? "remove conf : a configuration number is expected" :
    (c === 0213) ? "this configuration is not defined" :
    (c === 0214) ? "pad : too many configurations" :
    (c === 0215) ? "group : too many configurations" :
    (c === 0216) ? "vol : an incorrect volume" :
    (c === 0217) ? "vadj : an incorrect volume adjustment" :
    (c === 0218) ? "morph : an incorrect switch time" :
    (c === 0219) ? "opmod : an incorrect mode" :
    (c === 0220) ? "rdelay : an incorrect random delay" :
    (c === 0222) ? "scene : a scene number is expected" :
    (c === 0223) ? "prop : this preset number is already used" :
    (c === 0224) ? "prop : a preset number is expected" :
    (c === 0225) ? "prop n : a \"(\" is expected" :
    (c === 0226) ? "prop n ( ... ) : an unknown keyword" :
    (c === 0227) ? "prop n ( ... ) : a keyword, \",\", \";\" or \")\" is expected" :
    (c === 0228) ? "prop : a morph value is expected" :
    (c === 0229) ? "prop : a random delay value is expected" :
    (c === 0230) ? "prop : this configuration is not defined" :
    (c === 0231) ? "prop : a configuration number is expected" :
    (c === 0233) ? "defaultconf : a configuration number is expected" :
    (c === 0234) ? "prop pad / sgi : a scene number is expected" :
    (c === 0235) ? "pload : a projector number is expected" :
    (c === 0236) ? "pload : this projector preset is not defined" :
    (c === 0237) ? "pload : a projector preset number is expected" :
    (c === 0238) ? "remove prop : a preset number is expected" :
    (c === 0239) ? "prop color : a color number is expected" :
    (c === 0240) ? "actions : a color in [0, 15] is expected after /" :
    (c === 0250) ? "hppos : a speaker number (1 ... 128), frame, size or \";\" is expected" :
    (c === 0251) ? "hppos : \"<\", On or Off is expected after a speaker number" :
    (c === 0252) ? "hppos : the x position is expected, a number" :
    (c === 0253) ? "hppos : the y position is expected, a number" :
    (c === 0254) ? "hppos : the z position is expected, a number" :
    (c === 0255) ? "hppos : On, Off, \",\" or \";\" is expected" :
    (c === 0256) ? "conf : the configuration is too large (more than 34000 words)" :
    (c === 0259) ? "invert : a configuration defined before (not this one) is expected" :
    (c === 0269) ? "internal : an unknown state of the analyzer" :
    (c === 0297) ? "an unexpected character" :
    (c === 0298) ? "an unknown keyword" :
    (c === 0299) ? "internal : the analyzer stopped" :
    (c === 2423) ? "hppos frame : \"a b\" (a < b) or Metres is expected" :
    (c === 2424) ? "hppos size : three numbers X Y Z, > 0, are expected" :
    (c === 2425) ? "hppos frame Metres : the size is needed" :
    (c === 2427) ? "hppos : too many entries" :
    (c === 2428) ? "hppos : no memory for the positions" :
    (c === 2439) ? "a color in [0, 0xFFFFFF] is expected" :
    (c === 2470) ? "trajectory : a number in [1, 128] is expected" :
    (c === 2471) ? "trajectory : a \"name\", closed, open or \":\" is expected" :
    (c === 2472) ? "trajectory : a coordinate in [-10, 10] is expected (or more than 1024 points)" :
