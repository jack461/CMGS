        i = 0; loop(n,
            x = abs(mx - crv_Px(x0, w, p[3 * i])); y = abs(my - crv_Py(y0, h, lo, p[3 * i + 1]));
            ((x <= hs) && (y <= hs) && (x + y < f)) ? ( hit = i; f = x + y; );
            i += 1;
        );
        (hit < 0) ? (press = 0);
    );
    xv = max(0, min(1, (mx - x0 - CRV_PAD) / max(1, w - 1 - 2 * CRV_PAD)));
    yv = max(lo, min(1, 1 - (my - y0 - CRV_PAD) / max(1, h - 1 - 2 * CRV_PAD) * (1 - lo)));
    press ? (
        crv_Pre(k);
        crv_m0x = mx; crv_m0y = my; crv_moved = 0;
        ((hit >= 0) && (ms & 8) && (b[crv_fSel] >= 0) && (b[crv_fSel] < n) && crv_selF[b[crv_fSel]]) ? (
            // Shift : the points from the first selected to this one
            i = min(hit, b[crv_fSel]); loop(abs(hit - b[crv_fSel]) + 1, crv_selF[i] = 1; i += 1;);
        ) :
        ((hit >= 0) && (ms & (8 | 0x24))) ? (
            // Cmd (or Shift without a selected point) : this point added to the selection, or removed
            crv_selF[hit] = !crv_selF[hit];
            crv_selF[hit] ? (b[crv_fSel] = hit) : (b[crv_fSel] === hit) ? (b[crv_fSel] = -1);
        ) :
        (hit >= 0) ? (
            // this point (or the selection that holds it) is moved
            !(crv_selF[hit] && (crv_SelCount(n) > 1)) ? ( crv_SelClear(); crv_selF[hit] = 1; b[crv_fSel] = hit; );
            crv_mDrag = 1; crv_dragI = hit;
            crv_p0x = p[3 * hit]; crv_p0y = p[3 * hit + 1];
            memcpy(crv_orig, p, 3 * n);
        ) : (
            // the segment under the mouse : i ... i + 1
            i = 0; while ((i < n - 2) && (p[3 * (i + 1)] <= xv)) ( i += 1; );
            ya = crv_Py(y0, h, lo, crv_Val(b, xv));
            ((abs(my - ya) <= 6 * rp) && (p[3 * (i + 1)] > p[3 * i])) ? (
                crv_mDrag = 2; crv_dragI = i; crv_c0 = p[3 * i + 2];
            ) :
            (n < CRV_PMX) ? (
                // a new point after the point i (its x : between them), the selection
                crv_Commit();
                memcpy(p + 3 * (i + 2), p + 3 * (i + 1), 3 * (n - i - 1));
                x = max(p[3 * i], min(p[3 * (i + 2)], crv_Snap(xv, 0)));
                p[3 * (i + 1)] = x; p[3 * (i + 1) + 1] = max(lo, min(1, crv_Snap(yv, lo))); p[3 * (i + 1) + 2] = 0;
                n += 1; b[crv_fN] = n;
                (b[crv_fSus] > i) ? (b[crv_fSus] += 1);
                crv_SelClear(); crv_selF[i + 1] = 1; b[crv_fSel] = i + 1;
                crv_mDrag = 1; crv_dragI = i + 1;
                crv_p0x = p[3 * (i + 1)]; crv_p0y = p[3 * (i + 1) + 1];
                memcpy(crv_orig, p, 3 * n);
            ) : (
                sprintf(#crv_msg, "Curve %d : %d points at most", k + 1, CRV_PMX);
                mSL_log(SysLogBox, #crv_msg);
            );
        );
        ui_GFXdoNow |= 4;
    );
    (rpress && (hit >= 0)) ? (
        // delete the point (a selected point : all the selection), not the first and the last
        crv_Pre(k);
        !crv_selF[hit] ? ( crv_SelClear(); crv_selF[hit] = 1; );
        j = 0;
        i = n - 2; while (i > 0) (
            crv_selF[i] ? (
                (j === 0) ? crv_Commit(); j += 1;
                memcpy(p + 3 * i, p + 3 * (i + 1), 3 * (n - i - 1));
                crv_SelDel(i, n);
                (b[crv_fSus] === i) ? (b[crv_fSus] = -1) : (b[crv_fSus] > i) ? (b[crv_fSus] -= 1);
                n -= 1;
            );
            i -= 1;
        );
        b[crv_fN] = n;
        crv_SelClear(); b[crv_fSel] = -1;
        ui_GFXdoNow |= 4;
    );
    // the button held : the selected points or the curvature follow the mouse (Shift : 1/10)
    ((uix_mcap & 1) && crv_mDrag) ? (
        f = (ms & 8) ? 0.1 : 1;
        dxm = (mx - crv_m0x) * f; dym = (my - crv_m0y) * f;
        ((abs(mx - crv_m0x) + abs(my - crv_m0y) > 2) && !crv_moved) ? ( crv_moved = 1; crv_Commit(); );
        crv_moved ? (
            i = crv_dragI;
            (crv_mDrag === 1) ? (
                x = crv_p0x + dxm / max(1, w - 1 - 2 * CRV_PAD);
                y = crv_p0y - dym / max(1, h - 1 - 2 * CRV_PAD) * (1 - lo);
                (f === 1) ? ( x = crv_Snap(x, 0); y = crv_Snap(y, lo); );
                crv_Move(b, i, x, y, lo);
                crv_Clamp(b); // (QWave, HWave : the y fixed at 0)
            ) : (
                // drag up : the segment bulges up (rising : c > 0 ; falling : c < 0)
                sg = (p[3 * (i + 1) + 1] >= p[3 * i + 1]) ? 1 : -1;
                p[3 * i + 2] = max(-1, min(1, crv_c0 - sg * dym / max(1, h / 2)));
            );
            ui_GFXdoNow |= 4;
        );
    );
    // the button released : a clic on a segment, without moving : straight
    (!(uix_mcap & 1) && crv_mDrag) ? (
        ((crv_mDrag === 2) && !crv_moved && (p[3 * crv_dragI + 2] !== 0)) ? ( crv_Commit(); p[3 * crv_dragI + 2] = 0; );
        crv_mDrag = 0; crv_preK = -1;
        ui_GFXdoNow |= 4;
    );
);

// The curve b in the current rect (retina coordinates) : the guides, the grid, the segments, the points (the first and the
// last : another color ; the selected ones : Goldenrod ; the sustain point : an orange frame and a vertical line)
function crv_Draw(b)
local (x0, y0, w, h, rsc, lo, i, n, p, xa, ya, xb, yb, d, k)
(
    x0 = ui_left_retina(); y0 = ui_top_retina(); w = ui_width_retina(); h = ui_height_retina();
    rsc = max(1, floor(uix_drawconfig_current[9]));
    lo = crv_Lo(b[crv_fT]);
    ui_pcolor(0x808080, 0.15);
    gfx_rect(x0, y0, w, h);
    // the guides : y = 0, 1 (and -1), the middle
    ui_pcolor(0x808080, 0.6);
    gfx_line(x0, crv_Py(y0, h, lo, 0), x0 + w - 1, crv_Py(y0, h, lo, 0));
    ui_pcolor(0x808080, 0.3);
    gfx_line(x0, crv_Py(y0, h, lo, 1), x0 + w - 1, crv_Py(y0, h, lo, 1));
    gfx_line(x0, crv_Py(y0, h, lo, lo), x0 + w - 1, crv_Py(y0, h, lo, lo));
    (lo === 0) ? gfx_line(x0, crv_Py(y0, h, lo, 0.5), x0 + w - 1, crv_Py(y0, h, lo, 0.5));
    // the sustain point : a vertical line between the rise and the fall
    (b[crv_fSus] >= 0) ? (
        ui_pcolor(Color_Dark_Orange, 0.55);
        xa = floor(crv_Px(x0, w, b[crv_fP + 3 * b[crv_fSus]]));
        gfx_line(xa, y0, xa, y0 + h - 1);
        (rsc > 1) ? gfx_line(xa + 1, y0, xa + 1, y0 + h - 1);
    );
    (crv_grid > 0) ? (
        ui_pcolor(0x808080, 0.18);
        i = 1; loop(crv_grid - 1,
            d = i / crv_grid;
            gfx_line(crv_Px(x0, w, d), y0, crv_Px(x0, w, d), y0 + h - 1);
            gfx_line(x0, crv_Py(y0, h, lo, lo + d * (1 - lo)), x0 + w - 1, crv_Py(y0, h, lo, lo + d * (1 - lo)));
            i += 1;
        );
    );
    // the curve : each segment from its first point to the next one, one value per pixel
    ui_pcolor(uix_theme_accent(), 0.95);
    p = b + crv_fP;
    loop(b[crv_fN] - 1,
        xa = crv_Px(x0, w, p[0]); ya = crv_Py(y0, h, lo, p[1]);
        n = max(1, ceil(crv_Px(x0, w, p[3]) - xa));
        i = 1; loop(n,
            d = i / n;
            xb = xa + (crv_Px(x0, w, p[3]) - crv_Px(x0, w, p[0])) / n;
            yb = crv_Py(y0, h, lo, p[1] + (p[4] - p[1]) * crv_Shape(d, p[2]));
            gfx_line(xa, ya, xb, yb, 1);
            (rsc > 1) ? gfx_line(xa, ya + 1, xb, yb + 1, 1);
            xa = xb; ya = yb;
            i += 1;
        );
        p += 3;
    );
    // the points
    k = 3 * rsc;
    p = b + crv_fP; i = 0;
    loop(b[crv_fN],
        xa = crv_Px(x0, w, p[0]); ya = crv_Py(y0, h, lo, p[1]);
        crv_selF[i] ? ui_pcolor(Color_Goldenrod, 1) :
        ((i === 0) || (i === b[crv_fN] - 1)) ? ui_pcolor(Color_Light_Steel_Blue, 1) : ui_pcolor(Color_Limegreen, 1);
        gfx_rect(xa - k, ya - k, 2 * k + 1, 2 * k + 1);
        (i === b[crv_fSus]) ? (
            ui_pcolor(Color_Dark_Orange, 1);
            gfx_rect(xa - 2 * k, ya - 2 * k, 4 * k + 1, 4 * k + 1, 0);
            (rsc > 1) ? gfx_rect(xa - 2 * k + 1, ya - 2 * k + 1, 4 * k - 1, 4 * k - 1, 0);
        );
        p += 3; i += 1;
    );
);

// (2026-11-24, the user) The playheads of the host (crv_PhSet, set in the last 0.5 s ; all the curves or this one) over the
// curve b (number k) in the current rect (retina coordinates) : a vertical line, a dot on the curve, its letter at the top
// (the playheads of a curve : a little lower)
function crv_DrawPh(b, k) local(x0, y0, w, h, rsc, lo, i, x, px, py, t, tw, th)
(
    x0 = ui_left_retina(); y0 = ui_top_retina(); w = ui_width_retina(); h = ui_height_retina();
    rsc = max(1, floor(uix_drawconfig_current[9]));
    lo = crv_Lo(b[crv_fT]); t = time_precise();
    i = 0;
    loop(CRV_PHN,
        ((t - crv_phT[i] < 0.5) && ((crv_phK[i] < 0) || (crv_phK[i] === k))) ? (
            x = crv_XOf(b[crv_fT], crv_phU[i]);
            px = floor(crv_Px(x0, w, x)); py = crv_Py(y0, h, lo, crv_Val(b, x));
            ui_pcolor(crv_phC[i], 0.85);
            gfx_line(px, y0, px, y0 + h - 1);
            (rsc > 1) ? gfx_line(px + 1, y0, px + 1, y0 + h - 1);
            ui_pcolor(crv_phC[i], 1);
            gfx_circle(px, py, 4 * rsc, 1, 1);
            sprintf(#crv_phS, "%c%s", crv_phL[i], crv_phX[i]);
            gfx_measurestr(#crv_phS, tw, th);
            gfx_x = min(px + 3 * rsc, x0 + w - tw - 1); gfx_y = y0 + 2 * rsc + ((crv_phK[i] < 0) ? 0 : th);
            gfx_drawstr(#crv_phS);
        );
        i += 1;
    );
);

// The name txt given to the curve k (the prompt of the module) : the spaces at the ends removed ; "" : no name ; with Undo
function crv_Rename(k, txt) local(i, l)
(
    l = strlen(txt); i = 0;
    while ((i < l) && (str_getchar(txt, i, 'cu') === ' ')) ( i += 1; );
    while ((l > i) && (str_getchar(txt, l - 1, 'cu') === ' ')) ( l -= 1; );
    strcpy_substr(#crv_renX, txt, i, l - i);
    !crv_Ex(k) ? 0 :
    (strcmp(#crv_renX, crv_nm[k]) === 0) ? 0 :
    ((strlen(#crv_renX) > 0) && !crv_NmOk(#crv_renX)) ? (
        sprintf(#crv_msg, "Curve %d : a name has 1 ... %d characters, without \"", k + 1, CRV_NMLEN);
        mSL_log(SysLogBox, #crv_msg);
    ) :
    (((i = crv_Find(#crv_renX)) >= 0) && (i !== k)) ? (
        sprintf(#crv_msg, "Curve %d : the name \"%s\" is the one of the curve %d", k + 1, #crv_renX, i + 1);
        mSL_log(SysLogBox, #crv_msg);
    ) : (
        crv_Pre(k); crv_Commit();
        strcpy(crv_nm[k], #crv_renX);
    );
);

// The sustain point of the envelope b (number k) : i (a point), -1 (none), -2 (the selected point ; already the sustain :
// none) ; with Undo
function crv_SetSus(b, k, i)
(
    (i === -2) ? (
        i = b[crv_fSel];
        ((i >= 0) && (i < b[crv_fN]) && crv_selF[i]) ? ( (i === b[crv_fSus]) ? (i = -1); ) : (i = -2);
    );
    (b[crv_fT] !== CRV_ENV) ? (
        sprintf(#crv_msg, "Curve %d : only an envelope (not a half one) has a sustain point", k + 1);
        mSL_log(SysLogBox, #crv_msg);
    ) :
    (i === -2) ? (
        sprintf(#crv_msg, "Curve %d : sustain : select a point first", k + 1);
        mSL_log(SysLogBox, #crv_msg);
    ) :
    (i !== b[crv_fSus]) ? (
        crv_Pre(k); crv_Commit();
        b[crv_fSus] = i;
    );
);

// The curve k in the log, as in the settings : "Curve id type T [periodic On] [sustain n] points x y c ..." (6 points per line)
function crv_Dump(k) local(b, p, n, q)
(
    b = crv_B(k);
    crv_Ex(k) ? (
        (strlen(crv_nm[k]) > 0) ? sprintf(#crv_t1, "\"%s\"", crv_nm[k]) : sprintf(#crv_t1, "%d", k + 1);
        sprintf(#crv_msg, "Curve %s  type %s", #crv_t1, crv_tyN[b[crv_fT]]);
        (b[crv_fF] & CRV_PER) ? strcat(#crv_msg, "  periodic On");
        (b[crv_fSus] >= 0) ? (sprintf(#crv_t1, "  sustain %d", b[crv_fSus] + 1); strcat(#crv_msg, #crv_t1););
        strcat(#crv_msg, "  points");
        mSL_log(SysLogBox, #crv_msg);
        n = b[crv_fN]; p = b + crv_fP;
        while (n > 0) (
            strcpy(#crv_msg, "   ");
            q = 0; loop(min(6, n), sprintf(#crv_t1, "  %.6g %.6g %.6g", p[0], p[1], p[2]); strcat(#crv_msg, #crv_t1); p += 3; q += 1;);
            n -= q;
            mSL_log(SysLogBox, #crv_msg);
        );
    ) : (
        sprintf(#crv_msg, "Curve %d : no curve", k + 1); mSL_log(SysLogBox, #crv_msg);
    );
);

// The state of the editor e in the globals of the editor drawn ; kept again by crv_EdPut
function crv_EdGet(e) local(p)
(
    p = crv_ed + e * CRV_ES;
    crv_uiK = p[0]; crv_grid = p[1]; crv_mDrag = p[3]; crv_dragI = p[4];
    crv_m0x = p[5]; crv_m0y = p[6]; crv_moved = p[7]; crv_c0 = p[8]; crv_p0x = p[9]; crv_p0y = p[10];
    crv_selK = p[11]; crv_selF = crv_edSel + e * CRV_PMX;
);
function crv_EdPut(e) local(p)
(
    p = crv_ed + e * CRV_ES;
    p[0] = crv_uiK; p[1] = crv_grid; p[3] = crv_mDrag; p[4] = crv_dragI;
    p[5] = crv_m0x; p[6] = crv_m0y; p[7] = crv_moved; p[8] = crv_c0; p[9] = crv_p0x; p[10] = crv_p0y;
    p[11] = crv_selK;
);

// (2026-11-24) The items of the curves added to the menu str (ttl : the name of their sub-menus, by 32), the curve cur
// checked ; empty : the curves without points (a new curve there, or none) are greyed (with ok_empty : not) ; returns their
// count (CRV_MX : the item j is the curve j)
function crv_MenuAdd(str, ttl, cur, ok_empty) local(i, g, b)
(
    i = 0;
    loop(CRV_MX,
        g = (i % 32);
        (g === 0) ? (sprintf(#crv_it, "|>%s %d - %d", ttl, i + 1, i + 32); strcat(str, #crv_it););
        b = crv_B(i); // (EEL2 : no index on the result of a function)
        crv_Ex(i) ? (
            (strlen(crv_nm[i]) > 0) ? sprintf(#crv_t1, "%d  %s  (%s)", i + 1, crv_nm[i], crv_tyN[b[crv_fT]]) :
                sprintf(#crv_t1, "%d  (%s)", i + 1, crv_tyN[b[crv_fT]]);
        ) : (
            sprintf(#crv_t1, "%d  -", i + 1);
        );
        sprintf(#crv_it, "|%s%s%s%s", (g === 31) ? "<" : "", (i === cur) ? "!" : "", (!ok_empty && !crv_Ex(i)) ? "#" : "", #crv_t1);
        strcat(str, #crv_it);
        i += 1;
    );
    CRV_MX;
);
// (2026-11-24, step 3) The dynamics after c (d : 1 the next one, -1 the previous one) : the n0 curves of the host (0 ... n0
// - 1 : the easings of Space), then the curves that exist (CRV_DYN + k), in a circle
function crv_DynNext(c, d, n0) local(m, j, k, i, r)
(
    m = n0; k = 0; loop(CRV_MX, crv_Ex(k) ? (m += 1); k += 1;);
    (c < CRV_DYN) ? (j = max(0, min(n0 - 1, c|0))) : (
        j = n0; k = 0; loop(max(0, min(CRV_MX, (c|0) - CRV_DYN)), crv_Ex(k) ? (j += 1); k += 1;);
    );
    j = (j + d + 2 * m) % m;
    (j < n0) ? j : (
        i = j - n0; r = -1; k = 0;
        while ((r < 0) && (k < CRV_MX)) ( crv_Ex(k) ? ((i === 0) ? (r = k) : (i -= 1)); k += 1; );
        CRV_DYN + max(0, r);
    );
);
// (2026-11-24, step 3) The name of the dynamics c into str when it is a curve ("curve 5", or its name) : 1 ; else 0 (an
// easing of the host)
function crv_DynName(str, c) local(k)
(
    (c >= CRV_DYN) ? (
        k = max(0, min(CRV_MX - 1, (c|0) - CRV_DYN));
        (strlen(crv_nm[k]) > 0) ? strcpy(str, crv_nm[k]) : sprintf(str, "curve %d", k + 1);
        1;
    ) : 0;
);

// The menu of the curves (the title ttl : an item "#..."), the curve cur checked, by 32 in sub-menus : the curve chosen, or
// -1 ; empty : the curves without points (a new curve there, or none) are greyed (with ok_empty : not)
function crv_Menu(ttl, cur, ok_empty) local(m)
(
    strcpy(#crv_mnu, ttl);
    crv_MenuAdd(#crv_mnu, "Curves", cur, ok_empty);
    gfx_x = mouse_x; gfx_y = mouse_y;
    m = gfx_showmenu(#crv_mnu);
    uix_menu_end(m > 0);
    ((m >= 2) && (m < 2 + CRV_MX)) ? m - 2 : -1;
);

// The pad of the editors (shared : its labels are set before each drawing)
CRV_PSIZ = 8;
pad_Crv = make_jpad(ui_jpad_ty_act | ui_jpad_mk_labs | ui_jpad_mk_colors, 1, CRV_PSIZ, CRV_PSIZ);
pad_Crv_Labs = pad_Crv + pad_Crv[ui_jpad_labs];
pad_Crv_Colrs = pad_Crv + pad_Crv[ui_jpad_clrs];
i__k = 0; loop(CRV_PSIZ, pad_Crv_Colrs[i__k] = Col_P1; pad_Crv_Labs[i__k] = ""; i__k += 1;);

/*
    (2026-11-24, step 4) The exports : a curve as a block of the settings (crv_XpCurve : its lines in the text of mSL_Export ;
    its id : its name, else its number) ; crv_Export(k) : the curve k (k < 0 : all the curves) in a file of the folder of the
    project (Data/name-app-curve-date.mSL, app : #crv_xAp), written by CMGS-auxiliary.eel ; crv_XpPoll (each run of @gfx) :
    the file written, or not. The place of each module (crv_mr, crv_mf : the frame drawn) : a file dropped on it, its first
    block Curve goes into the curve it shows (crv_DropTarget, crv_tbDrop).
*/
// (the host : its short name in the files, its name in the texts, the first words of its settings : Interstys sets them)
#crv_xAp = "d3"; #crv_xApp = "Diffusion 3"; #crv_xHd = "";
crv_mr = make_array(4 * CRV_NE); crv_mf = make_array(CRV_NE);
i__k = 0; loop(CRV_NE, crv_mf[i__k] = -10; i__k += 1;);
function crv_XpCurve(k) local(b, n, p, q)
(
    b = crv_B(k);
    (strlen(crv_nm[k]) > 0) ? sprintf(#crv_xt, "Curve \"%s\"", crv_nm[k]) : sprintf(#crv_xt, "Curve %d", k + 1);
    strcat(#crv_xt, sprintf(#crv_xv, "  type %s", crv_tyN[b[crv_fT]]));
    (b[crv_fF] & CRV_PER) ? strcat(#crv_xt, "  periodic On");
    (b[crv_fSus] >= 0) ? strcat(#crv_xt, sprintf(#crv_xv, "  sustain %d", b[crv_fSus] + 1));
    strcat(#crv_xt, "  points");
    xpt_Block(#crv_xt, 4);
    n = b[crv_fN]; p = b + crv_fP;
    while (n > 0) (
        strcpy(#crv_xt, "");
        // (4 points per line, 6 digits : a line of the file)
        q = 0; loop(min(4, n), strcat(#crv_xt, sprintf(#crv_xv, "%s%.6g %.6g %.6g", (q > 0) ? "   " : "", p[0], p[1], p[2])); p += 3; q += 1;);
        n -= q;
        xpt_Block(#crv_xt, 8);
    );
);
function crv_XpErr(msg)
(
    sprintf(#crv_xm, "ERR: 1656    Curves : export : %s", msg);
    mSL_log(SysLogBox, #crv_xm);
    mSL_ErrNote(1656, msg);
    1656;
);
function crv_Export(k) local(c, i, cnt)
(
    cnt = 0; i = 0; loop(CRV_MX, (((k < 0) || (i === k)) && crv_Ex(i)) ? (cnt += 1); i += 1;);
    (cnt === 0) ? crv_XpErr("no curve") :
    ((c = xpt_Ready()) !== 0) ? (
        crv_XpErr((c === 1) ? "no auxiliary script (CMGS-auxiliary.eel) : nothing is written" :
            (c === 2) ? "the auxiliary script CMGS-auxiliary.eel must be started again (an old version)" :
            "the auxiliary script is busy : try again");
    ) : (
        (k >= 0) ? ( (strlen(crv_nm[k]) > 0) ? strcpy(#crv_xn, crv_nm[k]) : sprintf(#crv_xn, "Curve%d", k + 1); ) : strcpy(#crv_xn, "Curves");
        xpt_Clean(#crv_xn);
        xpt_FileName(#crv_xf, #crv_xn, #crv_xAp, (k >= 0) ? "curve" : "curves");
        xpt_Date(#crv_xd, 1);
        xpt_Begin();
        (k >= 0) ? sprintf(#crv_xt, "print(\"%s : courbe %d de %s, exportee le %s.\");", #crv_xn, k + 1, #crv_xApp, #crv_xd) :
            sprintf(#crv_xt, "print(\"Curves : %d courbe%s de %s, exportee%s le %s.\");", cnt, (cnt > 1) ? "s" : "", #crv_xApp,
                (cnt > 1) ? "s" : "", #crv_xd);
        xpt_Line(#crv_xt);
        xpt_Line("");
        xpt_Line(sprintf(#crv_xt, "%c*", '/'));
        xpt_Line("  Deposee sur un module Curves, la premiere courbe va dans la courbe qu'il montre. Ailleurs : une courbe nommee");
        xpt_Line("  remplace la courbe de meme nom, ou prend la premiere courbe libre ; sans nom : la courbe de meme numero.");
        xpt_Line("  Chaque point : x y c (x de 0 a 1 ; y la valeur, de 0 a 1 pour les enveloppes, de -1 a 1 pour les formes d'onde ;");
        xpt_Line("  c la courbure du segment qui part du point, de -1 a 1).");
        xpt_Line(sprintf(#crv_xt, "*%c", '/'));
        xpt_Line("");
        xpt_Line(sprintf(#crv_xt, "var r = settings(data(%s", #crv_xHd));
        i = 0; loop(CRV_MX, (((k < 0) || (i === k)) && crv_Ex(i)) ? crv_XpCurve(i); i += 1;);
        xpt_Line("));");
        sprintf(#crv_xt, "print(sprintf(0, \"%s : settings %%d (0 : OK)\", r));", #crv_xn);
        xpt_Line(#crv_xt);
        xpt_Ov ? crv_XpErr("the text is too long : nothing is written") : (
            xpt_Who = 'crv';
            xpt_Send(#crv_xf);
            sprintf(#crv_xm, "Curves : export of %d curve%s : %s", cnt, (cnt > 1) ? "s" : "", #crv_xf);
            mSL_log(SysLogBox, #crv_xm);
            0;
        );
    );
);
function crv_XpPoll() local(r)
(
    ((r = xpt_PollFor('crv')) !== 0) ? (
        (r > 0) ? (
            sprintf(#crv_xm, "Curves : export : %s written in the folder of the project", #crv_xf);
            mSL_log(SysLogBox, #crv_xm);
        ) : (
            crv_XpErr(sprintf(#crv_xv, "the file %s can't be written", #crv_xf));
        );
    );
);
// the curve shown by the module Curves under the mouse (drawn in the last frame), or -1
function crv_DropTarget() local(e, r, m, p)
(
    r = -1; e = 0;
    loop(CRV_NE,
        m = crv_mr + 4 * e;
        ((r < 0) && (crv_mf[e] >= gfx_executed - 1) && (mouse_x >= m[0]) && (mouse_y >= m[1]) && (mouse_x < m[0] + m[2]) &&
            (mouse_y < m[1] + m[3])) ? ( p = crv_ed + e * CRV_ES; r = p[0]; );
        e += 1;
    );
    r;
);

// The cell c of the pad of the curve k clicked (rc : the right clic ; sh : Shift)
function crv_Cell(k, c, rc, sh) local(b, ok, i, m, q)
(
    b = crv_B(k); ok = crv_Ex(k);
    (c === 0) ? (
        // the curve shown : left, the next one (Shift : the previous one) ; right, the menu
        rc ? (((m = crv_Menu("#The curve shown", k, 1)) >= 0) ? (crv_uiK = m)) : (crv_uiK = (k + (sh ? CRV_MX - 1 : 1)) % CRV_MX);
    ) :
    ((c === 1) && ok && !rc) ? (
        // the name : edited by the prompt in #crv_ren, taken when the prompt is closed (crv_Rename)
        strcpy(#crv_ren, crv_nm[k]); crv_renK = k;
        sprintf(#crv_renT, "Name of the curve %d (empty : no name)...", k + 1);
        ui_screen_open("control.prompt");
        ui_screen_arg(0, #crv_ren);
        ui_screen_arg(1, #crv_renT);
    ) :
    ((c === 2) && ok) ? (
        // the type : left, the next one (Shift : the previous one), in the order of crv_tyO ; right, the menu
        i = 0; while ((i < CRV_NTY - 1) && (crv_tyO[i] !== b[crv_fT])) ( i += 1; );
        rc ? (
            strcpy(#crv_mnu, "#The type of the curve");
            m = 0; loop(CRV_NTY, sprintf(#crv_it, "|%s%s", (m === i) ? "!" : "", crv_tyL[crv_tyO[m]]); strcat(#crv_mnu, #crv_it); m += 1;);
            gfx_x = mouse_x; gfx_y = mouse_y;
            m = gfx_showmenu(#crv_mnu) - 2; uix_menu_end(m >= 0);
        ) : (
            m = (i + (sh ? CRV_NTY - 1 : 1)) % CRV_NTY;
        );
        ((m >= 0) && (m < CRV_NTY) && (crv_tyO[m] !== b[crv_fT])) ? (
            crv_Pre(k); crv_Commit();
            b[crv_fT] = crv_tyO[m];
            crv_Clamp(b);
        );
    ) :
    ((c === 4) && ok && !rc && ((b[crv_fT] === CRV_ENV) || (b[crv_fT] === CRV_WAVE))) ? (
        crv_Pre(k); crv_Commit();
        b[crv_fF] = b[crv_fF] ~ CRV_PER;
        crv_Clamp(b);
    ) :
    ((c === 5) && !rc) ? (
        i = 0; while ((i < 4) && (crv_gridN[i] !== crv_grid)) ( i += 1; );
        crv_grid = crv_gridN[(i + (sh ? 4 : 1)) % 5];
    ) :
    ((c === 6) && !rc) ? (
        crv_Undo(k);
        crv_SelClear();
    ) :
    (c === 7) ? (
        // Actions (both clics)
        sprintf(#crv_mnu, "#Curve %d|New envelope|New half envelope (H-Envelope)|New waveform|New quarter waveform (Q-Waveform)|New half waveform (H-Waveform)||%sDuplicate into the first free curve|%sDump in the log||%sSustain : the selected point|%sSustain : none||%sDelete||%sExport : this curve (mSL settings)|Export : all the curves (mSL settings)",
            k + 1, ok ? "" : "#", ok ? "" : "#", (ok && (b[crv_fT] === CRV_ENV)) ? "" : "#", (ok && (b[crv_fSus] >= 0)) ? "" : "#", ok ? "" : "#",
            ok ? "" : "#");
        gfx_x = mouse_x; gfx_y = mouse_y;
        m = gfx_showmenu(#crv_mnu); uix_menu_end(m > 0);
        ((m >= 2) && (m <= 6)) ? (
            // a new curve (the one shown, replaced : Undo)
            crv_Pre(k); crv_Commit();
            crv_Default(b, crv_tyO[m - 2]);
            crv_SelClear();
        ) :
        ((m === 7) && ok) ? (
            i = 0; while ((i < CRV_MX) && crv_Ex(i)) ( i += 1; );
            (i < CRV_MX) ? (
                q = crv_B(i); memcpy(q, b, CRV_BS); strcpy(crv_nm[i], ""); q[crv_fSel] = -1;
                crv_uiK = i;
                sprintf(#crv_msg, "Curve %d : duplicated into the curve %d", k + 1, i + 1);
            ) : (
                sprintf(#crv_msg, "Curve %d : no free curve (%d)", k + 1, CRV_MX);
            );
            mSL_log(SysLogBox, #crv_msg);
        ) :
        ((m === 8) && ok) ? (
            crv_Dump(k);
        ) :
        ((m === 9) && ok) ? (
            // (the selected point, even if it is already the sustain)
            i = b[crv_fSel];
            crv_SetSus(b, k, ((i >= 0) && (i < b[crv_fN]) && crv_selF[i]) ? i : -2);
        ) :
        ((m === 10) && ok) ? (
            crv_SetSus(b, k, -1);
        ) :
        ((m === 11) && ok) ? (
            crv_Pre(k); crv_Commit();
            memset(b, 0, CRV_BS); strcpy(crv_nm[k], "");
            crv_SelClear();
        ) :
        // (2026-11-24, step 4) the exports (mSL settings)
        ((m === 12) && ok) ? crv_Export(k) :
        (m === 13) ? crv_Export(-1);
    );
    ui_GFXdoNow |= 4;
);

// The module "Curves A" ... (the editor e ; blockId : the module) : the pad, the graph (its height follows the pane), a line of
// text (x and y under the mouse, or the selected point)
function crv_Editor(blockId, e)
local (h1, hg, h3, hneed, zzmi, i, k, b, ok, zz, c, x0, w, mx, v, cgh)
(
    crv_EdGet(e);
    // the prompt of the name closed (OK or Cancel) : the new name, if it changed
    ((crv_renK >= 0) && !(ui_screen() == "control.prompt")) ? ( crv_Rename(crv_renK, #crv_ren); crv_renK = -1; );
    k = crv_uiK = max(0, min(CRV_MX - 1, crv_uiK|0));
    b = crv_B(k); ok = crv_Ex(k);
    (crv_selK !== k) ? ( crv_SelClear(); crv_selK = k; ok ? (b[crv_fSel] = -1); );
    h1 = uix_jpadHeight(1);
    h3 = uix_jBoxHeight(1);
    hg = max(100, min(ui_width() * 0.5, ui_height() - h1 - h3 - ui_jd_ctgr - 8));
    hneed = h1 + (ok ? hg + h3 : 0) + ui_jd_ctgr + 8;
    (ui_height() >= hneed) ? (
        ui_split_top(hneed);
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            // (2026-11-24, step 4) the place of the module : a file dropped on it (crv_DropTarget)
            crv_mr[4 * e] = ui_left_retina(); crv_mr[4 * e + 1] = ui_top_retina();
            crv_mr[4 * e + 2] = ui_width_retina(); crv_mr[4 * e + 3] = ui_height_retina();
            crv_mf[e] = gfx_executed;
            (zzmi && (uix_click1 || uix_click2)) ? (crv_lastE = e); // (2026-11-24 : the marks of this editor, crv_MarkE)
            zzmi ? (
                ui_push();
                    ui_color(Col_Frame);
                    ui_border();
                ui_pop();
                // keys : d the curve in the log ; h the selected point is the sustain point (again : none) ; z Undo ; Cmd + A
                // all the points
                (ok && GM_key_take('d')) ? crv_Dump(k) :
                (ok && GM_key_take('h')) ? crv_SetSus(b, k, -2) :
                GM_key_take('z') ? (crv_Undo(k); crv_SelClear(); ui_GFXdoNow |= 4;) :
                (ok && (GM_key_mods() & 4) && (GM_key_take('a') || GM_key_take(1))) ? (
                    i = 0; loop(b[crv_fN], crv_selF[i] = 1; i += 1;);
                    b[crv_fSel] = 0; ui_GFXdoNow |= 4;
                );
            );
            sprintf(#crv_ttl, "Curves %c", 'A' + e);
            control_group(#crv_ttl);
            ui_pad(0, ui_cg_pad_top, 0, ui_cg_pad_bottom);
            // the pad
            ui_split_top(h1);
                ui_pad(1, 2, 2, 2);
                mSL_setStrArray(pad_Crv_Labs, CRV_PSIZ);
                sprintf(pad_Crv_Labs[0], "Curve %d", k + 1);
                ok ? (
                    (strlen(crv_nm[k]) > 0) ? strcpy(pad_Crv_Labs[1], crv_nm[k]) : strcpy(pad_Crv_Labs[1], "(no name)");
                    strcpy(pad_Crv_Labs[2], crv_tyL[b[crv_fT]]);
                    sprintf(pad_Crv_Labs[3], "%d points", b[crv_fN]);
                    strcpy(pad_Crv_Labs[4], (b[crv_fF] & CRV_PER) ? "Periodic" : "Not periodic");
                ) : (
                    strcpy(pad_Crv_Labs[1], "No curve");
                    strcpy(pad_Crv_Labs[2], "-"); strcpy(pad_Crv_Labs[3], "-"); strcpy(pad_Crv_Labs[4], "-");
                );
                (crv_grid > 0) ? sprintf(pad_Crv_Labs[5], "Grid %d", crv_grid) : strcpy(pad_Crv_Labs[5], "No grid");
                strcpy(pad_Crv_Labs[6], "Undo");
                strcpy(pad_Crv_Labs[7], "Actions");
                // the roles (GUI rubric) : the curve (Navigation), its name (Action), its type (Choice), its points
                // (Information), periodic, the grid (Choice), Undo, Actions (Action)
                ui_jpad_roles_set(pad_Crv, 0, "naciccaa");
                i = 0; loop(CRV_PSIZ, ui_jpad_mark(pad_Crv, i, 0, 0); ui_jpad_lock(pad_Crv, i, 0); i += 1;);
                i = 1; loop(4, ui_jpad_mark(pad_Crv, i, 0, !ok); i += 1;);
                ui_jpad_mark(pad_Crv, 4, ok && (b[crv_fF] & CRV_PER), !ok || ((b[crv_fT] !== CRV_ENV) && (b[crv_fT] !== CRV_WAVE)));
                ui_jpad_mark(pad_Crv, 5, crv_grid > 0, 0);
                ui_jpad_mark(pad_Crv, 6, 0, crv_undoK !== k);
                zz = control_jpad(pad_Crv);
                (zz > 0) ? (
                    c = pad_Crv[ui_jpad_last] - 1;
                    (zz & (ui_jpad_ev_lmc | ui_jpad_ev_rmc)) ? crv_Cell(k, c, zz & ui_jpad_ev_rmc, mouse_cap & 8);
                    ui_GFXdoNow |= 4;
                );
            ui_pop();
            // the graph, then x and y under the mouse
            k = crv_uiK = max(0, min(CRV_MX - 1, crv_uiK|0)); b = crv_B(k); ok = crv_Ex(k);
            (crv_selK !== k) ? ( crv_SelClear(); crv_selK = k; ok ? (b[crv_fSel] = -1); );
            ok ? (
                ui_split_top(hg);
                    ui_pad(1, 2, 2, 2);
                    crv_Edit(b, k);
                    crv_Draw(b);
                    // (2026-11-24) the playheads of the host, in the editor of the marks (crv_MarkE ; none yet : all)
                    (((i = crv_MarkE()) < 0) || (i === e)) ? crv_DrawPh(b, k);
                    cgh = ui_hover();
                    x0 = ui_left_retina(); w = ui_width_retina();
                    // (2026-11-24) the marks of this editor (crv_MarkE) : its graph drawn, the x under the mouse (not while a
                    // point or a segment is dragged)
                    crv_seenF[e] = gfx_executed;
                    crv_hovX[e] = (cgh && !crv_mDrag) ? max(0, min(1, (mouse_x - x0 - CRV_PAD) / max(1, w - 1 - 2 * CRV_PAD))) : -1;
                    cgh ? (crv_lastE = e);
                ui_pop();
                ui_split_top(h3);
                    ui_pad(4, 2, 4, 2);
                    ui_pcolor(ui_jcolor_text);
                    ui_align(0, 0.5);
                    (((i = crv_SelCount(b[crv_fN])) > 1) && (crv_mDrag || !cgh)) ? (
                        ui_text(sprintf(#crv_txt, "%d points selected", i));
                    ) :
                    (((i = b[crv_fSel]) >= 0) && (i < b[crv_fN]) && crv_selF[i] && (crv_mDrag || !cgh)) ? (
                        v = b + crv_fP + 3 * i;
                        ui_text(sprintf(#crv_txt, "Point %d :  x %.4f   y %.4f   c %.3f%s", i + 1, v[0], v[1], v[2],
                            (i === b[crv_fSus]) ? "   (sustain)" : ""));
                    ) :
                    cgh ? (
                        mx = max(0, min(1, (mouse_x - x0 - CRV_PAD) / max(1, w - 1 - 2 * CRV_PAD)));
                        ui_text(sprintf(#crv_txt, "x %.4f   y %.4f", mx, crv_Val(b, mx)));
                    ) :
                    ((i = b[crv_fSus]) >= 0) ? (
                        v = b + crv_fP + 3 * i;
                        ui_text(sprintf(#crv_txt, "y in [0, 1]   sustain : point %d (x %.4f, y %.4f)", i + 1, v[0], v[1]));
                    ) : (
                        i = b[crv_fT];
                        ui_text((i === CRV_ENV) ? "y in [0, 1]" : (i === CRV_WAVE) ? "y in [-1, 1]" :
                            (i === CRV_HENV) ? "the rise, y in [0, 1] (the fall : its mirror)" :
                            (i === CRV_QWAVE) ? "a quarter of the waveform, y in [-1, 1] (the first y : 0)" :
                            "the first half of the waveform, y in [-1, 1] (the second : its symmetric about the middle)");
                    );
                ui_pop();
            );
        ui_pop();
    );
    crv_EdPut(e);
);

// Saved with the project : the curves that exist (record 'crv1' : CRV_MX, CRV_BS, CRV_NE ; then for each curve [its index, its
// count of points, 1 if it has a name, 0], its header and its points, its name ; [-1 ...] at the end ; then the curve shown
// and the grid of each editor)
function crv_Serialize() local(k, b, n, go, e, p)
(
    (file_avail(0) >= 0) ? (
        // ===LOAD===
        (file_avail(0) > 0) ? (
            memset(ser_hdr, 0, 4);
            load_mem(0, ser_hdr, 4);
            ((ser_hdr[0] === 'crv1') && (ser_hdr[1] === CRV_MX) && (ser_hdr[2] === CRV_BS) && (ser_hdr[3] === CRV_NE)) ? (
                memset(crv_blk, 0, CRV_MX * CRV_BS);
                k = 0; loop(CRV_MX, strcpy(crv_nm[k], ""); k += 1;);
                go = 1;
                while (go && (file_avail(0) > 0)) (
                    memset(crv_sv, 0, 4);
                    load_mem(0, crv_sv, 4);
                    k = crv_sv[0]; n = crv_sv[1];
                    ((k >= 0) && (k < CRV_MX) && (n >= 2) && (n <= CRV_PMX)) ? (
                        b = crv_B(k);
                        load_mem(0, b, crv_fP + 3 * n);
                        b[crv_fU] = 1; b[crv_fN] = n; b[crv_fSel] = -1;
                        crv_Clamp(b);
                        crv_sv[2] ? file_string(0, crv_nm[k]);
                    ) : (
                        go = 0;
                    );
                );
                memset(crv_sv, 0, 2 * CRV_NE);
                load_mem(0, crv_sv, 2 * CRV_NE);
                e = 0;
                loop(CRV_NE,
                    p = crv_ed + e * CRV_ES;
                    p[0] = max(0, min(CRV_MX - 1, crv_sv[2 * e]|0)); p[1] = max(0, min(32, crv_sv[2 * e + 1]|0));
                    e += 1;
                );
                crv_undoK = crv_preK = -1;
                mSL_log(SysLogBox, "Curves : loaded");
            );
        );
    ) : (
        // ===SAVE===
        ser_hdr[0] = 'crv1'; ser_hdr[1] = CRV_MX; ser_hdr[2] = CRV_BS; ser_hdr[3] = CRV_NE;
        save_mem(0, ser_hdr, 4);
        k = 0;
        loop(CRV_MX,
            b = crv_B(k);
            (b[crv_fU] > 0) ? (
                crv_sv[0] = k; crv_sv[1] = b[crv_fN]; crv_sv[2] = (strlen(crv_nm[k]) > 0); crv_sv[3] = 0;
                save_mem(0, crv_sv, 4);
                save_mem(0, b, crv_fP + 3 * b[crv_fN]);
                crv_sv[2] ? file_string(0, crv_nm[k]);
            );
            k += 1;
        );
        crv_sv[0] = -1; crv_sv[1] = crv_sv[2] = crv_sv[3] = 0;
        save_mem(0, crv_sv, 4);
        e = 0; loop(CRV_NE, p = crv_ed + e * CRV_ES; crv_sv[2 * e] = p[0]; crv_sv[2 * e + 1] = p[1]; e += 1;);
        save_mem(0, crv_sv, 2 * CRV_NE);
    );
);

<? _suppress = 0; ?>
