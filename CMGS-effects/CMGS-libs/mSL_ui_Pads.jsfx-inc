ui_jdrag_cell = -1;         // its cell
ui_jdrag_v = ui_jdrag_v0 = ui_jdrag_lo = ui_jdrag_hi = ui_jdrag_px = ui_jdrag_fl = 0;
ui_jdrag_x0 = ui_jdrag_y0 = ui_jdrag_mv = 0;
ui_jdrag_lx = ui_jdrag_ly = ui_jdrag_p = 0;                         // the last mouse position, the accumulated move
ui_jdrag_cl = ui_jdrag_cr = ui_jdrag_ct = ui_jdrag_cb = 0;          // the cell : left, right, top, bottom

// The left button has just been pressed in the current viewport (the pad), without Shift
function ui_jdrag_can_start()
(
    ui_mouse_down(1) && !(mouse_cap & 8);
);

function ui_jdrag_start(owner, cell, v, lo, hi, px, flags)
(
    ui_jdrag_own = owner; ui_jdrag_cell = cell;
    ui_jdrag_v = ui_jdrag_v0 = v; ui_jdrag_lo = lo; ui_jdrag_hi = hi; ui_jdrag_px = max(1, px); ui_jdrag_fl = flags;
    ui_jdrag_x0 = ui_jdrag_lx = uix_mouse_x; ui_jdrag_y0 = ui_jdrag_ly = uix_mouse_y; ui_jdrag_mv = ui_jdrag_p = 0;
