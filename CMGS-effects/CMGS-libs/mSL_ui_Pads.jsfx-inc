/*

    =============================== Leds and Pads ===============================

    === Mouse Buttons ===
    1: left mouse button
    2: right mouse button
    4: Control key (Windows), Command key (OSX)
    8: Shift key
    16: Alt key (Windows), Option key (OSX)
    32: Windows key (Windows), Control key (OSX)
    64: middle mouse button

*/

@init

uix_jled_col_off = 0xA9A9A9 ; // "off" default color
uix_jled_minsize = 6; // min. size

ui_jled_type = ui_jbtype; // for type "led"
ui_jled_spos = ui_jbsize; // size position
ui_jled_w = 2; // width
ui_jled_h = 3; // height
ui_jled_r = 4; // corner size if any
ui_jled_c_on = 5; // color "on"
ui_jled_status = 6; // on/off status
ui_jled_alt = 7; // alternate value
ui_jled_menu1 = 8;
ui_jled_menu2 = 9;
ui_jled_mk_round = 0x40;
ui_jled_mk_rrect = 0x80;
ui_jled_mk_interact = 0x100;
ui_jled_mk_actOnSel = 0x200;
ui_jled_mk_cartr = ui_jled_mk_round | ui_jled_mk_rrect;
ui_jledty = 10;
ui_jled_size = 10; // size of a led structure


function make_jled(flags, w, h, c)
local (led)
(
    led = make_array(ui_jled_size, 'led_');
    led[ui_jbtype] = ui_jledty | flags;
    led[ui_jbsize] = ui_jled_size;
    led[ui_jled_w] = w;
    led[ui_jled_h] = h;
    led[ui_jled_c_on] = c;
    led[ui_jled_r] = 0;
    led[ui_jled_status] = 0;
    led[ui_jled_alt] = 0;
    led[ui_jled_menu1] = 0;
    led[ui_jled_menu2] = 0;
    led;
);


function show_jled(led, val, uc)
local (x, r, ty, curw, curh, askw, askh, lpad, tpad, flgs, z, color, askr, rr, lxc, lyc, lrc)
(
    r = 0;
    (led[ui_jbtype] & ui_jbtmask == ui_jledty) ? (
        flgs = led[ui_jbtype] & ui_jbfmask;
        curw = ui_width(); curh = ui_height();
        (curw > uix_jled_minsize) && (curh > uix_jled_minsize) ? (
            askw = led[ui_jled_w]; askh = led[ui_jled_h];
            (askw <= 0) ? ( askw = curw; ) : (askw <= 1) ? ( askw *= curw; ) :
                  ( askw = min(askw, curw); );
            (askh <= -1) ? (askh = askw = min(askw, curh); ) :
            (askh <= 0) ? ( askh = curh; ) : (askh <= 1) ? ( askh *= curh; ) :
                  ( askh = min(askh, curh); );
            askw = max(uix_jled_minsize, askw);
            askh = max(uix_jled_minsize, askh);
            lpad = (curw-askw)/2; tpad = (curh-askh)/2; // pads
            ty = flgs & ui_jled_mk_cartr;
            led[ui_jled_status] = val;
            color = val < 0.5 ? uix_jled_col_off :
                (uc < 0) ? led[ui_jled_c_on] : uc;
            (ty == 0) ? (
                ui_pad(lpad, tpad);
                ui_pcolor(ui_jcolor_draw);
                ui_fill();
                ui_pad(1, 1);
                ui_pcolor(color);
                ui_fill();
            ) :
            (ty == ui_jled_mk_round) ? (
                ui_pcolor(color);
                lxc = ui_left() + curw/2; lyc = ui_top() + curh/2; lrc = min(askw, askh)/2;
                gfx_circle(lxc, lyc, lrc-1, 1);
                ui_pcolor(ui_jcolor_draw);
                gfx_circle(lxc, lyc, lrc, 0);
            ) :
            (ty == ui_jled_mk_rrect) ? (
                askr = led[ui_jled_r]; rr = 0 | (min(askh, askw)/2.1);
                (askr <= 0) ? ( askr = 0.4*rr; ) : (askr <= 1) ? ( askr *= rr; ) :
                              ( askr = min(askr, rr); );
                ui_pad(lpad, tpad);
                ui_pcolor(ui_jcolor_draw);
                gfx_fillrrect(ui_left(),ui_top(),ui_width(),ui_height(),askr);
                ui_pcolor(color);
                gfx_fillrrect(ui_left()+1,ui_top()+1,ui_width()-2,ui_height()-2,askr);
            ) :
            /* (ty == ui_jled_mk_cartr) ? */
            (
                ui_pad(lpad, tpad);
                ui_pcolor(ui_jcolor_draw);
                gfx_fillrcart(ui_left(),ui_top(),ui_width(),ui_height());
                ui_pcolor(color);
                gfx_fillrcart(ui_left()+1,ui_top()+1,ui_width()-2,ui_height()-2);
            );
        );

        // should we interact ?
        (flgs & ui_jled_mk_interact) ? (
            ui_hover() ? (
                // Mouse pointer in our window : 'x' toggles the led
                GM_key_take('x') ? (
                    led[ui_jled_status] = led[ui_jled_status] > 0.5 ? 0 : 1;
                    r = 1;
                );
                ((x = led[ui_jled_menu1]) != 0) ? (
                    (x == 1) ? (
                        // use left clic to on/off
                        ui_click(1) ? (
                            led[ui_jled_status] = led[ui_jled_status] > 0.5 ? 0 : 1;
                            r = 1;
                        );
                    ) :
                    (x == 2) ? (
                        // use right clic to on/off
                        ui_click(2) ? (
                            led[ui_jled_status] = led[ui_jled_status] > 0.5 ? 0 : 1;
                            r = 1;
                        );
                    ) :
                    (x == 3) ? (
                        // accept both buttons
                        (ui_click(1) || ui_click(2)) ? (
                            led[ui_jled_status] = led[ui_jled_status] > 0.5 ? 0 : 1;
                            r = 1;
                        );
                    ) :
                    (x == 4) ? (
                        // Use the std. on/off menu
                        (ui_jled_def_menu != 0) ? (
                            ui_menu_tick(ui_jled_def_menu, led[ui_jled_status]+1, 1);
                            z = control_jmenu(ui_jled_def_menu);
                            (z != 0) ? (
                                led[ui_jled_status] = z - 1;
                                r = 1;
                            );
                        );
                    ) : (
                        // use X as a control menu
                        ui_menu_tick(x, led[ui_jled_status]+1, 1);
                        z = control_jmenu(x);
                        (z != 0) ? (
                            led[ui_jled_status] = z-1;
                            r = 2;
                        );
                    );
                );
                ((x = led[ui_jled_menu2]) != 0) ? (
                    ui_menu_tick(x, led[ui_jled_alt]+1, 1);
                    z = control_jmenu(x);
                    (z != 0) ? (
                        led[ui_jled_alt] = z-1;
                        r = 4; // alt value changed
                        // should we activate ?
                        (flgs & ui_jled_mk_actOnSel) ? (led[ui_jled_status] = 1; r = 5; );
                    );
                );
                ui_GFXdoNow |= (r !=0);
            );
        );
    );
    r;
);

function show_jled(led, val)
(
    show_jled(led, val, -1);
);

function show_jled(led)
(
    show_jled(led, led[ui_jled_status], -1);
);






///-------------------------------------///
///----------  Pad Utilities -----------///


ui_jpad_typ = ui_jbtype;  // pad type and flags
ui_jpad_bsize = ui_jbsize; // block pad size
ui_jpad_last = 2; // last clicked entry number
ui_jpad_lmods = 3; // modifiers when last clicked
ui_jpad_rflags = 4; // return flags
ui_jpad_lkey = 5; // last typed char
ui_jpad_entkey = 6; // ent where char was typed
ui_jpad_lslider = 7; // last slider
ui_jpad_nli = 8;  // number of displayed lines
ui_jpad_nco = 9;  // number of displayed columns
ui_jpad_siz = 10; // pad size as cell count - can be > or < than lines*columns
ui_jpad_gloff = 11;  // global offset
ui_jpad_linc = 12; // line increment
ui_jpad_cinc = 13; // column increment
ui_jpad_border= 14; // border size
ui_jpad_cells = 15; // cells types and flags [array address]
ui_jpad_labs = 16; // labels addresses [array address]
ui_jpad_altlabs = 17; // alt labels addresses [array address]
ui_jpad_clrs = 18; // colors addresses [array address]
ui_jpad_altclrs = 19; // alt colors addresses [array address]
ui_jpad_values = 20; // numbers associated to cells [array address]
ui_jpad_actns = 21; // actions associated to cells [array address]
ui_jpad_fmts = 22; // string for formatting the values
ui_jpad_color1 = 23; // local color 1
ui_jpad_color2 = 24; // local color 2
ui_jpad_color3 = 25; // local color 3
ui_jpad_color4 = 26; // local color 4
ui_jpad_color5 = 27; // local color 5
ui_jpad_coff = 28;  // global offset
ui_jpad_roles = 29; // (2026-11-22) the roles of the cells [array offset ; negative while no role is set, see ui_jpad_roles_set]
ui_jpad_free = 30; // size of description, and first free entry.

// Description of pad types
ui_jpad_ty_act = 5; // action type : no pad is ever selected
ui_jpad_ty_sel = 6; // selection type : just one selected object
ui_jpad_ty_opt = 7; // options : any pad can be selected
// pad flags
ui_jpad_ty_bord = 0x80; // draw a border around the pad
ui_jpad_ty_nbr = 0x100; // use numbers as labels, starting at 1
ui_jpad_ty_lbs = 0x200; // use label strings from ui_jpad_labs
ui_jpad_ty_cls = 0x400; // use colors from ui_jpad_clrs

// Description of cells type
// ui_jpad_ct_align = 0x30; // align mask
ui_jpad_ct_selec = 0x100; // the cell is selected
ui_jpad_ct_UNselec = 0x7FFFFFFF ~ 0x100; // the cell is selected
ui_jpad_ct_round = 0x200; // draw round cells
ui_jpad_ct_rrect = 0x400; // draw round rectangles cells
ui_jpad_ct_nocolor = 0x800; // no color for this cell
ui_jpad_ct_showval = 0x1000; // show value of cell if any
ui_jpad_ct_nobrd = 0x2000; // no border
ui_jpad_ct_cclear = 0x4000; // set to leave the cell without label
ui_jpad_ct_disab = 0x8000; // set if cell is disabled
ui_jpad_ct_altcol = 0x10000; // set to use alternate color for cell
ui_jpad_ct_lock = 0x20000; // (2026-11-22) a cell with a role : drawn locked (hatched)
ui_jpad_ct_dim = 0x40000; // (2026-11-22) a cell with a role : drawn disabled (as ui_jpad_ct_disab), its clics kept

/*
   (2026-11-22) The roles of the cells (rubric GUI, step 2 : see mSL_GUI and the palette, uix_jp_make in ui-lib-JJ-GUI) :
   one word per cell (the area of pad[ui_jpad_roles]) ; 0 : the cell is drawn with the colors of the pad, as until then ;
   otherwise its role (bits 0-3) gives its color in the palette chosen by the user, and its mode (rest, hover, pressed,
   selected, disabled, locked) its variant : the mode comes from the flags of the cell (ui_jpad_ct_selec, ui_jpad_ct_disab,
   ui_jpad_ct_dim, ui_jpad_ct_lock) and from the mouse.
     bits 4-8 : 0, or 1 + an index (0 ... 15) in the identity series (the colors of what is numbered : projectors,
                channels ...) : the color of the cell, its role giving its behaviour (hover ...)
     bits 9-11 : 0, or 1 + a mode imposed (the preview of the module GUI)
*/
ui_jpad_rl_action = 1;  // opens a menu, starts an operation
ui_jpad_rl_choice = 2;  // On / Off, a mode among several
ui_jpad_rl_nav = 3;     // views, pages, tabs
ui_jpad_rl_value = 4;   // a number (a potentiometer)
ui_jpad_rl_object = 5;  // an item of a list : effect, reader, line ...
ui_jpad_rl_state = 6;   // an indicator, not clickable (selected : lit)
ui_jpad_rl_danger = 7;  // remove, reset
ui_jpad_rl_info = 8;    // a title, a caption, a passive display
ui_jpad_rl_empty = 9;   // an unused cell
ui_jpad_rl_alert = 10;  // (2026-11-22) an alert, an error : orange (Danger red), or a hue of the palette
ui_jpad_rl_ident = 16;  // role + ui_jpad_rl_ident * (1 + k) : the color k of the identity series
ui_jpad_rl_force = 512; // role + ui_jpad_rl_force * (1 + m) : the mode m imposed (0 rest ... 5 locked)

// Creation Flags, not used elsewhere
// Combine with "|", not "+"
ui_jpad_mk_labs = 0x40;
ui_jpad_mk_colors = 0x80;
ui_jpad_mk_values = 0x100;
ui_jpad_mk_actions = 0x200;
ui_jpad_mk_rcells = 0x400; // make round cells
ui_jpad_mk_rrcells = 0x800; // make round rectangles cells
ui_jpad_mk_clnobrd = 0x1000; // no border
ui_jpad_mk_lallign = 0x2000; // left align cell contents
ui_jpad_mk_callign = 0x4000; // center align cell contents
ui_jpad_mk_rallign = 0x8000; // right align cell contents
ui_jpad_mk_colmaj = 0x10000; // use column major order
ui_jpad_mk_altlabs =   0x20000; // use also alt. labels
ui_jpad_mk_altcolors = 0x40000; // use also alt. colors
ui_jpad_mk_cclear =    0x80000; // set to leave the cell without label

// Event flags returned
ui_jpad_ev_cclk = 0x1; // a cell was clicked
ui_jpad_ev_key = 0x2; // a char was keyed
ui_jpad_ev_mov = 0x80; // mouse over event
ui_jpad_ev_lmc = 0x10; // mouse left button clicked
ui_jpad_ev_rmc = 0x20; // mouse right button clicked
ui_jpad_ev_cmc = 0x40; // mouse center button clicked
ui_jpad_ev_slev = 0x100; // slider event

ui_jpad_cl_minWidth = 76; //  minimal width in pixels
/* Modifiers in "ui_jpad_lmods"
    1: left mouse button
    2: right mouse button
    4: Control key (Windows), Command key (OSX)
    8: Shift key
    16: Alt key (Windows), Option key (OSX)
    32: Windows key (Windows), Control key (OSX)
    64: middle mouse button
*/
/*
   Check that a structure is a pad
*/
function uix_jpad_check(pad) local (pty)
(
    // check we have a pad
    pty = pad[ui_jpad_typ] & ui_jbtmask;
    ((pty == ui_jpad_ty_act) || (pty == ui_jpad_ty_sel) || (pty == ui_jpad_ty_opt));
);

/*
    Set or reset a flag for an item of a pad.  ex:
        set_jpad_cell(my_pad, 5, ui_jpad_ty_cls); // set the flag "color" of the fifth cell
        set_jpad_cell(my_pad, 5, -ui_jpad_ty_cls); // reset the flag
    UNUSED - PROBABLY WRONG
*/
function set_jpad_cell(pad, num, flag) local (pty, pc, vcel)
(
    // check that we really have a pad
    pty = pad[ui_jpad_typ] & ui_jbtmask;
    ((pty == ui_jpad_ty_act) || (pty == ui_jpad_ty_sel) || (pty == ui_jpad_ty_opt)) ? (
        ((num >= 1) && (num <= pad[ui_jpad_siz])) ? (
            pc = pad + pad[ui_jpad_cells]; vcel = pc[num-1];
            (flag >= 0) ? (vcel |= flag) : (vcel &= flag -1);
            pc[num-1] = vcel;
            ui_XlocDoNow |= 1;
        );
    );
);


/*
    Select or desselect pad "ent" of matrix "pad"
    [[ internal function ]]
        ent is in [1, #items]
        flag == 0   => desselect
        flag == 1   => select
        flag == -1  => invert
*/
function ui_jpad_select(pad, ent, flag)
local (pty, pp, cel, v, ii, r)
(
    r = 0;
    pty = pad[ui_jpad_typ] & ui_jbtmask;
    ((pty == ui_jpad_ty_act) || (pty == ui_jpad_ty_sel) || (pty == ui_jpad_ty_opt)) ? (
        pp = pad + pad[ui_jpad_cells] -1; // subtract 1 because ent starts at 1
        (ent >=1 && ent <= pad[ui_jpad_siz]) ? (
            // ent is a valid entry
            cel = pp[ent]; // cell entry
            !(cel & ui_jpad_ct_disab) ? (
                (pty == ui_jpad_ty_sel) ? (
                    // only one can be selected at a time
                    v = cel & ui_jpad_ct_selec; // keep current status
                    // reset all
                    ii = 1;
                    loop (pad[ui_jpad_siz],
                        pp[ii] &= -1 ~ ui_jpad_ct_selec; ii += 1;
                    );
                    ((flag > 0) || ((flag < 0) && (v == 0))) ?  pp[ent] |= ui_jpad_ct_selec;
                );
                (pty == ui_jpad_ty_opt) ? ( // any pad can be selected
                    (flag >= 0) ? (
                        flag ? (cel |= ui_jpad_ct_selec) : (cel &= -1 ~ ui_jpad_ct_selec);
                    ) : (
                        cel = cel ~ ui_jpad_ct_selec;
                    );
                    pp[ent] = cel;
                );
                r = 1; // valid choice
            );
            ui_XlocDoNow |= 1;
        ) : (
            (ent == 0) ? (
                // deselect the pads
                //(pty == ui_jpad_ty_sel) ? (
                    ii = 1;
                    loop (pad[ui_jpad_siz],
                        pp[ii] &= -1 ~ ui_jpad_ct_selec; ii += 1;
                    );
                //);
                r = 1; // valid choice
            );
        );
    );
    r;
);


/*
   Draw a control pad and interact with it
*/
// "Soft" look (ui_jstyle) : the color of a cell fills the zone of its text, then fades into the background
ui_jpad_fade = 40; // max width of the fading, in pixels (it never leaves the cell)
ui_jpad_selmix = 0.35; // a selected cell is brighter : its color is mixed with white
// (2026-11-21) The look of the pads, set by the rubric "GUI" (mSL_GUI : the module "GUI", settings(data( GUI ... ))) ;
// the defaults : the look until then. In ui units (the display size and the retina scaling follow) :
ui_jg_gapx = 0;     // the room added between the cells, horizontally : the colored rectangle shrinks (never narrower than
                    // its text), the cell keeps its place (its clics), the pad its size
ui_jg_gapy = 0;     // vertically the same
ui_jg_extend = 0;   // the "soft" look : 1 the fade goes up to the edges of the cell (its frame), whatever ui_jpad_fade
ui_jg_frame = 0;    // the "soft" look : a frame around each cell that has a text : 0 none, 1 a rectangle, 2 rounded
ui_jg_radius = 6;   // the radius of its corners
ui_jg_thick = 1;    // its thickness (units ; 0 : no frame ; the classic style : no border around the cells either)
ui_jg_fcol = 1;     // its color : 0 that of the cell, 1 lighter, 2 darker, 3 grey
ui_jg_falpha = 0.7; // its opacity
ui_jg_cround = -1;  // the variation Std : the radius of the corners of the rectangular cells (-1 : as each pad draws them)
ui_jg_bold = 0;     // the text of the cells : 1 bold (all the styles)
ui_jg_ptext = 100;  // the text of the cells : its size, in % of the texts (80 ... 150 ; all the styles)
ui_jg_tcontrast = 0.35; // the variation Text : the least difference of luminance between the text of a cell and the background
// (2026-11-21) The variation of the cells (the sub-menu "Variation" of the panes, the module GUI) : 0 Std (the cell filled
// with its color, as the classic look until then), 1 Faded (its color around the text, faded : the "soft" look until then),
// 2 Text (its color in its text, no fill) ; -1 : as the style (Classic : Std, Soft : Faded). The style (ui_jstyle) sets
// the rest : Classic, the borders of the cells ; Soft, none (the frame of the rubric GUI, if any)
ui_jvariant = -1;

// (2026-11-21) The rounded rectangles of the rubric GUI, drawn line by line : the circles and gfx_roundrect do not join the
// straight sides well, and overshoot when the radius is more than half the height ; here the fill and the frame of a shape
// have exactly the same edges (anti-aliased : the pixels partly covered get a lower alpha). Pixels ; the current color.
// The inset of the line yy (0 ... h - 1) of the shape of height h, radius r (at most h / 2) :
function uix_jrr_dx(yy, h, r) local(dy)
(
    dy = (yy < r) ? r - (yy + 0.5) : (yy + 0.5 > h - r) ? (yy + 0.5) - (h - r) : 0;
    (dy > 0) ? r - sqrt(max(0, r * r - dy * dy)) : 0;
);
// the span [a, b) of the line yr (the pixels at the ends : partly covered)
function uix_jspan(a, b, yr) local(ia, ib, a0)
(
    (b - a > 0.01) ? (
        a0 = gfx_a;
        ia = ceil(a); ib = floor(b);
        (ib < ia) ? (
            gfx_a = a0 * (b - a); gfx_rect(floor(a), yr, 1, 1);
        ) : (
            (ib > ia) ? gfx_rect(ia, yr, ib - ia, 1);
            (ia - a > 0.02) ? (gfx_a = a0 * (ia - a); gfx_rect(ia - 1, yr, 1, 1););
            (b - ib > 0.02) ? (gfx_a = a0 * (b - ib); gfx_rect(ib, yr, 1, 1););
        );
        gfx_a = a0;
    );
);
// A filled rectangle with rounded corners (pixels : the rectangle (x, y, w, h), as floor(x) ... floor(x + w) ; radius r)
function uix_jfill_rrect(x, y, w, h, r) local(px, py, pw, ph, yy, dx, rb, y1)
(
    px = floor(x); py = floor(y); pw = floor(x + w) - px; ph = floor(y + h) - py;
    r = max(0, min(r, min(pw, ph) / 2));
    (r < 1) ? gfx_rect(px, py, pw, ph) : (
        rb = ceil(r); // the lines of the corners, at the top and at the bottom
        (ph - 2 * rb > 0) ? gfx_rect(px, py + rb, pw, ph - 2 * rb);
        yy = 0; loop(min(rb, ph), dx = uix_jrr_dx(yy, ph, r); uix_jspan(px + dx, px + pw - dx, py + yy); yy += 1;);
        yy = y1 = max(rb, ph - rb);
        loop(ph - y1, dx = uix_jrr_dx(yy, ph, r); uix_jspan(px + dx, px + pw - dx, py + yy); yy += 1;);
    );
);
// Its frame, inside it : thickness t (pixels ; the same edges as uix_jfill_rrect)
function uix_jline_rrect(x, y, w, h, r, t) local(px, py, pw, ph, yy, dxo, dxi, ri)
(
    px = floor(x); py = floor(y); pw = floor(x + w) - px; ph = floor(y + h) - py;
    r = max(0, min(r, min(pw, ph) / 2));
    t = max(1, min(floor(t), floor(min(pw, ph) / 2)));
    ri = max(0, r - t); // the inner shape : (t, t, pw - 2 t, ph - 2 t), radius ri
    yy = 0;
    loop(ph,
        dxo = uix_jrr_dx(yy, ph, r);
        ((yy < t) || (yy >= ph - t)) ? (
            uix_jspan(px + dxo, px + pw - dxo, py + yy);
        ) : (
            dxi = t + uix_jrr_dx(yy - t, ph - 2 * t, ri);
            uix_jspan(px + dxo, px + dxi, py + yy);
            uix_jspan(px + pw - dxi, px + pw - dxo, py + yy);
        );
        yy += 1;
    );
);

// (2026-11-21) The frame of a cell in the "soft" look (ui units : the zone of the cell ; col : its color ; rad : the radius
// of its corners, ui units, whatever ui_jg_frame (the variation Std : the corners of the cell), -1 : ui_jg_radius with
// ui_jg_frame 2 (Round), none with 1 (Rect) ; ui_jg_thick, ui_jg_fcol, ui_jg_falpha)
function uix_jpad_soft_frame(x, y, w, h, col, rad)
local (rs, t, k, r, cr, cg, cb, px, py, pw, ph)
(
    rs = uix_drawconfig_current[9]; // retina scaling
    cr = ((col >> 16) & 0xff) / 255; cg = ((col >> 8) & 0xff) / 255; cb = (col & 0xff) / 255;
    (ui_jg_fcol === 1) ? (cr += 0.45 * (1 - cr); cg += 0.45 * (1 - cg); cb += 0.45 * (1 - cb);) :
    (ui_jg_fcol === 2) ? (cr *= 0.55; cg *= 0.55; cb *= 0.55;) :
    (ui_jg_fcol === 3) ? (cr = cg = cb = 0.62;);
    gfx_set(cr, cg, cb, max(0.05, min(1, ui_jg_falpha)));
    px = floor(x * rs); py = floor(y * rs); pw = floor((x + w) * rs) - px; ph = floor((y + h) * rs) - py;
    t = max(1, floor(ui_jg_thick * rs + 0.5)); // (ui_jg_thick 0 : not called, see control_jpad)
    r = (rad >= 0) ? rad * rs : (ui_jg_frame === 2) ? max(0, ui_jg_radius * rs) : 0;
    (r >= 1) ? uix_jline_rrect(px, py, pw, ph, r, t) : (
        k = 0;
        loop(min(t, floor(min(pw, ph) / 2)), gfx_rect(px + k, py + k, pw - 2 * k, ph - 2 * k, 0); k += 1;);
    );
    gfx_a = 1;
);

// (2026-11-19) The core of the "soft" fill (pixels) : the zone (x0, y0) - (x1, y1) filled with color "col", then faded
// into the actual background (read in the corner of the cell), at most ui_jpad_fade, without leaving the cell
// (cx0, cy0) - (cx1, cy1). Used by uix_jpad_soft_fill (the zone : a text) and the input line of the mSL Console.
function uix_jsoft_zone(cx0, cy0, cx1, cy1, x0, y0, x1, y1, col)
local (rs, f, fl, fr, ft, fb, cr, cg, cb, br, bg, bb, k, ty, yy, kl, kr, kt, kb)
(
    rs = uix_drawconfig_current[9]; // retina scaling
    // the background color, on the left of the cell, half way up (2026-11-21 : not in a corner, where a rounded border of
    // the classic style may pass)
    gfx_x = cx0 + 1; gfx_y = floor((cy0 + cy1) / 2);
    br = bg = bb = 0;
    gfx_getpixel(br, bg, bb);
    // (2026-11-21) a whole number of pixels : gfx_gradrect drops the fractions of x and w, a fractional fade left a
    // dark line of one pixel between the left fade and the zone, once the cell is wide enough for the whole fade
    // ui_jg_extend (rubric GUI) : up to the edges of the cell
    f = ui_jg_extend ? 1000000 : floor(ui_jpad_fade * rs + 0.5);
    fl = min(f, x0 - cx0); fr = min(f, cx1 - x1); ft = min(f, y0 - cy0); fb = min(f, cy1 - y1);
    cr = ((col >> 16) & 0xff) / 255; cg = ((col >> 8) & 0xff) / 255; cb = (col & 0xff) / 255;
    gfx_mode = 0; gfx_a = 1;
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
    gfx_rect(x0, y0, x1 - x0, y1 - y0);
    // the weight of the color (0 : the background, 1 : the color) is taken at the center of each pixel, (k + 0.5) / f,
    // on the four sides and in the corners : the fades are symmetric (no shift of half a pixel between the middle
    // and the sides) ; kl, kr, kt, kb : half a pixel of each fade
    kl = 0.5 / max(1, fl); kr = 0.5 / max(1, fr); kt = 0.5 / max(1, ft); kb = 0.5 / max(1, fb);
    // sides : from the background (outside) to the color (inside)
    (fl >= 1) ? gfx_gradrect(x0 - fl, y0, fl, y1 - y0, br + kl * (cr - br), bg + kl * (cg - bg), bb + kl * (cb - bb), 1,
        (cr - br) / fl, (cg - bg) / fl, (cb - bb) / fl, 0);
    (fr >= 1) ? gfx_gradrect(x1, y0, fr, y1 - y0, cr + kr * (br - cr), cg + kr * (bg - cg), cb + kr * (bb - cb), 1,
        (br - cr) / fr, (bg - cg) / fr, (bb - cb) / fr, 0);
    (ft >= 1) ? gfx_gradrect(x0, y0 - ft, x1 - x0, ft, br + kt * (cr - br), bg + kt * (cg - bg), bb + kt * (cb - bb), 1,
        0, 0, 0, 0, (cr - br) / ft, (cg - bg) / ft, (cb - bb) / ft, 0);
    (fb >= 1) ? gfx_gradrect(x0, y1, x1 - x0, fb, cr + kb * (br - cr), cg + kb * (bg - cg), cb + kb * (bb - cb), 1,
        0, 0, 0, 0, (br - cr) / fb, (bg - cg) / fb, (bb - cb) / fb, 0);
    // corners, one line at a time : the color weight is the product of the horizontal and vertical weights
    (ft >= 1) ? (
        yy = 0; loop(ft,
            ty = (yy + 0.5) / ft; // 0 outside, 1 near the text
            (fl >= 1) ? gfx_gradrect(x0 - fl, y0 - ft + yy, fl, 1,
                br + ty * kl * (cr - br), bg + ty * kl * (cg - bg), bb + ty * kl * (cb - bb), 1,
                ty * (cr - br) / fl, ty * (cg - bg) / fl, ty * (cb - bb) / fl, 0);
            (fr >= 1) ? gfx_gradrect(x1, y0 - ft + yy, fr, 1,
                br + ty * (1 - kr) * (cr - br), bg + ty * (1 - kr) * (cg - bg), bb + ty * (1 - kr) * (cb - bb), 1,
                -ty * (cr - br) / fr, -ty * (cg - bg) / fr, -ty * (cb - bb) / fr, 0);
            yy += 1;
        );
    );
    (fb >= 1) ? (
        yy = 0; loop(fb,
            ty = 1 - (yy + 0.5) / fb; // 1 near the text, 0 outside
            (fl >= 1) ? gfx_gradrect(x0 - fl, y1 + yy, fl, 1,
                br + ty * kl * (cr - br), bg + ty * kl * (cg - bg), bb + ty * kl * (cb - bb), 1,
                ty * (cr - br) / fl, ty * (cg - bg) / fl, ty * (cb - bb) / fl, 0);
            (fr >= 1) ? gfx_gradrect(x1, y1 + yy, fr, 1,
                br + ty * (1 - kr) * (cr - br), bg + ty * (1 - kr) * (cg - bg), bb + ty * (1 - kr) * (cb - bb), 1,
                -ty * (cr - br) / fr, -ty * (cg - bg) / fr, -ty * (cb - bb) / fr, 0);
            yy += 1;
        );
    );

);

// Fills the zone of the text "txt" centered in the rectangle (x, y, w, h) (ui coordinates) with color "col",
// then fades it into the actual background (read in the corner of the rectangle), without leaving the rectangle.
// The fading is an opaque color gradient (the alpha of gfx_gradrect does not blend with the background).
// (2026-11-21) The same, the zone (x, y, w, h) and the rectangle (tx, ty, tww, tht) where the text is centered given apart
// (the classic style : the zone is the inside of the border of the cell, the text is lower)
function uix_jpad_soft_fill_in(x, y, w, h, tx, ty, tww, tht, txt, col)
local (rs, tw, th, cx0, cy0, cx1, cy1, x0, y0, x1, y1, tx0, ty0, tx1, ty1)
(
    ((txt != 0) && (strlen(txt) > 0)) ? (
        rs = uix_drawconfig_current[9]; // retina scaling
        cx0 = floor(x * rs); cy0 = floor(y * rs); cx1 = floor((x + w) * rs); cy1 = floor((y + h) * rs); // the cell, in pixels
        tx0 = floor(tx * rs); ty0 = floor(ty * rs); tx1 = floor((tx + tww) * rs); ty1 = floor((ty + tht) * rs); // the text
        uix_setgfxfont();
        tw = th = 0;
        gfx_measurestr(txt, tw, th);
        x0 = max(cx0, floor((tx0 + tx1 - tw) / 2 - 2 * rs)); x1 = min(cx1, ceil((tx0 + tx1 + tw) / 2 + 2 * rs));
        y0 = max(cy0, floor((ty0 + ty1 - th) / 2)); y1 = min(cy1, ceil((ty0 + ty1 + th) / 2));
        ((x1 > x0) && (y1 > y0)) ? uix_jsoft_zone(cx0, cy0, cx1, cy1, x0, y0, x1, y1, col);
    );
);
function uix_jpad_soft_fill(x, y, w, h, txt, col)
(
    uix_jpad_soft_fill_in(x, y, w, h, x, y, w, h, txt, col);
);

// (2026-11-21) The variation Text (ui_jvariant 2) : the color "col" of a cell, for its text, made readable on the background
// read at (px, py) (pixels) : its luminance kept at least ui_jg_tcontrast away from that of the background (mixed with
// white on a dark background, with black on a light one)
// (the color col made readable on the background (br, bg, bb : 0 ... 1) : d, the least difference of luminance ; also for
// the texts on a background made darker or lighter, see update_theme in ui-lib-JJ-GUI)
function uix_jcontrast(col, br, bg, bb, d)
local (cr, cg, cb, lc, lb, t)
(
    cr = ((col >> 16) & 0xff) / 255; cg = ((col >> 8) & 0xff) / 255; cb = (col & 0xff) / 255;
    lc = 0.299 * cr + 0.587 * cg + 0.114 * cb; lb = 0.299 * br + 0.587 * bg + 0.114 * bb;
    (lb < 0.5) ? (
        (lc < lb + d) ? (
            t = (min(1, lb + d) - lc) / max(0.001, 1 - lc);
            cr += t * (1 - cr); cg += t * (1 - cg); cb += t * (1 - cb);
        );
    ) : (
        (lc > lb - d) ? (
            t = max(0, lb - d) / max(0.001, lc);
            cr *= t; cg *= t; cb *= t;
        );
    );
    ((0|min(255, cr * 255 + 0.5)) << 16) | ((0|min(255, cg * 255 + 0.5)) << 8) | (0|min(255, cb * 255 + 0.5));
);
function uix_jtext_color(col, px, py)
local (br, bg, bb)
(
    gfx_x = px; gfx_y = py; br = bg = bb = 0;
    gfx_getpixel(br, bg, bb);
    uix_jcontrast(col, br, bg, bb, ui_jg_tcontrast);
);

// Guard of control_jpad : max lines / columns drawn ; the last anomaly is kept in ui_jpad_bad_*
ui_jpad_maxdim = 128;
// the room kept free on the right of the text of each cell (not retina scaled ; 0 : none) : the text is centered in the
// rest of the cell (for marks drawn by the host after the pad, see show_Summary_Pad in Interstys) ; set it just before
// control_jpad, back to 0 just after
ui_jpad_txt_rpad = 0;
ui_jpad_bad_pad = ui_jpad_bad_nl = ui_jpad_bad_nc = ui_jpad_bad_cnt = 0;

// (2026-11-21) The border of a cell in the classic style (control_jpad : gx0, gy0, gw, gh the cell less its gaps, ui units ;
// xc, yc, rc : a round cell ; drc, drr, crr : its shape) ; the current color
function uix_jpad_border(gx0, gy0, gw, gh, xc, yc, rc, drc, drr, crr) local(rs, i, x0, y0, x1, y1, g)
(
    rs = uix_drawconfig_current[9]; // retina scaling
    (drc) ? (
        (drr) ? (
            i = -1 + (0|min((gw-4)/2, (gh-4)/2));
            gfx_roundrect(rs * (gx0+1), rs * (gy0+1), rs * (gw-4), rs * (gh-4), rs * i);
        ) : (
            gfx_circle(rs * xc, rs * yc, rs * rc * 1.1, 1);
        );
    ) : (drr) ? (
        gfx_roundrect(rs * (gx0+1), rs * (gy0+1), rs * (gw-4), rs * (gh-4), rs * drr);
    ) : (
        // (2026-11-22) one pixel around the fill (gx0 + 2, gw - 5 : its pixels as uix_jfill_rrect), at floor(rs) - 1 pixels
        // from it : the same distance on the 4 sides at all the display sizes (gfx_roundrect, one unit from the fill, gave
        // 0 or 1 pixel by side at 120 %)
        x0 = floor(rs * (gx0+2)); y0 = floor(rs * (gy0+2));
        x1 = floor(rs * (gx0+2) + rs * (gw-5)); y1 = floor(rs * (gy0+2) + rs * (gh-5));
        g = max(0, floor(rs) - 1) + 1;
        uix_jline_rrect(x0 - g, y0 - g, x1 - x0 + 2 * g, y1 - y0 + 2 * g, (crr > 0) ? rs * crr + g : 0, 1);
    );
);

// (2026-11-22) The mode "locked" of a cell with a role : diagonal lines over the rectangle (x, y, w, h) (pixels), every st
// pixels, in the current color
function uix_jhatch(x, y, w, h, st) local(d, ax, ay, bx, by)
(
    x = floor(x); y = floor(y); w = floor(w); h = floor(h);
    d = floor(st / 2);
    while ((st > 0) && (d < w + h)) (
        (d <= w) ? (ax = x + d; ay = y;) : (ax = x + w; ay = y + d - w;);
        (d <= h) ? (bx = x; by = y + d;) : (bx = x + d - h; by = y + h;);
        gfx_line(ax, ay, bx, by, 1);
        d += st;
    );
);

// (2026-11-22) The pads that have roles (their cells react to the mouse : see uix_jhv_key in mSL_ui_LibJJ, must_do_gfx) :
// their rectangles in the last frame drawn (uix_jhv_tab, uix_jhvN : 7 words each, in pixels : left, top, width and height of
// a cell, columns, lines, the pad), the cell under the mouse then (uix_jhv_cur)
UIX_JHV_MAX = 16;
function uix_jhv_add(pm, left, top, wi, he, nc, nl, rs) local(q)
(
    ((uix_jhv_tab > 0) && (uix_jhvN < UIX_JHV_MAX)) ? (
        q = uix_jhv_tab + 7 * uix_jhvN;
        q[0] = left * rs; q[1] = top * rs; q[2] = wi * rs; q[3] = he * rs; q[4] = nc; q[5] = nl; q[6] = pm;
        uix_jhvN += 1;
        uix_jhv_cur = uix_jhv_key(); // (the same computation as must_do_gfx : the last pad drawn gives it for all of them)
    );
);

// (2026-11-22) The tip : Alt (or Alt + Cmd) and the mouse on a cell of a pad : its number (as in ui_jpad_roles_set), its
// role and its mode, in #uix_jtip_s, drawn near the mouse at the end of the frame (uix_jtip_draw, ui-lib-JJ-GUI ; uix_jtip :
// 0 none, reset by must_do_gfx)
uix_jtip = 0;
function uix_jrole_name(k)
(
    (k === 1) ? "Action" : (k === 2) ? "Choice" : (k === 3) ? "Navigation" : (k === 4) ? "Value" : (k === 5) ? "Object" :
    (k === 6) ? "State" : (k === 7) ? "Danger" : (k === 8) ? "Information" : (k === 9) ? "Empty" : (k === 10) ? "Alert" : "Role";
);
function uix_jmode_name(m)
(
    (m === 1) ? "hover" : (m === 2) ? "pressed" : (m === 3) ? "selected" : (m === 4) ? "disabled" : (m === 5) ? "locked" : "rest";
);
function uix_jtip_set(np, rk, rmo, jr, has)
(
    uix_jtip = 1;
    (rk > 0) ? (
        sprintf(#uix_jtip_s, "Cell %d : %s, %s", np, uix_jrole_name(rk), uix_jmode_name(rmo));
        ((jr >> 4) & 31) ? (sprintf(#uix_jtip_t, " (identity %d)", (jr >> 4) & 31); strcat(#uix_jtip_s, #uix_jtip_t););
        ((jr >> 9) & 7) ? strcat(#uix_jtip_s, " (imposed)");
    ) : (
        sprintf(#uix_jtip_s, has ? "Cell %d : no role (the colors of the pad)" : "Cell %d : no role (a pad without roles)", np);
    );
);

function control_jpad(pm, fnl, fnc, opt)
local (cc2, ty, pty, nl, nc, np, left, top, xpos, ypos, wi, he, xm, nx, ny, ix, iy, rs,
       dc, labs, gloff, isvalid, ctype, cc, cdefs, nums, colors, z1, z2, z3, z4, z5,
       CS, alabs, acolors, selected, fmsin, flevnt, drc, drr, bcl, dcl, i, ms_x, ms_y,
       xc, yc, rc, xcl, ycl, zcl, sst, gx0, gy0, gw, gh, gex, gey, crr, gtw, gth, gtc, vr, ttx, tty, ttw, tth,
       roles, jr, rk, rmo, rb, ovr, sl, sx0, sy0, sg)
(
    ty = pm[ui_jpad_typ]; // pad type and flags
    pty = ty & ui_jbtmask; // just the pad type
    rs = uix_drawconfig_current[9]; // retina scaling
    bcl = ((pm[ui_jpad_color2] >= 0) ? pm[ui_jpad_color2] : ui_jcolor_text);
    dcl = ((pm[ui_jpad_color3] >= 0) ? pm[ui_jpad_color3] : ui_jcolor_draw);
    xcl = ((pm[ui_jpad_color1] >= 0) ? pm[ui_jpad_color1] : bcl);
    ycl = ((pm[ui_jpad_color4] >= 0) ? pm[ui_jpad_color4] : bcl);
    zcl = ((pm[ui_jpad_color5] >= 0) ? pm[ui_jpad_color5] : bcl);
    flevnt = 0; // no event yet
    ((pty == ui_jpad_ty_act) || (pty == ui_jpad_ty_sel) || (pty == ui_jpad_ty_opt)) ? (
        ui_push(); // push viewport to save it
        // (2026-11-21) the text of the cells : bold, larger or smaller (rubric GUI ; the ui_pop at the end restores the font)
        ui_jg_bold ? ui_fontbold(1);
        // the variation of the cells : 0 Std (filled), 1 Faded, 2 Text, 3 Outline (2026-11-22 : Text, a selected cell framed) ;
        // ui_jvariant -1 : as the style
        vr = (ui_jvariant >= 0) ? min(3, ui_jvariant) : (ui_jstyle != 0);
        (ui_jg_ptext !== 100) ? ui_fontsize(ui_fontsize(0) * max(50, min(200, ui_jg_ptext)) / 100);
        nc = pm[ui_jpad_nco]; nc <= 0 ? nc = 1;
        (fnc > 0) ? (nc = (opt & 1) ? fnc : min(nc, fnc));
        nl = pm[ui_jpad_nli]; nl <= 0 ? nl = 1;
        (fnl > 0) ? (nl = (opt & 1) ? fnl : min(nl, fnl));
        // Guard : a damaged pad (or a wrong forced size) could ask for millions of cells and freeze the GUI
        (!((nl <= ui_jpad_maxdim) && (nc <= ui_jpad_maxdim))) ? (
            ui_jpad_bad_pad = pm; ui_jpad_bad_nl = nl; ui_jpad_bad_nc = nc;
            ui_jpad_bad_cnt += 1;
            nl = (nl <= ui_jpad_maxdim) ? nl : ui_jpad_maxdim;
            nc = (nc <= ui_jpad_maxdim) ? nc : ui_jpad_maxdim;
        );
        iy = pm[ui_jpad_linc]; ((iy <= 0) || (opt & 2)) ? iy = nc;
        ix = pm[ui_jpad_cinc]; ix <= 0 ? ix = 1;
        // is the mouse in the pad ?
        ms_x = ms_y = -1;
        (fmsin = ui_hover()) ? (
            ms_x = uix_mouse_x; ms_y = uix_mouse_y;
        );
        // cells rectangle size
        z2 = ui_width(); z3 = ui_height();
        // z2 = ui_width_retina(); z3 = ui_height_retina();
        wi = 0|(z2/nc); he = 0|(z3/nl);
        // Adjust rectangle for correct displaying.
        z2 = z2 - wi*nc; z3 = z3 - he*nl; z4 = 0|(z2/2); z5 = 0|(z3/2);
        ui_pad(z4, z5, z2-z4, z3-z5); // corrected work area for the pad
        // draw a border ?
        (ty & ui_jpad_ty_bord) ? ( ui_pad(4, 2, 5, 2); ui_pcolor(bcl); ui_border(); );
        ((z5 = pm[ui_jpad_border]) != 0) ?  ui_pad(z5, z5, z5, z5);
        left = ui_left(); ypos = top = ui_top();
        // left = ui_left_retina(); ypos = top = ui_top_retina();
        gloff = pm[ui_jpad_gloff];  // global offset for displaying
        // geometry of the last pad drawn (see ui_jpad_cell_pos)
        ui_jpad_lst_left = left; ui_jpad_lst_top = top; ui_jpad_lst_wi = wi; ui_jpad_lst_he = he;
        ui_jpad_lst_ix = ix; ui_jpad_lst_iy = iy; ui_jpad_lst_gloff = gloff;
        ui_jpad_lst_nc = nc; ui_jpad_lst_nl = nl;
        labs = pm[ui_jpad_labs]; labs != 0 ? labs += pm; // labels, if any
        alabs = pm[ui_jpad_altlabs]; alabs != 0 ? alabs += pm; // alt labels, if any
        cdefs = pm[ui_jpad_cells]; cdefs != 0 ? cdefs += pm; // cell definitions
        nums = pm[ui_jpad_values]; nums != 0 ? nums += pm; // values definitions
        colors = pm[ui_jpad_clrs]; colors != 0 ? colors += pm; // colors definitions
        acolors = pm[ui_jpad_altclrs]; acolors != 0 ? acolors += pm; // alt colors definitions
        // (2026-11-22) the roles of the cells, if the pad has some and the palette exists (uix_jp_tab, see mSL_GUI) : the pad
        // is declared for the mouse (its cells react when the mouse is on them)
        roles = pm[ui_jpad_roles];
        ((roles > 0) && (uix_jp_tab > 0)) ? (roles += pm; uix_jhv_add(pm, left, top, wi, he, nc, nl, rs);) : (
            roles = 0;
            ((mouse_cap & 16) && (uix_jp_tab > 0)) ? uix_jhv_add(pm, left, top, wi, he, nc, nl, rs); // (Alt : the tip, uix_jtip_set)
        );
        pm[ui_jpad_lmods] = ui_jmouse_cap; // keep mouse/keys infos
        fmsin ? (
            // Mouse clicked here ?
            (z1 = ui_click(1)) ? (
                flevnt |= ui_jpad_ev_lmc; ui_XlocDoNow |= 1;
            );
            (z2 = ui_click(2)) ? (
                flevnt |= ui_jpad_ev_rmc; ui_XlocDoNow |= 1;
            );
            (z3 = ui_click(64)) ? (
                flevnt |= ui_jpad_ev_cmc; ui_XlocDoNow |= 1;
            );
            // A single gesture cannot be both a left and a right clic : a stale "left button" state
            // (e.g. from the clic that chose a menu entry) must not add a left clic to a right clic
            (z1 && z2) ? (
                z1 = 0; flevnt &= -1 ~ ui_jpad_ev_lmc;
            );
            xm = z1 + z2 + z3;
        );
        // Loop to display the individual cells
        ny = 0; loop (nl, (  // displayed line
            xpos = left;
            nx = 0; loop (nc, ( // displayed column
                np = nx*ix + ny*iy - gloff; // the cell to be displayed in it
                ctype = drc = drr = 0; // dc = dcl;
                gtc = -1; // (the "text" look : the color of the text)
                CS = 0; // no color change for now
                ovr = 0; // (the mouse on the cell)
                isvalid = (np >= 0) && (np < pm[ui_jpad_siz]);
                (isvalid && (cdefs != 0)) ? (ctype = cdefs[np];); // cell type
                jr = (isvalid && (roles != 0)) ? roles[np] : 0; rk = jr & 15; // (its role, see ui_jpad_rl_action)
                (ctype & ui_jpad_ct_nobrd) ? ( z4 = z5 = 0;) : ( z4 = 2; z5 = 5; ) ;
                // (2026-11-21) the zone drawn : the cell, less the room added between the cells (ui_jg_gapx, ui_jg_gapy :
                // half on each side ; the cell keeps 12 x 8 units at least, and its text with 6 units on each side) ; the
                // clics : the whole cell (xpos, ypos, wi, he)
                gex = max(0, min(ui_jg_gapx, wi - 12)); gey = max(0, min(ui_jg_gapy, he - 8));
                ((gex > 0) && isvalid && ((ctype & ui_jpad_ct_cclear) == 0)) ? (
                    // its text (as drawn below)
                    sst = ((ctype & ui_jpad_ct_selec) && (alabs != 0) && (alabs[np] != 0)) ? alabs[np] :
