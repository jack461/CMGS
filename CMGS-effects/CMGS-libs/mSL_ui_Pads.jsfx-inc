    ((ui_jpad_lst_wi > 0) && (ui_jpad_lst_he > 0)) ? (
        nx = floor((uix_mouse_x - ui_jpad_lst_left) / ui_jpad_lst_wi);
        ny = floor((uix_mouse_y - ui_jpad_lst_top) / ui_jpad_lst_he);
        ((nx >= 0) && (nx < ui_jpad_lst_nc) && (ny >= 0) && (ny < ui_jpad_lst_nl)) ?
