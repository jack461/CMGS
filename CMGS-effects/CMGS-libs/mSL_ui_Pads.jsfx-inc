*/
ui_jpad_lst_left = ui_jpad_lst_top = ui_jpad_lst_wi = ui_jpad_lst_he = ui_jpad_lst_gloff = 0;
ui_jpad_lst_ix = ui_jpad_lst_iy = 1;
ui_jpad_cx = ui_jpad_cy = 0;
function ui_jpad_cell_pos(np)
local (k, nx, ny)
(
    k = np + ui_jpad_lst_gloff; // np = nx*ix + ny*iy - gloff
    (ui_jpad_lst_ix === 1) ? (
        nx = k % ui_jpad_lst_iy; ny = 0|(k / ui_jpad_lst_iy); // line major
    ) : (
        ny = k % ui_jpad_lst_ix; nx = 0|(k / ui_jpad_lst_ix); // column major
    );
