desc:GamePlayer
// J.J. Girardot-2020 - 2024


//°°°  SLIDERS
// the generic sliders, automatable (hidden : key 'S' shows them in the panel of REAPER, the Links Manager the one it
// links) ; -1 ... 1, as in Interstys and Diffusion-3 (until 2026-11-20 : "Slider 1 ... 64", ranges 0-1, 0-127 or 0-100)
<? i = 0; loop(64, printf("slider%d:slCtl%d=0<-1,1,0.001>-Ctl %d\n", i+1, i+1, i+1); i += 1;); ?>

//
//out_pin:none
in_pin:none

//// 1M=1048576 4M=41943040  8M=8388608 12M=12582912 16M=16777216 32M=33554432 40M=41943040
//// options:maxmem=16777216
options:maxmem = 41943040
options:gmem = GM_SHM
options:gfx_idle
options:gfx_hz = 30
options:want_all_kb
options:no_meter

<? no_init = 0; ?>

import CMGS-libs/mSL_Constants.jsfx-inc
import CMGS-libs/mSL_StM_Memory.jsfx-inc
import CMGS-libs/mSL_string_list_10000.jsfx-inc
import CMGS-libs/mSL_string_list_2000W.jsfx-inc
import CMGS-libs/mSL_string_list_2000X.jsfx-inc
