function fct1()
(
    GM_Log("","Function fct1/fun1 executed","");
    44444;
);
ext fun1 = fct1;

 
function fct2()
local (a, b, c, st)
(
    a = 3;
    b = 5;
    c = a + b; 
    st = stralloc();
    sprintf(st, "Function fct2/fun2 executed => %d", c);
    GM_Log("",st,"");
    55555;
);
ext fun2 = fct2;


function fct3(a,b,c)
local (x)
(
   x = a + b;
   sprintf(str, "Function fct3/fun3: a=%d  b=%d  x=%d", a, b, x);
   GM_Log("",str,"");
   66666;
);
ext fun3 = fct3;


function fct4(a, b, c, d, e, f, g)
local (s)
(
    s = a + b + c + d + e + f + g;
    sprintf(str, "Function fct4/fun4 executed ; sum => %d", s);
    GM_Log("",str,"");
    77777;
);
ext fun4 = fct4;
   


function fct5(c; v)
local (s, i)
(
    s = i = 0;
    loop(c, s += v[i]; i += 1;);
    sprintf(str, "Function fct5/fun5 executed ; cnt => %d, sum => %d", c, s);
    GM_Log("",str,"");
    88888;
);
ext fun5 = fct5;


 
function fct6()
(
    wait(120);
    GM_Log("","Function fct6/fun6 executed","");
    99999;
);
ext fun6 = fct6;

 


