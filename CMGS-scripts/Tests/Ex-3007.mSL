print("Ex-3007. Diffusion-3 settings : les blocs Curve (les courbes des modules Curves).");

/*
  Attention : ce test remplace les courbes 63 et 64 du projet, et cree la courbe nommee "Ex3007c" (la premiere courbe
  libre ; repasse : la meme). Un module Curves (touche z) : Undo de la derniere courbe lue.
  1) Curve 63 : une enveloppe de 3 points, nommee, avec un sustain ; Curve 64 : une forme d'onde periodique.
  2) Curve "Ex3007c" : un nom nouveau prend la premiere courbe libre ; un second bloc de la meme courbe, dans le meme
     settings, change son type (les blocs d'une courbe s'ajoutent).
  3) settings avec des arguments : un bloc Curve.
  Erreurs : e1 un y hors de [-1, 1] (1654) ; e2 x decroissant (1653) ; e3 le sustain d'une forme d'onde (1655) ; e4 un
  type inconnu (1652) ; e5 un mot inconnu apres un bloc Curve (0298 : la courbe 63 ne change pas, elle garde son nom).
*/

var r = settings(data( Curve 63  name "Ex3007a"  type Env  sustain 2  points 0 0 0  0.3 1 0.5  1 0 -0.25 ));
// Expected "Curves : curve 63 "Ex3007a" (Env, 3 points) : read from settings"
print(sprintf(0, "Ex-3007. 1a : %d", r));
// Expected "Ex-3007. 1a : 0"

r = settings(data( Curve 64  name "Ex3007b"  type Wave  periodic On  points 0 0 0  0.25 1 0  0.75 -1 0  1 0 0 ));
// Expected "Curves : curve 64 "Ex3007b" (Wave, 4 points) : read from settings"
print(sprintf(0, "Ex-3007. 1b : %d", r));
// Expected "Ex-3007. 1b : 0"

r = settings(data( Curve "Ex3007c"  type HEnv  points 0 0 0  1 1 0.5   Curve "Ex3007c"  type QWave ));
// Expected "Curves : curve %d "Ex3007c" (QWave, 2 points) : read from settings"
print(sprintf(0, "Ex-3007. 2 : %d", r));
// Expected "Ex-3007. 2 : 0"

r = settings(`Curve, 64, `periodic, `Off);
// Expected "Curves : curve 64 "Ex3007b" (Wave, 4 points) : read from settings"
print(sprintf(0, "Ex-3007. 3 : %d", r));
// Expected "Ex-3007. 3 : 0"

r = settings(data( Curve 63  points 0 0 0  1 1.5 0 ));
// Expected error 1654
print(sprintf(0, "Ex-3007. e1 : %d", r));
// Expected "Ex-3007. e1 : 1654"

r = settings(data( Curve 63  points 0 0 0  0.6 1 0  0.4 0.5 0  1 0 0 ));
// Expected error 1653
print(sprintf(0, "Ex-3007. e2 : %d", r));
// Expected "Ex-3007. e2 : 1653"

r = settings(data( Curve 64  sustain 2 ));
// Expected error 1655
print(sprintf(0, "Ex-3007. e3 : %d", r));
// Expected "Ex-3007. e3 : 1655"

r = settings(data( Curve 63  type Envelope ));
// Expected error 1652
print(sprintf(0, "Ex-3007. e4 : %d", r));
// Expected "Ex-3007. e4 : 1652"

r = settings(data( Curve 63  name "Ex3007z"  zorglub ));
// Expected error 0298
print(sprintf(0, "Ex-3007. e5 : %d", r));
// Expected "Ex-3007. e5 : 298"

r = settings(data( Curve "Ex3007a" ));
// Expected "Curves : curve 63 "Ex3007a" (Env, 3 points) : read from settings"
print(sprintf(0, "Ex-3007. fin : %d", r));
// Expected "Ex-3007. fin : 0"
