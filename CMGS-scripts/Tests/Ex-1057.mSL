// Expected "Check Link 4 OK"
// Expected "Control 1 value 1"
// Expected "Control 1 value 1"
// Expected "Control 1 value 0"
// Expected "Check Writer %d OK"
// Expected "Check Writer %d OK"
// Expected "Control 2 value 1"
// Expected "Control 2 value 1"
// Expected "Control 2 value -1"
// Expected "Check Reader %d OK"
// Expected "Check Reader %d OK"
// Expected "Check Reader %d OK"
