print("Ex-0027. La palette des cases a roles : settings(data( GUI palette ... )) (toutes les applications).");

/*
  Regle la palette (voir mSL_GUI et uix_jp_make dans ui-lib-JJ-GUI) : la famille, la teinte de base, la saturation, la
  luminosite, la couleur des cases Danger, l'intensite des modes survol et desactive. Seules les cases qui ont un role
  changent : le pad du module GUI et son apercu. Le journal montre la ligne "GUI settings : ... palette Spectrum hue 200
  ..." des reglages pris. A la fin, la palette revient a ses valeurs par defaut (les autres reglages GUI ne changent pas).
  Erreurs : e1 une famille inconnue (1642) ; e2 une teinte hors de sa plage (1641 : hue -1 ... 359) ; e3 une valeur de
  danger inconnue (1642 : Red ou Palette) ; e4 une saturation hors de sa plage (1641 : chroma 0 ... 100) ; e5 une valeur
  de tabs inconnue (1642 : Style, Always ou Hover) ; e6 un role inconnu dans adjust (1642) ; e7 une teinte hors de sa
  plage dans adjust (1641 : -180 ... 180). Les retouches des roles (adjust) sont effacees a la fin (adjust reset all), la
  barre des onglets revient a Style (comme le style). Un defaut de l'utilisateur est defini (default ... : il n'est pas
  applique), puis e8 : le theme n'en fait pas partie (1640) ; puis plus de defaut de l'utilisateur (default defaults : toutes
  les cles qui suivent default vont au defaut, d'ou un appel a part pour remettre la palette courante).
*/

var r = settings(data( GUI palette Spectrum hue 200 chroma 60 light 45 danger Palette hover 70 disabled 80 ));
print("Ex-0027. reglages pris");
// Expected "Ex-0027. reglages pris"

r = settings(data( GUI palette Mono hue -1 ));
print("Ex-0027. teinte du theme (nombre)");
// Expected "Ex-0027. teinte du theme (nombre)"

r = settings(data( GUI palette Analog hue Theme ));
print("Ex-0027. teinte du theme (mot)");
// Expected "Ex-0027. teinte du theme (mot)"

r = settings(data( GUI palette Rainbow ));
// Expected error 1642
print("Ex-0027. e1");
// Expected "Ex-0027. e1"

r = settings(data( GUI hue 400 ));
// Expected error 1641
print("Ex-0027. e2");
// Expected "Ex-0027. e2"

r = settings(data( GUI danger Blue ));
// Expected error 1642
print("Ex-0027. e3");
// Expected "Ex-0027. e3"

r = settings(data( GUI chroma 120 ));
// Expected error 1641
print("Ex-0027. e4");
// Expected "Ex-0027. e4"

r = settings(data( GUI tabs Always ));
print("Ex-0027. barre des onglets toujours affichee");
// Expected "Ex-0027. barre des onglets toujours affichee"

r = settings(data( GUI tabs Sometimes ));
// Expected error 1642
print("Ex-0027. e5");
// Expected "Ex-0027. e5"

r = settings(data( GUI palette Spectrum adjust Action 20 -5 0 adjust Spectrum Value -30 10 25 adjust Analog Alert 0 0 -50 ));
print("Ex-0027. retouches des roles");
// Expected "Ex-0027. retouches des roles"

r = settings(data( GUI adjust Toto 1 2 3 ));
// Expected error 1642
print("Ex-0027. e6");
// Expected "Ex-0027. e6"

r = settings(data( GUI adjust Action 200 0 0 ));
// Expected error 1641
print("Ex-0027. e7");
// Expected "Ex-0027. e7"

r = settings(data( GUI default style Soft variant Outline fonts 110 adjust Action 10 0 0 ));
print("Ex-0027. defaut utilisateur defini");
// Expected "Ex-0027. defaut utilisateur defini"

r = settings(data( GUI default theme 3 ));
// Expected error 1640
print("Ex-0027. e8");
// Expected "Ex-0027. e8"

r = settings(data( GUI default defaults ));
print("Ex-0027. plus de defaut utilisateur");
// Expected "Ex-0027. plus de defaut utilisateur"

r = settings(data( GUI adjust reset all palette Theme hue Theme chroma 50 light 50 danger Red hover 60 disabled 70 tabs Style ));
print("Ex-0027. fin");
// Expected "Ex-0027. fin"
