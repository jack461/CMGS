print("Ex-1063. Interstys settings : le Ring, ses modes FM et PM (cle index).");

/*
  FM et PM : la source A (la porteuse) voit sa phase tournee par l'oscillateur, ou par la source B (le modulateur) :
  PM, de index x le modulateur (radians) ; FM, de l'integrale de index x freq x le modulateur (la deviation, en Hz).
  index [0, 100], fois amount (0 a 2, modulable par l'entree Amount). Avec B, en FM, freq reste l'echelle de la deviation :
  Dump l'ecrit ; en PM avec B, non. Les modes Ring, AM, Up, Down n'ecrivent pas index.
  Erreurs (rien n'est cree) : e1 index 200 (2754) ; e2 index pour un Math (2767) ; e3 mode XM (2754).
  Les numeros des effets dependent du projet (%d).
*/

var r = settings(data(
    Interstys
    Effect lf  type LFO  chan 1  freq 200
    Effect rg  type Ring  chan 2  source In:0  mode PM  freq 220  index 3
    Dump Effect rg
    Check Effect rg  mode PM  freq 220  index 3  amount 1
    Effect rg  mode FM  index 0.5  amount 2  src2 Effect lf  bchan One
    Dump Effect rg
    Check Effect rg  mode FM  freq 220  index 0.5  amount 2  bchan One
    Effect rg  mode PM
    Dump Effect rg
    Effect rg  mode Ring
    Dump Effect rg
    Free Effect rg
    Free Effect lf
));
print(sprintf(0, "Ex-1063. resultat : %d", r));
// Expected "Effect %d status On type Ring phase Std chan 2 out Own limiter On src1 In:0 gain1 0 mode PM freq 220 wave Sine detune 0 spread 0 amount 1 index 3 mix 100"
// Expected "Check Effect %d OK"
// Expected "Effect %d status On type Ring phase Std chan 2 out Own limiter On src1 In:0 gain1 0 src2 Effect %d gain2 0 mode FM freq 220 amount 2 index 0.5 bchan One mix 100"
// Expected "Check Effect %d OK"
// Expected "Effect %d status On type Ring phase Std chan 2 out Own limiter On src1 In:0 gain1 0 src2 Effect %d gain2 0 mode PM amount 2 index 0.5 bchan One mix 100"
// Expected "Effect %d status On type Ring phase Std chan 2 out Own limiter On src1 In:0 gain1 0 src2 Effect %d gain2 0 mode Ring bchan One mix 100"
// Expected "Ex-1063. resultat : 0"

var e1 = settings(data( Interstys  Effect x  type Ring  index 200 ));
var e2 = settings(data( Interstys  Effect x  type Math  index 1 ));
var e3 = settings(data( Interstys  Effect x  type Ring  mode XM ));
print(sprintf(0, "Ex-1063. erreurs : %d %d %d", e1, e2, e3));
// Expected error 2754
// Expected error 2767
// Expected error 2754
// Expected "Ex-1063. erreurs : 2754 2767 2754"
