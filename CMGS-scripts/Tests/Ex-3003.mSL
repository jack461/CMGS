print("Ex-3003. Espaces settings : une seule analyse (configuration et blocs Edit), les deux formes.");

/*
  Attention : ce test remplace la configuration du module Edit D (touche z sur le module : Undo) et ajoute les sources
  252 a 254 a la configuration en cours (pas de "clear").
  1) settings(data(...)) : un bloc Edit puis une source, dans le meme data.
  2) settings avec des arguments : un bloc Edit ; une source, la ponctuation donnee par `: `< `; et des valeurs
     calculees.
  3) table et D3_config, les anciens noms : la meme analyse (table lit maintenant aussi la configuration, D3_config
     les blocs Edit, et ses arguments).
  Erreurs : e1 une cle inconnue dans un bloc Edit (2489) ; e2 une erreur de la configuration apres un bloc Edit
  (2492 : le bloc Edit ne change rien).
  Les wait laissent @gfx prendre chaque bloc Edit (ed_Frame).
*/

var r = settings(data( Edit D  name "Ex3003a"  smooth On   source 252 : 1 < 0.25 0.25 0 ; ));
print(sprintf(0, "Ex-3003. 1 : %d", r));
// Expected "Ex-3003. 1 : 0"
wait(0.5);
// Expected "Edit D : Ex3003a : read from settings"

r = settings(`Edit, `D, `name, "Ex3003b");
print(sprintf(0, "Ex-3003. 2a : %d", r));
// Expected "Ex-3003. 2a : 0"
wait(0.5);
// Expected "Edit D : Ex3003b : read from settings"

var x = 0.25;
r = settings(`source, 253, `:, 1, `<, x, x * 2, 0, `;);
print(sprintf(0, "Ex-3003. 2b : %d", r));
// Expected "Ex-3003. 2b : 0"

r = table(data( source 254 : 1 < 0 0.5 0 ; ));
print(sprintf(0, "Ex-3003. 3a : %d", r));
// Expected "Ex-3003. 3a : 0"

r = D3_config(`Edit, 4, `name, "Ex3003c", `smooth, `Off);
print(sprintf(0, "Ex-3003. 3b : %d", r));
// Expected "Ex-3003. 3b : 0"
wait(0.5);
// Expected "Edit D : Ex3003c : read from settings"

r = settings(data( Edit D  nmae "e1" ));
print(sprintf(0, "Ex-3003. e1 : %d", r));
// Expected error 2489
// Expected "Ex-3003. e1 : 2489"

r = settings(data( Edit D  name "e2"  source 0 : 1 < 0 0 0 ; ));
print(sprintf(0, "Ex-3003. e2 : %d", r));
// Expected error 2492
// Expected "Ex-3003. e2 : 2492"
wait(0.5);

print("Ex-3003. fin (Edit D garde Ex3003c).");
// Expected "Ex-3003. fin (Edit D garde Ex3003c)."
