print("Ex-1065. Interstys settings : la sortie none (une sortie dont on ne se sert pas), pour un effet et un reader.");

/*
  out none : la sortie n'est pas utilisee (ecrite dans les cellules poubelle) : pas de cable propre, rien a lire, pas un
  probleme pour le module Connections. Un VU meter n'a souvent besoin que de sa mesure ; un reader peut etre ecoute
  ailleurs. La source d'un autre module ne peut pas etre un module sans sortie (2703 : "has no output").
  Les numeros dependent du projet (%d).
*/

var r = settings(data(
    Interstys
    Effect vu  type VUMeter  chan 2  source In:0  out none
    Dump Effect vu
    Check Effect vu  out none
    Line ln  length 1  chan 1
    Reader rd  line ln  out none
    Dump Reader rd
    Check Reader rd  out none
    Effect vu  out Own
    Check Effect vu  out Own
    Free Reader rd
    Free Line ln
    Free Effect vu
));
print(sprintf(0, "Ex-1065. resultat : %d", r));
// Expected "Effect %d status On type VUMeter phase Std chan 2 out none source In:0 gain 0 mode HFixed time 45"
// Expected "Check Effect %d OK"
// Expected "Reader %d status %s line %d speed 1 out none vol 0"
// Expected "Check Reader %d OK"
// Expected "Check Effect %d OK"
// Expected "Ex-1065. resultat : 0"
