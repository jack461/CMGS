print("Ex-1060. Interstys table : les banques des liens MIDI (bank, target Bank, Global bank).");

/*
  bank b : le lien n'agit que quand la banque b est la banque courante (0, par defaut : toujours). Le cc 19 mene Ctl 1
  dans la banque 1 et Ctl 2 dans la banque 2 ; note 25 : Bank Prev, note 26 : Bank Next, note 27 : Bank 2.
  Apres un changement de banque, les liens de la nouvelle banque attendent que leur commande rejoigne leur valeur
  (cc 19 100 : rien ; cc 19 0 : rejointe). Bank Next sans banque suivante (la plus haute des liens : 2), Bank Prev a la
  banque 1 : rien. Global bank n change aussi la banque courante (Check Global bank n la verifie).
  Erreurs (rien n'est cree) : e1 bank pour une action Bank (2743) ; e2 target Bank 17 (2754) ; e3 target Bank Up (2730) ;
  e4 bank 17 (2754) ; e5 Global bank 0 (2754).
*/

var r1 = table(data(
    Interstys
    Free Link All
    Control 1  value 0
    Control 2  value 0
    Link 1  cc 19  target Ctl 1  min 0  max 1  bank 1
    Link 2  cc 19  target Ctl 2  min 0  max 1  bank 2
    Link 3  note 25  target Bank Prev
    Link 4  note 26  target Bank Next
    Link 5  note 27  target Bank 2
    Dump Link 1
    Dump Link 2
    Dump Link 3
    Dump Link 4
    Dump Link 5
    Check Link 2  bank 2
    Check Global  bank 1
    Inject cc 19 127
    Dump Control 1
    Dump Control 2
    Inject note 26 127
    Inject note 26 0
    Check Global  bank 2
    Inject cc 19 100
    Dump Control 2
    Inject cc 19 0
    Inject cc 19 127
    Dump Control 1
    Dump Control 2
    Inject note 26 127
    Inject note 26 0
    Check Global  bank 2
    Inject note 25 127
    Inject note 25 0
    Inject cc 19 64
    Dump Control 1
    Inject cc 19 127
    Inject cc 19 0
    Dump Control 1
    Inject note 25 127
    Inject note 25 0
    Check Global  bank 1
    Inject note 27 127
    Inject note 27 0
    Global  bank 1
    Check Global  bank 1
    Free Link All
    Control 1  value 0
    Control 2  value 0
));
print(sprintf(0, "Ex-1060. resultat : %d", r1));

var e1 = table(data( Interstys  Link 1  note 25  target Bank Next  bank 2 ));
var e2 = table(data( Interstys  Link 1  note 25  target Bank 17 ));
var e3 = table(data( Interstys  Link 1  note 25  target Bank Up ));
var e4 = table(data( Interstys  Link 1  cc 1  target Ctl 1  bank 17 ));
var e5 = table(data( Interstys  Global  bank 0 ));
print(sprintf(0, "Ex-1060. erreurs : %d %d %d %d %d", e1, e2, e3, e4, e5));

