print("Ex-3004. Espaces hppos : le cadre (frame), les dimensions (size), l'activation (Off), le cumul, clear.");

/*
  Attention : ce test remplace les positions des haut-parleurs de la configuration en cours, puis l'efface (clear, a
  la fin : la recharger ensuite, module Global, File 1 ... 9).
  hppos frame a b : le cube des coordonnees (a < b, le meme pour les 3 axes) ; frame Metres : en metres, dans
  [0, X] x [0, Y] x [0, Z] (size necessaire) ; sans frame : l'ancienne regle ([-5, 5]). size X Y Z : les dimensions
  reelles (metres). Off apres une position : un haut-parleur inactif. Les hppos se cumulent : les haut-parleurs donnes
  s'ajoutent, ou remplacent ceux de memes numeros ; "hppos clear" vide d'abord la disposition, le mot-cle "clear" de la
  configuration aussi. "n On|Off" : seulement l'activation. Un hppos finit a ";", a la fin des mots ou au mot-cle suivant.
  1) clear, une disposition dans [0, 1], 8.9 x 12.5 x 4.5 m, le 3 inactif ; 2) le 3 actif, le 4 inactif ; 3) avec
  les arguments (sans ";" final) ; 4) size seul ; 5) les haut-parleurs 5 a 8 s'ajoutent ; 6) deux hppos dans les
  arguments, sans ";" ; 7) clear, frame Metres ; 8) clear, l'ancienne regle ; 9) hppos clear seul ; 10) le clear de la
  configuration.
  Erreurs : e1 frame 1 0 (2423) ; e2 size avec 0 (2424) ; e3 Metres sans size (2425) ; e4 une position hors du cadre
  (2426) ; e5 frame 0 1 seul, les positions en cours (en metres) en sortent (2426). Rien ne change apres une erreur.
*/

var r = settings(data( hppos clear  frame 0 1  size 8.9 12.5 4.5
    1 < 0.1841 1 0,  2 < 0.4952 1 0,  3 < 0.8086 1 0 Off,  4 < 1 0.7909 0 ; ));
print(sprintf(0, "Ex-3004. 1 : %d", r));
// Expected "hppos : 4 speakers, frame 0 1, size 8.9 12.5 4.5, 1 inactive"
// Expected "Ex-3004. 1 : 0"

r = settings(data( hppos 3 On, 4 Off ; ));
print(sprintf(0, "Ex-3004. 2 : %d", r));
// Expected "hppos : 4 speakers, frame 0 1, size 8.9 12.5 4.5, 1 inactive"
// Expected "Ex-3004. 2 : 0"

r = settings(`hppos, 4, `On);
print(sprintf(0, "Ex-3004. 3 : %d", r));
// Expected "hppos : 4 speakers, frame 0 1, size 8.9 12.5 4.5, 0 inactive"
// Expected "Ex-3004. 3 : 0"

r = settings(data( hppos size 10 12 4 ; ));
print(sprintf(0, "Ex-3004. 4 : %d", r));
// Expected "hppos : 4 speakers, frame 0 1, size 10 12 4, 0 inactive"
// Expected "Ex-3004. 4 : 0"

r = settings(data( hppos  5 < 1 0.5043 0,  6 < 1 0.1994 0,  7 < 0.8089 0 0,  8 < 0.4974 0 0 ; ));
print(sprintf(0, "Ex-3004. 5 : %d", r));
// Expected "hppos : 8 speakers, frame 0 1, size 10 12 4, 0 inactive"
// Expected "Ex-3004. 5 : 0"

r = settings(`hppos, 2, `Off,  `hppos, 4, `Off);
print(sprintf(0, "Ex-3004. 6 : %d", r));
// Expected "hppos : 8 speakers, frame 0 1, size 10 12 4, 1 inactive"
// Expected "hppos : 8 speakers, frame 0 1, size 10 12 4, 2 inactive"
// Expected "Ex-3004. 6 : 0"

r = settings(data( hppos clear  frame Metres  size 8.9 12.5 4.5
    1 < 1.6 12.5 0,  2 < 4.4 12.5 0,  3 < 8.9 0 3.5 Off ; ));
print(sprintf(0, "Ex-3004. 7 : %d", r));
// Expected "hppos : 3 speakers, frame Metres, size 8.9 12.5 4.5, 1 inactive"
// Expected "Ex-3004. 7 : 0"

var e1 = settings(data( hppos frame 1 0  1 < 0 0 0 ; ));
print(sprintf(0, "Ex-3004. e1 : %d", e1));
// Expected error 2423
// Expected "Ex-3004. e1 : 2423"

var e2 = settings(data( hppos size 8.9 0 4.5 ; ));
print(sprintf(0, "Ex-3004. e2 : %d", e2));
// Expected error 2424
// Expected "Ex-3004. e2 : 2424"

var e3 = settings(data( hppos clear  frame Metres  1 < 0 0 0 ; ));
print(sprintf(0, "Ex-3004. e3 : %d", e3));
// Expected error 2425
// Expected "Ex-3004. e3 : 2425"

var e4 = settings(data( hppos clear  frame 0 1  1 < 0 2 0 ; ));
print(sprintf(0, "Ex-3004. e4 : %d", e4));
// Expected error 2426
// Expected "Ex-3004. e4 : 2426"

var e5 = settings(data( hppos frame 0 1 ; ));
print(sprintf(0, "Ex-3004. e5 : %d", e5));
// Expected error 2426
// Expected "Ex-3004. e5 : 2426"

r = settings(data( hppos clear  1 < -1 1 0,  2 < 1 1 0 ; ));
print(sprintf(0, "Ex-3004. 8 : %d", r));
// Expected "hppos : 2 speakers, frame none, size none, 0 inactive"
// Expected "Ex-3004. 8 : 0"

r = settings(data( hppos clear ; ));
print(sprintf(0, "Ex-3004. 9 : %d", r));
// Expected "hppos : 0 speakers, frame none, size none, 0 inactive"
// Expected "Ex-3004. 9 : 0"

r = settings(data( hppos 1 < 0 0 0 ;  clear  hppos ; ));
print(sprintf(0, "Ex-3004. 10 : %d", r));
// Expected "hppos : 1 speakers, frame none, size none, 0 inactive"
// Expected "hppos : 0 speakers, frame none, size none, 0 inactive"
// Expected "Ex-3004. 10 : 0"
