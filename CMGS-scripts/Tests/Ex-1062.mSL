print("Ex-1062. Interstys settings : la Reverb, ses traines Gate et Swell (cles tailmode, time, thresh).");

/*
  tailmode Normal | Gate | Swell (la traine), time (ms, 10 a 10000 : Gate, le temps d'ouverture apres que l'entree est
  repassee sous le seuil ; Swell, la montee), thresh (dB, -80 a 0 : le seuil de l'entree). time et thresh sont aussi des
  mots du VU meter (et thresh du Random) : ils sont lus apres le type de l'effet.
  Erreurs (rien n'est cree) : e1 tailmode Loud (2754) ; e2 time 5 (2754) ; e3 thresh 3 (2754) ; e4 tailmode pour un Matrix (2767).
  Les numeros des effets dependent du projet (%d).
*/

var r = settings(data(
    Interstys
    Effect rv  type Reverb  chan 2  source In:0  tailmode Gate  time 250  thresh -24
    Dump Effect rv
    Check Effect rv  tailmode Gate  time 250  thresh -24
    Effect rv  tailmode Swell  time 1200
    Check Effect rv  tailmode Swell  time 1200  thresh -24
    Effect vu  type VUMeter  chan 2  source In:0  time 100  thresh 2
    Check Effect vu  time 100  thresh 2
    Free Effect rv
    Free Effect vu
));
print(sprintf(0, "Ex-1062. resultat : %d", r));
// Expected "Effect %d status On type Reverb phase Std chan 2 out Own limiter On source In:0 gain 0 mode Hadamard mix 35 decay 3 damp 5000 dmin 25 dmax 90 diffusion 1 loop Decay seed 1 delays Geometric hp 40 inject Fold wow 0.3 rate 0.4 spread 0.25 glide 0.05 lines 16 predelay 20 size 1 diffuse 0.7 stages 4 density 0.5 early 0.4 bass 1 tailmode Gate time 250 thresh -24"
// Expected "Check Effect %d OK"
// Expected "Check Effect %d OK"
// Expected "Check Effect %d OK"
// Expected "Ex-1062. resultat : 0"

var e1 = settings(data( Interstys  Effect x  type Reverb  tailmode Loud ));
var e2 = settings(data( Interstys  Effect x  type Reverb  time 5 ));
var e3 = settings(data( Interstys  Effect x  type Reverb  thresh 3 ));
var e4 = settings(data( Interstys  Effect x  type Matrix  tailmode Gate ));
print(sprintf(0, "Ex-1062. erreurs : %d %d %d %d", e1, e2, e3, e4));
// Expected error 2754
// Expected error 2754
// Expected error 2754
// Expected error 2767
// Expected "Ex-1062. erreurs : 2754 2754 2754 2767"
