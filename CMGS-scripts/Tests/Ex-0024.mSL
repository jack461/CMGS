print("Ex-0024. Fonctions : lambda-expressions function (x) (...), _ (la fonction elle-meme), fonctions en valeur.");

/*
  Une lambda-expression, function (x) (corps), est une valeur : la fonction, sans nom (aucune variable cachee : elle
  disparait quand plus rien ne la garde). Des arguments juste apres l'appellent aussitot : function (x) (x + 1) (3)
  vaut 4, comme (function (x) (x + 1))(3). Dans une fonction, nommee ou non, _ est la fonction elle-meme (la
  recursivite, sans passer par une variable) ; dans des fonctions imbriquees, c'est la plus proche. Une fonction se
  range dans une variable, s'appelle par elle, se passe en argument, se rend en resultat. Pas de fermeture : le corps
  d'une lambda voit les variables globales, pas les parametres ni les locales de la fonction qui la contient.
  Une expression dont la valeur est une fonction s'appelle aussi : donne()(3), (w2 = donne())(3) ; une expression
  s'indexe : donneT()[1](0).
  Ne depend pas de l'application.
*/

// une fonction nommee, dans une variable
function f(x) (2*x + 3);
var g = f;
print(sprintf(0, "Ex-0024. f(4) %d, g(4) %d", f(4), g(4)));
// Expected "Ex-0024. f(4) 11, g(4) 11"

// une lambda appelee aussitot
print(sprintf(0, "Ex-0024. aussitot %d %d", function (x) (x + 1) (3), (function (x, y) (x * y))(5, 6)));
// Expected "Ex-0024. aussitot 4 30"

// une lambda dans une variable
var h = function (x) (x * x + 1);
print(sprintf(0, "Ex-0024. h(3) %d", h(3)));
// Expected "Ex-0024. h(3) 10"

// _ : la recursivite, dans une fonction nommee et dans une lambda ; _ ne depend pas du nom (fact2 = fact, fact change)
function fact(n) ( (n <= 1) ? 1 : n * _(n - 1); );
var fib = function (n) ( (n < 2) ? n : _(n - 1) + _(n - 2); );
print(sprintf(0, "Ex-0024. fact(6) %d, fib(10) %d", fact(6), fib(10)));
// Expected "Ex-0024. fact(6) 720, fib(10) 55"
var fact2 = fact;
fact = function (n) (0);
print(sprintf(0, "Ex-0024. fact2(5) %d, fact(5) %d", fact2(5), fact(5)));
// Expected "Ex-0024. fact2(5) 120, fact(5) 0"
print(sprintf(0, "Ex-0024. fact(5) aussitot %d", function (n) ( (n <= 1) ? 1 : n * _(n - 1); ) (5)));
// Expected "Ex-0024. fact(5) aussitot 120"

// une fonction en argument (une lambda ou une variable)
function twice(fn, x) ( fn(fn(x)); );
print(sprintf(0, "Ex-0024. twice %d %d", twice(function (x) (x + 10), 1), twice(h, 2)));
// Expected "Ex-0024. twice 21 26"

// une lambda recursive qui recoit une fonction
var pw = function (n) ( (n <= 0) ? 1 : 2 * _(n - 1); );
var somme = function (n, p) ( (n < 0) ? 0 : p(n) + _(n - 1, p); ); // (pas "sum" : une primitive)
print(sprintf(0, "Ex-0024. sum %d", somme(3, pw)));
// Expected "Ex-0024. sum 15"

// une lambda qui rend une lambda : le _ interieur est la fonction interieure
var mk = function (a) ( function (x) ( (x <= 0) ? 0 : 1 + _(x - 1); ); );
var cnt = mk(0);
print(sprintf(0, "Ex-0024. cnt(5) %d", cnt(5)));
// Expected "Ex-0024. cnt(5) 5"

// une lambda avec des variables locales
var sq = function (x) local(t) ( t = x * x; t + 1; );
print(sprintf(0, "Ex-0024. sq(7) %d", sq(7)));
// Expected "Ex-0024. sq(7) 50"

// l'appel d'une expression dont la valeur est une fonction : donne()(3), (donne())(3), (w2 = donne())(3)
function donne() (h);
var w2;
print(sprintf(0, "Ex-0024. expressions %d %d %d", donne()(3), (donne())(3), (w2 = donne())(3)));
// Expected "Ex-0024. expressions 10 10 10"

// l'indexation d'une expression, puis l'appel de l'element : donneT()[1](0), (donneT())[0](0)
var tb = array(sin, cos);
function donneT() (tb);
print(sprintf(0, "Ex-0024. index %d %d %d", donneT()[1](0), (donneT())[0](0), tb[1](0)));
// Expected "Ex-0024. index 1 0 1"

// deux lambdas : deux fonctions differentes
var a1 = function (x) (x + 1);
var a2 = function (x) (x + 1);
print(sprintf(0, "Ex-0024. differentes %d, egales a elles-memes %d", a1 !== a2, (a1 === a1) && (g === f)));
// Expected "Ex-0024. differentes 1, egales a elles-memes 1"

print("Ex-0024. fin.");
// Expected "Ex-0024. fin."
