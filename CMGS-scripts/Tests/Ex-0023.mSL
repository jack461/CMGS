print("Ex-0023. settings : la ponctuation `x (le meme mot que dans un data) ; settings() sans argument.");

/*
  `x, x une ponctuation, est le mot x d'un data : settings(`conf, 16, `:, 1, `>, 2) equivaut a
  settings(data( conf 16 : 1 > 2 )). Les operateurs de deux caracteres aussi (`<= `== `!= `&& `|| `<< `>>).
  Ne depend pas de l'application. A la fin, settings() sans argument, dans un processus separe : l'erreur 1632 n'arrete
  que lui (errLock 0, comme Ex-0006 : sinon, elle arreterait aussi les autres tests en cours).
*/

var d = data( : ; , . < > <= == != && || << >> = ! * + % ? ^ ~ [ ] # @ );
var k = 0;
k += (d[0] === `:) + (d[1] === `;) + (d[2] === `,) + (d[3] === `.) + (d[4] === `<) + (d[5] === `>);
k += (d[6] === `<=) + (d[7] === `==) + (d[8] === `!=) + (d[9] === `&&) + (d[10] === `||) + (d[11] === `<<);
k += (d[12] === `>>) + (d[13] === `=) + (d[14] === `!) + (d[15] === `*) + (d[16] === `+) + (d[17] === `%);
k += (d[18] === `?) + (d[19] === `^) + (d[20] === `~) + (d[21] === `[) + (d[22] === `]) + (d[23] === `#);
k += (d[24] === `@);
print(sprintf(0, "Ex-0023. %d mots sur %d, %d differents de 0", k, size(d), (`: !== 0) + (`; !== 0)));
mfree(d);
// Expected "Ex-0023. 25 mots sur 25, 2 differents de 0"

// Seul le processus fautif doit s'arreter (par defaut, une erreur verrouille tous les processus)
var lock = call(`errLock, 0);
function e1() ( settings(); );   // 1632 : settings sans argument
thread(`run, thread(`new, e1));
wait(1);
call(`errLock, lock);
// Expected error 1632

print("Ex-0023. fin (settings sans argument : erreur 1632).");
// Expected "Ex-0023. fin (settings sans argument : erreur 1632)."
