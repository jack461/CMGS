print("Ex-3008. Diffusion-3 settings : les blocs MetaSurface (la bibliotheque des MetaSurfaces).");

/*
  Attention : ce test remplace la MetaSurface MS32 du projet, et la courbe nommee "Ex3008" (ou la premiere courbe libre).
  1) Une courbe, puis MS32 qui l'utilise par son nom (dyn, modspeed) : tous les reglages, deux zones (configurations 1 et
     2 : celles qui ne sont pas definies dans le projet sont signalees), les trajectoires A ... D et leurs placements.
  2) settings avec des arguments : la meme MetaSurface, quelques cles (les autres ne changent pas).
  Erreurs : e1 un numero de MetaSurface hors de 1 ... 32 (2441) ; e2 une valeur hors de sa plage (2443) ; e3 un mot hors
  de la liste (2444) ; e4 une courbe inconnue (2447) ; e5 une trajectoire inconnue (2448) ; e6 place sans A ... D ni path
  (2449) ; e7 une erreur apres le bloc (0298 : la MetaSurface ne change pas, elle garde son nom : le bloc sans cle de la
  fin la relit telle qu'elle est).
  Les wait laissent @gfx prendre chaque MetaSurface (ms_Frame).
*/

var r = settings(data(
    Curve "Ex3008"  type Env  points 0 0 0  0.5 1 0  1 0 0
    MetaSurface 32  name "Ex3008"
        zone 1 0.25 0.5 1  zone 2 0.75 0.5 1.5
        aspect 1.5  surface Rect  band 0.1  proj 1
        spread 0.2  power 0.5  shape 1  stretch 1.5  offset 0.25  rotation 0.1  angle 45
        volume -6  latency 100  rule Distance  attack 1  release 3
        brush Path  duration 30  mode Back  speed Points  radius 0.5
        A Circle  place 0.1 -0.1 30 0.8  flip X
        B Square  place 0 0 0 1  flip None
        C Edit D  place 0 0 -90 1.2  flip XY
        D T5  place 0 0 0 1
        path place 0 0.05 15 0.9  flip Y
        chain ABC  mix 0.4  glide 8 On  dyn Curve "Ex3008" InOut
        modrot Off  cycle Path  depth 1
        modspeed Curve "Ex3008"  cycle 8  depth 0.5
        modmix Off
));
// Expected "Curves : curve %d "Ex3008" (Env, 3 points) : read from settings"
print(sprintf(0, "Ex-3008. 1 : %d", r));
// Expected "Ex-3008. 1 : 0"
wait(0.5);
// Expected "MetaSurface MS32 : Ex3008 : read from settings (2 configurations)"

r = settings(`MetaSurface, 32, `mix, 0.5, `dyn, `Sine, `Out, `A, `T, 12);
print(sprintf(0, "Ex-3008. 2 : %d", r));
// Expected "Ex-3008. 2 : 0"
wait(0.5);
// Expected "MetaSurface MS32 : Ex3008 : read from settings (2 configurations)"

r = settings(data( MetaSurface 33  mix 0 ));
// Expected error 2441
print(sprintf(0, "Ex-3008. e1 : %d", r));
// Expected "Ex-3008. e1 : 2441"

r = settings(data( MetaSurface 32  spread 2 ));
// Expected error 2443
print(sprintf(0, "Ex-3008. e2 : %d", r));
// Expected "Ex-3008. e2 : 2443"

r = settings(data( MetaSurface 32  mode Twice ));
// Expected error 2444
print(sprintf(0, "Ex-3008. e3 : %d", r));
// Expected "Ex-3008. e3 : 2444"

r = settings(data( MetaSurface 32  modrot Curve "Ex3008zz" ));
// Expected error 2447
print(sprintf(0, "Ex-3008. e4 : %d", r));
// Expected "Ex-3008. e4 : 2447"

r = settings(data( MetaSurface 32  B T200 ));
// Expected error 2448
print(sprintf(0, "Ex-3008. e5 : %d", r));
// Expected "Ex-3008. e5 : 2448"

r = settings(data( MetaSurface 32  place 0 0 0 1 ));
// Expected error 2449
print(sprintf(0, "Ex-3008. e6 : %d", r));
// Expected "Ex-3008. e6 : 2449"

r = settings(data( MetaSurface 32  name "Ex3008z"  zorglub ));
// Expected error 0298
print(sprintf(0, "Ex-3008. e7 : %d", r));
// Expected "Ex-3008. e7 : 298"

// (un bloc sans cle : la MetaSurface relue telle qu'elle est, son nom dans le journal)
r = settings(data( MetaSurface 32 ));
print(sprintf(0, "Ex-3008. fin : %d", r));
// Expected "Ex-3008. fin : 0"
wait(0.5);
// Expected "MetaSurface MS32 : Ex3008 : read from settings (2 configurations)"
