options:maxmem=33554432
// Declare a name for the shared memory
options:gmem=GM_SHM
options:gfx_idle
options:gfx_hz = 10
options:want_all_kb
options:no_meter


import GM-Libs/mSL_Constants.jsfx-inc
import GM-Libs/mSL_StM_Memory.jsfx-inc
import GM-Libs/mSL_string_list_10000.jsfx-inc
import GM-Libs/mSL_string_list_2000W.jsfx-inc
import GM-Libs/mSL_string_list_2000X.jsfx-inc
import GM-Libs/mSL_Strings.jsfx-inc
import GM-Libs/ui-lib.jsfx-inc
import GM-Libs/mSL_ui_LibJJ.jsfx-inc
import GM-Libs/mSL_ui_Menus.jsfx-inc
import GM-Libs/mSL_ui_Pads.jsfx-inc
import GM-Libs/mSL_Scheduler.jsfx-inc
import GM-Libs/mSL_clip_map.jsfx-inc
import GM-Libs/mSL_clip_lib.jsfx-inc
import GM-Libs/ui-lib-JJ-GUI.jsfx-inc
import GM-Libs/clip_lib_MIDI.jsfx-inc
import GM-Libs/mSL_Utilities.jsfx-inc
import GM-Libs/mSL_Dyn_Memory.jsfx-inc
import GM-Libs/mSL_Utilities2.jsfx-inc
import GM-Libs/mSL_FR_Vars_Access.jsfx-inc
import GM-Libs/mSL_Comp_lib.jsfx-inc
import GM-Libs/mSL_DeAsm.jsfx-inc

import GM-Libs/ScriptMaster_Utilities.jsfx-inc
import GM-Libs/ScriptMaster.jsfx-inc

filename:0,GM-Libs/themes/theme-cyan.png
filename:1,GM-Libs/themes/theme-dark-orange.png
filename:2,GM-Libs/themes/theme-dark-orange.png
filename:3,GM-Libs/themes/theme-dark-blue.png
filename:4,GM-Libs/themes/theme-dark-cyan.png
filename:5,GM-Libs/themes/theme-dark-green.png
filename:6,GM-Libs/themes/theme-dark-red.png
filename:7,GM-Libs/themes/theme-amber.png
filename:8,GM-Libs/themes/theme-dark-neon-green.png
filename:9,GM-Libs/themes/theme-magenta.png

@init

ext_nodenorm = 1;
ext_noinit = 1;
gfx_ext_retina = 1;

