desc:ChannelReducer16

slider1:1<1,16,1>Send 1 to
slider2:2<1,16,1>Send 2 to
slider3:3<1,16,1>Send 3 to
slider4:4<1,16,1>Send 4 to
slider5:5<1,16,1>Send 5 to
slider6:6<1,16,1>Send 6 to
slider7:7<1,16,1>Send 7 to
slider8:8<1,16,1>Send 8 to
slider9:9<1,16,1>Send 9 to
slider10:10<1,16,1>Send 10 to
slider11:11<1,16,1>Send 11 to
slider12:12<1,16,1>Send 12 to
slider13:13<1,16,1>Send 13 to
slider14:14<1,16,1>Send 14 to
slider15:15<1,16,1>Send 15 to
slider16:16<1,16,1>Send 16 to


@init
cu = 16;
addr = 0;
slid = cu;
i__ii=0; loop(cu, addr[i__ii] = 0; i__ii+= 1;);
i__ii=0; loop(cu, slid[i__ii] = i__ii; i__ii+= 1;);

@slider
l__ir=0; loop(cu, addr[l__ir] = 0; l__ir+= 1;);
slid[0] = slider1 - 1;
slid[1] = slider2 - 1;
slid[2] = slider3 - 1;
slid[3] = slider4 - 1;
slid[4] = slider5 - 1;
slid[5] = slider6 - 1;
slid[6] = slider7 - 1;
slid[7] = slider8 - 1;
slid[8] = slider9 - 1;
slid[9] = slider10 - 1;
slid[10] = slider11 - 1;
slid[11] = slider12 - 1;
slid[12] = slider13 - 1;
slid[13] = slider14 - 1;
slid[14] = slider15 - 1;
slid[15] = slider16 - 1;

@sample
s__is=0; loop(cu, addr[s__is] = 0; s__is+= 1;);
s__is=0; loop(cu, addr[slid[s__is]] += spl(s__is); s__is+= 1;);
s__is=0; loop(cu, spl(s__is) = addr[s__is]; s__is+= 1;);

