desc:mid-side management

// J.J. Girardot

slider1:0<-120,20,0.5:log=0>Mid (dB)
slider2:0<-120,20,0.5:log=0>Side (dB)


@init

mif = sid = 1;
vmid = vside = 0;

@slider

mid = slider1 <= -120 ? 0 : 10 ^(slider1/20);
sid = slider2 <= -120 ? 0 : 10 ^(slider2/20);

@block
k = num_ch;

@sample

vmid = (spl0 + spl1)/2;
vsid = (spl0 - spl1)/2;
spl0 = mid * vmid + sid * vsid;
spl1 = mid * vmid - sid * vsid;
