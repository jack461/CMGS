print("Ex-1011. Interstys table : erreurs des effets.");

/*
  Chaque table s'arrete sur une erreur avant toute modification (rien n'est cree) :
  r1 : "freq" n'a pas de sens pour un Mixer (2767) ; r2 : Sine n'est pas un mode de Filter (2754) ;
  r3 : l'effet est sa propre source (2768) ; r4 : un LFO n'a pas de limiteur (2767) ;
  r5 : 3 etages (2754) ; r6 : Drive est une entree de la Saturation, pas du Filter (2767) ;
  r7 : status Undefined (2754) ; r8 : "mod Cutoff" sur un Mixer (2767) ; r9 : type inconnu (2754) ;
  r10 : cle inconnue pour un effet (2753).
*/

var r1 = table(data( Effect x type Mixer freq 100 ));
var r2 = table(data( Effect x type Filter mode Sine ));
var r3 = table(data( Effect x type Mixer src1 Effect x ));
var r4 = table(data( Effect x type LFO limiter On ));
var r5 = table(data( Effect x type Filter stages 3 ));
var r6 = table(data( Effect x type Filter mod Drive In:0 ));
var r7 = table(data( Effect x status Undefined ));
var r8 = table(data( Effect x type Mixer mod Cutoff In:0 ));
var r9 = table(data( Effect x type Blender ));
var r10 = table(data( Effect x type Filter speed 2 ));
print(sprintf(0, "Ex-1011. erreurs : %d %d %d %d %d %d %d %d %d %d", r1, r2, r3, r4, r5, r6, r7, r8, r9, r10));

// Expected error 2767
