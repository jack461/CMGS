print("Ex-3002. Diffusion-3 : les sources des projecteurs spatiaux (source n : k < x y z, ... ;) et space n.");

/*
  Ne change pas la configuration en cours (pas de "clear") : definit les sources 250 (4 points, le point 3 non donne
  reste au centre) et 251 (1 point) ; elles apparaissent ensuite dans le menu Src des vues Space A ... D (cellule 2)
  et dans le menu Space des vues Projector A ... H (cellule 16).
  Erreurs (l'analyse s'arrete, rien ne change) : e1 source 0 (2492) ; e2 ":" manquant (2493) ; e3 point 129 (2494) ;
  e4 "<" manquant (2494) ; e5 x = 1.5 (2495) ; e6 "," ou ";" manquant (2496) ; e7 space d'une source non definie
  (2497 ; le preset 501 n'est pas cree) ; e8 space suivi d'un nom (2498).
  Les presets 501 et 502 ne doivent pas exister dans la configuration (sinon : erreur 223).
*/

var d = data( source 250 : 1 < -0.5 0.5 0, 2 < 0.5 0.5 0, 4 < 0 -1 0.25 ; source 251 : 1 < 0 0 1 ; );
D3_config(d); mfree(d);
print("Ex-3002. sources 250 et 251 definies");
// Expected "Ex-3002. sources 250 et 251 definies"

d = data( source 0 : 1 < 0 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2492"
print("Ex-3002. e1");
// Expected "Ex-3002. e1"

d = data( source 251 1 < 0 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2493"
print("Ex-3002. e2");
// Expected "Ex-3002. e2"

d = data( source 251 : 129 < 0 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2494"
print("Ex-3002. e3");
// Expected "Ex-3002. e3"

d = data( source 251 : 1 0 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2494"
print("Ex-3002. e4");
// Expected "Ex-3002. e4"

d = data( source 251 : 1 < 1.5 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2495"
print("Ex-3002. e5");
// Expected "Ex-3002. e5"

d = data( source 251 : 1 < 0 0 0  2 < 0 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2496"
print("Ex-3002. e6");
// Expected "Ex-3002. e6"

d = data( prop 501 ( space 249 ) );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2497"
print("Ex-3002. e7");
// Expected "Ex-3002. e7"

d = data( prop 502 ( space zz ) );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2498"
print("Ex-3002. e8");
// Expected "Ex-3002. e8"

/*
  La bibliotheque des trajectoires (trajectory n "nom" closed|open : x y z, ... ;) : la trajectoire T128 est remplacee
  par "Ex3002" (3 points, fermee : un triangle ; visible dans le module Trajectories et les menus A / B des vues Space).
  Erreurs : t1 trajectory 0 (2470) ; t2 un nom non entre guillemets (2471) ; t3 x = 11 (2472) ; t4 "," ou ";" manquant
  (2473).
*/
d = data( trajectory 128 "Ex3002" closed : 0 0.8 0, 0.7 -0.4 0, -0.7 -0.4 0 ; );
D3_config(d); mfree(d);
print("Ex-3002. T128 definie");
// Expected "Ex-3002. T128 definie"

d = data( trajectory 0 : 0 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2470"
print("Ex-3002. t1");
// Expected "Ex-3002. t1"

d = data( trajectory 127 zz : 0 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2471"
print("Ex-3002. t2");
// Expected "Ex-3002. t2"

d = data( trajectory 127 open : 11 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2472"
print("Ex-3002. t3");
// Expected "Ex-3002. t3"

d = data( trajectory 127 open : 0 0 0  1 0 0 ; );
D3_config(d); mfree(d);
// Expected "Set Table end - xErr = 2473"
print("Ex-3002. t4");
// Expected "Ex-3002. t4"

print("Ex-3002. fin");
// Expected "Ex-3002. fin"
