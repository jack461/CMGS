print("Ex-1052. Interstys table : Dump Session, Dump Patch d'une instance, Clear All.");

/*
  Une session : Global, les curseurs differents de 0, les courbes, les algorithmes, les lignes, les instances, les autres
  modules (leurs numeros ; un module d'une instance : instance:nom), les valeurs courantes des modules des instances, puis
  les modules supprimes d'une instance. Un patch garde les noms des modules de l'instance, et donne un nom a une courbe qui
  n'en a pas (le nom du patch et son numero). Clear All efface aussi les algorithmes, les courbes et les curseurs.
*/

table(data( Interstys  Clear All ));
var r = table(data(
    Interstys
    Control 3 value 0.5
    Curve "Forme" type Env points 0 0 0  0.5 1 0.25  1 0 0
    Curve 5 type Wave periodic On points 0 0 0  0.5 1 0  1 0 0
    Algorithm Essai
        input src
        output dst
        param lvl -6 -120 40
        Effect a  type Mixer  chan 2  src1 src  gain1 lvl
        Effect b  type LFO  chan 1  freq 3  mode Curve  curve 5
        Effect c  type Filter  chan 2  source Effect a  freq 800  mod Cutoff Effect b  depth 1
        Effect d  type Mixer  chan 2  src1 Effect c  gain1 0  out dst
        Effect z  type None  chan 1
    End
    Instance i1 Essai  src In:0  dst Out:0  lvl -3
    Effect 40  type Mixer  chan 2  src1 Effect i1:d  gain1 -1  out Bus 9
    Effect i1:c  freq 1200
    Free Effect i1:z
    Dump Session
    Dump Patch Effect i1:c
));
print(sprintf(0, "Ex-1052. resultat : %d", r));

var r2 = table(data( Interstys  Clear All  Dump Control 3 ));
var e1 = table(data( Interstys  Dump Instance i1 ));
var e2 = table(data( Interstys  Dump Curve Forme ));
var e3 = table(data( Interstys  Algorithm Bis End  Free Algorithm Essai ));
print(sprintf(0, "Ex-1052. apres Clear All : %d %d %d %d", r2, e1, e2, e3));

