print("Ex-1038. Interstys table : une cle de plusieurs types d'effets (spread), la Matrix Ring, le wow et le glide.");

/*
  "spread" est une cle du LFO (le dephasage entre ses canaux) et de la Matrix (le dephasage du wow d'une ligne a la
  suivante) : la table choisit celle du type de l'effet, lu dans le bloc (type) ou dans l'effet deja la. Les blocs qui
  ne donnent pas le type (lf, mx plus bas) sont relus quand le type est connu (passes 2 et 3). La Matrix en Ring
  (diffusion 2 : l'energie passe a la ligne suivante a chaque tour), avec le wow (3 ms a 0.7 Hz) et le glide.
  Erreurs (rien n'est cree) : e1 wow pour un LFO (2767) ; e2 spread 2 pour une Matrix (hors de [0, 1], 2754) ;
  e3 spread Harmonic pour un LFO (pas un nombre, 2754) ; e4 spread pour un filtre (2767).
  Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect lf  type LFO  chan 2  freq 1  spread 0.3
    Effect mx  type Matrix  chan 2  source In:0  mode Ring  diffusion 2  spread 0.5  wow 3  rate 0.7  glide 0.2
    Effect lf  spread 0.4
    Effect mx  spread 0.6
    Dump Effect lf
    Dump Effect mx
    Check Effect lf  spread 0.4
    Check Effect mx  mode Ring  spread 0.6  wow 3  rate 0.7  glide 0.2
    Free Effect lf
    Free Effect mx
));
print(sprintf(0, "Ex-1038. resultat : %d", r));

var e1 = table(data( Interstys  Effect x  type LFO  wow 3 ));
var e2 = table(data( Interstys  Effect x  type Matrix  spread 2 ));
var e3 = table(data( Interstys  Effect x  type LFO  spread Harmonic ));
var e4 = table(data( Interstys  Effect x  type Filter  spread 0.5 ));
print(sprintf(0, "Ex-1038. erreurs : %d %d %d %d", e1, e2, e3, e4));

// Expected "Effect %d status On type LFO phase Std chan 2 out Own freq 1 mode Sine amp 1 offset 0 spread 0.4"
// Expected "Effect %d status On type Matrix phase Std chan 2 out Own limiter On source In:0 gain 0 mode Ring mix 100 decay 2 damp 6000 dmin 20 dmax 80 diffusion 2 loop Decay seed 1 delays Geometric hp 0 inject Direct wow 3 rate 0.7 spread 0.6 glide 0.2 lines 1"
// Expected "Check Effect %d OK"
