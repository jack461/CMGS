print("Ex-1025. Interstys table : courbes rechargees avec le projet (apres Ex-1024, sauver, recharger).");

/*
  Les courbes svenv et svwav ont ete sauvees avec le projet : leurs noms, leurs types et leurs points sont les memes
  (Check), puis elles sont supprimees.
  Les numeros des courbes dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Check Curve svenv  name svenv  type Env  periodic Off  points 0 0 0.75  0.125 1 -0.3333  0.5 0.4 0  1 0 0
    Check Curve svwav  name svwav  type Wave  periodic On  points 0 0 0.5  0.3 -1 0  0.3 0.8 -1  1 0 0
    Free Curve svenv
    Free Curve svwav
));
print(sprintf(0, "Ex-1025. resultat : %d", r));

// Expected "Check Curve %d OK"
// Expected "Check Curve %d OK"
// Expected "Ex-1025. resultat : 0"
