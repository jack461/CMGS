print("Ex-1027. Interstys table : demi-enveloppes, quarts et demi formes d'onde (HEnv, QWave, HWave).");

/*
  Seule la partie editee est conservee (avec son type). QWave : le premier y est force a 0 ; HWave : le premier et le
  dernier y sont forces a 0 ; ces types ne sont pas periodiques (periodic On est ignore). Les erreurs : un sustain sur
  une demi-enveloppe (2799), un y negatif dans une demi-enveloppe (2795).
*/

var r = table(data(
    Interstys
    Curve chenv  type HEnv  points 0 0 0  0.5 1 0.3  1 0.6 0
    Dump Curve chenv
    Curve cqw  type QWave  points 0 0.5 0  1 1 0
    Dump Curve cqw
    Curve chw  type HWave  periodic On  points 0 0.2 0  0.5 1 0  1 0.3 0
    Dump Curve chw
    Check Curve chw  type HWave  periodic Off
));
print(sprintf(0, "Ex-1027. resultat : %d", r));

var e1 = table(data( Interstys  Curve chenv  type HEnv  sustain 2 ));
print(sprintf(0, "Ex-1027. sustain d'une demi-enveloppe : %d", e1));
var e2 = table(data( Interstys  Curve chenv  type HEnv  points 0 -0.5 0  1 1 0 ));
print(sprintf(0, "Ex-1027. y negatif : %d", e2));
var r2 = table(data( Interstys  Free Curve chenv  Free Curve cqw  Free Curve chw ));
print(sprintf(0, "Ex-1027. fin : %d", r2));

// Expected "Curve chenv type HEnv points 0 0 0 0.5 1 0.3 1 0.6 0"
// Expected "Curve cqw type QWave points 0 0 0 1 1 0"
// Expected "Curve chw type HWave points 0 0 0 0.5 1 0 1 0 0"
// Expected "Check Curve %d OK"
// Expected "Ex-1027. resultat : 0"
// Expected error 2799
// Expected "Ex-1027. sustain d'une demi-enveloppe : 2799"
// Expected error 2795
// Expected "Ex-1027. y negatif : 2795"
// Expected "Ex-1027. fin : 0"
