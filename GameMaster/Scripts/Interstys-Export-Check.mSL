print("Interstys-Export-Check. La session d'Ex-1053 relue : chaque module est verifie.");

/*
  A deposer apres le fichier Data/Ex1053-its-session-<date>.mSL (voir Ex-1053.mSL). Le journal note "Check ... OK" pour chaque
  module, ou une erreur 2759 pour chaque difference ; a la fin, le resultat doit etre 0.
*/

var r = table(data(
    Interstys
    Check Global  input 0  output 0
    Dump Control 3
    Check Line 1  length 2  chan 2
    Check Writer 1  line 1  source In:0  overdub 50  status Paused
    Check Reader 1  line 1  loop loop  from 0.5  to 1.5  xfade 20  mute On  speed 0.5  status Paused  out Bus 3
    Check Effect 1  type Mixer  chan 2  src1 Bus 3  gain1 -6  src2 In:2  gain2 -12
    Check Effect 2  type Saturation  chan 2  source Effect 1  mode Curve  curve Forme  drive 12  out Out:0
    Check Effect 3  type Filter  chan 2  source In:0  freq 300  mod Cutoff Ctl 3  depth 1  out Bus 8
    Check Curve Forme  type Env  sustain 2  points 0 0 0  0.5 1 0.25  1 0 0
    Check Effect i9:a  type Mixer  chan 2  src1 In:0  gain1 -3
    Check Effect i9:c  type Filter  chan 2  source Effect i9:a  freq 1200
    Check Effect i9:d  type Mixer  chan 2  src1 Effect i9:c  gain1 0  out Out:2
    Dump Instance i9
));
print(sprintf(0, "Interstys-Export-Check. resultat : %d (0 : OK)", r));

