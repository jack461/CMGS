print("Ex-1047. Interstys table : le declenchement du Random (sa source).");

/*
  Un Random prend une source : son declenchement. Un front montant au-dessus du seuil (thresh, plus 0.01) donne un tic
  et relance l'horloge ; rate 0 : les declenchements seuls ; clock Common : le premier canal de la source, clock Own : un
  canal de la source par canal. Le Dump montre la source, son gain, thresh et detect (seulement avec une source).
  Puis une source sur un bus, un gain, un seuil, rate 0, Step, clock Own ; puis la detection sur l'enveloppe (detect Env :
  release, la retombee en ms, n'est montre qu'avec Env) ; puis la source retiree (source none, thresh, detect et release
  restent). Un Filter qui devient un Random perd sa source (un nouveau Random n'a pas de declenchement).
  Erreurs (rien n'est cree) : e1 thresh 3 (2754) ; e2 thresh pour un Noise (2767) ; e3 source pour un LFO (2767) ;
  e4 thresh pour un Filter (2767) ; e5 detect Peak (2754) ; e6 release 0 (2754) ; e7 release pour un Noise (2767).
  Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect rt  type Random  chan 4  source Ctl 1
    Dump Effect rt
    Check Effect rt  source Ctl 1  gain 0  thresh 0  detect Wave  release 50  clock Common  rate 1
    Effect rt  source Bus 64:0  gain -6  thresh 0.5  rate 0  mode Step  clock Own
    Dump Effect rt
    Check Effect rt  source Bus 64:0  gain -6  thresh 0.5  rate 0  mode Step  clock Own
    Effect rt  detect Env  release 120
    Dump Effect rt
    Check Effect rt  detect Env  release 120
    Effect rt  source none
    Dump Effect rt
    Check Effect rt  source none  thresh 0.5  detect Env  release 120
    Effect fz  type Filter  chan 2  source In:0
    Effect fz  type Random
    Dump Effect fz
    Check Effect fz  source none  thresh 0  mode Smooth
    Free Effect rt
    Free Effect fz
));
print(sprintf(0, "Ex-1047. resultat : %d", r));

var e1 = table(data( Interstys  Effect x  type Random  thresh 3 ));
var e2 = table(data( Interstys  Effect x  type Noise  thresh 0.5 ));
var e3 = table(data( Interstys  Effect x  type LFO  source In:0 ));
var e4 = table(data( Interstys  Effect x  type Filter  thresh 0 ));
var e5 = table(data( Interstys  Effect x  type Random  detect Peak ));
var e6 = table(data( Interstys  Effect x  type Random  release 0 ));
var e7 = table(data( Interstys  Effect x  type Noise  release 50 ));
print(sprintf(0, "Ex-1047. erreurs : %d %d %d %d %d %d %d", e1, e2, e3, e4, e5, e6, e7));

