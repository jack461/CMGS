
/*
    Long string allocation sequence, with leaking memory
*/
var start = ptime();
var id = "Ex-0014.";
var str = stralloc();
var val = stralloc();
var thid = thread(`idt);

sprintf(str, "%s %d-Start.", id, thid);
GM_Log(str);

var siz = 4138;
var Tab = malloc(siz);
var i, j, z, ent, cnt;
var ma, mf;
ma = mf = 0;
cnt=i=j=0;
loop (2000,
    loop (5000,
        z = strtmp();
        ent = 138 + irand(1273);
	sprintf(z, "/%012d/ Val[%d]<= %d", thid, z, ent);
        Tab[i] = z;
        ma += 1;
        i = (i+1) % siz;
        z = Tab[j];
        (z != 0) ? (
             sprintf(val, "/%012d/ Val[%d]=> %d", thid, z, ent);
             strfree(z); mf += 1; Tab[j] = 0;
	);
        j = (j+13) % siz;
	cnt += 1;
    );
);

sprintf(str, "%s Iterations : %d", id, cnt);
GM_Log(str);
sprintf(str, "%s %d ma:%d mf:%d", id, thread(`idt), ma, mf);
GM_Log(str);
sprintf(str, "%s %d-Done.  %.2fs", id, thread(`idt), ptime() - start);
GM_Log(str);
strfree(str);
// Expect "Ex-0014. Iterations : 10000000"
