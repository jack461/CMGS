// The 10M loops test
// with abs and sin...
var startA = ptime();
var idA = "Ex-0013.";
var str89 = stralloc();
sprintf(str89, "%s %d-Start [expect %d iterations]", idA, thread(`idt), 6000000);
GM_Log(str89);

var sA = 0, cA = 0;
var epsA = 0.00001;
var iiiA = 0;
loop (100,
    loop (200,
        loop (300,
            iiiA += 1; cA += epsA;
            sA += abs(sin(cA));
        );
    );
);

sprintf(str89, "%s Duration:  %.2f s.", idA, ptime() - startA);
GM_Log(str89);
sprintf(str89, "%s Iterations:  %d", idA, iiiA);
GM_Log(str89);
sprintf(str89, "%s Result: %f    [expected 3804758.854101]", idA, sA);
GM_Log(str89);

sprintf(str89, "%s %d-End", idA, thread(`idt));
GM_Log(str89);
strfree(str89);

// Expect "Ex-0013. Iterations:  6000000"
// Expect "Ex-0013. Result: 3804758.854101"

