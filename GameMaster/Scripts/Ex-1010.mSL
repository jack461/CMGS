print("Ex-1010. Interstys table : effets LFO, Mixer, Auto Mixer, Filter.");

/*
  Les effets sont designes par des noms ; ils sont decrits (Dump), verifies (Check), modifies, puis supprimes.
  L'Auto Mixer calcule ses gains (-6.02 dB pour 2 sources) : son Dump ne les montre pas.
  "Effect lf type Filter" : un nouveau type prend ses valeurs par defaut (1000 Hz, Q 0.707, LP, 1 etage),
  comme dans le pad. Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect lf  type LFO  chan 2  freq 2  mode Triangle  amp 0.5  offset 0.25  spread 0.5
    Effect mx  type Mixer  chan 2  out Bus 2  src1 In:0  gain1 -6  src3 Effect lf  gain3 -12  status Off
    Effect am  type AutoMix  chan 2  src1 In:0  src2 Bus 4
    Effect fl  type Filter  chan 2  phase Post  limiter On  source Effect mx  gain -3  freq 500  q 2  mode BP  stages 4
               mod Cutoff Effect lf depth 1.5  status Bypass
    Dump Effect lf
    Dump Effect mx
    Dump Effect am
    Dump Effect fl
    Check Effect lf  type LFO  freq 2  mode Triangle  amp 0.5  offset 0.25  spread 0.5  status On
    Check Effect mx  out Bus 2  src1 In:0  gain1 -6  src3 Effect lf  gain3 -12  src2 none  status Off
    Check Effect am  type AutoMix  src2 Bus 4
    Check Effect fl  freq 500  q 2  mode BP  stages 4  mod Cutoff Effect lf depth 1.5 att 1  mod Reso none  status Bypass
    Effect fl  mode HP  mod Cutoff none
    Check Effect fl  mode HP  mod Cutoff none  freq 500
    Effect lf  type Filter
    Check Effect lf  type Filter  freq 1000  q 0.707  mode LP  stages 1
    Free Effect fl
    Free Effect am
    Free Effect mx
    Free Effect lf
    Check Effect mx  status Undefined
));
print(sprintf(0, "Ex-1010. resultat : %d", r));

// Expected "Effect %d status On type LFO phase Std chan 2 out Own freq 2 mode Triangle amp 0.5 offset 0.25 spread 0.5"
// Expected "Effect %d status Off type Mixer phase Std chan 2 out Bus 2:0 limiter Off src1 In:0 gain1 -6 src3 Effect %d gain3 -12"
// Expected "Effect %d status On type AutoMix phase Std chan 2 out Own limiter Off src1 In:0 src2 Bus 4:0"
// Expected "Effect %d status Bypass type Filter phase Post chan 2 out Own limiter On source Effect %d gain -3 freq 500 q 2 mode BP stages 4 mod Cutoff Effect %d depth 1.5 att 1"
