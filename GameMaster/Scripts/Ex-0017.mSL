var fan = (+);
var fun = (*);
var fiz = (sin);
var fdv = (/);

sprintf(str,"%s test:sin  %.0f %g", id, fiz, fiz(2.2));
GM_Log(str);

sprintf(str,"%s test:*  %.0f %g", id, fun, fun(12,34));
GM_Log(str);


sprintf(str,"%s test:+  %.0f %g", id, fan, fan(62,39));
GM_Log(str);

sprintf(str,"%s test:/  %.0f %g", id, fdv, fdv(62,31));
GM_Log(str);

var z = 0x3ffA27342C5;
sprintf(str,"%s hex: %.0f  %.0f", id, z,  4396477006533);
GM_Log(str);


sprintf(str,"%s End", id);

