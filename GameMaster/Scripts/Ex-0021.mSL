print("Ex-0021. data : codage de In:0 et de Bus 2:1.");

/*
  Dans un data, "In:0" donne trois mots : l'identificateur `In, le caractere ":" et l'entier 0.
  Un operateur ou un separateur y est code par son caractere + mSL_CharConst (0x7FFF * 2^24),
  comme la virgule (mSL_cstComma) : ":" doit valoir 32767 * 16777216 + 58 = 549739036730.
*/

var colon = 32767 * 16777216 + 58;
var d = data(In:0 Bus 2:1);
print(sprintf(0, "Ex-0021. In:0 : %s", ((d[0] === `In) && (d[1] === colon) && (d[2] === 0)) ? "OK" : "ERREUR"));
print(sprintf(0, "Ex-0021. Bus 2:1 : %s", ((d[3] === `Bus) && (d[4] === 2) && (d[5] === colon) && (d[6] === 1)) ? "OK" : "ERREUR"));
print(sprintf(0, "Ex-0021. mots : %.0f %.0f %.0f", d[0], d[1], d[2]));

// Expected "Ex-0021. In:0 : OK"
// Expected "Ex-0021. Bus 2:1 : OK"
// Expected "Ex-0021. mots : %d %d 0"
