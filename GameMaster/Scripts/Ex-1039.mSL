print("Ex-1039. Interstys table : 512 effets (des numeros au-dela de 256).");

/*
  Les effets 400, 401 et 512 (le dernier) : un filtre, un second filtre dont la source est l'effet 400, un LFO. Le Dump
  ecrit leurs numeros et la source "Effect 400". Erreur (rien n'est cree) : e1 l'effet 513 n'existe pas (2752).
  Les modules Effect A ... P (16 vues) se verifient a la main : sous-menu Effects du menu des modules.
*/

var r = table(data(
    Interstys
    Effect 400  type Filter  chan 1  source In:0  freq 500
    Effect 401  type Filter  chan 1  source Effect 400  freq 3000  mode HP
    Effect 512  type LFO  chan 1  freq 2
    Dump Effect 400
    Dump Effect 401
    Dump Effect 512
    Check Effect 401  source Effect 400  freq 3000
    Free Effect 401
    Free Effect 400
    Free Effect 512
));
print(sprintf(0, "Ex-1039. resultat : %d", r));

var e1 = table(data( Interstys  Effect 513  type LFO ));
print(sprintf(0, "Ex-1039. effet 513 : %d", e1));

