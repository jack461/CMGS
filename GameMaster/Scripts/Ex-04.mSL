/*
   Cet exemple doit être chargé après l'exécution de l'exemple 03,
   qui définit la fonction "fib" sous forme d'une valeur "externe"
*/
print("Appel de Fibonacci externe.");

ext fib;
var str = stralloc(); 

sprintf(str, "fib = %d", fib);
print(str); 

var s = 5;
sprintf(str, "fib(%d) vaut %d", s, fib(s)); 
print(str); 

strfree(str);
