print("Ex-1026. Interstys table : le point de sustain des enveloppes (Curve ... sustain).");

/*
  Une enveloppe avec un point de sustain (le 2e), le Dump, le Check ; de nouveaux points sans sustain : plus de sustain ;
  sustain 3, puis Off ; une enveloppe devenue forme d'onde perd son sustain. Les erreurs (2799, detectees
  en passe 3 si le bloc ne donne pas les points ou le type) : un sustain au-dela des points, un sustain sur une forme d'onde.
*/

var r = table(data(
    Interstys
    Curve csus  type Env  sustain 2  points 0 0 0  0.3 0.8 0.5  1 0 0
    Dump Curve csus
    Check Curve csus  sustain 2
    Curve csus  points 0 0 0  0.2 1 0  0.6 0.7 0  1 0 0
    Check Curve csus  sustain 0
    Curve csus  sustain 3
    Dump Curve csus
    Curve csus  sustain Off
    Check Curve csus  sustain 0
    Curve csus  sustain 2
    Curve csus  type Wave
    Check Curve csus  type Wave  sustain 0
));
print(sprintf(0, "Ex-1026. resultat : %d", r));

var e1 = table(data( Interstys  Curve csus  type Env  sustain 5 ));
print(sprintf(0, "Ex-1026. sustain hors des points : %d", e1));
var e2 = table(data( Interstys  Curve csus  sustain 2 ));
print(sprintf(0, "Ex-1026. sustain d'une forme d'onde : %d", e2));
var r2 = table(data( Interstys  Curve csus  type Env  sustain 4  Check Curve csus  type Env  sustain 4  Free Curve csus ));
print(sprintf(0, "Ex-1026. fin : %d", r2));

