print("Ex-0002. Recherche du plus grand élément d'un tableau.");

var liste = array (7, 11, 43, 0, 2, 1, 1, 637, -7, 13); 

var s; var i; 

s = liste[0]; i = 1; 

while (i < size(liste)) (

    s = max(s, liste[i]);

    i = i + 1;

); 

var str = stralloc(); 

sprintf(str, "Ex-0002. s vaut %d", s); 

print(str); 
// Expected "Ex-0002. s vaut 637"