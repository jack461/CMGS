print("Ex-1006. Interstys table : lignes designees par des noms.");

/*
  Un nom recoit une ligne libre, que l'analyse annonce dans le log ; il n'est valable que
  dans ce "table". Les deux lignes sont supprimees a la fin.
*/

var r = table(data(
    Line toto  length 0.5  chan 1
    Line titi  length 1.5  chan 3
    Check Line toto  length 0.5  chan 1
    Check Line titi  length 1.5  chan 3
    Free Line toto
    Free Line titi
));
print(sprintf(0, "Ex-1006. resultat : %d", r));

// Expected "Interstys table : toto = Line %d"
// Expected "Interstys table : titi = Line %d"
// Expected "Check Line %d OK"
// Expected "Check Line %d OK"
// Expected "Ex-1006. resultat : 0"
