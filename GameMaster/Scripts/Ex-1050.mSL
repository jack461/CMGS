print("Ex-1050. Interstys table : les cles from, to, xfade, mute, solo d'un reader, le bloc Control.");

/*
  from, to : les limites de la boucle d'un reader sur une ligne (Dump : quand ce n'est pas toute la ligne) ; xfade : le fondu
  en ms (Dump : quand ce n'est pas 10) ; mute, solo : On ou Off (Dump : quand ils sont On). Control n value v : le curseur
  generique Ctl n (v dans [-1, 1]), Dump Control n.
  Erreurs (rien n'est fait) : e1 Control sans le mot value (2725) ; e2 Control 65 (2754) ; e3 Export ni Patch ni Session (2726).
*/

var r = table(data(
    Interstys
    Line lx  length 2  chan 1
    Reader rx  line lx  loop loop  from 0.5  to 1.5  xfade 20  mute On  solo Off  status Paused
    Dump Reader rx
    Check Reader rx  from 0.5  to 1.5  xfade 20  mute On  solo Off
    Reader rx  from 0  to 2  xfade 10  mute Off
    Dump Reader rx
    Check Reader rx  from 0  to 2  xfade 10  mute Off
    Free Reader rx
    Free Line lx
    Control 7 value 0.25
    Dump Control 7
    Control 7 value 0
    Dump Control 7
));
print(sprintf(0, "Ex-1050. resultat : %d", r));

var e1 = table(data( Interstys  Control 7 0.25 ));
var e2 = table(data( Interstys  Control 65 value 0 ));
var e3 = table(data( Interstys  Export Nothing ));
print(sprintf(0, "Ex-1050. erreurs : %d %d %d", e1, e2, e3));

