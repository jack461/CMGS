print("Ex-1003. Interstys : un parametre a un seul descripteur.");

/*
  Le descripteur d'un parametre est cree au premier appel, puis reutilise (pp_mSL_Ref) :
  le nom et le numero du parametre doivent rendre le meme bloc.
*/

var a = gui(`slider, `PlayPos);
var b = gui(`slider, `PlayPos);
var c = gui(`slider, a[1]);
print(sprintf(0, "Ex-1003. meme descripteur : %s", ((a !== $undef) && (a === b) && (a === c)) ? "OK" : "ERREUR"));
print(sprintf(0, "Ex-1003. PlayPos : %s", a[4]));

// Expected "Ex-1003. meme descripteur : OK"
// Expected "Ex-1003. PlayPos : Play position"
