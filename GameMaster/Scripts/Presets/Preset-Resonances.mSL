print("Preset-Resonances. Le son excite des corps accordes qui changent d'accord ; 10 minutes, mono, dans le buffer de sortie.");

/*
  PRESET "RESONANCES" : des corps resonants
  Le buffer d'entree ne s'entend plus : il devient l'excitation de resonateurs. Des grains brefs et des segments (Brage),
  pris au hasard dans le buffer, frappent deux bancs de six filtres passe-bande tres etroits (accordes sur un spectre
  tire au hasard : harmoniques, harmoniques impaires, partiels d'une barre ou d'une cloche, accords justes, une grappe
  serree, les partiels aigus d'un son grave, ou au hasard ; parfois etires) et un reseau de retards accorde (Matrix :
  des retards multiples d'une periode, ou egaux : un peigne), qui sonne comme une corde, un tube, une plaque. D'une
  section a l'autre, l'accord mute (un banc remplace l'autre, en fondu ou d'un coup) ou glisse (tout le banc monte ou
  descend d'un intervalle) ; le peigne se reaccorde en glissant. Un decaleur de frequence fait battre et deriver les
  partiels ; des frappes soudaines (une rafale de grains) relancent les resonances.
  La forme : des sections de 12 s a 1 min ; des evenements toutes les 1.5 a 6 s.

  Utilisation (la meme pour les cinq presets : Nuee, Glacier, Sillons, Resonances, Vertige)
    - Regler les variables de "Reglages" ci-dessous, puis deposer ce fichier dans la fenetre d'Interstys. Une session
      vierge suffit : le preset cree ses buffers et ses modules, dans deux instances (resonin : le buffer d'entree ;
      reson : le traitement et le buffer de sortie), sans toucher aux autres modules.
    - Sans fichier (fichier = "") : le son de la piste est enregistre dans le buffer d'entree (In:0, et In:1 si canaux
      vaut 2) pendant "duree" secondes. Lancer d'abord la lecture de la piste (une nappe, un son de plusieurs minutes),
      puis deposer le preset : la generation commence apres 6 secondes d'enregistrement, et ne puise que dans la part
      deja enregistree. Avec un fichier : il est lu dans le buffer d'entree (mono ou stereo ; un nom relatif au dossier
      du projet, GMAuxiliary.eel en marche, ou un chemin complet), et "duree" doit valoir sa duree (ou moins : au-dela,
      les positions reviennent au debut du fichier).
    - La generation dure "sortie" secondes, en temps reel : REAPER doit faire tourner la piste (lecture en cours, ou
      piste armee avec le monitoring). Le resultat, mono, s'ecrit dans le buffer de sortie (la ligne "res" de l'instance
      reson, "reson:res" dans une table) et s'entend sur Out:0 et Out:1 (niveau "ecoute"). Le journal suit les sections.
    - Le hasard decide de tout (les positions dans le buffer, les durees, les textures, les hauteurs, les enchainements) :
      chaque execution est differente. Redeposer le fichier relance une generation (la precedente s'arrete, ses buffers
      sont refaits). Presets-Stop.mSL arrete les generations en cours (un fondu ; les buffers restent) ;
      Presets-Free.mSL retire tout.
    - La premiere fois, le journal note deux erreurs (2787, 2757) : les instances a retirer n'existent pas encore.
*/

// ======================================================================================================================
// Reglages
// ======================================================================================================================
var fichier = "";     // un fichier son pour le buffer d'entree ; "" : le son de la piste (In:0) est enregistre
var duree = 300;      // la duree du buffer d'entree (s, au plus 1300) : celle de l'enregistrement, ou celle du fichier
var canaux = 2;       // les canaux enregistres : 1 (In:0) ou 2 (In:0 et In:1) ; un fichier donne les siens
var continu = 0;      // 1 : l'enregistrement continue (le buffer garde les "duree" dernieres secondes) ; 0 : il s'arrete
var sortie = 600;     // la duree produite dans le buffer de sortie (s)
var ecoute = 6;      // le niveau d'ecoute du resultat sur Out:0 et Out:1 (dB ; -120 : muet)

// ======================================================================================================================
// Outils (les memes dans les cinq presets)
// ======================================================================================================================
var NOM = `reson;                    // le nom du processus : un nouveau depot de ce preset arrete celui-ci
var TITRE = "Preset-Resonances";
var PH = 7700000000;                 // dans une table modele, le mot PH + k est remplace par la k-ieme valeur (tab)
var arret = 0;                       // 1 : arret demande (Presets-Stop.mSL : un fondu), 2 : arret immediat
var T0 = 0;                          // le debut de la generation (ptime)
var Trec = 0;                        // le debut de l'enregistrement du buffer d'entree
var recfin = 0;                      // 1 : l'enregistrement est termine
var avecfic = (strlen(fichier) > 0); // 1 : le buffer d'entree vient d'un fichier
var FIN = 8;                         // le fondu final (s)
var E = 0.4;                         // l'energie (0 ... 1) : elle erre, et choisit les sections
var NS = 0;                          // les sections

// le hasard : le generateur de rand() avance d'un nombre de pas tire de l'horloge, chaque execution est differente
var k0 = floor(1000000 * (ptime() - floor(ptime())));
loop(1 + (k0 % 7919), rand(1));

function alea(a, b) ( a + rand(b - a); );                       // un reel dans [a, b]
function aleal(a, b) ( a * pow(b / a, rand(1)); );              // dans [a, b] (a, b > 0), en echelle logarithmique
function proba(p) ( rand(1) < p; );                             // vrai avec la probabilite p
function signe(p) ( (rand(1) < p) ? -1 : 1; );                  // -1 avec la probabilite p, sinon 1
function borne(x, a, b) ( max(a, min(b, x)); );
function pioche(t) ( t[min(t[-1] - 1, floor(rand(t[-1])))]; );  // un element d'un tableau, au hasard
function tps() ( ptime() - T0; );                               // le temps de la generation (s)

// un indice tire selon les poids du tableau w
function tirage(w) local(s, i, u, k)
(
    s = 0; i = 0; while (i < w[-1]) ( s += w[i]; i += 1; );
    u = rand(s); k = 0; s = w[0];
    while ((k < w[-1] - 1) && (u >= s)) ( k += 1; s += w[k]; );
    k;
);

// la table modele m (un data), ses mots PH + 1, PH + 2... remplaces par les valeurs v1, v2... : tab(m, v1, v2...) ;
// m n'est pas modifiee ; une instance qui n'existe plus (retiree a la main) arrete la generation
function tab(n; v) local(m, c, i, w, r)
(
    r = -1;
    (arret !== 2) ? (
        m = v[0]; c = malloc(m[-1]);
        i = 0; while (i < m[-1]) (
            w = m[i];
            ((w > PH) && (w < PH + n)) ? (w = v[w - PH]);
            c[i] = w; i += 1;
        );
        r = table(c);
        mfree(c);
        (r !== 0) ? (
            print(sprintf(0, "%s : erreur %04d dans une table", TITRE, r));
            ((r === 2757) || (r === 2787)) ? (arret = 2);
        );
    );
    r;
);

// attendre d secondes ; un message "stop" (Presets-Stop.mSL, ou un nouveau depot du preset) arrete la generation
function attend(d) local(t1, m)
(
    t1 = ptime() + d;
    while ((arret === 0) && (ptime() < t1 - 0.005)) (
        (t1 - ptime() >= 1) ? (
            m = event(`wait, t1 - ptime());
            (m > 0) ? (
                (m[2] === `stop) ? (arret = (m[14] === 1) ? 2 : 1);
                event(`recycle, m);
            );
        ) : (
            wait(t1 - ptime());
        );
    );
);

// la fin : attendre d secondes ; seul un nouveau depot du preset (un arret immediat) interrompt
function attfin(d) local(t1, m)
(
    t1 = ptime() + d;
    while ((arret !== 2) && (ptime() < t1 - 0.005)) (
        (t1 - ptime() >= 1) ? (
            m = event(`wait, t1 - ptime());
            (m > 0) ? (
                ((m[2] === `stop) && (m[14] === 1)) ? (arret = 2);
                event(`recycle, m);
            );
        ) : (
            wait(t1 - ptime());
        );
    );
);

// la duree utilisable du buffer d'entree (s) : la part deja enregistree, ou la duree du fichier
function dispo() local(e)
(
    avecfic ? duree : (
        e = ptime() - Trec;
        (e >= duree) ? duree : max(2, e - 0.5);
    );
);

// l'energie erre autour d'un arc (faible au debut et a la fin, forte au milieu)
function energie() local(x, arc)
(
    x = borne(tps() / sortie, 0, 1);
    arc = 0.2 + 0.6 * sin($pi * x);
    E = borne(0.5 * E + 0.5 * (arc + alea(-0.35, 0.35)), 0, 1);
);

// la duree d'une transition : une coupure (20 %), un fondu court (50 %) ou long (30 %)
function transit() local(u)
(
    u = rand(1);
    (u < 0.2) ? alea(0.03, 0.15) : ((u < 0.7) ? alea(0.8, 4) : alea(5, 14));
);

// ======================================================================================================================
// Resonances : les modules
// ======================================================================================================================
/*
  L'instance reson : les excitateurs gx (Grains) et bx (Brage) sur le buffer d'entree (resonin:src), leurs niveaux
  (l1 s1, l2 s2), leur somme ex ; le banc A (filtres a1 ... a6, somme ma, niveau l3 s3 e3 v3, accord ka ta : le
  glissement de tout le banc, en octaves), le banc B (b1 ... b6, mb, l4 s4 e4 v4, kb tb) ; leur somme ab, le decaleur
  fs (Ring : Up ou Down) ; le peigne cm (Matrix accordee), son niveau (l5 s5 e5 v5) ; la somme su, l'espace sp ; le
  niveau general (lm sm em vm) ; res, wo ; l'ecoute m0, m1.
*/
var KM = 5;                                   // le niveau general (0, 1 : les excitateurs, 2, 3 : les bancs A, B, 4 : le peigne)
var MAST = -4;
var NVl = array(`l1, `l2, `l3, `l4, `l5, `lm);
var NVs = array(`s1, `s2, `s3, `s4, `s5, `sm);
var NVc = malloc(6);
var NVd = malloc(6);

// les niveaux : une cible (un LFO constant "l...") et une pente (un Math Slew "s..." : de -80 a 0 dB, par pas de
// 0.8 dB) ; ils modulent le volume d'un reader, le gain d'un writer, ou (Math Exp "e...", Math Mul "v...") un son ;
// niv(k, dB, s) : le niveau k va vers dB en s secondes (au plus 10 s par 0.8 dB) ; ils partent de -80 dB
var TNIV = data(Interstys  Effect reson:7700000003  offset 7700000001  Effect reson:7700000004  attack 7700000002  release 7700000002);
function niv(k, db, s) local(t, d, a)
(
    t = borne(1 + db / 80, 0, 1);
    d = 100 * abs(t - NVc[k]);
    a = borne(1000 * s / max(0.01, d), 1, 10000);
    NVc[k] = t; NVd[k] = db;
    tab(TNIV, t, a, NVl[k], NVs[k]);
);
var k1 = 0;
loop(KM + 1, NVd[k1] = -80; k1 += 1;);

// le buffer d'entree (l'instance resonin : la ligne src et le writer rec, qui l'enregistre depuis In:0)
var TIN = data(
    Interstys
    Algorithm ResonIn
        Line src  length 7700000001  chan 7700000002
        Writer rec  line src  source In:0  status Paused
        Display Line src
    End
    Instance resonin ResonIn
);
var TFIC = data(Interstys  Line resonin:src  file 7700000001);
var TREC = data(Interstys  Writer resonin:rec  status 7700000001);
var TWS = data(Interstys  Writer reson:7700000001  status 7700000002);
var TRST = data(Interstys  Reader reson:7700000001  status 7700000002);

// l'enregistrement s'arrete quand le buffer d'entree est plein (sauf "continu")
function finrec()
(
    (!avecfic && !continu && !recfin && (ptime() - Trec >= duree)) ? (
        tab(TREC, `Paused); recfin = 1;
        print(sprintf(0, "%s : le buffer d'entree est complet (%d s)", TITRE, duree));
    );
);

var TCRE = data(
    Interstys
    Algorithm Reson
        Line res  length 7700000001  chan 1
        Effect l1  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s1  type Math  chan 1  source Effect l1  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l2  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s2  type Math  chan 1  source Effect l2  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l3  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s3  type Math  chan 1  source Effect l3  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l4  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s4  type Math  chan 1  source Effect l4  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l5  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s5  type Math  chan 1  source Effect l5  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect lm  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect sm  type Math  chan 1  source Effect lm  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect ka  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect ta  type Math  chan 1  source Effect ka  mode Slew  attack 1000  release 1000
        Effect kb  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect tb  type Math  chan 1  source Effect kb  mode Slew  attack 1000  release 1000
        Reader gx  line resonin:src  mode Grains  outchan 1  loop loop  out Own  size 20  density 10  plateau 0  fadein 30
                   mod Volume Effect s1  depth 80  law dB  status Reading
        Reader bx  line resonin:src  mode Brage  outchan 2  loop loop  out Own  block 120  overlap 20  search 0  transp 0
                   speed 1  mod Volume Effect s2  depth 80  law dB  status Reading
        Effect ex  type Mixer  chan 1  src1 Reader gx  gain1 0  src2 Reader bx:0  gain2 -3  src3 Reader bx:1  gain3 -3
        Effect a1  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 110  q 60  mod Cutoff Effect ta  depth 1
        Effect a2  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 220  q 60  mod Cutoff Effect ta  depth 1
        Effect a3  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 330  q 60  mod Cutoff Effect ta  depth 1
        Effect a4  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 440  q 60  mod Cutoff Effect ta  depth 1
        Effect a5  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 550  q 60  mod Cutoff Effect ta  depth 1
        Effect a6  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 660  q 60  mod Cutoff Effect ta  depth 1
        Effect ma  type Mixer  chan 1  src1 Effect a1  gain1 20  src2 Effect a2  gain2 20  src3 Effect a3  gain3 20
                    src4 Effect a4  gain4 20  src5 Effect a5  gain5 20  src6 Effect a6  gain6 20
        Effect b1  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 110  q 60  mod Cutoff Effect tb  depth 1
        Effect b2  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 220  q 60  mod Cutoff Effect tb  depth 1
        Effect b3  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 330  q 60  mod Cutoff Effect tb  depth 1
        Effect b4  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 440  q 60  mod Cutoff Effect tb  depth 1
        Effect b5  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 550  q 60  mod Cutoff Effect tb  depth 1
        Effect b6  type Filter  chan 1  source Effect ex  mode BP  stages 2  freq 660  q 60  mod Cutoff Effect tb  depth 1
        Effect mb  type Mixer  chan 1  src1 Effect b1  gain1 20  src2 Effect b2  gain2 20  src3 Effect b3  gain3 20
                    src4 Effect b4  gain4 20  src5 Effect b5  gain5 20  src6 Effect b6  gain6 20
        Effect e3  type Math  chan 1  source Effect s3  gain 38.0618  mode Exp
        Effect v3  type Math  chan 1  source Effect ma  src2 Effect e3  mode Mul
        Effect e4  type Math  chan 1  source Effect s4  gain 38.0618  mode Exp
        Effect v4  type Math  chan 1  source Effect mb  src2 Effect e4  mode Mul
        Effect ab  type Mixer  chan 1  src1 Effect v3  gain1 0  src2 Effect v4  gain2 0
        Effect fs  type Ring  chan 1  source Effect ab  mode 7700000002  freq 1.5  wave Sine  mix 40
        Effect cm  type Matrix  chan 1  source Effect ex  mode Hadamard  lines 8  delays Harmonic  dmin 9  dmax 160  decay 6
                   damp 6000  glide 4  mix 100
        Effect e5  type Math  chan 1  source Effect s5  gain 38.0618  mode Exp
        Effect v5  type Math  chan 1  source Effect cm  src2 Effect e5  mode Mul
        Effect su  type Mixer  chan 1  src1 Effect fs  gain1 0  src2 Effect v5  gain2 0
        Effect sp  type Matrix  chan 1  source Effect su  mode Householder  lines 12  delays Random  seed 7700000003  dmin 19
                   dmax 120  decay 2.5  damp 8000  wow 2  rate 0.3  mix 30
        Effect em  type Math  chan 1  source Effect sm  gain 38.0618  mode Exp
        Effect vm  type Math  chan 1  source Effect sp  src2 Effect em  mode Mul  limiter On
        Writer wo  line res  source Effect vm  status Paused
        Effect m0  type Mixer  chan 1  src1 Effect vm  gain1 7700000004  out Out:0
        Effect m1  type Mixer  chan 1  src1 Effect vm  gain1 7700000004  out Out:1
        Display Line res
    End
    Instance reson Reson
);

// les modules : le decaleur vers le haut ou vers le bas, la graine de l'espace, l'ecoute
function creer() ( tab(TCRE, sortie + 30, (proba(0.5) ? `Up : `Down), floor(rand(99999)), borne(ecoute, -120, 40)); );

var TBK = data(Interstys
    Effect reson:7700000001  freq 7700000007  q 7700000013  Effect reson:7700000002  freq 7700000008  q 7700000013  Effect reson:7700000003  freq 7700000009  q 7700000013
    Effect reson:7700000004  freq 7700000010  q 7700000013  Effect reson:7700000005  freq 7700000011  q 7700000013  Effect reson:7700000006  freq 7700000012  q 7700000013
    Effect reson:7700000014  gain1 7700000015  gain2 7700000015  gain3 7700000015  gain4 7700000015  gain5 7700000015  gain6 7700000015);
var TTU = data(Interstys  Effect reson:7700000001  offset 7700000002  Effect reson:7700000003  attack 7700000004  release 7700000004);
var TCM = data(Interstys  Effect reson:cm  dmin 7700000001  delays 7700000002  decay 7700000003  damp 7700000004);
var TFS = data(Interstys  Effect reson:fs  freq 7700000001);
var TGX = data(Interstys  Reader reson:gx  from 7700000001  to 7700000002  size 7700000003  density 7700000004  speed 7700000005  onsetrnd 7700000006  direction 7700000007
    sizernd 7700000008  speedrnd 7700000009);
var TBX = data(Interstys  Reader reson:bx  from 7700000001  to 7700000002  block 7700000003  speed 7700000004  transp 7700000005);
var TDX = data(Interstys  Reader reson:gx  density 7700000001);

var BKA = array(`a1, `a2, `a3, `a4, `a5, `a6);
var BKB = array(`b1, `b2, `b3, `b4, `b5, `b6);
// les spectres (rapports a la fondamentale) ; le dernier (hasard) est tire a chaque fois
var R0 = array(1, 2, 3, 4, 5, 6);
var R1 = array(1, 3, 5, 7, 9, 11);
var R2 = array(1, 2.756, 5.404, 8.933, 13.345, 18.64);
var R3 = array(0.56, 0.92, 1.19, 1.71, 2.74, 3.76);
var R4 = array(1, 1.25, 1.5, 2, 2.5, 3);
var R5 = array(1, 1.2, 1.5, 1.8, 2.4, 3.6);
var R6 = array(1, 1.029, 1.059, 1.122, 1.189, 1.26);
var R7 = array(8, 9, 10, 11, 13, 15);
var RS = array(R0, R1, R2, R3, R4, R5, R6, R7);
var RNOM = array("harmoniques", "impaires", "barre", "cloche", "majeur", "mineur", "grappe", "aigus", "hasard");
var GLI = array(-1, -0.5833, -0.4167, -0.1667, -0.0833, 0.0833, 0.1667, 0.4167, 0.5833, 1);   // les glissements (octaves)
var SPX = array(0.5, 1, 1, 2);                // les vitesses des grains
var SPB = array(-1, -0.5, 0.5, 1, 1, 2);      // celles des segments
var FQ = malloc(6);                           // les frequences d'un banc
var TU = malloc(2);                           // le glissement de chaque banc (octaves)
var CUR = 0;                                  // le banc qui sonne (0 : A, 1 : B)

// un accord pour le banc bk : un spectre (etire une fois sur trois), une fondamentale de 40 a 300 Hz, des filtres plus
// ou moins etroits (q de 30 a 400 : plus il est grand, plus ils resonnent), leur gain compense ; le banc ne glisse plus
function accord(bk) local(k, j, rs, f0, x, q, g, nm)
(
    k = floor(rand(8.999));
    rs = (k < 8) ? RS[k] : 0;
    f0 = aleal(40, 300);
    x = proba(0.3) ? alea(0.97, 1.08) : 1;
    j = 0;
    loop(6,
        FQ[j] = borne(f0 * ((k < 8) ? pow(rs[j], x) : aleal(1, 9)), 30, 12000);
        j += 1;
    );
    q = aleal(30, 400);
    g = borne(10 * log10(q) + 4, 0, 40);
    nm = (bk === 0) ? BKA : BKB;
    print(sprintf(0, "%s %d:%02d  banc %s : %s sur %d Hz, q %d", TITRE, floor(tps() / 60), floor(tps()) % 60,
        ((bk === 0) ? "A" : "B"), RNOM[k], floor(f0), floor(q)));
    tab(TBK, nm[0], nm[1], nm[2], nm[3], nm[4], nm[5], FQ[0], FQ[1], FQ[2], FQ[3], FQ[4], FQ[5], q,
        ((bk === 0) ? `ma : `mb), g);
    tab(TTU, ((bk === 0) ? `ka : `kb), 0, ((bk === 0) ? `ta : `tb), 1);
    TU[bk] = 0;
);

// une mutation : l'autre banc recoit un nouvel accord, puis les bancs s'echangent en tf secondes
function mutation(tf) local(o)
(
    o = 1 - CUR;
    accord(o);
    niv(2 + o, alea(-6, -1), tf);
    niv(2 + CUR, -80, tf * alea(0.7, 1.5));
    CUR = o;
);

// un glissement : le banc qui sonne monte ou descend d'un intervalle, en s secondes
function gliss(s) local(t)
(
    t = borne(TU[CUR] + pioche(GLI), -2, 2);
    tab(TTU, ((CUR === 0) ? `ka : `kb), t, ((CUR === 0) ? `ta : `tb), borne(1000 * s / max(0.01, abs(t - TU[CUR])), 1, 10000));
    TU[CUR] = t;
);

// le peigne se reaccorde (en glissant) : sa periode, des retards multiples ou egaux, sa duree, son amortissement
function peigne() local(f)
(
    f = aleal(35, 400);
    tab(TCM, borne(1000 / f, 2.5, 28), (proba(0.65) ? `Harmonic : `Equal), aleal(2, 14), aleal(2500, 9000));
);

// les excitateurs : des regions au hasard, des grains de 10 a 40 ms (plus denses avec l'energie), des segments
function excite() local(d, w, a)
(
    d = dispo();
    w = borne(aleal(0.5, 30), min(d, 0.3), d); a = rand(max(0, d - w));
    tab(TGX, a, a + w, aleal(10, 40), aleal(2, 10 + 60 * E), pioche(SPX), alea(0, 1), alea(-1, 1), alea(1, 2.5), alea(1, 1.5));
    w = borne(aleal(0.5, 30), min(d, 0.3), d); a = rand(max(0, d - w));
    tab(TBX, a, a + w, aleal(30, 400), pioche(SPB), (proba(0.3) ? alea(-7, 7) : 0));
);

// une frappe : une rafale de grains
function frappe() local(v)
(
    v = NVd[0];
    tab(TDX, 100);
    niv(0, alea(-4, 0), 0.02);
    attend(alea(0.1, 0.6));
    tab(TDX, aleal(2, 10 + 60 * E));
    niv(0, v, alea(0.5, 3));
);

// une section dure D secondes : toutes les 1.5 a 6 s, une frappe, un glissement, un nouveau decalage, de nouveaux
// excitateurs
function vivre(D) local(tf, u)
(
    tf = ptime() + D;
    while ((arret === 0) && (ptime() < tf - 0.3) && (tps() < sortie - FIN)) (
        attend(min(alea(1.5, 6), max(0.1, tf - ptime())));
        finrec();
        ((arret === 0) && (ptime() < tf - 1) && (tps() < sortie - FIN)) ? (
            u = rand(1);
            (u < 0.2) ? frappe() : ((u < 0.35) ? gliss(aleal(3, 12)) :
            ((u < 0.5) ? tab(TFS, aleal(0.1, 20)) : ((u < 0.65) ? excite() : 0)));
        );
    );
);

function section() local(D, tr)
(
    energie();
    NS += 1;
    D = aleal(12, 60);
    tr = transit();
    print(sprintf(0, "%s %d:%02d  section %d : %d s (energie %.2f)", TITRE, floor(tps() / 60), floor(tps()) % 60, NS,
        floor(D + 0.5), E));
    ((NS === 1) || proba(0.65)) ? mutation((proba(0.2) ? 0.05 : aleal(1.5, 10))) : gliss(aleal(4, 20));
    excite();
    niv(0, (proba(0.8) ? alea(-6, 0) : -80), tr);
    niv(1, (proba(0.5) ? alea(-10, -2) : -80), tr);
    proba(0.6) ? (
        peigne();
        niv(4, alea(-14, -4), tr);
    ) : niv(4, -80, tr);
    tab(TFS, (proba(0.6) ? aleal(0.1, 3) : aleal(3, 25)));
    vivre(D);
);

// la fin : les excitateurs s'arretent
function arreter() ( tab(TRST, `gx, `Paused); tab(TRST, `bx, `Paused); );

// ======================================================================================================================
// Demarrage, generation, fin (les memes dans les cinq presets)
// ======================================================================================================================
// un depot precedent de ce preset : son chef d'orchestre s'arrete (ses modules sont refaits ci-dessous)
(thread(`count, NOM) > 0) ? (
    loop(thread(`count, NOM), event(`notify, 0, 0, 0, 0, NOM, `stop, 0, 10, 0, 0, 0, 1, 0));
    wait(1.5);
);
thread(`name, NOM);
// les instances precedentes (la ligne d'abord : lue d'un fichier, elle n'appartient plus a son instance)
table(data( Free Instance reson ));
table(data( Free Line resonin:src  Free Instance resonin ));
var r = tab(TIN, (avecfic ? 1 : borne(duree, 2, 1300)), (avecfic ? 1 : borne(canaux, 1, 2)));
((r === 0) && avecfic) ? (r = tab(TFIC, fichier));
(r === 0) ? (r = creer());
(r !== 0) ? (
    print(sprintf(0, "%s : les modules n'ont pas pu etre crees (erreur %04d), rien n'est genere.", TITRE, r));
    arret = 2;
);
(arret === 0) ? (
    Trec = ptime();
    avecfic ? (
        print(sprintf(0, "%s : le buffer d'entree vient du fichier %s (%d s utilisees)", TITRE, fichier, duree));
    ) : (
        tab(TREC, `Writing);
        print(sprintf(0, "%s : enregistrement du buffer d'entree depuis In:0 (%d s, %d canal(aux))", TITRE, duree, canaux));
        attend(min(duree, 6));
    );
);
(arret === 0) ? (
    T0 = ptime();
    tab(TWS, `wo, `Writing);
    niv(KM, MAST, 3);
    print(sprintf(0, "%s : generation de %d s dans le buffer de sortie (reson:res)", TITRE, sortie));
);
while ((arret === 0) && (tps() < sortie - FIN)) ( section(); );
(arret !== 2) ? (
    niv(KM, -80, (arret === 1) ? 3 : FIN);
    attfin((arret === 1) ? 3.5 : (FIN + 0.5));
);
(arret !== 2) ? (
    tab(TWS, `wo, `Paused);
    arreter();
    (!avecfic && !recfin) ? tab(TREC, `Paused);
    print(sprintf(0, "%s : fin, %d s dans le buffer de sortie (reson:res)", TITRE, ((T0 > 0) ? floor(tps()) : 0)));
);
