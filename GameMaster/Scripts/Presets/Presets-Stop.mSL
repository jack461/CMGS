print("Presets-Stop. Arrete les generations des presets en cours (un fondu) ; leurs buffers et leurs modules restent.");

/*
  Envoie l'ordre "stop" au chef d'orchestre de chaque preset en cours (Nuee, Glacier, Sillons, Resonances, Vertige) :
  le niveau general descend en 3 secondes, puis le writer du buffer de sortie et les lecteurs s'arretent. Le buffer de
  sortie garde ce qui a ete genere (la ligne res de l'instance : nuee:res, glacier:res, sillons:res, reson:res,
  vertige:res). Pour tout retirer : Presets-Free.mSL.
*/

var noms = array(`nuee, `glacier, `sillons, `reson, `vertige);
var i = 0;
var n = 0;
while (i < noms[-1]) (
    loop(thread(`count, noms[i]),
        event(`notify, 0, 0, 0, 0, noms[i], `stop, 0, 10, 0, 0, 0, 0, 0);
        n += 1;
    );
    i += 1;
);
print(sprintf(0, "Presets-Stop. %d generation(s) arretee(s).", n));
