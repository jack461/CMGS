print("Presets-Free. Retire les presets : leurs modules, leurs buffers d'entree et de sortie, leurs modeles.");

/*
  Arrete d'abord les generations en cours (sans fondu), puis retire les instances des cinq presets (le traitement et le
  buffer de sortie, puis le buffer d'entree) et leurs modeles (Algorithm). Une table par instance : une instance
  absente donne une erreur (2787 ou 2757) sans empecher les autres.
*/

var noms = array(`nuee, `glacier, `sillons, `reson, `vertige);
var i = 0;
while (i < noms[-1]) (
    loop(thread(`count, noms[i]), event(`notify, 0, 0, 0, 0, noms[i], `stop, 0, 10, 0, 0, 0, 1, 0));
    i += 1;
);
wait(1.5);

var n = 0;
(table(data( Free Instance nuee )) == 0) ? (n += 1);
table(data( Free Line nueein:src  Free Instance nueein ));
(table(data( Free Instance glacier )) == 0) ? (n += 1);
table(data( Free Line glacin:src  Free Instance glacin ));
(table(data( Free Instance sillons )) == 0) ? (n += 1);
table(data( Free Line sillin:src  Free Instance sillin ));
(table(data( Free Instance reson )) == 0) ? (n += 1);
table(data( Free Line resonin:src  Free Instance resonin ));
(table(data( Free Instance vertige )) == 0) ? (n += 1);
table(data( Free Line vertin:src  Free Instance vertin ));
table(data( Free Algorithm Nuee ));
table(data( Free Algorithm NueeIn ));
table(data( Free Algorithm Glacier ));
table(data( Free Algorithm GlacIn ));
table(data( Free Algorithm Sillons ));
table(data( Free Algorithm SillIn ));
table(data( Free Algorithm Reson ));
table(data( Free Algorithm ResonIn ));
table(data( Free Algorithm Vertige ));
table(data( Free Algorithm VertIn ));
print(sprintf(0, "Presets-Free. %d preset(s) retire(s).", n));
