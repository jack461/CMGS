print("Preset-Nuee. Des nuees de grains preleves au hasard dans le buffer d'entree : 10 minutes, mono, dans le buffer de sortie.");

/*
  PRESET "NUEE" : la granulation
  Trois couches de grains puisent dans le buffer d'entree, a des positions tirees au hasard dans une fenetre qui saute
  d'une region a l'autre : des grains fins (une poussiere, un essaim), moyens (un nuage), longs (des trainees). Chaque
  couche a son champ de hauteurs, tire au hasard (unisson, octaves, quintes, douziemes, tritons, quartes, tierces,
  micro-intervalles, glissements continus), ses grains a l'endroit ou a l'envers, plus ou moins reguliers. Un phaser que
  balaye un mouvement aleatoire lent, un passe-bas qui respire et un reseau de retards (Matrix) qui diffuse et prolonge
  achevent de dissoudre le son d'origine.
  La forme : des sections de 6 s a 1 min (poussiere, essaim, nuage, trainees, tutti, silences), enchainees en coupures
  ou en fondus, choisies d'apres une "energie" qui erre (faible au debut et a la fin) ; dans chaque section, les
  fenetres derivent, les densites accelerent ou ralentissent, des accents surgissent.

  Utilisation (la meme pour les cinq presets : Nuee, Glacier, Sillons, Resonances, Vertige)
    - Regler les variables de "Reglages" ci-dessous, puis deposer ce fichier dans la fenetre d'Interstys. Une session
      vierge suffit : le preset cree ses buffers et ses modules, dans deux instances (nueein : le buffer d'entree ;
      nuee : le traitement et le buffer de sortie), sans toucher aux autres modules.
    - Sans fichier (fichier = "") : le son de la piste est enregistre dans le buffer d'entree (In:0, et In:1 si canaux
      vaut 2) pendant "duree" secondes. Lancer d'abord la lecture de la piste (une nappe, un son de plusieurs minutes),
      puis deposer le preset : la generation commence apres 6 secondes d'enregistrement, et ne puise que dans la part
      deja enregistree. Avec un fichier : il est lu dans le buffer d'entree (mono ou stereo ; un nom relatif au dossier
      du projet, GMAuxiliary.eel en marche, ou un chemin complet), et "duree" doit valoir sa duree (ou moins : au-dela,
      les positions reviennent au debut du fichier).
    - La generation dure "sortie" secondes, en temps reel : REAPER doit faire tourner la piste (lecture en cours, ou
      piste armee avec le monitoring). Le resultat, mono, s'ecrit dans le buffer de sortie (la ligne "res" de l'instance
      nuee, "nuee:res" dans une table) et s'entend sur Out:0 et Out:1 (niveau "ecoute"). Le journal suit les sections.
    - Le hasard decide de tout (les positions dans le buffer, les durees, les textures, les hauteurs, les enchainements) :
      chaque execution est differente. Redeposer le fichier relance une generation (la precedente s'arrete, ses buffers
      sont refaits). Presets-Stop.mSL arrete les generations en cours (un fondu ; les buffers restent) ;
      Presets-Free.mSL retire tout.
    - La premiere fois, le journal note deux erreurs (2787, 2757) : les instances a retirer n'existent pas encore.
*/

// ======================================================================================================================
// Reglages
// ======================================================================================================================
var fichier = "";     // un fichier son pour le buffer d'entree ; "" : le son de la piste (In:0) est enregistre
var duree = 240;      // la duree du buffer d'entree (s, au plus 1300) : celle de l'enregistrement, ou celle du fichier
var canaux = 2;       // les canaux enregistres : 1 (In:0) ou 2 (In:0 et In:1) ; un fichier donne les siens
var continu = 0;      // 1 : l'enregistrement continue (le buffer garde les "duree" dernieres secondes) ; 0 : il s'arrete
var sortie = 600;     // la duree produite dans le buffer de sortie (s)
var ecoute = 6;      // le niveau d'ecoute du resultat sur Out:0 et Out:1 (dB ; -120 : muet)

// ======================================================================================================================
// Outils (les memes dans les cinq presets)
// ======================================================================================================================
var NOM = `nuee;                    // le nom du processus : un nouveau depot de ce preset arrete celui-ci
var TITRE = "Preset-Nuee";
var PH = 7700000000;                 // dans une table modele, le mot PH + k est remplace par la k-ieme valeur (tab)
var arret = 0;                       // 1 : arret demande (Presets-Stop.mSL : un fondu), 2 : arret immediat
var T0 = 0;                          // le debut de la generation (ptime)
var Trec = 0;                        // le debut de l'enregistrement du buffer d'entree
var recfin = 0;                      // 1 : l'enregistrement est termine
var avecfic = (strlen(fichier) > 0); // 1 : le buffer d'entree vient d'un fichier
var FIN = 8;                         // le fondu final (s)
var E = 0.4;                         // l'energie (0 ... 1) : elle erre, et choisit les sections
var NS = 0;                          // les sections

// le hasard : le generateur de rand() avance d'un nombre de pas tire de l'horloge, chaque execution est differente
var k0 = floor(1000000 * (ptime() - floor(ptime())));
loop(1 + (k0 % 7919), rand(1));

function alea(a, b) ( a + rand(b - a); );                       // un reel dans [a, b]
function aleal(a, b) ( a * pow(b / a, rand(1)); );              // dans [a, b] (a, b > 0), en echelle logarithmique
function proba(p) ( rand(1) < p; );                             // vrai avec la probabilite p
function signe(p) ( (rand(1) < p) ? -1 : 1; );                  // -1 avec la probabilite p, sinon 1
function borne(x, a, b) ( max(a, min(b, x)); );
function pioche(t) ( t[min(t[-1] - 1, floor(rand(t[-1])))]; );  // un element d'un tableau, au hasard
function tps() ( ptime() - T0; );                               // le temps de la generation (s)

// un indice tire selon les poids du tableau w
function tirage(w) local(s, i, u, k)
(
    s = 0; i = 0; while (i < w[-1]) ( s += w[i]; i += 1; );
    u = rand(s); k = 0; s = w[0];
    while ((k < w[-1] - 1) && (u >= s)) ( k += 1; s += w[k]; );
    k;
);

// la table modele m (un data), ses mots PH + 1, PH + 2... remplaces par les valeurs v1, v2... : tab(m, v1, v2...) ;
// m n'est pas modifiee ; une instance qui n'existe plus (retiree a la main) arrete la generation
function tab(n; v) local(m, c, i, w, r)
(
    r = -1;
    (arret !== 2) ? (
        m = v[0]; c = malloc(m[-1]);
        i = 0; while (i < m[-1]) (
            w = m[i];
            ((w > PH) && (w < PH + n)) ? (w = v[w - PH]);
            c[i] = w; i += 1;
        );
        r = table(c);
        mfree(c);
        (r !== 0) ? (
            print(sprintf(0, "%s : erreur %04d dans une table", TITRE, r));
            ((r === 2757) || (r === 2787)) ? (arret = 2);
        );
    );
    r;
);

// attendre d secondes ; un message "stop" (Presets-Stop.mSL, ou un nouveau depot du preset) arrete la generation
function attend(d) local(t1, m)
(
    t1 = ptime() + d;
    while ((arret === 0) && (ptime() < t1 - 0.005)) (
        (t1 - ptime() >= 1) ? (
            m = event(`wait, t1 - ptime());
            (m > 0) ? (
                (m[2] === `stop) ? (arret = (m[14] === 1) ? 2 : 1);
                event(`recycle, m);
            );
        ) : (
            wait(t1 - ptime());
        );
    );
);

// la fin : attendre d secondes ; seul un nouveau depot du preset (un arret immediat) interrompt
function attfin(d) local(t1, m)
(
    t1 = ptime() + d;
    while ((arret !== 2) && (ptime() < t1 - 0.005)) (
        (t1 - ptime() >= 1) ? (
            m = event(`wait, t1 - ptime());
            (m > 0) ? (
                ((m[2] === `stop) && (m[14] === 1)) ? (arret = 2);
                event(`recycle, m);
            );
        ) : (
            wait(t1 - ptime());
        );
    );
);

// la duree utilisable du buffer d'entree (s) : la part deja enregistree, ou la duree du fichier
function dispo() local(e)
(
    avecfic ? duree : (
        e = ptime() - Trec;
        (e >= duree) ? duree : max(2, e - 0.5);
    );
);

// l'energie erre autour d'un arc (faible au debut et a la fin, forte au milieu)
function energie() local(x, arc)
(
    x = borne(tps() / sortie, 0, 1);
    arc = 0.2 + 0.6 * sin($pi * x);
    E = borne(0.5 * E + 0.5 * (arc + alea(-0.35, 0.35)), 0, 1);
);

// la duree d'une transition : une coupure (20 %), un fondu court (50 %) ou long (30 %)
function transit() local(u)
(
    u = rand(1);
    (u < 0.2) ? alea(0.03, 0.15) : ((u < 0.7) ? alea(0.8, 4) : alea(5, 14));
);

// ======================================================================================================================
// Nuee : les modules
// ======================================================================================================================
/*
  L'instance nuee : trois couches de grains g1 (fins), g2 (moyens), g3 (longs) qui lisent le buffer d'entree (nueein:src) ;
  leurs niveaux (l1 s1, l2 s2, l3 s3) ; leurs champs de hauteurs p1, p2, p3 (des Random qui modulent leur vitesse, en
  octaves : des paliers, ou une marche) ; leur melange mx ; un phaser ph, balaye par un Random lent (rf) ; un passe-bas
  lo qui respire (rb) ; un reseau de retards mt ; le niveau general (lm sm em vm) ; le buffer de sortie res et son
  writer wo ; l'ecoute m0, m1 (vers Out:0, Out:1).
*/
var KM = 3;                                   // le niveau general (0, 1, 2 : les couches)
var MAST = -4;                                // son niveau (dB)
var NVl = array(`l1, `l2, `l3, `lm);
var NVs = array(`s1, `s2, `s3, `sm);
var NVc = malloc(4);
var NVd = malloc(4);

// les niveaux : une cible (un LFO constant "l...") et une pente (un Math Slew "s..." : de -80 a 0 dB, par pas de
// 0.8 dB) ; ils modulent le volume d'un reader, le gain d'un writer, ou (Math Exp "e...", Math Mul "v...") un son ;
// niv(k, dB, s) : le niveau k va vers dB en s secondes (au plus 10 s par 0.8 dB) ; ils partent de -80 dB
var TNIV = data(Interstys  Effect nuee:7700000003  offset 7700000001  Effect nuee:7700000004  attack 7700000002  release 7700000002);
function niv(k, db, s) local(t, d, a)
(
    t = borne(1 + db / 80, 0, 1);
    d = 100 * abs(t - NVc[k]);
    a = borne(1000 * s / max(0.01, d), 1, 10000);
    NVc[k] = t; NVd[k] = db;
    tab(TNIV, t, a, NVl[k], NVs[k]);
);
var k1 = 0;
loop(KM + 1, NVd[k1] = -80; k1 += 1;);

// le buffer d'entree (l'instance nueein : la ligne src et le writer rec, qui l'enregistre depuis In:0)
var TIN = data(
    Interstys
    Algorithm NueeIn
        Line src  length 7700000001  chan 7700000002
        Writer rec  line src  source In:0  status Paused
        Display Line src
    End
    Instance nueein NueeIn
);
var TFIC = data(Interstys  Line nueein:src  file 7700000001);
var TREC = data(Interstys  Writer nueein:rec  status 7700000001);
var TWS = data(Interstys  Writer nuee:7700000001  status 7700000002);
var TRST = data(Interstys  Reader nuee:7700000001  status 7700000002);

// l'enregistrement s'arrete quand le buffer d'entree est plein (sauf "continu")
function finrec()
(
    (!avecfic && !continu && !recfin && (ptime() - Trec >= duree)) ? (
        tab(TREC, `Paused); recfin = 1;
        print(sprintf(0, "%s : le buffer d'entree est complet (%d s)", TITRE, duree));
    );
);

var TCRE = data(
    Interstys
    Algorithm Nuee
        Line res  length 7700000001  chan 1
        Effect l1  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s1  type Math  chan 1  source Effect l1  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l2  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s2  type Math  chan 1  source Effect l2  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l3  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s3  type Math  chan 1  source Effect l3  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect lm  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect sm  type Math  chan 1  source Effect lm  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect p1  type Random  chan 1  mode Step  dist Uniform  rate 12  jitter 0.7  steps 0  amp 0  offset 0
        Effect p2  type Random  chan 1  mode Step  dist Uniform  rate 6  jitter 0.7  steps 0  amp 0  offset 0
        Effect p3  type Random  chan 1  mode Walk  dist Uniform  rate 2  walk 0.3  glide 0.3  amp 0  offset 0
        Effect rf  type Random  chan 1  mode Smooth  dist Uniform  rate 0.2  jitter 0.5  amp 1  offset 0
        Effect rb  type Random  chan 1  mode Smooth  dist Gauss  rate 0.06  jitter 0.5  amp 1  offset 0
        Reader g1  line nueein:src  mode Grains  outchan 1  loop loop  out Own  size 40  density 5  plateau 10  fadein 50
                   mod Volume Effect s1  depth 80  law dB  mod Speed Effect p1  depth 1  law Oct  status Reading
        Reader g2  line nueein:src  mode Grains  outchan 1  loop loop  out Own  size 400  density 4  plateau 40  fadein 50
                   mod Volume Effect s2  depth 80  law dB  mod Speed Effect p2  depth 1  law Oct  status Reading
        Reader g3  line nueein:src  mode Grains  outchan 1  loop loop  out Own  size 2000  density 1  plateau 50  fadein 40
                   mod Volume Effect s3  depth 80  law dB  mod Speed Effect p3  depth 1  law Oct  status Reading
        Effect mx  type Mixer  chan 1  src1 Reader g1  gain1 0  src2 Reader g2  gain2 0  src3 Reader g3  gain3 0
        Effect ph  type Phaser  chan 1  source Effect mx  mode 7700000002  stages 7700000003  freq 700  sweep 3  rate 0.05  feedback 0.5
                   q 3  glide 3  mix 50  mod Freq Effect rf  depth 1.5
        Effect lo  type Filter  chan 1  source Effect ph  mode LP  stages 2  freq 5000  q 0.8  mod Cutoff Effect rb  depth 1.2
        Effect mt  type Matrix  chan 1  source Effect lo  mode Householder  lines 12  delays Random  seed 7700000004  dmin 17
                   dmax 110  decay 3  damp 7000  wow 3  rate 0.4  mix 7700000005
        Effect em  type Math  chan 1  source Effect sm  gain 38.0618  mode Exp
        Effect vm  type Math  chan 1  source Effect mt  src2 Effect em  mode Mul  limiter On
        Writer wo  line res  source Effect vm  status Paused
        Effect m0  type Mixer  chan 1  src1 Effect vm  gain1 7700000006  out Out:0
        Effect m1  type Mixer  chan 1  src1 Effect vm  gain1 7700000006  out Out:1
        Display Line res
    End
    Instance nuee Nuee
);

// les modules : le phaser Classic ou Resonant, ses etages, la graine des retards, la part du reseau, l'ecoute
function creer()
(
    tab(TCRE, sortie + 30, (proba(0.5) ? `Classic : `Resonant), floor(alea(6, 16)), floor(rand(99999)), alea(30, 55),
        borne(ecoute, -120, 40));
);

var TGR = data(Interstys  Reader nuee:7700000001  from 7700000002  to 7700000003  size 7700000004  sizernd 7700000005  plateau 7700000006  fadein 7700000007
    density 7700000008  onsetrnd 7700000009  direction 7700000010  speedrnd 7700000011  speed 7700000012  volrnd 7700000013  gvol 7700000014);
var TWIN = data(Interstys  Reader nuee:7700000001  from 7700000002  to 7700000003);
var TDEN = data(Interstys  Reader nuee:7700000001  density 7700000002);
var TPF = data(Interstys  Effect nuee:7700000001  mode 7700000002  amp 7700000003  steps 7700000004  rate 7700000005);
var TPH = data(Interstys  Effect nuee:ph  freq 7700000001  feedback 7700000002  rate 7700000003  sweep 7700000004  Effect nuee:rf  rate 7700000005
    Effect nuee:rb  rate 7700000006);
var TMT = data(Interstys  Effect nuee:mt  decay 7700000001  damp 7700000002);

var GN = array(`g1, `g2, `g3);                // les couches
var PN = array(`p1, `p2, `p3);                // leurs champs de hauteurs
var WA = malloc(3);                           // leurs fenetres (s)
var WB = malloc(3);
var GD = malloc(3);                           // leurs densites (/s)
// les champs de hauteurs : l'etendue (octaves de part et d'autre) et les paliers (0 : continu)
var CHA = array(0, 1, 0.5833, 1.5833, 2, 1, 0.08, 1.5, 0.8333, 0.6667);
var CHP = array(0, 3, 3, 3, 5, 5, 0, 0, 5, 5);
var CHHAR = array(1, 2, 3, 4, 8, 9);          // les champs "harmoniques"
var CHMIC = array(0, 6, 2);                   // unisson, micro-intervalles, quintes
var BASES = array(0.25, 0.5, 0.5, 0.75, 1, 1, 1, 1.5, 2);
var BASESL = array(0.25, 0.5, 0.5, 0.75, 1);
var NOMSEC = array("poussiere", "essaim", "nuage", "trainees", "tutti", "silence");
// les poids des sections, selon l'energie (faible, moyenne, forte)
var W1 = array(30, 8, 25, 27, 0, 10);
var W2 = array(15, 20, 22, 18, 16, 9);
var W3 = array(8, 30, 12, 10, 36, 4);
// les facteurs aleatoires des grains (taille, volume, vitesse : 1 ... 5) et l'irregularite des attaques (0 ... 1)
var Fsz = 1.5;
var Fvol = 1.5;
var Fsp = 1;
var Fon = 1;

// la couche i : taille (ms), densite (/s), plateau et attaque (%), sens (-1 a l'envers ... 1 a l'endroit), vitesse (la
// hauteur), largeur de sa fenetre (s) ; la fenetre au hasard dans le buffer ; le gain des grains selon leur nombre
function couche(i, sz, dn, pl, fi, dir, sp, w) local(d, a, ov, gv)
(
    d = dispo();
    w = borne(w, min(d, 0.05 + 3 * sz * sp / 1000), d);
    a = rand(max(0, d - w));
    ov = dn * sz / 1000;
    gv = borne(-10 * log10(max(1, ov)), -20, 6);
    WA[i] = a; WB[i] = a + w; GD[i] = dn;
    tab(TGR, GN[i], a, a + w, borne(sz, 10, 10000), borne(Fsz, 1, 5), floor(borne(pl, 0, 100)), floor(borne(fi, 0, 100)),
        borne(dn, 0.01, 100), borne(Fon, 0, 1), borne(dir, -1, 1), borne(Fsp, 1, 5), borne(sp, 0.05, 8), borne(Fvol, 1, 5), gv);
);

// le champ de hauteurs k de la couche i : son mode (Step : des paliers, Walk : une marche), sa vitesse (Hz)
function champ(i, k, md, rt) ( tab(TPF, PN[i], md, CHA[k], CHP[k], rt); );

// poussiere : des grains fins et rares, des accents, de longs echos
function sec0(tr)
(
    Fsz = alea(1, 2.5); Fvol = alea(1.5, 4); Fsp = alea(1, 1.3); Fon = 1;
    couche(0, aleal(6, 45), aleal(1.5, 14), alea(0, 25), alea(10, 60), alea(-1, 1), pioche(BASES), aleal(0.5, 30));
    champ(0, floor(rand(9.99)), `Step, aleal(4, 25));
    niv(0, alea(-4, 0), tr);
    niv(1, -80, tr);
    proba(0.3) ? (
        Fsz = 1.5; Fvol = 1.5; Fsp = 1.2; Fon = 1;
        couche(2, aleal(900, 4000), aleal(0.3, 1), 40, 50, alea(-1, 1), pioche(BASESL), aleal(5, 40));
        champ(2, 7, `Walk, aleal(0.5, 3));
        niv(2, alea(-20, -12), tr);
    ) : niv(2, -80, tr);
    tab(TMT, aleal(3, 14), aleal(5000, 12000));
);

// essaim : des grains fins et serres, une hauteur presque unique, battante
function sec1(tr)
(
    Fsz = alea(1.2, 2); Fvol = alea(1, 1.6); Fsp = aleal(1.003, 1.06); Fon = alea(0.2, 1);
    couche(0, aleal(12, 90), aleal(25, 95), alea(20, 50), alea(30, 60), (proba(0.7) ? 1 : alea(-1, 1)), pioche(BASES),
        aleal(0.3, 8));
    champ(0, pioche(CHMIC), `Step, aleal(10, 40));
    niv(0, alea(-6, -2), tr);
    proba(0.4) ? (
        Fsz = 1.5; Fvol = 1.5; Fsp = 1; Fon = 0.7;
        couche(1, aleal(150, 600), aleal(2, 6), 40, 50, 1, pioche(BASES), aleal(2, 15));
        champ(1, pioche(CHHAR), `Step, aleal(1, 5));
        niv(1, alea(-16, -10), tr);
    ) : niv(1, -80, tr);
    niv(2, -80, tr);
    tab(TMT, aleal(1, 4), aleal(4000, 9000));
);

// nuage : des grains moyens, un accord (octaves, quintes...), plus ou moins dense
function sec2(tr)
(
    Fsz = alea(1.3, 2.5); Fvol = alea(1, 2); Fsp = aleal(1, 1.02); Fon = alea(0.5, 1);
    couche(1, aleal(150, 1400), aleal(3, 18), alea(20, 60), alea(30, 70), alea(0, 1), pioche(BASES), aleal(2, 25));
    champ(1, pioche(CHHAR), `Step, aleal(2, 12));
    niv(1, alea(-5, -1), tr);
    proba(0.3) ? (
        Fsz = 2; Fvol = 3; Fsp = 1.1; Fon = 1;
        couche(0, aleal(8, 30), aleal(2, 8), 10, 40, alea(-1, 1), pioche(BASES), aleal(1, 20));
        champ(0, floor(rand(9.99)), `Step, 8);
        niv(0, alea(-18, -12), tr);
    ) : niv(0, -80, tr);
    proba(0.3) ? (
        Fsz = 1.5; Fvol = 1.3; Fsp = 1.1; Fon = 0.5;
        couche(2, aleal(1000, 5000), aleal(0.3, 1.2), 50, 40, alea(-1, 1), pioche(BASESL), aleal(5, 40));
        champ(2, pioche(CHHAR), `Step, aleal(0.2, 1));
        niv(2, alea(-14, -9), tr);
    ) : niv(2, -80, tr);
    tab(TMT, aleal(2, 7), aleal(4000, 10000));
);

// trainees : de longs grains rares, leur hauteur erre (une marche), a l'endroit et a l'envers
function sec3(tr)
(
    Fsz = alea(1.2, 2); Fvol = alea(1, 1.5); Fsp = alea(1, 1.5); Fon = alea(0.3, 1);
    couche(2, aleal(900, 7000), aleal(0.3, 2.5), alea(30, 70), alea(25, 60), alea(-1, 1), pioche(BASESL), aleal(5, 60));
    champ(2, 7, `Walk, aleal(0.5, 4));
    niv(2, alea(-5, -1), tr);
    proba(0.4) ? (
        Fsz = 2; Fvol = 3; Fsp = 1.2; Fon = 1;
        couche(0, aleal(6, 25), aleal(1, 6), 0, 30, alea(-1, 1), pioche(BASES), aleal(1, 30));
        champ(0, floor(rand(9.99)), `Step, 6);
        niv(0, alea(-22, -14), tr);
    ) : niv(0, -80, tr);
    niv(1, -80, tr);
    tab(TMT, aleal(4, 12), aleal(3000, 8000));
);

// tutti : les trois couches
function sec4(tr)
(
    Fsz = 1.8; Fvol = 2; Fsp = 1.05; Fon = 0.8;
    couche(0, aleal(10, 60), aleal(15, 60), 30, 50, alea(-1, 1), pioche(BASES), aleal(0.5, 10));
    couche(1, aleal(150, 900), aleal(3, 12), 40, 50, alea(0, 1), pioche(BASES), aleal(2, 20));
    couche(2, aleal(800, 5000), aleal(0.4, 2), 50, 40, alea(-1, 1), pioche(BASESL), aleal(5, 40));
    champ(0, floor(rand(9.99)), `Step, aleal(5, 30));
    champ(1, pioche(CHHAR), `Step, aleal(2, 8));
    champ(2, floor(rand(9.99)), `Walk, aleal(0.5, 3));
    niv(0, alea(-9, -5), tr);
    niv(1, alea(-9, -5), tr);
    niv(2, alea(-9, -5), tr);
    tab(TMT, aleal(2, 6), aleal(5000, 11000));
);

// la fenetre de la couche i derive (de 2 a 20 % du buffer)
function derive(i) local(d, w, a)
(
    d = dispo(); w = min(WB[i] - WA[i], d);
    a = borne(WA[i] + signe(0.5) * aleal(0.02, 0.2) * d, 0, max(0, d - w));
    WA[i] = a; WB[i] = a + w;
    tab(TWIN, GN[i], a, a + w);
);

// la densite de la couche i accelere ou ralentit
function densite(i, f) ( GD[i] = borne(GD[i] * f, 0.05, 100); tab(TDEN, GN[i], GD[i]); );

// un accent sur la couche i
function accent(i) local(v)
(
    v = NVd[i];
    niv(i, min(0, v + alea(4, 9)), alea(0.05, 0.4));
    attend(alea(0.3, 1.5));
    niv(i, v, alea(1, 4));
);

// une section dure D secondes : toutes les 1.5 a 6 s, une couche qui sonne derive, accelere, ralentit ou s'accentue
function vivre(D) local(tf, u, i)
(
    tf = ptime() + D;
    while ((arret === 0) && (ptime() < tf - 0.3) && (tps() < sortie - FIN)) (
        attend(min(alea(1.5, 6), max(0.1, tf - ptime())));
        finrec();
        ((arret === 0) && (ptime() < tf - 1) && (tps() < sortie - FIN)) ? (
            i = floor(rand(2.999));
            (NVd[i] > -60) ? (
                u = rand(1);
                (u < 0.45) ? derive(i) : ((u < 0.75) ? densite(i, aleal(0.5, 2)) : ((u < 0.88) ? accent(i) : 0));
            );
        );
    );
);

function section() local(ty, D, tr)
(
    energie();
    ty = tirage((E < 0.35) ? W1 : ((E < 0.7) ? W2 : W3));
    NS += 1;
    tr = transit();
    D = (ty === 5) ? alea(1, 5) : ((ty === 4) ? aleal(6, 25) : aleal(10, 55));
    print(sprintf(0, "%s %d:%02d  section %d : %s, %d s (energie %.2f)", TITRE, floor(tps() / 60), floor(tps()) % 60, NS,
        NOMSEC[ty], floor(D + 0.5), E));
    (ty === 5) ? (
        niv(KM, -80, alea(0.03, 1.5));
        attend(D);
        niv(KM, MAST, alea(0.05, 3));
    ) : (
        (ty === 0) ? sec0(tr) : ((ty === 1) ? sec1(tr) : ((ty === 2) ? sec2(tr) : ((ty === 3) ? sec3(tr) : sec4(tr))));
        tab(TPH, aleal(250, 3000), alea(-0.6, 0.85), aleal(0.01, 0.4), alea(1, 5), aleal(0.03, 0.6), aleal(0.02, 0.2));
        vivre(D);
    );
);

// la fin : les couches s'arretent
function arreter() ( tab(TRST, `g1, `Paused); tab(TRST, `g2, `Paused); tab(TRST, `g3, `Paused); );

// ======================================================================================================================
// Demarrage, generation, fin (les memes dans les cinq presets)
// ======================================================================================================================
// un depot precedent de ce preset : son chef d'orchestre s'arrete (ses modules sont refaits ci-dessous)
(thread(`count, NOM) > 0) ? (
    loop(thread(`count, NOM), event(`notify, 0, 0, 0, 0, NOM, `stop, 0, 10, 0, 0, 0, 1, 0));
    wait(1.5);
);
thread(`name, NOM);
// les instances precedentes (la ligne d'abord : lue d'un fichier, elle n'appartient plus a son instance)
table(data( Free Instance nuee ));
table(data( Free Line nueein:src  Free Instance nueein ));
var r = tab(TIN, (avecfic ? 1 : borne(duree, 2, 1300)), (avecfic ? 1 : borne(canaux, 1, 2)));
((r === 0) && avecfic) ? (r = tab(TFIC, fichier));
(r === 0) ? (r = creer());
(r !== 0) ? (
    print(sprintf(0, "%s : les modules n'ont pas pu etre crees (erreur %04d), rien n'est genere.", TITRE, r));
    arret = 2;
);
(arret === 0) ? (
    Trec = ptime();
    avecfic ? (
        print(sprintf(0, "%s : le buffer d'entree vient du fichier %s (%d s utilisees)", TITRE, fichier, duree));
    ) : (
        tab(TREC, `Writing);
        print(sprintf(0, "%s : enregistrement du buffer d'entree depuis In:0 (%d s, %d canal(aux))", TITRE, duree, canaux));
        attend(min(duree, 6));
    );
);
(arret === 0) ? (
    T0 = ptime();
    tab(TWS, `wo, `Writing);
    niv(KM, MAST, 3);
    print(sprintf(0, "%s : generation de %d s dans le buffer de sortie (nuee:res)", TITRE, sortie));
);
while ((arret === 0) && (tps() < sortie - FIN)) ( section(); );
(arret !== 2) ? (
    niv(KM, -80, (arret === 1) ? 3 : FIN);
    attfin((arret === 1) ? 3.5 : (FIN + 0.5));
);
(arret !== 2) ? (
    tab(TWS, `wo, `Paused);
    arreter();
    (!avecfic && !recfin) ? tab(TREC, `Paused);
    print(sprintf(0, "%s : fin, %d s dans le buffer de sortie (nuee:res)", TITRE, ((T0 > 0) ? floor(tps()) : 0)));
);
