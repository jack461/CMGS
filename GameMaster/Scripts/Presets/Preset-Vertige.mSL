print("Preset-Vertige. Des spirales de decalages de frequence dans des boucles de retard ; 10 minutes, mono, dans le buffer de sortie.");

/*
  PRESET "VERTIGE" : les spirales
  Des fragments du buffer d'entree, surtout a l'envers (Brage), et des grains sont injectes par bouffees dans deux
  boucles de retard (un retard court et un long, tires au hasard) ; a chaque tour, un decaleur de frequence (Ring, mode
  Up ou Down) deplace tout le spectre de quelques Hz : le son monte ou descend sans fin, en spirale, se dedouble, devient
  inharmonique, se perd dans les aigus ou dans les graves (des filtres dans la boucle l'y eteignent). Le decalage erre
  (une marche aleatoire) et change de regime d'une section a l'autre : des battements lents (moins de 1 Hz), des
  spirales (2 a 14 Hz), des cascades metalliques (20 a 160 Hz). Un phaser a balayage sans fin (barber pole) tourne
  par-dessus, une petite piece (Matrix) rapproche le tout.
  La forme : des sections de 10 s a 45 s ; toutes les 1 a 4 s, une bouffee d'entree, une chute (les entrees se taisent,
  les boucles tournent longtemps), une coupure (les boucles se vident), ou un nouveau decalage.

  Utilisation (la meme pour les cinq presets : Nuee, Glacier, Sillons, Resonances, Vertige)
    - Regler les variables de "Reglages" ci-dessous, puis deposer ce fichier dans la fenetre d'Interstys. Une session
      vierge suffit : le preset cree ses buffers et ses modules, dans deux instances (vertin : le buffer d'entree ;
      vertige : le traitement et le buffer de sortie), sans toucher aux autres modules.
    - Sans fichier (fichier = "") : le son de la piste est enregistre dans le buffer d'entree (In:0, et In:1 si canaux
      vaut 2) pendant "duree" secondes. Lancer d'abord la lecture de la piste (une nappe, un son de plusieurs minutes),
      puis deposer le preset : la generation commence apres 6 secondes d'enregistrement, et ne puise que dans la part
      deja enregistree. Avec un fichier : il est lu dans le buffer d'entree (mono ou stereo ; un nom relatif au dossier
      du projet, GMAuxiliary.eel en marche, ou un chemin complet), et "duree" doit valoir sa duree (ou moins : au-dela,
      les positions reviennent au debut du fichier).
    - La generation dure "sortie" secondes, en temps reel : REAPER doit faire tourner la piste (lecture en cours, ou
      piste armee avec le monitoring). Le resultat, mono, s'ecrit dans le buffer de sortie (la ligne "res" de l'instance
      vertige, "vertige:res" dans une table) et s'entend sur Out:0 et Out:1 (niveau "ecoute"). Le journal suit les sections.
    - Le hasard decide de tout (les positions dans le buffer, les durees, les textures, les hauteurs, les enchainements) :
      chaque execution est differente. Redeposer le fichier relance une generation (la precedente s'arrete, ses buffers
      sont refaits). Presets-Stop.mSL arrete les generations en cours (un fondu ; les buffers restent) ;
      Presets-Free.mSL retire tout.
    - La premiere fois, le journal note deux erreurs (2787, 2757) : les instances a retirer n'existent pas encore.
*/

// ======================================================================================================================
// Reglages
// ======================================================================================================================
var fichier = "";     // un fichier son pour le buffer d'entree ; "" : le son de la piste (In:0) est enregistre
var duree = 360;      // la duree du buffer d'entree (s, au plus 1300) : celle de l'enregistrement, ou celle du fichier
var canaux = 2;       // les canaux enregistres : 1 (In:0) ou 2 (In:0 et In:1) ; un fichier donne les siens
var continu = 0;      // 1 : l'enregistrement continue (le buffer garde les "duree" dernieres secondes) ; 0 : il s'arrete
var sortie = 600;     // la duree produite dans le buffer de sortie (s)
var ecoute = 6;      // le niveau d'ecoute du resultat sur Out:0 et Out:1 (dB ; -120 : muet)

// ======================================================================================================================
// Outils (les memes dans les cinq presets)
// ======================================================================================================================
var NOM = `vertige;                    // le nom du processus : un nouveau depot de ce preset arrete celui-ci
var TITRE = "Preset-Vertige";
var PH = 7700000000;                 // dans une table modele, le mot PH + k est remplace par la k-ieme valeur (tab)
var arret = 0;                       // 1 : arret demande (Presets-Stop.mSL : un fondu), 2 : arret immediat
var T0 = 0;                          // le debut de la generation (ptime)
var Trec = 0;                        // le debut de l'enregistrement du buffer d'entree
var recfin = 0;                      // 1 : l'enregistrement est termine
var avecfic = (strlen(fichier) > 0); // 1 : le buffer d'entree vient d'un fichier
var FIN = 8;                         // le fondu final (s)
var E = 0.4;                         // l'energie (0 ... 1) : elle erre, et choisit les sections
var NS = 0;                          // les sections

// le hasard : le generateur de rand() avance d'un nombre de pas tire de l'horloge, chaque execution est differente
var k0 = floor(1000000 * (ptime() - floor(ptime())));
loop(1 + (k0 % 7919), rand(1));

function alea(a, b) ( a + rand(b - a); );                       // un reel dans [a, b]
function aleal(a, b) ( a * pow(b / a, rand(1)); );              // dans [a, b] (a, b > 0), en echelle logarithmique
function proba(p) ( rand(1) < p; );                             // vrai avec la probabilite p
function signe(p) ( (rand(1) < p) ? -1 : 1; );                  // -1 avec la probabilite p, sinon 1
function borne(x, a, b) ( max(a, min(b, x)); );
function pioche(t) ( t[min(t[-1] - 1, floor(rand(t[-1])))]; );  // un element d'un tableau, au hasard
function tps() ( ptime() - T0; );                               // le temps de la generation (s)

// un indice tire selon les poids du tableau w
function tirage(w) local(s, i, u, k)
(
    s = 0; i = 0; while (i < w[-1]) ( s += w[i]; i += 1; );
    u = rand(s); k = 0; s = w[0];
    while ((k < w[-1] - 1) && (u >= s)) ( k += 1; s += w[k]; );
    k;
);

// la table modele m (un data), ses mots PH + 1, PH + 2... remplaces par les valeurs v1, v2... : tab(m, v1, v2...) ;
// m n'est pas modifiee ; une instance qui n'existe plus (retiree a la main) arrete la generation
function tab(n; v) local(m, c, i, w, r)
(
    r = -1;
    (arret !== 2) ? (
        m = v[0]; c = malloc(m[-1]);
        i = 0; while (i < m[-1]) (
            w = m[i];
            ((w > PH) && (w < PH + n)) ? (w = v[w - PH]);
            c[i] = w; i += 1;
        );
        r = table(c);
        mfree(c);
        (r !== 0) ? (
            print(sprintf(0, "%s : erreur %04d dans une table", TITRE, r));
            ((r === 2757) || (r === 2787)) ? (arret = 2);
        );
    );
    r;
);

// attendre d secondes ; un message "stop" (Presets-Stop.mSL, ou un nouveau depot du preset) arrete la generation
function attend(d) local(t1, m)
(
    t1 = ptime() + d;
    while ((arret === 0) && (ptime() < t1 - 0.005)) (
        (t1 - ptime() >= 1) ? (
            m = event(`wait, t1 - ptime());
            (m > 0) ? (
                (m[2] === `stop) ? (arret = (m[14] === 1) ? 2 : 1);
                event(`recycle, m);
            );
        ) : (
            wait(t1 - ptime());
        );
    );
);

// la fin : attendre d secondes ; seul un nouveau depot du preset (un arret immediat) interrompt
function attfin(d) local(t1, m)
(
    t1 = ptime() + d;
    while ((arret !== 2) && (ptime() < t1 - 0.005)) (
        (t1 - ptime() >= 1) ? (
            m = event(`wait, t1 - ptime());
            (m > 0) ? (
                ((m[2] === `stop) && (m[14] === 1)) ? (arret = 2);
                event(`recycle, m);
            );
        ) : (
            wait(t1 - ptime());
        );
    );
);

// la duree utilisable du buffer d'entree (s) : la part deja enregistree, ou la duree du fichier
function dispo() local(e)
(
    avecfic ? duree : (
        e = ptime() - Trec;
        (e >= duree) ? duree : max(2, e - 0.5);
    );
);

// l'energie erre autour d'un arc (faible au debut et a la fin, forte au milieu)
function energie() local(x, arc)
(
    x = borne(tps() / sortie, 0, 1);
    arc = 0.2 + 0.6 * sin($pi * x);
    E = borne(0.5 * E + 0.5 * (arc + alea(-0.35, 0.35)), 0, 1);
);

// la duree d'une transition : une coupure (20 %), un fondu court (50 %) ou long (30 %)
function transit() local(u)
(
    u = rand(1);
    (u < 0.2) ? alea(0.03, 0.15) : ((u < 0.7) ? alea(0.8, 4) : alea(5, 14));
);

// ======================================================================================================================
// Vertige : les modules
// ======================================================================================================================
/*
  L'instance vertige : les lecteurs rv (Brage, surtout a l'envers) et gr (Grains) sur le buffer d'entree (vertin:src),
  leurs niveaux (l1 s1, l2 s2), leur somme fo ; deux boucles A et B : la ligne (ya, yb : 4 s), son writer (xa, xb) qui
  ecrit l'entree (ia, ib : fo et le retour), le lecteur en retard (ra, rb), le decaleur (fa, fb : Ring Up ou Down ; wa,
  wb : la marche aleatoire de son decalage), un passe-haut et un passe-bas (ha, ka ; hb, kb), le retour (ga za, gb zb :
  son gain, lineaire ; fa2, fb2) ; les sorties des boucles (l3 s3 e3 v3, l4 s4 e4 v4) et les fragments directs (l5 s5
  e5 v5), leur somme ou, le phaser bp (barber pole), la piece sp ; le niveau general (lm sm em vm) ; res, wo ; m0, m1.
*/
var KM = 5;                                   // le niveau general (0, 1 : les entrees, 2, 3 : les boucles, 4 : direct)
var MAST = -4;
var NVl = array(`l1, `l2, `l3, `l4, `l5, `lm);
var NVs = array(`s1, `s2, `s3, `s4, `s5, `sm);
var NVc = malloc(6);
var NVd = malloc(6);

// les niveaux : une cible (un LFO constant "l...") et une pente (un Math Slew "s..." : de -80 a 0 dB, par pas de
// 0.8 dB) ; ils modulent le volume d'un reader, le gain d'un writer, ou (Math Exp "e...", Math Mul "v...") un son ;
// niv(k, dB, s) : le niveau k va vers dB en s secondes (au plus 10 s par 0.8 dB) ; ils partent de -80 dB
var TNIV = data(Interstys  Effect vertige:7700000003  offset 7700000001  Effect vertige:7700000004  attack 7700000002  release 7700000002);
function niv(k, db, s) local(t, d, a)
(
    t = borne(1 + db / 80, 0, 1);
    d = 100 * abs(t - NVc[k]);
    a = borne(1000 * s / max(0.01, d), 1, 10000);
    NVc[k] = t; NVd[k] = db;
    tab(TNIV, t, a, NVl[k], NVs[k]);
);
var k1 = 0;
loop(KM + 1, NVd[k1] = -80; k1 += 1;);

// le buffer d'entree (l'instance vertin : la ligne src et le writer rec, qui l'enregistre depuis In:0)
var TIN = data(
    Interstys
    Algorithm VertIn
        Line src  length 7700000001  chan 7700000002
        Writer rec  line src  source In:0  status Paused
        Display Line src
    End
    Instance vertin VertIn
);
var TFIC = data(Interstys  Line vertin:src  file 7700000001);
var TREC = data(Interstys  Writer vertin:rec  status 7700000001);
var TWS = data(Interstys  Writer vertige:7700000001  status 7700000002);
var TRST = data(Interstys  Reader vertige:7700000001  status 7700000002);

// l'enregistrement s'arrete quand le buffer d'entree est plein (sauf "continu")
function finrec()
(
    (!avecfic && !continu && !recfin && (ptime() - Trec >= duree)) ? (
        tab(TREC, `Paused); recfin = 1;
        print(sprintf(0, "%s : le buffer d'entree est complet (%d s)", TITRE, duree));
    );
);

var TCRE = data(
    Interstys
    Algorithm Vertige
        Line res  length 7700000001  chan 1
        Line ya  length 4  chan 1
        Line yb  length 4  chan 1
        Effect l1  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s1  type Math  chan 1  source Effect l1  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l2  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s2  type Math  chan 1  source Effect l2  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l3  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s3  type Math  chan 1  source Effect l3  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l4  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s4  type Math  chan 1  source Effect l4  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l5  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s5  type Math  chan 1  source Effect l5  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect lm  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect sm  type Math  chan 1  source Effect lm  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Reader rv  line vertin:src  mode Brage  outchan 2  loop loop  out Own  block 900  overlap 30  search 0  transp 0
                   speed -1  mod Volume Effect s1  depth 80  law dB  status Reading
        Reader gr  line vertin:src  mode Grains  outchan 1  loop loop  out Own  size 120  density 8  plateau 30  fadein 50
                   mod Volume Effect s2  depth 80  law dB  status Reading
        Effect fo  type Mixer  chan 1  src1 Reader rv:0  gain1 -3  src2 Reader rv:1  gain2 -3  src3 Reader gr  gain3 0
        Effect ga  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect za  type Math  chan 1  source Effect ga  mode Slew  attack 1000  release 1000
        Effect wa  type Random  chan 1  mode Walk  dist Uniform  rate 0.4  walk 0.15  glide 0.5  amp 0.5  offset 0
        Effect ia  type Mixer  chan 1  src1 Effect fo  gain1 0  src2 Effect fa2  gain2 0
        Writer xa  line ya  source Effect ia  status Writing
        Reader ra  writer xa  delay 7700000002  out Own  status Reading
        Effect fa  type Ring  chan 1  source Reader ra  mode 7700000004  freq 3  wave Sine  mix 100
                   mod Freq Effect wa  depth 1
        Effect ha  type Filter  chan 1  source Effect fa  mode HP  stages 1  freq 70  q 0.707
        Effect ka  type Filter  chan 1  source Effect ha  mode LP  stages 1  freq 6500  q 0.707
        Effect fa2  type Math  chan 1  source Effect ka  src2 Effect za  mode Mul
        Effect gb  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect zb  type Math  chan 1  source Effect gb  mode Slew  attack 1000  release 1000
        Effect wb  type Random  chan 1  mode Walk  dist Uniform  rate 0.25  walk 0.15  glide 0.5  amp 0.5  offset 0
        Effect ib  type Mixer  chan 1  src1 Effect fo  gain1 0  src2 Effect fb2  gain2 0
        Writer xb  line yb  source Effect ib  status Writing
        Reader rb  writer xb  delay 7700000003  out Own  status Reading
        Effect fb  type Ring  chan 1  source Reader rb  mode 7700000005  freq 3  wave Sine  mix 100
                   mod Freq Effect wb  depth 1
        Effect hb  type Filter  chan 1  source Effect fb  mode HP  stages 1  freq 70  q 0.707
        Effect kb  type Filter  chan 1  source Effect hb  mode LP  stages 1  freq 6500  q 0.707
        Effect fb2  type Math  chan 1  source Effect kb  src2 Effect zb  mode Mul
        Effect e3  type Math  chan 1  source Effect s3  gain 38.0618  mode Exp
        Effect v3  type Math  chan 1  source Effect ka  src2 Effect e3  mode Mul
        Effect e4  type Math  chan 1  source Effect s4  gain 38.0618  mode Exp
        Effect v4  type Math  chan 1  source Effect kb  src2 Effect e4  mode Mul
        Effect e5  type Math  chan 1  source Effect s5  gain 38.0618  mode Exp
        Effect v5  type Math  chan 1  source Effect fo  src2 Effect e5  mode Mul
        Effect ou  type Mixer  chan 1  src1 Effect v3  gain1 0  src2 Effect v4  gain2 0  src3 Effect v5  gain3 0
        Effect bp  type Phaser  chan 1  source Effect ou  mode 7700000006  stages 10  freq 900  sweep 4  rate 0.05  feedback 0.55
                   glide 3  mix 55
        Effect sp  type Matrix  chan 1  source Effect bp  mode Householder  lines 10  delays Random  seed 7700000007  dmin 13
                   dmax 90  decay 1.8  damp 7000  mix 25
        Effect em  type Math  chan 1  source Effect sm  gain 38.0618  mode Exp
        Effect vm  type Math  chan 1  source Effect sp  src2 Effect em  mode Mul  limiter On
        Writer wo  line res  source Effect vm  status Paused
        Effect m0  type Mixer  chan 1  src1 Effect vm  gain1 7700000008  out Out:0
        Effect m1  type Mixer  chan 1  src1 Effect vm  gain1 7700000008  out Out:1
        Display Line res
    End
    Instance vertige Vertige
);

// les modules : les retards des boucles (un court, un long), le sens de leurs decaleurs (souvent opposes), le sens du
// phaser, la graine de la piece, l'ecoute
function creer() local(m)
(
    m = proba(0.5) ? `Up : `Down;
    tab(TCRE, sortie + 30, aleal(0.07, 0.6), aleal(0.6, 3.2), m, (proba(0.6) ? ((m === `Up) ? `Down : `Up) : m),
        (proba(0.5) ? `BarberUp : `BarberDown), floor(rand(99999)), borne(ecoute, -120, 40));
);

var TFB = data(Interstys  Effect vertige:7700000001  offset 7700000002  Effect vertige:7700000003  attack 7700000004  release 7700000004);
var TRG = data(Interstys  Effect vertige:7700000001  freq 7700000002  Effect vertige:7700000003  amp 7700000004  rate 7700000005);
var TRV = data(Interstys  Reader vertige:rv  from 7700000001  to 7700000002  block 7700000003  speed 7700000004  overlap 7700000005  transp 7700000006);
var TGV = data(Interstys  Reader vertige:gr  from 7700000001  to 7700000002  size 7700000003  density 7700000004  speed 7700000005  direction 7700000006  speedrnd 7700000007);
var TBP = data(Interstys  Effect vertige:bp  rate 7700000001  feedback 7700000002  Effect vertige:sp  decay 7700000003);

var GA = array(`ga, `gb);                     // le retour des boucles : sa cible
var ZA = array(`za, `zb);                     // et sa pente
var FA = array(`fa, `fb);                     // les decaleurs
var WK = array(`wa, `wb);                     // leurs marches
var SPV = array(-1, -1, -0.5, -2, 1, 0.5);    // les vitesses des fragments (surtout a l'envers)
var SPG = array(0.5, 1, 1, 2);                // celles des grains
var FBv = malloc(2);                          // le retour de chaque boucle (gain lineaire)

// le retour de la boucle k va vers g (0 ... 0.97) en s secondes
function retour(k, g, s) local(a)
(
    g = borne(g, 0, 0.97);
    a = borne(1000 * s / max(0.001, abs(g - FBv[k])), 1, 10000);
    FBv[k] = g;
    tab(TFB, GA[k], g, ZA[k], a);
);

// un regime de decalage (Hz) : des battements, des spirales, des cascades
function regime() local(u)
(
    u = rand(1);
    (u < 0.3 - 0.15 * E) ? aleal(0.05, 1.2) : ((u < 0.75) ? aleal(1.5, 14) : aleal(18, 160));
);

// le decalage de la boucle k : sa frequence, l'etendue (octaves) et la vitesse de son errance
function decal(k) ( tab(TRG, FA[k], regime(), WK[k], alea(0.1, 1), aleal(0.05, 0.8)); );

// les entrees : des fragments (une region au hasard, des segments de 250 ms a 2.5 s) et des grains
function entree() local(d, w, a)
(
    d = dispo();
    w = borne(aleal(1, 30), min(d, 0.5), d); a = rand(max(0, d - w));
    tab(TRV, a, a + w, aleal(250, 2500), pioche(SPV), floor(alea(20, 45)), (proba(0.3) ? alea(-5, 5) : 0));
    w = borne(aleal(0.5, 20), min(d, 0.3), d); a = rand(max(0, d - w));
    tab(TGV, a, a + w, aleal(40, 400), aleal(2, 25), pioche(SPG), alea(-1, 1), alea(1, 1.3));
);

// une bouffee : une entree s'ouvre, puis se referme
function bouffee() local(k)
(
    k = floor(rand(1.999));
    niv(k, alea(-6, 0), alea(0.02, 0.5));
    attend(aleal(0.3, 4));
    niv(k, -80, alea(0.05, 2));
);

// une chute : les entrees se taisent, les boucles tournent longtemps
function chute()
(
    print(sprintf(0, "%s %d:%02d  chute", TITRE, floor(tps() / 60), floor(tps()) % 60));
    niv(0, -80, 0.3); niv(1, -80, 0.3);
    retour(0, alea(0.9, 0.95), alea(0.5, 2)); retour(1, alea(0.9, 0.95), alea(0.5, 2));
);

// une coupure : les boucles se vident, puis repartent sur une bouffee
function coupure() local(a, b)
(
    print(sprintf(0, "%s %d:%02d  coupure", TITRE, floor(tps() / 60), floor(tps()) % 60));
    a = FBv[0]; b = FBv[1];
    retour(0, 0, alea(0.02, 0.4)); retour(1, 0, alea(0.02, 0.4));
    attend(alea(0.5, 3));
    retour(0, a, alea(0.5, 3)); retour(1, b, alea(0.5, 3));
    bouffee();
);

// une section dure D secondes : toutes les 1 a 4 s, une bouffee, une chute, une coupure ou un nouveau decalage
function vivre(D) local(tf, u)
(
    tf = ptime() + D;
    while ((arret === 0) && (ptime() < tf - 0.3) && (tps() < sortie - FIN)) (
        attend(min(alea(1, 4), max(0.1, tf - ptime())));
        finrec();
        ((arret === 0) && (ptime() < tf - 1) && (tps() < sortie - FIN)) ? (
            u = rand(1);
            (u < 0.35) ? bouffee() : ((u < 0.45) ? chute() : ((u < 0.52) ? coupure() :
            ((u < 0.67) ? decal(floor(rand(1.999))) : 0)));
        );
    );
);

function section() local(D, tr, k)
(
    energie();
    NS += 1;
    D = aleal(10, 45);
    tr = transit();
    print(sprintf(0, "%s %d:%02d  section %d : %d s (energie %.2f)", TITRE, floor(tps() / 60), floor(tps()) % 60, NS,
        floor(D + 0.5), E));
    entree();
    k = 0;
    loop(2,
        decal(k);
        retour(k, alea(0.55, 0.93), alea(0.5, 4));
        niv(2 + k, (proba(0.85) ? alea(-8, -2) : -80), tr);
        k += 1;
    );
    niv(4, (proba(0.3) ? alea(-16, -8) : -80), tr);
    tab(TBP, aleal(0.01, 0.25), alea(0.3, 0.8), aleal(1, 4));
    bouffee();
    vivre(D);
);

// la fin : les lecteurs et les writers s'arretent
function arreter()
(
    tab(TRST, `rv, `Paused); tab(TRST, `gr, `Paused); tab(TRST, `ra, `Paused); tab(TRST, `rb, `Paused);
    tab(TWS, `xa, `Paused); tab(TWS, `xb, `Paused);
);

// ======================================================================================================================
// Demarrage, generation, fin (les memes dans les cinq presets)
// ======================================================================================================================
// un depot precedent de ce preset : son chef d'orchestre s'arrete (ses modules sont refaits ci-dessous)
(thread(`count, NOM) > 0) ? (
    loop(thread(`count, NOM), event(`notify, 0, 0, 0, 0, NOM, `stop, 0, 10, 0, 0, 0, 1, 0));
    wait(1.5);
);
thread(`name, NOM);
// les instances precedentes (la ligne d'abord : lue d'un fichier, elle n'appartient plus a son instance)
table(data( Free Instance vertige ));
table(data( Free Line vertin:src  Free Instance vertin ));
var r = tab(TIN, (avecfic ? 1 : borne(duree, 2, 1300)), (avecfic ? 1 : borne(canaux, 1, 2)));
((r === 0) && avecfic) ? (r = tab(TFIC, fichier));
(r === 0) ? (r = creer());
(r !== 0) ? (
    print(sprintf(0, "%s : les modules n'ont pas pu etre crees (erreur %04d), rien n'est genere.", TITRE, r));
    arret = 2;
);
(arret === 0) ? (
    Trec = ptime();
    avecfic ? (
        print(sprintf(0, "%s : le buffer d'entree vient du fichier %s (%d s utilisees)", TITRE, fichier, duree));
    ) : (
