);
while ((arret === 0) && (tps() < sortie - FIN)) ( section(); );
(arret !== 2) ? (
    niv(KM, -80, (arret === 1) ? 3 : FIN);
    attfin((arret === 1) ? 3.5 : (FIN + 0.5));
);
(arret !== 2) ? (
    tab(TWS, `wo, `Paused);
    arreter();
    (!avecfic && !recfin) ? tab(TREC, `Paused);
    print(sprintf(0, "%s : fin, %d s dans le buffer de sortie (vertige:res)", TITRE, ((T0 > 0) ? floor(tps()) : 0)));
);
