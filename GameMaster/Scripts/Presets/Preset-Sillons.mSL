print("Preset-Sillons. Des boucles de bande qui se reenregistrent, a vitesse variable ; 10 minutes, mono, dans le buffer de sortie.");

/*
  PRESET "SILLONS" : les boucles, le reenregistrement, le phonogene
  Deux lecteurs Brage prelevent des fragments au hasard dans le buffer d'entree (a l'endroit, a l'envers, transposes) ;
  ils s'enregistrent dans trois boucles courtes (de 0.7 a 9 s, des longueurs tirees au hasard, sans commune mesure), en
  s'ajoutant a ce qu'elles contiennent deja (overdub) : chaque boucle accumule ses passages, s'epaissit, s'efface.
  Chaque boucle est relue a sa vitesse (de -2 a 2 : a l'envers, transposee) qui glisse parfois (glissandos, arrets de
  bande), et se reinjecte un peu dans la suivante. Les ouvertures et les fermetures des enregistrements sont parfois des
  coupures franches (des "punch-in") ; une boucle peut se figer (un sillon ferme : elle repete sans fin ce qu'elle a)
  ou s'effacer d'un passage. Un chorus aleatoire imite le pleurage de la bande, un filtre change de couleur par
  paliers, une petite piece (Matrix) rapproche le tout.
  La forme : des sections de 8 s a 40 s, des evenements toutes les 1.5 a 5 s (arrets de bande, effacements,
  fluctuations de vitesse, nouveaux fragments).

  Utilisation (la meme pour les cinq presets : Nuee, Glacier, Sillons, Resonances, Vertige)
    - Regler les variables de "Reglages" ci-dessous, puis deposer ce fichier dans la fenetre d'Interstys. Une session
      vierge suffit : le preset cree ses buffers et ses modules, dans deux instances (sillin : le buffer d'entree ;
      sillons : le traitement et le buffer de sortie), sans toucher aux autres modules.
    - Sans fichier (fichier = "") : le son de la piste est enregistre dans le buffer d'entree (In:0, et In:1 si canaux
      vaut 2) pendant "duree" secondes. Lancer d'abord la lecture de la piste (une nappe, un son de plusieurs minutes),
      puis deposer le preset : la generation commence apres 6 secondes d'enregistrement, et ne puise que dans la part
      deja enregistree. Avec un fichier : il est lu dans le buffer d'entree (mono ou stereo ; un nom relatif au dossier
      du projet, GMAuxiliary.eel en marche, ou un chemin complet), et "duree" doit valoir sa duree (ou moins : au-dela,
      les positions reviennent au debut du fichier).
    - La generation dure "sortie" secondes, en temps reel : REAPER doit faire tourner la piste (lecture en cours, ou
      piste armee avec le monitoring). Le resultat, mono, s'ecrit dans le buffer de sortie (la ligne "res" de l'instance
      sillons, "sillons:res" dans une table) et s'entend sur Out:0 et Out:1 (niveau "ecoute"). Le journal suit les sections.
    - Le hasard decide de tout (les positions dans le buffer, les durees, les textures, les hauteurs, les enchainements) :
      chaque execution est differente. Redeposer le fichier relance une generation (la precedente s'arrete, ses buffers
      sont refaits). Presets-Stop.mSL arrete les generations en cours (un fondu ; les buffers restent) ;
      Presets-Free.mSL retire tout.
    - La premiere fois, le journal note deux erreurs (2787, 2757) : les instances a retirer n'existent pas encore.
*/

// ======================================================================================================================
// Reglages
// ======================================================================================================================
var fichier = "";     // un fichier son pour le buffer d'entree ; "" : le son de la piste (In:0) est enregistre
var duree = 300;      // la duree du buffer d'entree (s, au plus 1300) : celle de l'enregistrement, ou celle du fichier
var canaux = 2;       // les canaux enregistres : 1 (In:0) ou 2 (In:0 et In:1) ; un fichier donne les siens
var continu = 0;      // 1 : l'enregistrement continue (le buffer garde les "duree" dernieres secondes) ; 0 : il s'arrete
var sortie = 600;     // la duree produite dans le buffer de sortie (s)
var ecoute = 6;      // le niveau d'ecoute du resultat sur Out:0 et Out:1 (dB ; -120 : muet)

// ======================================================================================================================
// Outils (les memes dans les cinq presets)
// ======================================================================================================================
var NOM = `sillons;                    // le nom du processus : un nouveau depot de ce preset arrete celui-ci
var TITRE = "Preset-Sillons";
var PH = 7700000000;                 // dans une table modele, le mot PH + k est remplace par la k-ieme valeur (tab)
var arret = 0;                       // 1 : arret demande (Presets-Stop.mSL : un fondu), 2 : arret immediat
var T0 = 0;                          // le debut de la generation (ptime)
var Trec = 0;                        // le debut de l'enregistrement du buffer d'entree
var recfin = 0;                      // 1 : l'enregistrement est termine
var avecfic = (strlen(fichier) > 0); // 1 : le buffer d'entree vient d'un fichier
var FIN = 8;                         // le fondu final (s)
var E = 0.4;                         // l'energie (0 ... 1) : elle erre, et choisit les sections
var NS = 0;                          // les sections

// le hasard : le generateur de rand() avance d'un nombre de pas tire de l'horloge, chaque execution est differente
var k0 = floor(1000000 * (ptime() - floor(ptime())));
loop(1 + (k0 % 7919), rand(1));

function alea(a, b) ( a + rand(b - a); );                       // un reel dans [a, b]
function aleal(a, b) ( a * pow(b / a, rand(1)); );              // dans [a, b] (a, b > 0), en echelle logarithmique
function proba(p) ( rand(1) < p; );                             // vrai avec la probabilite p
function signe(p) ( (rand(1) < p) ? -1 : 1; );                  // -1 avec la probabilite p, sinon 1
function borne(x, a, b) ( max(a, min(b, x)); );
function pioche(t) ( t[min(t[-1] - 1, floor(rand(t[-1])))]; );  // un element d'un tableau, au hasard
function tps() ( ptime() - T0; );                               // le temps de la generation (s)

// un indice tire selon les poids du tableau w
function tirage(w) local(s, i, u, k)
(
    s = 0; i = 0; while (i < w[-1]) ( s += w[i]; i += 1; );
    u = rand(s); k = 0; s = w[0];
    while ((k < w[-1] - 1) && (u >= s)) ( k += 1; s += w[k]; );
    k;
);

// la table modele m (un data), ses mots PH + 1, PH + 2... remplaces par les valeurs v1, v2... : tab(m, v1, v2...) ;
// m n'est pas modifiee ; une instance qui n'existe plus (retiree a la main) arrete la generation
function tab(n; v) local(m, c, i, w, r)
(
    r = -1;
    (arret !== 2) ? (
        m = v[0]; c = malloc(m[-1]);
        i = 0; while (i < m[-1]) (
            w = m[i];
            ((w > PH) && (w < PH + n)) ? (w = v[w - PH]);
            c[i] = w; i += 1;
        );
        r = table(c);
        mfree(c);
        (r !== 0) ? (
            print(sprintf(0, "%s : erreur %04d dans une table", TITRE, r));
            ((r === 2757) || (r === 2787)) ? (arret = 2);
        );
    );
    r;
);

// attendre d secondes ; un message "stop" (Presets-Stop.mSL, ou un nouveau depot du preset) arrete la generation
function attend(d) local(t1, m)
(
    t1 = ptime() + d;
    while ((arret === 0) && (ptime() < t1 - 0.005)) (
        (t1 - ptime() >= 1) ? (
            m = event(`wait, t1 - ptime());
            (m > 0) ? (
                (m[2] === `stop) ? (arret = (m[14] === 1) ? 2 : 1);
                event(`recycle, m);
            );
        ) : (
            wait(t1 - ptime());
        );
    );
);

// la fin : attendre d secondes ; seul un nouveau depot du preset (un arret immediat) interrompt
function attfin(d) local(t1, m)
(
    t1 = ptime() + d;
    while ((arret !== 2) && (ptime() < t1 - 0.005)) (
        (t1 - ptime() >= 1) ? (
            m = event(`wait, t1 - ptime());
            (m > 0) ? (
                ((m[2] === `stop) && (m[14] === 1)) ? (arret = 2);
                event(`recycle, m);
            );
        ) : (
            wait(t1 - ptime());
        );
    );
);

// la duree utilisable du buffer d'entree (s) : la part deja enregistree, ou la duree du fichier
function dispo() local(e)
(
    avecfic ? duree : (
        e = ptime() - Trec;
        (e >= duree) ? duree : max(2, e - 0.5);
    );
);

// l'energie erre autour d'un arc (faible au debut et a la fin, forte au milieu)
function energie() local(x, arc)
(
    x = borne(tps() / sortie, 0, 1);
    arc = 0.2 + 0.6 * sin($pi * x);
    E = borne(0.5 * E + 0.5 * (arc + alea(-0.35, 0.35)), 0, 1);
);

// la duree d'une transition : une coupure (20 %), un fondu court (50 %) ou long (30 %)
function transit() local(u)
(
    u = rand(1);
    (u < 0.2) ? alea(0.03, 0.15) : ((u < 0.7) ? alea(0.8, 4) : alea(5, 14));
);

// ======================================================================================================================
// Sillons : les modules
// ======================================================================================================================
/*
  L'instance sillons : les lecteurs de fragments f1, f2 (Brage) sur le buffer d'entree (sillin:src), leur somme mono fo ;
  trois boucles b1, b2, b3 (des lignes courtes), leurs writers w1, w2, w3 (mode Sum : overdub, le sens d'ecriture tire au
  hasard) dont l'entree i1, i2, i3 recoit les fragments et un peu de la boucle precedente, et dont le gain suit les
  niveaux l4 s4, l5 s5, l6 s6 ; leurs lecteurs r1, r2, r3 (leur volume : l1 s1, l2 s2, l3 s3 ; leur vitesse glisse :
  k1 q1, k2 q2, k3 q3, en octaves) ; les fragments directs (l7 s7 e7 v7) ; la somme mx, le chorus fl (pleurage), le
  filtre tn (ts : sa couleur par paliers), la piece rm ; le niveau general (lm sm em vm) ; res, wo ; l'ecoute m0, m1.
*/
var KM = 7;                                   // le niveau general (0-2 : les boucles, 3-5 : leurs enregistrements, 6 : direct)
var MAST = -4;
var NVl = array(`l1, `l2, `l3, `l4, `l5, `l6, `l7, `lm);
var NVs = array(`s1, `s2, `s3, `s4, `s5, `s6, `s7, `sm);
var NVc = malloc(8);
var NVd = malloc(8);

// les niveaux : une cible (un LFO constant "l...") et une pente (un Math Slew "s..." : de -80 a 0 dB, par pas de
// 0.8 dB) ; ils modulent le volume d'un reader, le gain d'un writer, ou (Math Exp "e...", Math Mul "v...") un son ;
// niv(k, dB, s) : le niveau k va vers dB en s secondes (au plus 10 s par 0.8 dB) ; ils partent de -80 dB
var TNIV = data(Interstys  Effect sillons:7700000003  offset 7700000001  Effect sillons:7700000004  attack 7700000002  release 7700000002);
function niv(k, db, s) local(t, d, a)
(
    t = borne(1 + db / 80, 0, 1);
    d = 100 * abs(t - NVc[k]);
    a = borne(1000 * s / max(0.01, d), 1, 10000);
    NVc[k] = t; NVd[k] = db;
    tab(TNIV, t, a, NVl[k], NVs[k]);
);
var k1 = 0;
loop(KM + 1, NVd[k1] = -80; k1 += 1;);

// le buffer d'entree (l'instance sillin : la ligne src et le writer rec, qui l'enregistre depuis In:0)
var TIN = data(
    Interstys
    Algorithm SillIn
        Line src  length 7700000001  chan 7700000002
        Writer rec  line src  source In:0  status Paused
        Display Line src
    End
    Instance sillin SillIn
);
var TFIC = data(Interstys  Line sillin:src  file 7700000001);
var TREC = data(Interstys  Writer sillin:rec  status 7700000001);
var TWS = data(Interstys  Writer sillons:7700000001  status 7700000002);
var TRST = data(Interstys  Reader sillons:7700000001  status 7700000002);

// l'enregistrement s'arrete quand le buffer d'entree est plein (sauf "continu")
function finrec()
(
    (!avecfic && !continu && !recfin && (ptime() - Trec >= duree)) ? (
        tab(TREC, `Paused); recfin = 1;
        print(sprintf(0, "%s : le buffer d'entree est complet (%d s)", TITRE, duree));
    );
);

var TCRE = data(
    Interstys
    Algorithm Sillons
        Line res  length 7700000001  chan 1
        Line b1  length 7700000002  chan 1
        Line b2  length 7700000003  chan 1
        Line b3  length 7700000004  chan 1
        Effect l1  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s1  type Math  chan 1  source Effect l1  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l2  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s2  type Math  chan 1  source Effect l2  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l3  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s3  type Math  chan 1  source Effect l3  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l4  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s4  type Math  chan 1  source Effect l4  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l5  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s5  type Math  chan 1  source Effect l5  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l6  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s6  type Math  chan 1  source Effect l6  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect l7  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect s7  type Math  chan 1  source Effect l7  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect lm  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect sm  type Math  chan 1  source Effect lm  gain 40  mode Slew  attack 1000  release 1000  amp 0.01  offset -1
        Effect k1  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect q1  type Math  chan 1  source Effect k1  mode Slew  attack 1000  release 1000
        Effect k2  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect q2  type Math  chan 1  source Effect k2  mode Slew  attack 1000  release 1000
        Effect k3  type LFO  chan 1  freq 0.01  amp 0  offset 0
        Effect q3  type Math  chan 1  source Effect k3  mode Slew  attack 1000  release 1000
        Reader f1  line sillin:src  mode Brage  outchan 2  loop loop  out Own  block 400  overlap 25  search 0  transp 0
                   speed 1  status Reading
        Reader f2  line sillin:src  mode Brage  outchan 2  loop loop  out Own  block 900  overlap 25  search 0  transp 0
                   speed -1  status Reading
        Effect fo  type Mixer  chan 1  src1 Reader f1:0  gain1 -3  src2 Reader f1:1  gain2 -3  src3 Reader f2:0  gain3 -3
                   src4 Reader f2:1  gain4 -3
        Effect i1  type Mixer  chan 1  src1 Effect fo  gain1 0  src2 Reader r3  gain2 -120
        Writer w1  line b1  source Effect i1  mode Sum  overdub 75  direction 7700000005
                   mod Gain Effect s4  depth 80  law dB  status Writing
        Reader r1  line b1  loop loop  xfade 30  out Own  speed 7700000008  mod Volume Effect s1  depth 80  law dB
                   mod Speed Effect q1  depth 1  law Oct  status Reading
        Effect i2  type Mixer  chan 1  src1 Effect fo  gain1 0  src2 Reader r1  gain2 -120
        Writer w2  line b2  source Effect i2  mode Sum  overdub 75  direction 7700000006
                   mod Gain Effect s5  depth 80  law dB  status Writing
        Reader r2  line b2  loop loop  xfade 30  out Own  speed 7700000009  mod Volume Effect s2  depth 80  law dB
                   mod Speed Effect q2  depth 1  law Oct  status Reading
        Effect i3  type Mixer  chan 1  src1 Effect fo  gain1 0  src2 Reader r2  gain2 -120
        Writer w3  line b3  source Effect i3  mode Sum  overdub 75  direction 7700000007
                   mod Gain Effect s6  depth 80  law dB  status Writing
        Reader r3  line b3  loop loop  xfade 30  out Own  speed 7700000010  mod Volume Effect s3  depth 80  law dB
                   mod Speed Effect q3  depth 1  law Oct  status Reading
        Effect e7  type Math  chan 1  source Effect s7  gain 38.0618  mode Exp
        Effect v7  type Math  chan 1  source Effect fo  src2 Effect e7  mode Mul
        Effect mx  type Mixer  chan 1  src1 Reader r1  gain1 0  src2 Reader r2  gain2 0  src3 Reader r3  gain3 0
                   src4 Effect v7  gain4 0
        Effect fl  type Chorus  chan 1  source Effect mx  delay 12  sweep 3  rate 0.6  wave Random  voices 1  jitter 0.5
                   glide 1  mix 100
        Effect ts  type Random  chan 1  mode Step  dist Uniform  rate 0.08  jitter 0.6  steps 6  glide 0.8  amp 1  offset 0
        Effect tn  type Filter  chan 1  source Effect fl  mode LP  stages 2  freq 3200  q 0.9  mod Cutoff Effect ts  depth 1.6
        Effect rm  type Matrix  chan 1  source Effect tn  mode Householder  lines 8  delays Random  seed 7700000011  dmin 11
                   dmax 47  decay 0.9  damp 6000  mix 22
        Effect em  type Math  chan 1  source Effect sm  gain 38.0618  mode Exp
        Effect vm  type Math  chan 1  source Effect rm  src2 Effect em  mode Mul  limiter On
        Writer wo  line res  source Effect vm  status Paused
        Effect m0  type Mixer  chan 1  src1 Effect vm  gain1 7700000012  out Out:0
        Effect m1  type Mixer  chan 1  src1 Effect vm  gain1 7700000012  out Out:1
        Display Line res
    End
    Instance sillons Sillons
);

var BN = array(`r1, `r2, `r3);                // les lecteurs des boucles
var WN = array(`w1, `w2, `w3);                // leurs writers
var XN = array(`i1, `i2, `i3);                // leurs entrees (la reinjection de la boucle precedente : gain2)
var KN = array(`k1, `k2, `k3);                // les glissements de leur vitesse : la cible
var QN = array(`q1, `q2, `q3);                // et la pente
var FN = array(`f1, `f2);                     // les lecteurs de fragments
var SPD = array(-2, -1, -0.5, 0.5, 0.75, 1, 1, 1.5, 2);    // les vitesses des boucles (< 0 : a l'envers)
var SB = malloc(3);                           // la vitesse de chaque boucle
var GO = malloc(3);                           // son glissement (octaves)
var OV = malloc(3);                           // son overdub (%)
var LB = malloc(3);                           // sa longueur (s)

// le sens d'ecriture d'une boucle : en avant, en arriere, ou les deux
function sens() local(u) ( u = rand(1); (u < 0.6) ? `Forward : ((u < 0.85) ? `Backward : `Both); );

// les modules : la duree du buffer de sortie, les longueurs des boucles, leurs sens, leurs vitesses, la graine, l'ecoute
function creer() local(k)
(
    k = 0; loop(3, LB[k] = aleal(0.7, 9); SB[k] = pioche(SPD); OV[k] = 75; k += 1;);
    print(sprintf(0, "%s : boucles de %.2f, %.2f et %.2f s", TITRE, LB[0], LB[1], LB[2]));
    tab(TCRE, sortie + 30, LB[0], LB[1], LB[2], sens(), sens(), sens(), SB[0], SB[1], SB[2], floor(rand(99999)),
        borne(ecoute, -120, 40));
);

var TFR = data(Interstys  Reader sillons:7700000001  from 7700000002  to 7700000003  block 7700000004  speed 7700000005  overlap 7700000006  transp 7700000007);
var TOV = data(Interstys  Writer sillons:7700000001  overdub 7700000002);
var TSB = data(Interstys  Reader sillons:7700000001  speed 7700000002);
var TXF = data(Interstys  Effect sillons:7700000001  gain2 7700000002);
var TGL = data(Interstys  Effect sillons:7700000001  offset 7700000002  Effect sillons:7700000003  attack 7700000004  release 7700000004);
var TTN = data(Interstys  Effect sillons:ts  rate 7700000001  Effect sillons:fl  rate 7700000002  sweep 7700000003);

// le lecteur de fragments i : une region au hasard, des segments de 60 a 1500 ms, une vitesse, une transposition
function frag(i) local(d, w, a)
(
    d = dispo(); w = borne(aleal(0.5, 20), min(d, 0.3), d); a = rand(max(0, d - w));
    tab(TFR, FN[i], a, a + w, aleal(60, 1500), pioche(SPD), floor(alea(10, 40)), (proba(0.3) ? alea(-5, 5) : 0));
);

// la vitesse de la boucle k glisse vers oc octaves (par rapport a sa vitesse) en s secondes
function glisse(k, oc, s) local(a)
(
    a = borne(1000 * s / max(0.01, abs(oc - GO[k])), 1, 10000);
    GO[k] = oc;
    tab(TGL, KN[k], borne(oc, -10, 10), QN[k], a);
);

// la boucle k : son overdub (%) et ce qu'elle recoit de la boucle precedente (dB) : son gain reste sous 0.95
function boucle(k, ov, xg)
(
    xg = ((ov / 100 + pow(10, xg / 20)) > 0.95) ? 20 * log10(max(0.00001, 0.95 - ov / 100)) : xg;
    OV[k] = ov;
    tab(TOV, WN[k], ov);
    tab(TXF, XN[k], borne(xg, -120, 40));
);

// un arret de bande sur la boucle k : la vitesse tombe (-6 octaves), puis repart
function bande(k) local(g, s)
(
    (NVd[k] > -60) ? (
        print(sprintf(0, "%s %d:%02d  arret de bande (boucle %d)", TITRE, floor(tps() / 60), floor(tps()) % 60, k + 1));
        g = GO[k]; s = alea(0.5, 2.5);
        glisse(k, -6, s);
        attend(s + alea(0.3, 1.5));
        glisse(k, g, (proba(0.4) ? 0.05 : alea(0.3, 2)));
    );
);

// un effacement : la boucle k se remplit de neuf pendant un passage (si elle enregistre)
function efface(k) local(o)
(
    (NVd[3 + k] > -60) ? (
        print(sprintf(0, "%s %d:%02d  effacement (boucle %d)", TITRE, floor(tps() / 60), floor(tps()) % 60, k + 1));
        o = OV[k];
        tab(TOV, WN[k], 0);
        attend(LB[k] * 1.05);
        tab(TOV, WN[k], o);
    );
);

// une section dure D secondes : toutes les 1.5 a 5 s, un arret de bande, un effacement, une fluctuation de vitesse,
// ou de nouveaux fragments
function vivre(D) local(tf, u, k)
(
    tf = ptime() + D;
    while ((arret === 0) && (ptime() < tf - 0.3) && (tps() < sortie - FIN)) (
        attend(min(alea(1.5, 5), max(0.1, tf - ptime())));
        finrec();
        ((arret === 0) && (ptime() < tf - 1) && (tps() < sortie - FIN)) ? (
            k = floor(rand(2.999)); u = rand(1);
            (u < 0.12) ? bande(k) : ((u < 0.22) ? efface(k) :
            ((u < 0.42) ? glisse(k, GO[k] + alea(-0.06, 0.06), alea(0.5, 2)) : ((u < 0.65) ? frag(floor(rand(1.999))) : 0)));
        );
    );
);

function section() local(D, tr, k, f)
(
    energie();
    NS += 1;
    D = aleal(8, 40);
    tr = transit();
    print(sprintf(0, "%s %d:%02d  section %d : %d s (energie %.2f)", TITRE, floor(tps() / 60), floor(tps()) % 60, NS,
        floor(D + 0.5), E));
    frag(0); frag(1);
    k = 0;
    loop(3,
        // l'enregistrement s'ouvre ou se ferme (une coupure franche une fois sur deux)
        f = proba(0.3 + 0.45 * E);
        niv(3 + k, (f ? alea(-6, 0) : -80), (proba(0.5) ? 0.02 : alea(0.3, 3)));
        ((!f) && proba(0.3)) ? (
            boucle(k, 100, -120);
            print(sprintf(0, "%s %d:%02d  sillon ferme (boucle %d)", TITRE, floor(tps() / 60), floor(tps()) % 60, k + 1));
        ) : boucle(k, alea(50, 90), (proba(0.35) ? alea(-20, -12) : -120));
        proba(0.4) ? ( SB[k] = pioche(SPD); tab(TSB, BN[k], SB[k]); );
        proba(0.3) ? glisse(k, (proba(0.5) ? 0 : alea(-1, 1)), aleal(2, 15));
        niv(k, (proba(0.75) ? alea(-12, -3) : -80), tr);
        k += 1;
    );
    niv(6, (proba(0.25) ? alea(-16, -6) : -80), tr);
    tab(TTN, aleal(0.03, 0.4), aleal(0.2, 3), alea(1, 6));
    vivre(D);
);

// la fin : les lecteurs et les writers des boucles s'arretent
function arreter()
(
    tab(TRST, `f1, `Paused); tab(TRST, `f2, `Paused);
    tab(TRST, `r1, `Paused); tab(TRST, `r2, `Paused); tab(TRST, `r3, `Paused);
    tab(TWS, `w1, `Paused); tab(TWS, `w2, `Paused); tab(TWS, `w3, `Paused);
);

// ======================================================================================================================
// Demarrage, generation, fin (les memes dans les cinq presets)
// ======================================================================================================================
// un depot precedent de ce preset : son chef d'orchestre s'arrete (ses modules sont refaits ci-dessous)
(thread(`count, NOM) > 0) ? (
    loop(thread(`count, NOM), event(`notify, 0, 0, 0, 0, NOM, `stop, 0, 10, 0, 0, 0, 1, 0));
    wait(1.5);
);
thread(`name, NOM);
// les instances precedentes (la ligne d'abord : lue d'un fichier, elle n'appartient plus a son instance)
table(data( Free Instance sillons ));
table(data( Free Line sillin:src  Free Instance sillin ));
var r = tab(TIN, (avecfic ? 1 : borne(duree, 2, 1300)), (avecfic ? 1 : borne(canaux, 1, 2)));
((r === 0) && avecfic) ? (r = tab(TFIC, fichier));
(r === 0) ? (r = creer());
(r !== 0) ? (
    print(sprintf(0, "%s : les modules n'ont pas pu etre crees (erreur %04d), rien n'est genere.", TITRE, r));
    arret = 2;
);
(arret === 0) ? (
    Trec = ptime();
    avecfic ? (
        print(sprintf(0, "%s : le buffer d'entree vient du fichier %s (%d s utilisees)", TITRE, fichier, duree));
    ) : (
        tab(TREC, `Writing);
        print(sprintf(0, "%s : enregistrement du buffer d'entree depuis In:0 (%d s, %d canal(aux))", TITRE, duree, canaux));
        attend(min(duree, 6));
    );
);
(arret === 0) ? (
    T0 = ptime();
    tab(TWS, `wo, `Writing);
    niv(KM, MAST, 3);
    print(sprintf(0, "%s : generation de %d s dans le buffer de sortie (sillons:res)", TITRE, sortie));
);
while ((arret === 0) && (tps() < sortie - FIN)) ( section(); );
(arret !== 2) ? (
    niv(KM, -80, (arret === 1) ? 3 : FIN);
    attfin((arret === 1) ? 3.5 : (FIN + 0.5));
);
(arret !== 2) ? (
    tab(TWS, `wo, `Paused);
    arreter();
    (!avecfic && !recfin) ? tab(TREC, `Paused);
    print(sprintf(0, "%s : fin, %d s dans le buffer de sortie (sillons:res)", TITRE, ((T0 > 0) ? floor(tps()) : 0)));
);
