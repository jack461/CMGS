/*

   Multiple threads testing
*/
var id = "Ex-0020.";

var str = stralloc();
var sgt = stralloc();

sprintf(str, "%s Start: multiple threads testing.", id);
GM_Log(str);
sprintf(str, "%s THID = %.0f", id, thread(`idt));
GM_Log(str);

wait(2);

var thcnt = 0;

function xyz()
(
    yield();
    thcnt += 1;

    wait(1 + rand(30));
    sprintf(sgt, "%s THID-%.0f-start---", id, thread(`idt));
    // GM_Log(sgt);

    wait(2 + rand(25));
    sprintf(sgt, "%s THID-%.0f-middle 1", id, thread(`idt));

    wait(4 + rand(20));
    sprintf(sgt, "%s THID-%.0f-middle 2", id, thread(`idt));

    wait(6 + rand(15));
    sprintf(sgt, "%s THID-%.0f-middle 3", id, thread(`idt));
    // GM_Log(sgt);

    wait(8 + rand(10));
    sprintf(sgt, "%s THID-%.0f-middle 4", id, thread(`idt));

    wait(9 + rand(9));
    sprintf(sgt, "%s THID-%.0f-middle 5", id, thread(`idt));

    wait(8 + rand(8));
    sprintf(sgt, "%s THID-%.0f-middle 6", id, thread(`idt));

    wait(6 + rand(7));
    sprintf(sgt, "%s THID-%.0f-middle 7", id, thread(`idt));

    wait(4 + rand(6));
    sprintf(sgt, "%s THID-%.0f-middle 8", id, thread(`idt));

    wait(10 + rand(5));
    sprintf(sgt, "%s THID-%.0f-end----", id, thread(`idt));
    GM_Log(sgt);


    yield();
    thcnt -= 1;
);



loop(64,
    wait(2.01);
    thread(`run, thread(`new, xyz));
);

sprintf(str, "%s End of threads generation.", id);
GM_Log(str);

wait(10);

while (thcnt > 0) (
     wait(1);
);

sprintf(str, "%s End of threads execution.", id);
GM_Log(str);

// Expect "Ex-0020. End of threads execution."

 