/*
    Long alloc/free sequence, with leaking memory
*/
var id = "Ex-0011.";
var start = ptime();
var str=stralloc();

sprintf(str, "%s %d Start.", id, thread(`idt));

GM_Log(str);

var siz = 5273;
var Tab = malloc(siz);
var i, j, k, l, m, n, z, ent, cnt;
var ma, mf;
ma = mf = 0;
i=j=0;
cnt=k=l=0;
m = 2002;

loop (2000,
    n = 5002;
    loop (5000,
        ent = m  + irand(n);
        Tab[i] = malloc(ent);
        ma += 1;
        i = (i+1) % siz;
        z = Tab[j];
        (z != 0) ? (mfree(z); mf += 1; Tab[j] = 0;);
        j = (j+13) % siz;
        z = Tab[k];
        (z != 0) ? (mfree(z); mf += 1; Tab[k] = 0;);
        k = (k+17) % siz;
        z = Tab[l];
        (z != 0) ? (mfree(z); mf += 1; Tab[l] = 0;);
        l = (l+107) % siz;
        n -= 1;
	cnt += 1;
    );
    m -= 1;
);

// Expect "Ex-0011. Iterations : 10000000"
sprintf(str, "%s Iterations : %d", id, cnt);
GM_Log(str);
sprintf(str, "%s %d ma:%d mf:%d", id, thread(`idt), ma, mf);
GM_Log(str);
sprintf(str, "%s %d-Done.  %.2fs", id, thread(`idt), ptime() - start);
GM_Log(str);
strfree(str);

