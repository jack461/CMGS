print("Ex-1033. Interstys table : les actions globales StartAll, MuteAll, UnmuteAll.");

/*
  Un writer et un reader sur la ligne sa. StopAll les arrete (Ready), StartAll les relance (Writing, Reading) ; PauseAll
  les met en pause (Paused), StartAll les relance encore. MuteAll et UnmuteAll (qui supprime aussi les solos) s'executent
  sans erreur : le mute et le solo ne s'ecrivent pas dans la table (a verifier dans le pad).
  Comme Ex-1013, les actions s'appliquent a tous les modules du projet : a la fin, tout est arrete (StopAll) et rien
  n'est mute ni solo (UnmuteAll).
  Erreur : r2 : une action inconnue (2754).
*/

var r1 = table(data(
    Interstys
    Line sa  length 1
    Writer sw  line sa  source In:0  status Writing
    Reader sr  line sa  status Reading
    Global action MuteAll
    Global action StopAll
    Check Writer sw  status Ready
    Check Reader sr  status Ready
    Global action StartAll
    Check Writer sw  status Writing
    Check Reader sr  status Reading
    Global action PauseAll
    Check Writer sw  status Paused
    Check Reader sr  status Paused
    Global action StartAll
    Check Writer sw  status Writing
    Check Reader sr  status Reading
    Global action StopAll
    Global action UnmuteAll
    Free Reader sr
    Free Writer sw
    Free Line sa
));
var r2 = table(data( Global action SoloAll ));
print(sprintf(0, "Ex-1033. resultats : %d %d", r1, r2));

// Expected "Check Writer %d OK"
// Expected "Check Reader %d OK"
// Expected "Check Writer %d OK"
// Expected "Check Reader %d OK"
// Expected "Check Writer %d OK"
// Expected "Check Reader %d OK"
// Expected "Check Writer %d OK"
// Expected "Check Reader %d OK"
// Expected error 2754
// Expected "Ex-1033. resultats : 0 2754"
