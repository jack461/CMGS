print("Ex-1028. Interstys table : les noms des courbes (mots ou chaines entre guillemets, majuscules distinguees).");

/*
  Un nom chaine (avec un espace), renomme en un mot reserve entre guillemets ("Env") ; deux courbes cmin et cMin
  (la casse compte) ; le Dump ecrit un nom tel quel s'il est un symbole d'au plus 8 caracteres, non reserve, sinon
  entre guillemets. Les erreurs : un nom deja pris (2796), une chaine vide (2792), un nom trop long (2796), un mot
  reserve sans guillemets (2792).
*/

var r = table(data(
    Interstys
    Curve "Attaque lente"  type HEnv  points 0 0 0  1 1 0
    Dump Curve "Attaque lente"
    Curve "Attaque lente"  name "Env"
    Dump Curve "Env"
    Curve cmin  type Env
    Curve cMin  type Wave
    Dump Curve cmin
    Dump Curve cMin
    Check Curve cmin  type Env
    Check Curve "cMin"  type Wave  name cMin
));
print(sprintf(0, "Ex-1028. resultat : %d", r));

var e1 = table(data( Interstys  Curve cmin  name "cMin" ));
print(sprintf(0, "Ex-1028. nom deja pris : %d", e1));
var e2 = table(data( Interstys  Curve ""  type Env ));
print(sprintf(0, "Ex-1028. chaine vide : %d", e2));
var e3 = table(data( Interstys  Curve cmin  name "un nom bien trop long pour une courbe" ));
print(sprintf(0, "Ex-1028. nom trop long : %d", e3));
var e4 = table(data( Interstys  Dump Curve Env ));
print(sprintf(0, "Ex-1028. mot reserve : %d", e4));
var r2 = table(data( Interstys  Free Curve "Env"  Free Curve cmin  Free Curve cMin ));
print(sprintf(0, "Ex-1028. fin : %d", r2));

// Expected "Curve "Attaque lente" type HEnv points 0 0 0 1 1 0"
