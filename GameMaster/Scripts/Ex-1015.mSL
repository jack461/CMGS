print("Ex-1015. Interstys table : algorithmes et instances.");

/*
  Le modele Echo (une ligne, un writer, un reader en mode delay) est instancie deux fois : chaque instance a ses modules
  (noms locaux l, w, r), qui lui appartiennent. e2 prend les parametres par defaut et lit la sortie du reader de e1 (rd).
  Dump Instance donne l'appel puis les modules ; Free Instance les supprime. Les numeros dependent du projet (%d).
  Erreurs (rien n'est cree) : r2 : End manquant (2780) ; r3 : modele inconnu (2781) ; r4 : argument inconnu (2784) ;
  r5 : parametre hors bornes (2785) ; r6 : entree manquante (2786) ; r7 : instance inconnue (2787) ;
  r8 : Instance dans un modele (2789) ; r9 : nom deja utilise (2783).
*/

var r1 = table(data(
    Interstys
    Algorithm Echo
        input  src
        output dst
        param  time 0.25 0.001 5
        param  fb 0 -150 150
        Line l  length 5  chan 1
        Writer w  line l  source src  overdub fb  status Writing
        Reader r  writer w  delay time  out dst
    End
    Reader rd  out Bus 3
    Instance e1 Echo  src In:0  dst Bus 2:1  time 0.5  fb -3
    Instance e2 Echo  dst Out:1  src Reader rd
    Dump Instance e1
    Dump Instance e2
    Free Instance e1
    Free Instance e2
    Free Reader rd
    Free Algorithm Echo
));
var r2 = table(data( Algorithm A1 input x Line l ));
var r3 = table(data( Instance i1 Nothing ));
var r4 = table(data( Algorithm A2 input x Line l End  Instance i2 A2 x In:0 y 3 ));
var r5 = table(data( Algorithm A3 param p 1 0 2 Line l length p End  Instance i3 A3 p 5 ));
var r6 = table(data( Algorithm A4 input x output y Line l End  Instance i4 A4 x In:0 ));
var r7 = table(data( Free Instance nobody ));
var r8 = table(data( Algorithm A5 Instance i5 A2 End ));
var r9 = table(data( Algorithm A6 Line l End  Instance i6 A6  Instance i6 A6 ));
print(sprintf(0, "Ex-1015. resultats : %d %d %d %d %d %d %d %d %d", r1, r2, r3, r4, r5, r6, r7, r8, r9));

