print("Ex-1009. Interstys table : erreurs des writers et des readers.");

/*
  Chaque table s'arrete sur une erreur avant toute modification (rien n'est cree) :
  r1 : la ligne a ete supprimee plus haut dans la table (2763) ;
  r2 : canaux 2 a 2 d'une ligne de 2 canaux (2764) ;
  r3 : delai de 5 s sur une ligne de 1 s (2765) ;
  r4 : "q" est une ligne, pas un writer (2756) ;
  r5 : Foo n'est pas une source (2754) ; r6 : In n'est pas une destination (2754) ;
  r7 : cle inconnue pour un reader (2753).
*/

var r1 = table(data( Line q length 1  Free Line q  Reader x line q ));
var r2 = table(data( Line q length 1 chan 2  Reader x line q first 2 ));
var r3 = table(data( Line q length 1  Writer w line q source In:0  Reader x writer w delay 5 ));
var r4 = table(data( Line q length 1  Reader x writer q ));
var r5 = table(data( Writer w source Foo:1 ));
var r6 = table(data( Reader x out In:0 ));
var r7 = table(data( Reader x gain 3 ));
print(sprintf(0, "Ex-1009. erreurs : %d %d %d %d %d %d %d", r1, r2, r3, r4, r5, r6, r7));

// Expected error 2763
// Expected error 2764
// Expected error 2765
// Expected error 2756
// Expected error 2754
// Expected error 2754
// Expected error 2753
// Expected "Ex-1009. erreurs : 2763 2764 2765 2756 2754 2754 2753"
