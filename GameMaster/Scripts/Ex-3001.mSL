print("Ex-3001. Diffusion-3 table : les configurations des modules Edit.");

/*
  Attention : ce test remplace la configuration du module Edit D (touche z sur le module : Undo, un niveau).
  1) Une trajectoire de 4 points (fermee, lissee, deux segments courbes ; les points sans numero : 1, 2, 3, 4 dans leur
     ordre) : le journal note sa prise par Edit D.
  2) Une table qui ne change que le nom et l'option smooth : les points restent (pas de cle point).
  3) Deux points hors de la piece, free Off : le module passe en mode Free.
  Erreurs (rien ne change) : e1 Edit E (2486) ; e2 kind Line (2488) ; e3 une cle inconnue (2489) ; e4 x = 12 (2490) ;
  e5 129 points (2491 : 128 au plus) ; e6 name 3 (2487).
  Les wait laissent @gfx prendre chaque table (ed_Frame) avant la suivante.
*/

var r = table(data(
    Edit D  name "Ex3001"  kind Trajectory  closed On  smooth On  free Off
        point 0.5 0 0  bend 0 0.1 0
        point 0 0.5 0
        point -0.5 0 0  bend 0 -0.1 0.2
        point 0 -0.5 -0.25
));
print(sprintf(0, "Ex-3001. table 1 : %d (0 : OK)", r));
// Expected "Ex-3001. table 1 : 0 (0 : OK)"
wait(0.5);
// Expected "Edit D : Ex3001 : read from a table, 4 points"

r = table(data( Edit D  name "Ex3001b"  smooth Off ));
print(sprintf(0, "Ex-3001. table 2 : %d (0 : OK)", r));
// Expected "Ex-3001. table 2 : 0 (0 : OK)"
wait(0.5);
// Expected "Edit D : Ex3001b : read from a table"

r = table(data( Edit 4  name "Ex3001c"  free Off  point -1.5 0.5 0  point 3 0 0 ));
print(sprintf(0, "Ex-3001. table 3 : %d (0 : OK)", r));
// Expected "Ex-3001. table 3 : 0 (0 : OK)"
wait(0.5);
// Expected "Edit D : Ex3001c : read from a table, 2 points (outside the room : Free)"

r = table(data( Edit E  name "e1" ));
print(sprintf(0, "Ex-3001. e1 : %d", r));
// Expected error 2486
// Expected "Ex-3001. e1 : 2486"
r = table(data( Edit D  kind Line ));
print(sprintf(0, "Ex-3001. e2 : %d", r));
// Expected error 2488
// Expected "Ex-3001. e2 : 2488"
r = table(data( Edit D  color 3 ));
print(sprintf(0, "Ex-3001. e3 : %d", r));
// Expected error 2489
// Expected "Ex-3001. e3 : 2489"
r = table(data( Edit D  point 12 0 0 ));
print(sprintf(0, "Ex-3001. e4 : %d", r));
// Expected error 2490
// Expected "Ex-3001. e4 : 2490"
r = table(data( Edit D
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0  point 0 0 0
    point 0 0 0
));
print(sprintf(0, "Ex-3001. e5 : %d", r));
// Expected error 2491
// Expected "Ex-3001. e5 : 2491"
r = table(data( Edit D  name 3 ));
print(sprintf(0, "Ex-3001. e6 : %d", r));
// Expected error 2487
// Expected "Ex-3001. e6 : 2487"
wait(0.5);
print("Ex-3001. fin (Edit D garde la table 3).");
// Expected "Ex-3001. fin (Edit D garde la table 3)."
