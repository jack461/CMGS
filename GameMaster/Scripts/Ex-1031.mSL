print("Ex-1031. Interstys table : filtres raides (16 et 32 etages, jusqu'a 384 dB/oct), echelle LP1 resonante.");

/*
  Un passe-bas Butterworth de 32 biquads (384 dB/oct), passe a 16 ; un LP1 de 4 etages avec une resonance (l'echelle).
  Les erreurs : 64 etages (2754), 12 etages (2754). Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect fst  type Filter  chan 2  limiter On  freq 2000  mode LP  stages 32
    Dump Effect fst
    Check Effect fst  mode LP  stages 32
    Effect fst  stages 16
    Check Effect fst  stages 16
    Effect fld  type Filter  chan 2  freq 800  q 20  mode LP1  stages 4
    Check Effect fld  mode LP1  stages 4  q 20
    Free Effect fst
    Free Effect fld
));
print(sprintf(0, "Ex-1031. resultat : %d", r));

var e1 = table(data( Interstys  Effect fx  type Filter  stages 64 ));
var e2 = table(data( Interstys  Effect fx  type Filter  stages 12 ));
print(sprintf(0, "Ex-1031. erreurs : %d %d", e1, e2));

