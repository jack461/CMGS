print("Ex-1049. Interstys table : l'effet Ring (modulateur en anneau, AM, decaleur de frequence).");

/*
  Un nouveau Ring prend les valeurs par defaut : mode Ring, freq 440 Hz, wave Sine, detune 0, spread 0, amount 1, bchan
  Auto, mix 100 %, le limiteur en service. Le Dump montre freq, wave, detune, spread (l'oscillateur) seulement sans source
  B, curve seulement pour la forme Curve, amount seulement en AM, bchan seulement avec une source B (le Check les compare
  toujours). Sources : src1 (ou source) A, src2 B (la porteuse). Puis AM, une forme carree, des ecarts de frequence et de
  phase d'un canal au suivant, mix 80, les entrees Freq et Amount ; puis Up, la porteuse B (un LFO, son premier canal
  pour tous) et l'entree Mix ; puis Down, B retire (l'oscillateur revient).
  Erreurs (rien n'est cree) : e1 mode Shift (2754) ; e2 amount 3 (2754) ; e3 detune 20000 (2754) ; e4 wave Pulse (2754) ;
  e5 value pour un Ring (2767) ; e6 detune pour un Math (2767) ; e7 mod Value pour un Ring (2767) ; e8 src3 pour un Ring
  (2767). Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect lf  type LFO  chan 1  freq 200
    Effect rg  type Ring  chan 2  source In:0
    Dump Effect rg
    Check Effect rg  mode Ring  freq 440  wave Sine  detune 0  spread 0  amount 1  bchan Auto  mix 100  limiter On
    Effect rg  mode AM  amount 1.5  freq 6  wave Square  detune 0.5  spread 0.25  mix 80  mod Freq Ctl 1  mod Amount Ctl 2
    Dump Effect rg
    Check Effect rg  mode AM  amount 1.5  freq 6  wave Square  detune 0.5  spread 0.25  mix 80  mod Freq Ctl 1  depth 2
    Effect rg  mode Up  src2 Effect lf  bchan One  mod Mix Ctl 3
    Dump Effect rg
    Check Effect rg  mode Up  bchan One  mod Mix Ctl 3  depth 0.5
    Effect rg  mode Down  src2 none
    Dump Effect rg
    Check Effect rg  mode Down  src2 none  freq 6
    Free Effect rg
    Free Effect lf
));
print(sprintf(0, "Ex-1049. resultat : %d", r));

var e1 = table(data( Interstys  Effect x  type Ring  mode Shift ));
var e2 = table(data( Interstys  Effect x  type Ring  amount 3 ));
var e3 = table(data( Interstys  Effect x  type Ring  detune 20000 ));
var e4 = table(data( Interstys  Effect x  type Ring  wave Pulse ));
var e5 = table(data( Interstys  Effect x  type Ring  value 1 ));
var e6 = table(data( Interstys  Effect x  type Math  detune 1 ));
var e7 = table(data( Interstys  Effect x  type Ring  mod Value Ctl 1 ));
var e8 = table(data( Interstys  Effect x  type Ring  src3 In:0 ));
print(sprintf(0, "Ex-1049. erreurs : %d %d %d %d %d %d %d %d", e1, e2, e3, e4, e5, e6, e7, e8));

