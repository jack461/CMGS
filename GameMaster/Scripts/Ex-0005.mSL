print("Ex-0005. Ecritures indexees autorisees.");

/*
  Ecritures "tab[i] = v" (et "+=", "*=", ...) autorisees :
  - dans un bloc (malloc, data, array), pour un index dans [0, taille-1] ;
  - dans les arguments d'une fonction variadique "function f(n; b)", situes dans la pile ;
  - a une adresse quelconque, au moyen de poke().
*/

var t = malloc(10);
var i = 0;
while (i < 10) ( t[i] = i * i; i += 1; );
t[9] += 19;
t[0] -= 1;
print(sprintf(0, "Ex-0005. t[0] = %d, t[3] = %d, t[9] = %d", t[0], t[3], t[9]));

var d = data(1 2 3 4);
d[3] = d[0] + d[1] + d[2];
print(sprintf(0, "Ex-0005. d[3] = %d, taille %d", d[3], d[-1]));

// n : nombre d'arguments, b : les arguments (dans la pile)
function dbl(n; b)
local (k, s)
(
    k = s = 0;
    loop(n, b[k] *= 2; b[k] += 1; s += b[k]; k += 1; );
    s;
);
print(sprintf(0, "Ex-0005. dbl(1, 2, 3, 4) = %d", dbl(1, 2, 3, 4)));

var p = malloc(4);
poke(p, 2, 42);
poke(p + 3, 7);
print(sprintf(0, "Ex-0005. poke : p[2] = %d, p[3] = %d", p[2], p[3]));

mfree(t);
mfree(p);

// Expected "Ex-0005. t[0] = -1, t[3] = 9, t[9] = 100"
// Expected "Ex-0005. d[3] = 6, taille 4"
// Expected "Ex-0005. dbl(1, 2, 3, 4) = 24"
// Expected "Ex-0005. poke : p[2] = 42, p[3] = 7"
