print("Ex-1021. Interstys table : la vitesse de deplacement de la loop d'un reader (loopspeed), la desynchronisation (desync).");

/*
  loopspeed et desync sont montres par le Dump seulement s'ils ne sont pas nuls (mode lecture).
  Une vitesse hors de [-1, 1] est refusee (2754).
  Les numeros des modules et le type de boucle par defaut dependent du projet (%d, %s).
*/

var r = table(data(
    Interstys
    Line ll  length 2  chan 1
    Reader lr  line ll  loop loop  loopspeed -0.25  desync 0.1  status Paused
    Dump Reader lr
    Check Reader lr  loop loop  loopspeed -0.25  desync 0.1
    Reader lr  loopspeed 0
    Dump Reader lr
    Free Reader lr
    Free Line ll
));
print(sprintf(0, "Ex-1021. resultat : %d", r));

var e = table(data(
    Interstys
    Reader 250  loopspeed 2
));
print(sprintf(0, "Ex-1021. loopspeed 2 : %d", e));

// Expected "Reader %d status Paused line %d speed 1 out Out:0 vol 0 first 0 used 1 loop loop loopspeed -0.25 desync 0.1"
// Expected "Check Reader %d OK"
// Expected "Reader %d status Paused line %d speed 1 out Out:0 vol 0 first 0 used 1 loop loop desync 0.1"
// Expected "Ex-1021. resultat : 0"
// Expected error 2754
// Expected "Ex-1021. loopspeed 2 : 2754"
