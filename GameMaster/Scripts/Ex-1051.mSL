print("Ex-1051. Interstys table : le graphe d'un patch, Dump Patch.");

/*
  Le graphe d'un module : tout ce qu'il alimente, puis tout ce qui alimente ces modules. In, Out en sortie et Ctl ne relient
  pas : les effets 4 et 7 ecrivent tous deux Out:0, sans etre du meme graphe. Un bus relie ceux qui le lisent a ceux qui l'ecrivent.

      5 (Noise) --Bus 5--> 1 (Mixer, avec In:0) --> 3 (Filter, module par 2, un LFO) --> 4 --> Out:0
      5 --Bus 5--> 6 --Bus 6--> Writer 1 --> Line 1 --> Reader 1 --Bus 7--> 7 --> Out:0

  Effect 3 : il alimente 4 ; 1, 2 et 5 l'alimentent (6, qui lit aussi le bus 5, n'en est pas). Effect 5 : tout. Reader 1 :
  il alimente 7 ; 5, 6, le writer et la ligne l'alimentent. Les noms : le type et le numero, les entrees in1, les sorties out1.
*/

table(data( Interstys  Clear All ));
var r = table(data(
    Interstys
    Effect 1  type Mixer  chan 2  src1 In:0  gain1 0  src2 Bus 5  gain2 -6
    Effect 2  type LFO  chan 1  freq 2
    Effect 3  type Filter  chan 2  source Effect 1  freq 500  mod Cutoff Effect 2  depth 2
    Effect 4  type Mixer  chan 2  src1 Effect 3  gain1 0  out Out:0
    Effect 5  type Noise  chan 2  out Bus 5
    Effect 6  type Mixer  chan 2  src1 Bus 5  gain1 0  out Bus 6
    Line 1  length 2  chan 2
    Writer 1  line 1  source Bus 6  status Paused
    Reader 1  line 1  status Paused  out Bus 7
    Effect 7  type Mixer  chan 2  src1 Bus 7  gain1 0  out Out:0
    Dump Patch Effect 3
    Dump Patch Effect 5
    Dump Patch Reader 1
));
print(sprintf(0, "Ex-1051. resultat : %d", r));

var e1 = table(data( Interstys  Dump Patch Effect 100 ));
print(sprintf(0, "Ex-1051. erreur : %d", e1));
table(data( Interstys  Clear ));

