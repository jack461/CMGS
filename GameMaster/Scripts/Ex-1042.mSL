print("Ex-1042. Interstys table : l'effet Shimmer (le Matrix avec un transpositeur dans chaque ligne), le nombre de lignes.");

/*
  Un nouveau Shimmer prend les valeurs par defaut : Hadamard, decay 8 s, damp 7000 Hz, mix 50 %, retards de 30 a 120 ms,
  hp 100 Hz, wow 0.3 ms, shimmer 60 %, shift et shift2 12 demi-tons (une octave), grain 80 ms, 8 lignes au moins. Puis
  Householder, toute la boucle transposee (shimmer 100), les lignes paires une octave plus bas, les impaires une quinte
  plus haut, un grain court, 16 lignes, le decay module. Puis le type Matrix : ses valeurs par defaut (1 ligne au moins :
  les canaux), avec lines 4 ; l'entree Decay, commune aux deux types, reste branchee.
  Erreurs (rien n'est cree) : e1 shimmer pour un Matrix (2767) ; e2 shift 40 (2754) ; e3 grain 5 (2754) ; e4 lines 200
  (2754) ; e5 delay pour un Shimmer (2767 : une cle du Flanger) ; e6 mix -20 (2754 : [0, 100] pour un Shimmer).
  Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect sh  type Shimmer  chan 2  source In:0
    Dump Effect sh
    Check Effect sh  mode Hadamard  decay 8  damp 7000  mix 50  dmin 30  dmax 120  hp 100  wow 0.3  shimmer 60  shift 12
                     shift2 12  grain 80  lines 8
    Effect sh  mode Householder  decay 20  shimmer 100  shift -12  shift2 7  grain 30  lines 16  mod Decay Ctl 1  depth 2
    Dump Effect sh
    Check Effect sh  mode Householder  shimmer 100  shift -12  shift2 7  grain 30  lines 16  mod Decay Ctl 1  depth 2  att 1
    Effect sh  type Matrix  lines 4
    Dump Effect sh
    Check Effect sh  type Matrix  mode Householder  mix 100  decay 2  lines 4  mod Decay Ctl 1
    Free Effect sh
));
print(sprintf(0, "Ex-1042. resultat : %d", r));

var e1 = table(data( Interstys  Effect x  type Matrix  shimmer 50 ));
var e2 = table(data( Interstys  Effect x  type Shimmer  shift 40 ));
var e3 = table(data( Interstys  Effect x  type Shimmer  grain 5 ));
var e4 = table(data( Interstys  Effect x  type Shimmer  lines 200 ));
var e5 = table(data( Interstys  Effect x  type Shimmer  delay 3 ));
var e6 = table(data( Interstys  Effect x  type Shimmer  mix -20 ));
print(sprintf(0, "Ex-1042. erreurs : %d %d %d %d %d %d", e1, e2, e3, e4, e5, e6));

