print("Ex-1014. Interstys table : ligne lue dans un fichier son.");

/*
  Il faut Ex-1014.wav (0.25 s, 2 canaux, 48 kHz, 12000 echantillons ; une copie est dans Scripts/) dans le dossier
  du projet, et GMAuxiliary.eel actif (il donne ce dossier : ligne "Project folder : ..." du log).
  La ligne prend la taille et les canaux du fichier ; son Dump donne le fichier (le chemin complet, non verifie ici :
  Check le compare). Remplacee par une ligne de 2 s, elle n'a plus de fichier ; le writer w la suit.
  Erreurs : r2 : fichier absent (2770) ; r3 : "file" sans chaine (2754).
*/

var r1 = table(data(
    Interstys
    Line fl  file "Ex-1014.wav"
    Dump Line fl
    Check Line fl  chan 2  spls 12000  freq 48000  file "Ex-1014.wav"
    Writer w  line fl  source In:0
    Line fl  length 2
    Check Line fl  chan 2  spls 96000
    Check Writer w  line fl
    Dump Line fl
    Free Writer w
    Free Line fl
));
var r2 = table(data( Line x file "Ex-1014-absent.wav" ));
var r3 = table(data( Line x file 3 ));
print(sprintf(0, "Ex-1014. resultats : %d %d %d", r1, r2, r3));

// Expected "Line %d status Ready length 0.250 chan 2 spls 12000 freq 48000 file "
// Expected "Check Line %d OK"
// Expected "Check Line %d OK"
// Expected "Check Writer %d OK"
// Expected "Line %d status Ready length 2.000 chan 2 spls 96000 freq 48000"
// Expected error 2770
// Expected error 2754
// Expected "Ex-1014. resultats : 0 2770 2754"
