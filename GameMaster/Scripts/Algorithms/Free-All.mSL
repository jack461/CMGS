print("Free-All. Retire toutes les instances de la bibliotheque (une erreur 2787 : une instance absente).");

/*
  Une table par instance : une instance absente donne l'erreur 2787 sans empecher les autres.
*/

var n = 0;
(table(data( Free Instance essai )) == 0) ? (n += 1);
(table(data( Free Instance espace )) == 0) ? (n += 1);
(table(data( Free Instance traines )) == 0) ? (n += 1);
(table(data( Free Instance metal )) == 0) ? (n += 1);
(table(data( Free Instance accord )) == 0) ? (n += 1);
(table(data( Free Instance masse )) == 0) ? (n += 1);
(table(data( Free Instance pompe )) == 0) ? (n += 1);
(table(data( Free Instance souffle )) == 0) ? (n += 1);
(table(data( Free Instance tenue )) == 0) ? (n += 1);
(table(data( Free Instance repandu )) == 0) ? (n += 1);
(table(data( Free Instance anneau )) == 0) ? (n += 1);
(table(data( Free Instance ondule )) == 0) ? (n += 1);
(table(data( Free Instance vrille )) == 0) ? (n += 1);
