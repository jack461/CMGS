print("Interstys-Curves : trois courbes pour le module Curves (enveloppe ADSR, forme d'onde, rampe incurvee).");

/*
  Les courbes restent apres le script (le module "Curves" les montre ; clic gauche sur la cellule 0 : la suivante).
  Pour tout retirer : table(data( Free Curve adsr  Free Curve onde  Free Curve rampe ))
*/

var r = table(data(
    Interstys
    Curve adsr  type Env  points  0 0 0.6   0.08 1 -0.4   0.3 0.6 0   0.8 0.6 -0.5   1 0 0
    Curve onde  type Wave  periodic On  points  0 0 0.5   0.25 1 -0.5   0.5 0 0.5   0.6 -1 0   0.6 0.4 -0.7   1 0 0
    Curve rampe  type Env  points  0 0 0.9   1 1 0
    Dump Curve adsr
    Dump Curve onde
    Dump Curve rampe
));
print(sprintf(0, "Interstys-Curves : %d", r));

// Expected "Interstys-Curves : 0"
