print("Ex-1036. Interstys table : la Saturation et l'ADAA (adaa On|Off).");

/*
  Une nouvelle Saturation : ADAA en service, os 2. adaa Off avec os 4, puis le mode Fold avec adaa On et os 1 (sans
  surechantillonnage ; en 2x et plus, le filtre anti-repliement est d'ordre 4 avec l'ADAA). Le Dump ecrit adaa pour tous les modes de la Saturation.
  Erreurs (rien n'est cree) : e1 adaa Maybe (2754) ; e2 adaa pour un filtre (2767).
  Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect sa  type Saturation  chan 1
    Dump Effect sa
    Check Effect sa  adaa On  os 2
    Effect sa  adaa Off  os 4
    Dump Effect sa
    Check Effect sa  adaa Off  os 4
    Effect sa  mode Fold  adaa On  os 1
    Check Effect sa  mode Fold  adaa On  os 1
    Free Effect sa
));
print(sprintf(0, "Ex-1036. resultat : %d", r));

var e1 = table(data( Interstys  Effect sx  type Saturation  adaa Maybe ));
var e2 = table(data( Interstys  Effect fx  type Filter  adaa On ));
print(sprintf(0, "Ex-1036. erreurs : %d %d", e1, e2));

