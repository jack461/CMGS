print("Ex-1034. Interstys table : la boucle libre au bout de la ligne, elle saute ou elle traverse (cross).");

/*
  cross On : la boucle libre traverse la fin de la ligne (elle peut etre a cheval sur la fin et le debut) ;
  cross Off (par defaut) : elle saute a l'autre bout. Le Dump ne montre cross que s'il vaut On (mode lecture).
  Une autre valeur que On et Off est refusee (2754).
  Les numeros des modules dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Line ll  length 2  chan 1
    Reader lr  line ll  loop loop  loopspeed 0.5  cross On  status Paused
    Dump Reader lr
    Check Reader lr  loop loop  loopspeed 0.5  cross On
    Reader lr  cross Off
    Dump Reader lr
    Check Reader lr  cross Off
    Free Reader lr
    Free Line ll
));
print(sprintf(0, "Ex-1034. resultat : %d", r));

var e = table(data(
    Interstys
    Reader 250  cross Maybe
));
print(sprintf(0, "Ex-1034. cross Maybe : %d", e));

// Expected "Reader %d status Paused line %d speed 1 out Out:0 vol 0 first 0 used 1 loop loop loopspeed 0.5 cross On"
// Expected "Check Reader %d OK"
// Expected "Reader %d status Paused line %d speed 1 out Out:0 vol 0 first 0 used 1 loop loop loopspeed 0.5"
// Expected "Check Reader %d OK"
// Expected "Ex-1034. resultat : 0"
// Expected error 2754
// Expected "Ex-1034. cross Maybe : 2754"
