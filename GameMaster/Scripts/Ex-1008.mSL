print("Ex-1008. Interstys table : un writer, un reader en mode delay, un reader en mode lecture.");

/*
  Les modules sont designes par des noms ; ils sont decrits (Dump), verifies (Check), puis supprimes.
  Le writer n'a pas de status : avec une ligne et une source, il est "Ready".
  Les numeros des modules et le type de boucle par defaut du reader rd dependent du projet (%d, %s).
*/

var r = table(data(
    Interstys
    Line rl  length 1  chan 2
    Writer rw  line rl  source In:0  gain -6  overdub 50  mode Sum
    Reader rd  writer rw  delay 0.25  out Bus 3:1  vol -3  status Reading
    Reader rr  line rl  speed -0.5  first 1  used 1  loop catch  status Paused
    Dump Writer rw
    Dump Reader rd
    Dump Reader rr
    Check Writer rw  line rl  source In:0  gain -6  overdub 50  mode Sum  status Ready
    Check Reader rd  writer rw  delay 0.25  out Bus 3:1  vol -3  status Reading
    Check Reader rr  line rl  speed -0.5  first 1  used 1  loop catch  status Paused
    Free Reader rd
    Free Reader rr
    Free Writer rw
    Free Line rl
    Check Writer rw  status Undefined
));
print(sprintf(0, "Ex-1008. resultat : %d", r));

// Expected "Writer %d status Ready line %d source In:0 gain -6 overdub 50 mode Sum first 0 used 0"
// Expected "Reader %d status Reading writer %d delay 0.25 speed 1 out Bus 3:1 vol -3 first 0 used 2 loop %s"
// Expected "Reader %d status Paused line %d speed -0.5 out Out:0 vol 0 first 1 used 1 loop catch"
// Expected "Check Writer %d OK"
// Expected "Check Reader %d OK"
// Expected "Check Reader %d OK"
// Expected "Check Writer %d OK"
// Expected "Ex-1008. resultat : 0"
