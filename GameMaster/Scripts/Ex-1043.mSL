print("Ex-1043. Interstys table : le bloc Display (un module montre dans l'onglet courant).");

/*
  Display Effect|Reader|Writer|Line id, Display Curve id : le module est montre dans l'onglet courant : par la vue qui le
  montre deja, sinon par une vue qui montre un module qui n'existe pas, sinon par une nouvelle vue (Effect A ... P, Reader,
  Writer, Line, Curves A ... H), a la fin du panneau qui a le moins de modules. Display "nom" : le module de ce nom (celui
  du menu des modules : "Globals", "System Log", "Patch"...) est ajoute a l'onglet s'il n'y est pas.
  Ici l'effet dx est montre deux fois (une seule vue), puis la ligne lx, la courbe cx et le module Globals ; dx, lx et cx
  sont ensuite supprimes : leurs vues restent dans l'onglet, elles montrent des modules qui n'existent plus et
  resserviront. A verifier a l'oeil : les vues de dx (un Mixer), de lx, de cx, et le module Globals dans l'onglet.
  Erreurs (rien n'est cree) : e1 Display Global (2776) ; e2 Display d'un nom inconnu (2757) ; e3 Display "Nothing" (2777 :
  pas de module de ce nom).
*/

var r = table(data(
    Interstys
    Effect dx  type Mixer  chan 2  src1 In:0
    Line lx  length 1  chan 2
    Curve cx  type Env  points 0 0 0  0.5 1 0  1 0 0
    Display Effect dx
    Display Effect dx
    Display Line lx
    Display Curve cx
    Display "Globals"
    Free Effect dx
    Free Line lx
    Free Curve cx
));
print(sprintf(0, "Ex-1043. resultat : %d", r));

var e1 = table(data( Interstys  Display Global ));
var e2 = table(data( Interstys  Display Effect nosuch ));
var e3 = table(data( Interstys  Display "Nothing" ));
print(sprintf(0, "Ex-1043. erreurs : %d %d %d", e1, e2, e3));

// Expected "Ex-1043. resultat : 0"
// Expected error 2776
// Expected error 2757
// Expected error 2777
// Expected "Ex-1043. erreurs : 2776 2757 2777"
