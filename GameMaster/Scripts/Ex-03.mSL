print("Ex-03: Fibonacci recursive.");

/*
  Un exemple typique de définition de fonction récursive
  La première ligne de la fonction permet d'en tracer les appels successifs
*/
function fibo(n)
(
    print(sprintf(0, "calling fibo(%d)", n)); 
    (n <= 1) ? 1 : fibo(n-1) + fibo(n-2);
);

var s = fibo(5);
var str = stralloc(); 

print(str, "s vaut %d", s); 
GM_Log(str); 

/*
  La déclaration "ext" permet de définir un objet "externe"
  Celui-ci va être rémanent durant toute la session REAPER
  L'exemple 04 permet de vérifier que la fonction "fibo",
  sous le nom "fib", est toujours disponible, même après
  la terminaison de cet exemple 03.
*/
ext fib = fibo;


strfree(str);

