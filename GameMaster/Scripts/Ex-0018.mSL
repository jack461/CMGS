/*
   Multiple threads testing
*/
var id = "Ex-0018.";
var str = stralloc();
var sgt = stralloc();

sprintf(str, "%s Start: multiple threads testing.", id);
GM_Log(str);


sprintf(str, "%s THID = %.0f", id, thread(`idt));
GM_Log(str);


wait(6);
var cnt = 0;

function xyz()
(
    yield(); cnt += 1;
    wait(5 + rand(50));
    sprintf(sgt, "%s THID-%011.0f-End", id, thread(`idt));
    // GM_Log(sgt);
    yield(); cnt -= 1;
);


loop(512,
    wait(0.1);
    thread(`run, thread(`new, xyz));
);

sprintf(str, "%s End Threads generation.", id);
GM_Log(str);

while (cnt > 0) (
    wait(1);
);


sprintf(str, "%s End Threads execution.", id);
GM_Log(str);

// Expected "Ex-0018. End Threads execution."