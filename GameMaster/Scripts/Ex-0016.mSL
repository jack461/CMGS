/*
    Threads execution
*/

var str = stralloc();
var sgt = stralloc();

var id = "Ex-0016.";

sprintf(str, "%s Start", id);
GM_Log(str);
sprintf(str, "%s THrID = %.0f", id, thread(`idt));
GM_Log(str);

function xthread()
(
    sprintf(sgt, "%s Sub THrd-%.0f-start", id, thread(`idt));
    GM_Log(sgt);

    wait(10 + rand(40));
    sprintf(sgt, "%s Sub THrd-%.0f-end", id, thread(`idt));
    GM_Log(sgt);
);

var thr1 = thread(`new, xthread);
var thr2 = thread(`new, xthread);
var thr3 = thread(`new, xthread);
var thr4 = thread(`new, xthread);

thread(`run, thr1);
thread(`run, thr2);
thread(`run, thr3);
thread(`run, thr4);

yield();

var lp = 1, cnt = 0;

while (lp) (
    ((thread(`status, thr1) == 0) && (thread(`status, thr2) == 0) &&
     (thread(`status, thr3) == 0) && (thread(`status, thr4) == 0)) ? (
        lp = 0;
    );
    wait(1);
    cnt += 1;
    (cnt > 60) ? (
        sprintf(str, "%s Some threads not terminated", id);
        sprintf(sgt, "%s Status: %d %d %d %d", id, 
		thread(`status, thr1), thread(`status, thr2),
            	thread(`status, thr3), thread(`status, thr4));
        GM_Log(str);
        GM_Log(sgt);
        exit(0);
    );
);

sprintf(str, "%s All threads terminated", id);
GM_Log(str);

strfree(str);
strfree(sgt);

// Expect "Ex-0016. All threads terminated"
//=============================================================//