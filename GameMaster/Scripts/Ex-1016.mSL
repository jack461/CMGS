print("Ex-1016. Interstys table : Set d'une instance.");

/*
  L'instance d1 du modele Dly est mise en pause (Global action PauseAll : le writer et le reader passent en Paused).
  Set ne reapplique que les cles qui dependent d'un argument change : apres "Set d1 time 0.3", le delai change, et le
  writer et le reader restent en pause (leur "status" ne depend d'aucun argument). Puis level et dst changent.
  Les numeros dependent du projet (%d).
  Erreurs (rien n'est modifie) : r2 : instance inconnue (2787) ; r3 : parametre hors bornes (2785) ;
  r4 : argument inconnu (2784).
*/

var r1 = table(data(
    Interstys
    Algorithm Dly
        input  src
        output dst
        param  time 0.25 0.001 5
        param  level 0 -120 40
        Line l  length 5  chan 1
        Writer w  line l  source src  status Writing
        Reader r  writer w  delay time  out dst  vol level  status Reading
    End
    Instance d1 Dly  src In:0  dst Out:0  time 0.5  level -6
    Global action PauseAll
    Set d1  time 0.3
    Dump Instance d1
    Set d1  level -12  dst Bus 2
    Dump Instance d1
    Free Instance d1
    Free Algorithm Dly
));
var r2 = table(data( Set nobody time 1 ));
var r3 = table(data( Algorithm A7 param p 1 0 2 Line l length p End  Instance x7 A7  Set x7 p 9 ));
var r4 = table(data( Algorithm A8 param p 1 0 2 Line l length p End  Instance x8 A8  Set x8 q 1 ));
print(sprintf(0, "Ex-1016. resultats : %d %d %d %d", r1, r2, r3, r4));

// Expected "Instance d1 Dly src In:0 dst Out:0 time 0.3 level -6"
// Expected "Line %d status Ready length 5.000 chan 1 spls %d freq %d"
// Expected "Writer %d status Paused line %d source In:0 gain 0 overdub 0 mode XFade first 0 used 0"
// Expected "Reader %d status Paused writer %d delay 0.3 speed 1 out Out:0 vol -6 first 0 used %d loop %s"
// Expected "Instance d1 Dly src In:0 dst Bus 2 time 0.3 level -12"
// Expected "Line %d status Ready length 5.000 chan 1 spls %d freq %d"
// Expected "Writer %d status Paused line %d source In:0 gain 0 overdub 0 mode XFade first 0 used 0"
// Expected "Reader %d status Paused writer %d delay 0.3 speed 1 out Bus 2:0 vol -12 first 0 used %d loop %s"
// Expected error 2787
// Expected error 2785
// Expected error 2784
// Expected "Ex-1016. resultats : 0 2787 2785 2784"
