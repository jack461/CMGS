print("Ex-1023. Interstys table : les courbes (Curve), enveloppes et formes d'onde.");

/*
  Une enveloppe nommee (points x y c), une forme d'onde periodique (le dernier y devient le premier), le Dump, le Check,
  le changement de nom, puis Free. Les erreurs : points mal formes (2794), y hors bornes (2795), courbe inconnue (2792).
  Les numeros des courbes dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Curve cenv  type Env  points 0 0 0  0.25 1 0.5  1 0 -0.5
    Dump Curve cenv
    Check Curve cenv  type Env  points 0 0 0  0.25 1 0.5  1 0 0
    Curve cwav  type Wave  periodic On  points 0 0 0  0.5 1 0  0.75 -1 0  1 0.5 0
    Dump Curve cwav
    Curve cwav  name cwav2
    Check Curve cwav2  name cwav2  periodic On
    Free Curve cenv
    Free Curve cwav2
));
print(sprintf(0, "Ex-1023. resultat : %d", r));

var e1 = table(data( Interstys  Curve cbad  points 0 0 0  0.5 1 ));
print(sprintf(0, "Ex-1023. points incomplets : %d", e1));
var e2 = table(data( Interstys  Curve cbad  type Env  points 0 -0.5 0  1 1 0 ));
print(sprintf(0, "Ex-1023. y hors bornes : %d", e2));
var e3 = table(data( Interstys  Dump Curve cnobody ));
print(sprintf(0, "Ex-1023. courbe inconnue : %d", e3));

