print("Ex-1024. Interstys table : courbes a sauver (puis : sauver, recharger le projet, Ex-1025).");

/*
  Cree deux courbes nommees (une enveloppe incurvee, une forme d'onde periodique avec un saut vertical). Ensuite : sauver
  le projet, le recharger, et deposer Ex-1025 : les courbes doivent avoir ete sauvees avec le projet.
*/

var r = table(data(
    Interstys
    Curve svenv  type Env  points 0 0 0.75  0.125 1 -0.3333  0.5 0.4 0  1 0 0
    Curve svwav  type Wave  periodic On  points 0 0 0.5  0.3 -1 0  0.3 0.8 -1  1 0 0
    Dump Curve svenv
    Dump Curve svwav
));
print(sprintf(0, "Ex-1024. resultat : %d", r));

// Expected "Curve svenv type Env points 0 0 0.75 0.125 1 -0.3333 0.5 0.4 0 1 0 0"
// Expected "Curve svwav type Wave periodic On points 0 0 0.5 0.3 -1 0 0.3 0.8 -1 1 0 0"
// Expected "Ex-1024. resultat : 0"
