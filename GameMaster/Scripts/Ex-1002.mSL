print("Ex-1002. Interstys : les valeurs des parametres sont dans leurs bornes.");

/*
  Les bornes sont celles de dclAllParameters (Interstys.jsfx-inc). Les valeurs elles-memes
  dependent du projet : seul le resultat de la comparaison est attendu.
*/

var bad = 0;
function chk(name, vmin, vmax) local(sl, v) (
    sl = gui(`slider, name);
    (sl === $undef) ? ( bad += 1; ) : (
        v = sl[3];
        ((v < vmin) || (v > vmax)) ? ( bad += 1; print(sprintf(0, "Ex-1002. hors bornes : %s = %f", sl[4], v)); );
    );
);

chk(`LineSize, 1, 3600);
chk(`PlayVol, -120, 40);
chk(`CrssFade, 0.01, 20000);
chk(`WrOvrdb, -150, 150);
chk(`LfoFreq, 0.001, 10000);
chk(`FltFreq, 1, 20000);

print(sprintf(0, "Ex-1002. parametres hors bornes : %d sur 6", bad));

// Expected "Ex-1002. parametres hors bornes : 0 sur 6"
