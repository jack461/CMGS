print("Ex-0008. Chaines et ramasse-miettes.");

/*
  Le script alloue environ 50 millions de mots de blocs aussitot abandonnes, davantage que la
  memoire dynamique du GamePlayer (37 M mots) : le ramasse-miettes doit donc passer, sans
  toucher aux objets encore utilises (un bloc et une chaine, references par des variables).
  Il alloue et libere aussi beaucoup de chaines, explicites (stralloc) ou temporaires (strtmp).
*/

var keep = malloc(100);
var ks = stralloc();
var i, j, s, bad = 0;

i = 0;
while (i < 100) ( keep[i] = 3 * i; i += 1; );
sprintf(ks, "chaine conservee");

j = 0;
while (j < 1000) (
    malloc(50000);
    s = stralloc(); sprintf(s, "%d", j); strfree(s);
    sprintf(strtmp(), "temporaire %d", j);
    j += 1;
);

i = 0;
while (i < 100) ( (keep[i] !== 3 * i) ? (bad += 1); i += 1; );
print(sprintf(0, "Ex-0008. bloc conserve : %d erreur(s)", bad));
print(sprintf(0, "Ex-0008. chaine : %s", ks));

strfree(ks);
mfree(keep);

// Expected "Ex-0008. bloc conserve : 0 erreur(s)"
// Expected "Ex-0008. chaine : chaine conservee"
