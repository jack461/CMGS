print("Ex-1029. Interstys table : un LFO de forme Curve (la table d'une courbe), cle curve.");

/*
  Une demi forme d'onde nommee, un LFO (forme Curve) qui la lit ; le Dump ecrit la courbe par son nom, le Check la
  compare ; la courbe changee par son numero ; l'effet et la courbe sont supprimes a la fin de la table. Les erreurs :
  une courbe inconnue (2792), la cle curve pour un filtre (2767).
*/

var r = table(data(
    Interstys
    Curve ctri  type HWave  points 0 0 0  0.5 1 0  1 0 0
    Effect lfoc  type LFO  chan 1  freq 2  mode Curve  curve ctri  amp 1
    Dump Effect lfoc
    Check Effect lfoc  type LFO  mode Curve  curve ctri  freq 2
    Effect lfoc  curve 5
    Check Effect lfoc  curve 5
    Free Effect lfoc
    Free Curve ctri
));
print(sprintf(0, "Ex-1029. resultat : %d", r));

var e1 = table(data( Interstys  Effect lfox  type LFO  mode Curve  curve cnobody ));
print(sprintf(0, "Ex-1029. courbe inconnue : %d", e1));
var e2 = table(data( Interstys  Effect flx  type Filter  curve 1 ));
print(sprintf(0, "Ex-1029. curve pour un filtre : %d", e2));

// Expected "freq 2 mode Curve amp 1 offset 0 spread 0 curve ctri"
// Expected "Check Effect %d OK"
// Expected "Check Effect %d OK"
// Expected "Ex-1029. resultat : 0"
// Expected error 2792
// Expected "Ex-1029. courbe inconnue : 2792"
// Expected error 2767
// Expected "Ex-1029. curve pour un filtre : 2767"
