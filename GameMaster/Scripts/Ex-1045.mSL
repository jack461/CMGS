print("Ex-1045. Interstys table : l'effet Noise (bruits colores, impulsions, applications chaotiques).");

/*
  Un nouveau Noise prend les valeurs par defaut : White, output -12 dB, density 1000, chaos 0.9, tilt 0, power 1, corr 0
  (chaque canal son bruit), ni passe-bas ni passe-haut (0), rumble 0 (rfreq 40 Hz), le limiteur en service. Le Dump ne
  montre density que pour Velvet, Dust et Logistic, chaos que pour Crackle et Logistic, tilt que pour Mix, power que hors
  Velvet, rfreq qu'avec un rumble (le Check les compare toujours). Puis Velvet, une densite de 40, corr 0.5, les filtres,
  la densite modulee par Ctl 1 ; puis Logistic (chaos 0.2 : r = 3.2, la periode 2), le niveau module par Ctl 2 (la
  profondeur par defaut : 12 dB) ; puis Crackle (chaos 1 : p = 2) ; puis Mix entre Brown et Pink (tilt -4.5), la forme
  x^3, un rumble de 30 % a 25 Hz.
  Erreurs (rien n'est cree) : e1 color Blue (2754) ; e2 density 0 (2754) ; e3 corr 2 (2754) ; e4 mode pour un Noise (2767) ;
  e5 chaos pour un Matrix (2767) ; e6 mod Decay pour un Noise (2767) ; e7 source pour un Noise (2767 : il n'a pas
  d'entree) ; e8 tilt 7, e9 power 9, e10 rumble 150, e11 rfreq 2 (2754). Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect nz  type Noise  chan 4
    Dump Effect nz
    Check Effect nz  color White  output -12  density 1000  chaos 0.9  tilt 0  power 1  corr 0  damp 0  hp 0  rumble 0  rfreq 40
                     limiter On
    Effect nz  color Velvet  density 40  corr 0.5  damp 8000  hp 50  output -6  mod Density Ctl 1  depth 3
    Dump Effect nz
    Check Effect nz  color Velvet  output -6  density 40  corr 0.5  damp 8000  hp 50  mod Density Ctl 1  depth 3  att 1
    Effect nz  color Logistic  chaos 0.2  density 880  mod Level Ctl 2
    Dump Effect nz
    Check Effect nz  color Logistic  chaos 0.2  density 880  mod Level Ctl 2  depth 12  att 1
    Effect nz  color Crackle  chaos 1
    Dump Effect nz
    Check Effect nz  color Crackle  chaos 1
    Effect nz  color Mix  tilt -4.5  power 3  rumble 30  rfreq 25
    Dump Effect nz
    Check Effect nz  color Mix  tilt -4.5  power 3  rumble 30  rfreq 25
    Free Effect nz
));
print(sprintf(0, "Ex-1045. resultat : %d", r));

var e1 = table(data( Interstys  Effect x  type Noise  color Blue ));
var e2 = table(data( Interstys  Effect x  type Noise  density 0 ));
var e3 = table(data( Interstys  Effect x  type Noise  corr 2 ));
var e4 = table(data( Interstys  Effect x  type Noise  mode Pink ));
var e5 = table(data( Interstys  Effect x  type Matrix  chaos 0.5 ));
var e6 = table(data( Interstys  Effect x  type Noise  mod Decay Ctl 1 ));
var e7 = table(data( Interstys  Effect x  type Noise  source In:0 ));
var e8 = table(data( Interstys  Effect x  type Noise  tilt 7 ));
var e9 = table(data( Interstys  Effect x  type Noise  power 9 ));
var e10 = table(data( Interstys  Effect x  type Noise  rumble 150 ));
var e11 = table(data( Interstys  Effect x  type Noise  rfreq 2 ));
print(sprintf(0, "Ex-1045. erreurs : %d %d %d %d %d %d %d %d %d %d %d", e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11));

