print("Ex-1018. Interstys table : instance rechargee avec le projet (apres Ex-1017, sauver, recharger).");

/*
  L'instance s1 et le modele Sv ont ete sauves avec le projet : Dump Instance les retrouve, Set agit sur les memes
  modules, et une nouvelle instance s2 du modele Sv peut etre creee. Puis tout est supprime.
  Les numeros dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Dump Instance s1
    Set s1  time 0.2
    Dump Instance s1
    Instance s2 Sv  src In:1  dst Out:0
    Dump Instance s2
    Free Instance s1
    Free Instance s2
    Free Algorithm Sv
));
print(sprintf(0, "Ex-1018. resultat : %d", r));

// Expected "Instance s1 Sv src In:0 dst Out:1 time 0.7"
// Expected "Reader %d status %s writer %d delay 0.7 speed 1 out Out:1 vol 0 first 0 used %d loop %s"
// Expected "Instance s1 Sv src In:0 dst Out:1 time 0.2"
// Expected "Reader %d status %s writer %d delay 0.2 speed 1 out Out:1 vol 0 first 0 used %d loop %s"
// Expected "Instance s2 Sv src In:1 dst Out:0 time 0.4"
// Expected "Reader %d status %s writer %d delay 0.4 speed 1 out Out:0 vol 0 first 0 used %d loop %s"
// Expected "Ex-1018. resultat : 0"
