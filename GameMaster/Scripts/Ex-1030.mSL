print("Ex-1030. Interstys table : une Saturation de mode Curve (la fonction de transfert donnee par une courbe).");

/*
  Un quart de forme d'onde nomme (la partie positive d'une fonction de transfert impaire), une Saturation de mode Curve
  qui le lit ; le Dump ecrit la courbe par son nom, seulement dans le mode Curve ; le Check la compare ; la courbe
  changee par son numero. Les erreurs : une courbe inconnue (2792), la cle curve pour un filtre (2767).
  Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Curve csat  type QWave  points 0 0 0  0.5 0.8 0.3  1 1 0
    Effect satc  type Saturation  chan 2  mode Curve  curve csat
    Dump Effect satc
    Check Effect satc  type Saturation  mode Curve  curve csat
    Effect satc  curve 7
    Check Effect satc  curve 7
    Effect satc  mode Soft
    Dump Effect satc
    Free Effect satc
    Free Curve csat
));
print(sprintf(0, "Ex-1030. resultat : %d", r));

var e1 = table(data( Interstys  Effect satx  type Saturation  mode Curve  curve cnobody ));
print(sprintf(0, "Ex-1030. courbe inconnue : %d", e1));
var e2 = table(data( Interstys  Effect flx  type Filter  curve 1 ));
print(sprintf(0, "Ex-1030. curve pour un filtre : %d", e2));

