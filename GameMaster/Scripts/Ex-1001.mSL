print("Ex-1001. Interstys : les parametres sont connus par leur nom.");

/*
  gui(`slider, nom) rend le descripteur du parametre (voir mSL_gui_ops) :
  [1] numero, [3] valeur, [4] nom, [5] format. Un nom ou un numero inconnu rend $undef.
*/

var sl = gui(`slider, `LineSize);
print(sprintf(0, "Ex-1001. LineSize : %s | %s", sl[4], sl[5]));
sl = gui(`slider, `PlaySpd);
print(sprintf(0, "Ex-1001. PlaySpd : %s | %s", sl[4], sl[5]));
sl = gui(`slider, `FltQ);
print(sprintf(0, "Ex-1001. FltQ : %s | %s", sl[4], sl[5]));

var u1 = gui(`slider, `NoParam);
var u2 = gui(`slider, -1);
var u3 = gui(`slider, 100000);
print(sprintf(0, "Ex-1001. inconnus : %s", ((u1 === $undef) && (u2 === $undef) && (u3 === $undef)) ? "OK" : "ERREUR"));

// Expected "Ex-1001. LineSize : Line size | %%.3f s"
// Expected "Ex-1001. PlaySpd : Play Speed | %%.3f"
// Expected "Ex-1001. FltQ : Resonance | %%.3f"
// Expected "Ex-1001. inconnus : OK"
