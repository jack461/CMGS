print("Ex-1054. Interstys table : les blocs Tab et View, Dump Tab, Dump View, la cle display de Global.");

/*
  Tab n : un onglet (son nom, ses panneaux, leurs largeurs, live, les modules de chaque panneau par leur nom) ; View "module" :
  ce que montre une vue (Reader A ... Curves H : l'objet, obligatoire) et les mots de son bloc d'affichage. Une session se
  termine par ces blocs. Ce test ne change pas les onglets : il les ecrit (Dump), puis verifie les erreurs.
  Global display None|Essential|All : ce qu'un patch montre quand il est lu (le test le remet a Essential, la valeur par defaut).
  Un module inconnu dans View : un message, la table continue.
  Erreurs (rien n'est fait) : e1 Tab 9 (2754) ; e2 une cle inconnue (2753) ; e3 View d'un module sans vue (2728) ; e4 View
  "Reader A" avec un effet (2728) ; e5 View sans nom (2727) ; e6 display Some (2754).
*/

var r = table(data(
    Interstys
    Dump Tab 1
    Dump View "Reader A"
    Dump View "Controls"
    View "Nothing" Effect 1 words 1 2
    Global display None
    Check Global display None
    Global display Essential
    Check Global display Essential
));
print(sprintf(0, "Ex-1054. resultat : %d", r));

var e1 = table(data( Interstys  Tab 9 ));
var e2 = table(data( Interstys  Tab 1 color 3 ));
var e3 = table(data( Interstys  View "Globals" words 1 ));
var e4 = table(data( Interstys  View "Reader A" Effect 1 ));
var e5 = table(data( Interstys  View 3 ));
var e6 = table(data( Interstys  Global display Some ));
print(sprintf(0, "Ex-1054. erreurs : %d %d %d %d %d %d", e1, e2, e3, e4, e5, e6));

