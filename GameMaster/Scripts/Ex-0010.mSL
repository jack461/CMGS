
var id = "Ex-0010.";
var str01 = stralloc();

function fact(n)
(
   n > 1 ? 
      n * fact(n-1)
   :
      1;
);


sprintf(str01, "%s Start [expect: %d]", id, 3628800);
print(str01);

var start = ptime();

var res = fact (10);

var dur = ptime() - start;

sprintf(str01, "%s Result is %d", id, res);
print(str01);

sprintf(str01, "%s Duration:  %.6f s.", id, dur); 

print(str01, "");

strfree(str01);
// Expect "Ex-0010. Result is 3628800"

