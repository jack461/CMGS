print("Ex-1041. Interstys table : l'effet Phaser (filtres passe-tout balayes : Classic, Resonant, barber pole).");

/*
  Un nouveau Phaser prend les valeurs par defaut : mode Classic, freq 800 Hz, sweep 4 octaves, rate 0.3 Hz, wave Sine,
  feedback 0.5, mix 50 %, 8 etages, spacing 0, q 2, spread 0.25, jitter 0, seed 1, cross 0, glide 0.05 s, limiteur en
  service. Puis Resonant (24 etages espaces, q 8, feedback et mix negatifs, la forme Hold, les modulations de la
  frequence et de la reinjection), puis BarberDown (feedback 1.1 : la boucle sature, jitter, cross negatif, la
  modulation de la vitesse), puis le type Flanger : le mot "sweep" est alors celui du Flanger (ms), et l'entree Rate,
  commune aux deux types, reste branchee. Le Dump ecrit les cles du Phaser dans un ordre propre.
  Erreurs (rien n'est cree) : e1 stages 65 (2754) ; e2 q 0.05 (2754 : [0.1, 100] pour un Phaser) ; e3 sweep 11 (2754) ;
  e4 mode Barber (2754) ; e5 voices pour un Phaser (2767) ; e6 stages 3 pour un Filter (2754 : 1, 2, 4 ... 32) ;
  e7 spacing 3 (2754) ; e8 mod Delay pour un Phaser (2767 : une entree du Flanger).
  Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect ph  type Phaser  chan 2  source In:0
    Dump Effect ph
    Check Effect ph  mode Classic  freq 800  sweep 4  rate 0.3  wave Sine  feedback 0.5  mix 50  stages 8  spacing 0  q 2
                     spread 0.25  jitter 0  seed 1  cross 0  glide 0.05
    Effect ph  mode Resonant  freq 1200  sweep 6  stages 24  spacing 0.3  q 8  feedback -0.8  mix -50  wave Hold  glide 0.2
               mod Freq Ctl 1  depth 3  mod Feedback Ctl 2
    Dump Effect ph
    Check Effect ph  mode Resonant  stages 24  spacing 0.3  q 8  feedback -0.8  mix -50  mod Freq Ctl 1  depth 3  att 1
                     mod Feedback Ctl 2  depth 0.5  att 1
    Effect ph  mode BarberDown  stages 6  rate 0.1  feedback 1.1  jitter 0.4  seed 5  cross -0.5  spread 0.125
               mod Freq none  mod Feedback none  mod Rate Ctl 3
    Dump Effect ph
    Check Effect ph  mode BarberDown  stages 6  feedback 1.1  jitter 0.4  cross -0.5  mod Rate Ctl 3  depth 1  att 1
    Effect ph  type Flanger  sweep 3
    Dump Effect ph
    Check Effect ph  type Flanger  sweep 3  delay 2  mod Rate Ctl 3
    Free Effect ph
));
print(sprintf(0, "Ex-1041. resultat : %d", r));

var e1 = table(data( Interstys  Effect x  type Phaser  stages 65 ));
var e2 = table(data( Interstys  Effect x  type Phaser  q 0.05 ));
var e3 = table(data( Interstys  Effect x  type Phaser  sweep 11 ));
var e4 = table(data( Interstys  Effect x  type Phaser  mode Barber ));
var e5 = table(data( Interstys  Effect x  type Phaser  voices 3 ));
var e6 = table(data( Interstys  Effect x  type Filter  stages 3 ));
var e7 = table(data( Interstys  Effect x  type Phaser  spacing 3 ));
var e8 = table(data( Interstys  Effect x  type Phaser  mod Delay Ctl 1 ));
print(sprintf(0, "Ex-1041. erreurs : %d %d %d %d %d %d %d %d", e1, e2, e3, e4, e5, e6, e7, e8));

