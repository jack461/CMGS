/*
   Cet exemple doit être chargé après l'exécution de l'exemple 03,
   qui définit la fonction "fib" sous forme d'une valeur "externe"
*/
print("Ex-0004. Appel de Fibonacci externe.");

ext fib;
var str = stralloc(); 

sprintf(str, "Ex-0004. fib = %d", fib);
print(str); 

var s = 8;
sprintf(str, "Ex-0004. fib(%d) vaut %d", s, fib(s)); 
print(str); 

strfree(str);

// Expected "Ex-0004. fib = %d"
// Expected "Ex-0004. fib(8) vaut 34"