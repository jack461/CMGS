print("Ex-1020. Interstys table : un writer en mode W-Mix.");

/*
  Le mode WMix et ses 5 reglages (fade, plateau, wait, direction, desync) : decrits (Dump), verifies (Check), puis le
  writer revient en mode XFade (le Dump ne montre plus les reglages de W-Mix, qui sont gardes).
  Un fade hors de [0.001, 10] est refuse (2754).
  Les numeros des modules dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Line wl  length 2  chan 2
    Writer ww  line wl  source In:0  gain -3  mode WMix  fade 0.2  plateau 3  wait 0.5  direction 0.2  desync 10
    Dump Writer ww
    Check Writer ww  mode WMix  fade 0.2  plateau 3  wait 0.5  direction 0.2  desync 10  status Ready
    Writer ww  mode XFade
    Dump Writer ww
    Check Writer ww  mode XFade  fade 0.2  desync 10
    Free Writer ww
    Free Line wl
));
print(sprintf(0, "Ex-1020. resultat : %d", r));

var e = table(data(
    Interstys
    Writer 250  mode WMix  fade 20
));
print(sprintf(0, "Ex-1020. fade 20 : %d", e));

// Expected "Writer %d status Ready line %d source In:0 gain -3 overdub 0 mode WMix first 0 used 0 fade 0.2 plateau 3 wait 0.5 direction 0.2 desync 10"
// Expected "Check Writer %d OK"
// Expected "Writer %d status Ready line %d source In:0 gain -3 overdub 0 mode XFade first 0 used 0"
// Expected "Check Writer %d OK"
// Expected "Ex-1020. resultat : 0"
// Expected error 2754
// Expected "Ex-1020. fade 20 : 2754"
