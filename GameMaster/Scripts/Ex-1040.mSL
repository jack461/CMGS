print("Ex-1040. Interstys table : les effets Flanger et Chorus (retards modules, Through-zero, barber pole).");

/*
  Un nouveau Flanger prend les valeurs par defaut : mode Classic, delay 2 ms, sweep 1.8 ms, rate 0.2 Hz, wave Sine,
  feedback 0.7, mix 50 %, spread 0.25, 1 voix, jitter 0, seed 1, cross 0, damp et hp 0 (aucun), glide 0.05 s, limiteur
  en service. Puis Through-zero (mix negatif, feedback negatif, cross, filtres de la reinjection, les modulations du
  retard et de la reinjection), puis BarberUp (4 voix, feedback 1.2 : la boucle sature, jitter), puis le type Chorus
  (ses valeurs par defaut : delay 15, sweep 4, rate 0.6, feedback 0, 3 voix, jitter 0.3), la forme Hold a vitesse audio
  et la modulation de la vitesse. Le Dump ecrit les cles du type dans un ordre propre au Flanger (curve : seulement
  avec la forme Curve).
  Erreurs (rien n'est cree) : e1 wave Wobble (2754) ; e2 voices 17 (2754) ; e3 mix 150 (2754) ; e4 decay pour un
  Flanger (2767) ; e5 mode Barber (2754) ; e6 rate 6000 (2754) ; e7 mix -50 pour une Saturation (le mot "mix" de la
  Saturation : [0, 100], 2754).
  Les numeros des effets dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Effect fl  type Flanger  chan 2  source In:0
    Dump Effect fl
    Check Effect fl  mode Classic  delay 2  sweep 1.8  rate 0.2  wave Sine  feedback 0.7  mix 50  spread 0.25  voices 1
                     jitter 0  seed 1  cross 0  damp 0  hp 0  glide 0.05
    Effect fl  mode Through  delay 5  sweep 4  rate 0.05  wave Triangle  feedback -0.9  mix -50  spread 0.5  cross 0.3
               damp 8000  hp 50  mod Delay Ctl 1  depth 2  mod Feedback Ctl 2
    Dump Effect fl
    Check Effect fl  mode Through  delay 5  sweep 4  feedback -0.9  mix -50  cross 0.3  mod Delay Ctl 1  depth 2  att 1
                     mod Feedback Ctl 2  depth 0.5  att 1
    Effect fl  mode BarberUp  delay 60  sweep 50  rate 5  voices 4  feedback 1.2  jitter 0.5  seed 9  glide 0
               mod Delay none  mod Feedback none
    Dump Effect fl
    Check Effect fl  mode BarberUp  voices 4  feedback 1.2  jitter 0.5  seed 9  glide 0
    Effect fl  type Chorus
    Dump Effect fl
    Check Effect fl  type Chorus  mode Classic  delay 15  sweep 4  rate 0.6  voices 3  jitter 0.3  feedback 0  mix 50
    Effect fl  wave Hold  rate 2500  mod Rate Ctl 3
    Dump Effect fl
    Check Effect fl  wave Hold  rate 2500  mod Rate Ctl 3  depth 1  att 1
    Free Effect fl
));
print(sprintf(0, "Ex-1040. resultat : %d", r));

var e1 = table(data( Interstys  Effect x  type Flanger  wave Wobble ));
var e2 = table(data( Interstys  Effect x  type Flanger  voices 17 ));
var e3 = table(data( Interstys  Effect x  type Flanger  mix 150 ));
var e4 = table(data( Interstys  Effect x  type Flanger  decay 2 ));
var e5 = table(data( Interstys  Effect x  type Flanger  mode Barber ));
var e6 = table(data( Interstys  Effect x  type Chorus  rate 6000 ));
var e7 = table(data( Interstys  Effect x  type Saturation  mix -50 ));
print(sprintf(0, "Ex-1040. erreurs : %d %d %d %d %d %d %d", e1, e2, e3, e4, e5, e6, e7));

