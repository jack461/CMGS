print("Ex-1004. Interstys table : une ligne creee, Dump, Check, Free.");

/*
  La ligne 250 est creee, decrite (Dump), verifiee (Check), puis supprimee (Free).
  Le nombre d'echantillons et la frequence dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Line 250  length 2.5  chan 2
    Dump Line 250
    Check Line 250  status Ready  length 2.5  chan 2
    Free Line 250
    Check Line 250  status Undefined
));
print(sprintf(0, "Ex-1004. resultat : %d", r));

// Expected "Line 250 status Ready length 2.500 chan 2 spls %d freq %d"
// Expected "Check Line 250 OK"
// Expected "Check Line 250 OK"
// Expected "Ex-1004. resultat : 0"
