print("Ex-1005. Interstys table : ligne conservee, puis remplacee ; Check en desaccord.");

/*
  La deuxieme description de la ligne 251 est identique : la ligne est conservee.
  La troisieme change le nombre de canaux : la ligne est remplacee.
  Le Check annonce 2 canaux : il signale l'ecart (erreur 2759), l'analyse continue.
*/

var r = table(data(
    Line 251  length 1  chan 2
    Line 251  length 1  chan 2
    Line 251  chan 4
    Dump Line 251
    Check Line 251  chan 2  length 1
    Free Line 251
));
print(sprintf(0, "Ex-1005. resultat : %d", r));

// Expected "Line 251 status Ready length 1.000 chan 4 spls %d freq %d"
// Expected error 2759
// Expected "Ex-1005. resultat : 2759"
