print("Ex-1013. Interstys table : bloc Global.");

/*
  Global regle les echantillons de la piste, le gain d'entree, le volume de sortie et la latence (module "Globals"),
  puis les remet aux valeurs par defaut (Merge, 0 dB, 0 dB, 10 ms). L'action est executee tout de suite :
  apres "action StopAll", le reader rr est "Ready". "chan" (canaux de la piste) depend du projet (%d).
  Erreurs : r2 : Mute n'est pas un mode (2754) ; r3 : cle inconnue (2753) ; r4 : une action ne se verifie pas (2754).
*/

var r1 = table(data(
    Interstys
    Global  samples Ignore  input -6  output -3.5  latency 20
    Dump Global
    Check Global  samples Ignore  input -6  output -3.5  latency 20
    Line gl  length 1
    Reader rr  line gl  status Reading
    Global  samples Merge  input 0  output 0  latency 10  action StopAll
    Check Global  samples Merge  input 0  output 0  latency 10
    Check Reader rr  status Ready
    Free Reader rr
    Free Line gl
));
var r2 = table(data( Global samples Mute ));
var r3 = table(data( Global speed 1 ));
var r4 = table(data( Check Global action StopAll ));
print(sprintf(0, "Ex-1013. resultats : %d %d %d %d", r1, r2, r3, r4));

// Expected "Global samples Ignore input -6 output -3.5 latency 20 chan %d"
// Expected "Check Global OK"
// Expected "Check Global OK"
// Expected "Check Reader %d OK"
// Expected error 2754
// Expected error 2753
// Expected error 2754
// Expected "Ex-1013. resultats : 0 2754 2753 2754"
