print("Ex-1017. Interstys table : instance a sauver (puis : sauver, recharger le projet, Ex-1018).");

/*
  Cree le modele Sv et son instance s1. Ensuite : sauver le projet, le recharger (ou Reset to factory default puis
  Load), et deposer Ex-1018 : le modele et l'instance doivent avoir ete sauves avec le projet.
  Les numeros dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Algorithm Sv
        input  src
        output dst
        param  time 0.4 0.001 5
        Line l  length 2  chan 1
        Writer w  line l  source src
        Reader r  writer w  delay time  out dst
    End
    Instance s1 Sv  src In:0  dst Out:1  time 0.7
    Dump Instance s1
));
print(sprintf(0, "Ex-1017. resultat : %d", r));

// Expected "Instance s1 Sv src In:0 dst Out:1 time 0.7"
// Expected "Line %d status Ready length 2.000 chan 1 spls %d freq %d"
// Expected "Writer %d status %s line %d source In:0 gain 0 overdub 0 mode XFade first 0 used 0"
// Expected "Reader %d status %s writer %d delay 0.7 speed 1 out Out:1 vol 0 first 0 used %d loop %s"
// Expected "Ex-1017. resultat : 0"
