print("Ex-1022. Interstys table : le nombre de canaux de sortie d'un reader (outchan).");

/*
  outchan est montre par le Dump seulement s'il n'est pas nul (0 : le nombre de canaux utilises).
  Un nombre hors de [0, 128] est refuse (2754).
  Les numeros des modules dependent du projet (%d).
*/

var r = table(data(
    Interstys
    Line lo  length 1  chan 2
    Reader lo2  line lo  used 2  loop loop  outchan 4  status Paused
    Dump Reader lo2
    Check Reader lo2  used 2  outchan 4
    Reader lo2  outchan 0
    Check Reader lo2  outchan 0
    Free Reader lo2
    Free Line lo
));
print(sprintf(0, "Ex-1022. resultat : %d", r));

var e = table(data(
    Interstys
    Reader 250  outchan 200
));
print(sprintf(0, "Ex-1022. outchan 200 : %d", e));

// Expected "Reader %d status Paused line %d speed 1 out Out:0 vol 0 first 0 used 2 loop loop outchan 4"
// Expected "Check Reader %d OK"
// Expected "Check Reader %d OK"
// Expected "Ex-1022. resultat : 0"
// Expected error 2754
// Expected "Ex-1022. outchan 200 : 2754"
