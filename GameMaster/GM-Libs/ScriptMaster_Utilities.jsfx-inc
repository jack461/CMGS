@init


function mSL_Dbg_Memory_Updt(membox)
(
    (membox[14] & 0x100) ? (
        membox[9] = membox[8] = membox[7] = 0;
    );
);


// (the keys : see mSL_ui_LibJJ, Keyboard)

// Update a big number passed as parameter
// with "key" being the "command"
function updtBNumber(num, key, alt)
local (cq, cx, flu, flk, kuz, zplm)
(
    zplm = num;
    flu = 0; kuz = 1; cq = 1; flk = key > 0;
    key < 0 ? key = -key;
    ((key >= '0') && (key <= '9')) ? (
        num = num * 10 + key - '0';
    ) :
    ((key === '%')||(key === 'z')) ? (
        num = 0;
    ) :
    ((key === '+')||(key === '=')) ? (
        num = num + 8;
    ) :
    ((key === ':')||(key === '/')) ? (
        num = num - 8;
    ) :
    ((key === ';')||(key === '.')) ? (
        num = num + 1;
    ) :
    ((key === ',')||(key === '?')) ? (
        num = num - 1; cq = -1; flu = 1;
    ) :
    ((key === '$')) ? (
        num = alt;
    ) :
    ((key === 0)||(key === 1)) ? (
        flu = 1; // just "normalize" the value
        cq = (key === 0) ? 1 : -1;
    ) :
    (ui_jmouse_cap === 0) ? (
        ((key === 'n')||(key === 'p')||(key === 'b')||(key === 'rght')||(key === 'left')) ? (
            cq = ((key === 'n')||(key === 'rght')) ? 1 : -1;
            num = num + cq;
        ) :
        ((key === 'down')) ? (
            num = num + 32;
        ) :
        ((key === 'up')) ? (
            num = max(0, num - 32);
        ) :
        ((key === 'pgdn')) ? (
            num = num + 256;
        ) :
        ((key === 'pgup')) ? (
            num = max(0, num - 256);
        ) :
        ((key === 'home')) ? (
            num = 0;
        ) :
        (
            kuz = 0; // key has not been used
        );
    ) : (
        kuz = 0; // key has not been used
    );
    (flk && kuz) ? GM_key_take(key); // the key has been used (a negative key is not a typed key)

    num;
);

