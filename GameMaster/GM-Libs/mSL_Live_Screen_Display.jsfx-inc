/*
    mSL_Live_Screen_Display : "Live" screen (part 2) - see mSL_Live_Screen.jsfx-inc
    display_boxes() draws the HP set boxes only if the preprocessor variable live_screen_hpset = 1 was set
    before including this file (then mSL_Draw_HPSet.jsfx-inc must be included before).
*/

<? live_screen_in_gfx ? _suppress=1; ?>
@init
<? _suppress=0; ?>

/*
    Show all active boxes
*/
function display_boxes()
local (bpx, bpy, box, bxn, flact, flags, bty, d, h, bh, w, bpw, bph, i, j, m, p, q, r, s, mr, pr, abxfree, abxerr, knd4, knd7, knd5, knd1, knd2, knd0, knd3, knd6, abxl, abxz, abxg)
(
    abxfree = 0;
    abxerr = -1;
    abxdbcount += 1; // activity indicator


    // Should we show used memory ?
    (show_used) ? (
        j = 0; loop(win_cols - 1,
            i = 0; loop(win_lines,
                p = j + win_cols * i;
                (dispalloc_a[p] != 0) ? (
                    // mark current square
                    ((i + j) & 1) ? (gfx_r = gfx_g = gfx_b = 0;) : (gfx_r = gfx_g = gfx_b = 1;);
                    gfx_x = win_Xfr + j * sqr_w;
                    gfx_y = win_Yfr + i * sqr_h;
                    gfx_rect(gfx_x, gfx_y, floor(sqr_w/3), 2);
                );
                i += 1;
            );
            j += 1;
        );
    );


    bxn = 1; // start box numbering at "1"
    box = dispboxes;
    loop (dispboxcount,
        flact = box[bx_activ];
        flags = box[bx_posflgs];
        bty = box[bx_type];

        (flact & bx__used) ? (


            (bty === bx_ty_msg) ? (
                // Box is a message type. Can be directly displayed here




                // Do we need to update the box first ?
                (flact & bx__update) ? (
                    box[bx_cnt] += 1;
                    box[bx_crdate] = timec; // create/reposit. date
                    // gfx_setfont(box[bx_fontx], box[bx_fontn], box[bx_fontsiz]);
                    // Lets mesure string1
                    gfx_setfont(box[bx_font1], box[bx_fname1], box[bx_fsize1], box[bx_fmods1]);
                    gfx_measurestr(box[bx_string1],gl_w1,gl_h1); // this sets gl_w1 and gl_h1 which MUST be global variables
                    // Is there an extra string ?
                    (flact & bx__2strings) ? (
                        gfx_setfont(box[bx_font2], box[bx_fname2], box[bx_fsize2], box[bx_fmods2]);
                        gfx_measurestr(box[bx_string2],gl_w2,gl_h2); // set gl_w2 and gl_h2
                        w = max(gl_w1, gl_w2); // min. width
                        h = gl_h1 + gl_h2 + box[bx_interl]; // min. height
                    ) : (
                        w = gl_w1;
                        h = gl_h1;
                    );
                    // Compute the needed size as boxes
                    w = max(box[bx_minw], w + box[bx_extraw]); // pixels
                    h = max(box[bx_minh], h + box[bx_extrah]); // pixels
                    box[bx_sqw] = bpw = max(box[bx_sqw], ceil(w/sqr_w));
                    box[bx_sqh] = bph = max(box[bx_sqh], ceil(h/sqr_h));
                    p = -1;
                    // Could we already have what we need ?
                    ((flact & bx__posfound) && ((box[bx_posit]) >= 0)) ? (
                        m = (bxn << bx__shiftn) | (bph << bx__shifth) | bpw; // what we expect
                        q = uim_utl(s = box[bx_posit]);
                        r = dispalloc_a[q];
                        ((box[bx_needw] === bpw) && (box[bx_needh] === bph) && (r === m)) ? (
                            p = s; // ok. we keep it
                        ) : (
                            // free it first
                            uim_trc3 ? (
                                sprintf(#wxz, "  --+ free [%d:%d] => %06X (%08X : %08X)", bxn, box, q, r, m);
                                mSL_log(SysLogBox, #wxz);
                            );
                            box[bx_activ] = flact;
                            uim_free((box[bx_posit]), box);
                            flact = box[bx_activ];
                            box[bx_posit] = -5;
                            flact &= 0x7FFFFFFF - bx__posfound - bx__drawready;
                        );
                    );
                    (p < 0) ? (
                        box[bx_activ] = flact;
                        p = uim_alloc(bpw, bph, flags & bx__allocmod, bxn);
                        flact = box[bx_activ];
                        AAAAALCSTATUS_3 += 1; // reallocating
                        AAAAALCSTATUS_1 = box;
                        uim_trc3 ? (
                            sprintf(#wxz, "  --+ alloc [%d:%d < %07X/%07X]  => %06X / %08X", bxn, box, flact, flags,
                                p, dispalloc_a[uim_utl(box[bx_posit])]);
                            mSL_log(SysLogBox, #wxz);
                        );
                    );
                    (p >= 0) ? (
                        // a position is found at "p"
                        box[bx_posit] = p;
                        box[bx_bgidt] = dispalloc_a[box[bx_lposit] = uim_utl(p)];
                        box[bx_needw] = bpw;
                        box[bx_needh] = bph;
                        box[bx_sqx] = bpx = p & bx__maskw;
                        box[bx_sqy] = bpy = p >> bx__shifth;
                        // Save init position for later time
                        ((box[bx_initx] < 0) || (box[bx_inity] < 0)) ? (
                            box[bx_initx] = bpx; box[bx_inity] = bpy;
                        );
                        // compute the rounding box
                        box[bx_xpos] = bpx * sqr_w;
                        box[bx_ypos] = bpy * sqr_h;
                        box[bx_right] = box[bx_xpos] + bpw * sqr_w;
                        box[bx_bottom] = box[bx_ypos] + (bh = bph * sqr_h);
                        // Compute the position where to draw the strings
                        (flact & bx__2strings) ? (
                            d = floor((bh - gl_h1 - gl_h2) / 2); // avail. addit. height
                            box[bx_ypos1] = box[bx_ypos] + d; // start point to draw
                            box[bx_bott1] = box[bx_ypos1] + gl_h1;
                            box[bx_ypos2] = box[bx_bott1];
                            box[bx_bott2] = box[bx_ypos2] + gl_h2 ; // should equal box[bx_bottom]
                        ) : (
                            // only draw str1 - uses full height
                            box[bx_ypos1] = box[bx_ypos];
                            box[bx_bott1] = box[bx_bottom];
                        );
                        // keep initial size of the box
                        (box[bx_initw] <= 0) ?  box[bx_initw] = bpw;
                        (box[bx_inith] <= 0) ?  box[bx_inith] = bph;
                        flact &= 0x7FFFFFFF - bx__update;
                        flact |= bx__drawready | bx__posfound; // ready to draw the strings
                    ) : (
                        // unable to construct the box. wait a while and Release it
                        flact &= 0x7FFFFFFF - bx__drawready - bx__posfound;
                        flact |= bx__poserr;
                    );

                );



                (flact & bx__drawready) ? (
                    // Should we do a special "recall" of the box ?
                    ((flact & bx__fading) && (flact & (bx__drawhfrbox | bx__select | bx___keep))) ? (
                        // need to reactivate the box
                        box[bx_activ] = flact;
                        box_recall(box, bx__drawhfrbox, 0);
                        flact = box[bx_activ];
                    );
                    // Is there a full frame around the box ?
                    (flact & bx__select) ? (
                        draw_around_box(box[bx_xpos], box[bx_ypos], box[bx_sqw]*sqr_w, box[bx_sqh]*sqr_h, 0x2F);
                    ) :
                    (((flact & bx__boxaround) && (timez < box[bx_crdate] + uiBoxDuration)) || (flact & bx__drawhfrbox)) ? (
                        draw_around_box(box[bx_xpos], box[bx_ypos], box[bx_sqw]*sqr_w, box[bx_sqh]*sqr_h, 0x26);
                    );
                    gfx_a = 1;
                    // Display the box with the appropriate color
                    // First, display str1
                    gfx_setfont(box[bx_font1], box[bx_fname1], box[bx_fsize1], box[bx_fmods1]);
                    ((flact & bx__col1std) && (!(flact & bx__fading))) ? (
                        gfx_r = gfxstdr; gfx_g = gfxstdg; gfx_b = gfxstdb;
                    ) : (
                        gfx_r = box[bx_red1] / 255;
                        gfx_g = box[bx_green1] / 255;
                        gfx_b = box[bx_blue1] / 255;
                    );
                    // Show box as locked ?
                    (flact & bx__permlock) ? (
                        r = ceil(sqr_w / 5);
                        gfx_circle(win_Xfr + box[bx_xpos] + r, win_Yfr + box[bx_ypos] + r, r, 1, 1);
                    );
                    // Show box as permanent ?
                    (flact & bx__keepVisible) ? (
                        // show a triangle
                        gfx_triangle(win_Xfr + box[bx_xpos], win_Yfr + box[bx_bottom],
                            win_Xfr + box[bx_xpos] + 0.5 * sqr_w, win_Yfr + box[bx_bottom],
                            win_Xfr + box[bx_xpos], win_Yfr + box[bx_bottom] - 0.5 * sqr_h);
                    );
                    gfx_x = win_Xfr + box[bx_xpos];
                    gfx_y = win_Yfr + box[bx_ypos1];
                    gfx_drawstr(box[bx_string1], 0x5, win_Xfr + box[bx_right], win_Yfr + box[bx_bott1]);
                    // Should we display str2 ?
                    (flact & bx__2strings) ? (
                        gfx_setfont(box[bx_font2], box[bx_fname2], box[bx_fsize2], box[bx_fmods2]);
                        ((flact & bx__col2std) && (!(flact & bx__fading))) ? (
                            gfx_r = gfxstdr; gfx_g = gfxstdg; gfx_b = gfxstdb;
                        ) : (
                            gfx_r = box[bx_red2] / 255;
                            gfx_g = box[bx_green2] / 255;
                            gfx_b = box[bx_blue2] / 255;
                        );
                        gfx_a = 1;
                        gfx_x = win_Xfr + box[bx_xpos];
                        gfx_y = win_Yfr + box[bx_ypos2];
                        gfx_drawstr(box[bx_string2], 0x5, win_Xfr + box[bx_right], win_Yfr + box[bx_bott2]);
                    );
                    ((timez > box[bx_endshow]) && (box[bx_endshow] > 0) && (!(flact & (bx___keep | bx__drawhfrbox | bx__fading)))) ? (
                        (flact & bx__col1std) ? (
                            // Recreate (once) local colors from standard ones
                            box[bx_red1] = floor(0.5 + gfxstdr * 255);
                            box[bx_green1] = floor(0.5 + gfxstdg * 255);
                            box[bx_blue1] = floor(0.5 + gfxstdb * 255);
                            knd4 = timez;
                            knd7 = box[bx_endshow];
                        );
                        (flact & bx__2strings) ? (
                            (flact & bx__col2std) ? (
                                // Recreate (once) local colors from standard ones
                                box[bx_red2] = floor(0.5 + gfxstdr * 255);
                                box[bx_green2] = floor(0.5 + gfxstdg * 255);
                                box[bx_blue2] = floor(0.5 + gfxstdb * 255);
                                knd5 = timez;
                            );
                        );
                        flact |= bx__fading;
                    );
                    flact &= 0x7FFFFFFF - bx__drawhfrbox; // reset temporary draw indicator
                );



                (flact & bx__fading) ? (
                    // start fading the colors 1 out
                    (box[bx_timefd] < timez) ? (
                        box[bx_timefd] = timez + bxFadeDelta;
                        box[bx_red1] > gxcred ? box[bx_red1] = max(gxcred, box[bx_red1] - 1);
                        box[bx_red1] < gxcred ? box[bx_red1] = min(gxcred, box[bx_red1] + 1);
                        box[bx_green1] > gxcgreen ? box[bx_green1] = max(gxcgreen, box[bx_green1] - 1);
                        box[bx_green1] < gxcgreen ? box[bx_green1] = min(gxcgreen, box[bx_green1] + 1);
                        box[bx_blue1] > gxcblue ? box[bx_blue1] = max(gxcblue, box[bx_blue1] - 1);
                        box[bx_blue1] < gxcblue ? box[bx_blue1] = min(gxcblue, box[bx_blue1] + 1);
                        (flact & bx__2strings) ? (
                            // start fading the colors 2 out
                            box[bx_red2] > gxcred ? box[bx_red2] = max(gxcred, box[bx_red2] - 1);
                            box[bx_red2] < gxcred ? box[bx_red2] = min(gxcred, box[bx_red2] + 1);
                            box[bx_green2] > gxcgreen ? box[bx_green2] = max(gxcgreen, box[bx_green2] - 1);
                            box[bx_green2] < gxcgreen ? box[bx_green2] = min(gxcgreen, box[bx_green2] + 1);
                            box[bx_blue2] > gxcblue ? box[bx_blue2] = max(gxcblue, box[bx_blue2] - 1);
                            box[bx_blue2] < gxcblue ? box[bx_blue2] = min(gxcblue, box[bx_blue2] + 1);
                        );
                        // Are we over ?
                        knd1 = (box[bx_red1] === gxcred) && (box[bx_green1] === gxcgreen) && (box[bx_blue1] === gxcblue);
                        knd2 = ((flact & bx__2strings) ? ((box[bx_red2] === gxcred) && (box[bx_green2] === gxcgreen) && (box[bx_blue2] === gxcblue)) : 1);
                        knd0 = knd1 && knd2;
                        knd3 = flact;
                        (knd0) ? (
                            flact |= bx__drawended;
                            flact &= 0x7FFFFFFF - bx__fading - bx__drawready;
                            box[bx_endshow] = knd6 = timec;
                            uim_trc3 ? (
                                sprintf(#wxz, "  -++ Draw end [%d:%d] => %06X", bxn, box, flact); mSL_log(SysLogBox, #wxz);
                            );
                        );
                    );

                );




                (flact & bx__drawended) ? (
                        // we are finished with this box
                    box[bx_trelease] = max(timez + 1, box[bx_trelease]);
                    flact &= 0x7FFFFFFF - bx__used - bx__drawended - bx__drawready - bx__boxaround;
                );




            ) :



            (bty === bx_ty_hpset) ? (
                // The box is the HP displayer
<? live_screen_hpset ? printf("                HP_Draw_Pic(box, bxn);\n") : printf("                0; // no HP set drawing in this plugin\n"); ?>
                // Update returned values
                flact = box[bx_activ];
                flags = box[bx_posflgs];
            ) :



            (bty === bx_ty_err) ? (
                (timez > box[bx_trelease]) ? (
                    // liberate the box
                    flact = 0;
                );
            );


        ) :



        ((flact != 0) && (timez > timeg)) ? (
            // box has flags, but is not active
            // Should we release the mini boxes ?
            (timez > box[bx_trelease]) ? (
                (flact & bx__poserr) ? (
                    // Error found - keep the object as it is
                    box[bx_type] = bx_ty_err; // set a specific error type
                    box[bx_trelease] = max(box[bx_trelease], timez + uiKeepErrBox);
                    box[bx_pname] = box[bx_name];
                    box[bx_name] = 0;
                    flact &= 0x7FFFFFFF - bx__poserr;
                ) :
                (flact & bx__select) ? (
                    box[bx_trelease] = max(box[bx_trelease], timez + uiStdRlease); // keep it while selected
                    flact &= 0x7FFFFFFF - bx__select;
                ) :
                (flact & bx__posfound) ? (
                    uim_trc3 ? (
                        sprintf(#wxz, "  --r free [%d:%d] f=%08X p=%06X", bxn, box, flact, box[bx_posit]);
                        mSL_log(SysLogBox, #wxz);
                    );
                    box[bx_activ] = flact;
                    uim_free(box[bx_posit], box);  // free the graphic space used, keep the box
                    flact = box[bx_activ];
                    flact &= 0x7FFFFFFF - bx__posfound - bx__drawready - bx__permlock;
                    box[bx_trelease] = max(box[bx_trelease], timez + uiStdRlease); // keep it while selected
                ) :
                (flact & bx__keepVisible) ? (
                    box[bx_trelease] = max(box[bx_trelease], timez + uiStdRlease); // will release the block later
                ) : (
                    // Clear the box finally
                    uim_trc3 ? (
                        sprintf(#wxz, "  --r clear box [%d:%d] f=%08X p=%06X", bxn, box, flact, box[bx_posit]);
                        mSL_log(SysLogBox, #wxz);
                    );
                    memset(box, 0, dispboxsize); // clear the box
                    flags = flact = 0; // because it is rewritten in the end
                );
                timeg = timez + 0.01875;
            );
        );


        // Update flags and flact in current box
        box[bx_posflgs] = flags;
        box[bx_activ] = flact;

        (flact === 0) ? (
            (box[bx_check] != 0) ? (
                memset(box, 0, dispboxsize); // clear the box
            );
            abxfree += 1;
        ) : (
            abxl = bxn; // last used box encountered
        );
        box += dispboxsize;
        bxn += 1;
    );


    abxz = timez;
    abxg = timeg;


);


// The "Live" screen : animated background, clock string, display boxes
// (the host performs its own actions before, e.g. Diffusion-3 calls do_live_actions())
function live_screen() local(day, ms, gxi, minut, sec)
(

    (statgraph) ? (

        // Window size modified ?
        (((win_width != gfx_w) || (win_height != gfx_h) || wrefresh) && (win_mod < timec)) ? (
            update_window();

            0 ? (
            sprintf(#uidsp, "%d/%d", gfx_w, gfx_h);
            mk_display_box(0, #uidsp, 2, -1, 20);
            );

        );




        coloriterate ? (

            // Play with the back ground
            (timec % gxdlay === 0) ? (
                // change some coeff.
                gxvrinc = gxvrdec = gxvginc = gxvgdec = gxvbinc = gxvbdec = gxbase;
                gxi = irand(16);
                (gxi === 0) ? (gxvrinc = gxbase + gxeps;)
                :
                (gxi === 1) ? (gxvrdec = gxbase + gxeps;)
                :
                (gxi === 2) ? (gxvginc = gxbase + gxeps;)
                :
                (gxi === 3) ? (gxvgdec = gxbase + gxeps;)
                :
                (gxi === 4) ? (gxvbinc = gxbase + gxeps;)
                :
                (gxi === 5) ? (gxvbdec = gxbase + gxeps;)
                :
                (gxi === 6) ? (gxvrinc = gxbase + gxeps; gxvginc = gxbase + gxeps;)
                :
                (gxi === 7) ? (gxvrdec = gxbase + gxeps; gxvgdec = gxbase + gxeps;)
                :
                (gxi === 8) ? (gxvginc = gxbase + gxeps; gxvbinc = gxbase + gxeps;)
                :
                (gxi === 9) ? (gxvgdec = gxbase + gxeps; gxvbdec = gxbase + gxeps;)
                :
                (gxi === 10) ? (gxvbinc = gxbase + gxeps; gxvrinc = gxbase + gxeps;)
                :
                (gxi === 11) ? (gxvbdec = gxbase + gxeps; gxvrdec = gxbase + gxeps;)
                :
                (gxi === 10) ? (gxvrinc = gxbase + gxeps; gxvginc = gxbase + gxeps; gxvbinc = gxbase + gxeps;)
                :
                (gxi === 11) ? (gxvrdec = gxbase + gxeps; gxvgdec = gxbase + gxeps; gxvbdec = gxbase + gxeps;)
                :
                (gxi === 12) ? (gxvrinc = gxbase + gxeps; gxvgdec = gxbase + gxeps;)
                :
                (gxi === 13) ? (gxvginc = gxbase + gxeps; gxvbdec = gxbase + gxeps;)
                :
                (gxi === 14) ? (gxvbinc = gxbase + gxeps; gxvrdec = gxbase + gxeps;)
                ;
            );

            gxi = irand(7);
            (gxi === 0) ? ( gxcred = floor(gxfred = min(gxmxred, gxfred + gxvrinc)); )
            :
            (gxi === 1) ? ( gxcred = floor(gxfred = max(gxmired, gxfred - gxvrdec)); )
            :
            (gxi === 2) ? ( gxcgreen = floor(gxfgreen = min(gxmxgreen, gxfgreen + gxvginc)); )
            :
            (gxi === 3) ? ( gxcgreen = floor(gxfgreen = max(gxmigreen, gxfgreen - gxvgdec)); )
            :
            (gxi === 4) ? ( gxcblue = floor(gxfblue = min(gxmxblue, gxfblue + gxvbinc)); )
            :
            (gxi === 5) ? ( gxcblue = floor(gxfblue = max(gxmiblue, gxfblue - gxvbdec)); )
            ;

        );


        gfx_clear = gxcred + gxcgreen * 256 + gxcblue * 65536;

        // Every second
        (timec != gxprvctime) ? (
            gxprvctime = timec;


            coloriterate ? (
                // Evaluate the brightness of the background
                gxdkns = ui_bright(gxcred/255, gxcgreen/255, gxcblue/255);
                ((gxtype === 1) && (gxdkns > 0.35)) ? ( // 0.3
                    // switch to dark writing
                    gxtype = 2;
                    gfxstdr = gxwrdkred; gfxstdg = gxwrdkgreen; gfxstdb = gxwrdkblue;
                ) :
                ((gxtype === 2) && (gxdkns < 0.25)) ? ( // 0.1
                    // switch to light writing
                    gxtype = 1;
                    gfxstdr = gxwrlired; gfxstdg = gxwrligreen; gfxstdb = gxwrliblue;
                );

                // Compute a contrast color for the background
                (gxtype === 1) ? (
                    gfx_kred = gfx_kgreen = gfx_kblue = 0;
                ) : (
                    gfx_kred = gfx_kgreen = gfx_kblue = 1;
                );

            );

            stattimer ? (
                day = floor(timec - timet);
                day = (timedir > 0) ? day : max(0, -day);
            ) : (
                day = (timec + dechor * 3600) % 86400;
            );
            hour = floor(day / 3600);
            ms = day % 3600;
            minut = floor(ms / 60);
            sec = ms % 60;
            sprintf(#clockstr, "%02d:%02d:%02d", hour, minut, sec);

            coloriterate &= (gxcolor1 != gxcolor2);
        );


        // Every X minutes, display UI frame size
        /*
        (uifdisp < timez) ? (
            sprintf(#uidsp, "%d/%d", gfx_w, gfx_h);
            mk_display_box(0, #uidsp, 2, -1, 600);
            uifdisp = timez + 10;
        );
        */


        display_boxes(); // Show dialog boxes



    ) : (
        (statgraph != prevgraph) ? (
            gfx_clear = gxcred + gxcgreen * 256 + gxcblue * 65536;
            /*
            gfx_a = 1;
            gfx_r = gxcred / 255;
            gfx_g = gxcgreen / 255;
            gfx_b = gxcblue / 255;
            gfx_x = gfx_y = 10;
            gfx_rectto(20,20);
            */
        );
    );

    prevgraph = statgraph;

    ui_XlocDoNow |= 1;

);
