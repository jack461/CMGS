
@init


// The Garbage_Collector code
// We use a conservative one, where anything that looks like a memory bock can be marked "active"...
mSL_GC_BDMG = 0; // Global "block damaged" counter
mSL_GC_Err = 0; // Last GC error (3333 damaged block, 3336 rebuild, 3337 overflow, 3338 bad size in phase 2)
mSL_GC_Ovf = 0; // Set when the hash table or the list of objects overflowed : nothing is freed by this GC

// Enter a "verified" block in the "protect" area
function gc_protect(obj)
local (k, ty, s)
(
    k =  ((obj > mm_lowblocks) && (obj < mm_highblocks) && ((ty = obj[-2]) >= mSL_MKey_min)
        && (ty <= mSL_MKey_max) && ((s = obj[-1]) >= 0) && (s <= mm_sizmem)
        && (s === obj[s]) && (obj[s+1] === (ty ~ mSL_CC_Chksum)));
    k ? (
        mm_rem_mm[mm_rem_in] = obj; mm_rem_in = min(mm_rem_siz - 1, mm_rem_in + 1);
    );
    k;
);


// Check if some object is in the hash table
//        flg & 1 : put the object in the list
//        flg & 2 : already checked the object is a valid block
function gc_check(obj, flg)
local (ent, cnt, k, ty, s)
(
    ((flg & 2) || // (obj > mm_lowblocks) && // this condition is always tested before calling gc_check
    ((obj < mm_highblocks) // no address less than that can be an object
    && ((s = obj[-1]) >= 0) && (s <= mm_sizmem) && (s === obj[s])
    && ((ty = obj[-2]) >= mSL_MKey_min) && (ty <= mSL_MKey_max)
    && (obj[s+1] === (ty ~ mSL_CC_Chksum)))) ?
    (
        cnt = mm_hash_siz;
        ent = obj % mm_hash_siz;
        while (((k = mm_hash_mm[ent]) != 0) && (cnt > 0)) (
            (k === obj) ? cnt = -1;
            ent = (ent + 191) % mm_hash_siz;
            cnt -= 1;
        );
        (k === 0) ? (
            // enter the object at this location
            mm_hash_mm[ent] = obj;
            (flg & 1) ? (
                // and in the list - keep at least one empty slot, it ends the list
                (mm_list_cnt >= mm_list_siz - 1) ? (
                    mSL_GC_Ovf = 1; // the object won't be examined
                ) : (
                    mm_list_mm[mm_list_in] = obj;  mm_list_in = (mm_list_in + 1) % mm_list_siz;
                    ((mm_list_cnt += 1) > mm_list_mxc) ? mm_list_mxc =  mm_list_cnt;
                );
                (FlagsTbVals[Flgs_GC] & 32) ? (
                    sprintf(#ms, "* Enter: %d", obj);
                    mSL_log(SysLogBox, #ms);
                );
            );
        ) : (cnt === 0) ? (
            mSL_GC_Ovf = 1; // hash table full : the object can't be marked
        );
    );
);


// Mark an object when it is first encountered
function gc_mark(obj)
local (xo, ty, s, s2, pt, cnt, p, pl, pty)
(
    ((obj > mm_lowblocks) && (obj < mm_highblocks)) ? (
        gc_check(obj, 1); // will put the object in the mm_list_mm if necessary
    );
    while ((xo = mm_list_mm[mm_list_pt]) != 0) (
        mm_list_mm[mm_list_pt] = 0; mm_list_pt = (mm_list_pt + 1) % mm_list_siz; mm_list_cnt -= 1;
        // Is the object a valid bloc ?
        ty = xo[-2]; s = xo[-1];
        (FlagsTbVals[Flgs_GC] & 16) ? (
            sprintf(#ms, "* Study: %d  ty:%s", xo, mSL_edit_value(#AA0, ty));
            mSL_log(SysLogBox, #ms);
        );
        ((ty >= mSL_MKey_min) && (ty <= mSL_MKey_max) && (s >= 0) && (s <= mm_sizmem)) ? (
            s2 = xo[s];
            ((s === s2) && (xo[s+1] === (ty ~ mSL_CC_Chksum))) ? (
                (FlagsTbVals[Flgs_GC] & 8) ? (
                    sprintf(#ms, "* A block: %d  ty:%s", xo, mSL_edit_value(#AA0, ty)) ;
                    mSL_log(SysLogBox, #ms);
                );
                // The object is a valid block. Is this furthermore a dynamic bloc ?
                ((xo >= mm_lowmem) && (xo < mm_highmem)) ? (
                    // we "mark" the object by inverting its final length
                    xo[s] = min(-1, -s); // return a "-1" for blocks of size "0"
                    (FlagsTbVals[Flgs_GC] & 4) ? (
                        sprintf(#ms, "* Mark @:%d ty:%s sz:%d", xo, mSL_edit_value(#AA0, ty), s);
                        mSL_log(SysLogBox, #ms);
                    );
                );
                // is the object a "memory consistant" object - namely, that may content other blocks ?
                pt = xo; cnt = s;
                while (cnt > 0) (
                    p = pt[0];
                    (p == floor(p)) ? (
                        ((p > mm_lowblocks) && (p < mm_highblocks) && ((pl = p[-1]) >= 0)
                            && (pl <= mm_sizmem) && ((pty = p[-2]) >= mSL_MKey_min)
                            && (pty <= mSL_MKey_max) && (pl === p[pl]) && (p[pl+1] === (pty ~ mSL_CC_Chksum))) ? (
                                // Mark this one too...
                                gc_check(p, 3);
                        ) :
                        ((p >= mSL_Str_First) && (p <= mSL_Str_Last) /*&& ((mSL_Str_Use[pl = p - mSL_Str_First] & 0xf) != 0)*/) ? (
                            // might be a dynamic string
                            pl = p - mSL_Str_First;
                            mSL_Str_Use[pl] |= mSL_Str_Flg_marked;
                            // sprintf(#wst, "* Mark string %d @ %d", p, pl); mSL_log(SysLogBox, #wst);
                        );
                    );
                    pt += 1; cnt -= 1;
                );

            );
        );
    );
);




function gc_start()
local (i, obj, ptr)
(
    gc_run_count += 1;
    (mm_total_siz < mm_rem_siz) ? mm_total_siz = mm_rem_siz;
    mSL_Dyn_ReClean(); // clean recycle bin
    memset(mm_hash_mm, 0, mm_hash_siz); // very large hash table for objects
    memset(mm_list_mm, 0, mm_list_siz); // large circular list of objects to examine
    memset(mm_tmp_mm, 0, mm_tmp_siz); // small list of objects to free
    mm_tmp_in = mm_list_pt = mm_list_in = mm_list_cnt = 0;
    mSL_GC_Err = mSL_GC_Ovf = 0;
    // Decide the empty tables are already known and do not need any further processing
    // Also objects we DO NOT WISH to process...
    gc_check(mSL_current_memory, 0); // it won't be processed
    // Enter all the "protected" objects
    i = 0; loop(mm_total_siz,
        obj = mm_rem_mm[i]; i+= 1;
        ((obj > mm_lowblocks) && (obj < mm_highblocks)) ? gc_mark(obj);
    );
    // Enter the "temporary" protected objects
    ptr = mSL_current_memory + mSL_current_memory[mSL_MM_TPBuff];
    i = 0; loop(mSL_MM_TPBSize, gc_mark(ptr[i]); i += 1;);
);


/*
    Mark the objects referenced by a scheduler entry, and its message queue
*/
function gc_mark_entry(ent)
local (mss, msq, smg)
(
    gc_mark(SchedThrdPt[ent]);
    gc_mark(SchedPar1[ent]);
    gc_mark(SchedPar2[ent]); // potentially a message
    gc_mark(SchedPar3[ent]);
    gc_mark(SchedPar4[ent]);
    gc_mark(SchedPar5[ent]);
    gc_mark(SchedPar6[ent]);
    msq = ent+SchedHQB; smg = 0; // internal message queue
    mss = SchedPrvEnt[msq[SchedOtherEnd]]; // start at tail, as in SchedListSize
    while ((mss != msq) && (mss >= SchedFirstEnt) && (smg <= SchedNEmax)) (
        gc_mark(mss); // mark it
        smg += 1; mss = SchedPrvEnt[mss];
    );
);


/*
    Mark every mSL process in a process list
*/
function gc_mark_list(lblk)
local (ent, siz)
(
    ent = SchedPrvEnt[lblk[SchedOtherEnd]]; // start at tail
    siz = 0;
    while ((ent != lblk) && (siz <= SchedNEmax)) (
        // should we "mark" this one ?
        (FlagsTbVals[Flgs_GC] & 1) ? (
            sprintf(#ms, "Sched mark: %d [%d %d %d]", ent, SchedStatus[ent], SchedThrdPt[ent], SchedPar1[ent]);
            mSL_log(SysLogBox, #ms);
        );
        gc_mark_entry(ent);
        ent = SchedPrvEnt[ent];
        siz += 1;
    );
);


// Mark a string (if it is a dynamic one), so that the sweep keeps it
function gc_mark_string(p)
(
    ((mSL_Str_Use !== 0) && (p >= mSL_Str_First) && (p <= mSL_Str_Last)) ? (
        mSL_Str_Use[p - mSL_Str_First] |= mSL_Str_Flg_marked;
    );
);

function gc_mark_active()
local (i)
(

    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark Protected."); );
    gc_mark(mSL_GC_Protected);
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark User Defined Objects"); );
    gc_mark(mm_usr_prot);
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark ActivPts."); );
    gc_mark_list(SchedActivPts);
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark InActivPts."); );
    gc_mark_list(SchedInactPts);
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark DlydPts."); );
    gc_mark_list(SchedDlydPts);
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark EvntPts."); );
    gc_mark_list(SchedEvntPts);
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark SuspPts."); );
    gc_mark_list(SchedSuspPts);
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark LockdPts."); );
    gc_mark_list(SchedLockdPts);
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark RcyclPts."); );
    // Better to release all the unused messages. Do this just by reinitializing the SchedRcyclPts list
    SchedInitHQB(SchedRcyclPts, 'Rcyc');
    (FlagsTbVals[Flgs_GC] & 1) ? ( mSL_log(SysLogBox, "Mark Curr_entry."); );
    (mSL_dispatch_entry > 0) ? (
        ((SchedStatus[mSL_dispatch_entry] & SchmSLThrUsed) != SchmSLThrUsed) ? (
            sprintf(#ms, "!!Active thread mark: %d",  SchedStatus[mSL_dispatch_entry]);
            mSL_log(SysLogBox, #ms);
        );
        gc_mark_entry(mSL_dispatch_entry); // the whole message queue, as for the other threads
        mSL_Thread_mark = mSL_dispatch_entry;
    );
    // The names of the files waiting for compilation (dropped files : temporary strings),
    // and of the file being compiled (used again at the end of the compilation)
    (uuuMslTabs > 0) ? (
        i = 0;
        loop(uuuMslTSiz, gc_mark_string(uuuMslTabs[i]); i += 1; );
    );
    gc_mark_string(uuuMslFname);

);





function gc_release_unused_thread()
local (ent)
(
    while (SchedListNonEmpty(SchedInactPts)) (
        // get head
        ent = SchedDetachHead(SchedInactPts);
        // release thread stucture - they will be gc'd later
        SchedStatus[ent] = 0;
        SchedThrdPt[ent] = 0;
        SchedPid[ent] &= SchedNMask;
        // enter in free list
        SchedInsertTail(SchedFreePts, ent, SchETypeThrd);
    );
);






function mem_wk_signal(msg)
(
    sprintf(#ms, "GC Err: %s @ %d", msg, mm_mpt);
    mSL_log(SysLogBox, #ms);
    mm_wk_errC += 1;
);

function gc_run(p)
(
    gc_run_phaz = 1;
    FlagsTbVals[Flgs_GC] = p;
    atomic_add(mSL_Lock,1);
    atomic_add(mSL_loc_tim,mSL_loc_tadd);
);


function gc_sweep()
local (mpt, lwd, ty, s, s2, ub, xty, fl, k, mm_show_chflr)
(
    mm_show_ttf = 0; // total free
    mm_show_ttu = 0;  // total used
    mm_show_frbl = 0;  // free blocks
    mm_show_usbl = 0;  // used blocks
    mm_show_dmgb = 0;  // damaged blocks
    mm_show_rpdb = 0;  // repaired damaged blocks
    mm_show_flr = 0;  // fillers blocks
    mm_show_chflr = 0;  // change to fillers blocks
    fl = 0;
    mpt = mSL_new_memory+mSL_MM_1BKey; // Point to the 1st block in memory.
    lwd = mm_highmem;
    mSL_GC_Ovf ? (
        // Some objects could not be marked : free nothing, just unmark
        mSL_GC_Err = 3337;
        sprintf(#ms, "Sweep: GC tables overflow %d - nothing freed (list max %d / %d)", mSL_GC_Err, mm_list_mxc, mm_list_siz);
        mSL_log(SysLogBox, #ms);
    );

    0 ? (
    sprintf(#ms, "Sweep Phase 1 Start - Err= %d Mem=%d/%d Mpt=%d", mSL_GC_Err, mSL_current_memory, mSL_new_memory, mpt);
    mSL_log(SysLogBox, #ms);
    );

    while (mpt < lwd) (
        ty = mpt[0]; s= mpt[1];

        (ty != floor(ty)) ? (
            mem_wk_signal("Block Type not integer - Change to filler.");
            mpt[0] = mSL_Filler; // don't know what to do
            mm_show_chflr += 1;
            mpt += 1;
            mSL_GC_BDMG += 1;
        ) :
        (ty === mSL_Filler) ? (
            mpt += 1; // skip to next
            mm_show_ttf += 1;
            mm_show_flr += 1;
        ) :
        (
            s2 = mpt[s+2]; xty = mpt[s+3];
            // Let's check the block
            ((ty >= mSL_MT_FreeSt) && (ty <= mSL_MKey_max) && (s >= 0) && (mpt + s + 4 <= lwd)
            && (xty === (ty ~ mSL_CC_Chksum))
            && ((s === s2) || (s === - s2) || ((s === 0) && (s2 === -1)))) ? (
                // The block is correct (a marked block has a negative tail length). Should it be freed ?
                ((ty === mSL_MT_FreeSt) || (ty === mSL_MT_ToFreeSt)) ? (
                    // Already a free block
                    mm_show_ttf += s; mm_show_frbl += 1;
                    mpt[0] = mSL_MT_ToFreeSt; mpt[s+2] = s; mpt[s+3] = mSL_MT_ToFreeNd; // Change it to "to be freed"
                ) :
                ((s2 >= 0) && !mSL_GC_Ovf) ? (
                    // it must be freed
                    // but we can't free it now, since it could be merged with the next block,
                    // and we would be loosing track of this one...
                    (FlagsTbVals[Flgs_GC] & 1) ? (
                        sprintf(#ms, "Sweep: Block to Free at (%d) [%s %s ... %s %s]",
                            mpt+2, mSL_edit_value(#SGC1, ty, 0), mSL_edit_value(#SGC2, s, 0),
                            mSL_edit_value(#SGC3, s2, 0), mSL_edit_value(#SGC4, xty, 0));
                        mSL_log(SysLogBox, #ms);
                    );
                    mm_show_ttu += s; mm_show_usbl += 1;
                    mpt[0] = mSL_MT_ToFreeSt; mpt[s+2] = s; mpt[s+3] = mSL_MT_ToFreeNd; // Change it to "to be freed"
                ) : (
                    // else, unmark it
                    mpt[s+2] = s; // reset the correct length in the tail of the block
                    mm_show_ttu += s; mm_show_usbl += 1;
                    (FlagsTbVals[Flgs_GC] & 1) ? (
                        sprintf(#ms, "Sweep: Block Marked at (%d) [%s %s ... %s %s]",
                            mpt+2, mSL_edit_value(#SGC1, ty, 0), mSL_edit_value(#SGC2, s, 0),
                            mSL_edit_value(#SGC3, s2, 0), mSL_edit_value(#SGC4, xty, 0));
                        mSL_log(SysLogBox, #ms);
                    );
                );
                mpt += s + 4; // skip to next block
            ) : (
                mSL_GC_BDMG += 1;
                mSL_GC_Err = 3333; // GC error
                sprintf(#ms, "Sweep: Damaged Block %d at (%d) [%s %s ... %s %s]",
                    mSL_GC_Err, mpt+2, mSL_edit_value(#SGC1, ty, 0), mSL_edit_value(#SGC2, s, 0),
                    mSL_edit_value(#SGC3, s2, 0), mSL_edit_value(#SGC4, xty, 0));
                mSL_log(SysLogBox, #ms);
                mm_show_dmgb += 1;
                // Can we try to correct it ? Only with a plausible size, otherwise "mpt += s + 4" could loop for ever
                ((s >= 0) && (s === floor(s)) && (mpt + s + 4 <= lwd) && (
                    ((ty >= mSL_MT_FreeSt) && (xty === (ty ~ mSL_CC_Chksum)))
                    ||
                    ((ty === mSL_MT_FreeSt) && (xty === mSL_MT_ToFreeNd))
                    ||
                    ((s > 0) && ((s === s2) || (s === -s2)))
                    ||
                    (ty >= mSL_MT_FreeSt)
                )) ? (
                    // Try to change the type of the block
                    // s seem correct
                    fl = 1;
                ) : (
                    ((ty === 0) && (s === 0))
                ) ? (
                    fl = 2;
                );

                (fl === 1) ? (
                    fl = 0;
                    mSL_GC_Err = 0;
                    mm_show_rpdb += 1;
                    mpt[0] = 'DMGB'; mpt[1] = s; mpt[s+2] = s; mpt[s+3] = (mpt[0] ~ mSL_CC_Chksum);
                    sprintf(#ms, "Sweep: Correcting block type <1> at (%d) [%s %s ... %s %s]", mpt+2,
                        mSL_edit_value(#SGC1, mpt[0], 0),  mSL_edit_value(#SGC2, s, 0),
                        mSL_edit_value(#SGC3, s2, 0), mSL_edit_value(#SGC4, mpt[s+3], 0));
                    mSL_log(SysLogBox, #ms);
                    mpt += s + 4; // skip to next block
                ) :
                (fl === 2) ? (
                    fl = 0;
                    mSL_GC_Err = 0;
                    mm_show_rpdb += 1;
                    k = 0;
                    while ((mpt + k < lwd) && (mpt[k] === 0)) ( k += 1;);
                    (k < 7) ? (
                        sprintf(#ms, "Sweep: Entering <%d> fillers at (%d)", k, mpt);
                        mSL_log(SysLogBox, #ms);
                        memset(mpt, mSL_Filler, k);
                    ) : (
                        mpt[0] = 'DMGB'; mpt[1] = k-4; mpt[k-2] = k-4; mpt[k-1] = (mpt[0] ~ mSL_CC_Chksum);
                        sprintf(#ms, "Sweep: Correcting block type <2> at (%d) [%s %s ... %s %s]", mpt+2,
                            mSL_edit_value(#SGC1, mpt[0], 0),  mSL_edit_value(#SGC2, k-4, 0),
                            mSL_edit_value(#SGC3, mpt[k-2], 0), mSL_edit_value(#SGC4, mpt[k-1], 0));
                        mSL_log(SysLogBox, #ms);
                    );
                    mpt += k;
                ) : (
                    mpt[0] = mSL_Filler;
                    mm_show_chflr += 1;
                    sprintf(#ms, "Sweep: Entering a filler at (%d)", mpt);
                    mSL_log(SysLogBox, #ms);
                    mpt += 1;
                );
            );
        );
    );


    (lwd === mm_highmem) ? (
        // rebuild the structures, keep the contents
        s = mSL_new_memory; mSL_current_memory = mSL_new_memory = 0;
        s2 = mSL_Dyn_Init(s, 0, 0);
        (mSL_new_memory != s) ? (
            mSL_GC_Err = 3336;
        );
    );

    0 ? (
    sprintf(#ms, "Sweep End Phase 1 =>  Mem=%d  Err=%d\nUsbl=%d  Frbl=%d  Used=%d  Filr=%d\nFree=%d  Dmgb=%d  Rpdb=%d  Chfl=%d",
        s2, mSL_GC_Err, mm_show_usbl, mm_show_frbl, mm_show_ttu, mm_show_flr, mm_show_ttf, mm_show_dmgb, mm_show_rpdb,mm_show_chflr);
        mSL_log(SysLogBox, #ms);
    );

    mm_show_ttf = 0; // total free
    mm_show_ttu = 0;  // total used
    mm_show_frbl = 0;  // free blocks
    mm_show_usbl = 0;  // used blocks
    mm_show_dmgb = 0;  // damaged blocks
    mm_show_flr = 0;  // fillers blocks


    mpt = mSL_new_memory+mSL_MM_1BKey; // Point to the 1st block in memory.

    0 ? (
    sprintf(#ms, "Sweep Phase 2 Start - Err= %d Mem=%d/%d Mpt=%d", mSL_GC_Err, mSL_current_memory, mSL_new_memory, mpt);
    mSL_log(SysLogBox, #ms);
    );

    while (mpt < lwd) (
        ty = mpt[0]; s= mpt[1];
        (ty === mSL_Filler) ? (
            mpt += 1; // skip to next
            mm_show_ttf += 1;
            mm_show_flr += 1;
        ) :
        ((s < 0) || (s !== floor(s)) || (mpt + s + 4 > lwd)) ? (
            // Should not happen after phase 1 : don't jump backward, don't free anything more
            mSL_GC_Err = 3338;
            sprintf(#ms, "Sweep: Bad block size %d at (%d) [%s %s]", mSL_GC_Err, mpt+2,
                mSL_edit_value(#SGC1, ty, 0), mSL_edit_value(#SGC2, s, 0));
            mSL_log(SysLogBox, #ms);
            mpt += 1;
        ) :
        (
            s2 = mpt[s+2]; xty = mpt[s+3];
            // Let's check the block
            ((ty === mSL_MT_ToFreeSt) && (s >= 0) && (xty === mSL_MT_ToFreeNd) && (s === s2)) ? (
                // it must be freed
                // but we can't free it now, since it could be merged with the next block,
                // and we would be loosing track of this one...
                ub = mm_tmp_mm[mm_tmp_in]; mm_tmp_mm[mm_tmp_in] = mpt+2; // provide address of the content
                mm_tmp_in = (mm_tmp_in + 1) % mm_tmp_siz;
                (ub != 0) ? (
                    mSL_Dyn_Free(ub);
                    (mSL_errM != 0) ? mSL_GC_Err = mSL_errM; // keep the allocator error
                );
                mm_show_ttf += s; mm_show_frbl += 1;
            ) : (
                // keep the block
                mm_show_ttu += s; mm_show_usbl += 1;
            );
            mpt += s + 4;
        );
    );


    (mSL_GC_Err === 0) ? (
        // free all remaining blocks
        loop (mm_tmp_siz,
            ub = mm_tmp_mm[mm_tmp_in];
            (ub != 0) ? (mSL_Dyn_Free(ub); mm_tmp_mm[mm_tmp_in] = 0; (mSL_errM != 0) ? mSL_GC_Err = mSL_errM; );
            mm_tmp_in = (mm_tmp_in + 1) % mm_tmp_siz;
        );
    );

    0 ? (
    sprintf(#ms, "Sweep End Phase 2 =>  Mem=%d  Err=%d  Usbl=%d  Frbl=%d  Used=%d  Filr=%d  Free=%d  Dmgb=%d",
        mSL_new_memory, mSL_GC_Err, mm_show_usbl, mm_show_frbl, mm_show_ttu, mm_show_flr, mm_show_ttf, mm_show_dmgb);
    mSL_log(SysLogBox, #ms);
    );

    // Report the GC error to the caller (mSL_errM is reset by the caller before the GC)
    mSL_errM = max(mSL_errM, mSL_GC_Err);
);



/*
    After the sweep phase of a GC (call it after gc_sweep) :
    - clear the marks set by gc_mark on the strings (mSL_Str_Flg_marked),
    - age the unmarked temporary strings (temporary -> dispensable -> free),
    - if "recycle", put back in the stack the unmarked strings "in use" (Diffusion-3).
      A string referenced only from a JSFX variable or a static array is never marked :
      "recycle" would reuse it while it is still in use. Nothing is recycled when the GC overflowed.
    The counters mSL_Str_CFree / mSL_Str_CUsed are recomputed.
*/
function mSL_Str_sweep_strings(recycle)
local (i, k, mk, s, used)
(
    (mSL_Str_Use !== 0) ? (
        mSL_GC_Ovf ? recycle = 0;
        used = 0;
        i = 0;
        loop(mSL_Str_Range,
            k = mSL_Str_Use[i];
            mk = k & mSL_Str_Flg_marked;
            k &= 0x7F; // without the mark
            mk ? (
                // referenced : a dispensable string becomes temporary again
                (k === mSL_Str_Flg_dispensable) ? k = mSL_Str_Flg_temporary;
            ) :
            (k === mSL_Str_Flg_temporary) ? (
                k = mSL_Str_Flg_dispensable;
            ) :
            (k === mSL_Str_Flg_dispensable) ? (
                k = 0;
            ) :
            (recycle && ((k === mSL_Str_Flg_inUse) || (k === 0)) && (mSL_Str_Uptr < mSL_Str_Range)) ? (
                // Put it back in the stack
                s = i + mSL_Str_First;
                k = mSL_Str_Flg_inStack;
                mSL_Str_Uptr += 1;
                mSL_Str_Stack[mSL_Str_Uptr] = s;
                strcpy(s, "*RECYCLED*");
                mSL_Str_StGCD += 1;
            );
            ((k > 0) && (k <= 0xF)) ? used += 1;
            mSL_Str_Use[i] = k;
            i += 1;
        );
        mSL_Str_CFree = mSL_Str_Uptr + 1; mSL_Str_CUsed = used;
        (mSL_Str_StInLO > mSL_Str_LOrep) ? (
            sprintf(#ms, "Strings pool exhausted : %d low strings (%d..%d) reused - they may still be in use",
                mSL_Str_StInLO - mSL_Str_LOrep, mSL_Str_TempF, mSL_Str_TempL);
            mSL_log(SysLogBox, #ms);
            mSL_Str_LOrep = mSL_Str_StInLO;
        );
    );
);


mm_mpt = 0;
mm_wk_errC = 0;


function mem_walk(flg)
local (m, lwd, ty, s, s2, xty, ub, dmf, dmgb, chk)
(
    // Check the memory
    dmf = 0;
    m = mSL_new_memory;
    mm_wk_errC = 0;

    mm_mpt = mSL_new_memory+mSL_MM_1BKey; // Point to the 1st block in memory.
    0 ? (
    sprintf(#ms, "Mem walk Start - Err= %d Mem=%d/%d  Mpt=%d", mSL_errM, mSL_current_memory, mSL_new_memory, mm_mpt);
    mSL_log(SysLogBox, #ms);
    );

    chk = (((s = m[-1]) >= 131068) && (m[-2] === mSL_KODE_memory) && (m[s]===s) && (m[s+1] === (mSL_KODE_memory ~ mSL_CC_Chksum))
            && (m[s-1]===mSL_End_Mark) && (m[mSL_MM_LowAd]===(mm_lowmem-mSL_new_memory))
            && (m[mSL_MM_HighAd]===(mm_highmem-mSL_new_memory)) && (m[mSL_MM_MemSiz]===mm_sizmem) && GMW());
    !chk ? (
        (s < 131068) ? (
            sprintf(#ms, "** Hdr Size incorrect %d", s);
            mSL_log(SysLogBox, #ms);
        ) :
        (m[-2] != mSL_KODE_memory) ? (
            sprintf(#ms, "** Hdr Code incorrect %d", m[-2]);
            mSL_log(SysLogBox, #ms);
        ) :
        (m[s]!=s) ? (
            sprintf(#ms, "** Sizes mismatch %d %d", s, m[s]);
            mSL_log(SysLogBox, #ms);
        ) :
        (m[s+1] != (mSL_KODE_memory ~ mSL_CC_Chksum)) ? (
            sprintf(#ms, "** Trl Code incorrect %d", m[s+1]);
            mSL_log(SysLogBox, #ms);
        ) :
        (m[s-1]!=mSL_End_Mark) ? (
            sprintf(#ms, "** Trl Mark incorrect %d", m[s-1]);
            mSL_log(SysLogBox, #ms);
        ) :
        (!GMW()) ? (
            sprintf(#ms, "** Low memory damaged");
            mSL_log(SysLogBox, #ms);
            GMW0("Mem walk check");
            GMI();
        ) : (
            mSL_log(SysLogBox, "** Memory damaged **");
        );

    ) : (

        lwd = mm_highmem;
        mm_show_flr = 0; // filler count
        mm_show_usbl = 0;
        mm_show_dmg = 0;
        mm_show_frbl = 0;
        mm_show_ttf = 0;
        mm_show_ttu = 0;
        mm_bl_huge = 0;
        mm_bl_big = 0;
        mm_bl_large = 0;
        mm_bl_medium = 0;
        mm_bl_mini = 0;
        mm_bl_micro = 0;

        while ((mm_mpt < lwd) && (mm_wk_errC < 16)) (
            ty = mm_mpt[0]; s= mm_mpt[1];
            (ty != floor(ty)) ? (
                mem_wk_signal("Block Type not integer");
                mm_mpt += 1;
            ) :
            (ty === mSL_Filler) ? (
                mm_mpt += 1; // skip to next
                mm_show_flr += 1;
                mm_show_ttf += 1;
            ) :
            (
                // Let's check the block
                xty = mm_mpt[s+3]; s2= mm_mpt[s+2];
                ((ty === mSL_MT_FreeSt) || (ty === mSL_MT_ToFreeSt)) ? (
                    // The block is tagged as "free" (or "to be freed", after an interrupted GC)
                    ((s >= 0) && (s === s2) && (xty === (ty ~ mSL_CC_Chksum))) ? (
                        mm_show_frbl += 1; mm_show_ttf += s; // update total size
                        (s >= 2097152) ? ( mm_bl_huge += 1; ) :
                        (s >= 262144) ? ( mm_bl_big += 1; ) :
                        (s >= 32768) ? ( mm_bl_large += 1; ) :
                        (s >= 4096) ? ( mm_bl_medium += 1; ) :
                        (s >= 512) ? ( mm_bl_mini += 1; ) : mm_bl_micro += 1;
                        (flg & 1) ? (
                            sprintf(#ms, "Free @:%d %d", mm_mpt, s);
                            mSL_log(SysLogBox, #ms);
                        );
                        mm_mpt += s + 4; // skip to next block
                    ) : (
                        (dmf === 0) ? (
                            mm_show_dmg += 1;
                            dmgb = mm_mpt; // keep block address
                            sprintf(#ms, "*Free_Dmg @:%d  [%s %s ... %s %s]", mm_mpt, mSL_edit_value(#SGC1, ty, 0),
                                        mSL_edit_value(#SGC2, s, 0), mSL_edit_value(#SGC3, s2, 0),
                                        mSL_edit_value(#SGC4, xty, 0));
                            mSL_log(SysLogBox, #ms);
                            mm_wk_errC += 1;
                        );
                        dmf = 1; mm_mpt += 1;
                    );
                ) :
                ((ty >= mSL_MKey_min) && (ty <= mSL_MKey_max) && (s >= 0) && (mm_mpt[s+3] === (ty ~ mSL_CC_Chksum))
                && ((s === (s2 = mm_mpt[s+2])) || (s === - s2) || ((s === 0) && (s2 === -1)))) ?
                (
                    // Seems to be a correct block
                    mm_show_usbl += 1; mm_show_ttu += s; // update used
                    (flg & 1) ? (
                        sprintf(#ms, "*Block_OK  @:%d  [%s %s ... %s %s]", mm_mpt, mSL_edit_value(#SGC1, ty, 0),
                                    mSL_edit_value(#SGC2, s, 0), mSL_edit_value(#SGC3, s2, 0),
                                    mSL_edit_value(#SGC4, xty, 0));
                        mSL_log(SysLogBox, #ms);
                    );

                    (dmf > 0) ? (
                        // Previous block was damaged - let's correct it
                        // dmgb[dmgs-2] = dmgb[1] = mm_mpt - dmgb - 4;
                        // dmgb[dmgs-1] = (dmgb[0] = 'DMGB') ~ mSL_CC_Chksum;
                        dmf = 0;
                    );
                    mm_mpt += s + 4; // skip to next block
                ) : (
                    (dmf === 0) ? (
                        mm_show_dmg += 1;
                        dmgb = mm_mpt; // keep block address
                        sprintf(#ms, "*Block_Dmg @:%d  [%s %s ... %s %s]", mm_mpt, mSL_edit_value(#SGC1, ty, 0),
                                    mSL_edit_value(#SGC2, s, 0), mSL_edit_value(#SGC3, s2, 0),
                                    mSL_edit_value(#SGC4, xty, 0));
                        mSL_log(SysLogBox, #ms);
                        mm_wk_errC += 1;
                    );
                    dmf = 1; mm_mpt += 1;
                );

            );
        );
        mSL_Dyn_Dispo = mm_show_ttf;
        mm_show_ratio = min(99, (1+mm_show_ttf)/(1+mm_show_ttu));
        (flg & 8) ? (
            // check available memory
            ((mm_show_ratio < mm_show_limit) && (gc_run_phaz === 0)) ? (
                // run a GC
                (mSL_Dyn_Tr & 4) ? ( sprintf(#dbg_trace4, "Ratio free/used: %.4f", ((1+mm_show_ttf)/(1+mm_show_ttu))); );
                gc_run(2);
            );
        );
    );

    0 ? (
        sprintf(#ms, "Mem walk End - Err= %d Mem=%d/%d", mSL_errM, mSL_current_memory, mSL_new_memory);
        mSL_log(SysLogBox, #ms);
    );

);


function mem_show()
(
    sprintf(#ms, "Blocks:  fr:%d  us:%d  fl:%d  dm:%d", mm_show_frbl, mm_show_usbl, mm_show_flr, mm_show_dmg);
    mSL_log(SysLogBox, #ms);
    sprintf(#ms, "Free: %d  %.2f %%", mm_show_ttf, 100 * mm_show_ttf/mm_sizmem);
    mSL_log(SysLogBox, #ms);
    sprintf(#ms, "Used: %d  %.2f %%", mm_show_ttu, 100 * mm_show_ttu/mm_sizmem);
    mSL_log(SysLogBox, #ms);
);


(mSL_StM_FreePt >= fmemmax) ? (
    err_sys_ini = 9988;
);

