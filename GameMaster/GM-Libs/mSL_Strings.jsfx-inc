/*
    A dynamic string allocator

    needs the "mSL_StM_Memory.jsfx-inc" library.

    mSL_Str_Init, mSL_Str_TInit and mSL_Str_PInit all add their strings to the SAME pool :
    "temporary", "in use" and "permanent" are states of a string, not separate pools.
    No string can be obtained before mSL_Str_MkStructs() (the functions return 0).
    gc_mark sets mSL_Str_Flg_marked on the strings it meets; mSL_Str_sweep_strings
    (in mSL_Garbage_Collector) clears these marks after each GC.
*/

@init


mSL_Str_First = 0;
mSL_Str_Last = 0;
mSL_Str_Range = 0;
mSL_Str_Count = 0;
mSL_Str_Use = 0;
mSL_Str_Stack = 0;
mSL_Str_Uptr = 0;
mSL_Str_Aptr = 0;
mSL_Str_CFree = mSL_Str_CUsed = 0;
mSL_Str_Default = #mSL_Str_Default; // provide a default string

// Internal result
mSL_Str_Entry = 0;
mSL_Str_Item = 0;

// Flags
mSL_Str_Flg_dispensable = 1;
mSL_Str_Flg_temporary = 2;
mSL_Str_Flg_inUse = 4;
mSL_Str_Flg_permanent = 8;
mSL_Str_Flg_unavailable = 32;
mSL_Str_Flg_inStack = 64;
mSL_Str_Flg_marked = 128;

// By default, use first strings
mSL_Str_TempC = mSL_Str_TempF = 32; mSL_Str_TempL = 1024;

mSL_Str_Setsx = 0;
mSL_Str_Setsiz = 20; // allows 10 pairs.
mSL_Str_SetPt = 0;

//Statistics
mSL_Str_StGet = 0;
mSL_Str_StTemp = 0;
mSL_Str_StPerm = 0;
mSL_Str_StFree = 0;
mSL_Str_StGCD = 0;
mSL_Str_StInST = 0;
mSL_Str_StInTU = 0;
mSL_Str_StInLO = 0;
mSL_Str_StACycl = 0;
mSL_Str_LOrep = 0; // value of mSL_Str_StInLO at the last report (see mSL_Str_sweep_strings)
// Declare some new strings
function mSL_Str_Provide(first, last)
local (res)
(
    (mSL_Str_Setsx === 0) ? (mSL_Str_Setsx = mSL_StM_Alloc(mSL_Str_Setsiz, 'strx', mSL_StM_FlClear));
    res = mSL_Str_SetPt;
    mSL_Str_Setsx[mSL_Str_SetPt] = first; mSL_Str_Setsx[mSL_Str_SetPt+1] = last;
    mSL_Str_SetPt = (mSL_Str_SetPt + 2) % mSL_Str_Setsiz;
    res;
);

// Build the structures that gather all strings
function mSL_Str_MkStructs()
global(mSL_Str_First, mSL_Str_Last, mSL_Str_Range, mSL_Str_Count, mSL_Str_Use, mSL_Str_Stack, mSL_Str_Flg_unavailable,
    mSL_Str_Setsiz, mSL_Str_Setsx, mSL_StM_FlClear, mSL_Str_Flg_inStack, mSL_Str_Uptr, mSL_Str_CFree, mSL_Str_CUsed)
local (i, j, k, low, hig)
(
    low = 0x10000000; hig = 0;
    i = 0; loop(mSL_Str_Setsiz,
        k = mSL_Str_Setsx[i];
        (k != 0) ? (
            (k < low) ? low = k;
            (k > hig) ? hig = k;
        );
        i += 1;
    );
    mSL_Str_First = low; mSL_Str_Last = hig; mSL_Str_Range = hig-low+1;
    // Get the areas
    mSL_Str_Use = mSL_StM_Alloc(mSL_Str_Range + 1, 'stru', 0);
    memset(mSL_Str_Use, mSL_Str_Flg_unavailable, mSL_Str_Range);
    mSL_Str_Stack = mSL_StM_Alloc(mSL_Str_Range + 1, 'strs', mSL_StM_FlClear);
    // Enter all the strings in the arrays
    mSL_Str_Count = 0;
    i = 0; while (i < mSL_Str_Setsiz) (
        low = mSL_Str_Setsx[i]; hig = mSL_Str_Setsx[i+1];
        ((low != 0) && (hig != 0) && (low <= hig)) ? (
            while (low <= hig) (
                k = low - mSL_Str_First;
                mSL_Str_Use[k] = mSL_Str_Flg_inStack;
                strcpy(low, "");
                mSL_Str_Stack[mSL_Str_Count] = low;
                mSL_Str_Count += 1;
                low += 1;
            );
        );
        i += 2;
    );
    // all the strings are in the stack
    mSL_Str_Uptr = mSL_Str_Count - 1;
    mSL_Str_CFree = mSL_Str_Count; mSL_Str_CUsed = 0;
);

// find, by all means, a free string
function mSL_Str_Int_Get1()
global(mSL_Str_Entry, mSL_Str_Item, mSL_Str_Uptr, mSL_Str_Stack, mSL_Str_Last, mSL_Str_Range, mSL_Str_Aptr, mSL_Str_StACycl,
    mSL_Str_Use, mSL_Str_First, mSL_Str_Flg_inStack, mSL_Str_Flg_inUse, mSL_Str_Flg_dispensable, mSL_Str_Flg_temporary,
    mSL_Str_TempC, mSL_Str_TempL, mSL_Str_TempF, mSL_Str_CUsed, mSL_Str_CFree, mSL_Str_StInST, mSL_Str_StInTU, mSL_Str_StInLO)
local (itm, ent, i, k)
(
    mSL_Str_Entry = mSL_Str_Item = i = 0;
    // Not before mSL_Str_MkStructs : leave mSL_Str_Item at 0, and the passes below are skipped
    (mSL_Str_Use === 0) ? i = mSL_Str_Range;
    // First, look up in the stack (ignore a GC mark : don't lose the string)
    while ((mSL_Str_Item === 0) && (mSL_Str_Uptr >= 0) && (mSL_Str_Use !== 0))  (
        (((itm = mSL_Str_Stack[mSL_Str_Uptr]) >= mSL_Str_First) && (itm <= mSL_Str_Last)
        && ((mSL_Str_Use[ent = itm - mSL_Str_First] & 0x7F) === mSL_Str_Flg_inStack)) ? (
            // use this entry
            mSL_Str_Entry = ent; mSL_Str_Item = itm;
            mSL_Str_CUsed += 1; mSL_Str_CFree -= 1; mSL_Str_StInST += 1;
            // ) : (
            // value in the stack is inappropriate for some reason
        );
        mSL_Str_Stack[mSL_Str_Uptr] = 0;
        mSL_Str_Uptr -= 1;
    );
    // Second, perform a pass inside the uselist
    while ((mSL_Str_Item === 0) && (i < mSL_Str_Range)) (
        k = mSL_Str_Use[mSL_Str_Aptr];
        (k === 0) ? (
            // The entry is available
            mSL_Str_Use[mSL_Str_Aptr] = mSL_Str_Flg_inUse;
            mSL_Str_Item = mSL_Str_Aptr + mSL_Str_First;
            mSL_Str_Entry = mSL_Str_Aptr; mSL_Str_StInTU += 1;
        ) :
        (k === mSL_Str_Flg_dispensable) ? (
            mSL_Str_Use[mSL_Str_Aptr] = 0; // make it free
        ) :
        (k === mSL_Str_Flg_temporary) ? (
            mSL_Str_Use[mSL_Str_Aptr] = mSL_Str_Flg_dispensable; // make it dispensable
        );
        mSL_Str_Aptr += 1;
        (mSL_Str_Aptr >= mSL_Str_Range) ? (mSL_Str_Aptr = 0; mSL_Str_StACycl += 1;);
        i += 0.333;
    );
    ((mSL_Str_Item === 0) && (mSL_Str_Use !== 0)) ? (
        // Last chance allocate a low number string - it may still be in use : reported by mSL_Str_sweep_strings
        (mSL_Str_TempC >= mSL_Str_TempL) ? (mSL_Str_TempC = mSL_Str_TempF) : (mSL_Str_TempC += 1);
        mSL_Str_Item = mSL_Str_TempC;
        mSL_Str_Entry = mSL_Str_Range; mSL_Str_StInLO += 1;
    );
    mSL_Str_Item;
);

function mSL_Str_TInit(first, last)
(
    mSL_Str_Provide(first, last);
);

function mSL_Str_Tmp(val)
global (mSL_Str_Item, mSL_Str_Use, mSL_Str_Entry, mSL_Str_Flg_temporary, mSL_Str_StTemp)
(
    mSL_Str_Int_Get1();
    (mSL_Str_Item != 0) ? (
        mSL_Str_Use[mSL_Str_Entry] = mSL_Str_Flg_temporary;
        val === 0 ? val = "*TEMPORARY*";
        strcpy(mSL_Str_Item, val);
        mSL_Str_StTemp += 1;
    );
    mSL_Str_Item;
);

function mSL_Str_PInit(first, last)
(
    mSL_Str_Provide(first, last);
);

function mSL_Str_Perm()
global(mSL_Str_Item, mSL_Str_Use, mSL_Str_Entry, mSL_Str_Flg_permanent, mSL_Str_StPerm)
(
    mSL_Str_Int_Get1();
    (mSL_Str_Item != 0) ? (
        mSL_Str_Use[mSL_Str_Entry] = mSL_Str_Flg_permanent;
        mSL_Str_StPerm += 1;
    );
    mSL_Str_Item;
);

function mSL_Str_Init(first, last)
(
    mSL_Str_Provide(first, last);
);

function mSL_Str_Alloc(val)
global(mSL_Str_Use, mSL_Str_Entry, mSL_Str_Item, mSL_Str_Flg_inUse, mSL_Str_StGet)
(
    mSL_Str_Int_Get1();
    (mSL_Str_Item != 0) ? (
        mSL_Str_Use[mSL_Str_Entry] = mSL_Str_Flg_inUse;
        val === 0 ? val = "";
        strcpy(mSL_Str_Item, val);
        mSL_Str_StGet += 1;
    );
    mSL_Str_Item;
);

function mSL_Str_Free(str)
global(mSL_Str_First, mSL_Str_Last, mSL_Str_Count, mSL_Str_Use, mSL_Str_Stack, mSL_Str_Flg_inUse, mSL_Str_Flg_dispensable,
    mSL_Str_Flg_inStack, mSL_Str_Flg_temporary, mSL_Str_Uptr, mSL_Str_Default, mSL_Str_CFree, mSL_Str_CUsed,
    mSL_Str_StFree)
local (n, k)
(
    ((mSL_Str_Use !== 0) && (str >= mSL_Str_First) && (str <= mSL_Str_Last)) ? (
        k = mSL_Str_Use[n = str - mSL_Str_First] & 0x7F; // ignore a GC mark
        ((k === mSL_Str_Flg_inUse) || (k === mSL_Str_Flg_dispensable)) ? (
            // return to the stack
            mSL_Str_Use[n] = mSL_Str_Flg_inStack;
            mSL_Str_Uptr +=1;
            mSL_Str_Stack[mSL_Str_Uptr] = str;
            strcpy(str, "");
            mSL_Str_CUsed -= 1; mSL_Str_CFree += 1;
            mSL_Str_StFree += 1;
        ) :
        (k === mSL_Str_Flg_temporary) ? (
            mSL_Str_Use[n] = mSL_Str_Flg_dispensable;
        );
    );
);

function mSL_isString(str)
global(mSL_Str_First, mSL_Str_Last, mSL_Str_Use)
(
    (mSL_Str_Use !== 0) && (str >= mSL_Str_First) && (str <= mSL_Str_Last) && ((mSL_Str_Use[str - mSL_Str_First] & 0xf) !== 0);
);


function mSL_Str_RAlloc(val)
global (mSL_Str_Item, mSL_Str_Use, mSL_Str_Entry, mSL_Str_Flg_permanent, mSL_Str_StPerm)
(
    mSL_Str_Int_Get1();
    (mSL_Str_Item != 0) ? (
        mSL_Str_Use[mSL_Str_Entry] = mSL_Str_Flg_permanent;
        val === 0 ? val = "";
        strcpy(mSL_Str_Item, val);
        mSL_Str_StPerm += 1;
    );
    mSL_Str_Item;
);

