//1+;
function mSL_call_ops(argc, argv)
local(res, kw)
(
    // Decode the parameters - could be integers or keywords
    0 ? (
        sprintf(#s, "*mSL_call_ops[%d]  %18.0f   \"%s\"   \"%s\"    %g",
            argc, argv[0], mSL_edit_value(#s1, argv[0]), mSL_edit_value(#s2, mSL_KW_SensorSize), argv[1]);
        mSL_log(SysLogBox, #s);
    );
    res = Undef;
);




/*
    Call operations = call a JSfX func from mSL
*/
function mSL_players_ops(argc, argv)
local()
(
    Undef;
);// mSL_players_ops



/*
    Play operations = single operation for playing in mSL
*/
function mSL_play_ops(argc, argv)
local ()
(
    Undef;
);


/*
    Gui operations
*/
function mSL_gui_ops(argc, argv)
local ()
(
    Undef;
);


/*
    Events management operations
*/
function mSL_event_ops(argc, argv)
local (res, kw, ent, k, p1, p2, p3)
(
    res = 0;
);


// Insert here the mSL interpreter
<? include("GM-Libs/mSL_Evaluator.jsfx-inc"); ?>


//// All local GC protected blocks


mm_usr_prot_siz = 64;
mm_usr_prot_ptr = 0;
mm_usr_prot = make_array(mm_usr_prot_siz); // A list of USR defined protected objets


mm_usr_prot[mm_usr_prot_ptr] = uuuMslTabs; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = uuuMslCTab; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = memoryBox1; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = memoryBox2; mm_usr_prot_ptr += 1;

mm_usr_prot[mm_usr_prot_ptr] = workmat; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = xmlstack; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = tmpwork; mm_usr_prot_ptr += 1;

mm_usr_prot[mm_usr_prot_ptr] = dispboxes; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = dispalloc_a; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = defaultprojector; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = projlist; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = pcfdef; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = projectors; mm_usr_prot_ptr += 1;


////
mm_usr_prot[mm_usr_prot_ptr] = A_mSL_EXTab; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = A_mSL_PTTab; mm_usr_prot_ptr += 1;
// slot for HP_Positions : a dynamic block only referenced by a global variable (see Diffusion-3-Set-Table)
mm_usr_prot_hpps = mm_usr_prot_ptr; mm_usr_prot[mm_usr_prot_hpps] = 0; mm_usr_prot_ptr += 1;
// slot for xml_Tree when it stays in the global variable (parse error) - see Diffusion-3-XML
mm_usr_prot_xmlt = mm_usr_prot_ptr; mm_usr_prot[mm_usr_prot_xmlt] = 0; mm_usr_prot_ptr += 1;
// GC bounds : roots (mm_usr_prot, StaticWA, paramBlock...) and the dynamic memory must be
// between mm_lowblocks and mm_highblocks, otherwise gc_mark ignores them
mm_highblocks = make_array(2); // no block with memory references beyond that
mm_highblocks[0] = 'High'; mm_highblocks[1] = '_Mem';

TabAddrMax = mSL_StM_FreePt; // max. address recognized for an array
SharedHighMemory = lastmemory = make_array(2); // last use of the function
lastmemory[0] = 'last'; lastmemory[1] = 'stbl';
SharedHighMemorySize = SharedHighMemory - SharedLowMemorySize;

UBuffer = mSL_StM_BlockStart('buff'); // DO NOT use make_array() after that !
M_avail = UTmem - UBuffer - 256; // up to 64 * 2 * 2 zero-valued samples -

current_Memory_Mode = mSL_MMd_Dynamic;  // change allocation mode


// Update a big number passed as parameter
// with "key" being the "command"
function updtBNumber(num, key, alt)
local (cq, cx, flu, flk, kuz, zplm)
(
    zplm = num;
    flu = 0; kuz = 1; cq = 1; flk = key > 0;
    key < 0 ? key = -key;
    ((key >= '0') && (key <= '9')) ? (
        num = num * 10 + key - '0';
    ) :
    ((key === '%')||(key === 'z')) ? (
        num = 0;
    ) :
    ((key === '+')||(key === '=')) ? (
        num = num + 8;
    ) :
    ((key === ':')||(key === '/')) ? (
        num = num - 8;
    ) :
    ((key === ';')||(key === '.')) ? (
        num = num + 1;
    ) :
    ((key === ',')||(key === '?')) ? (
        num = num - 1; cq = -1; flu = 1;
    ) :
    ((key === '$')) ? (
        num = alt;
    ) :
    ((key === 0)||(key === 1)) ? (
        flu = 1; // just "normalize" the value
        cq = (key === 0) ? 1 : -1;
    ) :
    (ui_jmouse_cap === 0) ? (
        ((key === 'n')||(key === 'p')||(key === 'b')||(key === 'rght')||(key === 'left')) ? (
            cq = ((key === 'n')||(key === 'rght')) ? 1 : -1;
            num = num + cq;
        ) :
        ((key === 'down')) ? (
            num = num + 32;
        ) :
        ((key === 'up')) ? (
            num = max(0, num - 32);
        ) :
        ((key === 'pgdn')) ? (
            num = num + 256;
        ) :
        ((key === 'pgup')) ? (
            num = max(0, num - 256);
        ) :
        ((key === 'home')) ? (
            num = 0;
        ) :
        (
            kuz = 0; // key has not been used
        );
    ) : (
        kuz = 0; // key has not been used
    );



    num;
);


