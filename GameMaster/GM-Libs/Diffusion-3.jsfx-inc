function mSL_StM_show()
(
    sprintf(#ms, "Blocks:  cnt:%d  tsiz:%d  min:%d  max:%d", mSL_StM_BCount, mSL_StM_BTSize, mSL_StM_BSzMin, mSL_StM_BSzMax);
    mSL_log(SysLogBox, #ms);
);


function mSL_Str_sweep_strings()
global(mSL_Str_Range, mSL_Str_Use, mSL_Str_Flg_marked, mSL_Str_Flg_dispensable, mSL_Str_Flg_temporary, mSL_Str_First,
    mSL_Str_Flg_inUse, mSL_Str_Flg_inStack, mSL_Str_Uptr, mSL_Str_Stack, mSL_Str_CUsed, mSL_Str_CFree, mSL_Str_StGCD,
    #wxt, SysLogBox)
local (i, k, s)
(
    i = 0;
    loop(mSL_Str_Range,
        k = mSL_Str_Use[i];
        (k & mSL_Str_Flg_marked) ? (
            k &= 0x7FFFFF - mSL_Str_Flg_marked;
            (k === mSL_Str_Flg_dispensable) ? k = mSL_Str_Flg_temporary;
        ) : (
            // Not marked - can be recycled
            (k === mSL_Str_Flg_temporary) ? (
                k = mSL_Str_Flg_dispensable;
            ) :
            (k === mSL_Str_Flg_dispensable) ? (
                k = 0;
            ) :
            ((k === mSL_Str_Flg_inUse) || (k === 0)) ? (
                // Put it back in the stack
                s = i + mSL_Str_First;
                // sprintf(#wxt, "* Recycle %d @ %d", s, i); mSL_log(SysLogBox, #wxt);
                k = mSL_Str_Flg_inStack;
                mSL_Str_Uptr = min(mSL_Str_Range, 1+mSL_Str_Uptr);
                mSL_Str_Stack[mSL_Str_Uptr] = s ;
                strcpy(s, "*RECYCLED*");
                mSL_Str_CUsed -= 1; mSL_Str_CFree += 1;
                mSL_Str_StGCD += 1;
            );
        );
        mSL_Str_Use[i] = k;
        i += 1;
    );

);


// Print a sequence of strings
//   Known as "GM_Log"
function mSL_133(argc, argv)
(
    while (argc > 0) (
        mSL_log(SysLogBox, argv[0]);
        argc -= 1; argv += 1;
    );
);


// This redefines the function "mSL_134" as the product of its operands
//   Known as "prod"
function mSL_134(argc, argv)
local (product, ip)
(
    product = 1;
    ip = 0;
    loop(argc, product *= argv[ip]; ip += 1;);
    product;
);

// External access to some useful data structures
//   Known as "GM_Addr"
function mSL_135(argc, argv)
local (item)
(
    item = argv[0];
    (item == 'padv') ? ( padStPVals; ) :
    (item == 'padf') ? ( padStFlags; ) :
    (item == 'padl') ? ( padStClipsL; ) :
    (item == 'padh') ? ( padStClipsH; ) :
    (item == KodedSchFree) ? (
        SchedFreePts;
    ) :
    (item == KodedSchDlay) ? (
        SchedDlydPts;
    ) :
    (item == KodedSchActv) ? (
        SchedActivPts;
    ) :
    (item == KodedSchInac) ? (
        SchedInactPts;
    ) :
    (item == KodedSchCthr) ? (
        mSL_current_thread;
    ) :
    (item == KodedSchPads) ? (
        SchedPadSet; // A 16 entries array
    ) :
    (
        -1;
    );
);


function mSL_136(argc, argv)
(
    mSL_log(SysLogBox, "mSL_136 -> gc()");
    mSL_malloc_failed |= 1; // will start a GC.
);

function mSL_define_extensions()
(
    mSL_define_opcode("GM_Log", 133); // define 133 as "GM_Log"
    mSL_define_opcode("prod", 134); // define 134 as "prod"
    mSL_define_opcode("GM_Addr", 135); // etc.
    mSL_define_opcode("xxx", 136); // This will start a Garbage Collection
    mSL_define_opcode("D3_config", 138); // The Diffusion 3 configuration
    mSL_define_opcode("print", 133); // define "print" as a synonym of "GM_Log"
);


