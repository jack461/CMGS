// Signal a change somewhere that should reflect in the graphic display
// 1 to 16 is related with the corresponding projector number
// 16 + n is related to slider "n"
function signal_change(obj, par)
local (Err, projnum, ctlblock, ctlname, ctlslid)
(
    projnum = 0;
    (obj<22)?((obj<11)?((obj<5)?((obj<2)?((obj<1)?(
        //===0===//
        Err=0;
        //===0===//
    ):(
        //===1===//
