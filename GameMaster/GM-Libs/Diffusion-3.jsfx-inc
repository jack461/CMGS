        //===30===//
        Err=30;
        //===30===//
    ):((obj<32)?(
        //===31===//
        Err=31;
        //===31===//
    ):(
        //===32===//
        ctlblock = midictrlref[par];
        ctlname = ctlblock[mctlslname];
        ctlslid = ctlblock[mctlslider];
        projnum = currentpro[prx_fident];
        (ctlblock[mctlflags] & ctrlown) ? (
            bxid = (projnum << 8) | ctlslid;
