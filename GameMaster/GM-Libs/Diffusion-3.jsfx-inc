function nowTime()
(
    sprintf(#nowis, "Now: %02d/%02d/%02d ", gmem[timeDay], gmem[timeMonth], gmem[timeYear]);
    edTimeL(gmem[timeSecOfDay]);
    strcat(#nowis, #edt);
);

