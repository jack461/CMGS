// Before reloading a configuration
function clearArea()
local ()
(
    // memset(diffstart, 0, diffend-diffstart);
    // pcfdef : config steréo par defaut, 1 > left / 2 > right
    // All these are actual dynamically allocated memory blocks
    // memset(setlist, 0, settsize); // Clear the set list
    mSL_mfree_all(setlist, settsize);  // Clear the set list
    // memset(conflist, 0, conflsize + 4); // Clear the conflist
    mSL_mfree_all(conflist, conflsize);  //  Clear the conflist
    // memset(proprerefs, 0, proprescnt); // Clear the projectors preset list
    mSL_mfree_all(proprerefs, proprescnt);  // Clear the projectors preset list
    memset(groupdefs, 0, groupdefsize); // Clear the continuum configs
    pcfdef[0] = conflsize-1;
    pcfdef[1] = 1; pcfdef[2] = 1; pcfdef[3] = 1; pcfdef[4] = -1;
    pcfdef[5] = 2; pcfdef[6] = 2; pcfdef[7] = 1; pcfdef[8] = -1;
    pcfdef[9] = -2;
    conflist[conflsize-1] = pcfdef;
    ptconfs = 0;
    memset(historywa, pcfdef, historysiz);
    historypnt = 0; // last recorded number
    // Create [0 1 2 3 .. 127]
    bliostd[0] = freeword; bliostd[1] = -1; bliostd[2] = 0; bliostd[3] = iochsiz;
    iostdch = bliostd + 4;
    sik = 0; loop (iochsiz, iostdch[sik] = sik; sik += 1;);
    iostdch[sik] = endmark;
);
clearArea();

// sin/cos area
sik = 0; sil = 0; inc = ($pi  / 2) / (sincossize - 1);
loop (sincossize, sincos[sik] = sin(sil); sil += inc; sik += 1;);


