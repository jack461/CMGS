// Sizes of Allocated arrays for the Compiler and the Evaluator
C_compSize = 64 * 1024; // size : 64 kW [kilo words, not kilo watts]
C_progSize = 64 * 1024; // size  for the evaluator
ui_jmake_arraymax = 0x7FFFFFF; // "no" limit in the size of an array...

// Then, initialize all structures of the compiler.
C_compArea = make_array(C_compSize);
C_progArea = make_array(C_progSize);


mm_limit_a = make_array(2);
mm_limit_a[0] = 'STRT'; mm_limit_a[1] = 'MEMR';

// Memory size :
C_memrSize = 28 * 1024 * 1024; // size : X x 1MW
C_memrArea = make_array(C_memrSize); // THE DYNAMIC MEMORY !

mm_limit_b = make_array(2);
mm_limit_b[0] = 'END_'; mm_limit_b[1] = 'MEMR';


// Build the dynamic memory
mSL_errX = mSL_errC = 0;
mSL_current_memory = mSL_new_memory = 0; // make sure it is clear
AAAAC_5 = mSL_make_memory(C_memrArea, C_memrSize);

memoryBox1[7] = memoryBox2[7] = AAAAC_5 - 2; // actual start
mm_lowmem = mSL_new_memory + mSL_new_memory[mSL_MM_LowAd];
mm_highmem = mSL_new_memory + mSL_new_memory[mSL_MM_HighAd];
// mm_sizmem = max(1, mm_highmem - mm_lowmem);
mm_show_ttf = mm_sizmem = mSL_new_memory[mSL_MM_MemSiz];//
//AGMW166 = GMW();



mm_limit_f = make_array(2);
mm_limit_f[0] = 'STRT'; mm_limit_f[1] = 'COMP';

void_pointer = make_array(2);
void_pointer[0] = 0;
void_pointer[1] = 0;

// Provide an independent main symbol table for the compiler - "var" declarations
a_prime = 3313;
size = 4 * (a_prime + 1);
mem = make_array(size + 4);
A_mSL_GCTab = mSL_buildGVTab(mem, size, a_prime);


// Provide an independent local symbol table for the compiler - "loc" declarations
a_prime = 191;
size = 4 * (a_prime + 1);
mem = make_array(size + 4);
A_mSL_LCTab = mSL_buildLCTab(mem, size, a_prime);


// Provide a common external symbol table for the compiler - "ext" declarations
A_mSL_EXTab = mSL_buildEXTab(mSL_EXSiz);
// Provide a common external symbol table for the compiler - "ptr" declarations
A_mSL_PTTab = mSL_buildPTTab(mSL_PTSiz);

// Build the compiler
AAAAC_6 = mSL_make_compiler(C_compArea, C_compSize);
// Then, the evaluator
AAAAC_7 = mSL_make_evaluator(C_progArea, C_progSize);
mSL_new_thread = 0;

// define our new extensions
mSL_define_extensions();

mm_limit_g = make_array(2);
mm_limit_g[0] = 'END_'; mm_limit_g[1] = 'COMP';







memstart = mSL_StM_BlockStart('diff');

memadd = memstart + matrsiz; // first used memory address : 16384 + ...?
// A "free" matrix, used in case of "bug"
bugmat = memadd; memadd += matrsiz;

firstmat = memadd;
memadd += matrcnt * matrsiz;
endmatpt = memadd;

memend = memadd; // First word not used
memsize = memend - memstart;

mSL_StM_BlockEnd(memend);

// mm_highblocks : see after the mm_usr_prot list (it must include it)


// PROJECTOR
// indices in a projector
