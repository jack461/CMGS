// Delayed action
function thendo(flgs)
(
    (flgs === 1) ? (
        MIDIshowtime = 0;
    );
);

// Called every block
function MIDI_handle() local (zzuleft)
(
    // Update occasionnaly, or when necessary
    zzupdrefreshUI |= zzrefreshUI;
    (slidersmod != 0) ? (
        zzrefreshUI |= refresh_all;
        slidersmod = 0;
    );

    (timez >= timen) ? (
        // Automatic slow refresh of all zones
        timen = timez + 4; // Every "x" seconds
        zzucount -= 1;
        zzubit = zzubit >> 1;
        (zzucount <= 0) ? (
            zzucount = 24;
            zzubit = refresh_20;
        );
        zzrefreshUI |= zzubit;
    );

    (timez >= justafter) ? (
        // Execute the nearest operation in time
        theent = -1;
        wtime = timez;
        im = 0; loop (dolistsiz,
            qd = dolistdate[im];
            ((qd != 0) && (qd <= wtime)) ? (
                wtime = qd;
                theent = im;
            );
            im += 1;
        );
        (theent >= 0) ? (
            zzrefreshUI |= dolistflgs[theent];
            (dolistacts[theent] != 0) ? thendo(dolistacts[theent]);
            dolistdate[theent] = dolistflgs[theent] = dolistacts[theent] = 0;
        );
        // Search next action date
        justafter = timez + 300; // wait for some minutes
        im = 0; loop (dolistsiz,
            qd = dolistdate[im];
            ((qd != 0) && (qd <= justafter)) ? (
                justafter = qd;
            );
            im += 1;
        );
    );

    ((MIDIshowtime != 0) && (timez > MIDIshowtime)) ? (
        zzrefreshUI |= refresh_01;
        willdo(timez + 0.1, refresh_01, 1);
        MIDIshowtime =0;
    );

    zzrefreshUI ? updateLeds();
    zzuleft = timen - timez;
);
