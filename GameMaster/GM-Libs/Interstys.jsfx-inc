        g[its_Gr_Rho] = rho; g[its_Gr_Fi] = fi; g[its_Gr_Pl] = pl;
        g[its_Gr_G] = 10^(max(-20, min(20, reader[its_Rdr_GrVol])) / 20) * its_Gr_Rnd(reader[its_Rdr_GrVolR]);
        g[its_Gr_Ch] = min(nc - 1, floor(rand(nc)));
        g[its_Gr_Out] = min(no - 1, floor(rand(no)));
        k = reader[its_Rdr_GrCurve] - 1;
        ((k >= 0) && (k < its_CrvMx) && its_CrvTbE[k] && (its_CrvTbXs[k] >= 0)) ? (
            g[its_Gr_Tab] = its_CrvTab + k * its_CrvTbSz + its_CrvTbG; g[its_Gr_Xs] = its_CrvTbXs[k]; g[its_Gr_S] = its_CrvTbS[k];
