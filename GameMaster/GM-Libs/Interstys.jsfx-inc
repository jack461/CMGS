            fa = Effects_set[its_FxLst[a]];
            its_FxDeg[a] = its_FxDone[a] = 0;
            b = 0; loop(m,
                fb = Effects_set[its_FxLst[b]];
                k = (a !== b) && (fa[its_Efx_Phase] === fb[its_Efx_Phase]) && its_Fx_Reads(fa, its_FxWK[b]);
