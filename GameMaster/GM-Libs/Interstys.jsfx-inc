DebugTbNames = make_array(DebugTbSize);
DebugTbTyps = make_array(DebugTbSize);
DebugTbAdds = make_array(DebugTbSize);
DebugTbDecs = make_array(DebugTbSize);

dbg_u_za = 0;


// ============ Memory Debug ============
/*
    Types:   0x100  : the address to display is computed in the memory displayer by "mSL_Dbg_Memory_Updt"
             0x001  : show absolute : relative address
             0x002  : data is in gmem
             0x004  : show @ in hexadecimal
             0x008  : show data in hexadecimal
*/
// The debug menu ActionTbSiz
idx = 0;
DebugTbTyps[idx] = 0; DebugTbAdds[idx] = 0; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Memory"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 4; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Mem. mSL"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 5; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Main Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 6; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Aux. Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 7; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Readers Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 8; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Lines Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 9; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Writers Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 10; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Effects Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 11; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "spl()"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 12; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "alt()"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 21; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Reader 1"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 22; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Line 1"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 23; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Writer 1"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 24; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Effect 1"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 25; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Reader 2"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 26; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Line 2"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 27; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Writer 2"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 28; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Effect 2"; idx += 1;

DebugCount = idx;

mSL_Sort_Strings(DebugCount, 0, DebugTbNames, DebugTbTyps, DebugTbAdds, DebugTbDecs);

menu_Debug = make_jmenu(
            ui_jmenu_typ_action | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "debug", DebugCount, DebugTbNames);

debugDSize = 128;
memoryBox1[12] = make_array(debugDSize);
memoryBox2[12] = make_array(debugDSize);
// Preselect "Memory"
// Look for the "Memory" entry.
dbg_curr_sel = -1;
ii = 0; while ((dbg_curr_sel < 0) && (ii < DebugCount)) (
    (DebugTbNames[ii] == "Memory") ? dbg_curr_sel = ii;
    ii += 1;
);
memoryBox1[6] = memoryBox2[6] = dbg_curr_sel;
memoryBox1[8] = memoryBox2[8] = 0;
memoryBox1[9] = memoryBox2[9] = 0;
memoryBox1[10] = memoryBox2[10] = 0;
memoryBox1[11] = memoryBox2[11] = 0;
memoryBox1[13] = memoryBox2[13] = 0;
memoryBox1[14] = memoryBox2[14] = 0;


/* Add a file name to the compiler list */
function doMslCompile(fname)
(
    // Do not accept empty strings
    (strlen(fname) != 0) ? (
        0 ? (sprintf(#s, "::About to doMslCompile: \"%s\"", fname); mSL_log(SysLogBox, #s););
        atomic_set(mSL_Lock, max(1,atomic_get(mSL_Lock)));
        uuuMslTabs[uuuMslTPt] = fname; uuuMslTPt = (uuuMslTPt + 1) % uuuMslTSiz;
        atomic_add(mSL_loc_tim,mSL_loc_tadd);
        uuuMslFn = 1; // set flag
    )
);


