    blockStrMvRight = (itdsp += 1);
    blockDispNames[blockStrMvRight] = "&/Move right";
    blockCopyModule = (itdsp += 1);
    blockDispNames[blockCopyModule] = "&/Copy module";
    blockPasteModule = (itdsp += 1);
    blockDispNames[blockPasteModule] = "&/<Paste module";
    //
    (itdsp += 1); // separator
