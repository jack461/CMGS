);

// Saturation : the modes that have a primitive (ADAA, its_Sat_Adaa) : Soft, Hard, Fold, SineFold, XSin
function its_Sat_AdOk(md) ( (md >= its_SatSoft) && (md <= its_SatXSin); );

/*
    Saturation : the primitive F of the shape of the mode "md" (its_Sat_Shape), F(0) = 0 : tanh, log(cosh(u)) ; hard clip,
    u² / 2, then |u| - 1/2 ; fold (a triangle of period 4 : F is periodic, its integral over a period is 0), by the phase
    t = u + 1 modulo 4 ; sine fold, (2 / pi) (1 - cos(pi u / 2)) ; x - A sin(n x pi / 2), with a = n pi / 2 :
    (u² / 2 + A (cos(a u) - 1) / a) / 2
*/
function its_Sat_Prim(u, md, n, fx)
local (a, t)
(
    (md === its_SatSoft) ? (
        a = abs(u);
