        ) : (
            (ki === 0) ? ( its_Tb_v1 = its_Tb_Id(its_TK_Line, its_Tb_Next(), 0); ) :
            (ki === 1) ? ( its_Tb_v1 = its_Tb_Id(its_TK_Writer, its_Tb_Next(), 0); ) :
            (ki === 2) ? ( its_Tb_v1 = its_Tb_Num(nm, 0, 67108864 / srate); ) :
            ((ki === 3) || (ki === 19)) ? ( its_Tb_v1 = its_Tb_Num(nm, -SPDMAX, SPDMAX); ) : // speed, stretch
            (ki === 4) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbRSt, 5); ) :
            (ki === 5) ? ( its_Tb_Src(nm, 1); ) :
            (ki === 6) ? ( its_Tb_v1 = its_Tb_Num(nm, -120, 40); ) :
            (ki === 7) ? ( its_Tb_v1 = its_Tb_Int(nm, 0, 127); ) :
            (ki === 8) ? ( its_Tb_v1 = its_Tb_Int(nm, 1, 128); ) :
            (ki === 9) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbRLp, 6); ) :
            ((ki === 10) || (ki === 11)) ? ( its_Tb_v1 = its_Tb_Num(nm, -1, 1); ) : // loopspeed, desync
            (ki === 12) ? ( its_Tb_v1 = its_Tb_Int(nm, 0, 128); ) :
            (ki === 13) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbFSt, 2); ) : // Off, On
            (ki === 14) ? (
                (its_Tb_Peek() === its_TK_Reader) ? ( its_Tb_Next(); its_Tb_v1 = its_RdrMode_Read; ) :
                    ( its_Tb_v1 = its_Tb_Enum(nm, its_TbRMd, its_RdrModeCnt); );
            ) :
            // Stretch, Brage (the ranges of the pad, its_RdSt_Range) : block, overlap, search, transp
            (ki === 15) ? ( its_Tb_v1 = its_Tb_Num(nm, 10, 5000); ) :
            (ki === 16) ? ( its_Tb_v1 = its_Tb_Int(nm, 5, 50); ) :
            (ki === 17) ? ( its_Tb_v1 = its_Tb_Num(nm, 0, 200); ) :
            (ki === 18) ? ( its_Tb_v1 = its_Tb_Num(nm, -24, 24); ) :
