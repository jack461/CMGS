/*
   Display a log/trace
*/
function show_SysLog(blnb, box)
local (h1, h3, disps, mini, avail, uix_jneed, uix_jmini, ptr, nc, as, fl, flg, zzmi, xx, ii, u_ch, siz, dep, had, thgh)
(
    disps = box[4]; mini = 2;
    h1 = uix_jBoxHeight(mini);
    h3 = uix_jBoxHeight(disps);
    // (box[6] <= 0) ? box[6] = ui_jd_tboxs;
    uix_jneed = h3 + ui_jd_delta2 + ui_jd_ctgr;
    uix_jmini = max(h1 + ui_jd_ctgr, ui_jd_min_block);
    (ui_height() >= uix_jmini) ? (
        ui_split_top(uix_jneed);
            //ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blnb);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group("Script Syslog");
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
            ui_align(0,0);
            as = box[2]; // array size
            fl = box[1]; // first line
            xx = control_jmenu(menu_uix_jlog);
            (xx > 0) ? (
                (xx === 1) ? (
                    box[5] = 1;
                ) :
                (xx === 2) ? (
                    box[5] = 2;
                ) :
                (xx === 3) ? (
                    box[5] = 3;
                ) :
                (xx === 4) ? (
                    box[5] = 4;
                ) :
                (xx === 5) ? (
                    box[5] = 5;
                ) :
                (xx === 6) ? (
                    box[5] = 6;
                ) :
                (xx === 7) ? (
                    box[5] = 7;
                ) :
                (xx === 8) ? (
                    box[5] = 8;
                ) :
                (xx === 9) ? (
                    box[6] = min(20, box[6]+1);
                ) :
                (xx === 10) ? (
                    box[6] = max(0, box[6]-1);
                ) :
                (xx === 11) ? (
                    mSL_log(box, "");
                ) :
                (xx === 12) ? (
                    ii = 0; loop(as,
                        strcpy(fl + ii, ""); ii += 1;
                    );
                );
            );

            (zzmi) ? (
                u_ch = GM_key_peek(); // the keys of the log (taken below if used)
                (u_ch != 0) ? (
                    sprintf(#gfx_uc, "Keyed: '%c' [%d]", u_ch, kcnt); kcnt+= 1;
                    // mSL_log(SysLogBox, #gfx_uc);
                    (FlagsTbVals[Flgs_Traces] & 1) ? (
                        sprintf(#sq, "***Key  @  %d  %d  %d [%02x+%02x -> '%c']", mouse_x, mouse_y, mouse_cap, mouse_cap, u_ch, u_ch);
                        mSL_log(SysLogBox, #sq);
                    );
                    ((u_ch === ' ') || (u_ch ===  0x0d)) ? (mSL_log(box, " ");) :
                    (u_ch === 'm') ? (box[6] = min(20, box[6]+1);) :
                    (u_ch === 'l') ? (box[6] = max(0, box[6]-1);) :
                    (u_ch === 'z') ? (box[7] = 0;) :
                    (u_ch === 'k') ? (box[7] = max(0, box[7]-1);) :
                    (u_ch === 'j') ? (box[7] = (box[7]+1) % box[2];) :
                    (u_ch === 't') ? (nowTime(); mSL_log(SysLogBox, #nowis);) :
                    //(u_ch === 'v') ? (ShowConfig();) :
                    (u_ch === 'up') ? (box[7] = max(0, box[7]-10);) :
                    (u_ch === 'down') ? (box[7] = (box[7]+10) % box[2];) :
                    ((GM_key_mods() === 0) && (u_ch === 'left')) ? (box[7] = 0;) :
                    ((GM_key_mods() === 0) && (u_ch === 'rght')) ? (box[7] = (box[7]+100) % box[2];) :
                    (u_ch === '1') ? (box[5] = 1;) :
                    (u_ch === '2') ? (box[5] = 2;) :
                    (u_ch === '3') ? (box[5] = 3;) :
                    (u_ch === '4') ? (box[5] = 4;) :
                    (u_ch === '5') ? (box[5] = 5;) :
                    (u_ch === '6') ? (box[5] = 6;) :
                    (u_ch === '7') ? (box[5] = 7;) :
                    (u_ch === '8') ? (box[5] = 8;) :
                    (u_ch === 'p') ? (sysout(box);) : // log in a text file (see mSL_show_Utilities)
                    (u_ch === 'P') ? (sysout(box, 31);) : // the log in the console of GMAuxiliary.eel, to copy it
                    (u_ch = 0); // not a key of the log
                    GM_key_take(u_ch); // the key has been used
                );
            );
            nc = max(1, min(8, 0|box[5])); // number of columns to show
            nc = max(1, min(nc, floor(gfx_w/ui_jscale()/gfx_colL_width))); // narrow window: fewer columns

            ui_jshow_color = ui_jcolor_text;
            siz = box[2];
            dep = siz - 1; had = box[6];
            ptr = (box[3] + dep + 16*siz - box[7]) % siz; // last inserted line
            loop (nc,
                (nc != 0) ? ui_new_column(1/nc) : ui_new_column();
                nc = 0;
                ui_pad(3,0);ui_align(0, 0.5);
                ui_pcolor(ui_jshow_color);
                flg = 1;
                while (flg) (
                    /*
                    ui_jd_tboxh = had + ui_wraptext_height(#txt);
                    #txt = fl + ptr; // line to print
                    twdt = ui_text_width(#txt);
                    (twdt < wdth) ? (
                        (ui_height() >= ui_jd_tboxh) ? (
                            // put the string
                            uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                ui_pcolor(ui_jshow_color);
                                ui_wraptext(#txt);
                            ui_pop();
                            ptr = (ptr + dep) % siz;
                        ) : (
                            flg = 0;
                        );
                    ) : (
                    */
                    // Mono or Multi-line text
                    #txt = fl + ptr; // line to print
                    (strlen(#txt) === 0) ? #txt = " ";
                    thgh = ui_wraptext_height(#txt) + had;
                    (ui_height() >= thgh) ? (
                        // put the string
                        ui_split_top(thgh);
                            // ui_pcolor(ui_jshow_color);
                            ui_wraptext(#txt);
                        ui_pop();
                        ptr = (ptr + dep) % siz;
                    ) : (
                        flg = 0;
                    );
                    /*
                    lg = strlen(#txt);
                    k = max(1,ceil(lg / maxl));
                    (flg = (av = av - k) >= 0) ? (
                        (k === 1) ? (
                            // put the string
                            uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                ui_pcolor(ui_jshow_color);
                                ui_wraptext(#txt);
                            ui_pop();
                        ) : (
                            off = 0; sz = maxl;
                            while (k > 0) (
                                // cut the string in a few parts
                                strcpy_substr(#txt1,#txt, off, sz);
                                // put the string
                                uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                    // ui_pad(0,1,0,0);
                                    ui_pcolor(ui_jshow_color);
                                    ui_wraptext(#txt1);
                                ui_pop();
                                k -=1; off += maxl; sz = min(maxl, lg); lg -= sz;
                            );
                        );
                        ptr = (ptr + dep) % siz;
                    );
                    */
                );
            );
            ui_pop();


        ui_pop();
    );
);

// Markers of the heads on line "lcbl", for the next ui_audio_wave :
// green for the writers ; yellow for the readers (orange for the auxiliary head during a cross fade)
// rdrsel : number of the reader to show, or -1 for all the readers (each marker then shows the reader number)
// the marks of the grains running of the reader "x" (mode Grains, its_RdGr_MkMx at most ; the first one numbered "lab")
function its_Gr_Marks(x, lab) local(wk, g, i, c)
(
    wk = x[its_Rdr_Work];
    ((wk > BASE_MEMORY) && (wk[its_RdW_Size] === its_RdGr_WkSz) && (x[its_Rdr_SmplCnt] > 0)) ? (
        g = wk + its_RdW_Hdr; i = c = 0;
        while ((i < its_RdGr_Max) && (c < its_RdGr_MkMx)) (
            (g[its_Gr_N] > 0) ? (
                ui_audio_mark(its_Rd_Wrap(x, g[its_Gr_Pos]), its_WaveColAux, (c === 0) ? lab : 0);
                c += 1;
            );
            g += its_RdGr_Sz; i += 1;
        );
    );
);

function its_wave_marks(lcbl, rdrsel)
local (i, x, m, p, lab)
(
    its_wave_colors();
    i = 0; loop(WR_CNT,
        (((x = Writers_set[i]) != 0) && (x[its_Wrt_Lcbl] == lcbl) && (x[its_Wrt_Status] == its_WrtStat_Writing)) ? (
            ui_audio_mark(x[its_Wrt_Abspos], its_WaveColWrt, -(i + 1)); // numbered at the bottom (several writers may write the line)
        );
        i += 1;
    );
    i = 0; loop(RD_CNT,
        (((rdrsel < 0) || (rdrsel == i)) && ((x = Readers_set[i]) != 0) && (x[its_Rdr_Lcbl] == lcbl)
            && ((x[its_Rdr_Status] == its_RdrStat_Reading) || (x[its_Rdr_Status] == its_RdrStat_Paused))) ? ( // paused : its position too
            lab = (rdrsel < 0) ? i + 1 : 0;
            // mode Grains : the grains running (no read position of its own)
            (x[its_Rdr_Mode] === its_RdrMode_Grains) ? its_Gr_Marks(x, lab) : (
                // delay mode : a single read position (its multi and x-fade positions are not used)
                m = 0; loop((x[its_Rdr_Mode] === its_RdrMode_Delay) ? 1 : max(1, min(its_RdrMaxMulti, x[its_Rdr_MultiCnt])),
                    // (very) negative positions are used for fade in / fade out : no marker ; the positions in the frame of a
                    // writer that the loop follows are read modulo the size of the line (its_Rdr_LoopFollow)
                    ((p = x[its_Rdr_Abspos + m]) > MIN_VALUE) ? ui_audio_mark(its_Rd_Wrap(x, p), its_WaveColRdr, lab);
                    ((x[its_Rdr_XFadeCnt + m] > 0) && (x[its_Rdr_Mode] !== its_RdrMode_Delay) && (x[its_Rdr_Status] == its_RdrStat_Reading)) ? (
                        ((p = x[its_Rdr_AbsAuxpos + m]) > MIN_VALUE) ? ui_audio_mark(its_Rd_Wrap(x, p), its_WaveColAux, lab);
                    );
                    m += 1;
                );
            );
        );
        i += 1;
    );
);

// the loop of the reader block "r" is moved by hand (the mouse in its waveform, the sliders of its limits) : type
// "catch", it does not catch the read position it passes over while the left button is down (its_RdNoCatch, @block)
function its_Rd_HandMove(r)
(
    its_WvNoCatch = r; its_WvNoCatchT = time_precise();
);

// the time "t" (s, in the line) given by hand for a limit of the loop of the reader "r" : the loop crosses the end of the
// line (its_Rd_Cross), "t" in the frame centered on the loop (the line is circular : the result may be below 0 or above
// the size) ; else "t"
function its_Rd_CrossT(r, t)
local (cs, c)
(
    cs = r[its_Rdr_SmplCnt] / srate;
    ((r[its_Rdr_LfSt] & its_RdrLf_Cross) && (cs > 0)) ? (
        c = (r[its_Rdr_LowPosSec] + r[its_Rdr_HighPosSec]) / 2;
        t - cs * floor((t - c + cs / 2) / cs);
    ) : t;
);

// the value of "x" modulo the size of the line "cs" (s) nearest to "ref" (a drag of the mouse while the loop crosses the
// end of the line : the move stays continuous)
function its_Rd_Near(x, ref, cs)
(
    x - cs * floor((x - ref) / cs + 0.5);
);

/*
    the mouse in the waveform of the reader "r" (the current rectangle, the range shown [ui_aud_za, ui_aud_zb)) :
    - a left clic moves the read position there, at the release (modes Reader and Stretch, as the slider "Position" ;
      paused, the position is moved at once) ;
    - a left drag from a limit of the loop (its margin included, at its_WvDTol pixels) moves this limit (past the other
      limit, they are exchanged, as with the sliders ; the loop keeps at least two cross fades) ;
    - Alt + a left drag in the loop moves the loop, its length kept ; Shift + left clic : the loop on the whole line ;
    - the limits do not move when the loop follows a writer (its_Rdr_LoopFollow), a clic moves the read position ;
    - the loop crosses the end of the line (its_Rd_Cross) : its limits and the loop move across the end (the line is
      circular) ;
    - during a drag, the mouse may leave the waveform : the limit, or the loop, follows it at the scale of the range shown,
      up to the ends of the line, or modulo its size when the loop crosses the end of the line ;
    "dr" : a drag runs (the range shown is the one of the press, see its_wave_reader)
*/
function its_wave_mouse(r, dr)
local (za, zb, s, t, st, cs, mn, lo, ln, px, d1, d2, md, cx, n, tf, sf, tu, lmax)
(
    za = 0|ui_aud_za; zb = max(za + 1, 0|ui_aud_zb); // (as ui_audio_wave)
    // the sample under the mouse (a drag : also beyond the waveform, at the scale of the range shown)
    s = za + (dr ? ui_mouse_xratio() : max(0, min(1, ui_mouse_xratio()))) * (zb - za);
    st = r[its_Rdr_Start]; cs = r[its_Rdr_SmplCnt] / srate;
    t = max(0, min(cs, (s - st) / srate)); // (s, in the line)
    mn = min(cs, max(0.002, 2 * r[its_Rdr_XFade_mSec] / 1000)); // the shortest loop
    md = r[its_Rdr_Mode];
    // the loop crosses the end of the line (its_Rd_Cross) : the line is circular, the mouse is taken in the frame centered
    // on the loop (tf, sf : its limits may be below 0 or above the size), its limits move without bounds (@block puts the
    // loop in its form, its_Rd_CrossForm) ; "t" stays in the line (the read position)
    cx = (r[its_Rdr_LfSt] & its_RdrLf_Cross) && ((n = r[its_Rdr_SmplCnt]) > 0);
    tf = its_Rd_CrossT(r, t);
    sf = cx ? s - n * floor((s - its_Rd_FrLo(r)) / n) : s;
    dr ? (
        // a drag : the limit, or the loop, follows the mouse ; the loop crosses the end of the line : the value modulo the
        // size nearest to the limit dragged (or to the start of the loop : the move stays continuous), the loop at most
        // lmax long (its_Rd_CrossOk)
        tu = (s - st) / srate;
        lmax = cx ? (n - 2 * max(3, floor(0.5 + r[its_Rdr_XFade_mSec] * srate / 1000)) - 2 * samplesblock - 9) / srate : cs;
        (its_WvDK === its_WvD_Low) ? (
            tf = cx ? its_Rd_Near(tu, r[its_Rdr_LowPosSec], cs) : t;
            (tf > r[its_Rdr_HighPosSec]) ? (
                r[its_Rdr_LowPosSec] = r[its_Rdr_HighPosSec];
                r[its_Rdr_HighPosSec] = cx ? min(r[its_Rdr_LowPosSec] + lmax, max(tf, r[its_Rdr_LowPosSec] + mn)) :
                    min(cs, max(t, r[its_Rdr_LowPosSec] + mn));
                its_WvDK = its_WvD_High;
            ) : (
                r[its_Rdr_LowPosSec] = cx ? max(r[its_Rdr_HighPosSec] - lmax, min(tf, r[its_Rdr_HighPosSec] - mn)) :
                    max(0, min(t, r[its_Rdr_HighPosSec] - mn));
            );
        ) :
        (its_WvDK === its_WvD_High) ? (
            tf = cx ? its_Rd_Near(tu, r[its_Rdr_HighPosSec], cs) : t;
            (tf < r[its_Rdr_LowPosSec]) ? (
                r[its_Rdr_HighPosSec] = r[its_Rdr_LowPosSec];
                r[its_Rdr_LowPosSec] = cx ? max(r[its_Rdr_HighPosSec] - lmax, min(tf, r[its_Rdr_HighPosSec] - mn)) :
                    max(0, min(t, r[its_Rdr_HighPosSec] - mn));
                its_WvDK = its_WvD_Low;
            ) : (
                r[its_Rdr_HighPosSec] = cx ? min(r[its_Rdr_LowPosSec] + lmax, max(tf, r[its_Rdr_LowPosSec] + mn)) :
                    min(cs, max(t, r[its_Rdr_LowPosSec] + mn));
            );
        ) :
        (its_WvDK === its_WvD_Loop) ? (
            ln = r[its_Rdr_HighPosSec] - r[its_Rdr_LowPosSec];
            r[its_Rdr_LowPosSec] = lo = cx ? its_Rd_Near(tu - its_WvDOff, r[its_Rdr_LowPosSec], cs) :
                max(0, min(cs - ln, t - its_WvDOff));
            r[its_Rdr_HighPosSec] = lo + ln;
        );
        (its_WvDK > its_WvD_Head) ? (
            r[its_Rdr_StFlgs] |= its_RdrFlg_Mod; // (Rd_Update : the limits of the loop)
            its_Rd_HandMove(r);
        );
    ) :
    (uix_click(1) && ui_hover() && uix_clickwasinside(1)) ? (
        // a press : what it catches (the read position by default)
        its_WvDR = r; its_WvDK = its_WvD_Head; its_WvDZa = ui_aud_za; its_WvDZb = ui_aud_zb;
        !(r[its_Rdr_LfSt] & its_RdrLf_On) ? (
            (uix_clickmods & 8) ? (
                // Shift : the loop on the whole line
                r[its_Rdr_LowPosSec] = 0; r[its_Rdr_HighPosSec] = cs;
                r[its_Rdr_StFlgs] |= its_RdrFlg_Mod;
                its_WvDK = 0;
            ) :
            (uix_clickmods & 16) ? (
                // Alt : the loop, if the mouse is in it
                ((sf >= r[its_Rdr_RegSOut]) && (sf < r[its_Rdr_RegEOut])) ? (
                    its_WvDK = its_WvD_Loop; its_WvDOff = tf - r[its_Rdr_LowPosSec];
                ) : (
                    its_WvDK = 0;
                );
            ) : (
                // the nearest limit, if the mouse is close to it or to its margin
                px = ui_width() / (zb - za); // (pixels per sample)
                d1 = (sf < r[its_Rdr_RegSOut]) ? (r[its_Rdr_RegSOut] - sf) * px : (sf > r[its_Rdr_RegSIn]) ? (sf - r[its_Rdr_RegSIn]) * px : 0;
                d2 = (sf < r[its_Rdr_RegEIn]) ? (r[its_Rdr_RegEIn] - sf) * px : (sf > r[its_Rdr_RegEOut]) ? (sf - r[its_Rdr_RegEOut]) * px : 0;
                (min(d1, d2) <= its_WvDTol) ? (
                    its_WvDK = (d1 < d2) ? its_WvD_Low : (d2 < d1) ? its_WvD_High :
                        (tf < (r[its_Rdr_LowPosSec] + r[its_Rdr_HighPosSec]) / 2) ? its_WvD_Low : its_WvD_High;
                );
            );
        );
    ) :
    ((its_WvDR === r) && !(mouse_cap & 1) && uix_clickwasinside(1)) ? (
        // the release : a clic (no limit, no loop caught) moves the read position there
        ((its_WvDK === its_WvD_Head) && uix_unclick(1) && ui_hover() && its_Rd_Lined(md) && !its_Rd_Rand(md)) ? (
            r[its_Rdr_NxtPosSec] = t;
            (r[its_Rdr_Status] === its_RdrStat_Paused) ? (r[its_Rdr_Abspos] = its_Rd_LfIn(r, st + floor(t * srate)));
        );
        its_WvDR = its_WvDK = 0;
    );
);

// Waveform of the channels read by reader "rcbl" (number "rdr") in line "lcbl", zoom in [1, 100]
// The region (if it does not cover the whole line) and the zoom work in all the reading modes, so that the
// limits can be set before switching to a loop mode : the zoom goes from the whole line to [its_Rdr_RegSOut, its_Rdr_RegEOut) ;
// the mouse moves the limits of the loop and the read position (its_wave_mouse)
function its_wave_reader(lcbl, rcbl, rdr, zoom, flags)
local (fa, fb, ra, rb, nch, ch0, a, b, n, dr)
(
    its_wave_colors();
    fa = lcbl[its_Lin_Start]; fb = lcbl[its_Lin_Last];
    ra = rcbl[its_Rdr_RegSOut]; rb = rcbl[its_Rdr_RegEOut];
    (rcbl[its_Rdr_LfSt] & (its_RdrLf_On | its_RdrLf_Cross)) ? (
        // the loop follows a writer (its_Rdr_LoopFollow) or it crosses the end of the line (its_Rd_Cross) : it may
        // straddle the end and the start of the line (its limits below the start), then it is shown in two parts
        n = fb - fa; a = rcbl[its_Rdr_RegSIn]; b = rcbl[its_Rdr_RegEIn];
        (b < fa) ? ( a += n; b += n; );
        (a < fa) ? (
            ui_audio_band(a + n, fb, its_WaveColReg, 0.25);
            ui_audio_band(fa, b, its_WaveColReg, 0.25);
        ) : (
            ui_audio_band(a, b, its_WaveColReg, 0.25);
        );
        ui_audio_mark((ra < fa) ? ra + n : ra, its_WaveColRegLim);
        ui_audio_mark((rb < fa) ? rb + n : rb, its_WaveColRegLim);
    ) :
    // only when the region is smaller than the line (for the whole line, RegSOut = Start and RegEOut = Last)
    ((ra > fa + 1) || (rb < fb - 1)) ? (
        ui_audio_band(rcbl[its_Rdr_RegSIn], rcbl[its_Rdr_RegEIn], its_WaveColReg, 0.25);
        ui_audio_mark(ra, its_WaveColRegLim);
        ui_audio_mark(rb, its_WaveColRegLim);
    );
    ui_audio_zoom(fa, fb, ra, rb, zoom); // the whole line if the region covers it (or is not defined)
    // a drag of the mouse : the range shown does not move (the zoom follows the loop)
    dr = (its_WvDR === rcbl) && (its_WvDK > 0) && (mouse_cap & 1) && !uix_click(1) && uix_clickwasinside(1); // (a press : a new catch)
    dr ? ( ui_aud_za = its_WvDZa; ui_aud_zb = its_WvDZb; );
    // the mouse, before the waveform : the current rectangle is still the one of the waveform (ui_audio_wave gives back
    // the rest of the rectangle, empty here)
    its_wave_mouse(rcbl, dr);
    its_wave_marks(lcbl, rdr);
    ch0 = max(0, min(lcbl[its_Lin_ChCnt] - 1, rcbl[its_Rdr_Bf1stChan]));
    nch = max(0, min(rcbl[its_Rdr_BfChanUsed], lcbl[its_Lin_ChCnt] - ch0)); // only the channels read
    ui_aud_chan0 = ch0; // each channel keeps the color of its number in the line
    ui_audio_wave(0, nch, lcbl + its_Lin_BF1ST + ch0, lcbl[its_Lin_ActBSize],
        ui_aud_za, ui_aud_zb, flags, its_LinWaveMax);
);


/*
    Pads helpers : the sources and destinations (see its_Src_Cell, its_Out_Cell)
*/
// label of the source "src" (kind * ITS_KMul + number), first channel "off", in the string "str"
function its_Src_Label(str, src, off)
local (k, n)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    (src === 0) ? strcpy(str, "none") :
    (k === ITS_KIn) ? sprintf(str, "In:%d", off) :
    (k === ITS_KOut) ? sprintf(str, "Out:%d", off) :
    (k === ITS_KBus) ? sprintf(str, "Bus %d:%d", n + 1, off) :
    (k === ITS_KCtl) ? sprintf(str, "Ctl %d", n + 1 + off) :
    (k === ITS_KRdr) ? ((off > 0) ? sprintf(str, "R%d:%d", n + 1, off) : sprintf(str, "Reader %d", n + 1)) :
    (k === ITS_KFx) ? ((off > 0) ? sprintf(str, "E%d:%d", n + 1, off) : sprintf(str, "Effect %d", n + 1)) :
    strcpy(str, "???");
);

// label of the destination "dst" of an output (0 : own cable)
function its_Out_Label(str, dst, off)
(
    (dst === 0) ? strcpy(str, "Own cable") : its_Src_Label(str, dst, off);
);

// item of menu_Src_Ids for the source "src", first channel "off" (0 : not in the menu) ; the source of the item "r"
// items : 1 None, 2 ... In:0 ..., then Out:0 ..., the buses, the controls, the readers, the effects
function its_Src_MenuIdx(src, off)
local (k, n)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    (src === 0) ? 1 :
    (k === ITS_KIn) ? ((off < ITS_MNCH) ? 2 + off : 0) :
    (k === ITS_KOut) ? ((off < ITS_MNCH) ? 2 + ITS_MNCH + off : 0) :
    (k === ITS_KBus) ? 2 + 2 * ITS_MNCH + n :
    (k === ITS_KCtl) ? ((n + off < NB_GSL) ? 2 + 2 * ITS_MNCH + NB_BUS + n + off : 0) :
    (k === ITS_KRdr) ? 2 + 2 * ITS_MNCH + NB_BUS + NB_GSL + n :
    (k === ITS_KFx) ? 2 + 2 * ITS_MNCH + NB_BUS + NB_GSL + RD_CNT + n : 0;
);
// the source of the item "r" ; its first channel in its_Src_ChOff (0 for a bus, a control, a reader, an effect)
function its_Src_FromIdx(r)
(
    its_Src_ChOff = 0;
    (r <= 1) ? 0 :
    (r < 2 + ITS_MNCH) ? (its_Src_ChOff = r - 2; ITS_KIn * ITS_KMul) :
    (r < 2 + 2 * ITS_MNCH) ? (its_Src_ChOff = r - 2 - ITS_MNCH; ITS_KOut * ITS_KMul) :
    (r < 2 + 2 * ITS_MNCH + NB_BUS) ? ITS_KBus * ITS_KMul + r - 2 - 2 * ITS_MNCH :
    (r < 2 + 2 * ITS_MNCH + NB_BUS + NB_GSL) ? ITS_KCtl * ITS_KMul + r - 2 - 2 * ITS_MNCH - NB_BUS :
    (r < 2 + 2 * ITS_MNCH + NB_BUS + NB_GSL + RD_CNT) ? ITS_KRdr * ITS_KMul + r - 2 - 2 * ITS_MNCH - NB_BUS - NB_GSL :
    ITS_KFx * ITS_KMul + r - 2 - 2 * ITS_MNCH - NB_BUS - NB_GSL - RD_CNT;
);

// menu of the sources, "src" (first channel "off") ticked ; returns the source chosen (0 : none), -1 if no choice ;
// the first channel chosen is in its_Src_ChOff
function its_Src_Choose(src, off)
local (k, xx, res)
(
    res = -1;
    ui_menu_tick(menu_Src_Ids, -1, 0);
    ((k = its_Src_MenuIdx(src, off)) > 0) ? ui_menu_tick(menu_Src_Ids, k, 1);
    xx = control_jmenu(menu_Src_Ids);
    (xx != 0) ? (res = its_Src_FromIdx(xx));
    ui_menu_tick(menu_Src_Ids, -1, 0);
    res;
);

// menu of the destinations of an output, "dst" (first channel "off") ticked ; returns the destination chosen
// (0 : own cable), -1 if no choice ; the first channel chosen is in its_Src_ChOff (0 for the own cable, a bus)
// items : 1 own cable, 2 ... Out:0 ..., then the buses
function its_Dst_Choose(dst, off)
local (k, n, xx, res)
(
    res = -1;
    k = floor(dst / ITS_KMul);
    n = dst - k * ITS_KMul;
    ui_menu_tick(menu_Dst_Ids, -1, 0);
    k = (dst === 0) ? 1 : (k === ITS_KOut) ? ((off < ITS_MNCH) ? 2 + off : 0) : 2 + ITS_MNCH + n;
    (k > 0) ? ui_menu_tick(menu_Dst_Ids, k, 1);
    xx = control_jmenu(menu_Dst_Ids);
    (xx != 0) ? (
        its_Src_ChOff = 0;
        res = (xx === 1) ? 0 :
            (xx < 2 + ITS_MNCH) ? (its_Src_ChOff = xx - 2; ITS_KOut * ITS_KMul) :
            ITS_KBus * ITS_KMul + xx - 2 - ITS_MNCH;
    );
    ui_menu_tick(menu_Dst_Ids, -1, 0);
    res;
);

// menu of the first channel [0 ... 127], "off" ticked ; returns the channel chosen, -1 if no choice
// the menu "m" of a cell "Action" of a pad, opened by the clic "ev" of the pad : right clic, or left clic (the menu
// accepts the button used, see control_jmenu ; then its option again)
function its_Menu_Clic(m, ev)
local (ty, r)
(
    ty = m[ui_jmenu_type];
    m[ui_jmenu_type] = ty - (ty & ui_jmenu_opt_mask) + ((ev & ui_jpad_ev_rmc) ? ui_jmenu_opt_rclick : ui_jmenu_opt_lclick);
    r = control_jmenu(m);
    m[ui_jmenu_type] = ty;
    r;
);

function its_Off_Choose(off)
local (xx, res)
(
    res = -1;
    ui_menu_tick(menu_128_0_Ids, -1, 0);
    ui_menu_tick(menu_128_0_Ids, off + 1, 1);
    // also tick the header of the sub-menu that holds the current channel (reset below by the tick -1)
    str_setchar(menu_128_0_Ids[ui_jmenu_items + (0|(max(0, min(127, off)) / menu_128_Grp)) * (menu_128_Grp + 1)], 1, '!');
    xx = control_jmenu(menu_128_0_Ids);
    (xx != 0) ? (res = xx - 1);
    ui_menu_tick(menu_128_0_Ids, -1, 0);
    res;
);

/*
    The modulation inputs, in the pads (reader, writer : a line of their own ; effects : cells of the line of their type)
    right clic : the source ; Alt + right clic : the law (its_Mod_LawMenu : action, shape, polarity, the sliders shown :
    none, the depth, the depth and the attenuverter) ; left clic : bypass (the setting without its modulation, to
    compare) ; shift + left clic : the channel
    the depths and the attenuverters are sliders of the module (reader, writer : under the line of the inputs)
*/
// the law of the flags "f" when it is not the default one : " oct exp uni"...
function its_Mod_LawTxt(str, f) local(a, s)
(
    strcpy(str, "");
    ((a = (f >> 2) & 7) > 0) ? strcat(str, its_ModA_Tag[a]);
    ((s = (f >> 5) & 3) > 0) ? strcat(str, its_ModS_Tag[s]);
    (f & its_ModF_Uni) ? strcat(str, " uni");
    (f & its_ModF_Dop) ? strcat(str, " doppler");
    str;
);

// the cells [c0 ... c0+n-1] of a pad ("labs", "colrs") show the "n" inputs "mp", named "names" ("okm" : see its_Mod_Used) :
// the source, the attenuverter (not 1), the law (not the default one) ; bypass : "(off)", in orange
function its_Mod_Fill(labs, colrs, c0, mp, n, names, okm)
local (j, p, f)
(
    j = 0; loop(n,
        p = mp + j * its_ModDist; f = p[its_Mod_Flags];
        its_Src_Label(#modsrc, p[its_Mod_Src], p[its_Mod_Off]);
        ((p[its_Mod_Src] !== 0) && (p[its_Mod_Att] !== 1)) ? (
            sprintf(labs[c0 + j], "%s: %s x%.2f", names[j], #modsrc, p[its_Mod_Att]);
        ) : (
            sprintf(labs[c0 + j], "%s: %s", names[j], #modsrc);
        );
        (p[its_Mod_Src] !== 0) ? (
            (f & (its_ModF_Law | its_ModF_Dop)) ? strcat(labs[c0 + j], its_Mod_LawTxt(#its_ModLT, f));
            (f & its_ModF_Byp) ? strcat(labs[c0 + j], " (off)");
        );
        colrs[c0 + j] = ((okm & (1 << j)) === 0) ? Col_Inactive : (p[its_Mod_Src] === 0) ? Col_P1 :
            (f & its_ModF_Byp) ? Color_Dark_Orange : Col_P3;
        j += 1;
    );
);

// the item "i" (from 0) of the menu "m" : ticked, gray ; its text "txt" (0 : unchanged)
function its_Menu_Item(m, i, tick, gray, txt) local(t)
(
    t = m[ui_jmenu_items + i];
    str_setchar(t, 1, tick ? '!' : ui_jmenu_chSP);
    str_setchar(t, 3, gray ? '#' : ui_jmenu_chSP);
    (txt !== 0) ? (
        strcpy_substr(#its_MnI, t, 0, ui_jmenu_prefx);
        strcat(#its_MnI, txt);
        strcpy(t, #its_MnI);
    );
);

// the menu of the law of the input "p" ("d0" : its first depth, "kd" : its law, see its_ModK_...) ; a new action takes its
// first depth (the default action : d0) ; "Default law" : d0, Lin, bipolar, no Doppler
function its_Mod_LawMenu(p, d0, kd)
local (m, f, da, a, s, c, i, xx)
(
    m = menu_ModLaw;
    f = p[its_Mod_Flags];
    da = kd & 7;
    ((a = (f >> 2) & 7) === 0) ? (a = da);
    s = (f >> 5) & 3; c = (f >> 8) & 63;
    // the actions : those of the input (the default one is named), the current one ticked
    i = 1; loop(4,
        sprintf(#its_MnT, (i === da) ? "%s (default)" : "%s", its_ModA_Name[i]);
        its_Menu_Item(m, i, i === a, ((kd >> 3) & (1 << i)) === 0, #its_MnT);
        i += 1;
    );
    // the shapes ; the curves (their names ; gray : no curve)
    i = 0; loop(3, its_Menu_Item(m, 6 + i, s === i, 0, 0); i += 1;);
    i = 0; loop(its_CrvMx,
        (strlen(its_CrvNm[i]) > 0) ? sprintf(#its_MnT, "%d  %s", i + 1, its_CrvNm[i]) : sprintf(#its_MnT, "Curve %d", i + 1);
        its_Menu_Item(m, its_MLw_Crv(i), (s === its_ModS_Crv) && (c === i), its_CrvBlk[i] <= BASE_MEMORY, #its_MnT);
        i += 1;
    );
    its_Menu_Item(m, 76, f & its_ModF_Uni, 0, 0);
    its_Menu_Item(m, 77, f & its_ModF_Byp, 0, 0);
    its_Menu_Item(m, 78, f & its_ModF_Dop, !(kd & its_ModK_Dop), 0); // (gray : not the offset of a delay reader)
    // the sliders : none, the depth, the depth and the attenuverter
    i = (f & its_ModF_NoSl) ? 0 : (f & its_ModF_Att) ? 2 : 1;
    its_Menu_Item(m, 80, i === 0, 0, 0); its_Menu_Item(m, 81, i === 1, 0, 0); its_Menu_Item(m, 82, i === 2, 0, 0);
    xx = control_jmenu(m);
    ((xx >= 1) && (xx <= 4)) ? (
        (xx !== a) ? ( p[its_Mod_Depth] = (xx === da) ? d0 : its_ModA_Dep[xx]; );
        f = f - (f & 0x1C) + 4 * ((xx === da) ? 0 : xx);
    ) :
    ((xx >= 5) && (xx <= 7)) ? ( f = f - (f & 0x3F60) + 32 * (xx - 5); ) :
    ((xx >= 8) && (xx <= 71)) ? ( f = f - (f & 0x3F60) + 32 * its_ModS_Crv + 256 * (xx - 8); ) :
    (xx === 72) ? ( f += (f & its_ModF_Uni) ? -its_ModF_Uni : its_ModF_Uni; ) :
    (xx === 73) ? ( f += (f & its_ModF_Byp) ? -its_ModF_Byp : its_ModF_Byp; ) :
    ((xx === 74) && (kd & its_ModK_Dop)) ? ( f += (f & its_ModF_Dop) ? -its_ModF_Dop : its_ModF_Dop; ) :
    ((xx >= 75) && (xx <= 77)) ? ( f = f - (f & (its_ModF_NoSl | its_ModF_Att)) + ((xx === 75) ? its_ModF_NoSl : (xx === 77) ? its_ModF_Att : 0); ) :
    (xx === 78) ? ( f -= f & (its_ModF_Law | its_ModF_Dop); p[its_Mod_Depth] = d0; );
    p[its_Mod_Flags] = f;
);

// a clic "ev" (mouse modifiers "jmc") on the input "j" of "mp" ; "defs" : the first depths, "kinds" : the laws
// (its_ModK_...) ; returns 1 if the source changed
function its_Mod_Click(mp, j, ev, jmc, defs, kinds)
local (p, k, chg)
(
    chg = 0;
    p = mp + j * its_ModDist;
    ((ev & ui_jpad_ev_rmc) && (jmc & altCap)) ? (
        its_Mod_LawMenu(p, defs[j], kinds[j]);
    ) :
    (ev & ui_jpad_ev_rmc) ? (
        ((k = its_Src_Choose(p[its_Mod_Src], p[its_Mod_Off])) >= 0) ? (
            (p[its_Mod_Src] === 0) ? (p[its_Mod_Att] = 1); // a new connection : attenuverter 1
            p[its_Mod_Src] = k;
            p[its_Mod_Off] = its_Src_ChOff;
            (p[its_Mod_Depth] === 0) ? (p[its_Mod_Depth] = defs[j]);
            chg = 1;
        );
    ) :
    ((ev & ui_jpad_ev_lmc) && (jmc & shfCap)) ? (
        ((k = its_Off_Choose(p[its_Mod_Off])) >= 0) ? (
            p[its_Mod_Off] = k;
            chg = 1;
        );
    ) :
    (ev & ui_jpad_ev_lmc) ? (
        // bypass (a connected input)
        (p[its_Mod_Src] !== 0) ? (p[its_Mod_Flags] += (p[its_Mod_Flags] & its_ModF_Byp) ? -its_ModF_Byp : its_ModF_Byp);
    );
    chg;
);

// a line of its own for the "n" inputs "mp" (reader, writer) : 0 "Modulation", 1 ... n the inputs ; returns 1 if a source changed
function its_Mod_Row(mp, n, names, okm, defs, kinds)
local (j, zz, zzmcl, jmc, chg)
(
    chg = 0;
    mSL_setStrArray(pad_RdM_Labs, pad_RdM_Siz);
    j = 0; loop(pad_RdM_Siz,
        pad_RdM_Colrs[j] = Col_InfoA;
        strcpy(pad_RdM_Labs[j], "");
        j += 1;
    );
    strcpy(pad_RdM_Labs[0], "Modulation");
    its_Mod_Fill(pad_RdM_Labs, pad_RdM_Colrs, 1, mp, n, names, okm);
    jmc = ui_jmouse_cap;
    zz = control_jpad(pad_RdMod);
    (zz > 0) ? (
        ui_GFXdoNow |= 4; ui_GFXReason = 34;
        zzmcl = pad_RdMod[ui_jpad_last] - 1;
        ((zzmcl >= 1) && (zzmcl <= n)) ? (chg = its_Mod_Click(mp, zzmcl - 1, zz, jmc, defs, kinds));
    );
    chg;
);

// count of the sliders of the inputs used : the depth, and the attenuverter if shown (none : its_ModF_NoSl)
function its_Mod_SlCount(mp, n, okm)
local (j, c, f)
(
    c = j = 0; loop(n,
        f = mp[j * its_ModDist + its_Mod_Flags];
        (its_Mod_Used(mp, j, okm) && !(f & its_ModF_NoSl)) ? (c += 1 + ((f & its_ModF_Att) != 0));
        j += 1;
    );
    c;
);

// the parameter of the depth of the input "j" (named "nm") whose action "a" is not its default one : the parameter of the
// action, its label naming the input
function its_Mod_DepPar(a, nm, j) local(pg, t)
(
    pg = (a === its_ModA_Scale) ? p_modDepSc : (a === its_ModA_Oct) ? p_modDepOct : p_modDepDb;
    t = its_ModFmt[j];
    sprintf(t, (a === its_ModA_Scale) ? "%s depth: x%%.3f" : (a === its_ModA_Oct) ? "%s depth: %%.3f oct" : "%s depth: %%.2f dB", nm);
    paramBlock[pg * paramEntSize + pp_MFmt] = t;
    pg;
);

// the sliders of the inputs used : depth (parameter "pd" + j, or that of its action if it is not the default one, see
// its_Mod_DepPar ; right clic : no modulation), attenuverter if shown ("pa" + j ; right clic : 1) ; none if hidden
// (its_ModF_NoSl, menu of the law) ; "names", "kinds" : the names and the laws of the inputs
function its_Mod_Sliders(mp, n, okm, pd, pa, names, kinds)
local (j, p, r, a, pg)
(
    j = 0; loop(n,
        p = mp + j * its_ModDist;
        (its_Mod_Used(mp, j, okm) && !(p[its_Mod_Flags] & its_ModF_NoSl)) ? (
            a = (p[its_Mod_Flags] >> 2) & 7;
            pg = ((a === 0) || (a === (kinds[j] & 7))) ? pd + j : its_Mod_DepPar(a, names[j], j);
            paramValues[pg] = p[its_Mod_Depth];
            r = parCtl(pg);
            (r != 0) ? (
                p[its_Mod_Depth] = (r === 8) ? 0 : parV(pg);
            );
            (p[its_Mod_Flags] & its_ModF_Att) ? (
                paramValues[pa + j] = p[its_Mod_Att];
                r = parCtl(pa + j);
                (r != 0) ? (
                    p[its_Mod_Att] = (r === 8) ? 1 : max(-10, min(10, parV(pa + j)));
                );
            );
        );
        j += 1;
    );
);

/*
   RDBL[0] = reader to display
   RDBL[1] = reader type
   RDBL[2] = UI Error
   RDBL[3] = Exec error
   RDBL[4] = Speed display option
   RDBL[5] = Neded sliders count
   RDBL[6] = region length size option
   RDBL[7] = region length option
   RDBL[8] = waveform height (0 : its_RdrWaveH)
   RDBL[9] = waveform zoom [1 .. 100] (slider "Zoom")
   RDBL[10] = waveform flags (its_WaveHide, its_WaveOver ; keys 'w', '+', '-', 'v' : see its_Wave_Keys)
   RDBL[11] = Stretch display option (the range of the slider "Stretch", as RDBL[4] for the speed)
   Cells : 2 mode, 3 line, 6 first channel, 7 channels used (right or left clic : menus), 10 output (own cable, Out or a bus ; left clic : first channel),
   11 count of output channels from cell 10 (right clic : menu ; left clic : the count of channels used), 12 position,
   13 speed (reader mode ; right clic : display) or the writer followed (delay mode),
   modes Stretch and Brage : 24 ... 27 their settings, 28 the stretch (mode Stretch ; right clic : display), 29 the lag
*/
// the lines of the pad of a reader in the mode "md" : 2 in delay mode (no transport line), 4 in the modes Stretch and Brage
// (their settings), 5 in mode Grains
function its_Rd_PadLines(md)
(
    (md === its_RdrMode_Delay) ? 2 : (md === its_RdrMode_Grains) ? 5 : its_Rd_Blocks(md) ? 4 : 3;
);

// the read position of the reader "r" in its line (samples from its start, for the display) : in the frame of a writer
// that its loop follows, modulo the size of the line (its_Rdr_LoopFollow), else bounded to the line
function its_Rd_PosSmp(r)
(
    ((r[its_Rdr_LfSt] & its_RdrLf_Frame) && (r[its_Rdr_SmplCnt] > 0) && (r[its_Rdr_Abspos] > MIN_VALUE)) ?
        its_Rd_Wrap(r, r[its_Rdr_Abspos]) - r[its_Rdr_Start] :
        max(0, min(r[its_Rdr_Last], r[its_Rdr_Abspos]) - r[its_Rdr_Start]);
);

// a limit "x" (s) of the loop of the reader "r", in its line : below 0 when its loop follows a writer (its_Rd_LfReg)
function its_Rd_LimSec(r, x)
local (cs)
(
    cs = r[its_Rdr_SmplCnt] / srate;
    ((x < 0) && (cs > 0)) ? x - cs * floor(x / cs) : x;
);

// the range of the slider "p" of a speed (p_playSpeed, p_rdStretch ; 0 : none) for the option "k" of the menu
// menu_Rdr_Speed (RDBL[4], RDBL[11]) ; its bounds also in its_Rd_RgLo, its_Rd_RgHi (a drag of the cell of the stretch)
function its_Rd_SpdRange(p, k)
local (lo, hi, sl)
(
    (k === 1) ? ( lo = 0; hi = 4; sl = 3; ) :
    (k === 2) ? ( lo = 0; hi = 1; sl = 5; ) :
    (k === 3) ? ( lo = -4; hi = 0; sl = -3; ) :
    (k === 4) ? ( lo = -1; hi = 0; sl = -5; ) :
    (k === 5) ? ( lo = -1; hi = 1; sl = 0; ) :
    (k === 6) ? ( lo = -SPDMAX; hi = SPDMAX; sl = 0; ) :
    (k === 7) ? ( lo = 0; hi = SPDMAX; sl = 5; ) :
    ( lo = -4; hi = 4; sl = 0; );
    (p > 0) ? ( parSetPP(p, pp_Max, hi); parSetPP(p, pp_Min, lo); parSetPP(p, pp_Slope, sl); );
    its_Rd_RgLo = lo; its_Rd_RgHi = hi;
);

// the settings of the modes Stretch and Brage in the cells 24 ... 28 (block, overlap, search, transposition, stretch :
// the fields its_Rdr_StBlkMs ...) : their range for a drag (ui_jdrag_start) its_RdSt_lo, its_RdSt_hi, its_RdSt_px,
// its_RdSt_fl (1 logarithmic, 2 integers), their default value its_RdSt_def ; returns the field (0 : not a setting) ;
// the stretch : the range of its slider (its_Rd_SpdRange, called before)
function its_RdSt_Range(c)
(
    (c === 24) ? ( its_RdSt_lo = 10; its_RdSt_hi = 5000; its_RdSt_px = 450; its_RdSt_fl = 3; its_RdSt_def = 60; its_Rdr_StBlkMs ) :
    (c === 25) ? ( its_RdSt_lo = 5; its_RdSt_hi = 50; its_RdSt_px = 180; its_RdSt_fl = 2; its_RdSt_def = 25; its_Rdr_StOvlPc ) :
    (c === 26) ? ( its_RdSt_lo = 0; its_RdSt_hi = 200; its_RdSt_px = 400; its_RdSt_fl = 0; its_RdSt_def = 12; its_Rdr_StSrchMs ) :
    (c === 27) ? ( its_RdSt_lo = -24; its_RdSt_hi = 24; its_RdSt_px = 480; its_RdSt_fl = 0; its_RdSt_def = 0; its_Rdr_StTransp ) :
    (c === 28) ? ( its_RdSt_lo = its_Rd_RgLo; its_RdSt_hi = its_Rd_RgHi; its_RdSt_px = 400; its_RdSt_fl = 0; its_RdSt_def = 1; its_Rdr_Stretch ) :
    0;
);

// the settings of the mode Grains in the cells 24 ... 29 and 32 ... 37 (as its_RdSt_Range ; the curve of the envelope,
// cell 30 : its_Gr_CrvClick ; cell 31 : the grains running)
function its_RdGr_Range(c)
(
    (c === 24) ? ( its_RdSt_lo = 10; its_RdSt_hi = 10000; its_RdSt_px = 500; its_RdSt_fl = 3; its_RdSt_def = 100; its_Rdr_GrSize ) :
    (c === 25) ? ( its_RdSt_lo = 1; its_RdSt_hi = 5; its_RdSt_px = 300; its_RdSt_fl = 0; its_RdSt_def = 1; its_Rdr_GrSizeR ) :
    (c === 26) ? ( its_RdSt_lo = 0; its_RdSt_hi = 100; its_RdSt_px = 300; its_RdSt_fl = 2; its_RdSt_def = 50; its_Rdr_GrPlat ) :
    (c === 27) ? ( its_RdSt_lo = 1; its_RdSt_hi = 5; its_RdSt_px = 300; its_RdSt_fl = 0; its_RdSt_def = 1; its_Rdr_GrPlatR ) :
    (c === 28) ? ( its_RdSt_lo = 0; its_RdSt_hi = 100; its_RdSt_px = 300; its_RdSt_fl = 2; its_RdSt_def = 50; its_Rdr_GrFade ) :
    (c === 29) ? ( its_RdSt_lo = 1; its_RdSt_hi = 5; its_RdSt_px = 300; its_RdSt_fl = 0; its_RdSt_def = 1; its_Rdr_GrFadeR ) :
    (c === 32) ? ( its_RdSt_lo = -20; its_RdSt_hi = 20; its_RdSt_px = 400; its_RdSt_fl = 0; its_RdSt_def = 0; its_Rdr_GrVol ) :
    (c === 33) ? ( its_RdSt_lo = 1; its_RdSt_hi = 5; its_RdSt_px = 300; its_RdSt_fl = 0; its_RdSt_def = 1; its_Rdr_GrVolR ) :
    (c === 34) ? ( its_RdSt_lo = 1; its_RdSt_hi = 5; its_RdSt_px = 300; its_RdSt_fl = 0; its_RdSt_def = 1; its_Rdr_GrSpdR ) :
    (c === 35) ? ( its_RdSt_lo = -1; its_RdSt_hi = 1; its_RdSt_px = 200; its_RdSt_fl = 0; its_RdSt_def = 1; its_Rdr_GrDir ) :
    (c === 36) ? ( its_RdSt_lo = 0.01; its_RdSt_hi = 100; its_RdSt_px = 450; its_RdSt_fl = 1; its_RdSt_def = 10; its_Rdr_GrDens ) :
    (c === 37) ? ( its_RdSt_lo = 0; its_RdSt_hi = 1; its_RdSt_px = 200; its_RdSt_fl = 0; its_RdSt_def = 1; its_Rdr_GrRand ) :
    0;
);

// the field of the setting of the cell "c" for the reader "r" (its_RdSt_Range ; the stretch : only in mode Stretch, in
// mode Brage the loop moves by itself ; mode Grains : its_RdGr_Range)
function its_RdSt_Field(r, c)
(
    (r[its_Rdr_Mode] === its_RdrMode_Grains) ? its_RdGr_Range(c) :
    ((c === 28) && (r[its_Rdr_Mode] !== its_RdrMode_Stretch)) ? 0 : its_RdSt_Range(c);
);

// the menu (menu_RdSt, its_RdSt_V) of the values of the setting of the cell "c" of the reader "r" ; -1 : none (the stretch
// has the menu of the range of its slider)
function its_RdSt_MenuK(r, c)
(
    (r[its_Rdr_Mode] === its_RdrMode_Grains) ? (
        (c === 24) ? 4 : ((c === 25) || (c === 27) || (c === 29) || (c === 33) || (c === 34)) ? 5 :
        ((c === 26) || (c === 28)) ? 6 : (c === 32) ? 7 : (c === 35) ? 8 : (c === 36) ? 9 : (c === 37) ? 10 : -1;
    ) :
    ((c >= 24) && (c <= 27)) ? c - 24 : -1;
);

// the menu of the values of the setting of the cell "c" of the reader "r" : the nearest value is ticked
function its_RdSt_Menu(r, c)
local (f, k, n, i, b, bd, d, m, xx)
(
    (((f = its_RdSt_Field(r, c)) > 0) && ((k = its_RdSt_MenuK(r, c)) >= 0)) ? (
        n = its_RdSt_Cnt[k]; m = menu_RdSt[k];
        b = 0; bd = 10^30; i = 0;
        loop(n, ((d = abs(its_RdSt_V[16 * k + i] - r[f])) < bd) ? ( bd = d; b = i; ); i += 1;);
        ui_menu_tick(m, -1, 0);
        (bd < 0.001) ? ui_menu_tick(m, b + 1, 1);
        xx = control_jmenu(m);
        (xx != 0) ? (r[f] = its_RdSt_V[16 * k + xx - 1]);
        ui_menu_tick(m, -1, 0);
    );
);

// a clic on the cell of the envelope of the grains (mode Grains, cell 30) of the reader "r" : left clic, the next curve
// that exists (after the last one : linear) ; Shift + clic ("sh") : linear ; right clic : the menu of the curves
function its_Gr_CrvClick(r, ev, sh) local(k, i, xx)
(
    k = r[its_Rdr_GrCurve] - 1; // (-1 : linear)
    (ev & ui_jpad_ev_rmc) ? (
        ui_menu_tick(menu_Crv_Ids, -1, 0);
        (k >= 0) ? (
            ui_menu_tick(menu_Crv_Ids, k + 1, 1);
            str_setchar(menu_Crv_Ids[ui_jmenu_items + (0|(k / menu_Crv_Grp)) * (menu_Crv_Grp + 1)], 1, '!'); // (its sub-menu)
        );
        xx = control_jmenu(menu_Crv_Ids);
        (xx != 0) ? (r[its_Rdr_GrCurve] = xx);
        ui_menu_tick(menu_Crv_Ids, -1, 0);
    ) :
    sh ? (
        r[its_Rdr_GrCurve] = 0;
    ) : (
        i = k + 1; while ((i < its_CrvMx) && (its_CrvBlk[i] <= BASE_MEMORY)) ( i += 1; );
        r[its_Rdr_GrCurve] = (i < its_CrvMx) ? i + 1 : 0;
    );
);

function show_Reader_Pad(RDBL, blockId)
local (x, h1, h2, h3, h4, h5, uix_jneed, uix_jmini, rdr, rcbl, rok, lnb, lcbl, dfCol, zzmi, i, xx, w, k, r, jmc,
        rp, zi, zz, zzch, zzent, zzmcl, zzmmd, p1, p2, newlnb, rerr, spd, d1, clen, mvl, rgh, rsc, p, c, f, dr, wy)
(
    h2 = (RDBL[5] > 0) ? ui_jd_slidh * RDBL[5] + 6 : 0;
    // waveform, between the pad and the sliders, if the reader has a line
    rcbl = Readers_set[RDBL[0]];
    // delay mode : only the first 2 lines of the pad (no transport line) ; mode Stretch : 4 (its settings)
    // (no reader yet : the mode chosen in cell 2, RDBL[1])
    h1 = uix_jpadHeight(its_Rd_PadLines(((rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read)) ? rcbl[its_Rdr_Mode] : RDBL[1])); // height
    h3 = ((rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read) && ((lcbl = rcbl[its_Rdr_Lcbl]) > BASE_MEMORY)
        && (lcbl[-2] === KW_lcbl)) ? its_Wave_H(RDBL + 8, RDBL + 10, its_RdrWaveH) : 0;
    h4 = ((rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read)) ? uix_jpadHeight(1) : 0; // the modulation inputs
    // under their line : the sliders of the inputs used (depth, attenuverter if shown)
    h5 = (h4 > 0) ? its_Mod_SlCount(rcbl + its_Rdr_Mod1, its_Rdr_ModN, its_Rdr_ModOk(rcbl)) : 0;
    h5 = (h5 > 0) ? ui_jd_slidh * h5 + 6 : 0;
    uix_jneed = h1+h2+h3+h4+h5+ui_jd_ctgr;
    uix_jmini = h1+h2+h4+h5+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(min(uix_jneed, ui_height()));
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            rdr = RDBL[0]; // number of reader to be displayed
            rcbl = Readers_set[rdr];
            rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            // 'd' : dump of the reader in the log (taken before the pad)
            (zzmi && GM_key_take('d')) ? GM_Dump(rcbl, its_Rdr_BlkSize, sprintf(#, "Reader %d", rdr+1));
            (zzmi) ? its_Wave_Keys(RDBL + 8, RDBL + 10, its_RdrWaveH);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
                (g__dpa != 0) ? (
                    // audio file droped here
                    sprintf(#s, "Reader::drop file : \"%s\" - %d, %d, %d", g__efs, g__msx, g__msy, g__msc);
                    mSL_log(SysLogBox, #s);
                    g__dpa = 0;
                    // should we create the reader ?
                    (!rok) ? (
                        // Create the reader
                        rcbl = Rd_Create(rdr);
                        rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
                    );
                    (rok) ? (
                        // Does this reader has a line ?
                        p1 = p2 = -1;
                        (((lnb = rcbl[its_Rdr_LineNb]) >= 0) && ((lcbl = rcbl[its_Rdr_Lcbl]) > BASE_MEMORY)
                            && (lcbl[-2] === KW_lcbl)) ? (
                            p1 = lnb; p2 = lcbl;
                        );
                        newlnb = File_Handle(g__efs, p1, p2);
                        ((newlnb >= 0)) ? (
                            // Update reader
                            Rd_Set_Line(rdr, newlnb+1);
                        );
                    );
                );
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Rdr_Labs, pad_Rdr_Siz);

                CL1 = Color_Cornflower_Blue;
                (rok) ? (
                    dfCol = Col_InfoA ;
                    RDBL[5] = (rcbl[its_Rdr_Mode] === its_RdrMode_Delay) ? 2 : // delay mode : volume and offset only
                        (h3 > 0) ? 9 : 8; // + "Zoom" slider when the waveform is shown
                    (rcbl[its_Rdr_Mode] !== its_RdrMode_Delay) ? (RDBL[5] += 2); // + "Loop speed", "Desync"
                    (rcbl[its_Rdr_Mode] === its_RdrMode_Stretch) ? (RDBL[5] += 1); // + "Stretch"
                    i = 0; loop(pad_Rdr_Siz,
                        pad_Rdr_Colrs[i] = dfCol;
                        strcpy(pad_Rdr_Labs[i],"");
                        i += 1;);
                    strcpy(pad_Rdr_Labs[2],menu_Rdr_Type_N[rcbl[its_Rdr_Mode]]);
                    pad_Rdr_Colrs[2] = dfCol;
                    strcpy(pad_Rdr_Labs[1],menu_Rdr_Status_N[rcbl[its_Rdr_Status]]);
                    // status : Ready (blue), Paused (orange), Reading (green), else the default color
                    k = rcbl[its_Rdr_Status];
                    pad_Rdr_Colrs[1] = (k === its_RdrStat_Ready) ? Color_Light_Steel_Blue :
                        (k === its_RdrStat_Paused) ? Color_Dark_Orange :
                        (k === its_RdrStat_Reading) ? Color_Limegreen : dfCol;
                    (rcbl[its_Rdr_LineNb] >= 0) ? (
                        sprintf(pad_Rdr_Labs[3], "Line %d", rcbl[its_Rdr_LineNb]+1);
                        sprintf(pad_Rdr_Labs[4], "Size %.3f s", floor(1000*rcbl[its_Rdr_SmplCnt]/srate)/1000);
                        sprintf(pad_Rdr_Labs[5], "Channels %d", rcbl[its_Rdr_ChNbr]);
                        sprintf(pad_Rdr_Labs[6], "First %d", rcbl[its_Rdr_Bf1stChan]);
                        sprintf(pad_Rdr_Labs[7], "Used %d", rcbl[its_Rdr_BfChanUsed]);
                        sprintf(pad_Rdr_Labs[11], "Out %d ch.", its_Rdr_OutWidth(rcbl));
                        sprintf(pad_Rdr_Labs[12], "Pos %.3f s", its_Rd_PosSmp(rcbl) / srate); // (as in the writer pad)
                        (rcbl[its_Rdr_Mode] !== its_RdrMode_Delay) ? sprintf(pad_Rdr_Labs[13], "Speed %.3f", rcbl[its_Rdr_Speed]);
                        pad_Rdr_Colrs[3] = pad_Rdr_Colrs[4] = pad_Rdr_Colrs[5] =
                        pad_Rdr_Colrs[6] = pad_Rdr_Colrs[7] = Color_Heliotrope;
                        its_Out_Label(pad_Rdr_Labs[10], rcbl[its_Rdr_OutK], rcbl[its_Rdr_OutOff]);
                    ) : (
                        strcpy(pad_Rdr_Labs[3], "Line: None"); // (a reader just created : no line yet)
                    );
                    // Mute
                    (rcbl[its_Rdr_StFlgs] & its_RdrFlg_mute) ? (
                        strcpy(pad_Rdr_Labs[8],"** Mute **");
                        pad_Rdr_Colrs[8] = Col_P6;
                    ) : (
                        strcpy(pad_Rdr_Labs[8],"Mute");
                        pad_Rdr_Colrs[8] = Col_P1;
                    );
                    // Solo
                    (rcbl[its_Rdr_StFlgs] & its_RdrFlg_solo) ? (
                        strcpy(pad_Rdr_Labs[9],"** Solo **");
                        pad_Rdr_Colrs[9] = Col_P7;
                    ) : (
                        strcpy(pad_Rdr_Labs[9],"Solo");
                        pad_Rdr_Colrs[9] = Col_P1;
                    );
                    pad_Rdr_Colrs[10] = Col_P3;
                    // the count of output channels : the count of channels used (the color of the output), or chosen
                    pad_Rdr_Colrs[11] = (rcbl[its_Rdr_OutCnt] > 0) ? Color_Goldenrod : Col_P3;
                    pad_Rdr_Colrs[12] = CL1;
                    pad_Rdr_Colrs[13] = (rcbl[its_Rdr_Mode] !== its_RdrMode_Delay) ? CL1 : Col_P1;
                    pad_Rdr_Colrs[14] = pad_Rdr_Colrs[15] = Col_P1;
                    // Delay mode : the writer to follow (right clic : menu)
                    (rcbl[its_Rdr_Mode] === its_RdrMode_Delay) ? (
                        (rcbl[its_Rdr_WrSrc] >= 0) ? (
                            sprintf(pad_Rdr_Labs[13], "Writer %d", rcbl[its_Rdr_WrSrc]+1);
                            pad_Rdr_Colrs[13] = Color_Heliotrope;
                        ) : (
                            strcpy(pad_Rdr_Labs[13], "Writer: None");
                        );
                    );
                    // Modes Stretch and Brage : their settings (line 4 ; a drag, Shift + clic : the default value, right clic :
                    // a menu ; the stretch : only in mode Stretch, right clic : the range of its slider, the range of a drag)
                    // and the lag applied to the current block (correlation)
                    its_Rd_Blocks(rcbl[its_Rdr_Mode]) ? (
                        its_Rd_SpdRange(0, RDBL[11]); // (the range of a drag of the stretch, its_RdSt_Range)
                        (rcbl[its_Rdr_StBlkMs] < 1000) ? sprintf(pad_Rdr_Labs[24], "Block %d ms", rcbl[its_Rdr_StBlkMs]) :
                            sprintf(pad_Rdr_Labs[24], "Block %.2f s", rcbl[its_Rdr_StBlkMs] / 1000);
                        sprintf(pad_Rdr_Labs[25], "Overlap %d %%", rcbl[its_Rdr_StOvlPc]);
                        (rcbl[its_Rdr_StSrchMs] > 0) ? sprintf(pad_Rdr_Labs[26], "Search %.1f ms", rcbl[its_Rdr_StSrchMs]) :
                            strcpy(pad_Rdr_Labs[26], "Search off");
                        w = rcbl[its_Rdr_StTransp];
                        (w > 0) ? sprintf(pad_Rdr_Labs[27], "Transp. +%.2f", w) : sprintf(pad_Rdr_Labs[27], "Transp. %.2f", w);
                        (rcbl[its_Rdr_Mode] === its_RdrMode_Stretch) ? sprintf(pad_Rdr_Labs[28], "Stretch %.3f", rcbl[its_Rdr_Stretch]);
                        sprintf(pad_Rdr_Labs[29], "Lag %.2f ms", 1000 * rcbl[its_Rdr_StLag] / (srate * max(0.01, rcbl[its_Rdr_AdjInc])));
                        i = 24; loop(5, f = its_RdSt_Field(rcbl, i);
                            pad_Rdr_Colrs[i] = (f <= 0) ? Col_Inactive : (rcbl[f] !== its_RdSt_def) ? Col_P2 : Col_P1; i += 1;);
                        pad_Rdr_Colrs[29] = Col_InfoA;
                        pad_Rdr_Colrs[30] = pad_Rdr_Colrs[31] = Col_Inactive;
                    );
                    // Mode Grains : its settings (lines 4 and 5 ; a drag, Shift + clic : the default value, right clic : a
                    // menu), the curve of the envelope (cell 30 : its_Gr_CrvClick ; golden, gray if it is not an envelope :
                    // linear ramps), the grains running (cell 31)
                    (rcbl[its_Rdr_Mode] === its_RdrMode_Grains) ? (
                        w = rcbl[its_Rdr_GrSize];
