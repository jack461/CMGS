/*
    the cables follow the modules : called at each frame of @gfx (and forced after a load)
    a reader or an effect whose output is its own cable gets a cable of its width, a bus used gets the width that its
    users ask (first channel + width), a bus no longer used is freed ; after a change, all the modules are checked again
    (their cells are computed again by exec_reader, exec_writer, exec_fx)
*/
function its_Patch_Update()
local (i, b, w, wk, chg, n)
(
    chg = its_PatchForce;
    its_PatchForce = 0;
    i = 0; loop(RD_CNT,
        b = Readers_set[i];
        w = ((b > BASE_MEMORY) && (b[-2] === KW_read) && (b[its_Rdr_OutK] === 0)) ? max(1, min(128, b[its_Rdr_BfChanUsed])) : 0;
        (w !== CblRdWidth[i]) ? (
            Cbl_Free(CblRdStart[i], CblRdWidth[i]);
            CblRdStart[i] = (w > 0) ? Cbl_Alloc(w) : 0;
            CblRdWidth[i] = w;
            chg = 1;
        );
        i += 1;
    );
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        w = ((b > BASE_MEMORY) && (b[-2] === KW_effx) && (b[its_Efx_OutK] === 0)) ? max(1, min(128, b[its_Efx_CCnt])) : 0;
        (w !== CblFxWidth[i]) ? (
            Cbl_Free(CblFxStart[i], CblFxWidth[i]);
            CblFxStart[i] = (w > 0) ? Cbl_Alloc(w) : 0;
            CblFxWidth[i] = w;
            chg = 1;
        );
        i += 1;
    );
    // the buses
    its_Patch_Scan(-2);
    i = 0; loop(NB_BUS,
        w = min(128, BusNeed[i]);
        (w !== BusWidth[i]) ? (
            Cbl_Free(BusStart[i], BusWidth[i]);
            BusStart[i] = (w > 0) ? Cbl_Alloc(w) : 0;
            BusWidth[i] = w;
            chg = 1;
        );
        i += 1;
    );
    (chg) ? (
        // the buses cleared at each sample (@sample)
        n = 0; i = 0; loop(NB_BUS,
            (BusStart[i] > 0) ? (BusAct[n] = i; n += 1;);
            i += 1;
        );
        BusActN = n;
    );
    // the work areas of the effects : a new one when the size changes (not during a load : @block replaces the effects)
    (perform_loading === 0) ? (
        i = 0; loop(FX_CNT,
            b = Effects_set[i];
            ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? (
                (b[its_Efx_WkOld] > BASE_MEMORY) ? (
                    mSL_Dyn_Free(b[its_Efx_WkOld]); // replaced by @block before the current audio block
                    b[its_Efx_WkOld] = 0;
