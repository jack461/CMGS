// the type "ty" of the effect "fx" (the pad, the tables) : the parameters of the new type get their default values
function FX_Set_Type(fx, ty)
local (k)
(
    k = fx[its_Efx_Type]; // the previous type
    fx[its_Efx_Type] = ty;
    fx[its_Efx_Check] = 0;
    (ty === its_Efx_TyAutoMix) ? FX_Auto_Gains(fx);
    ((ty === its_Efx_TyLFO) && (fx[its_Efx_Par1] === 0)) ? (
        fx[its_Efx_Par1] = 1; // 1 Hz
        fx[its_Efx_Par1 + 2] = 1; // amplitude 1
    );
    ((ty === its_Efx_TyFilter) && (fx[its_Efx_Par1] < 10)) ? (
        fx[its_Efx_Par1] = 1000; // 1 kHz
        fx[its_Efx_Par1 + 1] = 0.707; // Q
        fx[its_Efx_Par1 + 2] = its_FltLP; // biquad low pass
        fx[its_Efx_Par1 + 3] = 0; // 12 dB/oct
    );
    ((ty === its_Efx_TySat) && (k !== its_Efx_TySat)) ? (
        fx[its_Efx_Par1] = 12; // drive (dB)
        fx[its_Efx_Par1 + 1] = its_SatSoft;
        fx[its_Efx_Par1 + 2] = 0; // bias
        fx[its_Efx_Par1 + 3] = 1; // mix : 100 %
        fx[its_Efx_Par1 + 4] = 2; // oversampling 4x
        fx[its_Efx_Par1 + 5] = -6; // output (dB)
        fx[its_Efx_Par1 + 6] = 3; // order (x - sin, Chebyshev)
        fx[its_Efx_Par1 + 7] = 1; // stretch (Cheb. sum)
        fx[its_Efx_Par1 + 8] = 1; // A (x - A sin)
        fx[its_Efx_Lim] = 1; // the auto-limiter in service
        its_Harm_Preset(fx + its_Efx_Harm1, 0); // the fundamental only
    );
);


