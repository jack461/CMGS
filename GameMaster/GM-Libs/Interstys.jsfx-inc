                        );
                    );
                );
            );
            i += 1;
        );
    );
    (chg) ? (
        its_PatchV += 1;
        i = 0; loop(RD_CNT+1, ((b = Readers_set[i]) > BASE_MEMORY) ? (b[its_Rdr_Check] = 0); i += 1;);
        i = 0; loop(WR_CNT+1, ((b = Writers_set[i]) > BASE_MEMORY) ? (b[its_Wrt_Check] = 0); i += 1;);
        i = 0; loop(FX_CNT+1, ((b = Effects_set[i]) > BASE_MEMORY) ? (b[its_Efx_Check] = 0); i += 1;);
    );
);


/*
    The execution order of the effects in @sample : in each phase, an effect runs after the effects whose output it reads (their
    own cable, a bus, Out : sources and modulation inputs) ; the effects of a loop (feedback) keep the order of their numbers
    (one sample of delay), and so do the independent ones. Computed by @gfx (its_Fx_Order, when its signature changes), put in
    place by @block between two audio blocks (its_Fx_OrderSwitch) : its_FxOrd[0 ... FX_CNT-1], the effects that exist first.
*/
its_FxOrd = make_array(FX_CNT); its_FxOrdNew = make_array(FX_CNT); its_FxOrdRdy = 0;
i__ii = 0; loop(FX_CNT, its_FxOrd[i__ii] = i__ii; i__ii += 1;);
its_FxLst = make_array(FX_CNT); // the effects that exist
its_FxWK = make_array(FX_CNT); // the key of the cells each one writes (its_Fx_WKey)
its_FxDeg = make_array(FX_CNT); // the count of the effects not yet placed that it reads
