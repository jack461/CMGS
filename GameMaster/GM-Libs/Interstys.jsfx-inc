        (sh && (e !== hd[5])) ? ( hd[5] = e; tb[0] = 0; c = 1; loop(its_NzTN, tb[c] = (c / its_NzTN) ^ e; c += 1;); );
        cb = sh ? sqrt((2 * e + 1) / 3) : 1; cp = sh ? cb ^ 0.75 : 1;
        // the weights of the colors : one of them, or (Mix) the two around the tilt (-6 Brown, -3 Pink, 0 White, +6 Violet)
        mx ? (
            tl = max(-6, min(6, fx[its_Efx_Par1 + 7]));
            ww = wp = wb = wv = 0;
            (tl < -3) ? ( wp = (tl + 6) / 3; wb = 1 - wp; ) : (tl < 0) ? ( ww = (tl + 3) / 3; wp = 1 - ww; ) : ( wv = tl / 6; ww = 1 - wv; );
        ) : (
            ww = (cl === its_NzWhite); wp = (cl === its_NzPink); wb = (cl === its_NzBrown); wv = (cl === its_NzViolet);
        );
        wp *= cp * its_NzPkG; wb *= cb * its_NzBrC; wv *= its_NzViG;
