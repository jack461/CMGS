/*
=== PARAMETERS DCL ===
*/
function
initAllParameters()
local(ix)
(
    // do some default init. We keep the name uninitialized.
    ix = 0;
    loop(paramCount,
        parDcl(ix, #pUndef, #pUndef, 0, "-", "-", 0, 1, 0, 0.1, 0);
        ix += 1;
    );
    paramBlock[pp_Name] = "(unused)"; // this "locks" entry 0.
    menu_Param_mSL = 0;
    menu_Param_UBS = 0;
    menu_Param_UBD = 0;
    parDclMode = 0xf;
);

function
dclAllParameters()
local (ix, p, pdx, pp, pb, ii, ix, iy, u, w,mi, ma)
(
    paramBlock[pp_Name] = "(unused)"; // this "locks" entry 0.
    p = 2; // potentiometer curve for amplitude


    parDcl(p_uix_jtheme, "UI Theme",  "UITheme",   0,      "%d",   "UI Theme: %d", 0, 16, 0, 1, 0);

    parDcl(p_playSpeed, "Play Speed", "PlaySpd", i_UB|i_SP, "%.3f",  "Play Speed: %.3f", -SPDMAX, SPDMAX, 1, 0.001, 0);

    parDcl(p_playVol, "Play Volume",  "PlayVol",  i_UB|i_SP, "%.1f dB", "Play Volume: %.1f dB",   -120,   20,    0,  0.1, -3);

    parDcl(p_lineSize, "Line size",  "LineSize",  i_UB|i_SP, "%.3f s", "Line Size: %.3f s",   1,   3600,    1,  0.001, 3);

    parDcl(p_playPos, "Play position",  "PlayPos",  i_UB|i_SP, "%.3f s", "Play position: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Low, "Loop Low Lim.",  "LoopLLim",  i_UB|i_SP, "%.3f s", "Loop Low Lim.: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_High, "Loop High Lim.",  "LoopHLim",  i_UB|i_SP, "%.3f s", "Loop High Lim.: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Pos, "Loop position",  "LoopRPos",  i_UB|i_SP, "%.3f s", "Loop position: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Len, "Loop Length",  "LoopRLen",  i_UB|i_SP, "%.5f s", "Loop Length: %.5f s",   0.00001,   3600,    0,  0.00001, 6);
    parDcl(p_play_XFade, "Cross Fade", "CrssFade", i_UB|i_SP, "%.2f ms", "Cross Fade : %.2f ms", 0.01, 20000, 10, 0.01, 6);
);



/*
    Try to read a file in a line new or existing
*/
function File_Handle(fname, lnb, lcbl)
local (FFrRate, FlCC, Fhandle, Fformat, FFSize, cbfsiz, bread, ptbuf, bcnt, addbuffs, rdcnt,
        rc, i, pb, ends)
(
    FFrRate = FlCC = its_FilErr = 0;
    Fhandle = file_open(fname);
    Fformat = 1;
    (Fhandle < 0) ? (
        its_FilErr = 400;
    ) :
    (
        file_riff(Fhandle, FlCC, FFrRate);
        (FlCC < 1) ? (
            its_FilErr = 401;
        ) :
        (FlCC > 128) ? (
            its_FilErr = 402;
        ) :
        ((FFrRate < 2400) || (FFrRate > 384000)) ? (
            its_FilErr = 403;
        ) :
        (
            FAdjRate = FFrRate / srate;
            FFSize = file_avail(Fhandle); // Size for all samples
            (FFSize <= 480) ? (
                its_FilErr = 408;
            ); // File too short
        );
    );

    sprintf(#s, "File-1  %d  %d=[%d  / %d]  %.5f  %d", its_FilErr, Fhandle, FlCC, FFrRate, FAdjRate, FFSize);
    mSL_log(SysLogBox, #s);

    (its_FilErr === 0) ? (
        // channels buffer sizes
        cbfsiz = FFSize / FlCC + BF_LIM * 2;
        bflen = FFSize / FlCC; // durée d'un buffer
        // Is the line already existing ?
        ((lnb < 0) || (lcbl < BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)
            || (lcbl[its_Lin_SmplCnt] < cbfsiz) || (lcbl[its_Lin_ChCnt] != FlCC)) ? (
            // We need a larger buffer
            lnb = lcbl = -1;
        );
        (lnb < 0) ? (
            // Create the appropriate buffer
            lnb = Ln_New();
            (lnb < 0) ? (
                its_FilErr = 411;
            ) : (
                lcbl = Ln_Make(lnb, srate, bflen/srate, FlCC);
                (lcbl === 0) ? (
                    its_FilErr = 412;
                );
            );
        );
    );

    (its_FilErr === 0) ? (
        // On va lire par blocs de BFFSIZ samples
        bread = 0; // what has been read
        ptbuf = BF_LIM; // start adress in buffer
        bcnt = FlCC * floor(BFFSIZ/FlCC); // How much to read in one call
        addbuffs = lcbl + its_Lin_BF1ST;
        while (bread < FFSize) (
            rdcnt = min(bcnt, FFSize - bread);
            rc = file_mem(Fhandle, savwrk, rdcnt);
            (rc != rdcnt) ? (
                its_FilErr = 416;
                bread = FFSize;
            ) : (
                // Update buffers
                i = 0; while (i < rdcnt) (
                    pb = addbuffs[i % FlCC];
                    pb[ptbuf] = savwrk[i];
                    i += 1;
                    ((i % FlCC) === 0) ? ptbuf += 1;
                );
            );
            bread += rdcnt;
        );
    );

    (its_FilErr === 0) ? (
        ends = FFSize / FlCC;
        lcbl[its_Lin_RecFreq] = FFrRate;
        lcbl[its_Lin_Used] = ends + BF_LIM;
        // Duplicate start and end samples in the buffer
        i = 0; loop (FlCC,
            pb = addbuffs[i];
            memcpy(pb, pb + ends, BF_LIM);
            memcpy(pb+ends + BF_LIM, pb + BF_LIM, BF_LIM);
            i += 1;
        );
    ) : (
        lnb = -1;
    );

    sprintf(#s, "File-2  %d  %d; lin=%d  %f  ptb=%d", its_FilErr, Fhandle, lnb, ends, ptbuf);
    mSL_log(SysLogBox, #s);

    file_close(Fhandle);
    Fhandle = -1;

    // Return the actual line number
    lnb;
);


/*
    Execute a read - the reader is defined and in status "reading"
*/
function exec_reader(reader, nbr)
local (lcbl, wcbl, k, act, ty, w, s, d, f, it, lcn, vol, val, val_aux, mdr, loc, loc_aux, SP, A, A_aux, playing)
(
    its_RdrErrXe = (reader[its_Rdr_Check] !== BLOCK_CHECK);
    (its_RdrErrXe) ? (
        L__104 += 10000;
        // recheck all structure
        ((reader <= BASE_MEMORY) || (reader[-2] !== KW_read)) ? (
            its_RdrErrXe = 260; // erreur - reader is not a block
        ) :
        (reader[its_Rdr_Mode] === its_RdrMode_Read) ? (
            (((lcbl = reader[its_Rdr_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ? (
                its_RdrErrXe = 264; // erreur - line is not a block
            ) :
            ((reader[its_Rdr_Unuz1] != SECURE_BL) || (reader[its_Rdr_Unuz2] != SECURE_BL)) ? (
                its_RdrErrXe = 265; // erreur - reader block damaged
            ) :
            ((Lines_Set[reader[its_Rdr_LineNb]] != lcbl) || (reader[its_Rdr_ChNbr] != lcbl[its_Lin_ChCnt])) ? (
                its_RdrErrXe = 266; // erreur - line mismatched
            ) : (
                (lcbl[its_Lin_Check] !== BLOCK_CHECK) ? (
                    Ln_Check(reader[its_Rdr_LineNb]);
                );
                ((reader[its_Rdr_Start] != lcbl[its_Lin_Start])
                    || (reader[its_Rdr_Last] != lcbl[its_Lin_Last])) ? (
                    reader[its_Rdr_Start] = lcbl[its_Lin_Start];
                    reader[its_Rdr_Last] = lcbl[its_Lin_Last];
                    reader[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
                );
                ((reader[its_Rdr_Abspos] < reader[its_Rdr_Start])
                    || (reader[its_Rdr_Abspos] > reader[its_Rdr_Last])) ? (
                    reader[its_Rdr_Abspos] = reader[its_Rdr_Start];
                );
                reader[its_Rdr_Check] = BLOCK_CHECK;
                its_RdrErrXe = 0;
            );
        ) :
        (reader[its_Rdr_Mode] === its_RdrMode_Folwr) ? (
            L__104 += 100;
            (((wcbl = reader[its_Rdr_WrBPtr]) <= BASE_MEMORY) || (wcbl[-2] !== KW_writ)) ? (
                its_RdrErrXe = 150; // writer referenced is not a block
            ) :
            (((lcbl = wcbl[its_Wrt_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ? (
                its_RdrErrXe = 154; // line is not a block
            ) : (
                reader[its_Rdr_Lcbl] = lcbl;
                ((reader[its_Rdr_Start] != lcbl[its_Lin_Start])
                    || (reader[its_Rdr_Last] != lcbl[its_Lin_Last])) ? (
                    reader[its_Rdr_Start] = lcbl[its_Lin_Start];
                    reader[its_Rdr_Last] = lcbl[its_Lin_Last];
                    reader[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
                );
                reader[its_Rdr_WOffsetSmp] = max(1, min(reader[its_Rdr_WOffsetSmp], reader[its_Rdr_SmplCnt]));
                reader[its_Rdr_WOffset] = floor(0.5 + 1000*reader[its_Rdr_WOffsetSmp]/srate)/1000;
                rdupdt = 1;
                reader[its_Rdr_Check] = BLOCK_CHECK;
                its_RdrErrXe = 0;
                    L__104 += 1;
            );
        ) : (
            its_RdrErrXe = 130; // erreur - unknown exec mode
        );
    );



    (its_RdrErrXe === 0) ? (
        flgs = reader[its_Rdr_StFlgs];
        (flgs & its_RdrFlg_Mod) ? (
            // Update the reader
            Rd_Update(nbr);
        );
        playing = !(((flgs & its_RdrFlg_mute) || (its_RdrSolos !== 0)) && (!(flgs & its_RdrFlg_solo)));
    );



    (its_RdrErrXe === 0) ? (
        lcbl = reader[its_Rdr_Lcbl]; // the line
        lcn = reader[its_Rdr_BfChanUsed]; // count of used channels
        vol = reader[its_Rdr_OutVol]; // output read volume
        mdr = reader[its_Rdr_Mode]; // reader mode

        (mdr === its_RdrMode_Read) ? (
            // Mode reader
            loc = reader[its_Rdr_Abspos]; // loc is the index to read
            it = (loc === floor(loc)); // true if reading at integer positions
            ty = reader[its_Rdr_LoopType];
            // Are we in X-cross mode ?
            (reader[its_Rdr_XFadeCnt] > 0) ? (
                reader[its_Rdr_Tmp0] += 1;
                (playing) ? (
                    // Perform a double cross fade reading
                    // SP is the (increasing) index in the sinus table
                    SP = floor(reader[its_Rdr_XFadeIdxPos]);
                    A = sinus_table[SP]; // sin(x)
                    A_aux = sinus_table[SINUS_TABLE_SIZE - SP]; // cos(x)
                    loc_aux = reader[its_Rdr_AbsAuxpos]; // auxiliary read pointer; will finally disappear
                    l_valid = (loc >= reader[its_Rdr_Low]) && (loc <= reader[its_Rdr_High]);
                    lax_valid = (loc_aux >= reader[its_Rdr_Low]) && (loc_aux <= reader[its_Rdr_High]);
                    s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan]; // index of 1st buffer to read
                    val = val_aux = 0;
                    loop(lcn,
                        bfr = lcbl[s + d]; // the buffer to read
                        (bfr === 0) ? (
                            val = val_aux = 0;
                        ) : (
                            (it) ? (
                                // Read as integers
                                l_valid ? (val = bfr[loc]);
                                lax_valid ? (val_aux = bfr[loc_aux]);
                            ) : (
                                // Read as fractionnal
                                l_valid ? (val = inter_cube(bfr, loc));
                                lax_valid ? (val_aux = inter_cube(bfr, loc_aux));
                            );
                        );
                        smpl_tab[reader[its_Rdr_RCell] + s] += vol * (val * A + val_aux * A_aux);
                        s += 1;
                    );
                );
                // Update now the future position
                reader[its_Rdr_XFadeIdxPos] += reader[its_Rdr_XFadeIncr];
                reader[its_Rdr_Abspos] += reader[its_Rdr_AbsInc] * reader[its_Rdr_AdjInc];
                reader[its_Rdr_AbsAuxpos] += reader[its_Rdr_AbsInc] * reader[its_Rdr_AdjInc];
                reader[its_Rdr_XFadeCnt] -= 1;
                (reader[its_Rdr_XFadeCnt] <= 0) ? (
                    (reader[its_Rdr_Abspos] < MIN_VALUE) &&
                        ((ty === its_RdrLoopTypeOnce) || (ty === its_RdrLoopTypeExit) || (ty === its_RdrLoopTypeStop)) ? (
                        reader[its_Rdr_Tmp2] += 1;
                        // time to stop
                        Rd_Do_Stop(reader, nbr);
                    ) : (
                        reader[its_Rdr_Abspos] = max(reader[its_Rdr_Start], min(reader[its_Rdr_Last], reader[its_Rdr_Abspos]));
                    );
                );
            ) : (
                // Mode read standard
                (playing) ? (
                    s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan];
                    loop(lcn,
                        bfr = lcbl[s + d]; // the buffer to read
                        (bfr === 0) ? (
                            val = 0;
                        ) : (
                            (it) ? (
                                // Read as integers
                                val = bfr[loc];
                            ) : (
                                // Read as fractionnal
                                val = inter_cube(bfr, loc);;
                            );
                        );
                        smpl_tab[reader[its_Rdr_RCell] + s] += vol * val;
                        s += 1;
                    );
                );
                // Update now the future position
                reader[its_Rdr_Abspos] += reader[its_Rdr_AbsInc] * reader[its_Rdr_AdjInc];


                s = 0;
                // Has a change in position been requested ?
                ((w = reader[its_Rdr_NxtPosSec]) >= 0) ? (
