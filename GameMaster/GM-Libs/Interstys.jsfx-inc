    parDcl(p_rdModDepth1+1, "Speed depth",  "RdModSpd",  i_UB|i_SP, "%.4f", "Speed depth: %.4f",   0,   32,    0.1,  0.0001, 5);
    parDcl(p_rdModDepth1+2, "Volume depth",  "RdModVol",  i_UB|i_SP, "%.3f", "Volume depth: %.3f",   0,   2,    0.5,  0.001, 0);
    parDcl(p_rdModAtt1, "Offset atten.",  "RdAttOff",  i_UB|i_SP, "%.3f", "Offset atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_rdModAtt1+1, "Speed atten.",  "RdAttSpd",  i_UB|i_SP, "%.3f", "Speed atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_rdModAtt1+2, "Volume atten.",  "RdAttVol",  i_UB|i_SP, "%.3f", "Volume atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_fxLfoFreq, "LFO Frequency",  "LfoFreq",  i_UB|i_SP, "%.3f Hz", "LFO Frequency: %.3f Hz",   0.001,   10000,    1,  0.001, 14); // exponential : about 9 Hz at the middle
    parDcl(p_fxLfoAmp, "LFO Amplitude",  "LfoAmp",  i_UB|i_SP, "%.3f", "LFO Amplitude: %.3f",   0,   10,    1,  0.001, 4.5); // exponential : 1 near the middle
    parDcl(p_fxLfoDC, "LFO Offset",  "LfoDC",  i_UB|i_SP, "%.3f", "LFO Offset: %.3f",   -10,   10,    0,  0.001, 0);
    parDcl(p_fxLfoSpread, "LFO Phase spread",  "LfoSprd",  i_UB|i_SP, "%.3f", "LFO Phase spread: %.3f",   0,   1,    0,  0.001, 0);
    parDcl(p_wrModDepth1, "Gain depth",  "WrModGn",  i_UB|i_SP, "%.1f dB", "Gain depth: %.1f dB",   0,   60,    6,  0.1, 2);
    parDcl(p_wrModDepth1+1, "Overdub depth",  "WrModOv",  i_UB|i_SP, "%.1f %%", "Overdub depth: %.1f %%",   0,   150,    20,  0.1, 0);
    parDcl(p_wrModAtt1, "Gain atten.",  "WrAttGn",  i_UB|i_SP, "%.3f", "Gain atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_wrModAtt1+1, "Overdub atten.",  "WrAttOv",  i_UB|i_SP, "%.3f", "Overdub atten.: %.3f",   -10,   10,    1,  0.001, 0);
    // exponential : about 600 Hz in the middle of the slider
    parDcl(p_fxFltFreq, "Cutoff",  "FltFreq",  i_UB|i_SP, "%.1f Hz", "Cutoff: %.1f Hz",   1,   20000,    1000,  0.1, 7);
    parDcl(p_fxFltQ, "Resonance",  "FltQ",  i_UB|i_SP, "%.3f", "Resonance (Q): %.3f",   0.1,   1000,    0.707,  0.001, 9);
    parDcl(p_fxFltModD1, "Cutoff depth",  "FltModF",  i_UB|i_SP, "%.3f oct", "Cutoff depth: %.3f oct",   0,   10,    2,  0.001, 2);
    parDcl(p_fxFltModD1+1, "Resonance depth",  "FltModQ",  i_UB|i_SP, "%.3f oct", "Resonance depth: %.3f oct",   0,   4,    1,  0.001, 2);
    parDcl(p_fxFltModA1, "Cutoff atten.",  "FltAttF",  i_UB|i_SP, "%.3f", "Cutoff atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_fxFltModA1+1, "Resonance atten.",  "FltAttQ",  i_UB|i_SP, "%.3f", "Resonance atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_fxSatDrive, "Drive",  "SatDrive",  i_UB|i_SP, "%.1f dB", "Drive: %.1f dB",   0,   96,    12,  0.1, 0);
    parDcl(p_fxSatBias, "Bias",  "SatBias",  i_UB|i_SP, "%.3f", "Bias: %.3f",   -4,   4,    0,  0.001, 0);
    parDcl(p_fxSatMix, "Mix",  "SatMix",  i_UB|i_SP, "%.1f %%", "Mix: %.1f %%",   0,   100,    100,  0.1, 0);
    parDcl(p_fxSatOut, "Output",  "SatOut",  i_UB|i_SP, "%.1f dB", "Output: %.1f dB",   -48,   24,    0,  0.1, 0);
    parDcl(p_fxSatOrder, "Order",  "SatOrder",  i_UB|i_SP, "%.3f", "Order (n): %.3f",   0,   32,    3,  0.001, 2);
    parDcl(p_fxSatAmp, "Sine amount",  "SatAmp",  i_UB|i_SP, "%.3f", "Sine amount (A): %.3f",   -8,   8,    1,  0.001, 0);
    parDcl(p_fxSatStretch, "Stretch",  "SatStrch",  i_UB|i_SP, "%.3f", "Stretch: %.3f",   0,   16,    1,  0.001, 2);
    parDcl(p_fxSatModD1, "Drive depth",  "SatModD",  i_UB|i_SP, "%.1f dB", "Drive depth: %.1f dB",   0,   96,    12,  0.1, 0);
    parDcl(p_fxSatModD1+1, "Bias depth",  "SatModB",  i_UB|i_SP, "%.3f", "Bias depth: %.3f",   0,   4,    0.5,  0.001, 0);
    parDcl(p_fxSatModA1, "Drive atten.",  "SatAttD",  i_UB|i_SP, "%.3f", "Drive atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_fxSatModA1+1, "Bias atten.",  "SatAttB",  i_UB|i_SP, "%.3f", "Bias atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_fxSatModD1+2, "Order depth",  "SatModO",  i_UB|i_SP, "%.3f", "Order depth: %.3f",   0,   32,    2,  0.001, 2);
    parDcl(p_fxSatModA1+2, "Order atten.",  "SatAttO",  i_UB|i_SP, "%.3f", "Order atten.: %.3f",   -10,   10,    1,  0.001, 0);
);



/*
    Try to read a file in a line new or existing
*/
function File_Handle(fname, lnb, lcbl)
local (FFrRate, FlCC, Fhandle, Fformat, FFSize, cbfsiz, bread, ptbuf, bcnt, addbuffs, rdcnt,
        rc, i, pb, ends, its_FilErr, bflen)
(
    FFrRate = FlCC = its_FilErr = 0;
    Fhandle = file_open(fname);
    Fformat = 1;
    (Fhandle < 0) ? (
        its_FilErr = 400;
    ) :
    (
        file_riff(Fhandle, FlCC, FFrRate);
        (FlCC < 1) ? (
            its_FilErr = 401;
        ) :
        (FlCC > 128) ? (
            its_FilErr = 402;
        ) :
        ((FFrRate < 2400) || (FFrRate > 384000)) ? (
            its_FilErr = 403;
        ) :
        (
            FAdjRate = FFrRate / srate;
            FFSize = file_avail(Fhandle); // Size for all samples
            (FFSize <= 480) ? (
                its_FilErr = 408;
            ); // File too short
        );
    );

    sprintf(#s, "File-1  %d  %d=[%d  / %d]  %.5f  %d", its_FilErr, Fhandle, FlCC, FFrRate, FAdjRate, FFSize);
    mSL_log(SysLogBox, #s);

    (its_FilErr === 0) ? (
        // channels buffer sizes
        cbfsiz = FFSize / FlCC + BF_LIM * 2;
        bflen = FFSize / FlCC; // durée d'un buffer
        // Is the line already existing ?
        ((lnb < 0) || (lcbl < BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)
            || (lcbl[its_Lin_SmplCnt] < cbfsiz) || (lcbl[its_Lin_ChCnt] != FlCC)) ? (
            // We need a larger buffer
            lnb = lcbl = -1;
        );
        (lnb < 0) ? (
            // Create the appropriate buffer
            lnb = Ln_New();
            (lnb < 0) ? (
                its_FilErr = 411;
            ) : (
                lcbl = Ln_Make(lnb, srate, bflen/srate, FlCC);
                (lcbl === 0) ? (
                    its_FilErr = 412;
                );
            );
        );
    );

    (its_FilErr === 0) ? (
        // On va lire par blocs de BFFSIZ samples
        bread = 0; // what has been read
        ptbuf = BF_LIM; // start adress in buffer
        bcnt = FlCC * floor(BFFSIZ/FlCC); // How much to read in one call
        addbuffs = lcbl + its_Lin_BF1ST;
        while (bread < FFSize) (
            rdcnt = min(bcnt, FFSize - bread);
            rc = file_mem(Fhandle, savwrk, rdcnt);
            (rc != rdcnt) ? (
                its_FilErr = 416;
                bread = FFSize;
            ) : (
                // Update buffers
                i = 0; while (i < rdcnt) (
                    pb = addbuffs[i % FlCC];
                    pb[ptbuf] = savwrk[i];
                    i += 1;
                    ((i % FlCC) === 0) ? ptbuf += 1;
                );
            );
            bread += rdcnt;
        );
    );

    (its_FilErr === 0) ? (
        ends = FFSize / FlCC;
        lcbl[its_Lin_RecFreq] = FFrRate;
        lcbl[its_Lin_Used] = ends + BF_LIM;
        // Duplicate start and end samples in the buffer
        i = 0; loop (FlCC,
            pb = addbuffs[i];
            memcpy(pb, pb + ends, BF_LIM);
            memcpy(pb+ends + BF_LIM, pb + BF_LIM, BF_LIM);
            i += 1;
        );
    ) : (
        lnb = -1;
    );

    (lnb >= 0) ? strcpy(its_LnFile[lnb], fname); // the file of the line
    sprintf(#s, "File-2  %d  %d; lin=%d  %f  ptb=%d", its_FilErr, Fhandle, lnb, ends, ptbuf);
    mSL_log(SysLogBox, #s);

    file_close(Fhandle);
    Fhandle = -1;

    // Return the actual line number
    lnb;
);


/*
    Execute a read - the reader is defined and in status "reading"
*/
function exec_reader(reader, nbr)
local (lcbl, wcbl, k, act, ty, w, s, d, f, it, lcn, vol, val, val_aux, mdr, loc, loc_aux, SP, A, A_aux, playing, l_valid, lax_valid, wps, oc,
        mp, c, inc, dm, off)
(
    its_RdrErrXe = (reader[its_Rdr_Check] !== BLOCK_CHECK);
    (its_RdrErrXe) ? (
        L__104 += 10000;
        // recheck all structure
        ((reader <= BASE_MEMORY) || (reader[-2] !== KW_read)) ? (
            its_RdrErrXe = 260; // erreur - reader is not a block
        ) :
        (reader[its_Rdr_Mode] === its_RdrMode_Read) ? (
            (((lcbl = reader[its_Rdr_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ? (
                its_RdrErrXe = 264; // erreur - line is not a block
            ) :
            ((reader[its_Rdr_Unuz1] != SECURE_BL) || (reader[its_Rdr_Unuz2] != SECURE_BL)) ? (
                its_RdrErrXe = 265; // erreur - reader block damaged
            ) :
            ((Lines_Set[reader[its_Rdr_LineNb]] != lcbl) || (reader[its_Rdr_ChNbr] != lcbl[its_Lin_ChCnt])) ? (
                its_RdrErrXe = 266; // erreur - line mismatched
            ) : (
                (lcbl[its_Lin_Check] !== BLOCK_CHECK) ? (
                    Ln_Check(reader[its_Rdr_LineNb]);
                );
                ((reader[its_Rdr_Start] != lcbl[its_Lin_Start])
                    || (reader[its_Rdr_Last] != lcbl[its_Lin_Last])) ? (
                    reader[its_Rdr_Start] = lcbl[its_Lin_Start];
                    reader[its_Rdr_Last] = lcbl[its_Lin_Last];
                    reader[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
                );
                ((reader[its_Rdr_Abspos] < reader[its_Rdr_Start])
                    || (reader[its_Rdr_Abspos] > reader[its_Rdr_Last])) ? (
                    reader[its_Rdr_Abspos] = reader[its_Rdr_Start];
                );
                reader[its_Rdr_Check] = BLOCK_CHECK;
                its_RdrErrXe = 0;
            );
        ) :
        (reader[its_Rdr_Mode] === its_RdrMode_Delay) ? (
            L__104 += 100;
            (((wcbl = reader[its_Rdr_WrBPtr]) <= BASE_MEMORY) || (wcbl[-2] !== KW_writ)) ? (
                its_RdrErrXe = 150; // writer referenced is not a block
            ) :
            (((lcbl = wcbl[its_Wrt_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ? (
                its_RdrErrXe = 154; // line is not a block
            ) : (
                reader[its_Rdr_Lcbl] = lcbl;
                reader[its_Rdr_LineNb] = wcbl[its_Wrt_LineNb]; // the line of the writer may have changed
                reader[its_Rdr_ChNbr] = lcbl[its_Lin_ChCnt];
                reader[its_Rdr_Bf1stChan] = 0;
                reader[its_Rdr_BfChanUsed] = (reader[its_Rdr_BfChanUsed] > 0) ? min(reader[its_Rdr_BfChanUsed], lcbl[its_Lin_ChCnt]) : lcbl[its_Lin_ChCnt];
                ((reader[its_Rdr_Start] != lcbl[its_Lin_Start])
                    || (reader[its_Rdr_Last] != lcbl[its_Lin_Last])) ? (
                    reader[its_Rdr_Start] = lcbl[its_Lin_Start];
                    reader[its_Rdr_Last] = lcbl[its_Lin_Last];
                    reader[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
                );
                reader[its_Rdr_WOffsetSmp] = max(1, min(reader[its_Rdr_WOffsetSmp], reader[its_Rdr_SmplCnt]));
                reader[its_Rdr_WOffset] = reader[its_Rdr_WOffsetSmp]/srate; // exact, not rounded to the ms
                rdupdt = 1;
                reader[its_Rdr_Check] = BLOCK_CHECK;
                its_RdrErrXe = 0;
                    L__104 += 1;
            );
        ) : (
            its_RdrErrXe = 130; // erreur - unknown exec mode
        );
        (its_RdrErrXe === 0) ? (
            // the output : own cable, or a bus ; an error is not fatal (the samples go to the trash cells)
            oc = its_Out_Cell(reader[its_Rdr_OutK], reader[its_Rdr_OutOff], reader[its_Rdr_BfChanUsed], CblRdStart[nbr], CblRdWidth[nbr]);
            (oc > 0) ? (
                reader[its_Rdr_OutCell] = oc;
                reader[its_Rdr_OutAdd] = (reader[its_Rdr_OutK] !== 0);
                reader[its_Rdr_Error] = 0;
            ) : (
                reader[its_Rdr_OutCell] = TRASH_P;
                reader[its_Rdr_OutAdd] = 0;
                reader[its_Rdr_Check] = 0; // checked again at the next sample
                reader[its_Rdr_Error] = 2711; // erreur : the output (own cable or bus) is not valid
            );
            // the modulation inputs (1 channel each) : an error is not fatal (no modulation)
            its_Mod_Resolve(reader + its_Rdr_Mod1, 3) ? (
                reader[its_Rdr_Check] = 0; // checked again at the next sample
                reader[its_Rdr_Error] = 2713; // erreur : a modulation input is not valid
            );
        );
    );



    (its_RdrErrXe === 0) ? (
        flgs = reader[its_Rdr_StFlgs];
        (flgs & its_RdrFlg_Mod) ? (
            // Update the reader
            Rd_Update(nbr);
        );
        playing = !(((flgs & its_RdrFlg_mute) || (its_RdrSolos !== 0)) && (!(flgs & its_RdrFlg_solo)));
    );



    (its_RdrErrXe === 0) ? (
        lcbl = reader[its_Rdr_Lcbl]; // the line
        lcn = reader[its_Rdr_BfChanUsed]; // count of used channels
        vol = reader[its_Rdr_OutVol] * (1 + its_Mod_Val(reader + its_Rdr_Mod1 + 2 * its_ModDist)); // output volume, modulated
        oc = reader[its_Rdr_OutCell]; // first output cell (own cable, bus or trash)
        (reader[its_Rdr_OutAdd] === 0) ? (
            memset(smpl_tab + oc, 0, lcn); // own cable : this reader is its only source
            reader[its_Rdr_OutDirty] = (oc !== TRASH_P);
        );
        mdr = reader[its_Rdr_Mode]; // reader mode

        (mdr === its_RdrMode_Read) ? (
            // Mode reader
            inc = (reader[its_Rdr_AbsInc] + its_Mod_Val(reader + its_Rdr_Mod1 + its_ModDist)) * reader[its_Rdr_AdjInc]; // speed, modulated
            inc = max(-256, min(256, inc)); // the reads stay in the guard samples (B_FADESIZ + BF_LIM)
            loc = reader[its_Rdr_Abspos]; // loc is the index to read
            it = (loc === floor(loc)); // true if reading at integer positions
            ty = reader[its_Rdr_LoopType];
            // Are we in X-cross mode ?
            (reader[its_Rdr_XFadeCnt] > 0) ? (
                reader[its_Rdr_Tmp0] += 1;
                (playing) ? (
                    // Perform a double cross fade reading
                    // SP is the (increasing) index in the sinus table
                    SP = floor(reader[its_Rdr_XFadeIdxPos]);
                    A = sinus_table[SP]; // sin(x)
                    A_aux = sinus_table[SINUS_TABLE_SIZE - SP]; // cos(x)
                    loc_aux = reader[its_Rdr_AbsAuxpos]; // auxiliary read pointer; will finally disappear
                    l_valid = (loc >= reader[its_Rdr_Low]) && (loc <= reader[its_Rdr_High]);
                    lax_valid = (loc_aux >= reader[its_Rdr_Low]) && (loc_aux <= reader[its_Rdr_High]);
                    s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan]; // index of 1st buffer to read
                    val = val_aux = 0;
                    loop(lcn,
                        bfr = lcbl[s + d]; // the buffer to read
                        (bfr === 0) ? (
                            val = val_aux = 0;
                        ) : (
                            (it) ? (
                                // Read as integers
                                l_valid ? (val = bfr[loc]);
                                lax_valid ? (val_aux = bfr[loc_aux]);
                            ) : (
                                // Read as fractionnal
                                l_valid ? (val = inter_cube(bfr, loc));
                                lax_valid ? (val_aux = inter_cube(bfr, loc_aux));
                            );
                        );
                        smpl_tab[oc + s] += vol * (val * A + val_aux * A_aux);
                        s += 1;
                    );
                );
                // Update now the future position
                reader[its_Rdr_XFadeIdxPos] += reader[its_Rdr_XFadeIncr];
                reader[its_Rdr_Abspos] += inc;
                reader[its_Rdr_AbsAuxpos] += inc;
                reader[its_Rdr_XFadeCnt] -= 1;
                (reader[its_Rdr_XFadeCnt] <= 0) ? (
                    (reader[its_Rdr_Abspos] < MIN_VALUE) &&
                        ((ty === its_RdrLoopTypeOnce) || (ty === its_RdrLoopTypeExit) || (ty === its_RdrLoopTypeStop)) ? (
                        reader[its_Rdr_Tmp2] += 1;
                        // time to stop
                        Rd_Do_Stop(reader, nbr);
                    ) : (
                        reader[its_Rdr_Abspos] = max(reader[its_Rdr_Start], min(reader[its_Rdr_Last], reader[its_Rdr_Abspos]));
                    );
                );
            ) : (
                // Mode read standard
                (playing) ? (
                    s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan];
                    loop(lcn,
                        bfr = lcbl[s + d]; // the buffer to read
                        (bfr === 0) ? (
                            val = 0;
                        ) : (
                            (it) ? (
                                // Read as integers
                                val = bfr[loc];
                            ) : (
                                // Read as fractionnal
                                val = inter_cube(bfr, loc);;
                            );
                        );
                        smpl_tab[oc + s] += vol * val;
                        s += 1;
                    );
                );
                // Update now the future position
                reader[its_Rdr_Abspos] += inc;


                s = 0;
                // Has a change in position been requested ?
                ((w = reader[its_Rdr_NxtPosSec]) >= 0) ? (
                    // This becomes the new read position
                    reader[its_Rdr_Abspos] = reader[its_Rdr_Start] + floor(w * srate);
                    reader[its_Rdr_NxtPosSec] = -1;
                    f = reader[its_Rdr_XFadeCntNxt];
                    s = 1;
                ) ;

                // Action depending on mode

                k = reader[its_Rdr_Abspos];
                v = reader[its_Rdr_AbsInc];
                f = reader[its_Rdr_BFadeCntNxt];

                (ty === its_RdrLoopTypeCatch) ? (
                    // Normal read, is catched by a loop
                    ((k >= reader[its_Rdr_RegEIn]) && (k < reader[its_Rdr_RegEOut]) && (v >= 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegSOut]; // will X-fade with this
                        f = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    ((k < reader[its_Rdr_RegSIn]) && (k >= reader[its_Rdr_RegSOut]) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegEOut]; // will X-fade with this
                        f = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeLoop) ? (
                    // immediately catched by the loop
                    (((k >= reader[its_Rdr_RegEIn]) || (k < reader[its_Rdr_RegSOut])) && (v >= 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegSOut]; // will X-fade with this
                        f = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    (((k < reader[its_Rdr_RegSIn]) || (k > reader[its_Rdr_RegEOut])) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegEOut]; // will X-fade with this
                        f = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeExit) ? (
                    // immediately catched by the loop
                    ((k >= reader[its_Rdr_RegEIn]) && (v >= 0)) ? (
                        // Time to start the end cross fade
                        reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                        f = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    ((k < reader[its_Rdr_RegSIn]) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                        f = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeStop) ? (
                    reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                    f = reader[its_Rdr_XFadeCntNxt];
                    s = 1;
                );

                (s === 0) ? (
                    // we may be at some end and need to loop
                    (ty !== its_RdrLoopTypeOnce) ? (
                        // loop at the end
                        ((k >= reader[its_Rdr_Last] - B_FADESIZ) && (v >= 0)) ? (
                            f = reader[its_Rdr_BFadeCntNxt];
                            // start cross fading
                            reader[its_Rdr_Abspos] = k - reader[its_Rdr_SmplCnt];
                            s = 1;
                        ) :
                        ((k < reader[its_Rdr_Start] + B_FADESIZ) && (v < 0)) ? (
                            f = reader[its_Rdr_BFadeCntNxt];
                            // start cross fading
                            reader[its_Rdr_Abspos] = k + reader[its_Rdr_SmplCnt];
                            s = 1;
                        );
                    ) :
                    (
                        // Stop at the end
                        ((k >= reader[its_Rdr_Last] - B_FADESIZ) && (v >= 0)) ? (
                            f = reader[its_Rdr_BFadeCntNxt];
                            // start fading, stop at the end
                            reader[its_Rdr_Abspos] = LOW_VALUE;
                            reader[its_Rdr_Tmp3] += 1;
                            s = 1;
                        ) :
                        ((k < reader[its_Rdr_Start] + B_FADESIZ) && (v < 0)) ? (
                            f = reader[its_Rdr_BFadeCntNxt];
                            // start fading, stop at the end
                            reader[its_Rdr_Abspos] = LOW_VALUE;
                            reader[its_Rdr_Tmp3] += 1;
                            s = 1;
                        );
                    );
                );

                (s) ? (
                    reader[its_Rdr_Tmp4] += 1;
                    reader[its_Rdr_AbsAuxpos] = k; // previous read position becomes the new aux
                    reader[its_Rdr_XFadeCnt] = f; // start counting
                    reader[its_Rdr_XFadeIncr] = SINUS_TABLE_SIZE / reader[its_Rdr_XFadeCnt];
                    reader[its_Rdr_XFadeIdxPos] = 0;
                );
            );
        ) :

        (mdr === its_RdrMode_Delay) ? (
            // we are in delay mode
            s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan];
            wcbl = reader[its_Rdr_WrBPtr]; // point to the writer block
            wps = wcbl[its_Wrt_Abspos];
            // the offset (samples) and its modulation (depth in ms) : a fractional offset is interpolated
            dm = its_Mod_Val(reader + its_Rdr_Mod1) * srate / 1000;
            off = its_Rd_Off(reader, reader[its_Rdr_WOffsetSmp] + dm);
            k = loc = wps - off;
            (loc < reader[its_Rdr_Start]) ? (loc += reader[its_Rdr_SmplCnt]);
            reader[its_Rdr_Abspos] = loc; // the read position, for the display (waveform marker, "Pos")
            (reader[its_Rdr_XFadeCnt] > 0) ? (
                // offset changed : cross fade from the previous offset (its_Rdr_AbsAuxpos), see Rd_Set_Offset
                w = reader[its_Rdr_AbsAuxpos];
                ((w < 1) || (w > reader[its_Rdr_SmplCnt])) ? (
                    reader[its_Rdr_XFadeCnt] = 0; // not an offset : no cross fade
                ) : (
