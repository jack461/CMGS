its_FxCycN = 0; // the effects placed in a loop (feedback) at the last computation

// the key of the cells written by the effect "fx" (number "n") : its own cable, or its output (Out, a bus)
function its_Fx_WKey(fx, n)
(
    (fx[its_Efx_OutK] === 0) ? ITS_KFx * ITS_KMul + n :
    (floor(fx[its_Efx_OutK] / ITS_KMul) === ITS_KOut) ? ITS_KOut * ITS_KMul : fx[its_Efx_OutK];
);

// a source as a key of cells (Out : all its channels)
function its_Fx_RKey(s) ( (floor(s / ITS_KMul) === ITS_KOut) ? ITS_KOut * ITS_KMul : s; );

// the effect "fx" reads the key "wk" (one of its sources, one of its modulation inputs)
function its_Fx_Reads(fx, wk)
local (r, j, p, ns, nm)
(
    r = 0;
    ns = max(0, its_Fx_NSrc(fx[its_Efx_Type]));
    p = fx + its_Efx_Src1; j = 0;
    while (!r && (j < ns)) ( r = (p[0] !== 0) && (its_Fx_RKey(p[0]) === wk); p += its_EfxDist; j += 1; );
    nm = (fx[its_Efx_Type] === its_Efx_TyFilter) ? 2 : (fx[its_Efx_Type] === its_Efx_TySat) ? 3 : 0;
    p = fx + its_Efx_Mod1; j = 0;
    while (!r && (j < nm)) ( r = (p[its_Mod_Src] !== 0) && (its_Fx_RKey(p[its_Mod_Src]) === wk); p += its_ModDist; j += 1; );
    r;
);

// the signature of what the order depends on : the effects that exist, their type, phase, output, sources, modulation inputs
function its_Fx_OrdSig()
local (i, j, b, p, g, sg)
(
    sg = 0;
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? (
            g = 1 + b[its_Efx_Type] * 11 + b[its_Efx_Phase] * 7 + b[its_Efx_OutK] * 3;
            p = b + its_Efx_Src1; j = 0; loop(8, g += p[0] * (j + 13); p += its_EfxDist; j += 1;);
            p = b + its_Efx_Mod1; j = 0; loop(3, g += p[its_Mod_Src] * (j + 31); p += its_ModDist; j += 1;);
            sg += (i + 1) * g;
