        a = hd[7];
        fc = fx[its_Efx_Par1 + 10];
        (fc !== hd[8]) ? ( hd[8] = fc; hd[9] = ((fc <= 1) || (fc >= 0.45 * srate)) ? 0 : exp(-2 * $pi * fc / srate); );
        hb = hd[9];
