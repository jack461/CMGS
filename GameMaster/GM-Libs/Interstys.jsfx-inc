live_screen_init(); // also creates the fonts table (font_names, font_sizes, font_modes)
colorlimits(0x000000, 0xFFFFFF); // limits of the animated background colors (as in Diffusion-3)
live_tab_active = 0; // set when a tab is shown with the "live" display
