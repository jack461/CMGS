            savtmp[0] = 'ains'; savtmp[1] = z__si; savtmp[2] = its_InsSym[z__si]; savtmp[3] = its_InsAName[z__si];
            svtotal += save_mem(0, savtmp, TMPSIZ);
            savtmp[0] = its_InsTLen[z__si]; savtmp[1] = its_InsALen[z__si]; savtmp[2] = its_InsNCnt[z__si]; savtmp[3] = 0;
            svtotal += save_mem(0, savtmp, TMPSIZ);
