        i = 0; loop((g === 3) ? its_EfxViews : 8, blockDispNames[it] = blockModNames[fid + i]; blockDispIdts[it] = fid + i; it += 1; i += 1;);
        (g === 0) ? (gl0 = it - 1) : (g === 1) ? (gl1 = it - 1) : (g === 2) ? (gl2 = it - 1) : (g === 3) ? (gl3 = it - 1) : (gl4 = it - 1);
