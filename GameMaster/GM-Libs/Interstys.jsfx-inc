Currreader = Readers_set[slReader];
CurrreaderNb = slReader;
Currwriter = Writers_set[slWriter];
CurrwriterNb = slWriter;
Curreffect = Effects_set[slEffect];
CurreffectNb = slEffect;
CurrLine = Lines_Set[slLine];
CurrLineNb = slLine;

Last_in_memory_block = make_array(2);
Last_in_memory_top = __memtop();


function Rd_Create(rnum)
local (rcb, mem_0_ACT, mem_0_CCR)
(
    (Readers_set[rnum] !== 0) ? (
        // ty to delete it
        mSL_Dyn_Free(Readers_set[rnum]);
        Readers_set[rnum] = 0;
    );
    // allocate the object uninitialized
    rcb = Rd_Make(rnum);
        str_mess = str_mess_slot(); // a string in [16 .. 32]
        sprintf(str_mess, "Create reader %d at %d", rnum+1, rcb);
        mem_0_ACT = slRdActRd;
        mem_0_CCR = rcb;
        dbg_show_4(rcb, 700);
    ((rcb !== 0) && (rcb[-2] === KW_read)) ? (
        // Set the reader as "unspecified"
                rcb[its_Rdr_Tmp4] = 220;
                rcb[its_Rdr_Tmp5] = rcb[its_Rdr_Status];
                rcb[its_Rdr_Tmp6] = ts();
        rcb[its_Rdr_Status] = its_RdrStat_Created;
        rcb[its_Rdr_Number] = rnum;
        rcb[its_Rdr_InAction] = 510;
    );
    rcb;
);


function Rd_Update(rdrn)
local (reader, L, P, S, X, Q, V, T, W, u, flg, A1, B1, A2, B2, S_In, S_Out, E_In, E_Out)
(
    flg = err = 0;
    ((rdrn < 0) || (rdrn >= RD_CNT)) ? (
        err = 132; // erreur
    ) :
    (((reader = Readers_set[rdrn]) <= BASE_MEMORY) || (reader[-2] !== KW_read)) ? (
        err = 133; // erreur
    ) :
    (
        // Some modifications in the play parameters ?
        (reader[its_Rdr_Speed] != reader[its_Rdr_SpeedPrev]) ? (
            reader[its_Rdr_SpeedPrev] = reader[its_Rdr_Speed] ;
            reader[its_Rdr_AbsInc] = reader[its_Rdr_Speed];
            flg |= 8;
        );
        V = reader[its_Rdr_Speed];
        (reader[its_Rdr_XFade_mSec] != reader[its_Rdr_XFade_mSecPrv]) ? (
            reader[its_Rdr_XFade_mSecPrv] = reader[its_Rdr_XFade_mSecSet] = reader[its_Rdr_XFade_mSec];
            flg |= 1;
        );
        (reader[its_Rdr_RegSizeSec] !== reader[its_Rdr_RegSizeSecPrv]) ? (
            reader[its_Rdr_RegSizeSecPrv] = reader[its_Rdr_RegSizeSec];
            flg |= 2;
        );
        (reader[its_Rdr_RegPosSec] !== reader[its_Rdr_RegPosSecPrv]) ? (
            reader[its_Rdr_RegPosSecPrv] = reader[its_Rdr_RegPosSec];
            flg |= 4;
        );
        (reader[its_Rdr_LowPosSec] !== reader[its_Rdr_LowPosSecPrv]) ? (
            reader[its_Rdr_LowPosSecPrv] = reader[its_Rdr_LowPosSec];
            flg |= 8;
        );
        (reader[its_Rdr_HighPosSec] !== reader[its_Rdr_HighPosSecPrv]) ? (
            reader[its_Rdr_HighPosSecPrv] = reader[its_Rdr_HighPosSec];
            flg |= 16;
        );
        X = max(3, floor(0.5 + reader[its_Rdr_XFade_mSec] * srate / 1000)); // crossfade from ms to samples
        L = max(6, floor(reader[its_Rdr_RegSizeSec] * srate)); // size of region from to samples
        P = floor(reader[its_Rdr_RegPosSec] * srate); // position of region from to samples
        A1 = floor(reader[its_Rdr_LowPosSec] * srate); // position of region low limit
        B1 = floor(reader[its_Rdr_HighPosSec] * srate); // position of region high limit
        S = reader[its_Rdr_SmplCnt]; // clip size in samples
        (flg & 1) ? (
            // check compatibility between region and crossfade
            u = min(S, 2 * X);
            (u > L) ? (
                L = u;
                reader[its_Rdr_RegSizeSecPrv] = reader[its_Rdr_RegSizeSec] = max(0.00001, floor(0.5 + 1000 * L/srate)/1000);
                flg |= 2;
            );
        );
        (flg & 2) ? (
            u = (reader[its_Rdr_RegSizeSec] * 1000) / 2; // convert to ms.
            (u < reader[its_Rdr_XFade_mSec]) ? (
                // decrease X-fade region
                reader[its_Rdr_XFade_mSec] = u;
            ): (
                // increase X-fade region
                reader[its_Rdr_XFade_mSec] = max(reader[its_Rdr_XFade_mSec], min(u, reader[its_Rdr_XFade_mSecSet]));
            );
            reader[its_Rdr_XFade_mSecPrv] = reader[its_Rdr_XFade_mSec];
            X = max(3, floor(0.5 + reader[its_Rdr_XFade_mSec] * srate / 1000)); // crossfade from ms to samples
        );
        (flg & (2|4)) ? (
