// Random : the inverse of the length of the next interval of a clock (relative to the rate) : 1 - jt + jt x an exponential
// draw of mean 1 (regular at 0, Poisson at 1)
function its_Rn_Ivl(jt) ( 1 / max(0.001, 1 - jt - jt * log(max(0.000001, 1 - rand(1)))); );

// Random : the clock at "q" (q[0] its phase, q[1] the inverse of the length of the current interval) moves by "rt" (ticks per
// sample) : 1 at a tick
function its_Rn_Clock(q, rt, jt)
(
    ((q[0] += rt * q[1]) >= 1) ? (
        q[0] -= floor(q[0]);
        q[1] = its_Rn_Ivl(jt);
        1;
    ) : 0;
);

// Random : a rising edge of the trigger "x" (above the threshold "th" + its_RnHyst, after having been at or below "th") ;
// q[9] : its state (1 : above)
function its_Rn_Edge(q, x, th)
(
    q[9] ? ( (x <= th) ? (q[9] = 0); 0; ) : (x > th + its_RnHyst) ? ( q[9] = 1; 1; ) : 0;
);

// Random : a rising edge of the trigger "x", detected on its wave ("dt" 0, its_Rn_Edge) or on its envelope ("dt" 1 : an
// attack) : q[11] the envelope (an instant attack, then the release "kr" per sample), q[12] its recent level (a one pole,
// "ks" : 5 times the release) ; an attack : the envelope above the threshold "th" (at least 0.001) and its_RnJump times
// its recent level ; again armed when it is back to its_RnReArm times this level, or under half the threshold (a
