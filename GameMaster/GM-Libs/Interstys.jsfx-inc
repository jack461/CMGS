                    ) : (
                        k = 1; loop(os,
                            u = s[0] + (x - s[0]) * k / os; // linear interpolation from the previous input
                            v = its_Sat_Shape(gd * u + bi, md, on, fx) - shb;
                            c = cf; p = s + 3;
                            loop(4,
                                y = c[0] * v + p[0];
                                p[0] = c[1] * v - c[3] * y + p[1];
                                p[1] = c[2] * v - c[4] * y;
                                v = y;
                                p += 2; c += 5;
                            );
                            k += 1;
                        );
                        y = v; // the last value : decimation
                        s[0] = x;
                    );
                    yd = y - s[1] + its_SatDcK * s[2]; // DC blocker (about 10 Hz)
                    s[1] = y; s[2] = yd;
                    !(abs(yd) < its_FinMax) ? (memset(s, 0, its_SatChW); yd = 0; its_NaNCnt += 1;);
                    out[i] += og * ((1 - mix) * x + mix * yd);
                    i += 1;
                );
            );
        ) : (
            // Mixer, Auto Mixer
            ptsrc = fx + its_Efx_Src1;
            loop (8,
                ((c = ptsrc[its_Efx_Cell1 - its_Efx_Src1]) > 0) ? (
                    src = smpl_tab + c;
                    g = ptsrc[its_Efx_Vol1 - its_Efx_Src1];
                    i = 0; loop(ccnt,
                        out[i] += g * src[i];
                        i += 1;
                    );
                );
                ptsrc += its_EfxDist;
            );
        );
        (lim) ? (
            // auto-limiter : peak envelope of all the channels (attack 5 ms, release 1.5 s), gain 1 / max(1, env) ;
            // short overshoots are possible (no look-ahead), at the attacks and when a setting changes
            m = 0; i = 0; loop(ccnt, m = max(m, abs(out[i])); i += 1;);
            e = fx[its_Efx_LimEnv];
            e += ((m > e) ? its_LimAtt : its_LimRel) * (m - e);
            !(abs(e) < its_FinMax) ? (e = 1; its_NaNCnt += 1;);
            fx[its_Efx_LimEnv] = e;
            g = go / max(1, e);
            i = 0; loop(ccnt, dst[i] += g * out[i]; i += 1;);
        );
        exec_effect += 1;
    ) :
    (fx[its_Efx_OutDirty] && (CblFxStart[nbr] > 0)) ? (
        // not executed : its own cable is silent
        memset(smpl_tab + CblFxStart[nbr], 0, CblFxWidth[nbr]);
        fx[its_Efx_OutDirty] = 0;
    );
);




//======== Serialize Procedures : save_mem, load_mem (mSL_Serialize.jsfx-inc)

function check_its_block(cbl)
(
    (cbl[0] !== SECURE_BL) || (cbl[cbl[-1]-1] !== SECURE_BL);
);

// free the blocks of a load not used (DuplWA) : the lines have no buffers yet (see recreate_structures)
function its_Load_Drop()
local (i, b)
(
    i = 0; loop(PtrsInWA,
        ((b = DuplWA[i]) > BASE_MEMORY) ? (
            (b[-2] === KW_lcbl) ? memset(b + its_Lin_BF1ST, 0, 128); // (pointers of the saved line : not ours)
            mSL_Dyn_Free(b);
        );
        DuplWA[i] = 0;
        i += 1;
    );
);

function recreate_structures()
local (ln, renew, nlcbl, olcbl, nrcbl, nwcbl, alt, i, nl, nr, nw, nf, bad)
(
    // what was loaded (see the log)
    nl = nr = nw = nf = bad = 0;
    i = 0; loop(LN_CNT + 1, (Lines_Set[i + AltWAdec] !== 0) ? (nl += 1); i += 1;);
    i = 0; loop(RD_CNT + 1, (Readers_set[i + AltWAdec] !== 0) ? (nr += 1); i += 1;);
    i = 0; loop(WR_CNT + 1, (Writers_set[i + AltWAdec] !== 0) ? (nw += 1); i += 1;);
    i = 0; loop(FX_CNT + 1, (Effects_set[i + AltWAdec] !== 0) ? (nf += 1); i += 1;);
    // the old lines : their Tmp1 tells if they are reused (see below)
    ln = 0; loop(LN_CNT + 1, ((olcbl = Lines_Set[ln]) !== 0) ? (olcbl[its_Lin_Tmp1] = 0); ln += 1;);
    // Update newly loaded line structures : first, the lines that can reuse the buffers of an old line
    ln = 0; loop(LN_CNT + 1,
        renew = -1;
        nlcbl = Lines_Set[ln+AltWAdec]; // nouvelle "ln"
        (nlcbl !== 0) ? (
            memset(nlcbl+its_Lin_BF1ST, 0, 128); // (pointers of the saved line : not ours)
            olcbl = Lines_Set[ln]; // ancienne "ln"
            (olcbl !== 0) ? (
                // Peut-on réutiliser l'ancienne ligne ?
                ((olcbl[its_Lin_ChCnt] === nlcbl[its_Lin_ChCnt]) // meme nombre de canaux
                    && (olcbl[its_Lin_SmplCnt] === nlcbl[its_Lin_SmplCnt]) // meme nombre de sample
                    && (olcbl[its_Lin_Tmp1] === 0)) ? ( // non encore utilisé
                    renew = ln;
                    olcbl[its_Lin_Tmp1] = 1000 + ln;
                );
            );
            // peut-on retrouver une ancienne ligne similaire ?
            alt = 0;
            while ((renew < 0) && (alt < LN_CNT)) (
                olcbl = Lines_Set[alt];
                ((olcbl != 0) && (olcbl[its_Lin_ChCnt] === nlcbl[its_Lin_ChCnt])
                    && (olcbl[its_Lin_SmplCnt] === nlcbl[its_Lin_SmplCnt])
                    && (olcbl[its_Lin_Tmp1] === 0)) ? ( // the old line is not yet used (was nlcbl)
                    renew = alt;
                    olcbl[its_Lin_Tmp1] = 2000 + ln;
                );
                alt += 1; // (was missing : the loop ran up to the JSFX limit)
            );

            (renew < 0) ? (
                nlcbl[its_Lin_Tmp1] = -1; // new buffers : allocated below, once the old lines not reused are freed
            ) : (
                // On réutilise les buffers de l'ancienne ligne
                olcbl = Lines_Set[renew];
                i = its_Lin_BF1ST; loop (128,
                    nlcbl[i] = olcbl[i];
sprintf(#A007,"buff-r  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i-1, nlcbl[i-1]);
sprintf(#A008,"buff-r  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i, nlcbl[i]);
                    olcbl[i] = 0; i += 1;
                );
            );
            nlcbl[its_Lin_Check] = 0; // for future fast check
sprintf(#A006,"nlcbl %d {%d  ch=%d  sz=%d}", ln, nlcbl, nlcbl[its_Lin_ChCnt], nlcbl[its_Lin_SmplCnt]);
            dbg_show_2(i__mem,66)
        );
        ln += 1;
    );
    // the old lines not reused are freed first : a large line could not be allocated while the old ones still exist
    ln = 0; loop(LN_CNT + 1,
        (((olcbl = Lines_Set[ln]) !== 0) && (olcbl[its_Lin_Tmp1] === 0)) ? Ln_Delete(ln);
        ln += 1;
    );
    // then the new buffers (a line that cannot get all its buffers is not created : error 2610 in its pad)
    ln = 0; loop(LN_CNT + 1,
        nlcbl = Lines_Set[ln+AltWAdec];
        ((nlcbl !== 0) && (nlcbl[its_Lin_Tmp1] === -1)) ? (
            nlcbl[its_Lin_Tmp1] = 0;
            renew = 1; // all the buffers allocated
            i = its_Lin_BF1ST; loop(nlcbl[its_Lin_ChCnt],
                ((nlcbl[i] = mSL_Dyn_Alloc(nlcbl[its_Lin_ActBSize], KW_buff, mSL_StM_FlClear)) < BASE_MEMORY) ? (
                    nlcbl[i] = 0; renew = 0;
                );
                i += 1;
            );
            (renew) ? (
                Ln_MemErr[ln] = 0;
            ) : (
                i = its_Lin_BF1ST; loop(128, (nlcbl[i] > BASE_MEMORY) ? mSL_Dyn_Free(nlcbl[i]); nlcbl[i] = 0; i += 1;);
                mSL_Dyn_Free(nlcbl);
                Lines_Set[ln+AltWAdec] = 0;
                Ln_MemErr[ln] = 1;
                bad += 1;
            );
        );
        ln += 1;
    );
    // On peut libérer les anciennes lignes
    ln = 0; loop(LN_CNT + 1,
        Ln_Delete(ln);
        ln += 1;
    );

    // Update readers
    ln = 0; loop(RD_CNT + 1,
        nrcbl = Readers_set[ln+AltWAdec];
        (nrcbl !== 0) ? (
            // update lines addresses
            (nrcbl[its_Rdr_Lcbl] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_Lcbl] = Lines_Set[nrcbl[its_Rdr_LineNb]+AltWAdec];
sprintf(#A004,"UpdRd %d bn=%d ba=%d", ln, nrcbl[its_Rdr_LineNb], Lines_Set[nrcbl[its_Rdr_LineNb]+AltWAdec]);
            );
            // reader lié à un writer ?
            (nrcbl[its_Rdr_WrBPtr] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_WrBPtr] = Writers_set[nrcbl[its_Rdr_WrSrc]+AltWAdec];
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens lecteurs
    ln = 0; loop(RD_CNT + 1,
        Rd_Delete(ln);
        ln += 1;
    );

    // Update writers
    ln = 0; loop(WR_CNT + 1,
        nwcbl = Writers_set[ln+AltWAdec];
        (nwcbl !== 0) ? (
            (nwcbl[its_Wrt_Lcbl] > BASE_MEMORY) ? (
                // Update with the new address
                nwcbl[its_Wrt_Lcbl] = Lines_Set[nwcbl[its_Wrt_LineNb]+AltWAdec];
sprintf(#A005,"UpdWr %d st=%d bn=%d ba=%d", ln, nwcbl[its_Wrt_Status], nwcbl[its_Wrt_LineNb], Lines_Set[nwcbl[its_Wrt_LineNb]+AltWAdec]);
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens écrivains
    ln = 0; loop(WR_CNT + 1,
        Wr_Delete(ln);
        ln += 1;
    );

    // On peut libérer les anciens effets
    ln = 0; loop(FX_CNT + 1,
        FX_Delete(ln);
        ln += 1;
    );

    // mise en place du nouveau bloc d'addresses
    memcpy(StaticWA, DuplWA, StaticWASize);
    memset(DuplWA, 0, StaticWASize);
    updt_tables(StaticWA);
    sprintf(#its_LdMsg, "Load : %d lines, %d readers, %d writers, %d effects ; %d lines without memory", nl, nr, nw, nf, bad);
    its_LdMsgOn = 1; // written in the log by @gfx
);

/*
    Gather all information needed for a preset
    SVASIZ is at least 32
*/
function build_savarea()
(
    memset(savarea, 0, SVASIZ);
    savarea[0] = savcode;

    savarea[10] = pgmode;
    savarea[11] = vol_inp;
    savarea[12] = vol_out;

    savarea[SVASIZ-1] = savcode;
);

function load_loadarea()
(
    // after a preset load, always back to "Merge" (the saved mode lodarea[10] is ignored) ;
    // update_sliders() then sets pgmode and vol_inp, and shows the gain sliders
    slSmpl = 0; slSmplPrv = -1;
    sliderchange(slSmpl);
    vol_out = lodarea[12];
);

/*
    put in place the structures of a load (@serialize) : by @block, between two audio blocks ; but REAPER does not call
    @block when the track is not processed (after a load, until the audio restarts) : then @gfx does it, once @block has
    not run for its_LdWait seconds (its_Hold stops @sample meanwhile, in case the audio restarts)
*/
its_LdWait = 0.25;
its_BlkCnt = its_LdBlk = its_LdTime = its_LdSeen = its_Hold = 0;
function its_Load_Install()
(
    perform_loading = 0;
    its_LnKeep = 1; // the old lines are deleted, the names of the files just loaded are kept (its_LnFile, 'lfil')
    recreate_structures(); // also update tables
    its_LnKeep = 0;
    load_loadarea();
    its_PatchForce = 1; // the cables and the cells of all the modules (see its_Patch_Update)
    // force sliders update
    lnupdt = slupdt = wrupdt = rdupdt = fxupdt = 1;
    handling_load = 0;
    its_LnRldPend = 1; its_LnRldIdx = its_LnRldOk = its_LnRldErr = 0; // the files of the lines are read again (@gfx)
);



// Print a sequence of strings
function mSL_133(argc, argv)
(
    while (argc > 0) (
        mSL_log(SysLogBox, argv[0]);
        argc -= 1; argv += 1;
    );
);

// This redefines the function "mSL_134" as the product of its operands
function mSL_134(argc, argv)
local (product, ip)
(
    product = 1;
    ip = 0;
    loop(argc, product *= argv[ip]; ip += 1;);
    product;
);

// External access to some useful data structures
function mSL_135(argc, argv)
local (item)
(
    item = argv[0];
    (item == KodedSchPads) ? (
        SchedPadSet; // A 16 entries array
    ) :
    (
        -1;
    );
);

function mSL_define_extensions()
(
    mSL_define_opcode("GM_Log", 133); // define "GM_Log"
    mSL_define_opcode("print", 133); // define print as a synonyp for "GM_Log"
    mSL_define_opcode("prod", 134); // define "prod"
    mSL_define_opcode("GM_Addr", 135); // etc.
);

// define our new extensions
mSL_define_extensions();


initAllParameters();
dclAllParameters();

// GC bounds : roots (mm_usr_prot, StaticWA, paramBlock...) and the dynamic memory must be
// between mm_lowblocks and mm_highblocks, otherwise gc_mark ignores them
mm_highblocks = make_array(2); // no block with memory references beyond that
mm_highblocks[0] = 'High'; mm_highblocks[1] = '_Mem';


/*
    Gui operations
*/
function mSL_gui_ops(argc, argv)
local(res, kw, npar, pp, r, sr, n, cnt, i, j, v, chk, idt,
      s, k, w, xbox, chkprev, res_end, ptb, ptw, pts, pta, lct, ds, ref, txt)
(
    res = Undef;
    (argc > 1) ? (
        kw = argv[0];
        npar = argv[1];

        (kw === mSL_KW_slider) ? (
            pp = 0;
            ((npar === (0|npar)) && (npar >= 0) && (npar < paramCount)) ? (
                pp = paramBlock + npar * paramEntSize;
            ) :
            ((npar > mSL_Sym_Low) && (npar < mSL_Sym_High) && (mSL_getinHT(paramHashTbl, npar) >= 0)) ? (
                pp = paramBlock + (npar = mSL_getinHTaux) * paramEntSize;
            );
            (pp != 0) ? (
                (argc >= 11) ? (
                    parDclMode = 1;
                    r = parDcl(npar, argv[2], argv[3], argv[4], argv[5], argv[6], argv[7], argv[8], argv[9], argv[10],
                        ((argc >= 12) ? argv[11]: 0), ((argc >= 13) ? argv[12]: 0), ((argc >= 14) ? argv[13]: 0),
                        ((argc >= 15) ? argv[14]: 0), ((argc >= 16) ? argv[15]: 0), ((argc >= 17) ? argv[16]: 0));
                    (r === 0) ? (
                        argc = 2; // return/build the entry
                    ) : (
                        // signal error
                        sprintf(#u, "++Slider error: %d - %d", npar, r);mSL_log(SysLogBox, #u);
                        argc = 2;
                    );
                );
                ((argc === 2) && (pp[pp_Name] != 0) && (pp[pp_Name] != #pUndef)) ? (
                    // return, if any, the slider block reference
                    sr = pp[pp_mSL_Ref];
                    ((sr > 0) && (mSL_bl_check(sr, 'sldr')) && (sr[-1] >= 12)) ? (
                        res = sr;
                    ) : (
                        pp[pp_mSL_Ref] = res = mSL_Dyn_Alloc(12, 'sldr', mSL_StM_FlClear);
                    );
                    // Create/update the slider descriptor
                    pp[pp_Addr] = res + 3;
                    paramFlags[npar] |= pflg_ChkWrite;
                    res[0] = mSL_KW_slider;
                    res[1] = npar;
                    res[2] = pp[pp_mSL_Code];
                    res[3] = parGetV(npar);
                    res[4] = pp[pp_Name];
                    res[5] = pp[pp_SFmt];
                    res[6] = pp[pp_MFmt];
                );
            );
        ) :
        (kw === mSL_KW_declare) ? (
            (mSL_bl_check(npar, 'umod') && (argc >= 4)) ? (
                idt = argv[2]; // uname
                n = argv[3]; // module. num
                (mSL_isString(idt) && (n === (0|n)) && (n >= 0) && (n <= dcbUModsSiz)) ? (
                    // declare the module
                    blockUsrNames[n] = idt;
                    blockUsrRefs[n] = npar;
                    res = n;
                );
            );
        ) :
        (kw === mSL_KW_update) ? (
            ((npar === mSL_KW_sliders) || (npar === mSL_KW_Params)) ? (
                // Rebuild parameters sliders
                menu_Param_mSL = 0;
                menu_Param_UBS = 0;
                menu_Param_UBD = 0;
                parDclMode = 0;
                dclAllParameters();
            ) :
            (npar === mSL_KW_modules) ? (
                // After creating new users modules
                checkUsrMods(); // valid blocks
                mkModuleMenu();// rebuild the menu
            );
        ) :
        (kw === mSL_KW_sbox) ? (
            // Creating a Slider Box
            cnt = argc - 1; // count of expected sliders references
            i = 1; n = 0; loop(cnt,
                v = argv[i];
                // lets check that v is a slider reference
                mSL_bl_check(v, 'sldr') ? (n += 1);
                i += 1;
            );
            (n === cnt) ? (
                // all parameters are sliders. Let's create the container
                res = mSL_Dyn_Alloc(ubx_isiz+cnt, 'sbox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'sbox'; // this is a slider box
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res;  // points to itself
                res[ubx_anc] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // no direct descendants
                res[ubx_icnt] = cnt; // items count
                res[ubx_1st] = 0; // not relevant for now
                res[ubx_tcnt] = 0; // no descendants at all
                //----
                res[ubx_l] = 0; // not relevant for now
                res[ubx_t] = 0; // not relevant for now
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_slidh * cnt; // actual value in pixels, "correct"
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                i = 1; j = ubx_isiz; loop(cnt,
                    res[j] = argv[i]; i += 1; j += 1;
                );
            );
        ) :
        (kw === mSL_KW_ibox) ? (
            // Create an info box with a set of infos to display
            cnt = argc - 1; // count of expected parameters
            (cnt > 1) ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+cnt+1), 'ibox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'ibox'; // This is an infobox
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // direct descendants count
                res[ubx_icnt] = 1;  // one item
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = 0; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_tboxs+5; // appropriate height
                //----
                res[ubx_minw] = ui_MinSubColSize; // min size
                res[ubx_maxw] = 5 * ui_MinSubColSize; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy
                ptb[0] = cnt;
                i = 0; loop(cnt,
                    i += 1; ptb += 1;
                    ptb[0] = argv[i];
                );
            );
        ) :
        ((kw === mSL_KW_hbox)) ? (
            // Create an horizontal box, expect a set of '*box'
            xbox = 'hbox';
            k = argc - 1; // count of parameters
            chk = i = 1; chkprev = cnt = w = n = 0;
            loop(k,
                v = argv[i];
                ((chk && chkprev && (v < 1024))) ? (
                    w += 1;
                    chkprev = 0;
                ) :
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                    cnt += 1;
                    chkprev = 1;
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+2*cnt), xbox, mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = xbox; // This is an horizontal box
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy references
                ptw = ptb + cnt; // where to copy widths
                k = argc - 1; // count of parameters
                i = 1; chkprev = 0; w = 0;
                loop(k,
                    v = argv[i];
                    ((chkprev && (v < 1024))) ? (
                        ptw[w-1] = v;
                        chkprev = 0;
                    ) :
                    (mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box')) ? (
                        ptb[w] = v;
                        ptw[w] = Undef; // default width
                        chkprev = 1;
                        w += 1;
                    );
                    i += 1;
                );
            );
        ) :
        ((kw === mSL_KW_vbox)) ? (
            // Create a vertical box, expect a set of '*box'
            xbox = 'vbox';
            cnt = argc - 1; // count of expected references
            chk = i = 1; n = 0; loop(cnt,
                v = argv[i];
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+n), xbox, mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = xbox; // This is a vertical box
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy
                i = 1; loop(cnt,
                    ptb[0] = argv[i]; i += 1; ptb += 1;
                );
            );
        ) :
        (kw === mSL_KW_tbox) ? (
            // Create a text box - Expect a string as parameter
            txt = argv[1];
            (chk = mSL_isString(txt)) ? (
                res = mSL_Dyn_Alloc((s = ubx_isiz+1), 'tbox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'tbox'; // this is a slider box
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res;  // points to itself
                res[ubx_anc] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // no direct descendants
                res[ubx_icnt] = 1; // items count
                res[ubx_1st] = 0; // not relevant for now
                res[ubx_tcnt] = 0; // no descendants at all
                //----
                res[ubx_l] = 0; // not relevant for now
                res[ubx_t] = 0; // not relevant for now
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_vtext; // actual value in pixels, "correct"
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                res[ubx_isiz] = txt; // the string number
            );
        ) :
        (kw === mSL_KW_module) ? (
            // Expect a module name
            // idt = argv[1];
            // chk = mSL_isString(idt);
            cnt = argc - 1; // count of expected references
            chk = i = 1; n = 0; loop(cnt,
                v = argv[i];
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+n*ubx_isiz), 'umod', mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = 'umod'; // This is a module
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                res[ubx_thread] = mSL_current_thread; //current thread
                res[ubx_thrdid] = mSL_current_thread[mSL_THR_UTId]; // current thread id
                // res[ubx_xxxx] = 0; // ubx_xxxx is not defined : would overwrite res[ubx_ty]
                //sprintf(#b, "a ===>    0:%d   //", res[ubx_ty]); mSL_log(SysLogBox, #b);
                //----
                // First insert direct references
                ptb = res + ubx_isiz; // where to copy / create the boxes descriptions
                pts = argv + 1; // local sources
                lct = cnt; // local count
                pta = res; // current ancestor : the module we are creating
                while ((chk) && (ptb < res_end)) (
                    // Create a local box from current src
                    while ((chk) && (lct > 0)) (
                        ds = pts[0];
                        // this must be a correct reference
                        (chk = (mSL_bl_check(ds) && ((ds[-2] & 0xffffff) === 'box'))) ? (
                            // indicate first descendant
                            (pta[ubx_1st] === 0) ? (pta[ubx_1st] = ptb - res;);
                            lct -= 1;
                            // insert the source
                            //----
                            ptb[ubx_ty] = ds[ubx_ty];
                            ptb[ubx_flgs] = ds[ubx_flgs];
                            ptb[ubx_mref] = ds;
                            ptb[ubx_anc] = pta - res;
                            //----
                            ptb[ubx_lcnt] = ds[ubx_lcnt];
                            ptb[ubx_icnt] = ds[ubx_icnt];;
                            ptb[ubx_1st] = 0;
                            ptb[ubx_tcnt] = ds[ubx_tcnt];
                            //----
                            ptb[ubx_t] = ds[ubx_t];
                            ptb[ubx_l] = ds[ubx_l];
                            ptb[ubx_w] = ds[ubx_w];
                            ptb[ubx_h] = ds[ubx_h];
                            //----
                            ptb[ubx_minw] = ds[ubx_minw];
                            ptb[ubx_maxw] = ds[ubx_maxw];
                            //----
                            pts += 1; // next source
                            ptb += ubx_isiz; // where we will copy it
                        );
                    );
                    (chk && (ptb < res_end) && (lct <= 0)) ? (
                        // skip to next set source
                        pta = pta + ubx_isiz; // new ancestor
                        ref = pta[ubx_mref]; // just recheck
                        (chk = (mSL_bl_check(ref))) ? (
                            lct = ref[ubx_lcnt]; // number of direct references to include
                            pts = ref + ubx_isiz; // point to this box references
                        );
                    );
                );
                // sprintf(#b, "b ===>    0:%d   //", res[ubx_ty]); mSL_log(SysLogBox, #b);
            );
            (!chk) ? (
                res = Undef;
            );
        ) :
        (kw === mSL_KW_delete) ? (
            (npar === mSL_KW_modules) ? (
                deleteUsrMods(); // delete all, then
                mkModuleMenu();// rebuild the menu
            ) :
            (npar === mSL_KW_sliders) ? (
                i = p_ActSize;
                while (i < paramCount) (
                    parRemove(i);
                    i += 1;
                );
                menu_Param_mSL = 0;
                menu_Param_UBS = 0;
                menu_Param_UBD = 0;
                parDclMode = 0;
                dclAllParameters();
            );
        );
    );
    res;
);//mSL_gui_ops


//============== mSL "table" : the description of a patch ===============
/*
    table(data( [Interstys] block block ... ))     (tests : Scripts/Ex-1NNN.mSL)
    A flat stream of words ; a block starts with its header and ends at the next header :
        Clear                           deletes all the lines, readers, writers and effects
        Line id [length s] [chan n] [spls n] [file "name"]
                                        creates the line ; keeps it if it is the same, replaces it otherwise ;
                                        file : reads the sound file into the line (its size and channels : length, chan,
                                        spls are then ignored) ; a relative name is in the folder of the project
                                        (its writers and readers follow, Ln_Rebind) ; "status" and "freq" are
                                        accepted and ignored, so that a Dump can be read again
        Writer id  line L  source S  status Ready|Paused|Writing  gain dB  overdub %  mode XFade|Sum  first n  used n
        Reader id  line L | writer W  delay s  speed x  status Ready|Paused|Reading  out D  vol dB  first n  used n
                   loop once|repeat|catch|loop|exit|stop
                                        "line" : reader mode, "writer" : delay mode ; the status is set last
        Effect id  type T  status On|Off|Bypass  phase Std|Pre|Post  chan n  out D  limiter On|Off  (+ the keys of the type)
                   T : None, Mixer : src1 S gain1 dB ... src8 S gain8 dB ; AutoMix : src1 S ... src8 S (gains computed) ;
                   Filter : source S  gain dB  freq Hz  q x  mode LP1|HP1|LP|HP|BP|Notch  stages 1|2|4|8
                            mod Cutoff|Reso S [depth d] [att a] ;
                   LFO : freq Hz  mode Sine|Triangle|SawUp|SawDown|Square  amp a  offset o  spread s (no limiter) ;
                   Saturation : source S  gain dB  mode Soft|Hard|Fold|SineFold|XSin|Cheb|ChebSum  drive dB  bias b  mix %
                            os 1|2|4|8  output dB  order n  stretch s  amount A  harm w1 [... w16]
                            mod Drive|Bias|Order S [depth d] [att a]  ("Order" : the stretch in the mode ChebSum) ;
                            harm : 1 to 16 weights, the others are 0 ; Dump : only the keys used by the mode
                                        "source", "gain" : src1, gain1 ; a new type gives its default values first
                                        (FX_Set_Type, as in the pad), the status is set last ; "mod X none" disconnects
        Global  samples Merge|Ignore|Pass  input dB  output dB  latency ms
                action StopAll|PauseAll|RestartAll|RewindAll|ClearAll  chan n
                                        the settings of the module "Globals" ; the action is performed last, at once ;
                                        "chan" (the channels of the track) is accepted and ignored, checked by Check
        Dump Line|Writer|Reader|Effect id | Global | Order (the execution order of the effects, see its_Fx_Order)
                                        logs the module in the same syntax ; Dump All : Global and all the modules
        Check Line|Writer|Reader|Effect id key value ... | Check Global key value ...
                                        logs "Check Writer n OK", or an error 2759 for each difference
        Free Line|Writer|Reader|Effect id
                                        deletes the module
    id : a number 1 ... LN_CNT (WR_CNT, RD_CNT, FX_CNT), or a name (not a reserved word) valid in this table only ;
    a new name gets a free module, that no number of the table designates.
    Sources S : In:c  Out:c  Bus n[:c]  Ctl n  Reader id[:c]  Effect id[:c]  none ; outputs D : Own  Out:c  Bus n[:c]
    (channels from 0, modules from 1, as in the pads).
    An omitted key keeps the value of the module, or takes its default (a line : 1 s, 2 channels).
    Four passes on the words, nothing is modified before the last one :
        0 marks the modules designated by a number, 1 gives a module to the names of the headers,
        2 checks everything on a simulation (lines, channels...), 3 executes.
    Algorithm, Instance, Free Instance|Algorithm, Dump Instance : see "Algorithms" below.
    Errors 2750 ... 2773, 2780 ... 2790 ; the result of "table" is 0, or the first error.
    It runs in @gfx (the mSL threads of Interstys) : the state of the analysis is global.
*/
its_TK_Cnt = 0;
its_TK_List = make_array(192); // the reserved words (they can't be names)
function its_TK(name) local(s) ( s = mSL_symbol(name); its_TK_List[its_TK_Cnt] = s; its_TK_Cnt += 1; s; );
its_TK_Interstys = its_TK("Interstys");
its_TK_End = its_TK("End");
its_TK_EofMark = its_TK("EofMark");
its_TK_Clear = its_TK("Clear");
its_TK_Line = its_TK("Line");
its_TK_Writer = its_TK("Writer");
its_TK_Reader = its_TK("Reader");
its_TK_Effect = its_TK("Effect");
its_TK_Global = its_TK("Global");
its_TK_Dump = its_TK("Dump");
its_TK_Check = its_TK("Check");
its_TK_Free = its_TK("Free");
its_TK_All = its_TK("All");
its_TK_In = its_TK("In");
its_TK_Out = its_TK("Out");
its_TK_Bus = its_TK("Bus");
its_TK_Ctl = its_TK("Ctl");
its_TK_Own = its_TK("Own");
its_TK_length = its_TK("length");
its_TK_chan = its_TK("chan");
its_TK_spls = its_TK("spls");
its_TK_freq = its_TK("freq");
its_TK_status = its_TK("status");
its_TK_Ready = its_TK("Ready");
its_TK_Undefined = its_TK("Undefined");
its_TK_Colon = ':' + mSL_CharConst; // as mSL_cstComma
its_TK_none = its_TK("none");
its_TK_source = its_TK("source");
its_TK_gain = its_TK("gain");
its_TK_mod = its_TK("mod");
its_TK_depth = its_TK("depth");
its_TK_att = its_TK("att");
its_TK_file = its_TK("file");
its_TK_Algorithm = its_TK("Algorithm");
its_TK_Instance = its_TK("Instance");
its_TK_input = its_TK("input");
its_TK_output = its_TK("output");
its_TK_param = its_TK("param");
its_TK_Set = its_TK("Set");
its_TK_Order = mSL_symbol("Order"); // (Dump Order ; reserved : a modulation input of the Saturation)
// markers of the expanded table (its_Al_Expand : never in a data) : the begin of an instance (followed by the index of its
// pending record, its_IP...), its end, the begin and the end of an argument (read in the scope outside the instance)
its_TbM_Base = -(2^50);
its_TbM_Ins = its_TbM_Base - 1;
its_TbM_InsEnd = its_TbM_Base - 2;
its_TbM_Out = its_TbM_Base - 3;
its_TbM_In = its_TbM_Base - 4;
its_TbM_Set = its_TbM_Base - 5; // the begin of a Set (followed by the index of its record, its_SP...)
its_TbM_SetEnd = its_TbM_Base - 6;
its_TbM_Chg = its_TbM_Base - 7; // the value which follows comes from a changed argument (Set)

// the keys of the writers and of the readers : their symbol, their name ; values (enumerations : the symbol of each value)
its_TbWNk = 8;
its_TbWKey = make_array(its_TbWNk); its_TbWNam = make_array(its_TbWNk);
its_TbRNk = 10;
its_TbRKey = make_array(its_TbRNk); its_TbRNam = make_array(its_TbRNk);
function its_TbKey(keys, nams, i, name) ( nams[i] = name; keys[i] = its_TK(name); );
its_TbKey(its_TbWKey, its_TbWNam, 0, "line"); its_TbKey(its_TbWKey, its_TbWNam, 1, "source");
its_TbKey(its_TbWKey, its_TbWNam, 2, "status"); its_TbKey(its_TbWKey, its_TbWNam, 3, "gain");
its_TbKey(its_TbWKey, its_TbWNam, 4, "overdub"); its_TbKey(its_TbWKey, its_TbWNam, 5, "mode");
its_TbKey(its_TbWKey, its_TbWNam, 6, "first"); its_TbKey(its_TbWKey, its_TbWNam, 7, "used");
its_TbKey(its_TbRKey, its_TbRNam, 0, "line"); its_TbKey(its_TbRKey, its_TbRNam, 1, "writer");
its_TbKey(its_TbRKey, its_TbRNam, 2, "delay"); its_TbKey(its_TbRKey, its_TbRNam, 3, "speed");
its_TbKey(its_TbRKey, its_TbRNam, 4, "status"); its_TbKey(its_TbRKey, its_TbRNam, 5, "out");
its_TbKey(its_TbRKey, its_TbRNam, 6, "vol"); its_TbKey(its_TbRKey, its_TbRNam, 7, "first");
its_TbKey(its_TbRKey, its_TbRNam, 8, "used"); its_TbKey(its_TbRKey, its_TbRNam, 9, "loop");
// statuses (its_WrtStat_..., its_RdrStat_... : 0 ... 4), modes of the writer, loops of the reader (its_RdrLoopType...)
its_TbWSt = make_array(5); its_TbRSt = make_array(5);
its_TbWSt[0] = its_TbRSt[0] = its_TK_Undefined; its_TbWSt[1] = its_TbRSt[1] = its_TK("Created");
its_TbWSt[2] = its_TbRSt[2] = its_TK_Ready; its_TbWSt[3] = its_TbRSt[3] = its_TK("Paused");
its_TbWSt[4] = its_TK("Writing"); its_TbRSt[4] = its_TK("Reading");
its_TbWMd = make_array(2); its_TbWMd[its_WrtMode_XFade] = mSL_symbol("XFade"); its_TbWMd[its_WrtMode_Sum] = mSL_symbol("Sum");
its_TbRLp = make_array(6);
i__ii = 0; loop(6, its_TbRLp[i__ii] = mSL_symbol(menu_Rdr_Loop_N[i__ii]); i__ii += 1;);

// the keys of the effects (one table for all the types : its_Tb_FxOk tells which keys a type takes) ; "source" and "gain"
// are src1 and gain1 ; the keys its_TbFMod ... : "mod" for each modulation input (its_TbFMI)
its_TbFMod = 38;
its_TbFMINb = 5;
its_TbFNk = its_TbFMod + its_TbFMINb;
its_TbFKey = make_array(its_TbFNk); its_TbFNam = make_array(its_TbFNk);
its_TbKey(its_TbFKey, its_TbFNam, 0, "type"); its_TbKey(its_TbFKey, its_TbFNam, 1, "status");
its_TbKey(its_TbFKey, its_TbFNam, 2, "phase"); its_TbKey(its_TbFKey, its_TbFNam, 3, "chan");
its_TbKey(its_TbFKey, its_TbFNam, 4, "out"); its_TbKey(its_TbFKey, its_TbFNam, 5, "limiter");
its_TbKey(its_TbFKey, its_TbFNam, 6, "src1"); its_TbKey(its_TbFKey, its_TbFNam, 7, "src2");
its_TbKey(its_TbFKey, its_TbFNam, 8, "src3"); its_TbKey(its_TbFKey, its_TbFNam, 9, "src4");
its_TbKey(its_TbFKey, its_TbFNam, 10, "src5"); its_TbKey(its_TbFKey, its_TbFNam, 11, "src6");
its_TbKey(its_TbFKey, its_TbFNam, 12, "src7"); its_TbKey(its_TbFKey, its_TbFNam, 13, "src8");
its_TbKey(its_TbFKey, its_TbFNam, 14, "gain1"); its_TbKey(its_TbFKey, its_TbFNam, 15, "gain2");
its_TbKey(its_TbFKey, its_TbFNam, 16, "gain3"); its_TbKey(its_TbFKey, its_TbFNam, 17, "gain4");
its_TbKey(its_TbFKey, its_TbFNam, 18, "gain5"); its_TbKey(its_TbFKey, its_TbFNam, 19, "gain6");
its_TbKey(its_TbFKey, its_TbFNam, 20, "gain7"); its_TbKey(its_TbFKey, its_TbFNam, 21, "gain8");
its_TbKey(its_TbFKey, its_TbFNam, 22, "freq"); its_TbKey(its_TbFKey, its_TbFNam, 23, "q");
its_TbKey(its_TbFKey, its_TbFNam, 24, "mode"); its_TbKey(its_TbFKey, its_TbFNam, 25, "stages");
its_TbKey(its_TbFKey, its_TbFNam, 26, "amp"); its_TbKey(its_TbFKey, its_TbFNam, 27, "offset");
its_TbKey(its_TbFKey, its_TbFNam, 28, "spread");
its_TbKey(its_TbFKey, its_TbFNam, 29, "drive"); its_TbKey(its_TbFKey, its_TbFNam, 30, "bias");
its_TbKey(its_TbFKey, its_TbFNam, 31, "mix"); its_TbKey(its_TbFKey, its_TbFNam, 32, "os");
its_TbKey(its_TbFKey, its_TbFNam, 33, "output"); its_TbKey(its_TbFKey, its_TbFNam, 34, "order");
its_TbKey(its_TbFKey, its_TbFNam, 35, "stretch"); its_TbKey(its_TbFKey, its_TbFNam, 36, "amount");
its_TbKey(its_TbFKey, its_TbFNam, 37, "harm");
i__ii = its_TbFMod; loop(its_TbFMINb, its_TbFKey[i__ii] = its_TK_mod; its_TbFNam[i__ii] = "mod"; i__ii += 1;);
// the modulation inputs : symbol, name, type of effect, input number, default depth
its_TbFMI = make_array(its_TbFMINb); its_TbFMIN = make_array(its_TbFMINb); its_TbFMIt = make_array(its_TbFMINb);
its_TbFMIj = make_array(its_TbFMINb); its_TbFMId = make_array(its_TbFMINb);
its_TbFMIN[0] = "Cutoff"; its_TbFMIN[1] = "Reso"; // (as its_ModN_Flt)
its_TbFMIN[2] = "Drive"; its_TbFMIN[3] = "Bias"; its_TbFMIN[4] = "Order"; // (as its_ModN_Sat : "Order" is also the stretch)
i__ii = 0; loop(its_TbFMINb,
    its_TbFMI[i__ii] = its_TK(its_TbFMIN[i__ii]);
    (i__ii < 2) ? (
        its_TbFMIt[i__ii] = its_Efx_TyFilter; its_TbFMIj[i__ii] = i__ii; its_TbFMId[i__ii] = its_ModD_Flt[i__ii];
    ) : (
        its_TbFMIt[i__ii] = its_Efx_TySat; its_TbFMIj[i__ii] = i__ii - 2; its_TbFMId[i__ii] = its_ModD_Sat[i__ii - 2];
    );
    i__ii += 1;
);
// the values : types (index = its_Efx_Ty...), statuses (Off, On, Bypass : its_EfxStat_... ; the limiter : Off, On),
// phases, filter modes, LFO shapes ; their names, their symbols
its_TbFTyN = make_array(its_Efx_TyCnt); its_TbFTy = make_array(its_Efx_TyCnt);
its_TbFTyN[0] = "Undefined"; its_TbFTyN[1] = "None"; its_TbFTyN[2] = "Mixer"; its_TbFTyN[3] = "AutoMix";
its_TbFTyN[4] = "Mover"; its_TbFTyN[5] = "Action"; its_TbFTyN[6] = "Script"; its_TbFTyN[7] = "LFO";
its_TbFTyN[8] = "Filter"; its_TbFTyN[9] = "Saturation";
i__ii = 0; loop(its_Efx_TyCnt, its_TbFTy[i__ii] = its_TK(its_TbFTyN[i__ii]); i__ii += 1;);
its_TbFStN = make_array(4); its_TbFSt = make_array(4);
its_TbFStN[0] = "Off"; its_TbFStN[1] = "On"; its_TbFStN[2] = "Bypass"; its_TbFStN[3] = "Undefined";
i__ii = 0; loop(4, its_TbFSt[i__ii] = its_TK(its_TbFStN[i__ii]); i__ii += 1;);
its_TbFPhN = make_array(3); its_TbFPh = make_array(3);
its_TbFPhN[0] = "Std"; its_TbFPhN[1] = "Pre"; its_TbFPhN[2] = "Post";
i__ii = 0; loop(3, its_TbFPh[i__ii] = mSL_symbol(its_TbFPhN[i__ii]); i__ii += 1;);
its_TbFMdN = make_array(6); its_TbFMd = make_array(6);
its_TbFMdN[its_FltLP1] = "LP1"; its_TbFMdN[its_FltHP1] = "HP1"; its_TbFMdN[its_FltLP] = "LP";
its_TbFMdN[its_FltHP] = "HP"; its_TbFMdN[its_FltBP] = "BP"; its_TbFMdN[its_FltNotch] = "Notch";
i__ii = 0; loop(6, its_TbFMd[i__ii] = mSL_symbol(its_TbFMdN[i__ii]); i__ii += 1;);
its_TbLShN = make_array(5); its_TbLSh = make_array(5);
its_TbLShN[its_LfoSine] = "Sine"; its_TbLShN[its_LfoTri] = "Triangle"; its_TbLShN[its_LfoSawUp] = "SawUp";
its_TbLShN[its_LfoSawDown] = "SawDown"; its_TbLShN[its_LfoSquare] = "Square";
i__ii = 0; loop(5, its_TbLSh[i__ii] = mSL_symbol(its_TbLShN[i__ii]); i__ii += 1;);
its_TbSMdN = make_array(its_SatModeCnt); its_TbSMd = make_array(its_SatModeCnt);
its_TbSMdN[its_SatSoft] = "Soft"; its_TbSMdN[its_SatHard] = "Hard"; its_TbSMdN[its_SatFold] = "Fold";
its_TbSMdN[its_SatSine] = "SineFold"; its_TbSMdN[its_SatXSin] = "XSin"; its_TbSMdN[its_SatCheb] = "Cheb";
its_TbSMdN[its_SatChebSum] = "ChebSum";
i__ii = 0; loop(its_SatModeCnt, its_TbSMd[i__ii] = mSL_symbol(its_TbSMdN[i__ii]); i__ii += 1;);
its_TbHarm = make_array(its_SatHarm); // the weights of the key "harm" (its_TbK1 : their count)
// the keys of the block Global ; track samples (as slSmpl), actions (index : its_GlAct_..., as slGlAct)
its_TbGNk = 6;
its_TbGKey = make_array(its_TbGNk); its_TbGNam = make_array(its_TbGNk);
its_TbKey(its_TbGKey, its_TbGNam, 0, "samples"); its_TbKey(its_TbGKey, its_TbGNam, 1, "input");
its_TbKey(its_TbGKey, its_TbGNam, 2, "output"); its_TbKey(its_TbGKey, its_TbGNam, 3, "latency");
its_TbKey(its_TbGKey, its_TbGNam, 4, "action"); its_TbKey(its_TbGKey, its_TbGNam, 5, "chan");
its_TbGSmN = make_array(3); its_TbGSm = make_array(3);
its_TbGSmN[0] = "Merge"; its_TbGSmN[1] = "Ignore"; its_TbGSmN[2] = "Pass";
i__ii = 0; loop(3, its_TbGSm[i__ii] = mSL_symbol(its_TbGSmN[i__ii]); i__ii += 1;);
its_TbGAc = make_array(6);
its_TbGAc[its_GlAct_None] = mSL_symbol("None"); its_TbGAc[its_GlAct_StopAll] = mSL_symbol("StopAll");
its_TbGAc[its_GlAct_PauseAll] = mSL_symbol("PauseAll"); its_TbGAc[its_GlAct_RestartAll] = mSL_symbol("RestartAll");
its_TbGAc[its_GlAct_RewdAll] = mSL_symbol("RewindAll"); its_TbGAc[its_GlAct_ClearAll] = mSL_symbol("ClearAll");

its_TbNSz = 512; // the names of a table
its_TbNScp = make_array(its_TbNSz); // their scope : 0 the table, k the instance k
its_TbNSym = make_array(its_TbNSz);
its_TbNTyp = make_array(its_TbNSz);
its_TbNIdx = make_array(its_TbNSz);
its_TbResv = make_array(LN_CNT + WR_CNT + RD_CNT + FX_CNT); // 1 : a module designated by a number, or given to a name
its_TbSimSp = make_array(LN_CNT + 1); // the simulation of pass 2 : the lines (samples, 0 : no line)
its_TbSimCh = make_array(LN_CNT + 1); // and their channels
its_TbSimWE = make_array(WR_CNT + 1); // the writers : 1 if they exist
its_TbSimWL = make_array(WR_CNT + 1); // their line (-1 : none)
its_TbSimRE = make_array(RD_CNT + 1); // the readers : 1 if they exist
its_TbSimFE = make_array(FX_CNT + 1); // the effects : 1 if they exist
its_TbSimFT = make_array(FX_CNT + 1); // their type
its_TbSimLO = make_array(LN_CNT + 1); // the owner of each line, writer, reader, effect (0 : none, k : the instance k)
its_TbSimWO = make_array(WR_CNT + 1);
its_TbSimRO = make_array(RD_CNT + 1);
its_TbSimFO = make_array(FX_CNT + 1);
its_TbKSz = 48; // (keys of the effects : its_TbFNk)
its_TbKS = make_array(its_TbKSz); // the keys of a block : 1 if given
its_TbK1 = make_array(its_TbKSz); // their value
its_TbK2 = make_array(its_TbKSz); // their second value (first channel of a source, of an output)
its_TbK3 = make_array(its_TbKSz); // modulations : the depth, the attenuverter (Undef : not given)
its_TbK4 = make_array(its_TbKSz);

// the next word (the commas are skipped), its_TK_End after the last one
// (and the markers of the instances : they change the scope of the names, its_Tb_scope)
function its_Tb_Peek() local(w)
(
    w = its_TK_End;
    while ((its_Tb_ptr < its_Tb_itc) && (((w = its_Tb_tbl[its_Tb_ptr]) === mSL_cstComma) || (w <= its_TbM_Base))) (
        (w === its_TbM_Ins) ? (
            its_Tb_ptr += 1; its_Tb_pi = its_Tb_tbl[its_Tb_ptr];
            its_Tb_scope = its_IPK[its_Tb_pi];
        ) :
        (w === its_TbM_InsEnd) ? (
            (its_Tb_mode === 3) ? (its_Tb_cpend = its_Tb_pi); // the instance is recorded (its_Al_Flush)
            its_Tb_scope = 0;
        ) :
        (w === its_TbM_Out) ? ( its_Tb_sscope = its_Tb_scope; its_Tb_scope = 0; ) :
        (w === its_TbM_In) ? ( its_Tb_scope = its_Tb_sscope; ) :
        (w === its_TbM_Set) ? (
            its_Tb_ptr += 1; its_Tb_si = its_Tb_tbl[its_Tb_ptr];
            its_Tb_scope = its_SPK[its_Tb_si]; its_Tb_setm = 1;
        ) :
        (w === its_TbM_SetEnd) ? (
            (its_Tb_mode === 3) ? (its_Tb_spend = its_Tb_si); // the arguments are recorded (its_Al_Flush)
            its_Tb_scope = 0; its_Tb_setm = 0;
        ) :
        (w === its_TbM_Chg) ? ( its_Tb_chg = 1; );
        its_Tb_ptr += 1; w = its_TK_End;
    );
    w;
);

function its_Tb_Next() local(w)
(
    w = its_Tb_Peek();
    (its_Tb_ptr < its_Tb_itc) ? (its_Tb_ptr += 1);
    w;
);

// the first error stops the analysis
function its_Tb_Err(code, msg)
(
    (its_Tb_error === 0) ? (
        its_Tb_error = code;
        sprintf(#its_TbMsg, "ERR: %04d    Interstys table (word %d) : %s", code, its_Tb_ptr, msg);
        mSL_log(SysLogBox, #its_TbMsg);
    );
);

function its_Tb_IsName(w) local(i, r)
(
    r = (w > mSL_Sym_Low) && (w < mSL_Sym_High);
    i = 0; while (r && (i < its_TK_Cnt)) ( (its_TK_List[i] === w) ? (r = 0); i += 1; );
    r;
);

// a header ends the current block
function its_Tb_IsHead(w)
(
    (w === its_TK_Clear) || (w === its_TK_Line) || (w === its_TK_Writer) || (w === its_TK_Reader)
        || (w === its_TK_Effect) || (w === its_TK_Global) || (w === its_TK_Dump) || (w === its_TK_Check)
        || (w === its_TK_Free) || (w === its_TK_End) || (w === its_TK_EofMark) || (w === its_TK_Algorithm)
        || (w === its_TK_Instance) || (w === its_TK_Set);
);

// a number in [vmin, vmax] (a "-" word before it changes its sign) ; Undef and an error otherwise
function its_Tb_Num(key, vmin, vmax) local(w, s)
(
    s = 1;
    ((w = its_Tb_Next()) === mSL_cstMinus) ? ( s = -1; w = its_Tb_Next(); );
    (abs(w) < mSL_CharConst) ? (w *= s);
    ((abs(w) < mSL_CharConst) && (w >= vmin) && (w <= vmax)) ? w : (
        sprintf(#its_TbW, "%s : %s is not a value in [%g, %g]", key, mSL_edit_value(#its_TbV, w), vmin, vmax);
        its_Tb_Err(2754, #its_TbW);
        Undef;
    );
);

function its_Tb_Int(key, vmin, vmax) local(v)
(
    v = its_Tb_Num(key, vmin, vmax);
    ((its_Tb_error === 0) && (v !== floor(v))) ? (
        sprintf(#its_TbW, "%s : %g is not an integer", key, v);
        its_Tb_Err(2754, #its_TbW);
    );
    v;
);

// one of the "n" symbols of "syms" : its index
function its_Tb_Enum(key, syms, n) local(w, i, k)
(
    w = its_Tb_Next();
    k = -1; i = 0; while ((k < 0) && (i < n)) ( (syms[i] === w) ? (k = i); i += 1; );
    (k < 0) ? (
        sprintf(#its_TbW, "%s : %s is not a possible value", key, mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2754, #its_TbW);
    );
    k;
);

function its_Tb_KeyErr(w, blk)
(
    sprintf(#its_TbW, "%s : unknown key %s", blk, mSL_edit_value(#its_TbV, w));
    its_Tb_Err(2753, #its_TbW);
);

function its_Tb_TyName(ty)
(
    (ty === its_TK_Line) ? "Line" : (ty === its_TK_Writer) ? "Writer" : (ty === its_TK_Reader) ? "Reader" : "Effect";
);

function its_Tb_Count(ty)
(
    (ty === its_TK_Line) ? LN_CNT : (ty === its_TK_Writer) ? WR_CNT : (ty === its_TK_Reader) ? RD_CNT : FX_CNT;
);

// the first entry of the type "ty" in its_TbResv
function its_Tb_RBase(ty)
(
    (ty === its_TK_Line) ? 0 : (ty === its_TK_Writer) ? LN_CNT : (ty === its_TK_Reader) ? LN_CNT + WR_CNT : LN_CNT + WR_CNT + RD_CNT;
);

// the module "i" of the type "ty" exists in the simulation
function its_Tb_SimEx(ty, i)
(
    (ty === its_TK_Line) ? (its_TbSimSp[i] > 0) : (ty === its_TK_Writer) ? its_TbSimWE[i] : (ty === its_TK_Reader) ? its_TbSimRE[i] :
        its_TbSimFE[i];
);

// the name "w" in the current scope (its_Tb_scope) : its entry, or -1
function its_Tb_Find(w) local(i, k)
(
    k = -1; i = 0;
    while ((k < 0) && (i < its_TbNCnt)) ( ((its_TbNSym[i] === w) && (its_TbNScp[i] === its_Tb_scope)) ? (k = i); i += 1; );
    k;
);

/*
    the module of type "ty" designated by the word "w" : 0 ... count-1 ; -1 after an error ;
    -2 for a name which has no module yet (passes 0 and 1) ; "head" : 1 in the header of a block
*/
function its_Tb_Id(ty, w, head) local(k, i, n, rb)
(
    k = -1;
    its_Tb_idLocal = 0; // 1 : a name of an instance (its module belongs to the instance : its_Tb_own)
    n = its_Tb_Count(ty);
    ((w === floor(w)) && (w >= 1) && (w <= n)) ? (
        k = w - 1;
    ) :
    its_Tb_IsName(w) ? (
        ((i = its_Tb_Find(w)) >= 0) ? (
            (its_TbNTyp[i] === ty) ? (
                k = its_TbNIdx[i];
                its_Tb_idLocal = (its_Tb_scope > 0);
            ) : (
                sprintf(#its_TbW, "%s is not a %s", mSL_edit_value(#its_TbV, w), its_Tb_TyName(ty));
                its_Tb_Err(2756, #its_TbW);
            );
        ) :
        ((its_Tb_mode === 0) || ((its_Tb_mode === 1) && !head)) ? (
            k = -2;
        ) :
        (its_Tb_mode === 1) ? (
            // a free module, that no number of the table designates
            rb = its_Tb_RBase(ty);
            i = 0; while ((k < 0) && (i < n)) ( ((its_Tb_SimEx(ty, i) == 0) && (its_TbResv[rb + i] === 0)) ? (k = i); i += 1; );
            (k < 0) ? (
                sprintf(#its_TbW, "no free %s for %s", its_Tb_TyName(ty), mSL_edit_value(#its_TbV, w));
                its_Tb_Err(2755, #its_TbW);
            ) :
            (its_TbNCnt >= its_TbNSz) ? (
                k = -1;
                its_Tb_Err(2762, "too many names");
            ) : (
                its_TbNSym[its_TbNCnt] = w; its_TbNTyp[its_TbNCnt] = ty; its_TbNIdx[its_TbNCnt] = k;
                its_TbNScp[its_TbNCnt] = its_Tb_scope;
                its_TbNCnt += 1;
                its_TbResv[rb + k] = 1;
                its_Tb_idLocal = (its_Tb_scope > 0);
                (its_Tb_scope > 0) ? (
                    sprintf(#its_TbW, "Interstys table : %s = %s %d (instance %d)", mSL_edit_value(#its_TbV, w), its_Tb_TyName(ty), k + 1,
                        its_Tb_scope);
                ) : (
                    sprintf(#its_TbW, "Interstys table : %s = %s %d", mSL_edit_value(#its_TbV, w), its_Tb_TyName(ty), k + 1);
                );
                mSL_log(SysLogBox, #its_TbW);
            );
        ) : (
            sprintf(#its_TbW, "unknown name %s", mSL_edit_value(#its_TbV, w));
            its_Tb_Err(2757, #its_TbW);
        );
    ) : (
        sprintf(#its_TbW, "%s : bad identifier %s (1 ... %d, or a name)", its_Tb_TyName(ty), mSL_edit_value(#its_TbV, w), n);
        its_Tb_Err(2752, #its_TbW);
    );
    k;
);

// the type of module named by the word "w" (Line, Writer, Reader, Effect), or 0 and an error
function its_Tb_Type(w, what)
(
    ((w === its_TK_Line) || (w === its_TK_Writer) || (w === its_TK_Reader) || (w === its_TK_Effect)) ? w : (
        sprintf(#its_TbW, "%s : %s is not Line, Writer, Reader or Effect", what, mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2751, #its_TbW);
        0;
    );
);

// the modules as they are now, for the simulation
function its_Tb_SimInit() local(i, b)
(
    i = 0; loop(LN_CNT,
        b = Lines_Set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_lcbl)) ? (
            its_TbSimSp[i] = b[its_Lin_SmplCnt]; its_TbSimCh[i] = b[its_Lin_ChCnt]; its_TbSimLO[i] = b[its_Lin_Owner];
        ) : (
            its_TbSimSp[i] = its_TbSimCh[i] = its_TbSimLO[i] = 0;
        );
        i += 1;
    );
    i = 0; loop(WR_CNT,
        b = Writers_set[i];
        (its_TbSimWE[i] = ((b > BASE_MEMORY) && (b[-2] === KW_writ))) ? (
            its_TbSimWL[i] = b[its_Wrt_LineNb]; its_TbSimWO[i] = b[its_Wrt_Owner];
        ) : (
            its_TbSimWL[i] = -1; its_TbSimWO[i] = 0;
        );
        i += 1;
    );
    i = 0; loop(RD_CNT,
        b = Readers_set[i];
        its_TbSimRO[i] = (its_TbSimRE[i] = (b > BASE_MEMORY) && (b[-2] === KW_read)) ? b[its_Rdr_Owner] : 0;
        i += 1;
    );
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        its_TbSimFT[i] = (its_TbSimFE[i] = ((b > BASE_MEMORY) && (b[-2] === KW_effx))) ? b[its_Efx_Type] : 0;
        its_TbSimFO[i] = its_TbSimFE[i] ? b[its_Efx_Owner] : 0;
        i += 1;
    );
);

// a reader of line "k" which uses channels beyond "nch" : its number + 1, or 0
function its_Tb_ChUser(k, nch) local(i, r, u)
(
    u = 0; i = 0;
    while ((u === 0) && (i < RD_CNT)) (
        (((r = Readers_set[i]) > BASE_MEMORY) && (r[-2] === KW_read) && (r[its_Rdr_LineNb] === k)
            && (r[its_Rdr_Bf1stChan] + r[its_Rdr_BfChanUsed] > nch)) ? (u = i + 1);
        i += 1;
    );
    u;
);

// the line "lnum" was replaced by Ln_Make : its writers and readers take the new line and keep their settings
function Ln_Rebind(lnum)
local (lcbl, i, j, r, w, d)
(
    lcbl = Lines_Set[lnum];
    i = 0; loop(WR_CNT,
        (((w = Writers_set[i]) > BASE_MEMORY) && (w[-2] === KW_writ) && (w[its_Wrt_LineNb] === lnum)) ? (
            Wr_Set_Line(i, lnum); // (the delay readers follow : Wr_Followers)
        );
        i += 1;
    );
    i = 0; loop(RD_CNT,
        (((r = Readers_set[i]) > BASE_MEMORY) && (r[-2] === KW_read) && (r[its_Rdr_LineNb] === lnum)
            && (r[its_Rdr_Mode] === its_RdrMode_Read)) ? (
            r[its_Rdr_Check] = 0; // first : @sample checks the reader again (exec_reader)
            r[its_Rdr_Lcbl] = lcbl;
            r[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
            r[its_Rdr_SmplCntSec] = d = lcbl[its_Lin_SmplCntSec];
            r[its_Rdr_ChNbr] = lcbl[its_Lin_ChCnt];
            r[its_Rdr_Start] = lcbl[its_Lin_Start];
            r[its_Rdr_Low] = r[its_Rdr_Start] - B_FADESIZ;
            r[its_Rdr_Last] = lcbl[its_Lin_Last];
            r[its_Rdr_High] = r[its_Rdr_Last] + B_FADESIZ;
            r[its_Rdr_LinSfreq] = lcbl[its_Lin_RecFreq];
            r[its_Rdr_AdjInc] = lcbl[its_Lin_RecFreq] / srate;
            j = 0; loop(its_RdrMaxMulti,
                r[its_Rdr_Abspos + j] = min(max(r[its_Rdr_Abspos + j], r[its_Rdr_Start]), r[its_Rdr_Last] - 1);
                j += 1;
            );
            // the region in the new length, recomputed by Rd_Update
            r[its_Rdr_RegSizeSec] = min(r[its_Rdr_RegSizeSec], d);
            r[its_Rdr_RegPosSec] = min(r[its_Rdr_RegPosSec], d);
            r[its_Rdr_RegSizeSecPrv] = r[its_Rdr_RegPosSecPrv] = -1;
            Rd_Update(i);
            r[its_Rdr_Check] = 0;
        );
        i += 1;
    );
    (slLine === lnum) ? (CurrLine = lcbl);
    wrupdt = rdupdt = lnupdt = 1;
);

/*
    Read the sound file "fname" into the line "lnb" : the line is created, or replaced if its size or its channels differ
    (its writers and readers follow, Ln_Rebind) ; it keeps the name of the file (its_LnFile) ; runs in @gfx
    Result : 0, or an error (logged) : 2771 the file can't be opened, 2772 not a sound file for a line (channels not in
    [1, 128], frequency not in [2400, 384000], too short, more than 67108864 samples), 2773 read error (the line is then
    not the file : its name is cleared), 2610 not enough memory (logged by Ln_Make) ; except for 2773, the line is unchanged
*/
function Ln_Load_File(lnb, fname)
local (fh, cc, fr, fsz, nfr, lcbl, err, wasold, bread, ptbuf, bcnt, rdcnt, i, c, pb, addbuffs)
(
    err = cc = fr = nfr = 0;
    ((fh = file_open(fname)) < 0) ? (
        err = 2771;
    ) : (
        file_riff(fh, cc, fr);
        ((cc < 1) || (cc > 128) || (fr < 2400) || (fr > 384000)) ? (err = 2772) : (
            fsz = file_avail(fh);
            nfr = floor(fsz / cc);
            ((fsz <= 480) || (nfr > 67108864)) ? (err = 2772);
        );
    );
    (err === 0) ? (
        lcbl = Lines_Set[lnb];
        wasold = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
        // the same size and channels : the line is kept ; otherwise, a new one ((nfr - 0.5) / srate gives nfr samples)
        (!wasold || (lcbl[its_Lin_SmplCnt] !== nfr) || (lcbl[its_Lin_ChCnt] !== cc)) ? (
            ((lcbl = Ln_Make(lnb, srate, (nfr - 0.5) / srate, cc)) <= BASE_MEMORY) ? (err = 2610); // (logged by Ln_Make)
        );
    );
    (err === 0) ? (
        // read by blocks of BFFSIZ samples, dispatched in the channels buffers
        bread = 0; ptbuf = BF_LIM; bcnt = cc * floor(BFFSIZ / cc);
        addbuffs = lcbl + its_Lin_BF1ST;
        fsz = nfr * cc;
        while (bread < fsz) (
            rdcnt = min(bcnt, fsz - bread);
            (file_mem(fh, savwrk, rdcnt) != rdcnt) ? (
                err = 2773;
                bread = fsz;
            ) : (
                i = 0; while (i < rdcnt) (
                    c = 0; loop(cc, pb = addbuffs[c]; pb[ptbuf] = savwrk[i + c]; c += 1;);
                    i += cc; ptbuf += 1;
                );
                bread += rdcnt;
            );
        );
    );
    (err === 0) ? (
        lcbl[its_Lin_RecFreq] = lcbl[its_Lin_Tmp2] = fr;
        lcbl[its_Lin_Used] = nfr + BF_LIM;
        // duplicate the start and the end samples around the buffers (as File_Handle)
        c = 0; loop(cc,
            pb = addbuffs[c];
            memcpy(pb, pb + nfr, BF_LIM);
            memcpy(pb + nfr + BF_LIM, pb + BF_LIM, BF_LIM);
            c += 1;
        );
        strcpy(its_LnFile[lnb], fname);
        wasold ? Ln_Rebind(lnb); // (the frequency of the file, a new block)
        lnupdt = 1;
    ) :
    (err !== 2610) ? (
        (err === 2773) ? strcpy(its_LnFile[lnb], ""); // (the line is not the file)
        sprintf(#its_LnFMsg, "ERR: %04d    Line %d : %s \"%s\"", err, lnb + 1,
            (err === 2771) ? "can't open" : (err === 2772) ? "not a sound file for a line :" : "read error in", fname);
        mSL_log(SysLogBox, #its_LnFMsg);
    );
    (fh >= 0) ? file_close(fh);
    err;
);

/*
    The folder of the project (#its_PrjDir, its_PrjSt = 2 when it is known) : asked to GMAuxiliary.eel (command 21), the answer
    is in the exploded gmem string (getexpldstr) ; its_PrjDir_Poll runs at each frame of @gfx ; its_PrjSt : 0 to ask, 1 asked
    (at its_PrjRq), 2 known, 3 GMAuxiliary.eel absent or busy (asked again 2 s later)
*/
its_PrjSt = 0; its_PrjRq = 0; #its_PrjDir = "";
function its_PrjDir_Poll()
local (t)
(
    t = time_precise() + timeD;
    (its_PrjSt === 0) ? (
        ((gmem[versionGMScript] != 0) && (gmem[dateDone] >= gmem[dateCfrm])) ? (
            gmem[cmndKode] = 21;
            gmem[dateRqst] = gmem[dateCfrm] = its_PrjRq = t; // (the dates last : the script starts on them)
            its_PrjSt = 1;
        ) : (
            its_PrjSt = 3; its_PrjRq = t;
        );
    ) :
    (its_PrjSt === 1) ? (
        (gmem[dateDone] > its_PrjRq) ? (
            getexpldstr(#its_PrjDir, 0);
            (strlen(#its_PrjDir) > 0) ? (
                its_PrjSt = 2;
                sprintf(#its_LnFMsg, "Project folder : %s", #its_PrjDir);
                mSL_log(SysLogBox, #its_LnFMsg);
            ) : (
                its_PrjSt = 3; its_PrjRq = t;
            );
        ) :
        (t - its_PrjRq > 5) ? (
            its_PrjSt = 3; its_PrjRq = t;
        );
    ) :
    ((its_PrjSt === 3) && (t - its_PrjRq > 2)) ? (
        its_PrjSt = 0;
    );
);

/*
    After a load (its_Load_Install : the lines are saved without their samples), the lines which had a file read it again :
    one line per frame of @gfx ; an error is logged (Ln_Load_File) and the line keeps the name of its file ("Reload")
*/
its_LnRldPend = its_LnRldIdx = its_LnRldOk = its_LnRldErr = 0;
function its_Ln_AutoReload()
local (k)
(
    (its_LnRldPend) ? (
        k = its_LnRldIdx;
        while ((k < LN_CNT) && (strlen(its_LnFile[k]) === 0)) ( k += 1; );
        (k < LN_CNT) ? (
            strcpy(#its_LnFTmp, its_LnFile[k]); // (Ln_Load_File writes its_LnFile)
            (Ln_Load_File(k, #its_LnFTmp) === 0) ? (its_LnRldOk += 1) : (its_LnRldErr += 1);
            its_LnRldIdx = k + 1;
        ) : (
            its_LnRldPend = 0;
            ((its_LnRldOk + its_LnRldErr) > 0) ? (
                sprintf(#its_LnFMsg, "Lines : %d file(s) read again, %d error(s)", its_LnRldOk, its_LnRldErr);
                mSL_log(SysLogBox, #its_LnFMsg);
            );
        );
    );
);

// the file "name" in "str" : as is if it is absolute, otherwise in the folder of the project ; 0 if this folder is unknown
function its_Path(str, name)
local (c0)
(
    c0 = str_getchar(name, 0, 'cu');
    ((c0 === '/') || (c0 === '\\') || (str_getchar(name, 1, 'cu') === ':')) ? (
        strcpy(str, name);
    ) :
    (its_PrjSt === 2) ? (
        strcpy(str, #its_PrjDir);
        strcat(str, (str_getchar(#its_PrjDir, 1, 'cu') === ':') ? "\\" : "/");
        strcat(str, name);
    ) : 0;
);

// the instance "k" of an algorithm is forgotten (its modules are not deleted)
function its_Al_InsDrop(k)
(
    (its_InsTpl[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_InsTpl[k]);
    (its_InsArg[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_InsArg[k]);
    (its_InsNam[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_InsNam[k]);
    its_InsSym[k] = its_InsAName[k] = its_InsTpl[k] = its_InsArg[k] = its_InsNam[k] = 0;
    its_InsTLen[k] = its_InsALen[k] = its_InsNCnt[k] = 0;
);

function its_Tb_Clear() local(k)
(
    (its_Tb_mode === 3) ? (
        its_actions(its_GlAct_DelAll);
        k = 1; loop(its_InsMx, (its_InsSym[k] !== 0) ? its_Al_InsDrop(k); k += 1;); // (their modules are deleted)
    ) : (
        memset(its_TbSimSp, 0, LN_CNT); memset(its_TbSimCh, 0, LN_CNT);
        memset(its_TbSimWE, 0, WR_CNT); memset(its_TbSimRE, 0, RD_CNT);
        memset(its_TbSimFE, 0, FX_CNT); memset(its_TbSimFT, 0, FX_CNT);
        its_Tb_clr = 1; // no more readers
    );
);

//—— Lines
// "file" : the path of the file in #its_TbFile (its_Path), its channels and its samples in its_Tb_fcc, its_Tb_fnfr ;
// 0 and an error if it can't be read
function its_Tb_File(name) local(fh, cc, fr, ok)
(
    ok = 0;
    !mSL_isString(name) ? (
        sprintf(#its_TbW, "file : %s is not a string", mSL_edit_value(#its_TbV, name));
        its_Tb_Err(2754, #its_TbW);
    ) :
    (its_Path(#its_TbFile, name) === 0) ? (
        (its_PrjSt === 3) ? (its_PrjSt = 0); // (asked again)
        sprintf(#its_TbW, "file \"%s\" : the folder of the project is unknown (GMAuxiliary.eel)", name);
        its_Tb_Err(2769, #its_TbW);
    ) :
    ((fh = file_open(#its_TbFile)) < 0) ? (
        sprintf(#its_TbW, "file \"%s\" : can't be opened", #its_TbFile);
        its_Tb_Err(2770, #its_TbW);
    ) : (
        cc = fr = 0;
        file_riff(fh, cc, fr);
        its_Tb_fcc = cc; its_Tb_fnfr = floor(file_avail(fh) / max(1, cc));
        file_close(fh);
        ((cc < 1) || (cc > 128) || (fr < 2400) || (fr > 384000) || (its_Tb_fnfr * cc <= 480) || (its_Tb_fnfr > 67108864)) ? (
            sprintf(#its_TbW, "file \"%s\" : %d channels, %d Hz, %d samples : not a sound file for a line", #its_TbFile, cc, fr, its_Tb_fnfr);
            its_Tb_Err(2770, #its_TbW);
        ) : (
            ok = 1;
        );
    );
    ok;
);

function its_Tb_Line() local(w, k, len, ch, spl, sp, cc, nsp, nch, lcbl, u, r, fil, err, own)
(
    k = its_Tb_Id(its_TK_Line, its_Tb_Next(), 1);
    own = its_Tb_idLocal ? its_Tb_scope : 0; // a line of an instance
    len = ch = spl = -1; fil = 0;
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        its_Tb_chg = 0;
        (w === its_TK_length) ? ( len = its_Tb_Num("length", 0.001, 67108864 / srate); (its_Tb_setm && !its_Tb_chg) ? (len = -1); ) :
        (w === its_TK_chan) ? ( ch = its_Tb_Int("chan", 1, 128); (its_Tb_setm && !its_Tb_chg) ? (ch = -1); ) :
        (w === its_TK_spls) ? ( spl = its_Tb_Int("spls", 48, 67108864); (its_Tb_setm && !its_Tb_chg) ? (spl = -1); ) :
        (w === its_TK_freq) ? ( its_Tb_Num("freq", 2400, 384000); ) :
        (w === its_TK_status) ? ( its_Tb_Next(); ) :
        (w === its_TK_file) ? ( fil = its_Tb_Next(); (its_Tb_setm && !its_Tb_chg) ? (fil = 0); ) :
        its_Tb_KeyErr(w, "Line");
    );
    // a file : its size and its channels (length, chan, spls are then ignored : a Dump can be read again)
    ((its_Tb_error === 0) && (k >= 0) && (fil !== 0) && (its_Tb_mode >= 2) && its_Tb_File(fil)) ? (
        spl = its_Tb_fnfr; ch = its_Tb_fcc;
    );
    ((its_Tb_error === 0) && (k >= 0)) ? (
        (its_Tb_mode === 0) ? (
            its_TbResv[k] = 1;
        ) :
        (its_Tb_mode >= 2) ? (
            (its_Tb_mode === 2) ? (
                sp = its_TbSimSp[k]; cc = its_TbSimCh[k];
            ) : (
                lcbl = Lines_Set[k];
                ((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
                    sp = lcbl[its_Lin_SmplCnt]; cc = lcbl[its_Lin_ChCnt];
                ) : (
                    sp = cc = 0;
                );
            );
            // the new size, as Ln_Make computes it
            nsp = (spl > 0) ? spl : (len > 0) ? max(48, min(67108864, ceil(len * srate))) : (sp > 0) ? sp : srate;
            nch = (ch > 0) ? ch : (cc > 0) ? cc : 2;
            (its_Tb_mode === 2) ? (
                ((sp > 0) && (its_Tb_clr === 0) && ((nsp !== sp) || (nch !== cc)) && ((u = its_Tb_ChUser(k, nch)) > 0)) ? (
                    r = Readers_set[u - 1];
                    sprintf(#its_TbW, "Line %d chan %d : Reader %d uses its channels %d-%d", k + 1, nch, u,
                        r[its_Rdr_Bf1stChan], r[its_Rdr_Bf1stChan] + r[its_Rdr_BfChanUsed] - 1);
                    its_Tb_Err(2758, #its_TbW);
                );
                its_TbSimSp[k] = nsp; its_TbSimCh[k] = nch;
                (own > 0) ? (its_TbSimLO[k] = own);
            ) :
            (fil !== 0) ? (
                // read the file into the line (created, or replaced if it differs)
                ((err = Ln_Load_File(k, #its_TbFile)) === 2610) ? (
                    its_Tb_error = 2610; // (logged by Ln_Make)
                ) :
                (err !== 0) ? (
                    sprintf(#its_TbW, "file \"%s\" : error %04d", #its_TbFile, err);
                    its_Tb_Err(err, #its_TbW);
                );
            ) :
            ((nsp !== sp) || (nch !== cc)) ? (
                // create, or replace by a different line ; (nsp - 0.5) / srate gives nsp samples in Ln_Make
                (Ln_Make(k, srate, (nsp - 0.5) / srate, nch) > BASE_MEMORY) ? (
                    (sp > 0) ? Ln_Rebind(k);
                    strcpy(its_LnFile[k], ""); // (no file any more)
                    lnupdt = 1;
                ) : (
                    its_Tb_error = 2610; // (logged by Ln_Make)
                );
            );
            ((its_Tb_mode === 3) && (own > 0) && ((lcbl = Lines_Set[k]) > BASE_MEMORY)) ? (lcbl[its_Lin_Owner] = own);
        );
    );
);

function its_Tb_DumpLine(k) local(lcbl)
(
    lcbl = Lines_Set[k];
    ((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        sprintf(#its_TbW, "Line %d status Ready length %.3f chan %d spls %d freq %d", k + 1,
            lcbl[its_Lin_SmplCntSec], lcbl[its_Lin_ChCnt], lcbl[its_Lin_SmplCnt], lcbl[its_Lin_RecFreq]);
        (strlen(its_LnFile[k]) > 0) ? strcat(#its_TbW, sprintf(#its_TbV1, " file \"%s\"", its_LnFile[k]));
    ) : (
        sprintf(#its_TbW, "Line %d status Undefined", k + 1);
    );
    mSL_log(SysLogBox, #its_TbW);
);

// a difference found by Check : logged as an error, the analysis goes on
function its_Tb_Diff(k, key, v, x)
(
    sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Line %d : %s %.10g (expected %.10g)", k + 1, key, v, x);
    mSL_log(SysLogBox, #its_TbMsg);
    (its_Tb_res === 0) ? (its_Tb_res = 2759);
);

function its_Tb_CheckLine(k) local(w, lcbl, ex, ok, v)
(
    lcbl = (k >= 0) ? Lines_Set[k] : 0;
    ex = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
    ok = (its_Tb_mode === 3) && (k >= 0);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        (w === its_TK_status) ? (
            v = its_Tb_Next();
            ((v !== its_TK_Ready) && (v !== its_TK_Undefined)) ? (
                sprintf(#its_TbW, "Check : status %s is not Ready or Undefined", mSL_edit_value(#its_TbV, v));
                its_Tb_Err(2754, #its_TbW);
            ) :
            (ok && (ex !== (v === its_TK_Ready))) ? (
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Line %d : status %s (expected %s)",
                    k + 1, ex ? "Ready" : "Undefined", ex ? "Undefined" : "Ready");
                mSL_log(SysLogBox, #its_TbMsg);
                (its_Tb_res === 0) ? (its_Tb_res = 2759);
                ok = -1;
            );
        ) :
        (w === its_TK_length) ? (
            v = its_Tb_Num("length", 0, 67108864 / srate);
            (ok && (its_Tb_error === 0) && (!ex || (abs(lcbl[its_Lin_SmplCntSec] - v) >= 0.0005))) ? (
                its_Tb_Diff(k, "length", ex ? lcbl[its_Lin_SmplCntSec] : 0, v); ok = -1;
            );
        ) :
        (w === its_TK_chan) ? (
            v = its_Tb_Int("chan", 0, 128);
            (ok && (its_Tb_error === 0) && ((ex ? lcbl[its_Lin_ChCnt] : 0) !== v)) ? (
                its_Tb_Diff(k, "chan", ex ? lcbl[its_Lin_ChCnt] : 0, v); ok = -1;
            );
        ) :
        (w === its_TK_spls) ? (
            v = its_Tb_Int("spls", 0, 67108864);
            (ok && (its_Tb_error === 0) && ((ex ? lcbl[its_Lin_SmplCnt] : 0) !== v)) ? (
                its_Tb_Diff(k, "spls", ex ? lcbl[its_Lin_SmplCnt] : 0, v); ok = -1;
            );
        ) :
        (w === its_TK_freq) ? (
            v = its_Tb_Num("freq", 0, 384000);
            (ok && (its_Tb_error === 0) && ((ex ? lcbl[its_Lin_RecFreq] : 0) !== v)) ? (
                its_Tb_Diff(k, "freq", ex ? lcbl[its_Lin_RecFreq] : 0, v); ok = -1;
            );
        ) :
        (w === its_TK_file) ? (
            // the file (its path, as the key "file" of a line)
            v = its_Tb_Next();
            (!mSL_isString(v)) ? (
                sprintf(#its_TbW, "Check : file %s is not a string", mSL_edit_value(#its_TbV, v));
                its_Tb_Err(2754, #its_TbW);
            ) :
            (ok && (its_Path(#its_TbFile, v) !== 0) && (strcmp(#its_TbFile, its_LnFile[k]) !== 0)) ? (
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Line %d : file \"%s\" (expected \"%s\")", k + 1,
                    its_LnFile[k], #its_TbFile);
                mSL_log(SysLogBox, #its_TbMsg);
                (its_Tb_res === 0) ? (its_Tb_res = 2759);
                ok = -1;
            );
        ) :
        its_Tb_KeyErr(w, "Check Line");
    );
    ((ok === 1) && (its_Tb_error === 0)) ? (
        sprintf(#its_TbW, "Check Line %d OK", k + 1);
        mSL_log(SysLogBox, #its_TbW);
    );
);

//—— Writers and readers

// the first channel after an optional ":" (0 without it)
function its_Tb_ChOpt(key)
(
    (its_Tb_Peek() === its_TK_Colon) ? ( its_Tb_Next(); its_Tb_Int(key, 0, 127); ) : 0;
);

// a source (dst = 0 ; "none" : no source) or the destination of an output (dst = 1) : its_Tb_v1 (kind * ITS_KMul + number,
// 0 : none or own cable), its_Tb_v2 (first channel)
function its_Tb_Src(key, dst) local(w, n)
(
    its_Tb_v1 = its_Tb_v2 = 0;
    w = its_Tb_Next();
    ((dst && (w === its_TK_Own)) || (!dst && (w === its_TK_none))) ? (
        0;
    ) :
    ((!dst && (w === its_TK_In)) || (w === its_TK_Out)) ? (
        (its_Tb_Next() !== its_TK_Colon) ? (
            sprintf(#its_TbW, "%s : %s:channel expected", key, (w === its_TK_In) ? "In" : "Out");
            its_Tb_Err(2754, #its_TbW);
        ) : (
            its_Tb_v2 = its_Tb_Int(key, 0, CH_NB - 1);
            its_Tb_v1 = ((w === its_TK_In) ? ITS_KIn : ITS_KOut) * ITS_KMul;
        );
    ) :
    (w === its_TK_Bus) ? (
        n = its_Tb_Int(key, 1, NB_BUS);
        its_Tb_v1 = ITS_KBus * ITS_KMul + n - 1;
        its_Tb_v2 = its_Tb_ChOpt(key);
    ) :
    (!dst && (w === its_TK_Ctl)) ? (
        n = its_Tb_Int(key, 1, NB_CTL);
        its_Tb_v1 = ITS_KCtl * ITS_KMul + n - 1;
    ) :
    (!dst && (w === its_TK_Reader)) ? (
        n = its_Tb_Id(its_TK_Reader, its_Tb_Next(), 0);
        its_Tb_v1 = ITS_KRdr * ITS_KMul + max(0, n);
        its_Tb_v2 = its_Tb_ChOpt(key);
    ) :
    (!dst && (w === its_TK_Effect)) ? (
        n = its_Tb_Id(its_TK_Effect, its_Tb_Next(), 0);
        its_Tb_v1 = ITS_KFx * ITS_KMul + max(0, n);
        its_Tb_v2 = its_Tb_ChOpt(key);
    ) : (
        sprintf(#its_TbW, "%s : %s is not a %s", key, mSL_edit_value(#its_TbV, w), dst ? "destination" : "source");
        its_Tb_Err(2754, #its_TbW);
    );
);

// the text of a source or a destination (as read by its_Tb_Src)
function its_Tb_SrcText(str, src, off)
local (k, n)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    (src === 0) ? strcpy(str, "none") :
    (k === ITS_KIn) ? sprintf(str, "In:%d", off) :
    (k === ITS_KOut) ? sprintf(str, "Out:%d", off) :
    (k === ITS_KBus) ? sprintf(str, "Bus %d:%d", n + 1, off) :
    (k === ITS_KCtl) ? sprintf(str, "Ctl %d", n + 1 + off) :
    (k === ITS_KRdr) ? ((off > 0) ? sprintf(str, "Reader %d:%d", n + 1, off) : sprintf(str, "Reader %d", n + 1)) :
    (k === ITS_KFx) ? ((off > 0) ? sprintf(str, "Effect %d:%d", n + 1, off) : sprintf(str, "Effect %d", n + 1)) :
    strcpy(str, "???");
);

// the key "w" of a writer or a reader (type "ty") : its index (its value in its_Tb_v1, its_Tb_v2), -1 if unknown
function its_Tb_Key(ty, w) local(keys, nk, ki, i, nm)
(
    (ty === its_TK_Writer) ? ( keys = its_TbWKey; nk = its_TbWNk; ) : ( keys = its_TbRKey; nk = its_TbRNk; );
    ki = -1; i = 0; while ((ki < 0) && (i < nk)) ( (keys[i] === w) ? (ki = i); i += 1; );
    its_Tb_v2 = 0;
    (ki >= 0) ? (
        nm = (ty === its_TK_Writer) ? its_TbWNam[ki] : its_TbRNam[ki];
        (ty === its_TK_Writer) ? (
            (ki === 0) ? ( its_Tb_v1 = its_Tb_Id(its_TK_Line, its_Tb_Next(), 0); ) :
            (ki === 1) ? ( its_Tb_Src(nm, 0); ) :
            (ki === 2) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbWSt, 5); ) :
            (ki === 3) ? ( its_Tb_v1 = its_Tb_Num(nm, -120, 40); ) :
            (ki === 4) ? ( its_Tb_v1 = its_Tb_Num(nm, -150, 150); ) :
            (ki === 5) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbWMd, 2); ) :
            (ki === 6) ? ( its_Tb_v1 = its_Tb_Int(nm, 0, 127); ) :
            ( its_Tb_v1 = its_Tb_Int(nm, 0, 128); );
        ) : (
            (ki === 0) ? ( its_Tb_v1 = its_Tb_Id(its_TK_Line, its_Tb_Next(), 0); ) :
            (ki === 1) ? ( its_Tb_v1 = its_Tb_Id(its_TK_Writer, its_Tb_Next(), 0); ) :
            (ki === 2) ? ( its_Tb_v1 = its_Tb_Num(nm, 0, 67108864 / srate); ) :
            (ki === 3) ? ( its_Tb_v1 = its_Tb_Num(nm, -SPDMAX, SPDMAX); ) :
            (ki === 4) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbRSt, 5); ) :
            (ki === 5) ? ( its_Tb_Src(nm, 1); ) :
            (ki === 6) ? ( its_Tb_v1 = its_Tb_Num(nm, -120, 40); ) :
            (ki === 7) ? ( its_Tb_v1 = its_Tb_Int(nm, 0, 127); ) :
            (ki === 8) ? ( its_Tb_v1 = its_Tb_Int(nm, 1, 128); ) :
            ( its_Tb_v1 = its_Tb_Enum(nm, its_TbRLp, 6); );
        );
    );
    ki;
);

//—— Effects

// the key "w" of an effect : its index (its value in its_Tb_v1 ... its_Tb_v4), -1 if unknown ; the word of "mode" is
// kept in its_Tb_v1 (its meaning depends on the type : its_Tb_FxPrep)
function its_Tb_FxKey(w) local(ki, i, nm, n)
(
    ki = -1; i = 0; while ((ki < 0) && (i < its_TbFMod)) ( (its_TbFKey[i] === w) ? (ki = i); i += 1; );
    (w === its_TK_source) ? (ki = 6) : (w === its_TK_gain) ? (ki = 14) : (w === its_TK_mod) ? (ki = its_TbFMod);
    its_Tb_v2 = 0;
    (ki >= 0) ? (
        nm = its_TbFNam[ki];
        (ki === 0) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbFTy, its_Efx_TyCnt); ) :
        (ki === 1) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbFSt, 4); ) :
        (ki === 2) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbFPh, 3); ) :
        (ki === 3) ? ( its_Tb_v1 = its_Tb_Int(nm, 1, 128); ) :
        (ki === 4) ? ( its_Tb_Src(nm, 1); ) :
        (ki === 5) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbFSt, 2); ) :
        (ki < 14) ? ( its_Tb_Src(nm, 0); ) :
        (ki < 22) ? ( its_Tb_v1 = its_Tb_Num(nm, -120, 40); ) :
        (ki === 22) ? ( its_Tb_v1 = its_Tb_Num(nm, 0.001, 0.5 * srate); ) :
        (ki === 23) ? ( its_Tb_v1 = its_Tb_Num(nm, 0.05, 2000); ) :
        (ki === 24) ? ( its_Tb_v1 = its_Tb_Next(); ) :
        (ki === 25) ? (
            n = its_Tb_v1 = its_Tb_Int(nm, 1, 8);
            ((its_Tb_error === 0) && (n !== 1) && (n !== 2) && (n !== 4) && (n !== 8)) ? (
                sprintf(#its_TbW, "stages : %d is not 1, 2, 4 or 8", n);
                its_Tb_Err(2754, #its_TbW);
            );
        ) :
        (ki === 26) ? ( its_Tb_v1 = its_Tb_Num(nm, 0, 10); ) :
        (ki === 27) ? ( its_Tb_v1 = its_Tb_Num(nm, -10, 10); ) :
        (ki === 28) ? ( its_Tb_v1 = its_Tb_Num(nm, 0, 1); ) :
        (ki === 29) ? ( its_Tb_v1 = its_Tb_Num(nm, -48, 144); ) :
        (ki === 30) ? ( its_Tb_v1 = its_Tb_Num(nm, -8, 8); ) :
        (ki === 31) ? ( its_Tb_v1 = its_Tb_Num(nm, 0, 100); ) :
        (ki === 32) ? (
            n = its_Tb_v1 = its_Tb_Int(nm, 1, 8);
            ((its_Tb_error === 0) && (n !== 1) && (n !== 2) && (n !== 4) && (n !== 8)) ? (
                sprintf(#its_TbW, "os : %d is not 1, 2, 4 or 8", n);
                its_Tb_Err(2754, #its_TbW);
            );
        ) :
        (ki === 33) ? ( its_Tb_v1 = its_Tb_Num(nm, -120, 40); ) :
        ((ki === 34) || (ki === 35)) ? ( its_Tb_v1 = its_Tb_Num(nm, -64, 64); ) :
        (ki === 36) ? ( its_Tb_v1 = its_Tb_Num(nm, -8, 8); ) :
        (ki === 37) ? (
            // harm : 1 to 16 weights in [-1, 1] (the numbers up to the next word ; the weights not given are 0)
            n = 0;
            while ((its_Tb_error === 0) && (n < its_SatHarm)
                && (((w = its_Tb_Peek()) === mSL_cstMinus) || (abs(w) < mSL_CharConst))) (
                its_TbHarm[n] = its_Tb_Num(nm, -1, 1);
                n += 1;
            );
            ((its_Tb_error === 0) && ((n === 0) || ((w = its_Tb_Peek()) === mSL_cstMinus) || (abs(w) < mSL_CharConst))) ? (
                sprintf(#its_TbW, "harm : 1 to %d weights expected", its_SatHarm);
                its_Tb_Err(2754, #its_TbW);
            );
            its_Tb_v1 = n;
        ) :
        (
            // mod : the input, its source, then "depth" and "att" (optional)
            w = its_Tb_Next();
            ki = -1; i = 0; while ((ki < 0) && (i < its_TbFMINb)) ( (its_TbFMI[i] === w) ? (ki = its_TbFMod + i); i += 1; );
            (ki < 0) ? (
                sprintf(#its_TbW, "mod : %s is not a modulation input", mSL_edit_value(#its_TbV, w));
                its_Tb_Err(2754, #its_TbW);
                ki = its_TbFMod; // (not -1 : not an unknown key)
            ) : (
                its_Tb_Src("mod", 0);
                (its_Tb_Peek() === its_TK_depth) ? ( its_Tb_Next(); its_Tb_v3 = its_Tb_Num("depth", 0, 100); );
                (its_Tb_Peek() === its_TK_att) ? ( its_Tb_Next(); its_Tb_v4 = its_Tb_Num("att", -10, 10); );
            );
        );
    );
    ki;
);

// the key "ki" has a meaning for the effect type "ty"
function its_Tb_FxOk(ty, ki)
(
    (ki <= 4) ? 1 :
    (ki === 5) ? (ty !== its_Efx_TyLFO) :
    (ki >= its_TbFMod) ? (its_TbFMIt[ki - its_TbFMod] === ty) :
    ((ty === its_Efx_TyMixer) || (ty === its_Efx_TyAutoMix)) ? ((ki < 14) || ((ki < 22) && (ty === its_Efx_TyMixer))) :
    (ty === its_Efx_TyFilter) ? ((ki === 6) || (ki === 14) || ((ki >= 22) && (ki <= 25))) :
    (ty === its_Efx_TySat) ? ((ki === 6) || (ki === 14) || (ki === 24) || ((ki >= 29) && (ki <= 37))) :
    (ty === its_Efx_TyLFO) ? ((ki === 22) || (ki === 24) || ((ki >= 26) && (ki <= 28))) : 0;
);

// the keys of the block, until the next header : its_TbKS, its_TbK1 ... its_TbK4
function its_Tb_Keys(ty) local(w, ki)
(
    memset(its_TbKS, 0, its_TbKSz);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        its_Tb_v3 = its_Tb_v4 = Undef;
        its_Tb_chg = 0;
        ((ki = (ty === its_TK_Effect) ? its_Tb_FxKey(w) : its_Tb_Key(ty, w)) >= 0) ? (
            // (Set : only the keys whose value depends on a changed argument)
            (!its_Tb_setm || its_Tb_chg) ? (
                its_TbKS[ki] = 1; its_TbK1[ki] = its_Tb_v1; its_TbK2[ki] = its_Tb_v2;
                its_TbK3[ki] = its_Tb_v3; its_TbK4[ki] = its_Tb_v4;
            );
        ) :
        its_Tb_KeyErr(w, its_Tb_TyName(ty));
    );
);

// the value of the key "ki" of the module "b" (type "ty") : its_Tb_g1, its_Tb_g2 ; b === 0 : no module
function its_Tb_Get(ty, ki, b)
(
    its_Tb_g2 = 0;
    its_Tb_g1 = (b === 0) ? (((ty === its_TK_Writer) ? (ki === 2) : (ki === 4)) ? its_WrtStat_UnDef : -1) :
    (ty === its_TK_Writer) ? (
        (ki === 0) ? b[its_Wrt_LineNb] :
        (ki === 1) ? ( its_Tb_g2 = b[its_Wrt_SrcOff]; b[its_Wrt_Src]; ) :
        (ki === 2) ? b[its_Wrt_Status] :
        (ki === 3) ? b[its_Wrt_InGaindB] :
        (ki === 4) ? b[its_Wrt_Ovrdb] :
        (ki === 5) ? b[its_Wrt_Mode] :
        (ki === 6) ? b[its_Wrt_Bf1stChan] : b[its_Wrt_BfChanUsed];
    ) : (
        (ki === 0) ? ((b[its_Rdr_Mode] === its_RdrMode_Read) ? b[its_Rdr_LineNb] : -1) :
        (ki === 1) ? ((b[its_Rdr_Mode] === its_RdrMode_Delay) ? b[its_Rdr_WrSrc] : -1) :
        (ki === 2) ? b[its_Rdr_WOffset] :
        (ki === 3) ? b[its_Rdr_Speed] :
        (ki === 4) ? ((b[its_Rdr_Status] > its_RdrStat_Reading) ? its_RdrStat_Reading : b[its_Rdr_Status]) : // (stopping, starting)
        (ki === 5) ? ( its_Tb_g2 = b[its_Rdr_OutOff]; b[its_Rdr_OutK]; ) :
        (ki === 6) ? b[its_Rdr_OutVoldB] :
        (ki === 7) ? b[its_Rdr_Bf1stChan] :
        (ki === 8) ? b[its_Rdr_BfChanUsed] : b[its_Rdr_LoopType];
    );
);

// the text of the value "v1", "v2" of the key "ki" (type "ty")
function its_Tb_ValText(str, ty, ki, v1, v2)
(
    (ty === its_TK_Writer) ? (
        (ki === 0) ? ((v1 < 0) ? strcpy(str, "none") : sprintf(str, "%d", v1 + 1)) :
        (ki === 1) ? its_Tb_SrcText(str, v1, v2) :
        (ki === 2) ? strcpy(str, menu_Wrt_Status_N[max(0, min(4, v1))]) :
        (ki === 5) ? strcpy(str, (v1 === its_WrtMode_Sum) ? "Sum" : "XFade") :
        ((ki === 6) || (ki === 7)) ? sprintf(str, "%d", v1) :
        sprintf(str, "%.10g", v1);
    ) : (
        ((ki === 0) || (ki === 1)) ? ((v1 < 0) ? strcpy(str, "none") : sprintf(str, "%d", v1 + 1)) :
        (ki === 4) ? strcpy(str, menu_Rdr_Status_N[(v1 > 4) ? 4 : max(0, v1)]) : // (stopping, starting : Reading)
        (ki === 5) ? ((v1 === 0) ? strcpy(str, "Own") : its_Tb_SrcText(str, v1, v2)) :
        ((ki === 7) || (ki === 8)) ? sprintf(str, "%d", v1) :
        (ki === 9) ? strcpy(str, menu_Rdr_Loop_N[max(0, min(5, v1))]) :
        sprintf(str, "%.10g", v1);
    );
    str;
);

// add " key value" to #its_TbW
function its_Tb_Cat(ty, ki, b)
(
    its_Tb_Get(ty, ki, b);
    strcat(#its_TbW, " ");
    strcat(#its_TbW, (ty === its_TK_Writer) ? its_TbWNam[ki] : its_TbRNam[ki]);
    strcat(#its_TbW, " ");
    strcat(#its_TbW, its_Tb_ValText(#its_TbV1, ty, ki, its_Tb_g1, its_Tb_g2));
);

// the block of the writer, the reader or the effect "k" (0 : none)
function its_Tb_Blk(ty, k) local(b)
(
    (ty === its_TK_Writer) ? (
        b = Writers_set[k];
        ((b > BASE_MEMORY) && (b[-2] === KW_writ)) ? b : 0;
    ) :
    (ty === its_TK_Reader) ? (
        b = Readers_set[k];
        ((b > BASE_MEMORY) && (b[-2] === KW_read)) ? b : 0;
    ) : (
        b = Effects_set[k];
        ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? b : 0;
    );
);

function its_Tb_DumpMod(ty, k) local(b, i)
(
    sprintf(#its_TbW, "%s %d", its_Tb_TyName(ty), k + 1);
    ((b = its_Tb_Blk(ty, k)) === 0) ? (
        strcat(#its_TbW, " status Undefined");
    ) :
    (ty === its_TK_Writer) ? (
        its_Tb_Cat(ty, 2, b);
        (b[its_Wrt_LineNb] >= 0) ? its_Tb_Cat(ty, 0, b);
        (b[its_Wrt_Src] !== 0) ? its_Tb_Cat(ty, 1, b);
        i = 3; loop(5, its_Tb_Cat(ty, i, b); i += 1;);
    ) : (
        its_Tb_Cat(ty, 4, b);
        (b[its_Rdr_Mode] === its_RdrMode_Read) ? (
            (b[its_Rdr_LineNb] >= 0) ? its_Tb_Cat(ty, 0, b);
        ) : (
            (b[its_Rdr_WrSrc] >= 0) ? its_Tb_Cat(ty, 1, b);
            its_Tb_Cat(ty, 2, b);
        );
        its_Tb_Cat(ty, 3, b);
        i = 5; loop(5, its_Tb_Cat(ty, i, b); i += 1;);
    );
    mSL_log(SysLogBox, #its_TbW);
);

// pass 2 : the line (-1 : unknown) of the keys of the block, checked
function its_Tb_SimMod(ty, k) local(l, w, sp, ch)
(
    l = -1;
    (ty === its_TK_Writer) ? (
        its_TbSimWE[k] = 1;
        (its_Tb_own > 0) ? (its_TbSimWO[k] = its_Tb_own);
        its_TbKS[0] ? (
            l = its_TbK1[0];
            (its_TbSimSp[l] === 0) ? (
                sprintf(#its_TbW, "Writer %d : Line %d is not defined", k + 1, l + 1);
                its_Tb_Err(2763, #its_TbW);
            );
            its_TbSimWL[k] = l;
        );
        l = its_TbSimWL[k];
        ((l >= 0) && its_TbKS[6] && (its_TbK1[6] >= its_TbSimCh[l])) ? (
            sprintf(#its_TbW, "Writer %d : first %d, Line %d has %d channels", k + 1, its_TbK1[6], l + 1, its_TbSimCh[l]);
            its_Tb_Err(2764, #its_TbW);
        );
    ) : (
        its_TbSimRE[k] = 1;
        (its_Tb_own > 0) ? (its_TbSimRO[k] = its_Tb_own);
        its_TbKS[0] ? (
            l = its_TbK1[0];
            (its_TbSimSp[l] === 0) ? (
                sprintf(#its_TbW, "Reader %d : Line %d is not defined", k + 1, l + 1);
                its_Tb_Err(2763, #its_TbW);
            );
        ) :
        its_TbKS[1] ? (
            w = its_TbK1[1];
            ((its_TbSimWE[w] == 0) || ((l = its_TbSimWL[w]) < 0)) ? (
                sprintf(#its_TbW, "Reader %d : Writer %d is not defined, or has no line", k + 1, w + 1);
                its_Tb_Err(2763, #its_TbW);
            );
        );
        ((its_Tb_error === 0) && (l >= 0)) ? (
            sp = its_TbSimSp[l]; ch = its_TbSimCh[l];
            ((its_TbKS[7] ? its_TbK1[7] : 0) + (its_TbKS[8] ? its_TbK1[8] : 1) > ch) ? (
                sprintf(#its_TbW, "Reader %d : first %d used %d, Line %d has %d channels", k + 1,
                    its_TbKS[7] ? its_TbK1[7] : 0, its_TbKS[8] ? its_TbK1[8] : 1, l + 1, ch);
                its_Tb_Err(2764, #its_TbW);
            ) :
            (its_TbKS[2] && (its_TbK1[2] * srate > sp)) ? (
                sprintf(#its_TbW, "Reader %d : delay %g s, Line %d lasts %.3f s", k + 1, its_TbK1[2], l + 1, sp / srate);
                its_Tb_Err(2765, #its_TbW);
            );
        );
    );
);

// pass 3 : the writer or the reader "k" is created if needed, then set (the status last)
function its_Tb_SetMod(ty, k) local(b, v)
(
    b = (ty === its_TK_Writer) ? Wr_Make(k) : (Readers_set[k] === 0) ? Rd_Make(k) : Readers_set[k];
    (b <= BASE_MEMORY) ? (
        sprintf(#its_TbW, "%s %d : not enough memory", its_Tb_TyName(ty), k + 1);
        its_Tb_Err(2766, #its_TbW);
    ) :
    (ty === its_TK_Writer) ? (
        (its_TbKS[0] && (b[its_Wrt_LineNb] !== its_TbK1[0])) ? Wr_Set_Line(k, its_TbK1[0]);
        its_TbKS[1] ? ( b[its_Wrt_Src] = its_TbK1[1]; b[its_Wrt_SrcOff] = its_TbK2[1]; b[its_Wrt_Check] = 0; );
        its_TbKS[3] ? ( b[its_Wrt_InGaindB] = v = its_TbK1[3]; b[its_Wrt_InGain] = (v <= -120) ? 0 : 10^(v/20); );
        its_TbKS[4] ? ( b[its_Wrt_Ovrdb] = its_TbK1[4]; );
        its_TbKS[5] ? ( b[its_Wrt_Mode] = its_TbK1[5]; );
        its_TbKS[6] ? ( b[its_Wrt_Bf1stChan] = its_TbK1[6]; b[its_Wrt_Check] = 0; );
        its_TbKS[7] ? ( b[its_Wrt_BfChanUsed] = its_TbK1[7]; b[its_Wrt_Check] = 0; );
        (its_Tb_own > 0) ? (b[its_Wrt_Owner] = its_Tb_own);
        Wr_Set_Status(k, its_TbKS[2] ? its_TbK1[2] : b[its_Wrt_Status]); // no line or no source : "Created"
        (k === slWriter) ? (Currwriter = b);
        wrupdt = 1;
    ) : (
        // reader mode on a line, or delay mode following a writer : kept if it is the same
        (its_TbKS[0] && ((b[its_Rdr_Mode] !== its_RdrMode_Read) || (b[its_Rdr_LineNb] !== its_TbK1[0]))) ? (
            b[its_Rdr_Mode] = its_RdrMode_Read;
            b[its_Rdr_WrBPtr] = 0;
            Rd_Set_Line(k, its_TbK1[0] + 1);
        );
        (its_TbKS[1] && ((b[its_Rdr_Mode] !== its_RdrMode_Delay) || (b[its_Rdr_WrSrc] !== its_TbK1[1]))) ? (
            b[its_Rdr_Mode] = its_RdrMode_Delay;
            Rd_Set_Writer(k, its_TbK1[1] + 1);
        );
        its_TbKS[5] ? ( b[its_Rdr_OutK] = its_TbK1[5]; b[its_Rdr_OutOff] = its_TbK2[5]; b[its_Rdr_Check] = 0; );
        its_TbKS[6] ? ( b[its_Rdr_OutVoldB] = v = its_TbK1[6]; b[its_Rdr_OutVol] = (v <= -120) ? 0 : 10^(v/20); );
        its_TbKS[7] ? ( b[its_Rdr_Bf1stChan] = its_TbK1[7]; b[its_Rdr_Check] = 0; );
        its_TbKS[8] ? ( b[its_Rdr_BfChanUsed] = its_TbK1[8]; b[its_Rdr_Check] = 0; );
        its_TbKS[9] ? ( b[its_Rdr_LoopType] = its_TbK1[9]; );
        its_TbKS[3] ? Rd_Set_Speed(k, its_TbK1[3], 1);
        its_TbKS[2] ? Rd_Set_Offset(b, its_TbK1[2] * srate);
        its_TbKS[4] ? Rd_Set_Status(k, its_TbK1[4]);
        (its_Tb_own > 0) ? (b[its_Rdr_Owner] = its_Tb_own);
        b[its_Rdr_StFlgs] |= its_RdrFlg_Mod; // (Rd_Update in @block)
        (k === slReader) ? (Currreader = b);
        rdupdt = 1;
    );
);

//—— Effects (2)

// the word of the key "mode" : its index for the type "ty" (Filter, Saturation, LFO) ; -1 and an error if it is not a mode of the type
function its_Tb_FxMode(ty, w) local(syms, n, k, i)
(
    (ty === its_Efx_TyFilter) ? ( syms = its_TbFMd; n = 6; ) :
    (ty === its_Efx_TySat) ? ( syms = its_TbSMd; n = its_SatModeCnt; ) : ( syms = its_TbLSh; n = 5; );
    k = -1; i = 0; while ((k < 0) && (i < n)) ( (syms[i] === w) ? (k = i); i += 1; );
    (k < 0) ? (
        sprintf(#its_TbW, "mode : %s is not a mode of a %s", mSL_edit_value(#its_TbV, w), its_TbFTyN[ty]);
        its_Tb_Err(2754, #its_TbW);
    );
    k;
);

// passes 2 and 3 : the type of the effect "k" after the block (its key "type", or its type in the simulation or now) ;
// each key given must have a meaning for this type ; the word of "mode" becomes its index
function its_Tb_FxPrep(k) local(ty, ki, fx)
(
    ty = its_TbKS[0] ? its_TbK1[0] : (its_Tb_mode === 2) ? its_TbSimFT[k] : ((fx = its_Tb_Blk(its_TK_Effect, k)) !== 0) ? fx[its_Efx_Type] : 0;
    ki = 1; while ((its_Tb_error === 0) && (ki < its_TbFNk)) (
        (its_TbKS[ki] && !its_Tb_FxOk(ty, ki)) ? (
            sprintf(#its_TbW, "Effect %d : the key %s has no meaning for the type %s", k + 1, its_TbFNam[ki], its_TbFTyN[ty]);
            its_Tb_Err(2767, #its_TbW);
        );
        ki += 1;
    );
    ((its_Tb_error === 0) && its_TbKS[24]) ? (its_TbK1[24] = its_Tb_FxMode(ty, its_TbK1[24]));
    ty;
);

// Saturation : the count of weights of "harm" up to the last one not null (at least 1)
function its_Tb_HarmN(fx) local(n)
(
    n = its_SatHarm; while ((n > 1) && (fx[its_Efx_Harm1 + n - 1] === 0)) ( n -= 1; );
    n;
);

// Saturation : the key "ki" is used by the mode of the effect "fx" (order : x - A sin, Chebyshev ; amount : x - A sin ;
// stretch, harm : Cheb. sum)
function its_Tb_SatUsed(fx, ki) local(md)
(
    md = fx[its_Efx_Par1 + 1];
    (ki === 34) ? ((md === its_SatXSin) || (md === its_SatCheb)) :
    (ki === 36) ? (md === its_SatXSin) :
    ((ki === 35) || (ki === 37)) ? (md === its_SatChebSum) : 1;
);

// the value of the key "ki" of the effect "fx" : its_Tb_g1 ... its_Tb_g4 ; fx === 0 : no effect
function its_Tb_FxGet(ki, fx) local(p)
(
    its_Tb_g2 = its_Tb_g3 = its_Tb_g4 = 0;
    its_Tb_g1 = (fx === 0) ? ((ki === 1) ? 3 : -1) : // (status Undefined)
    (ki === 0) ? fx[its_Efx_Type] :
    (ki === 1) ? fx[its_Efx_Status] :
    (ki === 2) ? fx[its_Efx_Phase] :
    (ki === 3) ? fx[its_Efx_CCnt] :
    (ki === 4) ? ( its_Tb_g2 = fx[its_Efx_OutOff]; fx[its_Efx_OutK]; ) :
    (ki === 5) ? (fx[its_Efx_Lim] !== 0) :
    (ki < 14) ? ( p = fx + its_Efx_Src1 + (ki - 6) * its_EfxDist; its_Tb_g2 = p[its_Efx_Off1 - its_Efx_Src1]; p[0]; ) :
    (ki < 22) ? fx[its_Efx_VoldB1 + (ki - 14) * its_EfxDist] :
    (ki === 24) ? fx[its_Efx_Par1 + ((fx[its_Efx_Type] === its_Efx_TyFilter) ? 2 : 1)] :
    (ki === 25) ? its_Flt_Stages(fx) :
    (ki < 26) ? fx[its_Efx_Par1 + ki - 22] : // freq Par1, q Par2
    (ki < 29) ? fx[its_Efx_Par1 + ki - 24] : // amp Par3, offset Par4, spread Par5
    (ki === 29) ? fx[its_Efx_Par1] : // drive
    (ki === 31) ? fx[its_Efx_Par1 + 3] * 100 : // mix (%)
    (ki === 32) ? 2^max(0, min(its_SatOSCnt - 1, floor(fx[its_Efx_Par1 + 4]))) : // oversampling
    (ki === 37) ? its_Tb_HarmN(fx) : // harm : the count of weights up to the last one not null
    (ki < its_TbFMod) ? fx[its_Efx_Par1 + ki - 28] : // bias Par3, output Par6, order Par7, stretch Par8, amount Par9
    (
        p = fx + its_Efx_Mod1 + its_TbFMIj[ki - its_TbFMod] * its_ModDist;
        its_Tb_g2 = p[its_Mod_Off]; its_Tb_g3 = p[its_Mod_Depth]; its_Tb_g4 = p[its_Mod_Att];
        p[its_Mod_Src];
    );
);

// the text of the value "v1" ... "v4" of the key "ki" (effect of type "ty") ; v3, v4 : Undef if not given
function its_Tb_FxText(str, ki, ty, v1, v2, v3, v4)
(
    (ki === 0) ? strcpy(str, its_TbFTyN[max(0, min(its_Efx_TyCnt - 1, v1))]) :
    ((ki === 1) || (ki === 5)) ? strcpy(str, its_TbFStN[max(0, min(3, v1))]) :
    (ki === 2) ? strcpy(str, its_TbFPhN[max(0, min(2, v1))]) :
    ((ki === 3) || (ki === 25) || (ki === 32)) ? sprintf(str, "%d", v1) :
    (ki === 4) ? ((v1 === 0) ? strcpy(str, "Own") : its_Tb_SrcText(str, v1, v2)) :
    (ki < 14) ? its_Tb_SrcText(str, v1, v2) :
    (ki === 24) ? strcpy(str, (ty === its_Efx_TyFilter) ? its_TbFMdN[max(0, min(5, v1))] :
        (ty === its_Efx_TySat) ? its_TbSMdN[max(0, min(its_SatModeCnt - 1, v1))] : its_TbLShN[max(0, min(4, v1))]) :
    (ki < its_TbFMod) ? sprintf(str, "%.10g", v1) :
    (
        // mod : the input, the source, depth, att
        sprintf(str, "%s ", its_TbFMIN[ki - its_TbFMod]);
        strcat(str, its_Tb_SrcText(#its_TbV3, v1, v2));
        (v1 !== 0) ? (
            (v3 !== Undef) ? strcat(str, sprintf(#its_TbV3, " depth %.10g", v3));
            (v4 !== Undef) ? strcat(str, sprintf(#its_TbV3, " att %.10g", v4));
        );
        str;
    );
    str;
);

// the name of the key "ki" in a Dump (an effect with one source : "source", "gain")
function its_Tb_FxKName(ty, ki)
(
    (((ty === its_Efx_TyFilter) || (ty === its_Efx_TySat)) && ((ki === 6) || (ki === 14))) ? ((ki === 6) ? "source" : "gain") :
        its_TbFNam[ki];
);

function its_Tb_DumpFx(k) local(fx, ty, ki, p, j)
(
    sprintf(#its_TbW, "Effect %d", k + 1);
    ((fx = its_Tb_Blk(its_TK_Effect, k)) === 0) ? (
        strcat(#its_TbW, " status Undefined");
    ) : (
        ty = fx[its_Efx_Type];
        ki = 0; loop(its_TbFNk,
            // the status first ; the sources connected only, each one followed by its gain ; the modulations connected only
            p = (ki === 0) ? 1 : (ki === 1) ? 0 : ((ki >= 6) && (ki < 22)) ? 6 + ((ki - 6) >> 1) + ((ki - 6) & 1) * 8 : ki;
            (its_Tb_FxOk(ty, p) && ((p < 6) || (p >= 22) || (fx[its_Efx_Src1 + ((p - 6) % 8) * its_EfxDist] !== 0))
                && ((ty !== its_Efx_TySat) || its_Tb_SatUsed(fx, p))) ? (
                its_Tb_FxGet(p, fx);
                ((p < its_TbFMod) || (its_Tb_g1 !== 0)) ? (
                    strcat(#its_TbW, " ");
                    strcat(#its_TbW, its_Tb_FxKName(ty, p));
                    (p === 37) ? (
                        j = 0; loop(its_Tb_g1, strcat(#its_TbW, sprintf(#its_TbV1, " %.10g", fx[its_Efx_Harm1 + j])); j += 1;);
                    ) : (
                        strcat(#its_TbW, " ");
                        strcat(#its_TbW, its_Tb_FxText(#its_TbV1, p, ty, its_Tb_g1, its_Tb_g2, its_Tb_g3, its_Tb_g4));
                    );
                );
            );
            ki += 1;
        );
    );
    mSL_log(SysLogBox, #its_TbW);
);

// pass 2 : the keys of the effect "k" checked on the simulation
function its_Tb_SimFx(k) local(ty, j)
(
    ty = its_Tb_FxPrep(k);
    (its_Tb_error === 0) ? (
        (its_TbKS[1] && (its_TbK1[1] === 3)) ? (
            sprintf(#its_TbW, "Effect %d : status Undefined (Free Effect deletes an effect)", k + 1);
            its_Tb_Err(2754, #its_TbW);
        );
        j = 0; loop(8,
            (its_TbKS[6 + j] && (its_TbK1[6 + j] === ITS_KFx * ITS_KMul + k)) ? (
                sprintf(#its_TbW, "Effect %d : its own output is its source %d", k + 1, j + 1);
                its_Tb_Err(2768, #its_TbW);
            );
            j += 1;
        );
    );
    its_TbSimFE[k] = 1; its_TbSimFT[k] = ty;
    (its_Tb_own > 0) ? (its_TbSimFO[k] = its_Tb_own);
);

// pass 3 : the effect "k" is created if needed, then set (the type first : it gives default values ; the status last)
function its_Tb_SetFx(k) local(fx, ty, j, p, ki)
(
    ((fx = its_Tb_Blk(its_TK_Effect, k)) === 0) ? (fx = FX_make(k));
    (fx <= BASE_MEMORY) ? (
        Effects_set[k] = 0;
        sprintf(#its_TbW, "Effect %d : not enough memory", k + 1);
        its_Tb_Err(2766, #its_TbW);
    ) : (
        ty = its_Tb_FxPrep(k); // (checked by pass 2)
        (its_TbKS[0] && (fx[its_Efx_Type] !== ty)) ? FX_Set_Type(fx, ty);
        its_TbKS[2] ? ( fx[its_Efx_Phase] = its_TbK1[2]; );
        its_TbKS[3] ? ( fx[its_Efx_CCnt] = its_TbK1[3]; );
        its_TbKS[4] ? ( fx[its_Efx_OutK] = its_TbK1[4]; fx[its_Efx_OutOff] = its_TbK2[4]; );
        its_TbKS[5] ? ( fx[its_Efx_Lim] = its_TbK1[5]; fx[its_Efx_LimEnv] = 0; );
        j = 0; p = fx + its_Efx_Src1; loop(8,
            its_TbKS[6 + j] ? ( p[0] = its_TbK1[6 + j]; p[its_Efx_Off1 - its_Efx_Src1] = its_TbK2[6 + j]; );
            its_TbKS[14 + j] ? ( p[its_Efx_VoldB1 - its_Efx_Src1] = its_TbK1[14 + j]; );
            j += 1; p += its_EfxDist;
        );
        (ty === its_Efx_TyAutoMix) ? FX_Auto_Gains(fx);
        its_TbKS[22] ? ( fx[its_Efx_Par1] = its_TbK1[22]; );
        its_TbKS[23] ? ( fx[its_Efx_Par1 + 1] = its_TbK1[23]; );
        its_TbKS[24] ? ( fx[its_Efx_Par1 + ((ty === its_Efx_TyFilter) ? 2 : 1)] = its_TbK1[24]; );
        its_TbKS[25] ? ( fx[its_Efx_Par1 + 3] = floor(log(its_TbK1[25]) / log(2) + 0.5); ); // 1, 2, 4, 8 stages : 0 ... 3
        ki = 26; loop(3, its_TbKS[ki] ? ( fx[its_Efx_Par1 + ki - 24] = its_TbK1[ki]; ); ki += 1;);
        its_TbKS[29] ? ( fx[its_Efx_Par1] = its_TbK1[29]; );
        its_TbKS[30] ? ( fx[its_Efx_Par1 + 2] = its_TbK1[30]; );
        its_TbKS[31] ? ( fx[its_Efx_Par1 + 3] = its_TbK1[31] / 100; );
        its_TbKS[32] ? ( fx[its_Efx_Par1 + 4] = floor(log(its_TbK1[32]) / log(2) + 0.5); ); // 1, 2, 4, 8 times : 0 ... 3
        ki = 33; loop(4, its_TbKS[ki] ? ( fx[its_Efx_Par1 + ki - 28] = its_TbK1[ki]; ); ki += 1;);
        its_TbKS[37] ? ( j = 0; loop(its_SatHarm, fx[its_Efx_Harm1 + j] = (j < its_TbK1[37]) ? its_TbHarm[j] : 0; j += 1;); );
        // the modulations : a new connection gets the attenuverter 1 and the default depth (as in the pad)
        ki = its_TbFMod; loop(its_TbFMINb,
            its_TbKS[ki] ? (
                p = fx + its_Efx_Mod1 + its_TbFMIj[ki - its_TbFMod] * its_ModDist;
                (its_TbK1[ki] === 0) ? (
                    p[its_Mod_Src] = p[its_Mod_Off] = 0;
                ) : (
                    (p[its_Mod_Src] === 0) ? (
                        p[its_Mod_Att] = 1;
                        (p[its_Mod_Depth] === 0) ? (p[its_Mod_Depth] = its_TbFMId[ki - its_TbFMod]);
                    );
                    p[its_Mod_Src] = its_TbK1[ki]; p[its_Mod_Off] = its_TbK2[ki];
                );
                (its_TbK3[ki] !== Undef) ? (p[its_Mod_Depth] = its_TbK3[ki]);
                (its_TbK4[ki] !== Undef) ? (p[its_Mod_Att] = its_TbK4[ki]);
            );
            ki += 1;
        );
        its_TbKS[1] ? ( fx[its_Efx_Status] = its_TbK1[1]; );
        (its_Tb_own > 0) ? (fx[its_Efx_Owner] = its_Tb_own);
        fx[its_Efx_Check] = 0; // checked again by exec_fx
    );
);

function its_Tb_CheckFx(k) local(fx, ty, fty, ki, bad, same, j, v)
(
    its_Tb_Keys(its_TK_Effect);
    ((its_Tb_error === 0) && (its_Tb_mode === 3) && (k >= 0)) ? (
        fx = its_Tb_Blk(its_TK_Effect, k);
        ty = its_Tb_FxPrep(k);
        fty = (fx !== 0) ? fx[its_Efx_Type] : 0;
        bad = 0;
        ki = 0; loop(its_TbFNk,
            ((its_Tb_error === 0) && its_TbKS[ki] && (ki === 37)) ? (
                // harm : the weights given, the others null
                j = 0; loop(its_SatHarm,
                    v = (j < its_TbK1[37]) ? its_TbHarm[j] : 0;
                    ((fx === 0) || (abs(fx[its_Efx_Harm1 + j] - v) >= 0.0000001)) ? (
                        sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Effect %d : harm H%d %.10g (expected %.10g)", k + 1, j + 1,
                            (fx !== 0) ? fx[its_Efx_Harm1 + j] : 0, v);
                        mSL_log(SysLogBox, #its_TbMsg);
                        (its_Tb_res === 0) ? (its_Tb_res = 2759);
                        bad = 1;
                    );
                    j += 1;
                );
            ) :
            ((its_Tb_error === 0) && its_TbKS[ki]) ? (
                its_Tb_FxGet(ki, fx);
                same = (abs(its_Tb_g1 - its_TbK1[ki]) < 0.0000001) && (its_Tb_g2 === its_TbK2[ki])
                    && ((its_TbK3[ki] === Undef) || (abs(its_Tb_g3 - its_TbK3[ki]) < 0.0000001))
                    && ((its_TbK4[ki] === Undef) || (abs(its_Tb_g4 - its_TbK4[ki]) < 0.0000001));
                (!same) ? (
                    sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Effect %d : %s %s (expected %s)", k + 1, its_TbFNam[ki],
                        its_Tb_FxText(#its_TbV1, ki, fty, its_Tb_g1, its_Tb_g2, its_Tb_g3, its_Tb_g4),
                        its_Tb_FxText(#its_TbV2, ki, ty, its_TbK1[ki], its_TbK2[ki], its_TbK3[ki], its_TbK4[ki]));
                    mSL_log(SysLogBox, #its_TbMsg);
                    (its_Tb_res === 0) ? (its_Tb_res = 2759);
                    bad = 1;
                );
            );
            ki += 1;
        );
        ((bad === 0) && (its_Tb_error === 0)) ? (
            sprintf(#its_TbW, "Check Effect %d OK", k + 1);
            mSL_log(SysLogBox, #its_TbW);
        );
    );
);

function its_Tb_Module(ty) local(k)
(
    k = its_Tb_Id(ty, its_Tb_Next(), 1);
    its_Tb_own = its_Tb_idLocal ? its_Tb_scope : 0; // a module of an instance (its_Tb_SimMod ... its_Tb_SetFx)
    its_Tb_Keys(ty);
    ((its_Tb_error === 0) && (k >= 0)) ? (
        (its_Tb_mode === 0) ? ( its_TbResv[its_Tb_RBase(ty) + k] = 1; ) :
        (its_Tb_mode === 2) ? ( (ty === its_TK_Effect) ? its_Tb_SimFx(k) : its_Tb_SimMod(ty, k); ) :
        (its_Tb_mode === 3) ? ( (ty === its_TK_Effect) ? its_Tb_SetFx(k) : its_Tb_SetMod(ty, k); );
    );
);

function its_Tb_CheckMod(ty, k) local(b, ki, ok, nk, same)
(
    its_Tb_Keys(ty);
    ((its_Tb_error === 0) && (its_Tb_mode === 3) && (k >= 0)) ? (
        b = its_Tb_Blk(ty, k);
        ok = 1;
        nk = (ty === its_TK_Writer) ? its_TbWNk : its_TbRNk;
        ki = 0; loop(nk,
            its_TbKS[ki] ? (
                its_Tb_Get(ty, ki, b);
                same = ((ty === its_TK_Reader) && (ki === 2)) ? (abs(its_Tb_g1 - its_TbK1[ki]) < 0.6 / srate) :
                    (abs(its_Tb_g1 - its_TbK1[ki]) < 0.0000001) && (its_Tb_g2 === its_TbK2[ki]);
                (!same) ? (
                    sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check %s %d : %s %s (expected %s)",
                        its_Tb_TyName(ty), k + 1, (ty === its_TK_Writer) ? its_TbWNam[ki] : its_TbRNam[ki],
                        its_Tb_ValText(#its_TbV1, ty, ki, its_Tb_g1, its_Tb_g2),
                        its_Tb_ValText(#its_TbV2, ty, ki, its_TbK1[ki], its_TbK2[ki]));
                    mSL_log(SysLogBox, #its_TbMsg);
                    (its_Tb_res === 0) ? (its_Tb_res = 2759);
                    ok = 0;
                );
            );
            ki += 1;
        );
        ok ? (
            sprintf(#its_TbW, "Check %s %d OK", its_Tb_TyName(ty), k + 1);
            mSL_log(SysLogBox, #its_TbW);
        );
    );
);

//—— Global

// the keys of the block Global, until the next header : its_TbKS, its_TbK1
function its_Tb_GKeys() local(w, ki, i)
(
    memset(its_TbKS, 0, its_TbKSz);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        ki = -1; i = 0; while ((ki < 0) && (i < its_TbGNk)) ( (its_TbGKey[i] === w) ? (ki = i); i += 1; );
        (ki < 0) ? its_Tb_KeyErr(w, "Global") : (
            its_Tb_chg = 0;
            its_TbK1[ki] = (ki === 0) ? its_Tb_Enum("samples", its_TbGSm, 3) :
                ((ki === 1) || (ki === 2)) ? its_Tb_Num(its_TbGNam[ki], -120, 40) :
                (ki === 3) ? its_Tb_Num("latency", 1, 10000) :
                (ki === 4) ? its_Tb_Enum("action", its_TbGAc, 6) :
                its_Tb_Int("chan", 0, 128);
            its_TbKS[ki] = !its_Tb_setm || its_Tb_chg; // (Set : only the keys of a changed argument)
        );
    );
);

// the value of the key "ki" of the block Global
function its_Tb_GGet(ki)
(
    (ki === 0) ? slSmpl : (ki === 1) ? slInGain : (ki === 2) ? slOutVol : (ki === 3) ? slStlatency : (ki === 4) ? 0 : chcnt;
);

function its_Tb_GText(str, ki, v)
(
    (ki === 0) ? strcpy(str, its_TbGSmN[max(0, min(2, v))]) : (ki === 5) ? sprintf(str, "%d", v) : sprintf(str, "%.10g", v);
);

/*
    Global : the track samples, the input gain, the output volume and the latency are set in the native sliders (as the
    module "Globals" does : update_sliders computes the gains) ; the action is performed last, at once (its_actions) ;
    "chan" (the channels of the track) can't be set : it is accepted, so that a Dump can be read again, and checked
*/
function its_Tb_Global()
(
    its_Tb_GKeys();
    ((its_Tb_error === 0) && (its_Tb_mode === 3)) ? (
        its_TbKS[0] ? ( slSmpl = its_TbK1[0]; sliderchange(slSmpl); );
        its_TbKS[1] ? ( slInGain = its_TbK1[1]; sliderchange(slInGain); );
        its_TbKS[2] ? ( slOutVol = its_TbK1[2]; sliderchange(slOutVol); );
        its_TbKS[3] ? ( slStlatency = its_TbK1[3]; sliderchange(slStlatency); );
        slupdt = 1; // see update_sliders
        (its_TbKS[4] && (its_TbK1[4] !== its_GlAct_None)) ? its_actions(its_TbK1[4]);
    );
);

function its_Tb_DumpGlobal() local(ki)
(
    strcpy(#its_TbW, "Global");
    ki = 0; loop(its_TbGNk,
        (ki !== 4) ? (
            strcat(#its_TbW, " "); strcat(#its_TbW, its_TbGNam[ki]); strcat(#its_TbW, " ");
            strcat(#its_TbW, its_Tb_GText(#its_TbV1, ki, its_Tb_GGet(ki)));
        );
        ki += 1;
    );
    mSL_log(SysLogBox, #its_TbW);
);

function its_Tb_CheckGlobal() local(ki, bad)
(
    its_Tb_GKeys();
    (its_TbKS[4] && (its_Tb_error === 0)) ? its_Tb_Err(2754, "Check Global : an action can't be checked");
    ((its_Tb_error === 0) && (its_Tb_mode === 3)) ? (
        bad = 0;
        ki = 0; loop(its_TbGNk,
            (its_TbKS[ki] && (abs(its_Tb_GGet(ki) - its_TbK1[ki]) >= 0.0000001)) ? (
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Global : %s %s (expected %s)", its_TbGNam[ki],
                    its_Tb_GText(#its_TbV1, ki, its_Tb_GGet(ki)), its_Tb_GText(#its_TbV2, ki, its_TbK1[ki]));
                mSL_log(SysLogBox, #its_TbMsg);
                (its_Tb_res === 0) ? (its_Tb_res = 2759);
                bad = 1;
            );
            ki += 1;
        );
        (bad === 0) ? mSL_log(SysLogBox, "Check Global OK");
    );
);

//—— Algorithms

/*
    Algorithm Name  input a  output b  param p def min max  <blocks>  End
        a template : the words between the name and End (the declarations first) ; nothing is created
    Instance i Name  a S  b D  p v
        the blocks of the template, with the arguments in place of their names (a parameter : its value, its default if it
        is omitted ; an input or an output : its words, read in the scope of the table) ; the names of the template are the
        names of this instance (its scope : its number k, 1 ... its_InsMx) ; each module named in the template belongs to the
        instance (Owner = k)
    Set i p v ... : the arguments given replace those of the instance ; only the keys whose value depends on a changed argument
        are applied again (its_TbM_Chg) : the other settings of its modules (pads...) are kept
    Free Instance i : deletes its modules ; Dump Instance i : the call, then its modules ; Free Algorithm Name
    The instances are expanded before the 4 passes (its_Al_Expand) : markers (its_TbM_...) tell the scopes ; an instance and
    a template are recorded in pass 3 (its_Al_Commit, its_Al_TplCommit). Errors 2780 ... 2790.
*/
its_AlgMx = 32; // the templates
its_AlgSym = make_array(its_AlgMx); its_AlgBlk = make_array(its_AlgMx); its_AlgLen = make_array(its_AlgMx);
its_InsMx = 64; // the instances 1 ... its_InsMx : name, template (name, copy of its words), arguments, names
its_InsSym = make_array(its_InsMx + 1); its_InsAName = make_array(its_InsMx + 1);
its_InsTpl = make_array(its_InsMx + 1); its_InsTLen = make_array(its_InsMx + 1);
its_InsArg = make_array(its_InsMx + 1); its_InsALen = make_array(its_InsMx + 1);
its_InsNam = make_array(its_InsMx + 1); its_InsNCnt = make_array(its_InsMx + 1);
// (their blocks are dynamic : protected from the garbage collector)
mm_usr_prot[mm_usr_prot_ptr] = its_AlgBlk; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = its_InsTpl; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = its_InsArg; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = its_InsNam; mm_usr_prot_ptr += 1;
// the templates and the instances of the current table, recorded in pass 3
its_APMx = 16; its_APCnt = 0;
its_APN = make_array(its_APMx); its_APP = make_array(its_APMx); its_APL = make_array(its_APMx);
its_IPMx = 32; its_IPCnt = 0;
its_IPN = make_array(its_IPMx); its_IPK = make_array(its_IPMx); its_IPAN = make_array(its_IPMx);
its_IPTP = make_array(its_IPMx); its_IPTL = make_array(its_IPMx);
its_IPAO = make_array(its_IPMx); its_IPAL = make_array(its_IPMx);
its_IPArgSz = 4096; its_IPArg = make_array(its_IPArgSz); // their arguments : for each declaration, n then n words
its_SPMx = 32; its_SPCnt = 0; // the Set of the table : the instance, its new arguments (in its_IPArg)
its_SPK = make_array(its_SPMx); its_SPAO = make_array(its_SPMx); its_SPAL = make_array(its_SPMx);
// the declarations of a template (its_Al_Decl) : name, kind (0 input, 1 output, 2 param), default, min, max ; the arguments
// of an instance : position in the table, count of words, value
its_AlDMx = 32;
its_AlDN = make_array(its_AlDMx); its_AlDK = make_array(its_AlDMx);
its_AlDDef = make_array(its_AlDMx); its_AlDMin = make_array(its_AlDMx); its_AlDMax = make_array(its_AlDMx);
its_AlAP = make_array(its_AlDMx); its_AlAL = make_array(its_AlDMx); its_AlAV = make_array(its_AlDMx);
its_Tb_cpend = its_Tb_spend = -1; its_Tb_scope = its_Tb_sscope = its_Tb_setm = its_Tb_chg = 0; its_Al_buf = 0;

// the word "i" of the table (its_TK_End after the last one) ; the next word that is not a comma
function its_Al_W(i) ( (i < its_Tb_itc) ? its_Tb_tbl[i] : its_TK_End; );
function its_Al_Skip(i) ( while ((i < its_Tb_itc) && (its_Tb_tbl[i] === mSL_cstComma)) ( i += 1; ); i; );

// the expanded table (its_Al_buf : 0 when its size is computed)
function its_Al_Emit(w) ( (its_Al_buf !== 0) ? (its_Al_buf[its_Al_cnt] = w); its_Al_cnt += 1; );

// the declaration of the name "w" : its index, or -1
function its_Al_DIdx(w) local(i, k)
(
    k = -1; i = 0; while ((k < 0) && (i < its_AlDCnt)) ( (its_AlDN[i] === w) ? (k = i); i += 1; );
    k;
);

// a number (a "-" word before it changes its sign) at "i" in the "n" words "tp" : its value (Undef if none), its_Al_rn the next
// index
function its_Al_RNum(tp, n, i) local(w, sg)
(
    sg = 1;
    w = (i < n) ? tp[i] : its_TK_End;
    (w === mSL_cstMinus) ? ( sg = -1; i += 1; w = (i < n) ? tp[i] : its_TK_End; );
    its_Al_rn = i + 1;
    (abs(w) < mSL_CharConst) ? sg * w : Undef;
);

// the declarations of the template "tp" ("n" words) : its_AlD..., its_AlDCnt ; its_AlBody : the index of its first block
function its_Al_Decl(tp, n) local(i, w, nm, c, v1, v2, v3)
(
    its_AlDCnt = 0; i = 0; its_AlBody = -1;
    while ((its_Tb_error === 0) && (its_AlBody < 0) && (i < n)) (
        w = tp[i];
        (w === mSL_cstComma) ? ( i += 1; ) :
        ((w === its_TK_input) || (w === its_TK_output) || (w === its_TK_param)) ? (
            nm = (i + 1 < n) ? tp[i + 1] : 0;
            c = its_AlDCnt;
            !its_Tb_IsName(nm) ? (
                sprintf(#its_TbW, "Algorithm %s : %s is not a name", mSL_edit_value(#its_TbV, its_Al_cur), mSL_edit_value(#its_TbV1, nm));
                its_Tb_Err(2782, #its_TbW);
            ) :
            (its_Al_DIdx(nm) >= 0) ? (
                sprintf(#its_TbW, "Algorithm %s : %s is declared twice", mSL_edit_value(#its_TbV, its_Al_cur), mSL_edit_value(#its_TbV1, nm));
                its_Tb_Err(2782, #its_TbW);
            ) :
            (c >= its_AlDMx) ? (
                sprintf(#its_TbW, "Algorithm %s : more than %d declarations", mSL_edit_value(#its_TbV, its_Al_cur), its_AlDMx);
                its_Tb_Err(2788, #its_TbW);
            ) : (
                its_AlDN[c] = nm; its_AlDK[c] = (w === its_TK_input) ? 0 : (w === its_TK_output) ? 1 : 2;
                i += 2;
                (w === its_TK_param) ? (
                    v1 = its_Al_RNum(tp, n, i); i = its_Al_rn;
                    v2 = its_Al_RNum(tp, n, i); i = its_Al_rn;
                    v3 = its_Al_RNum(tp, n, i); i = its_Al_rn;
                    ((v1 === Undef) || (v2 === Undef) || (v3 === Undef) || (v2 > v1) || (v1 > v3)) ? (
                        sprintf(#its_TbW, "Algorithm %s : param %s default min max (min <= default <= max) expected",
                            mSL_edit_value(#its_TbV, its_Al_cur), mSL_edit_value(#its_TbV1, nm));
                        its_Tb_Err(2782, #its_TbW);
                    );
                    its_AlDDef[c] = v1; its_AlDMin[c] = v2; its_AlDMax[c] = v3;
                );
                its_AlDCnt += 1;
            );
        ) : (
            its_AlBody = i; // the first block
        );
    );
    (its_AlBody < 0) ? (its_AlBody = n);
);

// the template "w" : 1 if it exists (its words in its_Al_tp, its_Al_tl), the templates of this table first
function its_Al_FindTpl(w) local(i, r)
(
    r = 0;
    i = its_APCnt - 1; while ((r === 0) && (i >= 0)) (
        (its_APN[i] === w) ? ( r = 1; its_Al_tp = its_APP[i]; its_Al_tl = its_APL[i]; );
        i -= 1;
    );
    i = 0; while ((r === 0) && (i < its_AlgMx)) (
        (its_AlgSym[i] === w) ? ( r = 1; its_Al_tp = its_AlgBlk[i]; its_Al_tl = its_AlgLen[i]; );
        i += 1;
    );
    r;
);

// the instance named "w" : its number (recorded, or of this table), or -1
function its_Al_InsFind(w) local(i, k)
(
    k = -1;
    i = 1; while ((k < 0) && (i <= its_InsMx)) ( (its_InsSym[i] === w) ? (k = i); i += 1; );
    i = 0; while ((k < 0) && (i < its_IPCnt)) ( (its_IPN[i] === w) ? (k = its_IPK[i]); i += 1; );
    k;
);

// a module (line, writer, reader, effect) belongs to the instance "k"
function its_Al_Owned(k) local(i, b, r)
(
    r = 0;
    i = 0; while (!r && (i < LN_CNT)) ( b = Lines_Set[i]; r = (b > BASE_MEMORY) && (b[-2] === KW_lcbl) && (b[its_Lin_Owner] === k); i += 1; );
    i = 0; while (!r && (i < WR_CNT)) ( b = Writers_set[i]; r = (b > BASE_MEMORY) && (b[-2] === KW_writ) && (b[its_Wrt_Owner] === k); i += 1; );
    i = 0; while (!r && (i < RD_CNT)) ( b = Readers_set[i]; r = (b > BASE_MEMORY) && (b[-2] === KW_read) && (b[its_Rdr_Owner] === k); i += 1; );
    i = 0; while (!r && (i < FX_CNT)) ( b = Effects_set[i]; r = (b > BASE_MEMORY) && (b[-2] === KW_effx) && (b[its_Efx_Owner] === k); i += 1; );
    r;
);

// a free number for a new instance (not recorded, not used by this table, no module) : 1 ... its_InsMx, or 0
function its_Al_NewId() local(k, i, j, u)
(
    k = 0; i = 1;
    while ((k === 0) && (i <= its_InsMx)) (
        u = (its_InsSym[i] !== 0) || its_Al_Owned(i);
        j = 0; while (!u && (j < its_IPCnt)) ( u = (its_IPK[j] === i); j += 1; );
        !u ? (k = i);
        i += 1;
    );
    k;
);

// the words of an input (dst = 0) or of an output (dst = 1) at "p" in the table : their count (0 : not a source, a destination)
function its_Al_SrcLen(p, dst) local(w, n)
(
    w = its_Al_W(p);
    n = ((dst && (w === its_TK_Own)) || (!dst && (w === its_TK_none))) ? 1 :
        ((!dst && (w === its_TK_In)) || (w === its_TK_Out)) ? 3 :
        ((w === its_TK_Bus) || (!dst && ((w === its_TK_Reader) || (w === its_TK_Effect) || (w === its_TK_Ctl)))) ? 2 : 0;
    ((n === 2) && (w !== its_TK_Ctl) && (its_Al_W(p + 2) === its_TK_Colon)) ? (n = 4);
    n;
);

// the arguments of the instance "nm" (template "an", declarations its_AlD...) from "p" up to the next block : its_AlAP (position
// of the value of each declaration, 0 : not given), its_AlAL (its count of words), its_AlAV (a parameter : its value) ; the index after
function its_Al_Args(p, nm, an) local(d, w, n, v)
(
    d = 0; loop(its_AlDMx, its_AlAP[d] = 0; d += 1;);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Al_W(p = its_Al_Skip(p)))) (
        its_Tb_ptr = p; // (the word of an error)
        ((d = its_Al_DIdx(w)) < 0) ? (
            sprintf(#its_TbW, "Instance %s : %s is not an argument of %s", mSL_edit_value(#its_TbV, nm),
                mSL_edit_value(#its_TbV1, w), mSL_edit_value(#its_TbV2, an));
            its_Tb_Err(2784, #its_TbW);
        ) : (
            p = its_Al_Skip(p + 1);
            its_AlAP[d] = p;
            (its_AlDK[d] === 2) ? (
                v = its_Al_RNum(its_Tb_tbl, its_Tb_itc, p);
                ((v === Undef) || (v < its_AlDMin[d]) || (v > its_AlDMax[d])) ? (
                    sprintf(#its_TbW, "Instance %s : %s : %s is not a value in [%g, %g]", mSL_edit_value(#its_TbV, nm),
                        mSL_edit_value(#its_TbV1, w), mSL_edit_value(#its_TbV2, its_Al_W(p)), its_AlDMin[d], its_AlDMax[d]);
                    its_Tb_Err(2785, #its_TbW);
                );
                its_AlAV[d] = v; p = its_Al_rn;
            ) : (
                ((n = its_Al_SrcLen(p, its_AlDK[d])) === 0) ? (
                    sprintf(#its_TbW, "Instance %s : %s : %s is not %s", mSL_edit_value(#its_TbV, nm),
                        mSL_edit_value(#its_TbV1, w), mSL_edit_value(#its_TbV2, its_Al_W(p)),
                        its_AlDK[d] ? "a destination" : "a source");
                    its_Tb_Err(2784, #its_TbW);
                );
                its_AlAL[d] = n; p += n;
            );
        );
    );
    p;
);

// the record of the arguments (for each declaration : n, then n words), in its_IPArg from its_IPAPt : the given ones, the
// others from "old" (a record, 0 : the defaults) ; its offset (its_Al_alen : its length)
function its_Al_Record(old) local(ao, d, n, j, q)
(
    ao = its_IPAPt; q = old;
    d = 0; while ((its_Tb_error === 0) && (d < its_AlDCnt)) (
        n = its_AlAP[d] ? ((its_AlDK[d] === 2) ? 1 : its_AlAL[d]) : (old !== 0) ? q[0] : 1;
        (ao + n + 1 > its_IPArgSz) ? (
            its_Tb_Err(2788, "Instance : too many arguments in this table");
        ) : (
            its_IPArg[ao] = n;
            its_AlAP[d] ? (
                (its_AlDK[d] === 2) ? (
                    its_IPArg[ao + 1] = its_AlAV[d];
                ) : (
                    j = 0; loop(n, its_IPArg[ao + 1 + j] = its_Tb_tbl[its_AlAP[d] + j]; j += 1;);
                );
            ) :
            (old !== 0) ? (
                j = 0; loop(n, its_IPArg[ao + 1 + j] = q[1 + j]; j += 1;);
            ) : (
                its_IPArg[ao + 1] = its_AlDDef[d]; // (a parameter : an input or an output is given)
            );
            ao += n + 1;
        );
        (old !== 0) ? (q += q[0] + 1);
        d += 1;
    );
    its_Al_alen = ao - its_IPAPt;
    ao = its_IPAPt; its_IPAPt += its_Al_alen;
    ao;
);

// the body of the template "tp" ("tl" words), the names of the declarations replaced by the arguments of the record "ao" ;
// chg : a changed argument is preceded by the marker its_TbM_Chg (Set)
function its_Al_Body(tp, tl, ao, chg) local(j, w, d, q, v, n)
(
    j = its_AlBody; while (j < tl) (
        w = tp[j];
        ((d = its_Al_DIdx(w)) < 0) ? (
            its_Al_Emit(w);
        ) : (
            q = ao; loop(d, q += its_IPArg[q] + 1;); // the argument d
            (chg && its_AlAP[d]) ? its_Al_Emit(its_TbM_Chg);
            (its_AlDK[d] === 2) ? (
                v = its_IPArg[q + 1];
                (v < 0) ? ( its_Al_Emit(mSL_cstMinus); its_Al_Emit(-v); ) : its_Al_Emit(v);
            ) : (
                its_Al_Emit(its_TbM_Out);
                n = its_IPArg[q]; q += 1; loop(n, its_Al_Emit(its_IPArg[q]); q += 1;);
                its_Al_Emit(its_TbM_In);
            );
        );
        j += 1;
    );
);

// Instance at "i" : checked, its body is emitted (with its markers) ; the index after it
function its_Al_Inst(i) local(nm, an, k, p, d, pi, tp)
(
    nm = its_Al_W(i + 1); an = its_Al_W(i + 2); p = i + 3;
    !its_Tb_IsName(nm) ? (
        sprintf(#its_TbW, "Instance : %s is not a name", mSL_edit_value(#its_TbV, nm));
        its_Tb_Err(2783, #its_TbW);
    ) :
    (its_Al_InsFind(nm) >= 0) ? (
        sprintf(#its_TbW, "Instance %s exists already (Free Instance first)", mSL_edit_value(#its_TbV, nm));
        its_Tb_Err(2783, #its_TbW);
    ) :
    !its_Al_FindTpl(an) ? (
        sprintf(#its_TbW, "Instance %s : unknown algorithm %s", mSL_edit_value(#its_TbV, nm), mSL_edit_value(#its_TbV1, an));
        its_Tb_Err(2781, #its_TbW);
    ) :
    ((its_IPCnt >= its_IPMx) || ((k = its_Al_NewId()) === 0)) ? (
        sprintf(#its_TbW, "Instance %s : too many instances", mSL_edit_value(#its_TbV, nm));
        its_Tb_Err(2788, #its_TbW);
    ) : (
        tp = its_Al_tp;
        its_Al_cur = an;
        its_Al_Decl(tp, its_Al_tl);
        p = its_Al_Args(p, nm, an);
        // an input or an output must be given
        d = 0; while ((its_Tb_error === 0) && (d < its_AlDCnt)) (
            ((its_AlDK[d] < 2) && (its_AlAP[d] === 0)) ? (
                sprintf(#its_TbW, "Instance %s : %s %s missing", mSL_edit_value(#its_TbV, nm), its_AlDK[d] ? "output" : "input",
                    mSL_edit_value(#its_TbV1, its_AlDN[d]));
                its_Tb_Err(2786, #its_TbW);
            );
            d += 1;
        );
        (its_Tb_error === 0) ? (
            pi = its_IPCnt; its_IPCnt += 1;
            its_IPN[pi] = nm; its_IPK[pi] = k; its_IPAN[pi] = an; its_IPTP[pi] = tp; its_IPTL[pi] = its_Al_tl;
            its_IPAO[pi] = its_Al_Record(0); its_IPAL[pi] = its_Al_alen;
            its_Al_Emit(its_TbM_Ins); its_Al_Emit(pi);
            its_Al_Body(tp, its_Al_tl, its_IPAO[pi], 0);
            its_Al_Emit(its_TbM_InsEnd);
        );
    );
    p;
);

// Set at "i" : the arguments given replace those of the instance ; its body is emitted in the mode Set (only the keys
// that depend on a changed argument are applied, its_TbM_Chg) ; the index after it
function its_Al_Set(i) local(nm, k, p, j, pi, si, tp, tl, old)
(
    nm = its_Al_W(i + 1); p = i + 2;
    ((k = its_Al_InsFind(nm)) < 0) ? (
        sprintf(#its_TbW, "Set : unknown instance %s", mSL_edit_value(#its_TbV, nm));
        its_Tb_Err(2787, #its_TbW);
    ) :
    (its_SPCnt >= its_SPMx) ? (
        its_Tb_Err(2788, "Set : too many Set in this table");
    ) : (
        // the template and the arguments : recorded, or of an instance of this table (the last record of its arguments)
        (its_InsSym[k] === nm) ? (
            tp = its_InsTpl[k]; tl = its_InsTLen[k]; old = its_InsArg[k]; its_Al_cur = its_InsAName[k];
        ) : (
            j = 0; while (j < its_IPCnt) ( (its_IPK[j] === k) ? (pi = j); j += 1; );
            tp = its_IPTP[pi]; tl = its_IPTL[pi]; old = its_IPArg + its_IPAO[pi]; its_Al_cur = its_IPAN[pi];
        );
        j = 0; while (j < its_SPCnt) ( (its_SPK[j] === k) ? (old = its_IPArg + its_SPAO[j]); j += 1; ); // (a previous Set)
        its_Al_Decl(tp, tl);
        p = its_Al_Args(p, nm, its_Al_cur);
        (its_Tb_error === 0) ? (
            si = its_SPCnt; its_SPCnt += 1;
            its_SPK[si] = k;
            its_SPAO[si] = its_Al_Record(old); its_SPAL[si] = its_Al_alen;
            its_Al_Emit(its_TbM_Set); its_Al_Emit(si);
            its_Al_Body(tp, tl, its_SPAO[si], 1);
            its_Al_Emit(its_TbM_SetEnd);
        );
    );
    p;
);

// the table, its templates taken and its instances expanded, in its_Al_buf (0 : only its size, its_Al_cnt)
// (Algorithm and Instance after Free or Dump are kept : Free Algorithm, Free Instance, Dump Instance)
function its_Al_Expand() local(i, j, w, nm, pw)
(
    its_Al_cnt = its_APCnt = its_IPCnt = its_SPCnt = its_IPAPt = 0;
    i = 0; pw = 0;
    while ((its_Tb_error === 0) && (i < its_Tb_itc)) (
        w = its_Tb_tbl[i];
        its_Tb_ptr = i; // (the word of an error)
        ((pw === its_TK_Free) || (pw === its_TK_Dump)) ? (
            its_Al_Emit(w);
            i += 1;
        ) :
        (w === its_TK_Algorithm) ? (
            nm = its_Al_W(i + 1); j = i + 2;
            while ((j < its_Tb_itc) && ((w = its_Tb_tbl[j]) !== its_TK_End) && (w !== its_TK_Algorithm) && (w !== its_TK_Instance)
                && (w !== its_TK_EofMark)) ( j += 1; );
            !its_Tb_IsName(nm) ? (
                sprintf(#its_TbW, "Algorithm : %s is not a name", mSL_edit_value(#its_TbV, nm));
                its_Tb_Err(2782, #its_TbW);
            ) :
            ((j >= its_Tb_itc) || (its_Tb_tbl[j] !== its_TK_End)) ? (
                sprintf(#its_TbW, "Algorithm %s : %s", mSL_edit_value(#its_TbV, nm),
                    ((w === its_TK_Algorithm) || (w === its_TK_Instance)) ? "Algorithm or Instance inside" : "End missing");
                its_Tb_Err(((w === its_TK_Algorithm) || (w === its_TK_Instance)) ? 2789 : 2780, #its_TbW);
            ) :
            (its_APCnt >= its_APMx) ? (
                its_Tb_Err(2788, "Algorithm : too many templates in this table");
            ) : (
                its_Al_cur = nm;
                its_Al_Decl(its_Tb_tbl + i + 2, j - i - 2);
                its_APN[its_APCnt] = nm; its_APP[its_APCnt] = its_Tb_tbl + i + 2; its_APL[its_APCnt] = j - i - 2;
                its_APCnt += 1;
            );
            i = j + 1;
        ) :
        (w === its_TK_Instance) ? (
            i = its_Al_Inst(i);
        ) :
        (w === its_TK_Set) ? (
            i = its_Al_Set(i);
        ) : (
            its_Al_Emit(w);
            i += 1;
        );
        (w !== mSL_cstComma) ? (pw = w);
    );
    its_Tb_ptr = 0;
);

// a copy of the record of arguments "ao" ("n" words) in a dynamic block (0 : no memory) ; a name of the table after Reader or
// Effect becomes its number (the names of a table don't last)
function its_Al_ArgCopy(ao, n) local(b, i, j)
(
    ((b = mSL_Dyn_Alloc(n + 1, 'alga', 0)) > BASE_MEMORY) ? (
        memcpy(b, its_IPArg + ao, n);
        j = 1; while (j < n) (
            (((b[j - 1] === its_TK_Reader) || (b[j - 1] === its_TK_Effect)) && its_Tb_IsName(b[j])) ? (
                i = 0; while (i < its_TbNCnt) (
                    ((its_TbNSym[i] === b[j]) && (its_TbNScp[i] === 0) && (its_TbNTyp[i] === b[j - 1])) ? (
                        b[j] = its_TbNIdx[i] + 1; i = its_TbNCnt;
                    );
                    i += 1;
                );
            );
            j += 1;
        );
    );
    b;
);

// pass 3, at the end of a Set : the new arguments of the instance are recorded
function its_Al_SetCommit(si) local(k, b)
(
    k = its_SPK[si];
    ((b = its_Al_ArgCopy(its_SPAO[si], its_SPAL[si])) <= BASE_MEMORY) ? (
        its_Tb_Err(2790, "Set : not enough memory for the arguments");
    ) : (
        (its_InsArg[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_InsArg[k]);
        its_InsArg[k] = b; its_InsALen[k] = its_SPAL[si];
    );
);

// pass 3, at the end of an instance : it is recorded (its template copied, its arguments, its names)
function its_Al_Commit(pi) local(k, b, n, i, j, ok)
(
    k = its_IPK[pi]; ok = 1;
    its_InsSym[k] = its_IPN[pi]; its_InsAName[k] = its_IPAN[pi];
    ((b = mSL_Dyn_Alloc(its_IPTL[pi] + 1, 'algt', 0)) > BASE_MEMORY) ? memcpy(b, its_IPTP[pi], its_IPTL[pi]) : (ok = 0);
    its_InsTpl[k] = b; its_InsTLen[k] = its_IPTL[pi];
    ((b = its_Al_ArgCopy(its_IPAO[pi], its_IPAL[pi])) <= BASE_MEMORY) ? (ok = 0);
    its_InsArg[k] = b; its_InsALen[k] = its_IPAL[pi];
    n = 0; i = 0; loop(its_TbNCnt, (its_TbNScp[i] === k) ? (n += 1); i += 1;);
    ((b = mSL_Dyn_Alloc(3 * n + 1, 'algn', 0)) > BASE_MEMORY) ? (
        j = 0; i = 0; loop(its_TbNCnt,
            (its_TbNScp[i] === k) ? ( b[j] = its_TbNSym[i]; b[j + 1] = its_TbNTyp[i]; b[j + 2] = its_TbNIdx[i]; j += 3; );
            i += 1;
        );
    ) : (ok = 0);
    its_InsNam[k] = b; its_InsNCnt[k] = n;
    !ok ? (
        sprintf(#its_TbW, "Instance %s : not enough memory for its record", mSL_edit_value(#its_TbV, its_IPN[pi]));
        its_Tb_Err(2790, #its_TbW);
    );
);

function its_Al_Flush()
(
    (its_Tb_cpend >= 0) ? ( its_Al_Commit(its_Tb_cpend); its_Tb_cpend = -1; );
    (its_Tb_spend >= 0) ? ( its_Al_SetCommit(its_Tb_spend); its_Tb_spend = -1; );
);

// the names of the recorded instances changed by a Set of the table : in the table of the names (their scope : the instance)
function its_Al_SetNames() local(i, j, k, b, m)
(
    i = 0; loop(its_SPCnt,
        k = its_SPK[i]; m = 1;
        j = 0; while (j < i) ( (its_SPK[j] === k) ? (m = 0); j += 1; ); // (once per instance)
        (m && ((b = its_InsNam[k]) > BASE_MEMORY)) ? (
            j = 0; loop(its_InsNCnt[k],
                (its_TbNCnt < its_TbNSz) ? (
                    its_TbNSym[its_TbNCnt] = b[3 * j]; its_TbNTyp[its_TbNCnt] = b[3 * j + 1]; its_TbNIdx[its_TbNCnt] = b[3 * j + 2];
                    its_TbNScp[its_TbNCnt] = k;
                    its_TbNCnt += 1;
                );
                j += 1;
            );
        );
        i += 1;
    );
);

// end of a table without error : its templates are recorded (a template of the same name is replaced)
function its_Al_TplCommit() local(i, j, k, b)
(
    i = 0; loop(its_APCnt,
        (its_APN[i] !== 0) ? (
            k = -1; j = 0; while ((k < 0) && (j < its_AlgMx)) ( (its_AlgSym[j] === its_APN[i]) ? (k = j); j += 1; );
            j = 0; while ((k < 0) && (j < its_AlgMx)) ( (its_AlgSym[j] === 0) ? (k = j); j += 1; );
            (k < 0) ? (
                its_Tb_Err(2788, "Algorithm : too many templates");
            ) :
            ((b = mSL_Dyn_Alloc(its_APL[i] + 1, 'algt', 0)) <= BASE_MEMORY) ? (
                its_Tb_Err(2790, "Algorithm : not enough memory");
            ) : (
                (its_AlgBlk[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_AlgBlk[k]);
                memcpy(b, its_APP[i], its_APL[i]);
                its_AlgSym[k] = its_APN[i]; its_AlgBlk[k] = b; its_AlgLen[k] = its_APL[i];
            );
        );
        i += 1;
    );
);

// the text of the "n" words "p" of an argument (In:0, Bus 2:1, Reader 3...)
function its_Al_WText(str, p, n) local(i, w)
(
    strcpy(str, "");
    i = 0; loop(n,
        w = p[i];
        (w === its_TK_Colon) ? strcat(str, ":") : (
            ((i > 0) && (p[i - 1] !== its_TK_Colon)) ? strcat(str, " ");
            strcat(str, mSL_edit_value(#its_TbV3, w));
        );
        i += 1;
    );
    str;
);

// the call of the instance "k" in "str" : "Instance i Name arg value ..."
function its_Al_CallText(str, k) local(d, q, n)
(
    sprintf(str, "Instance %s %s", mSL_edit_value(#its_TbV, its_InsSym[k]), mSL_edit_value(#its_TbV1, its_InsAName[k]));
    its_Al_cur = its_InsAName[k];
    its_Al_Decl(its_InsTpl[k], its_InsTLen[k]);
    q = its_InsArg[k];
    d = 0; loop(its_AlDCnt,
        n = q[0];
        strcat(str, " "); strcat(str, mSL_edit_value(#its_TbV, its_AlDN[d])); strcat(str, " ");
        (its_AlDK[d] === 2) ? strcat(str, sprintf(#its_TbV1, "%.10g", q[1])) : strcat(str, its_Al_WText(#its_TbV1, q + 1, n));
        q += n + 1; d += 1;
    );
    str;
);

// the name of the instance "k" (the owner of a module) in "str"
function its_Al_OwnName(str, k)
(
    ((k >= 1) && (k <= its_InsMx) && (its_InsSym[k] !== 0)) ? mSL_edit_value(str, its_InsSym[k]) : sprintf(str, "#%d", k);
    str;
);

// the templates in the log : "Algorithm Name input a output b param p def min max"
function its_Al_DumpTpls() local(i, d, n)
(
    n = 0;
    i = 0; loop(its_AlgMx,
        (its_AlgSym[i] !== 0) ? (
            its_Al_cur = its_AlgSym[i];
            its_Al_Decl(its_AlgBlk[i], its_AlgLen[i]);
            sprintf(#its_TbW, "Algorithm %s", mSL_edit_value(#its_TbV, its_AlgSym[i]));
            d = 0; loop(its_AlDCnt,
                strcat(#its_TbW, (its_AlDK[d] === 0) ? " input " : (its_AlDK[d] === 1) ? " output " : " param ");
                strcat(#its_TbW, mSL_edit_value(#its_TbV, its_AlDN[d]));
                (its_AlDK[d] === 2) ? strcat(#its_TbW, sprintf(#its_TbV1, " %.10g %.10g %.10g", its_AlDDef[d], its_AlDMin[d], its_AlDMax[d]));
                d += 1;
            );
            mSL_log(SysLogBox, #its_TbW);
            n += 1;
        );
        i += 1;
    );
    (n === 0) ? mSL_log(SysLogBox, "No algorithm");
);

// Dump Instance i : "Instance i Name arg value ...", then its modules
function its_Al_DumpIns(k) local(i, b)
(
    mSL_log(SysLogBox, its_Al_CallText(#its_TbW, k));
    i = 0; loop(LN_CNT, (((b = Lines_Set[i]) > BASE_MEMORY) && (b[its_Lin_Owner] === k)) ? its_Tb_DumpLine(i); i += 1;);
    i = 0; loop(WR_CNT, (((b = Writers_set[i]) > BASE_MEMORY) && (b[its_Wrt_Owner] === k)) ? its_Tb_DumpMod(its_TK_Writer, i); i += 1;);
    i = 0; loop(RD_CNT, (((b = Readers_set[i]) > BASE_MEMORY) && (b[its_Rdr_Owner] === k)) ? its_Tb_DumpMod(its_TK_Reader, i); i += 1;);
    i = 0; loop(FX_CNT, (((b = Effects_set[i]) > BASE_MEMORY) && (b[its_Efx_Owner] === k)) ? its_Tb_DumpFx(i); i += 1;);
);

// the modules of the instance "k" are deleted, then it is forgotten (@gfx : Free Instance, the module "Instances")
function its_Al_Delete(k) local(i, b)
(
    i = 0; loop(RD_CNT, (((b = Readers_set[i]) > BASE_MEMORY) && (b[its_Rdr_Owner] === k)) ? Rd_Action(i, its_RdrAct_Delete, 0); i += 1;);
    i = 0; loop(WR_CNT, (((b = Writers_set[i]) > BASE_MEMORY) && (b[its_Wrt_Owner] === k)) ? Wr_Action(its_WrtAct_Delete, i, 0); i += 1;);
    i = 0; loop(FX_CNT, (((b = Effects_set[i]) > BASE_MEMORY) && (b[its_Efx_Owner] === k)) ? FX_Delete(i); i += 1;);
    i = 0; loop(LN_CNT, (((b = Lines_Set[i]) > BASE_MEMORY) && (b[its_Lin_Owner] === k)) ? Ln_Delete(i, 1); i += 1;);
    its_Al_InsDrop(k);
    its_PatchForce = 1;
);

// Free Instance i : its modules are deleted (pass 2 : in the simulation), then it is forgotten
function its_Al_FreeIns(k) local(i)
(
    (its_Tb_mode === 2) ? (
        i = 0; loop(LN_CNT, (its_TbSimLO[i] === k) ? ( its_TbSimSp[i] = its_TbSimCh[i] = its_TbSimLO[i] = 0; ); i += 1;);
        i = 0; loop(WR_CNT, (its_TbSimWO[i] === k) ? ( its_TbSimWE[i] = its_TbSimWO[i] = 0; its_TbSimWL[i] = -1; ); i += 1;);
        i = 0; loop(RD_CNT, (its_TbSimRO[i] === k) ? ( its_TbSimRE[i] = its_TbSimRO[i] = 0; ); i += 1;);
        i = 0; loop(FX_CNT, (its_TbSimFO[i] === k) ? ( its_TbSimFE[i] = its_TbSimFT[i] = its_TbSimFO[i] = 0; ); i += 1;);
    ) :
    (its_Tb_mode === 3) ? (
        its_Al_Delete(k);
        i = 0; loop(its_IPCnt, (its_IPK[i] === k) ? (its_IPN[i] = 0); i += 1;); // (an instance of this table)
    );
);

// the instance named by the next word (Free, Dump) : its number, or -1 and an error
function its_Al_InsWord(what) local(w, k)
(
    w = its_Tb_Next();
    ((k = its_Al_InsFind(w)) < 0) ? (
        sprintf(#its_TbW, "%s Instance : unknown instance %s", what, mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2787, #its_TbW);
    );
    k;
);

// Free Algorithm Name : the template is forgotten (the instances keep their copy)
function its_Al_FreeAlg() local(w, i, f)
(
    w = its_Tb_Next(); f = 0;
    i = 0; loop(its_APCnt, (its_APN[i] === w) ? ( f = 1; (its_Tb_mode === 3) ? (its_APN[i] = 0); ); i += 1;);
    i = 0; loop(its_AlgMx,
        (its_AlgSym[i] === w) ? (
            f = 1;
            (its_Tb_mode === 3) ? ( (its_AlgBlk[i] > BASE_MEMORY) ? mSL_Dyn_Free(its_AlgBlk[i]); its_AlgSym[i] = its_AlgBlk[i] = its_AlgLen[i] = 0; );
        );
        i += 1;
    );
    !f ? (
        sprintf(#its_TbW, "Free Algorithm : unknown algorithm %s", mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2781, #its_TbW);
    );
);

//—— Dump, Check, Free
function its_Tb_Dump() local(w, ty, k, b)
(
    w = its_Tb_Next();
    (w === its_TK_Global) ? (
        (its_Tb_mode === 3) ? its_Tb_DumpGlobal();
    ) :
    (w === its_TK_Instance) ? (
        k = its_Al_InsWord("Dump");
        ((its_Tb_mode === 3) && (k > 0)) ? its_Al_DumpIns(k);
    ) :
    (w === its_TK_Order) ? (
        // the execution order of the effects that exist (computed now, unless the previous one is not yet taken by @block)
        (its_Tb_mode === 3) ? (
            (its_FxOrdRdy === 0) ? ( its_FxSig = -1; its_Fx_Order(); );
            strcpy(#its_TbW, "Order :");
            k = 0; loop(FX_CNT,
                b = Effects_set[its_FxOrdNew[k]];
                ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? strcat(#its_TbW, sprintf(#its_TbV1, " %d", its_FxOrdNew[k] + 1));
                k += 1;
            );
            strcat(#its_TbW, sprintf(#its_TbV1, " ; loops %d", its_FxCycN));
            mSL_log(SysLogBox, #its_TbW);
        );
    ) :
    (w === its_TK_All) ? (
        (its_Tb_mode === 3) ? (
            its_Tb_DumpGlobal();
            k = 0; loop(LN_CNT, (Lines_Set[k] !== 0) ? its_Tb_DumpLine(k); k += 1;);
            k = 0; loop(WR_CNT, (Writers_set[k] !== 0) ? its_Tb_DumpMod(its_TK_Writer, k); k += 1;);
            k = 0; loop(RD_CNT, (Readers_set[k] !== 0) ? its_Tb_DumpMod(its_TK_Reader, k); k += 1;);
            k = 0; loop(FX_CNT, (Effects_set[k] !== 0) ? its_Tb_DumpFx(k); k += 1;);
        );
    ) :
    ((ty = its_Tb_Type(w, "Dump")) !== 0) ? (
        k = its_Tb_Id(ty, its_Tb_Next(), 0);
        ((its_Tb_mode === 3) && (k >= 0)) ? (
            (ty === its_TK_Line) ? its_Tb_DumpLine(k) : (ty === its_TK_Effect) ? its_Tb_DumpFx(k) : its_Tb_DumpMod(ty, k);
        );
    );
);

function its_Tb_Check() local(w, ty, k)
(
    ((w = its_Tb_Next()) === its_TK_Global) ? (
        its_Tb_CheckGlobal();
    ) :
    ((ty = its_Tb_Type(w, "Check")) !== 0) ? (
        k = its_Tb_Id(ty, its_Tb_Next(), 0);
        (ty === its_TK_Line) ? its_Tb_CheckLine(k) : (ty === its_TK_Effect) ? its_Tb_CheckFx(k) : its_Tb_CheckMod(ty, k);
    );
);

function its_Tb_Free() local(w, ty, k)
(
    ((w = its_Tb_Next()) === its_TK_Instance) ? (
        ((k = its_Al_InsWord("Free")) > 0) ? its_Al_FreeIns(k);
    ) :
    (w === its_TK_Algorithm) ? (
        its_Al_FreeAlg();
    ) :
    ((ty = its_Tb_Type(w, "Free")) !== 0) ? (
        k = its_Tb_Id(ty, its_Tb_Next(), 0);
        (k >= 0) ? (
            (its_Tb_mode === 2) ? (
                (ty === its_TK_Line) ? ( its_TbSimSp[k] = its_TbSimCh[k] = 0; ) :
                (ty === its_TK_Writer) ? ( its_TbSimWE[k] = 0; its_TbSimWL[k] = -1; ) :
                (ty === its_TK_Reader) ? ( its_TbSimRE[k] = 0; ) :
                ( its_TbSimFE[k] = its_TbSimFT[k] = 0; );
            ) :
            (its_Tb_mode === 3) ? (
                (ty === its_TK_Line) ? Ln_Delete(k, 1) :
                (ty === its_TK_Writer) ? Wr_Action(its_WrtAct_Delete, k, 0) :
                (ty === its_TK_Reader) ? Rd_Action(k, its_RdrAct_Delete, 0) :
                FX_Delete(k);
            );
        );
    );
);

// Implementation of the mSL "table" operation
function Set_Table(tbl) local(m, w, xb)
(
    its_Tb_tbl = tbl; its_Tb_itc = tbl[-1];
    its_Tb_error = its_Tb_res = its_TbNCnt = 0;
    its_Tb_scope = its_Tb_sscope = its_Tb_setm = 0; its_Tb_cpend = its_Tb_spend = -1;
    memset(its_TbResv, 0, LN_CNT + WR_CNT + RD_CNT + FX_CNT);
    // the templates taken, the instances expanded (its_Al_Expand : its size, then the words)
    its_Al_buf = xb = 0;
    its_Al_Expand();
    (its_Tb_error === 0) ? (
        ((xb = mSL_Dyn_Alloc(its_Al_cnt + 4, 'tbex', 0)) <= BASE_MEMORY) ? (
            its_Tb_Err(2790, "not enough memory for the expanded table");
            xb = 0;
        ) : (
            its_Al_buf = xb;
            its_Al_Expand();
            its_Al_buf = 0;
            its_Tb_tbl = xb; its_Tb_itc = its_Al_cnt;
            its_Al_SetNames(); // (the modules of the instances changed by a Set)
        );
    );
    m = 0;
    while ((m <= 3) && (its_Tb_error === 0)) (
        its_Tb_mode = m; its_Tb_ptr = its_Tb_clr = 0;
        its_Tb_scope = its_Tb_sscope = its_Tb_setm = 0;
        its_Tb_SimInit();
        (its_Tb_Peek() === its_TK_Interstys) ? its_Tb_Next();
        while ((its_Tb_error === 0) && ((w = its_Tb_Next()) !== its_TK_End) && (w !== its_TK_EofMark)) (
            its_Al_Flush(); // (an instance ended by the previous block)
            (w === its_TK_Clear) ? its_Tb_Clear() :
            (w === its_TK_Line) ? its_Tb_Line() :
            ((w === its_TK_Writer) || (w === its_TK_Reader) || (w === its_TK_Effect)) ? its_Tb_Module(w) :
            (w === its_TK_Dump) ? its_Tb_Dump() :
            (w === its_TK_Check) ? its_Tb_Check() :
            (w === its_TK_Free) ? its_Tb_Free() :
            (w === its_TK_Global) ? its_Tb_Global() : (
                sprintf(#its_TbW, "%s : a block (Line, Writer, Reader, Effect, Global, Algorithm, Instance, Set, Dump, Check, Free, Clear) is expected", mSL_edit_value(#its_TbV, w));
                its_Tb_Err(2750, #its_TbW);
            );
        );
        (its_Tb_error === 0) ? its_Al_Flush();
        m += 1;
    );
    ((m === 4) && (its_Tb_error === 0)) ? its_Al_TplCommit();
    (xb > BASE_MEMORY) ? mSL_Dyn_Free(xb);
    (m === 4) ? (its_PatchForce = 1); // the cables of all the modules (see its_Patch_Update)
    (its_Tb_error !== 0) ? its_Tb_error : its_Tb_res;
);


// Insert here the mSL interpreter
<? include("GM-Libs/mSL_Evaluator.jsfx-inc"); ?>


TabAddrMax = mSL_StM_FreePt; // max. address recognized for an array
SharedHighMemory = lastmemory = make_array(2); // last use of the function
// End of the static allocations : from now on, make_array is refused (as in the other applications) ;
// mSL_Dyn_Alloc does not depend on this mode (it uses the dynamic memory created by mSL_make_memory)
current_Memory_Mode = mSL_MMd_Dynamic;  // change allocation mode



// Initial memory check
mSL_StM_Check(0);



Last_in_memory_alloc = mSL_StM_FreePt;
Free_Memory = __memtop() - mSL_StM_FreePt;
str_mess = "Interstys started";

mSL_log(SysLogBox, "*** Interstys started ***");
sprintf(#itm, "Memory : dynamic %.2f MW, free after the static allocations %.2f MW (top %.2f MW)",
    C_memrSize / 1048576, Free_Memory / 1048576, __memtop() / 1048576);
mSL_log(SysLogBox, #itm);

// the native JSFX sliders are hidden at start (key 'S' shows them)
(!gui_show_sliders) ? mod_sliders(0);

@slider

update_sliders();



@serialize


doingLoad = doingSave = 0;
handling_load = perform_loading = 0;
loadMode = file_avail(0) >= 0;


loadMode ? (


    // ===LOAD===

    doingLoad = 1;
    // a previous load not yet taken by @block (see recreate_structures) : first, @block must not take this one
    // before it is complete ; then the blocks of the previous one are freed
    ldprev = perform_loading;
    perform_loading = 0;
    handling_load = 1;
    (ldprev) ? its_Load_Drop();
    lditmc = 0; ldstud = 0; ldtnam = -1; // count of tabs names read (-1 : none in this preset)
    ldtotal = 0;
    lderr = 0;
    memset(DuplWA, 0, StaticWASize); // clean the load area pointer
    z__si = 0; loop(LN_CNT, strcpy(its_LnFile[z__si], ""); z__si += 1;); // (the files of the lines : 'lfil' blocks)
    // the templates and the instances of algorithms ('algt', 'ains' blocks)
    z__si = 0; loop(its_AlgMx,
        (its_AlgBlk[z__si] > BASE_MEMORY) ? mSL_Dyn_Free(its_AlgBlk[z__si]);
        its_AlgSym[z__si] = its_AlgBlk[z__si] = its_AlgLen[z__si] = 0;
        z__si += 1;
    );
    z__si = 1; loop(its_InsMx, (its_InsSym[z__si] !== 0) ? its_Al_InsDrop(z__si); z__si += 1;);
    // First, load the block
    slz1 = load_mem(0, lodarea, SVASIZ);
    ldtotal += slz1;
    ldok = (lodarea[0] == savcode) && (lodarea[SVASIZ-1] == savcode);
    while (ldok && (file_avail(0) > 0)) (
        slz2 = load_mem(0, savtmp, TMPSIZ);
        ldtotal += slz2;
        (savtmp[0] === 'stwa') ? (
            z__si = savtmp[1];
            sbty = savtmp[2];
            sbsz = savtmp[3];
            ((z__si < 0) || (z__si >= StaticWASize)) ? (
                ldok = 0;
                lderr = 180
            ) : (
                // Create a memory area for the block
                z__sbl = mSL_Dyn_Alloc(sbsz, sbty, 0); // allocate memory
                (z__sbl === 0) ? (
                    ldok = 0; // can't allocate
                    lderr = 170;
                ) : (
                    rdsz = load_mem(0, z__sbl, sbsz); // Read the block
                    ldtotal += rdsz;
                    (rdsz !== sbsz) ? (
                        ldok = 0;
                        lderr = 160;
                    ) :
                    (check_its_block(z__sbl)) ? (
                        ldok = 0;
                        lderr = 156;
                    ) : (
                        (sbty === KW_effx) ? (z__sbl[its_Efx_Work] = z__sbl[its_Efx_WkNew] = z__sbl[its_Efx_WkOld] = 0);
                        DuplWA[z__si] = z__sbl;
                        lditmc += 1;
                    );
                );
            );
        ) :
        (savtmp[0] === 'stud') ? (
            // studio : tabs config (Pr7_*) and modules shown in each pane
            ((savtmp[1] <= 128) && (savtmp[2] <= dcbBSize)) ? (
                ldtotal += load_mem(0, serialBlock, savtmp[1]);
                ldtotal += load_mem(0, dcbBlocksAll, savtmp[2]);
                ldstud = 1;
                ui_jstyle = (serialBlock[Pr7_UiStyle] != 0); // look of the GUI
                uix_jtheme = max(0, min(uix_jtheme_rtc_max - 1, 0|serialBlock[Pr7_UiTheme])); // theme of the GUI
            ) : (
                ldok = 0;
                lderr = 140; // studio block too large
            );
        ) :
        (savtmp[0] === 'disp') ? (
            // display blocks of the modules (absent from the older presets : the modules then show the objects 1)
            z__si = min(savtmp[1], DispStructsSize); // another size (other version) : read up to the smallest one
            ldtotal += load_mem(0, ReadersStructA, z__si);
            loop(2 * (savtmp[1] - z__si), file_var(0, zzz_dskip)); // each value is saved in 2 words (see save_mem)
            // the numbers of the objects shown must stay in their sets
            z__si = 0; loop(8,
                z__sp = ReadersStructA + z__si * ReadersBlockSize; z__sp[0] = max(0, min(RD_CNT - 1, 0|z__sp[0]));
                z__sp = LinesStructA + z__si * LinesBlockSize; z__sp[0] = max(0, min(LN_CNT - 1, 0|z__sp[0]));
                z__sp = WriterStructA + z__si * WriterBlockSize; z__sp[0] = max(0, min(WR_CNT - 1, 0|z__sp[0]));
                z__si += 1;
            );
            z__si = 0; loop(10,
                z__sp = EffectsStructA + z__si * LinesBlockSize; z__sp[0] = max(0, min(FX_CNT - 1, 0|z__sp[0]));
                z__si += 1;
            );
        ) :
        (savtmp[0] === 'algt') ? (
            // a template of algorithm (its name, its words)
            z__sp = 0; while ((z__sp < its_AlgMx) && (its_AlgSym[z__sp] !== 0)) ( z__sp += 1; );
            z__sbl = ((z__sp < its_AlgMx) && (savtmp[2] > 0)) ? mSL_Dyn_Alloc(savtmp[2] + 1, 'algt', 0) : 0;
            (z__sbl > BASE_MEMORY) ? (
                ldtotal += load_mem(0, z__sbl, savtmp[2]);
                its_AlgSym[z__sp] = savtmp[1]; its_AlgBlk[z__sp] = z__sbl; its_AlgLen[z__sp] = savtmp[2];
            ) : (
                ldok = 0; lderr = 171; // no room or no memory for the template
            );
        ) :
        (savtmp[0] === 'ains') ? (
            // an instance of algorithm : number, name, template name ; then the sizes of its template, arguments, names
            z__si = savtmp[1];
            ldtotal += load_mem(0, savtmp + TMPSIZ, TMPSIZ);
            ((z__si >= 1) && (z__si <= its_InsMx) && (its_InsSym[z__si] === 0)) ? (
                its_InsSym[z__si] = savtmp[2]; its_InsAName[z__si] = savtmp[3];
                its_InsTLen[z__si] = savtmp[TMPSIZ]; its_InsALen[z__si] = savtmp[TMPSIZ + 1]; its_InsNCnt[z__si] = savtmp[TMPSIZ + 2];
                its_InsTpl[z__si] = mSL_Dyn_Alloc(its_InsTLen[z__si] + 1, 'algt', 0);
                its_InsArg[z__si] = mSL_Dyn_Alloc(its_InsALen[z__si] + 1, 'alga', 0);
                its_InsNam[z__si] = mSL_Dyn_Alloc(3 * its_InsNCnt[z__si] + 1, 'algn', 0);
                ((its_InsTpl[z__si] > BASE_MEMORY) && (its_InsArg[z__si] > BASE_MEMORY) && (its_InsNam[z__si] > BASE_MEMORY)) ? (
                    ldtotal += load_mem(0, its_InsTpl[z__si], its_InsTLen[z__si]);
                    ldtotal += load_mem(0, its_InsArg[z__si], its_InsALen[z__si]);
                    ldtotal += load_mem(0, its_InsNam[z__si], 3 * its_InsNCnt[z__si]);
                ) : (
                    its_Al_InsDrop(z__si);
                    ldok = 0; lderr = 172; // no memory for the instance
                );
            ) : (
                ldok = 0; lderr = 173; // bad instance number
            );
        ) :
        (savtmp[0] === 'lfil') ? (
            // the file of a line (the lines are saved without their samples : "Reload" in the file pad of the line)
            ((savtmp[1] >= 0) && (savtmp[1] < LN_CNT)) ? file_string(0, its_LnFile[savtmp[1]]) : file_string(0, #tnam_skip);
        ) :
        (savtmp[0] === 'tnam') ? (
            ldtnam = savtmp[1]; // alternate tabs names (see "Rename tab...")
            z__si = 0; loop(savtmp[1],
                (z__si < dcbTabsCount) ? file_string(0, altTabsNames[z__si]) : file_string(0, #tnam_skip);
                z__si += 1;
            );
        ) :
        (
            zzz_savtmp = savtmp[0];
            zzz_sastwa = 'stwa';
            zzz_sequal = zzz_savtmp == zzz_sastwa;
            ldok = 0;
            lderr = 150;
        );

    );
    (
        // load is ok
        str_mess = str_mess_slot(); // a string in [16 .. 32]
        sprintf(str_mess, "Load (%d / %d), %d items, %d tab names, studio %d.", ldok, lderr, lditmc, ldtnam, ldstud);
    );

    (lderr === 0) ? (
        perform_loading = 1;
        handling_load = 1;
    ) : (
        // failed : the blocks already read are freed, the current structures are kept
        its_Load_Drop();
        handling_load = 0;
    );


) : (

    //  ===SAVE===

    doingSave = 1;
    svitmc = 0;
    sverr = 0;
    svtotal = 0;
    build_savarea();
    siz1 = save_mem(0, savarea, SVASIZ);
    svtotal += siz1;
    // Save the alternate tabs names (see "Rename tab...") : first, before the blocks
    savtmp[0] = 'tnam'; savtmp[1] = dcbTabsCount; savtmp[2] = savtmp[3] = 0;
    svtotal += save_mem(0, savtmp, TMPSIZ);
    z__si = 0; loop(dcbTabsCount, file_string(0, altTabsNames[z__si]); z__si += 1;);
    // Save the studio : tabs config (Pr7_* : panes count and widths, live display) and modules of each pane
    savtmp[0] = 'stud'; savtmp[1] = 128; savtmp[2] = dcbBSize; savtmp[3] = 0;
    svtotal += save_mem(0, savtmp, TMPSIZ);
    svtotal += save_mem(0, serialBlock, 128);
    svtotal += save_mem(0, dcbBlocksAll, dcbBSize);
    // Save the display blocks of the modules (reader, line, writer, effect shown in "Reader A", ...)
    savtmp[0] = 'disp'; savtmp[1] = DispStructsSize; savtmp[2] = savtmp[3] = 0;
    svtotal += save_mem(0, savtmp, TMPSIZ);
    svtotal += save_mem(0, ReadersStructA, DispStructsSize);
    // Save the templates and the instances of algorithms
    z__si = 0; loop(its_AlgMx,
        ((its_AlgSym[z__si] !== 0) && (its_AlgBlk[z__si] > BASE_MEMORY)) ? (
            savtmp[0] = 'algt'; savtmp[1] = its_AlgSym[z__si]; savtmp[2] = its_AlgLen[z__si]; savtmp[3] = 0;
