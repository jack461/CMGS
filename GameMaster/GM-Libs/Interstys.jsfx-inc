            w = max(1, min(128, floor(b[its_Efx_CCnt])));
            its_Pch_Use(b[its_Efx_OutK], b[its_Efx_OutOff],
                its_Out_Cell(b[its_Efx_OutK], b[its_Efx_OutOff], w, CblFxStart[i], CblFxWidth[i]), w, 1, "Effect", i, "output");
            n = 0; p = b + its_Efx_Src1; loop(its_Fx_NSrc(ty),
                (p[0] !== 0) ? its_Pch_Use(p[0], p[its_Efx_Off1 - its_Efx_Src1], its_Src_Cell(p[0], p[its_Efx_Off1 - its_Efx_Src1], w), w, 0,
