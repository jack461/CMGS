function its_Sat_Adaa(u, s, md, n, fx, fr)
local (u0, f0, f1, d)
(
    u0 = s[11];
    f0 = fr ? s[12] : its_Sat_Prim(u0, md, n, fx);
    f1 = its_Sat_Prim(u, md, n, fx);
    s[11] = u; s[12] = f1;
    d = u - u0;
    (abs(d) > its_SatAdEps) ? (f1 - f0) / d : its_Sat_Shape(0.5 * (u + u0), md, n, fx);
);

// free the work areas of the effect "fx" (deleted)
function its_Fx_WorkFree(fx)
(
    (fx[its_Efx_Work] > BASE_MEMORY) ? mSL_Dyn_Free(fx[its_Efx_Work]);
    (fx[its_Efx_WkNew] > BASE_MEMORY) ? mSL_Dyn_Free(fx[its_Efx_WkNew]);
    (fx[its_Efx_WkOld] > BASE_MEMORY) ? mSL_Dyn_Free(fx[its_Efx_WkOld]);
    fx[its_Efx_Work] = fx[its_Efx_WkNew] = fx[its_Efx_WkOld] = 0;
);

/*
    the work areas of the effects, put in place by @block between two audio blocks : all the @sample of an audio block
    see the same area (prepared by its_Patch_Update in @gfx, which frees the old one at its next frame)
*/
function its_Fx_WorkSwitch()
local (i, b, wn)
(
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        ((b > BASE_MEMORY) && ((wn = b[its_Efx_WkNew]) !== 0)) ? (
            b[its_Efx_WkOld] = b[its_Efx_Work];
            b[its_Efx_Work] = max(0, wn);
            b[its_Efx_WkNew] = 0;
        );
        i += 1;
    );
);

// the modes of a reader that read a line by themselves (not a delay, which follows its writer) : Read, Stretch, Brage, Grains
function its_Rd_Lined(md)
(
    (md === its_RdrMode_Read) || (md === its_RdrMode_Stretch) || (md === its_RdrMode_Brage) || (md === its_RdrMode_Grains);
);

// the modes made of blocks joined by overlap (SOLA, see exec_stretch) : Stretch, Brage
function its_Rd_Blocks(md)
(
    (md === its_RdrMode_Stretch) || (md === its_RdrMode_Brage);
);

// the modes that draw their reads at random in the loop (no read position of their own) : Brage (segments), Grains
function its_Rd_Rand(md)
(
    (md === its_RdrMode_Brage) || (md === its_RdrMode_Grains);
);

// the modes that have settings in the lines 4 (and 5) of the pad : Stretch, Brage, Grains (see its_RdSt_Field)
function its_Rd_Sets(md)
(
    its_Rd_Blocks(md) || (md === its_RdrMode_Grains);
);

// the direction of the progression of the reader "r" in its line : its stretch in mode Stretch (the speed is then the
// read rate of the blocks), else its speed
function its_Rd_Dir(r)
(
    (r[its_Rdr_Mode] === its_RdrMode_Stretch) ? r[its_Rdr_Stretch] : r[its_Rdr_Speed];
);

// the coarse step of the search of the correlation (samples of the line) for "fl" samples of the line per second : about
// 12 kHz (4 at 48 kHz)
function its_St_Step(fl)
(
    max(1, floor(fl / 12000 + 0.5));
);

// the size of the work area of the reader "r" (0 : none, not in mode Stretch or Brage) : T and D (the window), X (the
// search, both ways, and the window read at the highest rate : beyond, the window is shorter, see its_St_Next), every
// coarse step of the samples of its line
function its_Rd_WorkSize(r)
local (fl)
(
    its_Rd_Blocks(r[its_Rdr_Mode]) ? (
        fl = srate * max(0.01, min(16, r[its_Rdr_AdjInc])); // the samples of the line per second
        its_RdW_Hdr + 2 * ceil(its_RdW_LcMax * srate)
            + ceil((2 * its_RdW_KMax + its_RdW_LcMax * its_RdW_RhoMax) * fl / its_St_Step(fl)) + 16;
    ) :
    (r[its_Rdr_Mode] === its_RdrMode_Grains) ? its_RdGr_WkSz : 0;
);

// free the work areas of the reader "r" (deleted)
function its_Rd_WorkFree(r)
(
    (r[its_Rdr_Work] > BASE_MEMORY) ? mSL_Dyn_Free(r[its_Rdr_Work]);
    (r[its_Rdr_WkNew] > BASE_MEMORY) ? mSL_Dyn_Free(r[its_Rdr_WkNew]);
    (r[its_Rdr_WkOld] > BASE_MEMORY) ? mSL_Dyn_Free(r[its_Rdr_WkOld]);
    r[its_Rdr_Work] = r[its_Rdr_WkNew] = r[its_Rdr_WkOld] = 0;
);

// the work areas of the readers, put in place by @block between two audio blocks (as its_Fx_WorkSwitch)
function its_Rd_WorkSwitch()
local (i, b, wn)
(
    i = 0; loop(RD_CNT,
        b = Readers_set[i];
        ((b > BASE_MEMORY) && ((wn = b[its_Rdr_WkNew]) !== 0)) ? (
            b[its_Rdr_WkOld] = b[its_Rdr_Work];
            b[its_Rdr_Work] = max(0, wn);
            b[its_Rdr_WkNew] = 0;
            b[its_Rdr_StCPh] = 0; // (a correlation being computed used the old area : the next block has no lag)
        );
        i += 1;
    );
);

// copy the reader block "src" into "dst" (copy, paste) : "dst" keeps its own work areas, a stretch starts again
function its_Rd_Copy(dst, src)
local (w0, w1, w2)
(
    w0 = dst[its_Rdr_Work]; w1 = dst[its_Rdr_WkNew]; w2 = dst[its_Rdr_WkOld];
    memcpy(dst, src, its_Rdr_BlkSize);
    dst[its_Rdr_Work] = w0; dst[its_Rdr_WkNew] = w1; dst[its_Rdr_WkOld] = w2;
    dst[its_Rdr_StJ] = -1;
