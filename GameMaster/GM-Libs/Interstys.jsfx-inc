//  Interstys modular fractional delay - V0.2.1



@init

ext_noinit = 1;
gfx_ext_retina = 1;
<? no_init = 1; ?>

version = 0x000103;

tStart = tUnix = start_time = time();

SL_COUNT= <? printf("%d", slnum); ?>; // nombre de sliders utilisés
CH_NB = <? printf("%d", CH_NB); ?>; // nombre de canaux gérés [typiquement 128]
RD_CNT = <? printf("%d", RD_CNT); ?>; // nombre de lecteurs
WR_CNT = <? printf("%d", WR_CNT); ?>; // nombre de writers
NB_WRK = <? printf("%d", NB_WRK); ?>; // nombre de mots de travail
// Buffers audio
LN_CNT = <? printf("%d", LN_CNT); ?>; // nombre de buffers
FX_CNT = <? printf("%d", FX_CNT); ?>; // nombre d'effets
SMPL_SIZE = <? printf("%d", SMPL_SIZE); ?>; // nombre total de cellules
TEMP_SIZE = <? printf("%d", TEMP_SIZE); ?>; // nombre total de cellules
NB_AUX = <? printf("%d", NB_AUX); ?>; // nombre de cellules auxiliaires / temporaires
SPL_P = <? printf("%d", SPL_P); ?>; // position 1 pour les samples d'entrée [1 .. 128]
OUT_P = <? printf("%d", OUT_P); ?>; // position 2 pour les copies des samples d'entrée
SPDMAX = <? printf("%d", SPDMAX); ?>; // max speed.
BF_BASE = srate; // 1 second

lastslider = <? printf("%d", slnum); ?>;

// Paramètres de la table SInc
SINC_RADIUS = 32; // Nombre d'échantillons utilisés à gauche et à droite (Qualité)
B_FADESIZ = 160; // samples for the borders fade
SINC_TABLE_SIZE = 8192; // Résolution de la table "sinc"
SINC_FACT = SINC_TABLE_SIZE / (2 * SINC_RADIUS);
BF_LIM = SINC_RADIUS + B_FADESIZ + 4; // taille bords buffer
// SECURE_BL = 192365423/128; // "the unused value"
SECURE_BL = '_OK_';
LOW_VALUE = -2147483648;
MIN_VALUE = -1073741824;

// Paramètres de la table SInus
SINUS_TABLE_SIZE = 8192;

// BLOCK_CHECK = 192562217/128; // block fast check oK
BLOCK_CHECK = '_BC_';
// Frequently used names

XDcount = 1; // 10;
cmdCap = 0x4 | 0x20; // On Mac: allow "cmd" or "ctrl" as "alternate" modifiers
altCap = 0x10 ; // on Mac : "alt"
shfCap = 0x08; // shift


/* Paramètres
p_playVol
p_playSpeed
p_lineSize (s.)
p_playPos  (s.) [0 .. p_lineSize]
p_play_S_Low (s.) [0 .. p_lineSize]
p_play_S_High (s.) [0 .. p_lineSize]
p_play_S_Len (s.) [0 .. p_lineSize]
p_play_S_Pos (s.) [0 .. p_lineSize]
p_play_XFade
*/


// STRUCTURES
//==========================================================
// LINE - KW_lcbl - Lines_Set[LN_CNT]
idx = 0;
//  0
its_Lin_Unuz1 = idx; idx += 1; // Sécurité : mot inutilisé
its_Lin_Ltype= idx; idx += 1; // Line type
its_Lin_Status = idx; idx += 1; //  Etat du buffer
its_Lin_Flgs = idx; idx += 1; //  Flags du buffer
its_Lin_Numb = idx; idx += 1; //  Buffer number (in line set)
its_Lin_ChCnt = idx; idx += 1; //  Nombre de canaux
its_Lin_SmplCnt = idx; idx += 1; //  Nombre de samples par canal
its_Lin_SmplCntSec = idx; idx += 1; // Duration in seconds
//  8
its_Lin_RecFreq = idx; idx += 1; //  Record frequency
its_Lin_Start = idx; idx += 1; // 1er sample dans chaque buffer
its_Lin_Last = idx; idx += 1; // après le dernier sample disponible
its_Lin_Used = idx; idx += 1; // après le dernier sample utilisé
its_Lin_TStmp = idx; idx += 1; // creation time stamp
its_Lin_ActBSize = idx; idx += 1; // actual size needed for buffers
its_Lin_RdOffset = idx; idx += 1; // line read offset
its_Lin_Tmp1 = idx; idx += 1; // work for load/save
// 16
its_Lin_Tmp2 = idx; idx += 1; // work for load/save
its_Lin_Check = idx; idx += 1; // quick check
its_Lin_BF1ST = idx; idx += 1; // Pointeur sur le premier buffer
// Il peut y avoir jusqu'à 128 buffers, 1 pour chaque canal
idx += 127;
its_Lin_Unuz2 = idx; idx += 1; // Sécurité : mot inutilisé
its_Lin_BlkSize = (idx | 3) + 1; // round to a multiple of 4
// Status
its_LinStat_Undef = 0;
its_LinStat_Ready = 1;
its_LinStat_Used = 2;
// Actions
its_LinAct_Clear = 1;
its_LinAct_Create = 2;
its_LinAct_Delete = 4;


//==========================================================
// READER - KW_read - Readers_set[RD_CNT]
its_RdrMaxMulti = 8; // nombre max de lecteurs multi simultanés
idx = 0;
//  0
its_Rdr_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Rdr_Status = idx; idx += 1; //  Etat affiché du reader
its_Rdr_Flgs = idx; idx += 1; //  Flags du reader
its_Rdr_Mode = idx; idx += 1; //  Mode du reader
its_Rdr_Number = idx; idx += 1; //  Numéro interne du reader
its_Rdr_LoopType = idx; idx += 1; //  Type of looping
its_Rdr_InAction = idx; idx += 1; //  internal action
its_Rdr_Intern = idx; idx += 1; //  Etat interne du reader
//  8
its_Rdr_LineNb = idx; idx += 1; //  Source du reader : numéro du buffer   -1/ [0 ... N-1]
its_Rdr_Lcbl = idx; idx += 1; // pointeur sur le bloc de controle du (des) buffer(s)
its_Rdr_ChNbr = idx; idx += 1; // nombre de canaux dans le lcbl
its_Rdr_SmplCnt = idx; idx += 1; // taille du buffer
its_Rdr_LinSfreq = idx; idx += 1; // sample freq. of the reader
its_Rdr_SmplCntSec = idx; idx += 1; // taille du buffer en secondes
its_Rdr_Start = idx; idx += 1; //  pointeur vers le premier mot du tampon
its_Rdr_Low = idx; idx += 1; //  pointeur vers le premier mot du tampon
//  0x10 - 16
its_Rdr_Relpos = idx; idx += 1; //  Position [0 ... 100] de la tête de lecture
its_Rdr_Last = idx; idx += 1; //  pointeur vers le dernier mot du tampon
its_Rdr_High = idx; idx += 1; //  pointeur vers le dernier mot du tampon
its_Rdr_RCell = idx; idx += 1; // Cellule de sortie du lecteur
its_Rdr_RCellT = idx; idx += 1; // Cellule de sortie du lecteur (type)
its_Rdr_RCellN = idx; idx += 1; // Cellule de sortie du lecteur (num)
its_Rdr_Speed = idx; idx += 1; //  Vitesse de lecture
its_Rdr_SpeedPrev = idx; idx += 1; //  Vitesse de lecture
//  0x18 - 24
its_Rdr_StFlgs = idx; idx += 1; //  Status flags
its_Rdr_MultiCnt = idx; idx += 1; //  nombre de lecteurs multi
its_Rdr_Bf1stChan = idx; idx += 1; // Premier canal utilisé dans le buffer
its_Rdr_BfChanUsed = idx; idx += 1; // nombre de canaux utilisés dans le buffer
its_Rdr_WrSrc = idx; idx += 1; // Writer source number
its_Rdr_WrBPtr = idx; idx += 1; // Writer source address
its_Rdr_WOffset = idx; idx += 1; // Read Offset in seconds
its_Rdr_WOffsetSmp = idx; idx += 1; // Read Offset in samples
// 0x20 - 32
its_Rdr_IntPt = idx; idx += 1; // pointeur interne
its_Rdr_OutVoldB = idx; idx += 1; // output volume (db)
its_Rdr_OutVol = idx; idx += 1; // output volume
its_Rdr_AuxVol = idx; idx += 1; // auxiliary volume
its_Rdr_RegSize = idx; idx += 1; // Taille région auxiliaire (samples)
its_Rdr_RegSizeSec = idx; idx += 1; // Taille région auxiliaire (secondes)
its_Rdr_RegSizeSecPrv = idx; idx += 1; // Ancienne taille région auxiliaire (secondes)
its_Rdr_RegPos = idx; idx += 1; // Position de la région auxiliaire (samples)
//  0x28 - 40
its_Rdr_RegPosSec = idx; idx += 1; // Position de la région auxiliaire (secondes)
its_Rdr_RegPosSecPrv = idx; idx += 1; // Ancienne Position de la région auxiliaire
its_Rdr_XFade_mSec = idx; idx += 1; // Cross Fade in mili seconds
its_Rdr_XFade_mSecSet = idx; idx += 1; // Cross Fade in mili seconds as explicitely set
its_Rdr_XFade_mSecPrv = idx; idx += 1; // Cross Fade in mili seconds, previous value
its_Rdr_LowPosSec = idx; idx += 1; // A1 pos in seconds
its_Rdr_LowPosSecPrv = idx; idx += 1; // A1 previous pos in seconds
its_Rdr_HighPosSec = idx; idx += 1; // A2 pos in seconds
//  0x30 - 48
its_Rdr_HighPosSecPrv = idx; idx += 1; // A2 previous pos in seconds
its_Rdr_RegSOut = idx; idx += 1; // Start extérieur reg. auxiliaire in Buffer
its_Rdr_RegSIn= idx; idx += 1; // Start intérieur reg. auxiliaire in Buffer
its_Rdr_RegEOut = idx; idx += 1; // End extérieur reg. auxiliaire in Buffer
its_Rdr_RegEIn = idx; idx += 1; // End intérieur reg. auxiliaire in Buffer
its_Rdr_Check = idx; idx += 1; // quick check
its_Rdr_AmpModPtr = idx; idx += 1; // pt. sur modulation amplitude
its_Rdr_FrqModPtr = idx; idx += 1; // pt. sur modulation frequence
//  0x38 - 56
its_Rdr_NxtPosSec = idx; idx += 1; // next play position
its_Rdr_BFadeCntNxt = idx; idx += 1; // next B Fade counter
its_Rdr_Error = idx; idx += 1; // last error encountered
its_Rdr_Tmp0 = idx; idx += 1; // temp 0
its_Rdr_Tmp1 = idx; idx += 1; // temp 1
its_Rdr_Tmp2 = idx; idx += 1; // temp 2
its_Rdr_Tmp3 = idx; idx += 1; // temp 3
its_Rdr_Tmp4 = idx; idx += 1; // temp 4
//  0x40 - 64
its_Rdr_Tmp5 = idx; idx += 1; // temp 5
its_Rdr_Tmp6 = idx; idx += 1; // temp 6
its_Rdr_Tmp7 = idx; idx += 1; // temp 7
its_Rdr_Tmp8 = idx; idx += 1; // temp 8
its_Rdr_Tmp9 = idx; idx += 1; // temp 9
its_Rdr_TmpA = idx; idx += 1; // temp A
its_Rdr_TmpB = idx; idx += 1; // temp B
its_Rdr_TmpC = idx; idx += 1; // temp C
//  0x40 - 72
its_Rdr_Abspos = idx; idx += its_RdrMaxMulti; //  Position [its_Rdr_Start ... its_Rdr_Last - 1] de lecture en samples
its_Rdr_AbsInc = idx; idx += its_RdrMaxMulti; //  Incrément de la position
its_Rdr_AdjInc = idx; idx += its_RdrMaxMulti; //  Ajustement de la position
its_Rdr_AbsAuxpos = idx; idx += its_RdrMaxMulti; //  Position de lecture auxiliaire
its_Rdr_XFadeCnt = idx; idx += its_RdrMaxMulti; // X Fade counter
its_Rdr_XFadeIdxPos = idx; idx += its_RdrMaxMulti; // X Fade position
its_Rdr_XFadeIncr = idx; idx += its_RdrMaxMulti; // X Fade increment
its_Rdr_XFadeCntNxt = idx; idx += its_RdrMaxMulti; // next X Fade counter
//
its_Rdr_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Rdr_BlkSize = (idx | 3) + 1; // round to a multiple of 4

its_RdrFlg_init = 0x0001; //  si lecteur initialisé
its_RdrFlg_actif = 0x0002; // si lecteur en cours de lecture
its_RdrFlg_hasline = 0x0002; // si lecteur a un buffer
its_RdrFlg_mute = 0x0010; // si lecteur mute
its_RdrFlg_solo = 0x0100; // si lecteur solo
its_RdrFlg_Mod = 0x1000; // si lecteur modifié interactivement
// Modes
its_RdrMode_Read = 0;
its_RdrMode_Folwr = 1;
// Etats
its_RdrStat_UnDef = 0;
its_RdrStat_Created = 1;
its_RdrStat_Ready = 2;
its_RdrStat_Paused = 3;
its_RdrStat_Reading = 4;
its_RdrStat_stopping = 12;
its_RdrStat_starting = 13;
// Actions
its_RdrAct_Copy = 1;
its_RdrAct_Paste = 2;
its_RdrAct_Clear = 3;
its_RdrAct_Rewind = 4;
its_RdrAct_Speed1 = 5;
its_RdrAct_Create = 6;
its_RdrAct_Activate = 7;
its_RdrAct_Show = 8;
its_RdrAct_Test = 9;
its_RdrAct_Delete = 10;

// Etats communs
its_RdrSolos = 0; // count of readers in solo mode
its_RdrErrCr = 0; // last create error
its_RdrErrXe = 0; // last exec error
its_RdrLoopTypeCnt = 6;
its_RdrLoopTypeOnce = 0;
its_RdrLoopTypeRepeat = 1;
its_RdrLoopTypeCatch = 2;
its_RdrLoopTypeLoop = 3;
its_RdrLoopTypeExit = 4;
its_RdrLoopTypeStop = 5;


//==========================================================
// WRITER - KW_writ - Writers_set[WR_CNT]
idx = 0;
// 0
its_Wrt_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Wrt_BLType = idx; idx += 1; //  Type du bloc
its_Wrt_Number = idx; idx += 1; //  Numéro du writer
its_Wrt_Status = idx; idx += 1; //  Etat du writer
its_Wrt_InAction = idx; idx += 1; //  internal action
its_Wrt_Flgs = idx; idx += 1; //  Flags du writer
its_Wrt_Mode = idx; idx += 1; //  Mode de fonctionnement du writer
its_Wrt_Intern = idx; idx += 1; //  Etat interne du writer
its_Wrt_LineNb = idx; idx += 1; // numéro du buffer -1/ [0 ... N-1]
its_Wrt_Lcbl = idx; idx += 1; // pointeur sur le bloc de controle du (des) buffer(s)
// 10
its_Wrt_ChNbr = idx; idx += 1; // nombre de canaux dans le lcbl
its_Wrt_SmplCnt = idx; idx += 1; //  Taille de la zone utile
its_Wrt_Start = idx; idx += 1; //  pointeur vers le premier mot du tampon
its_Wrt_Relpos = idx; idx += 1; //  Position [0 ... 100] de la tête d'écriture
its_Wrt_Last = idx; idx += 1; //  pointeur vers le dernier mot du tampon
its_Wrt_Cell = idx; idx += 1; // numéro du (premier) mot écrit par le writer
its_Wrt_Abspos = idx; idx += 1; //  Position [0 ... size - 1] de la tête d'écriture
its_Wrt_Buff_1 = idx; idx += 1; // pointeur sur le 1er buffer
its_Wrt_Ovrdb = idx; idx += 1; // recycling
its_Wrt_Check = idx; idx += 1; // quick check
// 20
its_Wrt_InGaindB = idx; idx += 1; // input gain (dB)
its_Wrt_InGain = idx; idx += 1; // input gain (dB)
its_Wrt_Error = idx; idx += 1; // last error
its_Wrt_Tmp0 = idx; idx += 1; // temp 0
its_Wrt_Tmp1 = idx; idx += 1; // temp 1
its_Wrt_Tmp2 = idx; idx += 1; // temp 2
its_Wrt_Tmp3 = idx; idx += 1; // temp 3
its_Wrt_Tmp4 = idx; idx += 1; // temp 4
its_Wrt_Tmp5 = idx; idx += 1; // temp 5
its_Wrt_Tmp6 = idx; idx += 1; // temp 6
// 30
its_Wrt_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Wrt_BlkSize = (idx | 3) + 1; // round to a multiple of 4

its_WrtFlg_init = 0x0001; //  si writer initialisé
// Etats
its_WrtStat_UnDef = 0;
its_WrtStat_Created = 1;
its_WrtStat_Ready = 2;
its_WrtStat_Paused = 3;
its_WrtStat_Writing = 4;
// Actions
its_WrtAct_Copy = 1;
its_WrtAct_Paste = 2;
its_WrtAct_Clear = 3;
its_WrtAct_Rewind = 4;
its_WrtAct_Reset = 5;
its_WrtAct_Create = 6;
its_WrtAct_Activate = 7;
its_WrtAct_Show = 8;
its_WrtAct_Delete = 10;

// Etats communs
its_WrtErrXe = 0; // last exec error


//==========================================================
// EFFECT - KW_effx - Effects_set[FX_CNT]
idx = 0;
//   0
its_Efx_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Efx_Status = idx; idx += 1; //  Etat de l'effet
its_Efx_Flgs = idx; idx += 1; //  Flags de l'effet
its_Efx_Type = idx; idx += 1; //  Type de l'effet
its_Efx_Numb = idx; idx += 1; //  Numéro de l'effet
its_Efx_Phase = idx; idx += 1; //  Phase de l'effet
its_Efx_CCnt = idx; idx += 1; //  Channel count
its_Efx_Out = idx; idx += 1; //  Sortie de l'effet
its_Efx_Src1 = idx; idx += 1; //  Source n°1
its_Efx_VoldB1 = idx; idx += 1; //  Volume n°1 (dB)
//   10
its_Efx_Vol1 = idx; idx += 1; //  Volume n°1
its_Efx_Dst1 = idx; idx += 1; //  Destination n°1
its_Efx_Src2 = idx; idx += 1; //  Source n°2
its_Efx_VoldB2 = idx; idx += 1; //  Volume n°2 (dB)
its_Efx_Vol2 = idx; idx += 1; //  Volume n°2
its_Efx_Dst2 = idx; idx += 1; //  Destination n°2
its_Efx_Src3 = idx; idx += 1; //  Source n°3
its_Efx_VoldB3 = idx; idx += 1; //  Volume n°3 (dB)
its_Efx_Vol3 = idx; idx += 1; //  Volume n°3
its_Efx_Dst3 = idx; idx += 1; //  Destination n°3
//   20
its_Efx_Src4 = idx; idx += 1; //  Source n°4
its_Efx_VoldB4 = idx; idx += 1; //  Volume n°4 (dB)
its_Efx_Vol4 = idx; idx += 1; //  Volume n°4
its_Efx_Dst4 = idx; idx += 1; //  Destination n°4
