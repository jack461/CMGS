    );
    u;
);

/*
    Phaser : per channel of its source, a chain of allpass stages (Par10, 1 ... its_PhMaxS ; its_Ph_Chain) whose frequency is
    swept : the frequency (Par1, modulated in octaves) times 2^(sweep / 2 x the shape of the phase) (the sweep : Par3,
    octaves ; the shape : Par8) ; the stages spread by the spacing (MxX, octaves from a stage to the next, centered) ; the
    phases turn at the rate (MxX + 1, modulated in octaves ; jitter MxX + 4 : x [1 - j, 1 + j] per channel), shifted by the
    spread (Par5) from a channel to the next ; the input of the chain : the input plus the feedback (Par7, modulated) of the
    output of the chain at the previous sample (cross, Par12 : the share of the next channel, < 0 : of the previous one),
    through a saturation (its_Mx_Sat) when the feedback reaches 1 ; the output : (1 - |mix|) x + mix (the chain), mix Par4 ;
    the modes : Classic (one pole stages), Resonant (two pole stages, the Q : Par11), Barber up / down (two chains of one pole
    stages half a period apart, each one in a window 0.5 - 0.5 cos of its phase, their frequency ramps up / down over the
    sweep : an endless sweep) ; the frequency and the sweep glide (MxX + 3)
    its work area : the header (its_FxW_Hdr ; its_FxW_Md : 1 when it is in use), then its_PhH words (0 the frequency and 1 the
    sweep, gliding (-1 : to set), 2 the glide and 3 its coefficient, 4 the seed and 5 the jitter of the factors computed, 6 the
    stages and 7 the spacing of the factors of the stages, 8 the mode of the states), the factors of the stages (its_PhMaxS),
    its_PhCW words per channel (0 the output of its chain at the previous sample, 1 its phase, 2 the factor of its rate, 3 4
    its random values (Random : from 3 to 4 ; Hold : 4), 5 the value held, 6 its last phase with the offset, 7 the output of
    the current sample), then the states (4 x its_PhMaxS per channel : the chain A, then the chain B of the barber modes)
*/
function exec_phaser(fx, ccnt, out)
local (wk, hd, sf, cw, st, src, g, mp, md, sh, ns, bm, rs, f0, sw, rt, fb, mix, spr, cr, jt, gk, ls, ct, kq, c, p, s, k, x, u, v,
       y, ph, pe, pb, wa, dr)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
        hd = wk + its_FxW_Hdr; sf = hd + its_PhH; cw = sf + its_PhMaxS; st = cw + its_PhCW * ccnt;
        src = smpl_tab + fx[its_Efx_Cell1]; g = fx[its_Efx_Vol1];
        mp = fx + its_Efx_Mod1;
        md = fx[its_Efx_Par1 + 1]; sh = fx[its_Efx_Par1 + 7];
        bm = (md === its_PhBarbUp) || (md === its_PhBarbDown);
        rs = (md === its_PhReson);
        ns = max(1, min(its_PhMaxS, floor(fx[its_Efx_Par1 + 9])));
        // a new area, after a bypass, after a value not finite : the states from zero
        (wk[its_FxW_Md] !== 1) ? (
            memset(hd, 0, its_PhH + its_PhMaxS + (its_PhCW + 4 * its_PhMaxS) * ccnt);
            hd[0] = hd[2] = hd[4] = hd[6] = hd[8] = -1; // (the frequency, the glide, the factors, the stages, the mode to compute)
            p = cw; loop(ccnt, p[3] = rand(2) - 1; p[4] = p[5] = rand(2) - 1; p += its_PhCW;);
            wk[its_FxW_Md] = 1;
        );
        // another mode : another use of the states, from zero
        (md !== hd[8]) ? (
            hd[8] = md;
            memset(st, 0, 4 * its_PhMaxS * ccnt);
            p = cw; loop(ccnt, p[0] = p[7] = 0; p += its_PhCW;);
        );
        // the factors of the frequencies of the stages (the spacing, centered)
        ((ns !== hd[6]) || (fx[its_Efx_MxX] !== hd[7])) ? (
            hd[6] = ns; hd[7] = fx[its_Efx_MxX];
            k = 0; loop(ns, sf[k] = 2 ^ (hd[7] * (k - 0.5 * (ns - 1))); k += 1;);
        );
        // the factors of the rates of the channels, from the seed (jitter)
        jt = max(0, min(1, fx[its_Efx_MxX + 4]));
        ((hd[4] !== fx[its_Efx_Par1 + 8]) || (hd[5] !== jt)) ? (
            hd[4] = fx[its_Efx_Par1 + 8]; hd[5] = jt;
            p = cw; k = 0;
            loop(ccnt,
                u = sin(12.9898 * (k + 1) + 78.233 * (hd[4] + 1)) * 43758.5453; u -= floor(u);
                p[2] = 1 + jt * (2 * u - 1);
