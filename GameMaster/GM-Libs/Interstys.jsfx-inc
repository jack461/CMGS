bplMenuNames[idx += 1] = "Update HP conf";
bplHPConf = idx+1;
bplMenuNames[idx += 1] = ">Layout change";
bplCopy = idx + 1;
bplMenuNames[idx += 1] = "copy A => E"; bplMenuNames[idx += 1] = "copy A => F";
bplMenuNames[idx += 1] = "copy A => G"; bplMenuNames[idx += 1] = "copy A => H";
bplMenuNames[idx += 1] = "copy B => E"; bplMenuNames[idx += 1] = "copy B => F";
bplMenuNames[idx += 1] = "copy B => G"; bplMenuNames[idx += 1] = "copy B => H";
bplMenuNames[idx += 1] = "copy C => E"; bplMenuNames[idx += 1] = "copy C => F";
bplMenuNames[idx += 1] = "copy C => G"; bplMenuNames[idx += 1] = "copy C => H";
bplMenuNames[idx += 1] = "copy D => E"; bplMenuNames[idx += 1] = "copy D => F";
bplMenuNames[idx += 1] = "copy D => G"; bplMenuNames[idx += 1] = "copy D => H";
//
bplMenuNames[idx += 1] = "copy E => A"; bplMenuNames[idx += 1] = "copy E => B";
bplMenuNames[idx += 1] = "copy E => C"; bplMenuNames[idx += 1] = "copy E => D";
bplMenuNames[idx += 1] = "copy F => A"; bplMenuNames[idx += 1] = "copy F => B";
bplMenuNames[idx += 1] = "copy F => C"; bplMenuNames[idx += 1] = "copy F => D";
bplMenuNames[idx += 1] = "copy G => A"; bplMenuNames[idx += 1] = "copy G => B";
bplMenuNames[idx += 1] = "copy G => C"; bplMenuNames[idx += 1] = "copy G => D";
bplMenuNames[idx += 1] = "copy H => A"; bplMenuNames[idx += 1] = "copy H => B";
bplMenuNames[idx += 1] = "copy H => C"; bplMenuNames[idx += 1] = "<copy H => D";
bplCopyLast = idx;

// bplMenuNames[idx += 1] = "";

bplMenuNames[idx += 1] = ">Controls layout";
bplMenuNames[idx += 1] = "1 column";
bplMenuNames[idx += 1] = "<2 columns";
idx += 1; // Menu item count

// Menus
bplSLMenu = make_jmenu(
            ui_jmenu_typ_action | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "Moves", idx, bplMenuNames);


//=============================== Globals
/*
    The globals of Interstys (the module "Globals", the table block Global ; saved by @serialize, see build_savarea) :
    the track samples its_GlSmpl (0 Merge, 1 Ignore, 2 Pass ; always Merge after a load), the input gain its_GlInGain (dB,
    mode Merge), the output volume its_GlOutVol (dB, modes Merge and Ignore) ; its_Gl_Apply computes the gains of @sample
*/
its_GlSmpl = its_GlInGain = its_GlOutVol = 0;
function its_Gl_Apply()
(
    pgmode = its_GlSmpl;
    vol_inp = (its_GlSmpl === 1) ? 0 : (its_GlSmpl === 2) ? 1 : (its_GlInGain <= -120) ? 0 : 10^(its_GlInGain/20);
    vol_out = (its_GlOutVol <= -120) ? 0 : 10^(its_GlOutVol/20);
);

// the generic sliders Ctl 1 ... NB_GSL shown (flag 1) or hidden (0) in the panel of REAPER (key 'S')
function its_Ctl_Show(flag)
(
    <? i = 0; loop(NB_GSL, printf("slider_show(slCtl%d, flag); ", i+1); ((i % 8) == 7) && (i < NB_GSL-1) ? printf("\n    "); i += 1;); ?>
);

// the value of the generic slider Ctl k + 1, a new value
function its_Ctl_Get(k) ( slider(GSL_FIRST + k); );
function its_Ctl_Set(k, v)
(
    <? i = 0; loop(NB_GSL, printf("(k === %d) ? (slCtl%d = v; slider_automate(slCtl%d);) :\n    ", i, i+1, i+1); i += 1;); ?>0;
);

function delete_all_struct()
local (i)
(
    i = 0; loop(RD_CNT+1, Rd_Delete(i); i+=1;);
    i = 0; loop(WR_CNT+1, Wr_Delete(i); i+=1;);
    i = 0; loop(FX_CNT+1, FX_Delete(i); i+=1;);
    i = 0; loop(LN_CNT+1, Ln_Delete(i); i+=1;);
    memset(StaticWA, 0, StaticWASize);
    updt_tables(StaticWA);
);


function its_actions(act)
local (i, cbl, st)
(
    (act === its_GlAct_StartAll) ? (
        // Start the readers and the writers stopped (Ready) or paused, as their pads do : a reader stopped starts again
        // from its home (Rd_Set_Status), a reader paused goes on
        i = 0; loop(RD_CNT,
            cbl = Readers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_read) && (((st = cbl[its_Rdr_Status]) === its_RdrStat_Ready)
                || (st === its_RdrStat_Paused))) ? Rd_Set_Status(i, its_RdrStat_Reading);
            i += 1;
        );
        i = 0; loop(WR_CNT,
            cbl = Writers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_writ) && (((st = cbl[its_Wrt_Status]) === its_WrtStat_Ready)
                || (st === its_WrtStat_Paused))) ? Wr_Set_Status(i, its_WrtStat_Writing);
            i += 1;
        );
    ) :
    (act === its_GlAct_StopAll) ? (
        // Stop readers
        i = 0; loop(RD_CNT+1,
            cbl = Readers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_read) && (cbl[its_Rdr_Status] > its_RdrStat_Ready)) ? (
                cbl[its_Rdr_Status] = its_RdrStat_Ready;
                its_Run_Check(cbl);
            );
            i+=1;
        );
        // Stop writers
        i = 0; loop(WR_CNT+1,
            cbl = Writers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_writ) && (cbl[its_Wrt_Status] > its_WrtStat_Ready)) ? (
                cbl[its_Wrt_Status] = its_WrtStat_Ready;
                its_Run_Check(cbl);
            );
            i+=1;
        );
    ) :
    (act === its_GlAct_PauseAll) ? (
        // Pause readers
        i = 0; loop(RD_CNT+1,
            cbl = Readers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_read) && (cbl[its_Rdr_Status] > its_RdrStat_Paused)) ? (
                cbl[its_Rdr_Status] = its_RdrStat_Paused;
                its_Run_Check(cbl);
            );
            i+=1;
        );
        // Pause writers
        i = 0; loop(WR_CNT+1,
            cbl = Writers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_writ) && (cbl[its_Wrt_Status] > its_WrtStat_Paused)) ? (
                cbl[its_Wrt_Status] = its_WrtStat_Paused;
                its_Run_Check(cbl);
            );
            i+=1;
        );
    ) :
    (act === its_GlAct_ResumeAll) ? (
        // Resume the paused readers
        i = 0; loop(RD_CNT+1,
            cbl = Readers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_read) && (cbl[its_Rdr_Status] >= its_RdrStat_Paused)) ? (
                cbl[its_Rdr_Status] = its_RdrStat_Reading;
            );
            i+=1;
        );
        // Resume the paused writers
        i = 0; loop(WR_CNT+1,
            cbl = Writers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_writ) && (cbl[its_Wrt_Status] >= its_WrtStat_Paused)) ? (
                cbl[its_Wrt_Status] = its_WrtStat_Writing;
            );
            i+=1;
        );
    ) :
    (act === its_GlAct_RewdAll) ? (
        // Rewind readers
        i = 0; loop(RD_CNT+1,
            cbl = Readers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_read) && (cbl[its_Rdr_Status] >= its_RdrStat_Ready)) ? (
                cbl[its_Rdr_Abspos] = cbl[its_Rdr_Start];
            );
            i+=1;
        );
        // Rewind writers
        i = 0; loop(WR_CNT+1,
            cbl = Writers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_writ) && (cbl[its_Wrt_Status] >= its_WrtStat_Ready)) ? (
                cbl[its_Wrt_Abspos] = cbl[its_Wrt_Start];
            );
            i+=1;
        );
    ) :
    ((act === its_GlAct_MuteAll) || (act === its_GlAct_UnmuteAll)) ? (
        // Mute all the readers ; unmute them all, and no more solo
        i = 0; loop(RD_CNT,
            cbl = Readers_set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_read)) ? (
                (act === its_GlAct_MuteAll) ? (cbl[its_Rdr_StFlgs] |= its_RdrFlg_mute) :
                    (cbl[its_Rdr_StFlgs] -= cbl[its_Rdr_StFlgs] & (its_RdrFlg_mute | its_RdrFlg_solo));
            );
            i += 1;
        );
    ) :
    (act === its_GlAct_ClearAll) ? (
        // Clear all lines
        i = 0; loop(LN_CNT+1,
            cbl = Lines_Set[i];
            ((cbl > BASE_MEMORY) && (cbl[-2] === KW_lcbl)) ? (
                Ln_Clear(i);
            );
            i += 1;
        );
    ) :
    (act === its_GlAct_DelAll) ? (
        delete_all_struct();
        str_mess = "Delete all structures";
    );
    lnupdt = 1;
);


/*
=== PARAMETERS DCL ===
*/
function initAllParameters()
local(ix)
(
    // do some default init. We keep the name uninitialized.
    ix = paramBase;
    loop(paramCount,
        parDcl(ix, #pUndef, #pUndef, 0, "-", "-", 0, 1, 0, 0.1, 0);
        ix += 1;
    );
    paramBlock[paramBase * paramEntSize + pp_Name] = "(unused)"; // this "locks" the first entry of the range
    menu_Param_mSL = 0;
    menu_Param_UBS = 0;
    menu_Param_UBD = 0;
    parDclMode = 0xf;
);

function dclAllParameters()
local (ix, p, pdx, pp, pb, ii, ix, iy, u, w,mi, ma)
(
    paramBlock[paramBase * paramEntSize + pp_Name] = "(unused)"; // this "locks" the first entry of the range
    p = 2; // potentiometer curve for amplitude


    parDcl(p_uix_jtheme, "UI Theme",  "UITheme",   0,      "%d",   "UI Theme: %d", 0, 16, 0, 1, 0);

    parDcl(p_playSpeed, "Play Speed", "PlaySpd", i_UB|i_SP, "%.3f",  "Play Speed: %.3f", -SPDMAX, SPDMAX, 1, 0.001, 0);
    parDcl(p_rdStretch, "Stretch", "RdStrtch", i_UB|i_SP, "%.3f",  "Stretch: %.3f", -SPDMAX, SPDMAX, 1, 0.001, 0);

    parDcl(p_playVol, "Play Volume",  "PlayVol",  i_UB|i_SP, "%.1f dB", "Play Volume: %.1f dB",   -120,   40,    0,  0.1, -2);

    parDcl(p_lineSize, "Line size",  "LineSize",  i_UB|i_SP, "%.3f s", "Line Size: %.3f s",   1,   3600,    1,  0.001, 3);

    parDcl(p_playPos, "Play position",  "PlayPos",  i_UB|i_SP, "%.3f s", "Play position: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Low, "Loop Low Lim.",  "LoopLLim",  i_UB|i_SP, "%.3f s", "Loop Low Lim.: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_High, "Loop High Lim.",  "LoopHLim",  i_UB|i_SP, "%.3f s", "Loop High Lim.: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Pos, "Loop position",  "LoopRPos",  i_UB|i_SP, "%.3f s", "Loop position: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Len, "Loop Length",  "LoopRLen",  i_UB|i_SP, "%.5f s", "Loop Length: %.5f s",   0.00001,   3600,    0,  0.00001, 6);
    parDcl(p_play_XFade, "Cross Fade", "CrssFade", i_UB|i_SP, "%.2f ms", "Cross Fade : %.2f ms", 0.01, 20000, 10, 0.01, 6);
    parDcl(p_play_Zoom, "Zoom", "WaveZoom", i_UB|i_SP, "%.0f", "Zoom : %.0f", 1, 100, 1, 1, 0);
    // strong exponential curve (slope 8) and 10 µs step : very fine choice of the small offsets
    parDcl(p_rdOffset, "Delay Offset", "RdOffset", i_UB|i_SP, "%.5f s", "Delay Offset: %.5f s", 0, 3600, 1, 0.00001, 8);
    parDcl(p_wrGain, "Record Gain",  "WrGain",  i_UB|i_SP, "%.1f dB", "Record Gain: %.1f dB",   -120,   40,    0,  0.1, -2);
    parDcl(p_wrOvrdb, "Overdub",  "WrOvrdb",  i_UB|i_SP, "%.1f %%", "Overdub: %.1f %%",   -150,   150,    0,  0.1, 0);
    parDcl(p_glInGain, "Input Gain",  "GlInGain",  i_UB|i_SP, "%.1f dB", "Input Gain: %.1f dB",   -120,   40,    0,  0.1, -2);
    parDcl(p_glOutVol, "Output Volume",  "GlOutVol",  i_UB|i_SP, "%.1f dB", "Output Volume: %.1f dB",   -120,   40,    0,  0.1, -2);
    parDcl(p_fxGain1, "Gain 1",  "FxGain1",  i_UB|i_SP, "%.1f dB", "Gain 1: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+1, "Gain 2",  "FxGain2",  i_UB|i_SP, "%.1f dB", "Gain 2: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+2, "Gain 3",  "FxGain3",  i_UB|i_SP, "%.1f dB", "Gain 3: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+3, "Gain 4",  "FxGain4",  i_UB|i_SP, "%.1f dB", "Gain 4: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+4, "Gain 5",  "FxGain5",  i_UB|i_SP, "%.1f dB", "Gain 5: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+5, "Gain 6",  "FxGain6",  i_UB|i_SP, "%.1f dB", "Gain 6: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+6, "Gain 7",  "FxGain7",  i_UB|i_SP, "%.1f dB", "Gain 7: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+7, "Gain 8",  "FxGain8",  i_UB|i_SP, "%.1f dB", "Gain 8: %.1f dB",   -120,   20,    0,  0.1, -3);
    // very fine choice of the small depths (flanger, chorus : 50 % of the slider is about 5 ms) up to 5 s
    parDcl(p_rdModDepth1, "Offset depth",  "RdModOff",  i_UB|i_SP, "%.4f ms", "Offset depth: %.4f ms",   0,   5000,    2,  0.0001, 14);
    parDcl(p_rdModDepth1+1, "Speed depth",  "RdModSpd",  i_UB|i_SP, "%.4f", "Speed depth: %.4f",   0,   32,    0.1,  0.0001, 5);
    parDcl(p_rdModDepth1+2, "Volume depth",  "RdModVol",  i_UB|i_SP, "%.3f", "Volume depth: %.3f",   0,   2,    0.5,  0.001, 0);
    parDcl(p_rdModAtt1, "Offset atten.",  "RdAttOff",  i_UB|i_SP, "%.3f", "Offset atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_rdModAtt1+1, "Speed atten.",  "RdAttSpd",  i_UB|i_SP, "%.3f", "Speed atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_rdModAtt1+2, "Volume atten.",  "RdAttVol",  i_UB|i_SP, "%.3f", "Volume atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_rdModDepth1+3, "Loop speed depth",  "RdModLsp",  i_UB|i_SP, "%.4f s/s", "Loop speed depth: %.4f s/s",   0,   2,    0.1,  0.0001, 0);
    parDcl(p_rdModAtt1+3, "Loop speed atten.",  "RdAttLsp",  i_UB|i_SP, "%.3f", "Loop speed atten.: %.3f",   -10,   10,    1,  0.001, 0);
    // symmetric curve (slope 1000 + 7, see uix_slider_value_to_ratio) : fine near 0 (about 0.03 s/s at a quarter of the slider)
    parDcl(p_rdLoopSpd, "Loop speed",  "RdLoopSp",  i_UB|i_SP, "%.4f s/s", "Loop speed: %.4f s/s",   -1,   1,    0,  0.0001, 1007);
    // symmetric curve, finer (slope 1000 + 9) : about 0.6 ms at a tenth of a half, 11 ms at a quarter of the slider
    parDcl(p_rdDesync, "Desync",  "RdDesync",  i_UB|i_SP, "%.5f s", "Desync: %.5f s",   -1,   1,    0,  0.00001, 1009);
    parDcl(p_rdModDepth1+4, "Desync depth",  "RdModDsy",  i_UB|i_SP, "%.5f s", "Desync depth: %.5f s",   0,   1,    0.01,  0.00001, 9); // (exponential)
    parDcl(p_rdModAtt1+4, "Desync atten.",  "RdAttDsy",  i_UB|i_SP, "%.3f", "Desync atten.: %.3f",   -10,   10,    1,  0.001, 0);
    // the depth of a modulation input whose action is not its default one (its label names the input, see its_Mod_DepPar)
    parDcl(p_modDepSc, "Depth (scale)",  "ModDepSc",  i_UB|i_SP, "%.3f", "Depth: x%.3f",   0,   10,    0.5,  0.001, 5);
    parDcl(p_modDepOct, "Depth (octaves)",  "ModDepOc",  i_UB|i_SP, "%.3f oct", "Depth: %.3f oct",   0,   8,    1,  0.001, 0);
    parDcl(p_modDepDb, "Depth (dB)",  "ModDepDb",  i_UB|i_SP, "%.2f dB", "Depth: %.2f dB",   0,   60,    6,  0.01, 0);
    parDcl(p_fxLfoFreq, "LFO Frequency",  "LfoFreq",  i_UB|i_SP, "%.3f Hz", "LFO Frequency: %.3f Hz",   0.001,   10000,    1,  0.001, 14); // exponential : about 9 Hz at the middle
    parDcl(p_fxLfoAmp, "LFO Amplitude",  "LfoAmp",  i_UB|i_SP, "%.3f", "LFO Amplitude: %.3f",   0,   10,    1,  0.001, 4.5); // exponential : 1 near the middle
    parDcl(p_fxLfoDC, "LFO Offset",  "LfoDC",  i_UB|i_SP, "%.3f", "LFO Offset: %.3f",   -10,   10,    0,  0.001, 0);
    parDcl(p_fxLfoSpread, "LFO Phase spread",  "LfoSprd",  i_UB|i_SP, "%.3f", "LFO Phase spread: %.3f",   0,   1,    0,  0.001, 0);
    parDcl(p_wrModDepth1, "Gain depth",  "WrModGn",  i_UB|i_SP, "%.1f dB", "Gain depth: %.1f dB",   0,   60,    6,  0.1, 2);
    parDcl(p_wrModDepth1+1, "Overdub depth",  "WrModOv",  i_UB|i_SP, "%.1f %%", "Overdub depth: %.1f %%",   0,   150,    20,  0.1, 0);
    parDcl(p_wrModAtt1, "Gain atten.",  "WrAttGn",  i_UB|i_SP, "%.3f", "Gain atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_wrModAtt1+1, "Overdub atten.",  "WrAttOv",  i_UB|i_SP, "%.3f", "Overdub atten.: %.3f",   -10,   10,    1,  0.001, 0);
    // W-Mix : exponential (slope 9 : about 0.1 s in the middle of the fade, 1 s in the middle of the plateau and of the wait)
    parDcl(p_wrWFade, "Fade",  "WrWFade",  i_UB|i_SP, "%.4f s", "Fade: %.4f s",   0.001,   10,    0.05,  0.0001, 9);
    parDcl(p_wrWFade+1, "Plateau",  "WrWPlat",  i_UB|i_SP, "%.3f s", "Plateau: %.3f s",   0,   100,    1,  0.001, 9);
    parDcl(p_wrWFade+2, "Wait",  "WrWWait",  i_UB|i_SP, "%.3f s", "Wait: %.3f s",   0,   100,    1,  0.001, 9);
    parDcl(p_wrWFade+3, "Direction",  "WrWDir",  i_UB|i_SP, "%.3f", "Direction: %.3f",   -1,   1,    1,  0.001, 0);
    parDcl(p_wrWFade+4, "Desync",  "WrWDsync",  i_UB|i_SP, "%.1f %%", "Desync: %.1f %%",   0,   100,    0,  0.1, 0);
    parDcl(p_wrModDepth1+2, "Fade depth",  "WrModFd",  i_UB|i_SP, "%.3f oct", "Fade depth: %.3f oct",   0,   8,    1,  0.001, 0);
    parDcl(p_wrModDepth1+3, "Plateau depth",  "WrModPl",  i_UB|i_SP, "%.3f oct", "Plateau depth: %.3f oct",   0,   8,    1,  0.001, 0);
    parDcl(p_wrModDepth1+4, "Wait depth",  "WrModWt",  i_UB|i_SP, "%.3f oct", "Wait depth: %.3f oct",   0,   8,    1,  0.001, 0);
    parDcl(p_wrModDepth1+5, "Direction depth",  "WrModDr",  i_UB|i_SP, "%.3f", "Direction depth: %.3f",   0,   2,    0.5,  0.001, 0);
    parDcl(p_wrModDepth1+6, "Desync depth",  "WrModDs",  i_UB|i_SP, "%.1f %%", "Desync depth: %.1f %%",   0,   100,    20,  0.1, 0);
    parDcl(p_wrModAtt1+2, "Fade atten.",  "WrAttFd",  i_UB|i_SP, "%.3f", "Fade atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_wrModAtt1+3, "Plateau atten.",  "WrAttPl",  i_UB|i_SP, "%.3f", "Plateau atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_wrModAtt1+4, "Wait atten.",  "WrAttWt",  i_UB|i_SP, "%.3f", "Wait atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_wrModAtt1+5, "Direction atten.",  "WrAttDr",  i_UB|i_SP, "%.3f", "Direction atten.: %.3f",   -10,   10,    1,  0.001, 0);
    parDcl(p_wrModAtt1+6, "Desync atten.",  "WrAttDs",  i_UB|i_SP, "%.3f", "Desync atten.: %.3f",   -10,   10,    1,  0.001, 0);
    // exponential : about 600 Hz in the middle of the slider
    parDcl(p_fxFltFreq, "Cutoff",  "FltFreq",  i_UB|i_SP, "%.1f Hz", "Cutoff: %.1f Hz",   1,   20000,    1000,  0.1, 7);
    parDcl(p_fxFltQ, "Resonance",  "FltQ",  i_UB|i_SP, "%.3f", "Resonance (Q): %.3f",   0.1,   1000,    0.707,  0.001, 9);
