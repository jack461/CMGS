        writer[its_Wrt_Last] = lcbl[its_Lin_Last];
        writer[its_Wrt_Abspos] = lcbl[its_Lin_Start];
        writer[its_Wrt_Flgs] |= its_WrtFlg_init;
        writer[its_Wrt_Check] = -1;
        // default source cell : spl_in(wrtn)
        (writer[its_Wrt_Cell] === 0) ? (writer[its_Wrt_Cell] = 1 + wrtn);
        writer[its_Wrt_Status] = max(writer[its_Wrt_Status], its_WrtStat_Ready);
        Wr_Followers(writer, 0); // the delay readers take the new line
        0;
    );
);

/*
    set the status "st" of writer "wrtn" ; returns the actual status (-1 : no writer)
    without a line or a source cell, the writer stays "Created"
    used by the slider "slWrStatus" and by the writer pad
*/
function Wr_Set_Status(wrtn, st)
local(writer, lcbl)
(
    ((wrtn < 0) || (wrtn >= WR_CNT) || ((writer = Writers_set[wrtn]) <= BASE_MEMORY) || (writer[-2] !== KW_writ)) ? (
        -1;
    ) : (
        (((lcbl = writer[its_Wrt_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl) || (writer[its_Wrt_Cell] === 0)) ? (
            st = its_WrtStat_Created;
        ) : (
            st = max(its_WrtStat_Ready, min(its_WrtStat_Writing, st));
        );
        (st === its_WrtStat_Writing) ? (
            writer[its_Wrt_Flgs] |= 2;
        ) : (
            writer[its_Wrt_Flgs] &= 0xFFFD;
        );
        writer[its_Wrt_Status] = st;
    );
);

// Something was modified
function invalid_RW()
local (i, bc)
(
    i = 0; loop(RD_CNT+1,
        ((bc = Readers_set[i]) !== 0) ? (bc[its_Rdr_Check] = 0);
        i +=1 ;
    );
    i = 0; loop(WR_CNT+1,
        ((bc = Writers_set[i]) !== 0) ? (bc[its_Wrt_Check] = 0);
        i +=1 ;
    );
);



// Fonction d'interpolation cubique (Hermite)
// buffer : le tableau d'échantillons
// position : l'indice fractionnaire (ex: 44.32)
function inter_cube(buffer, position)
local(i, f, y0, y1, y2, y3, a, b, c, d)
(
  // 1. Séparation de la partie entière et fractionnaire
  i = floor(position);
  f = position - i;

  // 2. Récupération des 4 points nécessaires (y0, y1, y2, y3)
  // On s'assure que les indices restent dans les bornes du buffer
  // On utilise max(0, ...) et min(buffer_size, ...) pour éviter les crashs
  // y0 = buffer[max(0, i - 1)];
  y0 = buffer[i - 1];
  y1 = buffer[i];
  y2 = buffer[i + 1];
  // y3 = buffer[max(0, i + 2)]; // Note: buffer_size doit être géré globalement
  y3 = buffer[i + 2];
  // 3. Calcul de l'interpolation cubique (Spline d'Hermite)
  // Formule : a*f^3 + b*f^2 + c*f + d
  a = -0.5*y0 + 1.5*y1 - 1.5*y2 + 0.5*y3;
  b = y0 - 2.5*y1 + 2*y2 - 0.5*y3;
  c = -0.5*y0 + 0.5*y2;
  d = y1;

  // Résultat final
  ((a*f + b)*f + c)*f + d;
);


function inter_lookup(buffer, position)
local(i, f, j, sum)
(
  i = floor(position);
  f = position - i;

  sum = 0;

  // On boucle sur le rayon du SInc (de -RADIUS à +RADIUS)
  // Pour chaque échantillon voisin, on cherche son poids dans la table
  j = - SINC_RADIUS;
  loop(2 * SINC_RADIUS + 1,
    // Calcul de la distance relative entre l'échantillon j et la position fractionnaire
    // Conversion de cette distance en index pour la table de look-up
    // On normalise la distance dist (qui est entre -RADIUS et RADIUS) vers l'index de la table
    // On récupère le poids dans la table (interpolation linéaire rapide pour la table elle-même)
    // Somme pondérée : valeur de l'échantillon * son poids SInc
    // sum += buffer[i + j] * sinc_table[floor((((j - f) + SINC_RADIUS) / (2 * SINC_RADIUS)) * SINC_TABLE_SIZE)];
    sum += buffer[i + j] * sinc_table[floor(((j - f) + SINC_RADIUS) * SINC_FACT)];
    j += 1;
  );

  sum;
);

// Execute action "act" (its_WrtAct_...) on writer "wnum" ; returns the writer block (0 : none)
// used by the slider "slWrtAct" and by the writer pad
function Wr_Action(act, wnum, pars)
local (cb, lcbl, cpy)
(
    cb = Writers_set[wnum];
    cpy = 0;
    ((cb === 0) && (act === its_WrtAct_Paste)) ? (
        // the writer must first be created
        cpy = 1;
        act = its_WrtAct_Create;
    );
    (act === its_WrtAct_Create) ? (
        // Create the writer
        (Writers_set[wnum] !== 0) ? (
            // ty to delete it
            Wr_Followers(Writers_set[wnum], 1); // the delay readers no longer follow the freed block
            mSL_Dyn_Free(Writers_set[wnum]);
            Writers_set[wnum] = 0;
        );
        // allocate the object uninitialized
        cb = Wr_Make(wnum);
        ((cb !== 0) && (cb[-2] === KW_writ)) ? (
            // Set as unspecified
            cb[its_Wrt_Status] = its_WrtStat_Created;
            cb[its_Wrt_InAction] = 520;
            cb[its_Wrt_Number] = wnum;
            str_mess = "Create writer configuration";
            (cpy && (Writers_set[WR_CNT] !== 0)) ? (
                memcpy(cb, Writers_set[WR_CNT], its_Wrt_BlkSize);
                cb[its_Wrt_Number] = wnum;
                cb[its_Wrt_Check] = -1;
                Wr_Set_Status(wnum, its_WrtStat_Ready); // a pasted writer does not write (Created if no line)
                str_mess = "Create/Paste writer configuration";
            );
        );
    ) :
    ((cb > BASE_MEMORY) && (cb[-2] === KW_writ)) ? (
        (act === its_WrtAct_Copy) ? (
            // Copy to reserve
            (Writers_set[WR_CNT] === 0) ? (
                // create an area for the copy
                Wr_Make(WR_CNT);
            );
            memcpy(Writers_set[WR_CNT], cb, its_Wrt_BlkSize);
            str_mess = "Copy writer configuration";
        ) :
        (act === its_WrtAct_Paste) ? (
            (Writers_set[WR_CNT] !== 0) ? (
                // paste from reserve
                memcpy(cb, Writers_set[WR_CNT], its_Wrt_BlkSize);
                cb[its_Wrt_Number] = wnum;
                cb[its_Wrt_Check] = -1;
                Wr_Set_Status(wnum, its_WrtStat_Ready); // a pasted writer does not write (Created if no line)
                Wr_Followers(cb, 0); // the line may have changed
                str_mess = "Paste writer configuration";
            );
        ) :
        (act === its_WrtAct_Clear) ? (
            Wr_Clear(wnum); // (the slider gave the block address, not the number)
            Wr_Followers(cb, 0); // no more line : they will stop
            str_mess = "Clear writer configuration";
        ) :
        (act === its_WrtAct_Rewind) ? (
            cb[its_Wrt_Abspos] = cb[its_Wrt_Start];
            str_mess = "Rewind writer";
        ) :
        (act === its_WrtAct_Show) ? (
            dbg_show_2(cb, 60);
        ) :
        (act === its_WrtAct_Activate) ? (
            ((cb[its_Wrt_Status] === its_WrtStat_Created)
                && ((lcbl = cb[its_Wrt_Lcbl]) > BASE_MEMORY)
                && (lcbl[-2] === KW_lcbl)) ?
            (
                // associate the line with the writer (and set it ready)
                Wr_Set_Line(wnum, cb[its_Wrt_LineNb]);
                str_mess = "Activate writer";
            );
        ) :
        (act === its_WrtAct_Delete) ? (
            Wr_Followers(cb, 1); // the delay readers no longer follow the freed block
            Wr_Delete(wnum);
            cb = 0;
            (wnum === slWriter) ? (Currwriter = 0); // no pointer to the freed block
            str_mess = "Delete writer";
        );
    );
    cb;
);



function mkModuleMenu()
local (i, g, it, fid, ttl, gl0, gl1, gl2, gl3, othFirst, tmp, bln, blu, itdsp, MM2, blockStrSpace, blockThemeBlack, blockThemeTron, blockThemeLightCyan, blockThemeOrange, blockThemeBlue, blockThemeDarkCyan, blockThemeDarkGreen, blockThemeDarkRed, blockThemeLightAmber, blockThemeNeonGreen, blockThemeLightMagenta)
