// the generic sliders (automatable by REAPER) : the control cells Ctl 1 ... NB_GSL (smoothed by the inputs that read them)
ctl_i = 0; loop(NB_GSL, smpl_tab[CTL_P + ctl_i] = slider(GSL_FIRST + ctl_i); ctl_i += 1;);

