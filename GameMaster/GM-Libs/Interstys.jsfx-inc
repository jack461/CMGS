            (act === its_EfxAct_EQMix) ? (
                // Apply EQ Mix on "N" values : set volume to -20*log(N)
                scnt = 8;
                (fxbcl[its_Efx_Src8] === 0) ? (
                    scnt = 7;
                    (fxbcl[its_Efx_Src7] === 0) ? (
                        scnt = 6;
                        (fxbcl[its_Efx_Src6] === 0) ? (
                            scnt = 5;
                            (fxbcl[its_Efx_Src5] === 0) ? (
                                scnt = 4;
                                (fxbcl[its_Efx_Src4] === 0) ? (
                                    scnt = 3;
                                    (fxbcl[its_Efx_Src3] === 0) ? (
                                        scnt = 2;
                                        (fxbcl[its_Efx_Src2] === 0) ? (
                                            scnt = 1;
                                        );
                                    );
                                );
                            );
                        );
                    );
                );
                tmp = -20 * log10(scnt);
                tmp = floor (0.5 + 100 * tmp)/100; // petit arrondi joli
                tmdisp = 10^(tmp/20);
                fxbcl[its_Efx_VoldB1] = slRnGain1Prv = slRnGain1 = (scnt >= 1) ? tmp : -120;
                fxbcl[its_Efx_VoldB2] = slRnGain2Prv = slRnGain2 = (scnt >= 2) ? tmp : -120;
                fxbcl[its_Efx_VoldB3] = slRnGain3Prv = slRnGain3 = (scnt >= 3) ? tmp : -120;
                fxbcl[its_Efx_VoldB4] = slRnGain4Prv = slRnGain4 = (scnt >= 4) ? tmp : -120;
