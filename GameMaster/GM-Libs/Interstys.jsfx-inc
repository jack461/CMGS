                (op === its_MtAdd) ? a + b :
                (op === its_MtSub) ? a - b :
                (op === its_MtMin) ? min(a, b) :
                (op === its_MtMax) ? max(a, b) :
                (op === its_MtAbs) ? abs(a) :
                (op === its_MtEnv) ? ( x = abs(a); p[0] += ((x > p[0]) ? ka : kr) * (x - p[0]); ) :
                (op === its_MtGate) ? ( p[0] ? ( (a <= b) ? (p[0] = 0); ) : ( (a > b + its_RnHyst) ? (p[0] = 1); ); p[0]; ) :
                (op === its_MtSlew) ? ( p[0] += max(-hd[5], min(hd[4], a - p[0])); ) :
                (op === its_MtLog) ? 20 * log10(max(abs(a), 0.000001)) :
                (op === its_MtExp) ? 10 ^ (min(a, 120) / 20) :
                a;
            y = off + am * y;
            !(abs(y) < its_FinMax) ? ( y = 0; p[0] = 0; its_NaNCnt += 1; );
            out[c] += y;
            c += 1; p += its_MtCW;
        );
    );
);

// Ring : the 90 degree network at "s" (34 words : 4 x 4 the sections of the path A, 4 x 4 those of the path B, 32 the delay
// of the path A, 33 the output Q) : returns I (the path A, one sample later), Q in s[33] ; from 20 Hz to 20 kHz (48 kHz)
// the two outputs are 90 degrees apart (the other sideband : -40 to -55 dB)
function its_Rg_Hilb(s, x) local(y, t, i, q)
(
    y = x; q = s; i = 0;
    loop(4, t = its_RgKA[i] * (y + q[3]) - q[1]; q[1] = q[0]; q[0] = y; q[3] = q[2]; q[2] = t; y = t; q += 4; i += 1;);
    t = s[32]; s[32] = y;
    y = x; i = 0;
    loop(4, s[33] = its_RgKB[i] * (y + q[3]) - q[1]; q[1] = q[0]; q[0] = y; q[3] = q[2]; q[2] = s[33]; y = s[33]; q += 4; i += 1;);
    t;
);

// Ring : the polyBLEP correction of a jump at the phase 0 ("t" the phase, "dt" its step per sample)
function its_Rg_Blep(t, dt)
(
    (t < dt) ? ( t /= dt; t + t - t * t - 1; ) :
    (t > 1 - dt) ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0;
);

// Ring : the carrier of the shape "sh" at the phase "pe" ("dt" its step : the jumps of Saw and Square smoothed, polyBLEP ;
// negative : the phase goes back), "p" the slots of the channel (Random, Hold : 3 4 the values, 6 the previous phase),
// "ct" the table of the curve
function its_Rg_Wave(sh, pe, dt, p, ct) local(y, ad)
(
    ad = min(0.5, abs(dt));
    y = (sh === its_LfoSine) ? sin(2 * $pi * pe) :
        (sh === its_LfoTri) ? ((pe < 0.5) ? 4 * pe - 1 : 3 - 4 * pe) :
        (sh === its_LfoSawUp) ? 2 * pe - 1 - its_Rg_Blep(pe, ad) :
        (sh === its_LfoSawDown) ? 1 - 2 * pe + its_Rg_Blep(pe, ad) :
        (sh === its_LfoSquare) ? ((pe < 0.5) ? 1 : -1) + its_Rg_Blep(pe, ad) - its_Rg_Blep(pe + ((pe < 0.5) ? 0.5 : -0.5), ad) :
        (sh === its_LfoCurve) ? its_Crv_Cyc(ct, pe) :
