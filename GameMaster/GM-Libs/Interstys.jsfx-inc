its_CrvGridN = make_array(5); its_CrvGridN[0] = 0; its_CrvGridN[1] = 4; its_CrvGridN[2] = 8; its_CrvGridN[3] = 16; its_CrvGridN[4] = 32;
// the modules that write or read a cell of the module "Connections" (right clic on the cell) : its items are set by its_Pch_Use
