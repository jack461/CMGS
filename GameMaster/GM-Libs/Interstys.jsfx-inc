ipos = 0; // temp. index
XPND = 0;
mdtb = 0; // temp ref. modulation table
bfsx = 0; // buffer in the modulation table

gmem[clPlAvail] = UTmem = __memtop(); // total memory available


// These must be defined here
padSScriptsNL = 4;
padSScriptsNC = 4;
K_padSScriptsSiz = padSScriptsNL * padSScriptsNC;

// MAIN MEMORY STRUCTURE
SharedLowMemory = 0;
SharedLowMemorySize = 1024;
SharedHighMemory = 0; // will be updated later
SharedHighMemorySize = 0; // yet unknown

// Some temporary work area
// 0 to 127 reserved
wrk1 = SharedLowMemory + 128; // size : 64 words
wrk2 = wrk1 + 64;
wa128 = 128; // a 128 words work area : also wrk1 et wrk2
wa256 = 256; // a 256 words work area
wa512 = 512; // a (surprise !) 512 words work area
//====== User modules : boxes and display stack (copied from GamePlayer, used by show_UserModule)
//----
//  Module/box flags
ubx_inited = 1;
ubx_modified = 2;
ubx_final = 0x100; // contains final items
ubx_recurs = 0x200; // contains other boxes
//  User inner box description
ubx_psize = idx = -1;
//----
ubx_ty = (idx += 1);    // Type of the box
ubx_flgs = (idx += 1); // associated flags
ubx_mref = (idx += 1);  // dynamic memory reference
ubx_anc = (idx += 1);  // ancestor (relative)
ubx_name = ubx_anc; // name of module as a string
//----
ubx_lcnt = (idx += 1);  // Number of direct descendants
ubx_icnt = (idx += 1); // number of direct items
ubx_1st = (idx += 1);  // 1st descendant (relative)
ubx_tcnt = (idx += 1);  // total Number of descendants
//----
ubx_l  = (idx += 1); // left position
ubx_t  = (idx += 1); // top position
ubx_w  = (idx += 1);  // width
ubx_h  = (idx += 1);  // height
//----
ubx_minw  = (idx += 1);  // min width
ubx_maxw  = (idx += 1);  // max width
ubx_thread = (idx += 1);  // thread base
ubx_thrdid = (idx += 1);  // thread base idt
//----
ubx_isiz = (idx += 1); // size of a box
//----
idx = 0; // tos
stk_btyp = idx;  // current bloc type
stk_cbx = (idx -= 1);  // current box [relative]
stk_rtsk = (idx -= 1); // return stack
stk_rtst = (idx -= 1); // return state
stk_mode = (idx -= 1); // work mode
stk_h = (idx -= 1); // computed height
stk_w = (idx -= 1); // computed width
stk_t = (idx -= 1); // computed top
stk_l = (idx -= 1); // computed left
stk_i = (idx -= 1); // index in boxes
stk_b = (idx -= 1); // base of boxes sequence
stk_isiz = 1 - idx;
// adjusts
ubx_sbox_more = 4;
//====== Reserve some memory to read/write presets
idx = SharedLowMemory + SharedLowMemorySize;
serialSize = 12288; // size of a preset
serialBlock = idx; // +++ 1024
dcbBlocksAll = serialBlock+3072; //  at least 2048

idx += serialSize;
K_savedStringsCnt = 192; // can save up to preset strings.
savedStrings = idx; // +++ 13312
idx += K_savedStringsCnt; // +++ 13504
memset(serialBlock, 0, idx - serialBlock);
static_Mem = BASE_MEMORY = idx;

BCtrlInfoSize = 128;
serialDelta = serialBlock; // current position in preset
serialHead = 8; // 1st 8 words describe the kind of preset loaded
serialLoad = serialSize - serialHead; // 12288 - 8 = 12280
serialBlockV = serialBlock + serialHead;

// Reserve some strings for the presets
// (the preset strings are reserved after mSL_Str_MkStructs(), see "STATIC MEMORY")
// 0 to 15 are for tabulations names (if any)
idx = 16;
Pr7_Date = idx; // save date of the preset

idx = 48;
// 48 to 64 are for scripts names in settings
namScriptfiles = savedStrings + idx;
idx += K_padSScriptsSiz;
K_fileAliases = idx; // strings for files aliases
idx += 64; // should we need more ?
(idx >= K_savedStringsCnt) ? err_sys_ini = 9927; // preset string array overflow
// serialBlock + 0
// Subblock 1 - individual variables - @0, Size 128
Pr7_pr_vers = 0;
Pr7_pr_check = 1;
Pr7_pr_aux1 = 2;
Pr7_pr_aux2 = 3;
//
Pr7_Partial0 = 32; // size:
Pr7_StudConf = Pr7_Partial0 + 16;
Pr7_StudRat = Pr7_StudConf + 8;  // size : 8 * 4
Pr7_StudLive = Pr7_StudRat + 8 * 4; // size : 8 -- 1 if the tab uses the "live" display
Pr7_UiStyle = Pr7_StudLive + 8; // ui_jstyle (look of the GUI) - saved with the 'stud' block
Pr7_UiTheme = Pr7_UiStyle + 1; // uix_jtheme (theme of the GUI) - saved with the 'stud' block
Pr7_UiSize = Pr7_UiTheme + 1; // the display size, in percent (0 : the default, see ui_jzoom_set) - 'stud' block
Pr7_Free = Pr7_UiSize + 1;

// Update tabulations width
i__tab = 0; loop (8,
    i__p = serialBlock + Pr7_StudRat + 4 * i__tab;
    i__p[0] = i__p[1] = i__p[2] = i__p[3] = 600;
    i__tab += 1;
);

idx = serialBlock + 128; // dcbBlocksAll stays at serialBlock+3072 (was overlapping the structures and parameters below)

// Description interne des readers
ReadersBlockSize = 12; // RDBL : see show_Reader_Pad
ReadersStructA = idx; idx += ReadersBlockSize;
ReadersStructB = idx; idx += ReadersBlockSize;
ReadersStructC = idx; idx += ReadersBlockSize;
ReadersStructD = idx; idx += ReadersBlockSize;
ReadersStructE = idx; idx += ReadersBlockSize;
ReadersStructF = idx; idx += ReadersBlockSize;
ReadersStructG = idx; idx += ReadersBlockSize;
ReadersStructH = idx; idx += ReadersBlockSize;
// Display of a reader : RDBL[8] = waveform height, RDBL[9] = waveform zoom [1 .. 100], RDBL[10] = waveform flags (its_Wave_...)
its_RdrWaveH = 100; // default waveform height
its_RdrWaveMin = 24; // smaller : no waveform
// the mouse in the waveform of a reader (its_wave_mouse) : the reader block caught by a press (0 : none), what it moves
// (its_WvD_...), the range shown when it was pressed (it does not move during a drag), the offset of the mouse in the loop
its_WvDR = its_WvDK = its_WvDZa = its_WvDZb = its_WvDOff = 0;
its_WvD_Head = 1; // the read position (at the release)
its_WvD_Low = 2; // the low limit of the loop
its_WvD_High = 3; // the high limit
its_WvD_Loop = 4; // the loop (Alt), its length kept
its_WvDTol = 5; // a limit of the loop (or its margin) is caught at this distance (pixels)
// a loop moved by hand (its_Rd_HandMove : the mouse in the waveform, or the sliders of its limits) : its reader block
// (0 : none) and the time of the last frame of the move ; @block keeps it in its_RdNoCatch while the left button is down
// (at most 0.25 s after the last frame) : type "catch", the loop does not catch the read position it passes over
its_WvNoCatch = its_WvNoCatchT = its_RdNoCatch = 0;
i__ii = 0; loop(8, i__p = ReadersStructA + i__ii * ReadersBlockSize; i__p[8] = its_RdrWaveH; i__p[9] = 1; i__ii += 1;);

LinesBlockSize = 8;
LinesStructA = idx; idx += LinesBlockSize;
LinesStructB = idx; idx += LinesBlockSize;
LinesStructC = idx; idx += LinesBlockSize;
LinesStructD = idx; idx += LinesBlockSize;
LinesStructE = idx; idx += LinesBlockSize;
LinesStructF = idx; idx += LinesBlockSize;
LinesStructG = idx; idx += LinesBlockSize;
LinesStructH = idx; idx += LinesBlockSize;

WriterBlockSize = 8;
WriterStructA = idx; idx += WriterBlockSize;
WriterStructB = idx; idx += WriterBlockSize;
WriterStructC = idx; idx += WriterBlockSize;
WriterStructD = idx; idx += WriterBlockSize;
WriterStructE = idx; idx += WriterBlockSize;
WriterStructF = idx; idx += WriterBlockSize;
WriterStructG = idx; idx += WriterBlockSize;
WriterStructH = idx; idx += WriterBlockSize;

EffectsBlockSize = 12;
EffectsStructA = idx; idx += LinesBlockSize;
EffectsStructB = idx; idx += LinesBlockSize;
EffectsStructC = idx; idx += LinesBlockSize;
EffectsStructD = idx; idx += LinesBlockSize;
EffectsStructE = idx; idx += LinesBlockSize;
EffectsStructF = idx; idx += LinesBlockSize;
EffectsStructG = idx; idx += LinesBlockSize;
EffectsStructH = idx; idx += LinesBlockSize;
EffectsStructI = idx; idx += LinesBlockSize;
EffectsStructJ = idx; idx += LinesBlockSize;
idx += 6 * LinesBlockSize; // EffectsStructK ... EffectsStructP (the views Effect A ... P : EffectsStructA + k * LinesBlockSize)
its_EfxViews = 16; // the modules "Effect A" ... "Effect P" (blockEffectA ... blockEffectP : consecutive numbers)
ControlsStruct = idx; idx += 8; // the module "Controls" : [0] the page of sliders shown
PatchStruct = idx; idx += 8; // the module "Connections" : [0] the view (its_PchV...), [1] the page, [2] the pinned entry + 1, [3] its view
SummaryStruct = idx; idx += 8; // the summary modules (show_Summary_Pad) : the pages of "Readers" [0], "Writers" [1], "Effects" [2],
    // "Lines" [3], "Curves" [4], "Modules" [5] ; [6] the kind shown by "Modules" (0 : all ; 1 ... 5 : see its_Sum_Kind)
// the module "Patch" (show_PGraph_Pad) : [0] 1 all the modules (0 : the patch of the module designated), [1] 1 In and the
// controls not shown, [2] the first column shown
PGraphStruct = idx; idx += 8;
// the display blocks of the modules above (number of the object shown, display options) : saved in the 'disp' block
DispStructsSize = idx - ReadersStructA;

// Parameters : the range of Interstys (mSL_gmem_map) ; the tables are indexed by its numbers [paramBase ... paramNMax]
// (their addresses minus the base, see GP_Parameters)
paramBase = parBase_ITS;
paramCount = parCnt_ITS;
paramNMax = paramBase + paramCount - 1; // (GP_Parameters, included before, computed it with the default range)
paramEntSize = 20;
paramValues = idx - paramBase; idx += paramCount;
paramStatus = idx - paramBase; idx += paramCount;
paramFlags = idx - paramBase; idx += paramCount;
paramPrevValues = idx - paramBase; idx += paramCount;

// Parameters declaration (paramBase : not used, a security)
idx = paramBase + 1;
p_uix_jtheme = idx; idx += 1; // the theme of the GUI (a parameter common to the applications : its own number in each one)
p_playVol = idx; idx += 1; // player volume
p_playSpeed = idx; idx += 1; // player speed
p_lineSize = idx; idx += 1; // line size [0 .. 3600 s.]
p_playPos = idx; idx += 1; // play position [0 .. p_lineSize]
p_play_S_Low = idx; idx += 1; // region low limit
p_play_S_High = idx; idx += 1; // region high limit
p_play_S_Len = idx; idx += 1; // region length
p_play_S_Pos = idx; idx += 1; // region position
p_play_XFade = idx; idx += 1; // xfade time
p_play_Zoom = idx; idx += 1; // zoom of the waveform of a reader (a display property, kept in RDBL[9])
p_rdOffset = idx; idx += 1; // offset of a reader in delay mode [0 .. line size] (s.)
p_wrGain = idx; idx += 1; // record gain of a writer (dB)
p_wrOvrdb = idx; idx += 1; // overdub of a writer (%)
p_glInGain = idx; idx += 1; // global input gain (dB) : its_GlInGain
p_glOutVol = idx; idx += 1; // global output volume (dB) : its_GlOutVol
p_fxGain1 = idx; idx += 8; // gains of the 8 sources of a mixer (dB) : p_fxGain1 ... p_fxGain1 + 7
p_rdModDepth1 = idx; idx += 5; // depths of the 5 modulation inputs of a reader : offset (ms), speed, volume, loop speed (s/s), desync (s)
p_rdModAtt1 = idx; idx += 5; // attenuverters of the 5 modulation inputs of a reader [-10 ... 10]
p_rdLoopSpd = idx; idx += 1; // speed of the move of the loop of a reader (s/s) [-1 ... 1]
p_rdDesync = idx; idx += 1; // desync of the channels of a reader (s) [-1 ... 1]
p_fxLfoFreq = idx; idx += 1; // LFO : frequency (Hz)
p_fxLfoAmp = idx; idx += 1; // LFO : amplitude
p_fxLfoDC = idx; idx += 1; // LFO : offset
p_fxLfoSpread = idx; idx += 1; // LFO : phase spread between the channels (turns)
p_wrModDepth1 = idx; idx += 7; // depths of the 7 modulation inputs of a writer : record gain (dB), overdub (%), W-Mix (its_Wrt_Mod1)
p_wrModAtt1 = idx; idx += 7; // their attenuverters [-10 ... 10]
p_wrWFade = idx; idx += 5; // W-Mix : fade (s), plateau (s), wait (s), direction, desync (%) (in the order of its_Wrt_WFade ...)
p_fxFltFreq = idx; idx += 1; // Filter : cutoff frequency (Hz)
p_fxFltQ = idx; idx += 1; // Filter : resonance (Q)
p_fxFltModD1 = idx; idx += 2; // depths of the 2 modulation inputs of a filter : cutoff, resonance (octaves)
p_fxFltModA1 = idx; idx += 2; // their attenuverters [-10 ... 10]
p_fxSatDrive = idx; idx += 1; // Saturation : drive (dB)
p_fxSatBias = idx; idx += 1; // Saturation : bias
p_fxSatMix = idx; idx += 1; // Saturation : mix (%)
p_fxSatOut = idx; idx += 1; // Saturation : output gain (dB)
p_fxSatModD1 = idx; idx += 3; // depths of the 3 modulation inputs of a saturation : drive (dB), bias, order (or stretch)
p_fxSatModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxSatOrder = idx; idx += 1; // Saturation : order n (modes x - sin, Chebyshev)
p_fxSatStretch = idx; idx += 1; // Saturation : stretch (mode Cheb. sum)
p_fxSatAmp = idx; idx += 1; // Saturation : amount A of the sine (mode x - A sin)
p_rdStretch = idx; idx += 1; // stretch of a reader (mode Stretch) : the progression in its line, the tempo [-SPDMAX ... SPDMAX]
p_modDepSc = idx; idx += 1; // the depth of a modulation input whose action is Scale, Oct or dB but not its default one
p_modDepOct = idx; idx += 1; // (one parameter per action, shared by the inputs : see its_Mod_DepPar)
p_modDepDb = idx; idx += 1;
p_fxMxDecay = idx; idx += 1; // Matrix : decay T60 (s)
p_fxMxDamp = idx; idx += 1; // Matrix : damping (Hz)
p_fxMxMix = idx; idx += 1; // Matrix : mix (%)
p_fxMxDmin = idx; idx += 1; // Matrix : the shortest delay (ms)
p_fxMxDmax = idx; idx += 1; // Matrix : the longest delay (ms)
p_fxMxDiff = idx; idx += 1; // Matrix : diffusion [-2 ... 2]
p_fxMxHp = idx; idx += 1; // Matrix : high pass in the loop (Hz)
p_fxMxWow = idx; idx += 1; // Matrix : wow, the depth of the modulation of the delays (ms)
p_fxMxRate = idx; idx += 1; // Matrix : its rate (Hz)
p_fxMxSpread = idx; idx += 1; // Matrix : its phase from a line to the next (turns)
p_fxMxGlide = idx; idx += 1; // Matrix : the glide of the delays (s)
p_fxMxModD1 = idx; idx += 3; // depths of the 3 modulation inputs of a matrix : decay, damping (octaves), diffusion
p_fxMxModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxFlDelay = idx; idx += 1; // Flanger, Chorus : the delay (ms)
p_fxFlSweep = idx; idx += 1; // the sweep (ms)
p_fxFlRate = idx; idx += 1; // the rate of the sweep (Hz)
p_fxFlFb = idx; idx += 1; // the feedback [-2 ... 2]
p_fxFlMix = idx; idx += 1; // the mix [-100 ... 100] (%)
p_fxFlSpread = idx; idx += 1; // the phase from a channel to the next (turns)
p_fxFlCross = idx; idx += 1; // the cross feedback [-1 ... 1]
p_fxFlJitter = idx; idx += 1; // the jitter of the voices [0 ... 1]
p_fxFlModD1 = idx; idx += 3; // depths of the 3 modulation inputs : delay, rate (octaves), feedback
p_fxFlModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxPhFreq = idx; idx += 1; // Phaser : the frequency (Hz)
p_fxPhSweep = idx; idx += 1; // the sweep (octaves)
p_fxPhStages = idx; idx += 1; // the stages [1 ... its_PhMaxS]
p_fxPhSpacing = idx; idx += 1; // the spacing of the stages (octaves from a stage to the next)
p_fxPhQ = idx; idx += 1; // the Q of the stages (mode Resonant)
p_fxPhModD1 = idx; idx += 3; // depths of the 3 modulation inputs : frequency, rate (octaves), feedback
p_fxPhModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxMxLines = idx; idx += 1; // Matrix, Shimmer : the minimum count of lines
p_fxShAmt = idx; idx += 1; // Shimmer : the share of the shifted signal in the lines (%)
p_fxShShift = idx; idx += 2; // the intervals of the even and of the odd lines (semitones)
p_fxShGrain = idx; idx += 1; // the window of the pitch shifter (ms)
p_fxNzLevel = idx; idx += 1; // Noise : the level (dB)
p_fxNzDens = idx; idx += 1; // the density (events or iterations per second)
p_fxNzCorr = idx; idx += 1; // the correlation of the channels [0, 1]
p_fxNzChaos = idx; idx += 1; // chaos [0, 1] (Crackle, Logistic)
p_fxNzModD1 = idx; idx += 3; // depths of the 3 modulation inputs : level (dB), density (octaves), correlation
p_fxNzModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxNzTilt = idx; idx += 1; // the tilt of the mode Mix (dB/oct)
p_fxNzPower = idx; idx += 1; // the exponent of the shape (power)
p_fxNzRumble = idx; idx += 1; // the share of the rumble (%)
p_fxNzRFreq = idx; idx += 1; // its frequency (Hz)
p_fxRnRate = idx; idx += 1; // Random : the rate (Hz)
p_fxRnAmp = idx; idx += 1; // the amplitude
p_fxRnDC = idx; idx += 1; // the offset
p_fxRnJitter = idx; idx += 1; // the irregularity of the clock [0, 1]
p_fxRnGlide = idx; idx += 1; // the glide (s)
p_fxRnSteps = idx; idx += 1; // the steps (0 : none)
p_fxRnWalk = idx; idx += 1; // the size of the steps of the mode Walk
p_fxRnThr = idx; idx += 1; // the threshold of the trigger
p_fxRnRel = idx; idx += 1; // the release of its envelope (ms)
p_fxRnModD1 = idx; idx += 3; // depths of the 3 modulation inputs : amplitude, rate (octaves), jitter
p_fxRnModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxMtScale = idx; idx += 1; // Math : the scale of the output
p_fxMtDC = idx; idx += 1; // its offset
p_fxMtVal = idx; idx += 1; // the value of B (without source B)
p_fxMtAtt = idx; idx += 1; // the attack (ms : Env, Slew)
p_fxMtRel = idx; idx += 1; // the release (ms : Env, Slew)
p_fxMtModD1 = idx; idx += 3; // depths of the 3 modulation inputs : scale, value, offset
p_fxMtModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxRgFreq = idx; idx += 1; // Ring : the frequency of the oscillator (Hz)
p_fxRgDetune = idx; idx += 1; // the gap of frequency from a channel to the next (Hz)
p_fxRgSpread = idx; idx += 1; // the gap of phase from a channel to the next (turns)
p_fxRgAmt = idx; idx += 1; // the amount (AM)
p_fxRgMix = idx; idx += 1; // the mix (%)
p_fxRgModD1 = idx; idx += 3; // depths of the 3 modulation inputs : frequency (octaves), amount, mix
p_fxRgModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxVuTime = idx; idx += 1; // VU meter : the sample time (ms)
p_fxVuHl = idx; idx += 1; // the highlighted channel (0 : none)
p_fxLmLimit = idx; idx += 8; // Limiter : limit, pre-gain, volume out, anticipation, release, distortion, zoom, channels shown
its_ParLast = idx - 1; // the last parameter of Interstys : in its range (paramNMax), see the error 2716

// Global variables
blockDesc = 0;  // description of the current block
blockMouseWasIn = 0; //  in which block was the mouse ?
cModule = 0; // "current" module
copiedMod = 0; // "copied" module

TabIdt = 0;
PanIdt = 0;


///===== STATIC MEMORY =====
mSL_StM_Init(BASE_MEMORY); // init static memory at this position
current_Memory_Mode = mSL_MMd_Static; // starting now, allow use of "make_array"
TabAddrMin = mSL_StM_FreePt; // min. address recognized for an array (see mSL_Evaluator)
mSL_Str_Init(#strFirst, #strLast); // allocate strings for strings allocator
mSL_Str_TInit(#wstrFirst, #wstrLast); // allocate strings for temporary strings
mSL_Str_PInit(#xstrFirst, #xstrLast); // allocate strings for permanent strings
mSL_Str_MkStructs(); // Build string management structures
// Reserve some strings for the presets : needs the string manager built just above
i__ii = 0; loop(K_savedStringsCnt, savedStrings[i__ii] = mSL_Str_Perm(); i__ii+=1;);
// see mm_highblocks
//====== GLOBALS ======
init_idents();
mSL_Init_Keywords();
mSL_Init_long_Keywords();
init_log_boxes();


//====== Init "ui-lib-JJ.jsfx-inc" ======
ui_lib_start = mSL_StM_BlockStart('uilb'); // ui lib block
ui_lib_end = ui_setup(ui_lib_start);
mSL_StM_BlockEnd(ui_lib_end);
gfxInit();
// the VU meter and the limiter (GM-Meters) : the table of the limiter, the offscreen image of the meters
lm_hctab = make_array(lm_TabSize); lm_InitTab(lm_hctab);
ui_reserve_image(VU_IMG);
//====== Init "ui-lib-JJ-GUI.jsfx-inc" ======
studPrefDispPanes = 2;
studPrefDispSize = 1;
ui_MinSize1Pane = 312;
ui_MinSize4Panes = 4 * ui_MinSize1Pane;
ui_MinSize3Panes = 3 * ui_MinSize1Pane;
ui_MinSize2Panes = 2 * ui_MinSize1Pane; // min size for 2 panes
ui_MaxSize1Pane = 16 * ui_MinSize1Pane; // max size for 1 pane
ui_BestSize1Pane = 0|(16 * ui_MinSize1Pane); // best size for 1 pane
ui_MinSubColSize = 0|(ui_MinSize1Pane/2.5);
ui_lib_JJ_GUI_init(2);
ui_js_slValSize = 192; // the labels of the sliders are longer here (152 in the lib) : "Resonance depth: 2.000 oct"

// REAL START OF BLOCKS ANALYZED BY THE GARBAGE COLLECTOR
mm_lowblocks = make_array(2); // creates a gap of 2 words.
mm_lowblocks[0] = 'Low_'; mm_lowblocks[1] = '_Mem';

/*
=== MODULES ===
*/

// The Main menu
dcbNamesCnt = 192; // up to 192 strings in the dcb Menu - 163 used with 32 user modules (16 views Effect A ... P)
// memory block for the menu
GUI_Main_Menu_Block = mSL_StM_Alloc(ui_jmenu_items+dcbNamesCnt, 'Menu', mSL_StM_FlClear);

blockDispNames = make_array(dcbNamesCnt);
blockDispIdts = make_array(dcbNamesCnt);
blockDispInverts = make_array(dcbNamesCnt);
blockModNames = make_array(dcbNamesCnt); // module names, by module number (see mkModuleMenu)

// User modules
dcbUModsSiz = 32;
dcbUModsCnt = 0;
blockUsrNames = make_array(dcbUModsSiz);
blockUsrIds = make_array(dcbUModsSiz);
blockUsrNum = make_array(dcbUModsSiz);
blockUsrRefs = make_array(dcbUModsSiz);
blockUsrChecks = make_array(dcbUModsSiz);

dcbUXRefsSiz = 64;
blockUsrCode = make_array(dcbUXRefsSiz);
blockUsrDesc = make_array(dcbUXRefsSiz);

#MainScreen = "Tab1"; // (unused)
#LiveScreen = "Tab2"; // (unused)

// Live screen (shared with Diffusion-3) : fonts, display boxes, colored background
<? include("GM-Libs/mSL_Live_Screen.jsfx-inc"); ?>
<? include("GM-Libs/mSL_Live_Screen_Display.jsfx-inc"); ?>
live_screen_init(); // also creates the fonts table (font_names, font_sizes, font_modes)
colorlimits(0x000000, 0xFFFFFF); // limits of the animated background colors (as in Diffusion-3)
live_tab_active = 0; // set when a tab is shown with the "live" display
live_clock_init(); // clock box of the "live" display (needs mSL symbols)

<? include("GM-Libs/mSL_Colors.jsfx-inc"); ?>

// Shared display modules : scheduler pad (mSL_show_Utilities.jsfx-inc)
<? shw_part = 1; include("GM-Libs/mSL_show_Utilities.jsfx-inc"); ?>
shw_Sched_Init();
shw_Proc_Init();
shw_AppName = "Interstys"; // in the names of the log files (sysout)
// Audio waveforms (mSL_ui_audio.jsfx-inc) : work tables and colors ; waveform of a line in show_Line_Pad
ui_audio_init();
its_LinWaveH = 120; // height of the waveform of a line
its_LinWaveMax = 4; // max channels shown (the loudest ones)
// The waveform of a module (Line, Reader, Writer) : its height and flags are kept in the display block of the module
its_WaveHide = 1; // flag : the waveform is not shown
its_WaveOver = 2; // flag : the channels are superposed (else one band per channel)
its_WaveHMin = 40; // heights (keys '+' and '-')
its_WaveHMax = 600;
its_WaveHStep = 20;
// height of the waveform ("hp" : the height kept, 0 for the default "dflt" ; "fp" : the flags) ; 0 if hidden
function its_Wave_H(hp, fp, dflt)
(
    (fp[0] & its_WaveHide) ? 0 : (hp[0] > 0) ? hp[0] : dflt;
);
// the flags of ui_audio_wave
function its_Wave_Flags(fp)
(
    (fp[0] & its_WaveOver) ? ui_aud_Axis : ui_aud_Sep | ui_aud_Axis;
);
// keys of the waveform, the mouse over the module : 'w' shows / hides it, '+' (or '=') and '-' change its height,
// 'v' superposes / separates the channels
function its_Wave_Keys(hp, fp, dflt)
local (h)
(
    h = (hp[0] > 0) ? hp[0] : dflt;
    GM_key_take('w') ? (
        fp[0] = fp[0] ~ its_WaveHide; // show / hide the waveform
    ) :
    (GM_key_take('+') || GM_key_take('=')) ? (
        hp[0] = min(its_WaveHMax, h + its_WaveHStep); // taller waveform
        fp[0] -= fp[0] & its_WaveHide;
    ) :
    GM_key_take('-') ? (
        hp[0] = max(its_WaveHMin, h - its_WaveHStep); // smaller waveform
        fp[0] -= fp[0] & its_WaveHide;
    ) :
    GM_key_take('v') ? (
        fp[0] = fp[0] ~ its_WaveOver; // channels superposed / separate
    );
);
// Colors of the markers and of the region in the waveforms
// (set by its_wave_colors before each waveform : darker hues with the light themes, see uix_theme_thickline)
its_WaveColWrt = 0x20FF20; // writing head : green
its_WaveColRdr = 0xFFE020; // reading head : yellow
its_WaveColAux = 0xFF8C20; // auxiliary reading head (during a cross fade) : orange
its_WaveColReg = 0x4080FF; // loop region (shaded)
its_WaveColRegLim = 0x909090; // limits of the cross fades around the region
function its_wave_colors()
(
    uix_theme_thickline() ? (
        // light background
        its_WaveColWrt = 0x008C00; // dark green
        its_WaveColRdr = 0xA87800; // ochre
        its_WaveColAux = 0xD04800; // dark orange
        its_WaveColRegLim = 0x505050;
    ) : (
        its_WaveColWrt = 0x20FF20;
        its_WaveColRdr = 0xFFE020;
        its_WaveColAux = 0xFF8C20;
        its_WaveColRegLim = 0x909090;
    );
);

