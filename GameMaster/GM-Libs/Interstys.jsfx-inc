            Trace_Z_002 = lcbl[its_Lin_SmplCnt];
            Trace_Z_003 = writer[its_Wrt_ChNbr];
            Trace_Z_004 = lcbl[its_Lin_ChCnt];
        ) : (
            ((writer[its_Wrt_Start] != lcbl[its_Lin_Start])
                || (writer[its_Wrt_Last] != lcbl[its_Lin_Last])) ? (
                writer[its_Wrt_Start] = lcbl[its_Lin_Start];
                writer[its_Wrt_Last] = lcbl[its_Lin_Last];
                writer[its_Wrt_SmplCnt] = lcbl[its_Lin_SmplCnt];
            );
            ((writer[its_Wrt_Abspos] < writer[its_Wrt_Start])
                || (writer[its_Wrt_Abspos] >= writer[its_Wrt_Last])) ? (
