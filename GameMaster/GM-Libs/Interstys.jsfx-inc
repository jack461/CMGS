//==========================================================
//===== LINES Handling
// Lines_Set[LN_CNT]

// A revoir
function Ln_Check(lnum)
local (lcbl)
(
    ((lnum >= 0) && (lnum <= LN_CNT) && ((lcbl = Lines_Set[lnum]) > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        (lcbl[its_Lin_Check] !== BLOCK_CHECK) ? (
            ((lcbl[its_Lin_Unuz1] === SECURE_BL) && (lcbl[its_Lin_Unuz1] === SECURE_BL)) ? (
                lcbl[its_Lin_Check] = BLOCK_CHECK;
            );
        );
        lcbl[its_Lin_Check];
    );
);

function Ln_Clear(lnum)
local (i, lcbl)
(
    ((lnum >= 0) && (lnum <= LN_CNT) && ((lcbl = Lines_Set[lnum]) > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        i = its_Lin_BF1ST; loop(lcbl[its_Lin_ChCnt],
            memset(lcbl[i], 0, lcbl[its_Lin_ActBSize]);
            l_cleared += lcbl[its_Lin_ActBSize];
            i += 1;
        );
    );
);


function Ln_New()
local (lnb, i)
(
    lnb = -1; i = 0;
    while ((i < LN_CNT) && (lnb < 0)) (
        (Lines_Set[i] === 0) ? (lnb = i);
        i += 1;
    );
    lnb;
);


/*
    A line replaced by Ln_Make : @sample may still be reading or writing it (@gfx runs concurrently).
    Its memory is freed later by Ln_Trash_Run (@gfx), 2 @block after, or 1 s after without audio processing.
*/
Ln_TrashSz = 2 * LN_CNT;
Ln_TrashP = make_array(Ln_TrashSz); // the line blocks waiting
Ln_TrashB = make_array(Ln_TrashSz); // its_BlkCnt when they were put there
Ln_TrashT = make_array(Ln_TrashSz); // time_precise() when they were put there

// free the buffers and the control block of a line
function Ln_Free(lcbl)
local (i, j)
(
    ((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        i = 0; loop (128,
            j = lcbl[i+its_Lin_BF1ST];
            (j != 0) ? (mSL_Dyn_Free(j));
            i += 1;
        );
        mSL_Dyn_Free(lcbl);
    );
);

function Ln_Defer_Free(lcbl)
local (i, k)
(
    k = -1; i = 0;
    while ((k < 0) && (i < Ln_TrashSz)) ( (Ln_TrashP[i] === 0) ? (k = i); i += 1; );
    (k < 0) ? (
        Ln_Free(lcbl); // no room left (should not arrive)
    ) : (
        Ln_TrashB[k] = its_BlkCnt; Ln_TrashT[k] = time_precise();
        Ln_TrashP[k] = lcbl;
    );
);

function Ln_Trash_Run()
local (i)
(
    i = 0; loop(Ln_TrashSz,
        ((Ln_TrashP[i] !== 0) && ((its_BlkCnt - Ln_TrashB[i] >= 2) || (time_precise() - Ln_TrashT[i] > 1))) ? (
            Ln_Free(Ln_TrashP[i]);
            Ln_TrashP[i] = 0;
        );
        i += 1;
    );
);


function Ln_Make(lnum, freq, size, channels)
local (lcbl, buff, bsz, i, j, R, lng, old)
(
    // Create the buffer control bloc
    channels = max(1, min(128, 0|channels));
    // size is in seconds
    // freq is in Hz
    lng = max(48, min(67108864, ceil(size * freq)));
    lcbl = mSL_Dyn_Alloc(its_Lin_BlkSize, KW_lcbl, mSL_StM_FlClear);
    (lcbl > BASE_MEMORY) ? (
        lcbl[its_Lin_Unuz1] = SECURE_BL; // "Interstys buffer"
        lcbl[its_Lin_Status] = its_LinStat_Ready;
        lcbl[its_Lin_Flgs] = 1;
        lcbl[its_Lin_Numb] = lnum;
        lcbl[its_Lin_ChCnt] = channels;
        lcbl[its_Lin_SmplCnt] = lng;
        lcbl[its_Lin_RecFreq] = freq;
        lcbl[its_Lin_SmplCntSec] = floor(1000* lng/freq)/1000;
        lcbl[its_Lin_Start] = BF_LIM;
        lcbl[its_Lin_Last] = BF_LIM + lng;
        lcbl[its_Lin_Unuz2] = SECURE_BL;

        // Create the various buffers
        // lng is the expected size in samples, bsz is the size needed to represent the buffer
        lcbl[its_Lin_ActBSize] = bsz = lng + BF_LIM * 2;
        lcbl[its_Lin_Tmp2] = lcbl[its_Lin_RecFreq];
        i = its_Lin_BF1ST; R = j = 0;
        while (j < channels) (
            (((lcbl[i] = mSL_Dyn_Alloc(bsz, KW_buff, 0)) < BASE_MEMORY)) ? (
                R = 1; j = channels;
            );
            i += 1; j +=1;
        );
        (R === 0) ? (
            // Replace previous line if any
            // (with its buffers, when @sample no longer uses it : Ln_Defer_Free)
            ((old = Lines_Set[lnum]) > BASE_MEMORY) ? (
                // the new line keeps the owner of the old one (a file read in the line of an instance, from outside
                // the instance or by Reload in the pad : else Free Instance no longer frees it)
                (old[-2] === KW_lcbl) ? (lcbl[its_Lin_Owner] = old[its_Lin_Owner]);
                Ln_Defer_Free(old);
            );
            Lines_Set[lnum] = lcbl;
            Ln_MemErr[lnum] = 0;
            Ln_Clear(lnum);
        ) : (
            // Can't create all buffers : free those already allocated
            i = its_Lin_BF1ST; loop(channels,
                (lcbl[i] > BASE_MEMORY) ? mSL_Dyn_Free(lcbl[i]);
                i += 1;
            );
            mSL_Dyn_Free(lcbl);
            lcbl = 0;
        );
    );
    (lcbl <= BASE_MEMORY) ? (
        Ln_MemErr[lnum] = 1; // shown in the pad of the line
        sprintf(#itm, "Error 2610 : line %d (%.3f s, %d chan., %.2f MW) : not enough memory (free %.2f MW)",
            lnum+1, size, channels, channels * (lng + BF_LIM * 2) / 1048576, mSL_Dyn_Dispo / 1048576);
        mSL_log(SysLogBox, #itm);
    );
    lcbl;
);

// delete buffer "lnum" from Lines_Set ; "defer" : 1 in @gfx (the memory is freed by Ln_Trash_Run)
function Ln_Delete(lnum, defer)
local (lcbl, i, j, cb)
(
    ((lnum >= 0) && (lnum <= LN_CNT)) ? (
        (((lcbl = Lines_Set[lnum]) > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? ( // (was "lbcl =" : nothing was freed)
            // Check that the line is not used in any reader/writer
            i = 0; loop(RD_CNT+1,
                cb = Readers_set[i];
                ((cb !== 0) && (lcbl === cb[its_Rdr_Lcbl])) ? (
                    // stop reader
                cb[its_Rdr_Tmp4] = 210;
                cb[its_Rdr_Tmp5] = cb[its_Rdr_Status];
                cb[its_Rdr_Tmp6] = ts();
                    cb[its_Rdr_Status] = its_RdrStat_Created;
                    its_Run_Check(cb);
                    cb[its_Rdr_Check] = 0;
                    cb[its_Rdr_Lcbl] = 0;
                    cb[its_Rdr_LineNb] = -1;
                    rdupdt = 1;
                );
                i += 1;
            );
            i = 0; loop(WR_CNT+1,
                cb = Writers_set[i];
                ((cb !== 0) && (lcbl === cb[its_Wrt_Lcbl])) ? (
                    // stop writer
                    cb[its_Wrt_Flgs] &= -1 ~ (its_WrtFlg_init | 2);
                    cb[its_Wrt_Buff_1] = 0;
                    cb[its_Wrt_Status] = its_WrtStat_Created;
                    its_Run_Check(cb);
                    cb[its_Wrt_Check] = 0;
                    cb[its_Wrt_Lcbl] = 0;
                    cb[its_Wrt_LineNb] = -1;
                );
                i += 1;
            );
            Lines_Set[lnum] = 0;
            defer ? Ln_Defer_Free(lcbl) : Ln_Free(lcbl);
            lnupdt = 1;
        );
        Lines_Set[lnum] = 0;
        ((its_LnFile !== 0) && !its_LnKeep) ? strcpy(its_LnFile[lnum], ""); // (no file any more ; its_Load_Install : kept)
    );
);
function Ln_Delete(lnum) ( Ln_Delete(lnum, 0); );

function Ln_Action(lnb, act, tmp)
local (lcbl, err)
(
    err = 0;
    ((lnb < 0) || (lnb > LN_CNT)) ? (
        err = 2607; // bad line number
    ) :
    (((lcbl = Lines_Set[lnb]) < BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ? (
        (lcbl === 0) ? (
            (act === its_LinAct_Create) ? (
                // can create using tmp
                (Ln_Make(lnb, srate, tmp[1], tmp[2]) <= BASE_MEMORY) ? err = 2610; // not enough memory
            );
        ) : (
            err = 2608; // the entry of the line is not a valid line
        );
    ) :
    (act === its_LinAct_Clear) ? (
        Ln_Clear(lnb);
        strcpy(its_LnFile[lnb], ""); // (the samples of the file are lost)
    ) :
    (act === its_LinAct_Delete) ? (
        Ln_Delete(lnb, 1); // (@gfx : the pad of the line)
    ) :
    (
        err = 2609; // unknown action (or "Create" on an existing line)
    );
    (err != 0) ? (
        // (2610 : already written by Ln_Make)
        (err != 2610) ? (
            sprintf(#itm, "Error %04d : line %d, action %d (Lines_Set : %d)", err, lnb+1, act, Lines_Set[lnb]);
            mSL_log(SysLogBox, #itm);
        );
    );
    err;
);


// Ln_MemErr[line] : 1 when the last creation of the line failed for lack of memory, error 2610 (see Ln_Make, show_Line_Pad)
Ln_MemErr = make_array(LN_CNT+1);

// its_LnFile[line] : the string of the sound file read into the line (full path ; "" : none), see Ln_Load_File, File_Handle ;
// cleared when the line is deleted, replaced or cleared ; saved in the preset ('lfil' blocks)
its_LnFile = make_array(LN_CNT+1);
