            k = c; loop(w, wr ? (its_PchW[k] += 1) : (its_PchR[k] += 1); k += 1;);
        ) :
        ((its_PchCell < c + w) && (its_PchCell + its_PchCellW > c)) ? (
            sprintf(#its_PchTmp, "%s %d %s", kind, n + 1, role);
            // the menu of the cell (right clic in the module "Connections") : the module, kind 'R', 'W' or 'E'
            (its_PchLstN < its_PchLstMx) ? (
                its_PchLstT[its_PchLstN] = str_getchar(kind, 0, 'cu');
                its_PchLstM[its_PchLstN] = n;
                sprintf(menu_Pch_Mods[ui_jmenu_items + its_PchLstN], "*-----%s %d : %s", kind, n + 1, role);
                its_PchLstN += 1;
            );
            wr ? (
                (strlen(#its_PchWs) > 0) ? strcat(#its_PchWs, ", ");
                strcat(#its_PchWs, #its_PchTmp);
            ) : (
                (strlen(#its_PchRs) > 0) ? strcat(#its_PchRs, ", ");
                strcat(#its_PchRs, #its_PchTmp);
            );
        );
    );
);

// the modulation inputs "mp" (n inputs, names "names", meaningful "okm") of the module "kind" n° "num"
function its_Pch_Mods(mp, n, names, okm, kind, num)
local (j, p)
(
    j = 0; loop(n,
        p = mp + j * its_ModDist;
        its_Mod_Used(mp, j, okm) ? its_Pch_Use(p[its_Mod_Src], p[its_Mod_Off], its_Src_Cell(p[its_Mod_Src], p[its_Mod_Off], 1), 1, 0,
            kind, num, names[j]);
        j += 1;
    );
);

function its_Patch_Scan(cell)
local (i, b, w, f, n, ty, p)
(
    its_PchCell = cell;
    (cell === -2) ? (
        memset(BusNeed, 0, NB_BUS);
    ) :
    (cell === -1) ? (
        memset(its_PchW, 0, SMPL_SIZE);
        memset(its_PchR, 0, SMPL_SIZE);
        its_PchBad = 0;
    ) : (
        strcpy(#its_PchWs, "");
        strcpy(#its_PchRs, "");
        its_PchLstN = 0;
    );
    i = 0; loop(RD_CNT,
        b = Readers_set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_read)) ? (
            w = its_Rdr_OutWidth(b);
            its_Pch_Use(b[its_Rdr_OutK], b[its_Rdr_OutOff],
                its_Out_Cell(b[its_Rdr_OutK], b[its_Rdr_OutOff], w, CblRdStart[i], CblRdWidth[i]), w, 1, "Reader", i, "output");
            its_Pch_Mods(b + its_Rdr_Mod1, its_Rdr_ModN, its_ModN_Rdr, its_Rdr_ModOk(b), "Reader", i);
        );
        i += 1;
    );
    i = 0; loop(WR_CNT,
        b = Writers_set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_writ)) ? (
            f = max(0, min(b[its_Wrt_ChNbr] - 1, b[its_Wrt_Bf1stChan]));
            n = b[its_Wrt_ChNbr] - f;
            (b[its_Wrt_BfChanUsed] > 0) ? (n = min(n, b[its_Wrt_BfChanUsed]));
            (n > 0) ? its_Pch_Use(b[its_Wrt_Src], b[its_Wrt_SrcOff], its_Src_Cell(b[its_Wrt_Src], b[its_Wrt_SrcOff], n), n, 0,
                "Writer", i, "input");
            its_Pch_Mods(b + its_Wrt_Mod1, its_Wrt_ModN, its_ModN_Wrt, its_Wrt_ModOk(b), "Writer", i);
        );
        i += 1;
    );
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_effx) && (its_Fx_NSrc(ty = b[its_Efx_Type]) >= 0)) ? (
            w = max(1, min(128, floor(b[its_Efx_CCnt])));
            its_Pch_Use(b[its_Efx_OutK], b[its_Efx_OutOff],
                its_Out_Cell(b[its_Efx_OutK], b[its_Efx_OutOff], w, CblFxStart[i], CblFxWidth[i]), w, 1, "Effect", i, "output");
            n = 0; p = b + its_Efx_Src1; loop(its_Fx_NSrc(ty),
                w = its_Fx_SrcWj(b, n, p[0], p[its_Efx_Off1 - its_Efx_Src1]);
                (p[0] !== 0) ? its_Pch_Use(p[0], p[its_Efx_Off1 - its_Efx_Src1], its_Src_Cell(p[0], p[its_Efx_Off1 - its_Efx_Src1], w), w, 0,
                    "Effect", i,
                    (its_Fx_NSrc(ty) > 1) ? sprintf(#its_PchRole, "source %d", n + 1) : (ty === its_Efx_TyRandom) ? "trigger" : "source");
                n += 1; p += its_EfxDist;
            );
            (ty === its_Efx_TyFilter) ? its_Pch_Mods(b + its_Efx_Mod1, 2, its_ModN_Flt, its_Flt_ModOk(b), "Effect", i) :
            (ty === its_Efx_TySat) ? its_Pch_Mods(b + its_Efx_Mod1, 3, its_ModN_Sat, its_Sat_ModOk(b), "Effect", i) :
            its_Mx_Is(ty) ? its_Pch_Mods(b + its_Efx_Mod1, 3, its_ModN_Mx, its_Mx_ModOk(b), "Effect", i) :
            its_Fl_Is(ty) ? its_Pch_Mods(b + its_Efx_Mod1, 3, its_ModN_Fl, 7, "Effect", i) :
            (ty === its_Efx_TyPhaser) ? its_Pch_Mods(b + its_Efx_Mod1, 3, its_ModN_Ph, 7, "Effect", i) :
            (ty === its_Efx_TyNoise) ? its_Pch_Mods(b + its_Efx_Mod1, 3, its_ModN_Nz, its_Nz_ModOk(b), "Effect", i) :
            (ty === its_Efx_TyRandom) ? its_Pch_Mods(b + its_Efx_Mod1, 3, its_ModN_Rn, 7, "Effect", i) :
            (ty === its_Efx_TyMath) ? its_Pch_Mods(b + its_Efx_Mod1, 3, its_ModN_Mt, its_Mt_ModOk(b), "Effect", i) :
            (ty === its_Efx_TyRing) ? its_Pch_Mods(b + its_Efx_Mod1, 3, its_ModN_Rg, its_Rg_ModOk(b), "Effect", i);
        );
        i += 1;
    );
);

/*
    the cables follow the modules : called at each frame of @gfx (and forced after a load)
    a reader or an effect whose output is its own cable gets a cable of its width, a bus used gets the width that its
    users ask (first channel + width), a bus no longer used is freed ; after a change, all the modules are checked again
    (their cells are computed again by exec_reader, exec_writer, exec_fx)
*/
function its_Patch_Update()
local (i, b, w, wk, chg, n)
(
    chg = its_PatchForce;
    its_PatchForce = 0;
    i = 0; loop(RD_CNT,
        b = Readers_set[i];
        w = ((b > BASE_MEMORY) && (b[-2] === KW_read) && (b[its_Rdr_OutK] === 0)) ? its_Rdr_OutWidth(b) : 0;
        (w !== CblRdWidth[i]) ? (
            Cbl_Free(CblRdStart[i], CblRdWidth[i]);
            CblRdStart[i] = (w > 0) ? Cbl_Alloc(w) : 0;
            CblRdWidth[i] = w;
            chg = 1;
        );
        i += 1;
    );
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        w = ((b > BASE_MEMORY) && (b[-2] === KW_effx) && (b[its_Efx_OutK] === 0)) ? max(1, min(128, b[its_Efx_CCnt])) : 0;
        (w !== CblFxWidth[i]) ? (
            Cbl_Free(CblFxStart[i], CblFxWidth[i]);
            CblFxStart[i] = (w > 0) ? Cbl_Alloc(w) : 0;
            CblFxWidth[i] = w;
            chg = 1;
        );
        i += 1;
    );
    // the buses
    its_Patch_Scan(-2);
    i = 0; loop(NB_BUS,
        w = min(128, BusNeed[i]);
        (w !== BusWidth[i]) ? (
            Cbl_Free(BusStart[i], BusWidth[i]);
            BusStart[i] = (w > 0) ? Cbl_Alloc(w) : 0;
            BusWidth[i] = w;
            chg = 1;
        );
        i += 1;
    );
    (chg) ? (
        // the buses cleared at each sample (@sample)
        n = 0; i = 0; loop(NB_BUS,
            (BusStart[i] > 0) ? (BusAct[n] = i; n += 1;);
            i += 1;
        );
        BusActN = n;
    );
    // the work areas of the effects : a new one when the size changes (not during a load : @block replaces the effects)
    (perform_loading === 0) ? (
        i = 0; loop(FX_CNT,
            b = Effects_set[i];
            ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? (
                (b[its_Efx_WkOld] > BASE_MEMORY) ? (
                    mSL_Dyn_Free(b[its_Efx_WkOld]); // replaced by @block before the current audio block
                    b[its_Efx_WkOld] = 0;
                ) :
                (b[its_Efx_WkNew] === 0) ? (
                    w = its_Fx_WorkSize(b);
                    wk = b[its_Efx_Work];
                    (w !== ((wk > BASE_MEMORY) ? wk[its_FxW_Size] : 0)) ? (
                        (w === 0) ? (
                            b[its_Efx_WkNew] = -1; // no more area
                        ) : (
                            wk = mSL_Dyn_Alloc(w, KW_fxwk, mSL_StM_FlClear);
                            (wk > BASE_MEMORY) ? (
                                wk[its_FxW_Size] = w;
                                b[its_Efx_WkNew] = wk;
                            );
                        );
                    );
                );
            );
            i += 1;
        );
        // the work areas of the readers in mode Stretch (the same way ; not the copy, Readers_set[RD_CNT])
        i = 0; loop(RD_CNT,
            b = Readers_set[i];
            ((b > BASE_MEMORY) && (b[-2] === KW_read)) ? (
                (b[its_Rdr_WkOld] > BASE_MEMORY) ? (
                    mSL_Dyn_Free(b[its_Rdr_WkOld]); // replaced by @block before the current audio block
                    b[its_Rdr_WkOld] = 0;
                ) :
                (b[its_Rdr_WkNew] === 0) ? (
                    w = its_Rd_WorkSize(b);
                    wk = b[its_Rdr_Work];
                    (w !== ((wk > BASE_MEMORY) ? wk[its_RdW_Size] : 0)) ? (
                        (w === 0) ? (
                            b[its_Rdr_WkNew] = -1; // no more area
                        ) : (
                            wk = mSL_Dyn_Alloc(w, KW_rdwk, mSL_StM_FlClear);
                            (wk > BASE_MEMORY) ? (
                                wk[its_RdW_Size] = w;
                                b[its_Rdr_WkNew] = wk;
                            );
                        );
                    );
                );
            );
            i += 1;
        );
    );
    (chg) ? (
        its_PatchV += 1;
        i = 0; loop(RD_CNT+1, ((b = Readers_set[i]) > BASE_MEMORY) ? (b[its_Rdr_Check] = 0); i += 1;);
        i = 0; loop(WR_CNT+1, ((b = Writers_set[i]) > BASE_MEMORY) ? (b[its_Wrt_Check] = 0); i += 1;);
        i = 0; loop(FX_CNT+1, ((b = Effects_set[i]) > BASE_MEMORY) ? (b[its_Efx_Check] = 0); i += 1;);
    );
);


/*
    The execution order of the effects in @sample : in each phase, an effect runs after the effects whose output it reads (their
    own cable, a bus, Out : sources and modulation inputs) ; the effects of a loop (feedback) keep the order of their numbers
    (one sample of delay), and so do the independent ones. Computed by @gfx (its_Fx_Order, when its signature changes), used by
    its_Run_Schedule : its_FxOrd[0 ... FX_CNT-1], the effects that exist first.
*/
its_FxOrd = make_array(FX_CNT);
i__ii = 0; loop(FX_CNT, its_FxOrd[i__ii] = i__ii; i__ii += 1;);
its_FxLst = make_array(FX_CNT); // the effects that exist
its_FxWK = make_array(FX_CNT); // the key of the cells each one writes (its_Fx_WKey)
its_FxDeg = make_array(FX_CNT); // the count of the effects not yet placed that it reads
its_FxDone = make_array(FX_CNT); // 1 : placed (index in its_FxLst) ; then, by number : in the order
its_FxDep = make_array(FX_CNT * FX_CNT); // its_FxDep[a * FX_CNT + b] : its_FxLst[a] reads its_FxLst[b] (the same phase)
its_FxSig = -1; // the signature of the last computation
its_FxCycN = 0; // the effects placed in a loop (feedback) at the last computation

// the key of the cells written by the effect "fx" (number "n") : its own cable, or its output (Out, a bus)
function its_Fx_WKey(fx, n)
(
    (fx[its_Efx_OutK] === 0) ? ITS_KFx * ITS_KMul + n :
    (floor(fx[its_Efx_OutK] / ITS_KMul) === ITS_KOut) ? ITS_KOut * ITS_KMul : fx[its_Efx_OutK];
);

// a source as a key of cells (Out : all its channels)
function its_Fx_RKey(s) ( (floor(s / ITS_KMul) === ITS_KOut) ? ITS_KOut * ITS_KMul : s; );

// the effect "fx" reads the key "wk" (one of its sources, one of its modulation inputs)
function its_Fx_Reads(fx, wk)
local (r, j, p, ns, nm)
(
    r = 0;
    ns = max(0, its_Fx_NSrc(fx[its_Efx_Type]));
    p = fx + its_Efx_Src1; j = 0;
    while (!r && (j < ns)) ( r = (p[0] !== 0) && (its_Fx_RKey(p[0]) === wk); p += its_EfxDist; j += 1; );
    nm = (fx[its_Efx_Type] === its_Efx_TyFilter) ? 2 :
        ((fx[its_Efx_Type] === its_Efx_TySat) || its_Mx_Is(fx[its_Efx_Type]) || its_Fl_Is(fx[its_Efx_Type])
        || (fx[its_Efx_Type] === its_Efx_TyPhaser) || (fx[its_Efx_Type] === its_Efx_TyNoise)
        || (fx[its_Efx_Type] === its_Efx_TyRandom) || (fx[its_Efx_Type] === its_Efx_TyMath)
        || (fx[its_Efx_Type] === its_Efx_TyRing)) ? 3 : 0;
    p = fx + its_Efx_Mod1; j = 0;
    while (!r && (j < nm)) ( r = (p[its_Mod_Src] !== 0) && (its_Fx_RKey(p[its_Mod_Src]) === wk); p += its_ModDist; j += 1; );
    r;
);

// the signature of what the order depends on : the effects that exist, their type, phase, output, sources, modulation inputs
function its_Fx_OrdSig()
local (i, j, b, p, g, sg)
(
    sg = 0;
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? (
            g = 1 + b[its_Efx_Type] * 11 + b[its_Efx_Phase] * 7 + b[its_Efx_OutK] * 3;
            p = b + its_Efx_Src1; j = 0; loop(8, g += p[0] * (j + 13); p += its_EfxDist; j += 1;);
            p = b + its_Efx_Mod1; j = 0; loop(3, g += p[its_Mod_Src] * (j + 31); p += its_ModDist; j += 1;);
            sg += (i + 1) * g;
        );
        i += 1;
    );
    sg;
);

// @gfx : the order, computed again when its signature changes (the previous one taken by @block)
function its_Fx_Order()
local (sg, m, a, b, fa, fb, k, best, i)
(
    ((sg = its_Fx_OrdSig()) !== its_FxSig) ? (
        its_FxSig = sg;
        m = 0; i = 0; loop(FX_CNT,
            b = Effects_set[i];
            ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? ( its_FxLst[m] = i; its_FxWK[m] = its_Fx_WKey(b, i); m += 1; );
            i += 1;
        );
        // the dependencies, in the same phase
        a = 0; loop(m,
            fa = Effects_set[its_FxLst[a]];
            its_FxDeg[a] = its_FxDone[a] = 0;
            b = 0; loop(m,
                fb = Effects_set[its_FxLst[b]];
                k = (a !== b) && (fa[its_Efx_Phase] === fb[its_Efx_Phase]) && its_Fx_Reads(fa, its_FxWK[b]);
                its_FxDep[a * FX_CNT + b] = k;
                its_FxDeg[a] += k;
                b += 1;
            );
            a += 1;
        );
        // the next one : the first whose dependencies are placed ; none : a loop, the first one not placed
        its_FxCycN = 0;
        k = 0; loop(m,
            best = -1; a = 0; while ((best < 0) && (a < m)) ( ((its_FxDone[a] === 0) && (its_FxDeg[a] === 0)) ? (best = a); a += 1; );
            (best < 0) ? (
                a = 0; while ((best < 0) && (a < m)) ( (its_FxDone[a] === 0) ? (best = a); a += 1; );
                its_FxCycN += 1;
            );
            its_FxDone[best] = 1;
            its_FxOrd[k] = its_FxLst[best];
            fb = Effects_set[its_FxLst[best]];
            (fb > BASE_MEMORY) ? (fb[its_Efx_Rank] = k); // (its rank in the order)
            k += 1;
            a = 0; loop(m, ((its_FxDone[a] === 0) && its_FxDep[a * FX_CNT + best]) ? (its_FxDeg[a] -= 1); a += 1;);
        );
        // then the other numbers
        memset(its_FxDone, 0, FX_CNT);
        a = 0; loop(k, its_FxDone[its_FxOrd[a]] = 1; a += 1;);
        i = 0; loop(FX_CNT, (its_FxDone[i] === 0) ? ( its_FxOrd[k] = i; k += 1; ); i += 1;);
    );
);

// the effects of phase "ph" that are active, in the order its_FxOrd, put in the list "w" from "n" ; returns the new "n"
function its_Run_AddFx(w, n, ph)
local (i, b)
(
    i = 0; loop(FX_CNT,
        b = Effects_set[its_FxOrd[i]];
        ((b > BASE_MEMORY) && (b[its_Run_Kind] === its_RunK_Effect) && (b[its_Efx_Phase] === ph) && its_Run_Active(b)) ? (
            w[n] = b; n += 1;
        );
        i += 1;
    );
    n;
);

/*
    @gfx : the list of the modules executed by @sample, built again in the work list ; published (its_RunX) when it changes,
    or when a deleted block waits for it. The work list is free once @sample uses the last list published : two audio blocks
    later (@block and @sample run in sequence), or after 1 s without audio. Order : Clear, Input, the effects "Pre", the
    readers, the effects "Std", the writers, the effects "Post", Output. A module started again after a stop (delay < 0) gets
    the delay 0.
*/
function its_Run_Schedule()
local (w, n, i, b, chg)
(
    // the own cables of the modules that no longer run (written once more after its_Run_Check)
    i = 0; loop(RD_CNT, (((b = Readers_set[i]) > BASE_MEMORY) && (its_Run_Active(b) == 0)) ? its_Run_Silent(b); i += 1;);
    i = 0; loop(FX_CNT, (((b = Effects_set[i]) > BASE_MEMORY) && (its_Run_Active(b) == 0)) ? its_Run_Silent(b); i += 1;);
    ((its_BlkCnt - its_RunPubBlk >= 2) || (time_precise() - its_RunPubT > 1)) ? (
        w = its_RunWrk; n = 0;
        w[n] = its_RunClr; n += 1;
        w[n] = its_RunInp; n += 1;
        n = its_Run_AddFx(w, n, its_Efx_PhasePre);
        i = 0; loop(RD_CNT,
            (((b = Readers_set[i]) > BASE_MEMORY) && (b[its_Run_Kind] === its_RunK_Reader) && its_Run_Active(b)) ? ( w[n] = b; n += 1; );
            i += 1;
        );
        n = its_Run_AddFx(w, n, its_Efx_PhaseStd);
        i = 0; loop(WR_CNT,
            (((b = Writers_set[i]) > BASE_MEMORY) && (b[its_Run_Kind] === its_RunK_Writer) && its_Run_Active(b)) ? ( w[n] = b; n += 1; );
            i += 1;
        );
        n = its_Run_AddFx(w, n, its_Efx_PhasePost);
        w[n] = its_RunOut; n += 1;
        w[n] = 0;
        chg = its_RunTrW;
        i = 0; while ((chg === 0) && (i <= n)) ( (w[i] !== its_RunExe[i]) ? (chg = 1); i += 1; );
        // the modules started again
        i = 0; loop(n, b = w[i]; ((b[its_Run_Delay] < 0) && (b[its_Run_Kind] !== its_RunK_None)) ? (b[its_Run_Delay] = 0); i += 1;);
        chg ? (
            its_RunX = w;
            its_RunWrk = its_RunExe; its_RunExe = w;
            its_RunPubN += 1; its_RunPubBlk = its_BlkCnt; its_RunPubT = time_precise();
        );
    );
);

/*
    @gfx : free the deleted blocks (its_Run_Free). A block deleted when its_RunPubN was N may be in the list N (published)
    and in the list N+1 (built before its deletion) : it is freed once the list N+2 is the one @sample uses.
*/
function its_Run_TrashRun()
local (i, b, ok)
(
    ok = (its_BlkCnt - its_RunPubBlk >= 2) || (time_precise() - its_RunPubT > 1);
    its_RunTrW = 0;
    i = 0; loop(its_RunTrSz,
        ((b = its_RunTrB[i]) > 0) ? (
            (ok && (its_RunTrN[i] + 2 <= its_RunPubN)) ? (
                (b[-2] === KW_effx) ? its_Fx_WorkFree(b);
                (b[-2] === KW_read) ? its_Rd_WorkFree(b);
                mSL_Dyn_Free(b);
                its_RunTrN[i] = 10^30;
                its_RunTrB[i] = 0;
            ) :
            (its_RunTrN[i] + 2 > its_RunPubN) ? (its_RunTrW = 1); // (10^30 : being filled, published later)
        );
        i += 1;
    );
    (its_RunTrLost > 0) ? (
        sprintf(#its_RunTrM, "Error 2791 : %d deleted modules not freed (trash full)", its_RunTrLost);
        mSL_log(SysLogBox, #its_RunTrM);
        its_RunTrLost = 0;
    );
);




// The module "Connections" (see its_Patch_Scan) : count of the writers and of the readers of each cell
its_PchW = make_array(SMPL_SIZE);
its_PchR = make_array(SMPL_SIZE);
its_PchCbl = make_array(RD_CNT + FX_CNT); // the own cables that exist (see its_Pch_Cables)
its_PchLstMx = 32; // the modules that write or read a cell (its_Patch_Scan(cell)) : kind ('R', 'W', 'E'), number
its_PchLstT = make_array(its_PchLstMx);
its_PchLstM = make_array(its_PchLstMx);
its_PchLstN = 0;

mm_limit_a = make_array(2);
mm_limit_a[0] = 'STRT'; mm_limit_a[1] = 'MEMR';


// size : all the memory left under __memtop() (options:maxmem), but a reserve for the static allocations
// made after this one (see the memory written in the log at start : "free after the static allocations")
C_memrReserve = 512 * 1024; // 2026-10-20 : 0.02 MW used after this allocation
C_memrSize = floor(__memtop() - mSL_StM_FreePt - C_memrReserve);
C_memrArea = make_array(C_memrSize); // THE DYNAMIC MEMORY !

mm_limit_b = make_array(2);
mm_limit_b[0] = 'END_'; mm_limit_b[1] = 'MEMR';


// Build the dynamic memory
mSL_errX = mSL_errC = mSL_errM = 0;
mSL_current_memory = mSL_new_memory = 0; // make sure it is clear
AAAAC_5 = mSL_make_memory(C_memrArea, C_memrSize);

memoryBox1[7] = memoryBox2[7] = AAAAC_5 - 2; // actual start

mm_lowmem = mSL_new_memory + mSL_new_memory[mSL_MM_LowAd];
mm_highmem = mSL_new_memory + mSL_new_memory[mSL_MM_HighAd];
// mm_sizmem = max(1, mm_highmem - mm_lowmem);
mm_show_ttf = mm_sizmem = mSL_new_memory[mSL_MM_MemSiz];


mm_limit_f = make_array(2);
mm_limit_f[0] = 'STRT'; mm_limit_f[1] = 'COMP';

void_pointer = make_array(2);
void_pointer[0] = 0;
void_pointer[1] = 0;

// Provide an independent main symbol table for the compiler - "var" declarations
aprime = 3313;
size = 4 * (aprime + 1);
i__mem = make_array(size + 4);
A_mSL_GCTab = mSL_buildGVTab(i__mem, size, aprime);


// Try to provide an independent local symbol table for the compiler - "loc" declarations
aprime = 191;
size = 4 * (aprime + 1);
i__mem = make_array(size + 4);
A_mSL_LCTab = mSL_buildLCTab(i__mem, size, aprime);


// Provide a common external symbol table for the compiler - "ext" declarations
A_mSL_EXTab = mSL_buildEXTab(47);
// Provide a common external symbol table for the compiler - "ptr" declarations
A_mSL_PTTab = mSL_buildPTTab(47);

// Build the compiler
AAAAC_6 = mSL_make_compiler(C_compArea, C_compSize);
// Then, the interpreter
AAAAC_7 = mSL_make_evaluator(C_progArea, C_progSize);
mSL_new_thread = 0;

mm_limit_g = make_array(2);
mm_limit_g[0] = 'END_'; mm_limit_g[1] = 'COMP';




handling_load = 0;
perform_loading = 0;
flg_clear_input = 0;
str_mess = "New message";
// Messages : the strings 16 to 32 are used in turn (str_mess is reset to 0 once displayed, see @gfx)
str_mess_n = 15;
function str_mess_slot()
(
    str_mess_n = ((str_mess_n < 16) || (str_mess_n >= 32)) ? 16 : str_mess_n + 1;
);
str_mess_prv = "Previous message";
ctime = 0;
pgmode = 0; // plug-in mode : merge (its_GlSmpl, see its_Gl_Apply)
vol_inp = 1; // global gain - entrée
its_InGainLow = -60; // below (dB) : the input is shown as almost muted (Globals : the cell "Channels" in red ; Connections : the cells In)
vol_out = 1; // global volume - sortie

// Return a unique time stamp
function ts()
local (pxtime, pftime)
(
    /*
    (pftime != (ctime%10000)) ? (
        pftime = (ctime%10000);
        pxtime = 0;
    ) : (
        pxtime += 1/1024;
    );
    pftime + pxtime;
    */
    pftime += 1;
);




// (a parameter of another application : its value in gmem, see mSL_gmem_map)
function parGetV(xp)
local (val, act)
(
    xp = 0|max(0,min(paramGCount - 1,xp)); // minimalistic check
    val = ((xp >= paramBase) && (xp <= paramNMax)) ? paramValues[xp] : gmem[paramGCopy+xp];
);

function parSet(xop, value)
local (f, pp, pq, pv, fspect)
(
    xop = 0|max(paramBase,min(paramNMax,xop)); // minimalistic check
    pv = paramValues[xop]; // previous value
);

/*
    Implementation of the mSL "get"
*/
function mSL_get(argc, argv)
local (pfid, ref, addr, res, flg, kod, size, s, ip, k, k2, pt, kid, pid)
(
    pfid = argv[0]; ref = argv[1];
    res = addr = flg = 0;
    kod = size = -1;
    kid = (argc > 1) && (((ref > mSL_Sym_Low) && (ref < mSL_Sym_High)) || ((ref >= mSL_MKey_min) && (ref <= mSL_MKey_max)));

    // is this a keyword ?
    ((pfid > mSL_Sym_Low) && (pfid < mSL_Sym_High)) ? (
        (FlagsTbVals[Flgs_PrOps] & 1) ? (
            // just for trace
            strcpy(#sZ0, mSL_id2Str(pfid));
            (argc <= 1) ? (
                sprintf(#sfc, "mSL_get[%d]  \"%s\".", argc, #sZ0);
            ) :
            (
                sprintf(#sfc, "mSL_get[%d]  \"%s\"  \"%s\" / %d", argc, #sZ0, mSL_edit_value(#sZ1, ref), kid);
            );
            mSL_log(SysLogBox, #sfc);
        );
        pid = -1;
        ((pfid === mSL_KW_JSFX) || (pfid === mSL_KW_jsfx_) || (pfid === mSL_KW_GM) || (pfid === mSL_KW_GM_)) ? (
            // acces a JSFX variable
            res = mSL_vGet(ref);
        ) :
        ((pfid === mSL_KW_JSFXref) || (pfid === mSL_KW_jsfxref_)) ? (
            // acces a JSFX variable reference
            res = mSL_get_var_idt(ref);
        ) :
        (pfid === mSL_KW_PNum) ? (
            // Get a parameter number
            (kid && ((k = mSL_getinHT(paramHashTbl, ref)) >= 0)) ? (
                pid = mSL_getinHTaux; // use the auxiliary result = param number
            );
            res = pid;
        ) :
        (pfid === mSL_KW_ParamV) ? (
            // get a parameter value
            pid = 0; k = -2; // for now
            // Get the value of a parameter by name or by number
            (kid) ? (
                // look for the ident. in a table
                ((k = mSL_getinHT(paramHashTbl, ref)) >= 0) ? (
                    pid = mSL_getinHTaux;
                );
            ) :
            ((ref >= 0) && (ref < paramGCount)) ? ( // (a number of any application, see mSL_gmem_map)
                pid = ref;
            );
            (pid >= 0) ? (
                res = parGetV(pid);
            );
            // sprintf(#sfc, "Get Param  %d / %d =>  %f", pid, k, res);
            // mSL_log(SysLogBox, #sfc);
        ) :
        (pfid === mSL_KW_Host) ? (
            res = the_host;
        ) :
        //(pfid === mSL_KW_vars) ? (
        //    // return the "vars" array
        //    res = mSL_baseAVars;
        //) :
        //(pfid === mSL_KW_locs) ? (
        //    // return the "locs" array
        //    res = mSL_baseOVars;
        //):
        (
            res = mSL_vGet(pfid);
        );
    ) : (
        // Is the first parameter the address of a table ?
        (((addr = pfid) > 2) && ((kod = addr[-2]) >= mSL_MKey_min) && ((s = addr[-1]) > 0)
            && (s === addr[s]) && (((k2 = addr[s+1]) === mSL_End_Mark) || (k2 === (kod ~ mSL_CC_Chksum)))) ? (
                flg = 1; size = s;
        ) :
        // Is this the "raw" address of a table ?
        (((addr = pfid + 2) > 2) && ((kod = addr[-2]) >= mSL_MKey_min) && ((s = addr[-1]) > 0)
            && (s === addr[s]) && (((k2 = addr[s+1]) === mSL_End_Mark) || (k2 === (kod ~ mSL_CC_Chksum)))) ? (
                flg = 1; size = s;
        ) :
        // Let's consider it as a simple pointer...
        (
            addr = pfid; // don't know much more
            size = 0x1000000; // default access...
        );


        (kid) ? (
            // look for an entry in the table
            ip = 0; k = addr[ip];
            (flg && ((ref === 'size') || (ref === mSL_KW_size))) ? (
                res = size; flg = 0;
            );
            (flg && ((ref === 'type') || (ref === mSL_KW_type))) ? (
                res = kod; flg = 0;
            );
            while (flg && (((k > mSL_Sym_Low) && (k < mSL_Sym_High)) || ((k >= mSL_MKey_min) && (k <= mSL_MKey_max)))) (
                (ip >= size) ? (
                    flg = 0;
                ) :
                (k === ref) ? (
                    res = addr[ip+1]; flg = 0;
                ) :
                (
                    ip += 2; k = addr[ip];
                );
            );
        ) :
        ((addr >= 0) && ((pt = addr + ref) >= 0)) ? (
            (pt < mSL_lastmemory) ? (
                res = pt[0];
            );
        ) :
        (addr < 0) ? (
            (((pt = -addr + ref) > 0) && (pt < 0x8000000)) ? (
                res = gmem[pt];
            );
        );

    );
    res;
);

/*
    Set the value of field ; return previous one
*/
function mSL_set(argc, argv)
local (pfid, ref, value, force, addr, res, flg, kod, size, s, ip, k, k2, pt, kid)
(

    pfid = argv[0]; ref = argv[1]; value = argv[2]; force = argv[3];
    res = addr = flg = 0;
    kod = size = -1;
    kid = (argc > 1) && (((ref > mSL_Sym_Low) && (ref < mSL_Sym_High)) || ((ref >= mSL_MKey_min) && (ref <= mSL_MKey_max)));

    // is this a keyword ?
    ((pfid > mSL_Sym_Low) && (pfid < mSL_Sym_High)) ? (
        (FlagsTbVals[Flgs_PrOps] & 1) ? (
            strcpy(#sZ0, mSL_id2Str(pfid));
            sprintf(#sfc, "mSL_set[%d]  \"%s\"  \"%s\" / %d    %g",argc, #sZ0, mSL_edit_value(#sZ1, ref), kid, value);
            mSL_log(SysLogBox, #sfc);
        );
        ((pfid === mSL_KW_JSFX) || (pfid === mSL_KW_jsfx_) || (pfid === mSL_KW_GM) || (pfid === mSL_KW_GM_)) ? (
            // acces a JSFX variable
            (argc > 2) ? (
                res = mSL_vSet(ref, value);
            );
        ) :
        (pfid === mSL_KW_ParamV) ? (
            pid = -1; // for now
            // Get the value of a parameter by name or by number
            (kid) ? (
                // look for the ident. in a table
                ((k = mSL_getinHT(paramHashTbl, ref)) >= 0) ? (
                    pid = mSL_getinHTaux; // use the auxiliary result
                );
            ) :
            ((ref >= 0) && (ref < paramGCount)) ? ( // (a number of any application, see mSL_gmem_map)
                pid = ref;
            );
            // Set the value of a parameter (of this application : the others are read only)
            (pid >= 0) ? (
                res = parGetV(pid);
                ((pid >= paramBase) && (pid <= paramNMax)) ? (
                    parSet(pid, value);
                ) :
                (parOwnErr === 0) ? (
                    parOwnErr = 1; // said once
                    mSL_log(SysLogBox, "ERR: 0621    set(`ParamV, ...) : this parameter belongs to another application");
                );
            );
        ) :
        (
            (argc > 1) ? (
                res = mSL_vSet(pfid, ref);
            );
        );
    ) : (
        // Is this a table ?
        (((addr = pfid) > 2) && ((kod = addr[-2]) >= mSL_MKey_min) && ((s = addr[-1]) > 0)
            && (s === addr[s]) && (((k2 = addr[s+1]) === mSL_End_Mark) || (k2 === (kod ~ mSL_CC_Chksum)))) ? (
                flg = 1; size = s;
        ) :
        (((addr = pfid + 2) > 2) && ((kod = addr[-2]) >= mSL_MKey_min) && ((s = addr[-1]) > 0)
            && (s === addr[s]) && (((k2 = addr[s+1]) === mSL_End_Mark) || (k2 === (kod ~ mSL_CC_Chksum)))) ? (
                flg = 1; size = s;
        ) :
        (
            addr = pfid; // don't know much more
            size = 0x1000000; // default access...
        );

        (((ref > mSL_Sym_Low) && (ref < mSL_Sym_High)) || ((ref >= mSL_MKey_min) && (ref <= mSL_MKey_max))) ? (
            // look for an entry in the table
            ip = 0; k = addr[ip];
            (flg && ((ref === 'type') || (ref === mSL_KW_type)) && (force & 1) && (value >= mSL_MKey_min) && (value <= mSL_MKey_max)) ? (
                flg = 0;  addr[-2] = value; addr[s+1] = value ~ mSL_CC_Chksum;
            );
            while (flg && (((k > mSL_Sym_Low) && (k < mSL_Sym_High)) || ((k >= mSL_MKey_min) && (k <= mSL_MKey_max)))) (
                (k === ref) ? (
                    res = addr[ip+1];
                    addr[ip+1] = value;
                    flg = 0;
                ) :
                (ip >= size) ? (
                    flg = 0;
                ) : (
                    ip += 2; k = addr[ip];
                );
            );
            (flg && (force & 1)) ? (
                // try to create the entry
                ip = 0; flg = 1;
                while (flg) (
                    (ip >= size) ? (
                        flg = 0;
                    ) :
                    (addr[ip] === 0) ? (
                        addr[ip] = ref;
                        addr[ip+1] = res = value;
                        flg = 0;
                    ) :
                    (
                        ip += 2; k = addr[ip];
                    );
                );
            );
        ) :
        ((addr >= 0) && ((pt = addr + ref) >= 0)) ? (
            (pt < mSL_lastmemory) ? (
                // but this may write anywhere in the memory !
                res = pt[0];
                pt[0] = value;
            );
        ) :
        (addr < 0) ? (
            (((pt = -addr + ref) > 0) && (pt < 0x8000000)) ? (
                // but this may write anywhere in the shared memory !
                res = gmem[pt];
                gmem[pt] = value;
            );
        );
    );
    res;
);






// Read & Compile a mSL script file
function mSL_load_file_inGFX(fname)
local (fhd, ent, thrd, s, mSL_baseAVars, mSL_baseOVars, mSL_basePVars, mSL_load_start, mSL_load_end)
(
    mSL_load_start = gfxStartTime;
    mSL_errX = mSL_errC = mSL_errM = 0;
    ent = 0; fhd = -1;
    //(mSL_errC === 0) ? (
    //    SchedListEmpty(SchedInactPts) ? (
    //        mSL_errC = 2406; // can't get a thread
    //    );
    //);

    (FlagsTbVals[Flgs_Traces] & 4) ? (sprintf(#gfxu, "::-> Trying \"%s\"  %d", fname, mSL_errC); mSL_log(SysLogBox, #gfxu););

    (mSL_errC === 0) ? (
        fhd = GM_file_open(fname, FFlagsmSL);
        ((fhd >= 0)) ? (
            0 ? (sprintf(#gfxu, "::-> Using \"%s\"", #tmpFname); mSL_log(SysLogBox, #gfxu););
            // get a free thread
            (ent = getNewThread()) ? (
                thrd = SchedThrdPt[ent];
                AAAAAAAA_01_cp_rtc = mSL_compile(fhd, -1, -1, 0); // we add the input in the memory
                0 ? (sprintf(#gfxu, "::-> Compiled: %d lines   [Err:%d] [Thrd:%d/%d]", mSL_C_numLine, mSL_errC,ent,thrd);
                     mSL_log(SysLogBox, #gfxu););
                fhd = -1; // file has been closed by the compiler
                (mSL_errC === 0) ? (
                    AAAAAAAA_02_add = mSL_main_cod;
                    // This duplicates the work made in "mSL_init_thread" - TODO!!
                    (mSL_main_cod != 0) ? (
                        (FlagsTbVals[Flgs_Scripts] & 1) ? (
                            sprintf(#gfxu, "SZ(%d) %d, %d, %d", ent, (mSL_gvar+1) & mSL_NumMask, (mSL_ovar+1) & mSL_NumMask, (mSL_pvar+1) & mSL_NumMask);
                            mSL_log(SysLogBox, #gfxu);
                        );
                        // Let's copy appropriate vars tables in the thread references
                        thrd[mSL_THR_baseAVars] = mSL_baseAVars = mSL_main_cod[mSL_CC_GlbTab];
                        thrd[mSL_THR_baseOVars] = mSL_baseOVars = mSL_main_cod[mSL_CC_OwnTab];
                        thrd[mSL_THR_basePVars] = mSL_basePVars = mSL_main_cod[mSL_CC_PtrTab];
                        SchedStatus[ent] |= SchThrUsed;  // now in use
                        AAAAAAAA_ent = ent ;
                        SchedPar1[ent] = mSL_main_cod; // the code
                        // Keep tables info in the main code
                        // sprintf(#gfxu, "TH: %d, %d, [%d, %d, %d]", ent, thrd, mSL_baseAVars, mSL_baseOVars, mSL_basePVars);
                        (FlagsTbVals[Flgs_Scripts] & 1) ? (
                            sprintf(#gfxu, "TH(%d) [%d, %d]", ent, mSL_baseAVars, mSL_baseOVars);
                            mSL_log(SysLogBox, #gfxu);
                        );
                        SchedCode[ent] = KRun_mSL_Thread; // start running a thread
                        mSL_init_thread(ent); // perform initalization
                        // ADump(mSL_main_cod); // just a trace
                        mSL_errX = max(mSL_errX, max(mSL_errC, mSL_errM));
                        (mSL_errX === 0) ? (
                            (FlagsTbVals[Flgs_Scripts] & 1) ? (
                                sprintf(#gfxu, "Load OK - Ent: %d", ent);
                                mSL_log(SysLogBox, #gfxu);
                            );
                        );
                        mSL_High_Stack = mSL_max_TOS = 0;
                    ) : (
                        mSL_errX = 2409; // no code generated
                    );
                );
                // GMW2("D");
            ) : (
                mSL_errX = 2410; // no thread available
            );
        ) : (
            mSL_errX = 2405; // can't open
        );
    );

    (mSL_C_fH >= 0) ? (file_close(mSL_C_fH); mSL_C_fH = -1;);
    (fhd >= 0) ? (file_close(fhd); fhd = -1;);
    mSL_errX = max(mSL_errX, max(mSL_errC, mSL_errM));

    (mSL_errX === 0) ? (
        (ent > 0) ? SchedInsertTail(SchedLockdPts, ent, SchETypeThrd);
    ) : (
        SchedFree(ent); // in case of error, free the entry
        ent = 0;
    );

    mSL_load_end = gfxStartTime;
    (FlagsTbVals[Flgs_Scripts] & 1) ? (
        sprintf(#gfxu, "Fread(%d) Err:%d Dur:%.2f ms", ent, mSL_errX,
                        1000 * (mSL_load_end - mSL_load_start));
        mSL_log(SysLogBox, #gfxu);
    );
    flagShowMemory = 1;
    mSL_errX ? (
        sprintf(#gfxu, "ERR: %d    can't compile \"%s\".", mSL_errX, fname);
        mSL_log(SysLogBox, #gfxu);
    );
    ent;
);



function Simple_Action(src)
local (zz, xp, mr, ccnt, ent, s1, mpt, w1, pindx, err, p, flgs, auxKmd, auxRes,
    par1, par2, par3, par4, par5, par6, par7, par8)
(
    flgs = FlagsTbVals[Flgs_Acts]; // trace flags
);


function Simple_Action(code, seq)
(
    Simple_temp[0] = 1;
    Simple_temp[1] = code;
    Simple_temp[2] = seq[0];
    Simple_temp[3] = seq[1];
    Simple_temp[4] = seq[2];
    Simple_temp[5] = seq[3];
    Simple_temp[6] = seq[4];
    Simple_temp[7] = seq[5];
    Simple_temp[8] = seq[6];
    Simple_Action(Simple_temp);
);

// Set_Table (the mSL "table" operation) : see "mSL table", before the evaluator


function mSL_call_ops(argc, argv)
local(res, kw)
(
    // Decode the parameters - could be integers or keywords
    0 ? (
        sprintf(#s, "*mSL_call_ops[%d]  %18.0f   \"%s\"   \"%s\"    %g",
            argc, argv[0], mSL_edit_value(#s1, argv[0]), mSL_edit_value(#s2, mSL_KW_SensorSize), argv[1]);
        mSL_log(SysLogBox, #s);
    );
    res = Undef;
    // call(`errLock [, v]) : after an error in a process, lock all the processes (1) or stop only this one (0)
    ((argc >= 1) && (argv[0] === mSL_KW_errLock)) ? (
        res = mSL_ErrLockAll;
        (argc >= 2) ? ( mSL_ErrLockAll = (argv[1] != 0); );
    );
    res;
);




