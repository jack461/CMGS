// The modulation inputs of the modules : their names, and their first depths (when first connected)
its_ModN_Rdr = make_array(its_Rdr_ModN); its_ModN_Rdr[0] = "Offset"; its_ModN_Rdr[1] = "Speed"; its_ModN_Rdr[2] = "Volume";
its_ModN_Rdr[3] = "Loop spd"; its_ModN_Rdr[4] = "Desync";
its_ModD_Rdr = make_array(its_Rdr_ModN); its_ModD_Rdr[0] = 2; its_ModD_Rdr[1] = 0.1; its_ModD_Rdr[2] = 0.5; its_ModD_Rdr[3] = 0.1;
its_ModD_Rdr[4] = 0.01;
its_ModN_Wrt = make_array(its_Wrt_ModN); its_ModN_Wrt[0] = "Gain"; its_ModN_Wrt[1] = "Overdub";
its_ModN_Wrt[2] = "Fade"; its_ModN_Wrt[3] = "Plateau"; its_ModN_Wrt[4] = "Wait"; its_ModN_Wrt[5] = "Dir."; its_ModN_Wrt[6] = "Desync";
its_ModD_Wrt = make_array(its_Wrt_ModN); its_ModD_Wrt[0] = 6; its_ModD_Wrt[1] = 20;
its_ModD_Wrt[2] = its_ModD_Wrt[3] = its_ModD_Wrt[4] = 1; its_ModD_Wrt[5] = 0.5; its_ModD_Wrt[6] = 20;
its_ModN_Flt = make_array(2); its_ModN_Flt[0] = "Cutoff"; its_ModN_Flt[1] = "Reso";
its_ModD_Flt = make_array(2); its_ModD_Flt[0] = 2; its_ModD_Flt[1] = 1;
its_ModN_Sat = make_array(3); its_ModN_Sat[0] = "Drive"; its_ModN_Sat[1] = "Bias"; its_ModN_Sat[2] = "Order"; // "Stretch" : Cheb. sum
its_FxTmp = make_array(128); // the output of an effect before its auto-limiter (@sample, see exec_fx)
its_ModD_Sat = make_array(3); its_ModD_Sat[0] = 12; its_ModD_Sat[1] = 0.5; its_ModD_Sat[2] = 2;
// their laws (see its_Mod_Law) : the default action + 8 x the mask of the actions possible (bit a : the action a)
function its_ModKind(a, m) ( a + 8 * m; );
its_ModK_Dop = 256; // (in a law) : the choice Doppler / cross fades (the offset of a reader in delay mode)
i__a = 1 << its_ModA_Add; i__s = 1 << its_ModA_Scale; i__o = 1 << its_ModA_Oct; i__d = 1 << its_ModA_dB;
its_ModK_Rdr = make_array(its_Rdr_ModN);
// the offset (ms) : delay mode, a base (the slider) ; the modes on a line, the displacement alone (Add) ; Doppler : the
// modes delay and reader (the pad sets its_ModK_Rdr[0] from the mode of the reader, its_Rd_OffKind)
its_ModK_OffDly = its_ModKind(its_ModA_Add, i__a | i__s | i__o) + its_ModK_Dop;
its_ModK_OffRd = its_ModKind(its_ModA_Add, i__a) + its_ModK_Dop;
its_ModK_OffBlk = its_ModKind(its_ModA_Add, i__a);
function its_Rd_OffKind(md) ( (md === its_RdrMode_Delay) ? its_ModK_OffDly : (md === its_RdrMode_Read) ? its_ModK_OffRd : its_ModK_OffBlk; );
its_ModK_Rdr[0] = its_ModK_OffDly; // offset
its_ModK_Rdr[1] = its_ModKind(its_ModA_Add, i__a | i__s | i__o); // speed
its_ModK_Rdr[2] = its_ModKind(its_ModA_Scale, i__s | i__d); // volume
its_ModK_Rdr[3] = its_ModKind(its_ModA_Add, i__a | i__s); // loop speed (s/s)
its_ModK_Rdr[4] = its_ModKind(its_ModA_Add, i__a | i__s); // desync (s)
its_ModK_Wrt = make_array(its_Wrt_ModN);
its_ModK_Wrt[0] = its_ModKind(its_ModA_dB, i__d | i__s); // record gain
its_ModK_Wrt[1] = its_ModKind(its_ModA_Add, i__a | i__s); // overdub (%)
its_ModK_Wrt[2] = its_ModK_Wrt[3] = its_ModK_Wrt[4] = its_ModKind(its_ModA_Oct, i__o | i__s); // W-Mix : fade, plateau, wait
its_ModK_Wrt[5] = its_ModKind(its_ModA_Add, i__a); // direction
its_ModK_Wrt[6] = its_ModKind(its_ModA_Add, i__a | i__s); // desync (%)
its_ModK_Flt = make_array(2);
its_ModK_Flt[0] = its_ModK_Flt[1] = its_ModKind(its_ModA_Oct, i__o | i__s); // cutoff, resonance
its_ModK_Sat = make_array(3);
its_ModK_Sat[0] = its_ModK_Sat[1] = its_ModKind(its_ModA_Add, i__a); // drive (dB), bias
its_ModK_Sat[2] = its_ModKind(its_ModA_Add, i__a | i__s); // order, stretch
// Matrix : decay (octaves), damping (octaves), diffusion
its_ModN_Mx = make_array(3); its_ModN_Mx[0] = "Decay"; its_ModN_Mx[1] = "Damping"; its_ModN_Mx[2] = "Diffusion";
its_ModD_Mx = make_array(3); its_ModD_Mx[0] = 1; its_ModD_Mx[1] = 2; its_ModD_Mx[2] = 0.5;
its_ModK_Mx = make_array(3);
its_ModK_Mx[0] = its_ModK_Mx[1] = its_ModKind(its_ModA_Oct, i__o | i__s);
its_ModK_Mx[2] = its_ModKind(its_ModA_Add, i__a | i__s);
// Flanger, Chorus : delay (octaves), rate (octaves), feedback
its_ModN_Fl = make_array(3); its_ModN_Fl[0] = "Delay"; its_ModN_Fl[1] = "Rate"; its_ModN_Fl[2] = "Feedback";
its_ModD_Fl = make_array(3); its_ModD_Fl[0] = 1; its_ModD_Fl[1] = 1; its_ModD_Fl[2] = 0.5;
its_ModK_Fl = make_array(3);
its_ModK_Fl[0] = its_ModK_Fl[1] = its_ModKind(its_ModA_Oct, i__o | i__s);
its_ModK_Fl[2] = its_ModKind(its_ModA_Add, i__a | i__s);
// Phaser : frequency (octaves), rate (octaves), feedback
its_ModN_Ph = make_array(3); its_ModN_Ph[0] = "Freq"; its_ModN_Ph[1] = "Rate"; its_ModN_Ph[2] = "Feedback";
its_ModD_Ph = make_array(3); its_ModD_Ph[0] = 2; its_ModD_Ph[1] = 1; its_ModD_Ph[2] = 0.5;
its_ModK_Ph = make_array(3);
its_ModK_Ph[0] = its_ModK_Ph[1] = its_ModKind(its_ModA_Oct, i__o | i__s);
its_ModK_Ph[2] = its_ModKind(its_ModA_Add, i__a | i__s);
// Noise : level (dB), density (octaves), correlation
its_ModN_Nz = make_array(3); its_ModN_Nz[0] = "Level"; its_ModN_Nz[1] = "Density"; its_ModN_Nz[2] = "Corr";
its_ModD_Nz = make_array(3); its_ModD_Nz[0] = 12; its_ModD_Nz[1] = 2; its_ModD_Nz[2] = 0.5;
its_ModK_Nz = make_array(3);
its_ModK_Nz[0] = its_ModKind(its_ModA_Add, i__a); // (dB, as the drive of the Saturation)
its_ModK_Nz[1] = its_ModKind(its_ModA_Oct, i__o | i__s);
its_ModK_Nz[2] = its_ModKind(its_ModA_Add, i__a | i__s);
// Random : amplitude, rate (octaves), jitter
its_ModN_Rn = make_array(3); its_ModN_Rn[0] = "Amp"; its_ModN_Rn[1] = "Rate"; its_ModN_Rn[2] = "Jitter";
its_ModD_Rn = make_array(3); its_ModD_Rn[0] = 0.5; its_ModD_Rn[1] = 1; its_ModD_Rn[2] = 0.5;
its_ModK_Rn = make_array(3);
its_ModK_Rn[0] = its_ModK_Rn[2] = its_ModKind(its_ModA_Add, i__a | i__s);
its_ModK_Rn[1] = its_ModKind(its_ModA_Oct, i__o | i__s);
// Math : scale ("Amp", as the Random), value, offset
its_ModN_Mt = make_array(3); its_ModN_Mt[0] = "Amp"; its_ModN_Mt[1] = "Value"; its_ModN_Mt[2] = "Offset";
its_ModD_Mt = make_array(3); its_ModD_Mt[0] = 0.5; its_ModD_Mt[1] = 1; its_ModD_Mt[2] = 1;
its_ModK_Mt = make_array(3);
its_ModK_Mt[0] = its_ModK_Mt[1] = its_ModK_Mt[2] = its_ModKind(its_ModA_Add, i__a | i__s);
// Ring : frequency (octaves, as the Phaser), amount, mix
its_ModN_Rg = make_array(3); its_ModN_Rg[0] = "Freq"; its_ModN_Rg[1] = "Amount"; its_ModN_Rg[2] = "Mix";
its_ModD_Rg = make_array(3); its_ModD_Rg[0] = 2; its_ModD_Rg[1] = 0.5; its_ModD_Rg[2] = 0.5;
its_ModK_Rg = make_array(3);
its_ModK_Rg[0] = its_ModKind(its_ModA_Oct, i__o | i__s);
its_ModK_Rg[1] = its_ModK_Rg[2] = its_ModKind(its_ModA_Add, i__a | i__s);
// the actions and the shapes : their names (menu, labels of the cells), the first depth of an action that is not the default one
its_ModA_Name = make_array(5); its_ModA_Name[1] = "Add"; its_ModA_Name[2] = "Scale"; its_ModA_Name[3] = "Octaves"; its_ModA_Name[4] = "Decibels";
its_ModA_Tag = make_array(5); its_ModA_Tag[1] = " +"; its_ModA_Tag[2] = " scale"; its_ModA_Tag[3] = " oct"; its_ModA_Tag[4] = " dB";
its_ModS_Tag = make_array(4); its_ModS_Tag[1] = " exp"; its_ModS_Tag[2] = " log"; its_ModS_Tag[3] = " crv";
its_ModA_Dep = make_array(5); its_ModA_Dep[2] = 0.5; its_ModA_Dep[3] = 1; its_ModA_Dep[4] = 6;
its_ModFmt = make_array(8); // the labels of the sliders of the depths (one per input of a module, see its_Mod_DepPar)
i__ii = 0; loop(8, its_ModFmt[i__ii] = mSL_Str_Perm(); i__ii += 1;);
// Menu of the law of a modulation input (Alt + right clic on its cell, see its_Mod_LawMenu) : results 1-4 the actions, 5-7
// the shapes Lin, Exp, Log, 8-71 the shape Curve with the curve 1-64, 72 unipolar, 73 bypass, 74 Doppler, 75-77 the sliders
// (none, the depth, the depth and the attenuverter), 78 the default law ; the items (from 0) : 1-4 the actions, 6-8 the
// shapes, the curves (its_MLw_Crv), 76-78, 80-82
menu_ModLaw_N = make_array(85);
menu_ModLaw_N[0] = ">Action"; menu_ModLaw_N[1] = "Add"; menu_ModLaw_N[2] = "Scale"; menu_ModLaw_N[3] = "Octaves";
menu_ModLaw_N[4] = "<Decibels";
menu_ModLaw_N[5] = ">Shape"; menu_ModLaw_N[6] = "Linear"; menu_ModLaw_N[7] = "Exp (fine near 0)"; menu_ModLaw_N[8] = "<Log (strong near 0)";
<? i=0; j=9; loop(64, (i % 32) == 0 ? (printf("menu_ModLaw_N[%d] = \">Shape : curves %d-%d\";", j, i+1, i+32); j += 1;); printf("menu_ModLaw_N[%d] = \"%sCurve %d\";", j, ((i % 32) == 31) ? "<" : "", i+1); i += 1; j += 1;); ?>
menu_ModLaw_N[75] = ""; menu_ModLaw_N[76] = "Unipolar"; menu_ModLaw_N[77] = "Bypass"; menu_ModLaw_N[78] = "Doppler (delay offset)";
menu_ModLaw_N[79] = ""; menu_ModLaw_N[80] = "No slider"; menu_ModLaw_N[81] = "Depth slider"; menu_ModLaw_N[82] = "Depth and attenuverter sliders";
menu_ModLaw_N[83] = ""; menu_ModLaw_N[84] = "Default law";
menu_ModLaw = make_jmenu(
    ui_jmenu_typ_opt | ui_jmenu_opt_rndrect | ui_jmenu_opt_arclick | ui_jmenu_opt_notitle,
            "modulation-law", 85, menu_ModLaw_N);
function its_MLw_Crv(i) ( 10 + i + (i >= 32); ); // the item of the curve i

