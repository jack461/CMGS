        lv = its_Mod_Apply(mp, fx[its_Efx_Par1 + 5], its_ModA_Add, 1); // the level (dB)
        lv = (lv <= -120) ? 0 : 10 ^ (min(40, lv) / 20);
        dn = max(0.01, min(srate, its_Mod_Apply(mp + its_ModDist, fx[its_Efx_Par1 + 4], its_ModA_Oct, 1))); // the density
        cr = max(0, min(1, its_Mod_Apply(mp + 2 * its_ModDist, fx[its_Efx_Par1 + 3], its_ModA_Add, 1))); // the correlation
        a = sqrt(cr); b = sqrt(1 - cr);
