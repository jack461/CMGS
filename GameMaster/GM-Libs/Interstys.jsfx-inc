    mSL_Sort_Strings(blockDispITC, othFirst, blockDispNames, blockDispIdts, 0, 0);
    // build invert table (module number -> menu item)
    i = blockFirst; while(i<blockDispITC) (
        (blockDispIdts[i] > 0) ? blockDispInverts[blockDispIdts[i]] = i;
