            loop(ccnt + 1, p[2] = 1; p[3] = rand(0.5); p[4] = rand(0.5); p[5] = 0.1 + rand(0.8); p[18] = rand(1); p[19] = rand(1); p += its_NzCW;);
            hd[0] = cl; hd[1] = hd[3] = hd[5] = hd[6] = -1; // (the filters, the table of the shape, the rumble to compute)
