                            ) : (
                                rcbl[its_Rdr_StFlgs] |= its_RdrFlg_solo;
                            );
                        ) :
                        ((zzmcl === 10) && rok) ? (
                            ((k = its_Off_Choose(rcbl[its_Rdr_OutOff])) >= 0) ? (
