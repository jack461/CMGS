            v = u - s[1];
            v1 = a1 * s[0] + a2 * v;
            v2 = s[1] + a2 * s[0] + a3 * v;
            s[0] = 2 * v1 - s[0]; s[1] = 2 * v2 - s[1];
            u -= 2 * kq * v1;
