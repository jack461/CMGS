// the value of the key "ki" of the module "b" (type "ty") : its_Tb_g1, its_Tb_g2 (mod : its_Tb_g1 ... its_Tb_g5, see
// its_Tb_ModGet) ; b === 0 : no module
function its_Tb_Get(ty, ki, b)
(
    its_Tb_g2 = its_Tb_g3 = its_Tb_g4 = its_Tb_g5 = 0;
    its_Tb_g1 = (b === 0) ? (((ty === its_TK_Writer) ? (ki === 2) : (ki === 4)) ? its_WrtStat_UnDef : -1) :
    (ty === its_TK_Writer) ? (
        (ki === 0) ? b[its_Wrt_LineNb] :
        (ki === 1) ? ( its_Tb_g2 = b[its_Wrt_SrcOff]; b[its_Wrt_Src]; ) :
        (ki === 2) ? b[its_Wrt_Status] :
        (ki === 3) ? b[its_Wrt_InGaindB] :
        (ki === 4) ? b[its_Wrt_Ovrdb] :
        (ki === 5) ? b[its_Wrt_Mode] :
        (ki === 6) ? b[its_Wrt_Bf1stChan] :
        (ki === 7) ? b[its_Wrt_BfChanUsed] :
