        Currwriter[its_Wrt_InGain] = (slWrInGain <= -120) ? 0 : 10^(slWrInGain/20);
    );


    (wrupdt) ? display_Writer();



    //---------------------------------------------------
    //-----  GLOBALS SETTINGS
    (slSmpl != slSmplPrv) ? (
