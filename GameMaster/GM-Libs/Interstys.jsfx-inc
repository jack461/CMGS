// Fonction d'interpolation cubique (Hermite)
// buffer : le tableau d'échantillons
// position : l'indice fractionnaire (ex: 44.32)
function inter_cube(buffer, position)
local(i, f, y0, y1, y2, y3, a, b, c, d)
(
  // 1. Séparation de la partie entière et fractionnaire
  i = floor(position);
  f = position - i;

  // 2. Récupération des 4 points nécessaires (y0, y1, y2, y3)
  // On s'assure que les indices restent dans les bornes du buffer
  // On utilise max(0, ...) et min(buffer_size, ...) pour éviter les crashs
  // y0 = buffer[max(0, i - 1)];
  y0 = buffer[i - 1];
  y1 = buffer[i];
  y2 = buffer[i + 1];
  // y3 = buffer[max(0, i + 2)]; // Note: buffer_size doit être géré globalement
  y3 = buffer[i + 2];
  // 3. Calcul de l'interpolation cubique (Spline d'Hermite)
  // Formule : a*f^3 + b*f^2 + c*f + d
  a = -0.5*y0 + 1.5*y1 - 1.5*y2 + 0.5*y3;
  b = y0 - 2.5*y1 + 2*y2 - 0.5*y3;
  c = -0.5*y0 + 0.5*y2;
  d = y1;

  // Résultat final
  ((a*f + b)*f + c)*f + d;
);



// value of "bfr" at the position "pos" : interpolated (Hermite) if the position is fractional
function its_Rd_Get(bfr, pos)
(
    (pos === floor(pos)) ? bfr[pos] : inter_cube(bfr, pos);
);

// offset "x" (samples) of a delay reader, bounded : [1 ... size - 3], at least 3 if fractional (the 4 points of inter_cube
// are then already written : the writer writes after the readers)
function its_Rd_Off(reader, x)
(
    x = min(reader[its_Rdr_SmplCnt] - 3, x);
    (x === floor(x)) ? max(1, x) : max(3, x);
);

function inter_lookup(buffer, position)
local(i, f, j, sum)
(
  i = floor(position);
  f = position - i;

  sum = 0;

  // On boucle sur le rayon du SInc (de -RADIUS à +RADIUS)
  // Pour chaque échantillon voisin, on cherche son poids dans la table
  j = - SINC_RADIUS;
  loop(2 * SINC_RADIUS + 1,
    // Calcul de la distance relative entre l'échantillon j et la position fractionnaire
    // Conversion de cette distance en index pour la table de look-up
    // On normalise la distance dist (qui est entre -RADIUS et RADIUS) vers l'index de la table
    // On récupère le poids dans la table (interpolation linéaire rapide pour la table elle-même)
    // Somme pondérée : valeur de l'échantillon * son poids SInc
    // sum += buffer[i + j] * sinc_table[floor((((j - f) + SINC_RADIUS) / (2 * SINC_RADIUS)) * SINC_TABLE_SIZE)];
    sum += buffer[i + j] * sinc_table[floor(((j - f) + SINC_RADIUS) * SINC_FACT)];
    j += 1;
  );

  sum;
);

// Execute action "act" (its_WrtAct_...) on writer "wnum" ; returns the writer block (0 : none)
