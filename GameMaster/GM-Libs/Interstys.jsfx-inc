*/
function mSL_error_analysis(thrd)
(
    sprintf(#uuu, " _ Thread: %d", thrd);
    mSL_log(SysLogBox, #uuu);
    sprintf(#uuu, " _ Mem avail: %d", mSL_available_memory());
    mSL_log(SysLogBox, #uuu);
);



