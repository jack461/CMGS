);

// the count of channels read from a source of the effect "fx" : its channels ; a Random, clock Common : one (the first
// channel of its trigger)
function its_Fx_SrcW(fx)
(
    ((fx[its_Efx_Type] === its_Efx_TyRandom) && (fx[its_Efx_Par1 + 7] === 0)) ? 1 : max(1, min(128, floor(fx[its_Efx_CCnt])));
);

// a Math, a Ring : the word of the channels of their source B (bchan : 0 all, 1 the first)
function its_Fx_BcIdx(fx) ( its_Efx_Par1 + ((fx[its_Efx_Type] === its_Efx_TyRing) ? 9 : 5); );

// the count of channels read from the source "j" (0 ...) of the effect "fx", "s" (first channel "off") : its_Fx_SrcW ; the
// source B of a Math, of a Ring (j 1) : all the channels of the effect if its cable has them (bchan 0), else its first
// channel for all
function its_Fx_SrcWj(fx, j, s, off) local(w)
(
    w = its_Fx_SrcW(fx);
    ((j === 1) && ((fx[its_Efx_Type] === its_Efx_TyMath) || (fx[its_Efx_Type] === its_Efx_TyRing))) ? (
        ((fx[its_Fx_BcIdx(fx)] !== 0) || (its_Src_Cell(s, off, w) < 0)) ? 1 : w;
    ) : w;
);

// Ring : the modulation inputs that have a meaning (a mask) : the frequency (no source B), the amount (AM), the mix
function its_Rg_ModOk(fx)
(
    4 + ((fx[its_Efx_Src2] === 0) ? 1 : 0) + ((floor(fx[its_Efx_Par1 + 1]) === its_RgAM) ? 2 : 0);
);

// Math : the operation "op" reads B ; it uses the attack and the release
function its_Mt_UsesB(op) ( (op === its_MtMul) || (op === its_MtAdd) || (op === its_MtSub) || (op === its_MtMin) || (op === its_MtMax)
    || (op === its_MtGate); );
function its_Mt_UsesT(op) ( (op === its_MtEnv) || (op === its_MtSlew); );

// Math : the modulation inputs that have a meaning (a mask) : the scale, the value (an operation that reads B, without
// source B), the offset
function its_Mt_ModOk(fx) local(op)
(
    op = max(0, min(its_MtCnt - 1, floor(fx[its_Efx_Par1 + 1])));
    5 + ((its_Mt_UsesB(op) && (fx[its_Efx_Src2] === 0)) ? 2 : 0);
);

/*
    Saturation, mode Cheb. sum : sum of hw[k-1] * cos(k * s * acos(fold(u))), k in [1 ... its_SatHarm] ; s = 1 : the sum of
    the Chebyshev polynomials T_k(fold(u)) weighted by hw ; the cosines by the recurrence cos((k+1)p) = 2 cos(p) cos(kp) - cos((k-1)p)
*/
function its_Cheb_Sum(u, s, hw)
local (c1, c0, ck, y, w)
(
    u = 0.25 * (u + 1);
    c1 = max(-1, min(1, 1 - 4 * abs(u - floor(u) - 0.5))); // fold(u)
    (s !== 1) ? (c1 = cos(s * acos(c1)));
    c0 = 1; ck = c1; y = 0;
    loop(its_SatHarm,
        y += hw[0] * ck;
        w = 2 * c1 * ck - c0; c0 = ck; ck = w;
        hw += 1;
    );
    y;
);

/*
    Saturation, mode Curve : the transfer function given by the table of the curve fx[Par10] (its complete form F, see
    its_CrvTab), the input u in [-1, 1] covering the part edited (bipolar, see its_Crv_Xfer)
*/
function its_Sat_Curve(u, fx)
(
    its_Crv_Xfer(u, max(0, min(its_CrvMx - 1, 0|fx[its_Efx_Par1 + 9])), 0);
);

// Saturation : the curve of the mode "md" (in [-1, 1], except x - A sin : about 0.5 * u, Cheb. sum : the sum of the |weights|) ;
// n : the order (x - A sin, Chebyshev) or the stretch (Cheb. sum) ; fx : the effect (A, the weights of Cheb. sum, the curve) ;
// tanh : a rational function (Padé 7/6, error < 0.0001, 1 beyond 4.97)
function its_Sat_Shape(u, md, n, fx)
local (a)
(
    (md === its_SatSoft) ? (
        (u >= 4.97) ? 1 : (u <= -4.97) ? -1 :
        ( a = u * u; u * (135135 + a * (17325 + a * (378 + a))) / (135135 + a * (62370 + a * (3150 + 28 * a))); );
    ) :
    (md === its_SatHard) ? max(-1, min(1, u)) :
    (md === its_SatFold) ? (u = 0.25 * (u + 1); 1 - 4 * abs(u - floor(u) - 0.5)) : // folds back at -1 and 1
    (md === its_SatXSin) ? 0.5 * (u - fx[its_Efx_Par1 + 8] * sin(0.5 * $pi * n * u)) :
    (md === its_SatCheb) ? (u = 0.25 * (u + 1); cos(n * acos(max(-1, min(1, 1 - 4 * abs(u - floor(u) - 0.5)))))) : // T_n(fold(u))
    (md === its_SatChebSum) ? its_Cheb_Sum(u, n, fx + its_Efx_Harm1) :
