//===== EFFECTS Handling
// Effects_set[FX_CNT]
// Réinitialiser un effet
function FX_Clear(enum)
local (fxcb)
(
    ((enum >= 0) && (enum <= FX_CNT) && ((fxcb = Effects_set[enum]) > BASE_MEMORY) && (fxcb[-2] === KW_effx)) ? (
        memset(fxcb, 0, its_Efx_BlkSize);
        fxcb[its_Efx_Status] = its_Efx_Unspecified;
        fxcb[its_Efx_Phase] = its_Efx_PhaseStd;
        fxcb[its_Efx_Numb] = enum;
        fxcb[its_Efx_CCnt] = 1;
        fxcb[its_Efx_Unuz1] = fxcb[its_Efx_Unuz2] = SECURE_BL;
    );
);
// Obtenir l'espace pour représenter un effet
function FX_make(enum)
local (fxcb)
(
    fxcb = mSL_Dyn_Alloc(its_Efx_BlkSize, KW_effx, mSL_StM_FlClear); // allocate memory
    Effects_set[enum] = fxcb;
    FX_Clear(enum);
    fxcb;
);

// Delete an effect from Effects_set
function FX_Delete(enum)
local (fxcb)
(
    ((enum >= 0) && (enum <= FX_CNT) && ((fxcb = Effects_set[enum]) > BASE_MEMORY) && (fxcb[-2] === KW_effx)) ? (
        mSL_Dyn_Free(fxcb);
    );
    Effects_set[enum] = 0;
);


