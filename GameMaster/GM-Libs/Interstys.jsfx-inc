            (ki === 36) ? ( its_Tb_v1 = its_Tb_Num(nm, 0.01, 20000); ) :
            (ki === 37) ? ( its_Tb_v1 = its_Tb_Num(nm, 0, 67108864 / srate); ) :
            ((ki === 38) || (ki === 39)) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbFSt, 2); ) : ( // Off, On
