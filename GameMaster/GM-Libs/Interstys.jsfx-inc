//==========================================================
//===== EFFECTS Handling
// Effects_set[FX_CNT]
// Réinitialiser un effet
// (the effect keeps its work areas : its_Patch_Update frees them)
function FX_Clear(enum)
local (fxcb, w0, w1, w2)
(
    ((enum >= 0) && (enum <= FX_CNT) && ((fxcb = Effects_set[enum]) > BASE_MEMORY) && (fxcb[-2] === KW_effx)) ? (
        w0 = fxcb[its_Efx_Work]; w1 = fxcb[its_Efx_WkNew]; w2 = fxcb[its_Efx_WkOld];
        memset(fxcb, 0, its_Efx_BlkSize);
        fxcb[its_Efx_Work] = w0; fxcb[its_Efx_WkNew] = w1; fxcb[its_Efx_WkOld] = w2;
        fxcb[its_Efx_Status] = its_Efx_Unspecified;
        fxcb[its_Efx_Phase] = its_Efx_PhaseStd;
        fxcb[its_Efx_Numb] = enum;
        fxcb[its_Efx_CCnt] = 1;
        its_Mod_Init(fxcb + its_Efx_Mod1, 3); // modulation attenuverters
        fxcb[its_Efx_Unuz1] = fxcb[its_Efx_Unuz2] = SECURE_BL;
    );
);
// Obtenir l'espace pour représenter un effet
function FX_make(enum)
local (fxcb)
(
    fxcb = mSL_Dyn_Alloc(its_Efx_BlkSize, KW_effx, mSL_StM_FlClear); // allocate memory
    Effects_set[enum] = fxcb;
    FX_Clear(enum);
    fxcb;
);

// Delete an effect from Effects_set
function FX_Delete(enum)
local (fxcb)
(
    ((enum >= 0) && (enum <= FX_CNT) && ((fxcb = Effects_set[enum]) > BASE_MEMORY) && (fxcb[-2] === KW_effx)) ? (
        Effects_set[enum] = 0; // first : the audio thread no longer sees it
        its_Fx_WorkFree(fxcb);
        mSL_Dyn_Free(fxcb);
    );
    Effects_set[enum] = 0;
);

// Copy the effect "src" into "dst" (Copy, Paste) : "dst" keeps its own work areas
function FX_Copy(dst, src)
local (w0, w1, w2)
(
    w0 = dst[its_Efx_Work]; w1 = dst[its_Efx_WkNew]; w2 = dst[its_Efx_WkOld];
    memcpy(dst, src, its_Efx_BlkSize);
    dst[its_Efx_Work] = w0; dst[its_Efx_WkNew] = w1; dst[its_Efx_WkOld] = w2;
);

// Auto Mixer : the same gain -20*log10(N) (rounded to 0.01 dB) for the N sources not null
function FX_Auto_Gains(fx)
local (n, g, p)
(
    n = 0; p = fx + its_Efx_Src1;
    loop(8, (p[0] > 0) ? (n += 1); p += its_EfxDist;);
    g = (n > 0) ? floor(0.5 - 2000 * log10(n)) / 100 : 0;
    p = fx + its_Efx_Src1;
    loop(8, p[its_Efx_VoldB1 - its_Efx_Src1] = (p[0] > 0) ? g : -120; p += its_EfxDist;);
    fx[its_Efx_Check] = 0;
);

// the weights "hw" of the mode Cheb. sum : a preset "k" (menu_Efx_Harm)
function its_Harm_Preset(hw, k)
local (i, m)
(
    (k === 6) ? (
        // normalize : the largest |weight| becomes 1
