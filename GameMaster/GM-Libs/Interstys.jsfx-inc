        ) : (
            0;
        );
    );

    (slWritCell != slWritCellPrv) ? (
        (Currwriter !== 0) ? (
            Currwriter[its_Wrt_Cell] = slWritCell;
        );
        slWritCellPrv = slWritCell;
        wrupdt = 1;
    );

    (slWDlSize != slWDlSizePrv) ? (
        (Currwriter !== 0) ? (
            bfr = Currwriter[its_Wrt_Lcbl];
            // slWDlSizePrv = slWDlSize = (bfr <= 0) ? 0 : floor(1000 * bfr[its_Lin_SmplCnt]/srate) / 1000;
            slWDlSizePrv = slWDlSize = (bfr <= 0) ? 0 : bfr[its_Lin_SmplCntSec];
