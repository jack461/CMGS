);

// View "module" kind id words w ... (pass 3 ; an unknown module : a message, its words are read)
function its_Tb_View() local(w, k, ty, o, n, j, st, sz, v)
(
    w = its_Tb_Next();
    !mSL_isString(w) ? (
        sprintf(#its_TbW, "View : %s is not the \"name\" of a module", mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2727, #its_TbW);
    );
    k = (its_Tb_error === 0) ? its_Xp_ModNum(w) : -1;
    st = (k >= 0) ? its_Xp_ViewOf(k) : 0; sz = its_XpVSz; ty = its_XpVTy;
    ((its_Tb_error === 0) && (k >= 0) && (st === 0)) ? (
        sprintf(#its_TbW, "View \"%s\" : this module has no view", w);
        its_Tb_Err(2728, #its_TbW);
    );
    // the object : required for a view of objects (Reader A, ... Curves H) ; an unknown module : the kind given
    o = -1;
    (its_Tb_error === 0) ? (
        (k < 0) ? (
            ty = its_Tb_Peek();
            ((ty === its_TK_Reader) || (ty === its_TK_Writer) || (ty === its_TK_Line) || (ty === its_TK_Effect) || (ty === its_TK_Curve)) ? 0 : (ty = 0);
        );
        (ty !== 0) ? (
            (its_Tb_Peek() !== ty) ? (
                sprintf(#its_TbW, "View \"%s\" : %s id expected", w, (ty === its_TK_Curve) ? "Curve" : its_Tb_TyName(ty));
                its_Tb_Err(2728, #its_TbW);
            ) : (
                its_Tb_Next();
                o = (ty === its_TK_Curve) ? its_Crv_Id(its_Tb_Next(), 0) : its_Tb_Id(ty, its_Tb_Next(), 0);
            );
        );
    );
    n = 0;
    ((its_Tb_error === 0) && (its_Tb_Peek() === its_XpKWords)) ? (
        its_Tb_Next();
        while ((its_Tb_error === 0) && its_Tb_IsNum()) (
            v = its_Tb_Num("words", -(2^40), 2^40);
            (n < 16) ? ( its_TbVW[n] = v; n += 1; );
        );
    );
    ((its_Tb_mode === 3) && (its_Tb_error === 0)) ? (
        (k < 0) ? (
            sprintf(#its_TbW, "Interstys table : View : no module named \"%s\" (ignored)", w);
            mSL_log(SysLogBox, #its_TbW);
        ) : (
            (o >= 0) ? (st[0] = o);
            j = (ty !== 0) ? 1 : 0;
            loop(min(n, sz - j), st[j] = its_TbVW[j - ((ty !== 0) ? 1 : 0)]; j += 1;);
        );
    );
);

// Global display All : all the modules of the instances of this table shown (after the essential ones : their Display)
function its_Tb_ShowAll() local(i, j, k, b, ty, t2, x, f)
(
    f = 0;
    i = 0; loop(its_IPCnt,
        k = its_IPK[i];
        ((its_InsSym[k] === its_IPN[i]) && ((b = its_InsNam[k]) > BASE_MEMORY)) ? (
            j = 0; loop(its_InsNCnt[k],
                ty = b[3 * j + 1]; x = b[3 * j + 2];
                t2 = (ty === its_TK_Effect) ? 'E' : (ty === its_TK_Reader) ? 'R' : (ty === its_TK_Writer) ? 'W' :
                    (ty === its_TK_Line) ? 'L' : (ty === its_TK_Curve) ? 'C' : 0;
                (((t2 === 'C') && (its_CrvBlk[x] > BASE_MEMORY)) || ((t2 !== 0) && (t2 !== 'C') && (its_Xp_Blk(ty, x) !== 0))) ? (
                    !its_Mod_Show(t2, x) ? (f += 1);
                );
                j += 1;
            );
        );
        i += 1;
    );
    (f > 0) ? (
        sprintf(#its_TbW, "Interstys table : display All : %d module(s) not shown (no free view, or no room)", f);
        mSL_log(SysLogBox, #its_TbW);
    );
);

// Implementation of the mSL "table" operation
function Set_Table(tbl) local(m, w, xb)
(
    its_Tb_tbl = tbl; its_Tb_itc = tbl[-1];
    its_Tb_error = its_Tb_res = its_TbNCnt = 0;
    its_Tb_scope = its_Tb_sscope = its_Tb_setm = 0; its_Tb_cpend = its_Tb_spend = -1;
    its_Tb_hasTab = 0; // (pass 0 : a block Tab, see its_XpShow)
    memset(its_TbResv, 0, LN_CNT + WR_CNT + RD_CNT + FX_CNT);
    // the templates taken, the instances expanded (its_Al_Expand : its size, then the words)
    its_Al_buf = xb = 0;
    its_Al_Expand();
    (its_Tb_error === 0) ? (
        ((xb = mSL_Dyn_Alloc(its_Al_cnt + 4, 'tbex', 0)) <= BASE_MEMORY) ? (
            its_Tb_Err(2790, "not enough memory for the expanded table");
            xb = 0;
        ) : (
            its_Al_buf = xb;
            its_Al_Expand();
            its_Al_buf = 0;
            its_Tb_tbl = xb; its_Tb_itc = its_Al_cnt;
            its_Al_SetNames(); // (the modules of the instances changed by a Set)
        );
    );
    m = 0;
    while ((m <= 3) && (its_Tb_error === 0)) (
        its_Tb_mode = m; its_Tb_ptr = its_Tb_clr = 0;
        its_Tb_scope = its_Tb_sscope = its_Tb_setm = 0;
        its_Tb_SimInit();
        its_Crv_SimInit();
        (its_Tb_Peek() === its_TK_Interstys) ? its_Tb_Next();
        while ((its_Tb_error === 0) && ((w = its_Tb_Next()) !== its_TK_End) && (w !== its_TK_EofMark)) (
            its_Al_Flush(); // (an instance ended by the previous block)
            (w === its_TK_Clear) ? its_Tb_Clear() :
            (w === its_TK_Line) ? its_Tb_Line() :
            ((w === its_TK_Writer) || (w === its_TK_Reader) || (w === its_TK_Effect)) ? its_Tb_Module(w) :
            (w === its_TK_Dump) ? its_Tb_Dump() :
            (w === its_TK_Check) ? its_Tb_Check() :
            (w === its_TK_Free) ? its_Tb_Free() :
            (w === its_TK_Display) ? its_Tb_Display(0) :
            (w === its_TK_Remove) ? its_Tb_Display(1) :
            (w === its_TK_Global) ? its_Tb_Global() :
            (w === its_TK_Control) ? its_Tb_Control() :
            (w === its_TK_Export) ? its_Tb_Export() :
            (w === its_TK_Tab) ? its_Tb_Tab() :
            (w === its_TK_View) ? its_Tb_View() :
            (w === its_TK_Curve) ? its_Tb_Curve() : (
                sprintf(#its_TbW, "%s : a block (Line, Writer, Reader, Effect, Global, Control, Curve, Algorithm, Instance, Set, Dump, Check, Free, Display, Remove, Clear, Export, Tab, View) is expected", mSL_edit_value(#its_TbV, w));
                its_Tb_Err(2750, #its_TbW);
            );
        );
        (its_Tb_error === 0) ? its_Al_Flush();
        m += 1;
    );
    ((m === 4) && (its_Tb_error === 0)) ? its_Al_TplCommit();
    ((m === 4) && (its_Tb_error === 0) && (its_XpShow === 2) && !its_Tb_hasTab) ? its_Tb_ShowAll();
    (xb > BASE_MEMORY) ? mSL_Dyn_Free(xb);
    (m === 4) ? (its_PatchForce = 1); // the cables of all the modules (see its_Patch_Update)
    (its_Tb_error !== 0) ? its_Tb_error : its_Tb_res;
);


// Insert here the mSL interpreter
