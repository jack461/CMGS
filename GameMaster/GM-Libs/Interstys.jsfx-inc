        fc = fx[its_Efx_Par1 + 2];
        (fc !== hd[1]) ? ( hd[1] = fc; hd[2] = ((fc <= 0) || (fc >= 0.45 * srate)) ? 0 : 1 - exp(-2 * $pi * fc / srate); );
        fc = fx[its_Efx_Par1 + 10];
        (fc !== hd[3]) ? ( hd[3] = fc; hd[4] = ((fc <= 1) || (fc >= 0.45 * srate)) ? 0 : 1 - exp(-2 * $pi * fc / srate); );
        kd = hd[2]; kh = hd[4];
        // the rumble : its share, its two low pass, its gain (sqrt(2 srate / (pi fc)) brings it to the power of the source ;
        // then its median peak over 45 ms, and its rare peaks with the swells (99.9 % of the windows), measured, at the level)
        rm = max(0, min(1, fx[its_Efx_Par1]));
        (rm > 0) ? (
            fc = max(5, min(500, fx[its_Efx_Par1 + 9]));
            (fc !== hd[6]) ? (
                hd[6] = fc; hd[7] = 1 - exp(-2 * $pi * fc / srate);
                x = log(fc / 40) / log(2);
                hd[8] = sqrt(2 * srate / ($pi * fc)) * 10 ^ (-(0.5453 + 1.3367 * x - 0.0819 * x * x + 4.4 - 0.5 * x + 0.12 * x * x) / 20);
            );
            rk = hd[7]; rg = hd[8];
            r0 = (a > 0) ? rand(2) - 1 : 0; // (the common source)
            sw = its_NzSwR / srate;
        );
        g0 = 0;
        (a > 0) ? ( g0 = its_Nz_Gen(cw + ccnt * its_NzCW, cl, tf, pd, pc, rl); sh ? (g0 = its_Nz_Shape(g0, tb, e)); ); // the common generator
        c = 0; p = cw;
        loop(ccnt,
            u = a * g0;
            (b > 0) ? ( x = its_Nz_Gen(p, cl, tf, pd, pc, rl); sh ? (x = its_Nz_Shape(x, tb, e)); u += b * x; );
            (cl <= its_NzMix) ? (
                // White, Pink, Brown, Violet, Mix (its filters always computed : no jump when the tilt passes from two colors to two others)
                y = ww * u;
