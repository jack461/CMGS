        (fx[its_Efx_MxX + 3] !== hd[2]) ? ( hd[2] = fx[its_Efx_MxX + 3]; hd[3] = (hd[2] <= 0) ? 1 : 1 - exp(-1 / (hd[2] * srate)); );
        gk = hd[3];
        f0 = max(1, its_Mod_Apply(mp, fx[its_Efx_Par1], its_ModA_Oct, 1));
        sw = max(0, min(10, fx[its_Efx_Par1 + 2]));
        (hd[0] < 0) ? ( hd[0] = f0; hd[1] = sw; ) : ( hd[0] += gk * (f0 - hd[0]); hd[1] += gk * (sw - hd[1]); );
        f0 = hd[0]; sw = hd[1];
        rt = max(0, its_Mod_Apply(mp + its_ModDist, fx[its_Efx_MxX + 1], its_ModA_Oct, 1)) / srate; // (turns per sample)
        fb = max(-2, min(2, its_Mod_Apply(mp + 2 * its_ModDist, fx[its_Efx_Par1 + 6], its_ModA_Add, 1)));
        ls = (abs(fb) >= 1); // the loop saturates
        mix = max(-1, min(1, fx[its_Efx_Par1 + 3]));
        spr = fx[its_Efx_Par1 + 4];
        cr = max(-1, min(1, fx[its_Efx_Par1 + 11]));
        kq = 1 / max(0.1, min(100, fx[its_Efx_Par1 + 10]));
        ct = its_CrvTab + max(0, min(its_CrvMx - 1, 0|fx[its_Efx_Par1 + 5])) * its_CrvTbSz + its_CrvTbG;
        dr = (md === its_PhBarbUp) ? 1 : -1; // (barber : the direction of the ramps)
        c = 0; p = cw;
        loop(ccnt,
            x = g * src[c];
            // the feedback : the output of the chain of the channel, or of its neighbour (cross), at the previous sample
            v = p[0];
            (cr !== 0) ? (
                k = (cr > 0) ? ((c + 1 < ccnt) ? c + 1 : 0) : ((c > 0) ? c - 1 : ccnt - 1);
                v += abs(cr) * (cw[k * its_PhCW] - v);
            );
            u = x + fb * v;
            ls ? (u = its_Mx_Sat(u));
            ph = p[1] + rt * p[2]; ph -= floor(ph); p[1] = ph;
            pe = ph + c * spr; pe -= floor(pe); // its phase, with the offset of the channel
            s = st + c * 4 * its_PhMaxS;
            bm ? (
                // two chains half a period apart, their frequency ramps over the sweep, each one in its window
                wa = 0.5 - 0.5 * cos(2 * $pi * pe);
                pb = pe + 0.5; pb -= floor(pb);
                v = wa * its_Ph_Chain(u, f0 * 2 ^ (dr * sw * (pe - 0.5)), ns, sf, s, 0, kq)
                    + (1 - wa) * its_Ph_Chain(u, f0 * 2 ^ (dr * sw * (pb - 0.5)), ns, sf, s + 2 * its_PhMaxS, 0, kq);
            ) : (
                y = (sh === its_LfoSine) ? sin(2 * $pi * pe) :
                    (sh === its_LfoTri) ? ((pe < 0.5) ? 4 * pe - 1 : 3 - 4 * pe) :
                    (sh === its_LfoSawUp) ? 2 * pe - 1 :
                    (sh === its_LfoSawDown) ? 1 - 2 * pe :
                    (sh === its_LfoSquare) ? ((pe < 0.5) ? 1 : -1) :
                    (sh === its_LfoCurve) ? its_Crv_Cyc(ct, pe) :
                    (
                        (pe < p[6]) ? ( p[3] = p[4]; p[4] = rand(2) - 1; ); // a new period : a new random value
                        (sh === its_FlShRand) ? p[3] + (p[4] - p[3]) * (0.5 - 0.5 * cos($pi * pe)) : (p[5] += gk * (p[4] - p[5]));
                    );
                v = its_Ph_Chain(u, f0 * 2 ^ (0.5 * sw * y), ns, sf, s, rs, kq);
            );
            p[6] = pe;
            !(abs(v) < its_FinMax) ? ( memset(s, 0, 4 * its_PhMaxS); v = 0; its_NaNCnt += 1; );
            p[7] = v;
            out[c] += (1 - abs(mix)) * x + mix * v;
            p += its_PhCW; c += 1;
        );
        p = cw; loop(ccnt, p[0] = p[7]; p += its_PhCW;);
    );
);

/*
    the VU meter (the plugin Multichannel_VU_meter, GM-Meters) : the meters of the channels of its source (times its gain),
    which goes unchanged to the output (the meter can be inserted in a chain) ; its engine after the header of its work
    area (made again after a bypass, its_FxW_Md)
*/
function exec_vu(fx, ccnt, out)
local (wk, e, src, g, i)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
        e = wk + its_FxW_Hdr;
        (wk[its_FxW_Md] !== 1) ? ( vu_Reset(e, ccnt); wk[its_FxW_Md] = 1; );
        src = smpl_tab + fx[its_Efx_Cell1]; g = fx[its_Efx_Vol1];
        vu_Sample(fx + its_Efx_Par1, e, src, g, ccnt);
        i = 0; loop(ccnt, out[i] += g * src[i]; i += 1;);
    );
);

/*
    the Limiter (the plugin SmoothMultiLimiter, GM-Meters) : the channels of its source (times its gain) delayed by the
    anticipation and limited together, added to the output ; its engine after the header of its work area (made again
    after a bypass, its_FxW_Md)
*/
function exec_limiter(fx, ccnt, out)
local (wk, e)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
        e = wk + its_FxW_Hdr;
        (wk[its_FxW_Md] !== 1) ? ( lm_Reset(e, ccnt); wk[its_FxW_Md] = 1; );
        lm_Sample(fx + its_Efx_Par1, e, smpl_tab + fx[its_Efx_Cell1], fx[its_Efx_Vol1], out, ccnt, 1);
    );
);

/*
    execute the effect "fx" (number "nbr") : called by @sample, in the phase of the effect
    the output is the own cable of the effect (assigned), or Out or a bus (added)
    Mixer and Auto Mixer (the Auto Mixer only sets equal gains, see FX_Auto_Gains) :
        Out[0 ... CCnt-1] = sum of Vol_i * Src_i[Off_i ... Off_i+CCnt-1], for the sources i in [1 ... 8] not null
        the gains in dB (its_Efx_VoldB_i) are the reference : the linear gains (its_Efx_Vol_i) are computed by the check
    LFO : Out[c] = Par4 + Par3 * shape(phase + c * Par5), the phase turning at Par1 Hz ; the shape "Curve" : the table of
        the curve Par6 (its_CrvTab), cubic interpolation (Catmull-Rom : a vertical jump of the curve overshoots a little)
    Filter : Out = filter(Vol_1 * Src_1), cutoff Par1 (Hz) and resonance Par2 (Q), both modulated (octaves), mode Par3,
        2^Par4 stages (low pass, high pass : Butterworth cascade, the resonance on the last stage) ; its coefficients and
        states are in its work area (silent until @block has put in place an area of the right size)
    Saturation : Out = Par6 * ((1 - Par4) * x + Par4 * (shape(Par1 * x + Par3) - shape(Par3))), x = Vol_1 * Src_1, with the drive
        (Par1, dB) and the bias (Par3) modulated ; computed 2^Par5 times per sample (linear interpolation of x, then an
        anti-aliasing low pass, Butterworth at 0.45 * srate : order 8, order 4 with ADAA), then a DC blocker ; ADAA (Par11,
        the modes Soft, Hard, Fold, SineFold, XSin) : the shape is replaced by its mean between two inputs (its_Sat_Adaa) ;
        in its work area
        the shape : mode Par2 (tanh, hard clip, fold, sine fold, x - A sin(n x), Chebyshev T_n, Cheb. sum, Curve), the order n
        in Par7, A in Par9, the curve in Par10 (see its_Sat_Curve),
        the stretch in Par8 (Cheb. sum), each one modulated by the third input ; the weights of Cheb. sum in its_Efx_Harm1
    Matrix : a feedback delay network on the channels of its source, see exec_matrix
    Shimmer : the Matrix with a pitch shifter in each line (the tail climbs or falls by intervals), see exec_matrix
    Flanger, Chorus : modulated delays on the channels of its source (Through-zero, barber pole, voices), see exec_flanger
    Phaser : swept allpass stages on the channels of its source (one pole, two pole, barber pole), see exec_phaser
    Noise : noises on its channels (colors, impulses, chaotic maps), decorrelated or not, see exec_noise
    Random : random control signals on its channels (held, smooth, a walk ; irregular clocks ; its source : a trigger),
        see exec_random
    Math : operations on its sources A and B (Mul, Add, Env, Gate, Slew, Log ...), see exec_math
    Ring : the ring modulator, AM, the frequency shifter (Up, Down) ; the carrier : B or an oscillator, see exec_ring
    VU meter : the meters of the plugin Multichannel_VU_meter on its source, unchanged to the output, see exec_vu
    Limiter : the plugin SmoothMultiLimiter on its source (delayed by the anticipation), see exec_limiter
    Bypass (its_EfxStat_Bypass) : Out = the first source not null, unchanged (an LFO, a Noise, a Random : nothing)
    Auto-limiter (its_Efx_Lim, not the LFO) : the output of the type, divided by max(1, its smoothed peak), then the output gain
    the structure is checked again after each modification (its_Efx_Check reset to 0) ; the error is kept in its_Efx_Error
*/
function exec_fx(fx, nbr)
local (tw, sj, ty, ptsrc, src, dst, cc, ccnt, g, i, c, err, ph, x, v, sh, amp, dc, spr, mbad, mp, f, q, md, cf, st, w, cw, sw, al, a0, b0, b1, b2, y,
       wk, ns, k, qk, s, os, gd, bi, shb, mix, og, u, p, yd, on, lim, out, go, m, e, ct, fg, fk, fa, fn, fb, ad, nb, fr, f2)
(
    (fx[its_Efx_Check] !== BLOCK_CHECK) ? (
        err = mbad = 0;
        ty = fx[its_Efx_Type];
        ccnt = fx[its_Efx_CCnt];
        (its_Fx_NSrc(ty) < 0) ? (
            err = 2706; // erreur : type not (yet) executed
        ) :
        ((ccnt <= 0) || (ccnt > 128) || (ccnt !== floor(ccnt))) ? (
            err = 2701; // erreur : bad channel count
        ) :
        ((dst = its_Out_Cell(fx[its_Efx_OutK], fx[its_Efx_OutOff], ccnt, CblFxStart[nbr], CblFxWidth[nbr])) <= 0) ? (
            err = 2702; // erreur : bad output (own cable, Out or bus)
        ) : (
            fx[its_Efx_OutCell] = dst;
            fx[its_Efx_OutAdd] = (fx[its_Efx_OutK] !== 0);
            (its_Fx_NSrc(ty) > 0) ? (
                // Mixer, Auto Mixer : the sources ; Filter, Saturation : its source (the first one)
                cc = 0; ptsrc = fx + its_Efx_Src1; sj = 0;
                loop(its_Fx_NSrc(ty),
                    g = ptsrc[its_Efx_VoldB1 - its_Efx_Src1];
                    ptsrc[its_Efx_Vol1 - its_Efx_Src1] = (g > -120) ? 10^(g/20) : 0;
                    tw = its_Fx_SrcWj(fx, sj, ptsrc[0], ptsrc[its_Efx_Off1 - its_Efx_Src1]);
                    ((sj === 1) && ((ty === its_Efx_TyMath) || (ty === its_Efx_TyRing))) ? (fx[its_Efx_St1] = (tw > 1)); // (B : one channel per channel, or its first one)
                    src = its_Src_Cell(ptsrc[0], ptsrc[its_Efx_Off1 - its_Efx_Src1], tw);
                    ptsrc[its_Efx_Cell1 - its_Efx_Src1] = max(0, src);
                    (src < 0) ? (
                        err = 2703; // erreur : bad source
                    ) :
                    ((src > 0) && (src < dst + ccnt) && (src + tw > dst)) ? (
                        err = 2704; // erreur : a source overlaps the output
                    ) :
                    (src > 0) ? (
                        cc += 1;
                    );
                    ptsrc += its_EfxDist; sj += 1;
                );
                ((err === 0) && (((cc === 0) && (ty !== its_Efx_TyRandom)) || (((ty === its_Efx_TyMath) || (ty === its_Efx_TyRing)) && (fx[its_Efx_Src1] === 0)))) ? (
                    err = 2705; // erreur : no source (the trigger of a Random : optional ; a Math, a Ring : A, B optional)
                );
            );
            // the modulation inputs : an error is not fatal (no modulation, the error is shown)
            ((ty === its_Efx_TyFilter) || (ty === its_Efx_TySat) || its_Mx_Is(ty) || its_Fl_Is(ty) || (ty === its_Efx_TyPhaser)
                || (ty === its_Efx_TyNoise) || (ty === its_Efx_TyRandom) || (ty === its_Efx_TyMath) || (ty === its_Efx_TyRing)) ?
                (mbad = its_Mod_Resolve(fx + its_Efx_Mod1, (ty === its_Efx_TyFilter) ? 2 : 3));
        );
        fx[its_Efx_Error] = (err === 0) && mbad ? 2715 : err; // 2715 : a modulation input is not valid
        (err === 0) ? (
            fx[its_Efx_Check] = BLOCK_CHECK;
        );
    );
    (fx[its_Efx_Check] === BLOCK_CHECK) ? (
        dst = fx[its_Efx_OutCell] + smpl_tab;
        ccnt = fx[its_Efx_CCnt];
        (fx[its_Efx_OutAdd] === 0) ? (
            memset(dst, 0, ccnt); // own cable : this effect is its only source
            fx[its_Efx_OutDirty] = 1;
        );
        // the auto-limiter (not the LFO, not in Bypass) : the effect writes into its_FxTmp, then the limiter adds it to dst
        lim = fx[its_Efx_Lim] && !its_Fx_Ctl(fx[its_Efx_Type]) && !its_Fx_Meter(fx[its_Efx_Type]) && (fx[its_Efx_Status] !== its_EfxStat_Bypass);
        out = lim ? its_FxTmp : dst;
        lim ? memset(out, 0, ccnt);
        go = 1; // the output gain, after the limiter (Saturation : Par6)
        (fx[its_Efx_Status] === its_EfxStat_Bypass) ? (
            ((its_Fx_NSrc(fx[its_Efx_Type]) > 0) && !its_Fx_Ctl(fx[its_Efx_Type])) ? (
                c = 0; ptsrc = fx + its_Efx_Src1;
                loop(its_Fx_NSrc(fx[its_Efx_Type]),
                    (c === 0) ? (c = ptsrc[its_Efx_Cell1 - its_Efx_Src1]);
                    ptsrc += its_EfxDist;
                );
                (c > 0) ? (
                    src = smpl_tab + c;
                    i = 0; loop(ccnt,
                        dst[i] += src[i];
                        i += 1;
                    );
                );
            );
            // the filter, the saturation start again from silence when turned on (their states are cleared, see its_FxW_Md)
            ((wk = fx[its_Efx_Work]) > BASE_MEMORY) ? (wk[its_FxW_Md] = -1);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyLFO) ? (
            ph = fx[its_Efx_St1];
            sh = fx[its_Efx_Par1 + 1];
            amp = fx[its_Efx_Par1 + 2];
            dc = fx[its_Efx_Par1 + 3];
            spr = fx[its_Efx_Par1 + 4];
            ct = its_CrvTab + max(0, min(its_CrvMx - 1, 0|fx[its_Efx_Par1 + 5])) * its_CrvTbSz + its_CrvTbG;
            i = 0; loop(ccnt,
                x = ph + i * spr;
                x -= floor(x);
                v = (sh === its_LfoCurve) ? its_Crv_Cyc(ct, x) : // the table of the curve
                    (sh === its_LfoSine) ? sin(2 * $pi * x) :
                    (sh === its_LfoTri) ? ((x < 0.5) ? 4 * x - 1 : 3 - 4 * x) :
                    (sh === its_LfoSawUp) ? 2 * x - 1 :
                    (sh === its_LfoSawDown) ? 1 - 2 * x :
                    ((x < 0.5) ? 1 : -1);
                dst[i] += dc + amp * v;
                i += 1;
            );
            ph += fx[its_Efx_Par1] / srate;
            fx[its_Efx_St1] = ph - floor(ph);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyFilter) ? (
            wk = fx[its_Efx_Work];
            ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
                src = smpl_tab + fx[its_Efx_Cell1];
                g = fx[its_Efx_Vol1];
                mp = fx + its_Efx_Mod1;
                f = max(1, min(0.45 * srate, its_Mod_Apply(mp, fx[its_Efx_Par1], its_ModA_Oct, 1)));
                q = max(0.05, min(2000, its_Mod_Apply(mp + its_ModDist, fx[its_Efx_Par1 + 1], its_ModA_Oct, 1)));
                md = fx[its_Efx_Par1 + 2];
                ns = its_Flt_Stages(fx);
                cf = wk + its_FxW_Hdr;
                st = cf + 5 * ns;
                (md !== wk[its_FxW_Md]) ? memset(st, 0, 2 * ns * ccnt); // another mode : another use of the states
                ((f !== wk[its_FxW_F]) || (q !== wk[its_FxW_Q]) || (md !== wk[its_FxW_Md])) ? (
                    // the coefficients (biquads : RBJ cookbook)
                    wk[its_FxW_F] = f; wk[its_FxW_Q] = q; wk[its_FxW_Md] = md;
                    w = 2 * $pi * f / srate;
                    (md < its_FltLP) ? (
                        // one pole stages (trapezoidal integrators) : cf[0] = G = g / (1 + g), g = tan(w / 2), the same for
                        // all the stages ; cf[1] = the feedback k of 4 and 8 stages : r * kc, kc = 1 / cos(pi / ns)^ns
                        // (the gain of self oscillation), r = 1 - 0.707 / Q in [0, 1[ (Q 0.707 or less : none)
                        al = tan(0.5 * w); cf[0] = al / (1 + al);
                        cf[1] = (ns >= 4) ? max(0, 1 - sqrt(0.5) / q) / (cos($pi / ns) ^ ns) : 0;
                    ) : (
                        cw = cos(w); sw = sin(w);
                        c = cf; k = 0; loop(ns,
                            // low pass, high pass : Q of the stage k of a Butterworth filter of order 2 * ns, the last one
                            // (the highest Q) multiplied by the resonance ; band pass, notch : the same stages
                            qk = ((md === its_FltLP) || (md === its_FltHP)) ?
                                0.5 / cos((2 * k + 1) * $pi / (4 * ns)) * ((k === ns - 1) ? q / sqrt(0.5) : 1) : q;
                            al = sw / (2 * qk); a0 = 1 + al;
                            (md === its_FltLP) ? (b0 = (1 - cw) / 2; b1 = 1 - cw; b2 = b0;) :
                            (md === its_FltHP) ? (b0 = (1 + cw) / 2; b1 = -(1 + cw); b2 = b0;) :
                            (md === its_FltBP) ? (b0 = al; b1 = 0; b2 = -al;) :
                            (b0 = 1; b1 = -2 * cw; b2 = 1;); // notch
                            c[0] = b0 / a0; c[1] = b1 / a0; c[2] = b2 / a0; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
                            c += 5; k += 1;
                        );
                    );
                );
                (md < its_FltLP) ? (
                    /*
                        one pole stages (TPT : trapezoidal integrator, state s[0]) : low pass, or the input minus the low pass ;
                        a ladder (as the Moog filter) : the input of the first stage is x - k * (the output), the loop solved
                        without delay : a stage gives fa * (its input) + (a term of its state), so the output is
                        fn * u + y0, fn = fa^ns, y0 the output for a null input u ; u = ((1 + k) x - k y0) / (1 + k fn),
                        (1 + k) : the gain of the pass band kept ; the resonance near cutoff * tan(pi / ns) (low pass), or
                        cutoff / tan(pi / ns) (high pass) : at the cutoff for 4 stages
                    */
                    fg = cf[0]; fk = cf[1];
                    fa = (md === its_FltLP1) ? fg : 1 - fg; fn = fa ^ ns; fb = (md === its_FltLP1) ? 1 - fg : fg - 1;
                    i = 0; loop(ccnt,
                        x = g * src[i];
                        s = st + 2 * ns * i;
                        (fk > 0) ? (
                            y = 0; p = s; loop(ns, y = fa * y + fb * p[0]; p += 2;);
                            x = ((1 + fk) * x - fk * y) / (1 + fk * fn);
                        );
                        loop(ns,
                            v = (x - s[0]) * fg; y = v + s[0]; s[0] = y + v;
                            x = (md === its_FltLP1) ? y : x - y;
                            s += 2;
                        );
                        !(abs(x) < its_FinMax) ? (memset(st + 2 * ns * i, 0, 2 * ns); x = 0; its_NaNCnt += 1;);
                        out[i] += x;
                        i += 1;
                    );
                ) : (
                    // biquads, transposed direct form II (2 states per stage and per channel)
                    i = 0; loop(ccnt,
                        x = g * src[i];
                        s = st + 2 * ns * i;
                        c = cf;
                        loop(ns,
                            y = c[0] * x + s[0];
                            s[0] = c[1] * x - c[3] * y + s[1];
                            s[1] = c[2] * x - c[4] * y;
                            x = y;
                            s += 2; c += 5;
                        );
                        !(abs(x) < its_FinMax) ? (memset(st + 2 * ns * i, 0, 2 * ns); x = 0; its_NaNCnt += 1;);
                        out[i] += x;
                        i += 1;
                    );
                );
            );
        ) :
        its_Mx_Is(fx[its_Efx_Type]) ? (
            exec_matrix(fx, ccnt, out);
        ) :
        its_Fl_Is(fx[its_Efx_Type]) ? (
            exec_flanger(fx, ccnt, out);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyPhaser) ? (
            exec_phaser(fx, ccnt, out);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyNoise) ? (
            exec_noise(fx, ccnt, out);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyRandom) ? (
            exec_random(fx, ccnt, out);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyMath) ? (
            exec_math(fx, ccnt, out);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyRing) ? (
            exec_ring(fx, ccnt, out);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyVU) ? (
            exec_vu(fx, ccnt, out);
        ) :
        (fx[its_Efx_Type] === its_Efx_TyLimiter) ? (
            exec_limiter(fx, ccnt, out);
        ) :
        (fx[its_Efx_Type] === its_Efx_TySat) ? (
            wk = fx[its_Efx_Work];
            ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
                src = smpl_tab + fx[its_Efx_Cell1];
                g = fx[its_Efx_Vol1];
                mp = fx + its_Efx_Mod1;
                gd = 10^(max(-48, min(144, its_Mod_Apply(mp, fx[its_Efx_Par1], its_ModA_Add, 1))) / 20); // drive
                bi = max(-8, min(8, its_Mod_Apply(mp + its_ModDist, fx[its_Efx_Par1 + 2], its_ModA_Add, 1))); // bias
                md = fx[its_Efx_Par1 + 1];
                mix = max(0, min(1, fx[its_Efx_Par1 + 3]));
                og = 10^(fx[its_Efx_Par1 + 5] / 20);
                lim ? (go = og; og = 1;); // the limiter, then the output gain
                os = 2^max(0, min(its_SatOSCnt - 1, floor(fx[its_Efx_Par1 + 4])));
                // the order (Par7), or the stretch (Par8) in the mode Cheb. sum, modulated
                on = max(-64, min(64, its_Mod_Apply(mp + 2 * its_ModDist, fx[its_Efx_Par1 + ((md === its_SatChebSum) ? 7 : 6)], its_ModA_Add, 1)));
                shb = its_Sat_Shape(bi, md, on, fx); // the output for a null input : removed
                ad = (fx[its_Efx_Par1 + 10] !== 0) && its_Sat_AdOk(md); // ADAA
                nb = ad ? 2 : 4; // the biquads of the anti-aliasing filter
                cf = wk + its_FxW_Hdr;
                st = cf + 5 * 4;
                ((os !== wk[its_FxW_Md]) || (nb !== wk[its_FxW_Nb])) ? (
                    // another oversampling, ADAA or not : the anti-aliasing filter, nb biquads (Butterworth, order 2 nb) at 0.45 * srate
                    wk[its_FxW_Md] = os; wk[its_FxW_Nb] = nb;
                    memset(st, 0, its_SatChW * ccnt);
                    w = 2 * $pi * 0.45 / os; cw = cos(w); sw = sin(w);
                    c = cf; k = 0; loop(nb,
                        qk = 0.5 / cos((2 * k + 1) * $pi / (4 * nb));
                        al = sw / (2 * qk); a0 = 1 + al;
                        c[0] = (1 - cw) / (2 * a0); c[1] = (1 - cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
                        c += 5; k += 1;
                    );
                );
                // ADAA : the primitives kept (s[12]) are valid while the shape does not change (its mode ; x - A sin : its order, A)
                fr = ad && (wk[its_FxW_AdK] === md)
                    && ((md !== its_SatXSin) || ((wk[its_FxW_AdN] === on) && (wk[its_FxW_AdA] === fx[its_Efx_Par1 + 8])));
                wk[its_FxW_AdK] = ad ? md : -1; wk[its_FxW_AdN] = on; wk[its_FxW_AdA] = fx[its_Efx_Par1 + 8];
                i = 0; loop(ccnt,
                    x = g * src[i];
                    s = st + its_SatChW * i;
                    (os === 1) ? (
                        y = (ad ? its_Sat_Adaa(gd * x + bi, s, md, on, fx, fr) : its_Sat_Shape(gd * x + bi, md, on, fx)) - shb;
                    ) : (
                        f2 = fr;
                        k = 1; loop(os,
                            u = s[0] + (x - s[0]) * k / os; // linear interpolation from the previous input
                            v = (ad ? its_Sat_Adaa(gd * u + bi, s, md, on, fx, f2) : its_Sat_Shape(gd * u + bi, md, on, fx)) - shb;
                            f2 = 1;
                            c = cf; p = s + 3;
                            loop(nb,
                                y = c[0] * v + p[0];
                                p[0] = c[1] * v - c[3] * y + p[1];
                                p[1] = c[2] * v - c[4] * y;
                                v = y;
                                p += 2; c += 5;
                            );
                            k += 1;
                        );
                        y = v; // the last value : decimation
                        s[0] = x;
                    );
                    yd = y - s[1] + its_SatDcK * s[2]; // DC blocker (about 10 Hz)
                    s[1] = y; s[2] = yd;
                    !(abs(yd) < its_FinMax) ? (memset(s, 0, its_SatChW); yd = 0; its_NaNCnt += 1;);
                    out[i] += og * ((1 - mix) * x + mix * yd);
                    i += 1;
                );
            );
        ) : (
            // Mixer, Auto Mixer
            ptsrc = fx + its_Efx_Src1;
            loop (8,
                ((c = ptsrc[its_Efx_Cell1 - its_Efx_Src1]) > 0) ? (
                    src = smpl_tab + c;
                    g = ptsrc[its_Efx_Vol1 - its_Efx_Src1];
                    i = 0; loop(ccnt,
                        out[i] += g * src[i];
                        i += 1;
                    );
                );
                ptsrc += its_EfxDist;
            );
        );
        (lim) ? (
            // auto-limiter : peak envelope of all the channels (attack 5 ms, release 1.5 s), gain 1 / max(1, env) ;
            // short overshoots are possible (no look-ahead), at the attacks and when a setting changes
            m = 0; i = 0; loop(ccnt, m = max(m, abs(out[i])); i += 1;);
            e = fx[its_Efx_LimEnv];
            e += ((m > e) ? its_LimAtt : its_LimRel) * (m - e);
            !(abs(e) < its_FinMax) ? (e = 1; its_NaNCnt += 1;);
            fx[its_Efx_LimEnv] = e;
            g = go / max(1, e);
            i = 0; loop(ccnt, dst[i] += g * out[i]; i += 1;);
        );
        exec_effect += 1;
    ) :
    (fx[its_Efx_OutDirty] && (CblFxStart[nbr] > 0)) ? (
        // not executed : its own cable is silent
        memset(smpl_tab + CblFxStart[nbr], 0, CblFxWidth[nbr]);
        fx[its_Efx_OutDirty] = 0;
    );
);




//======== Serialize Procedures : save_mem, load_mem (mSL_Serialize.jsfx-inc)

// (a reader or a writer of another size : saved by another version, not compatible)
function check_its_block(cbl)
(
    (cbl[0] !== SECURE_BL) || (cbl[cbl[-1]-1] !== SECURE_BL)
        || ((cbl[-2] === KW_read) && (cbl[-1] !== its_Rdr_BlkSize)) || ((cbl[-2] === KW_writ) && (cbl[-1] !== its_Wrt_BlkSize));
);

// free the blocks of a load not used (DuplWA) : the lines have no buffers yet (see recreate_structures)
function its_Load_Drop()
local (i, b)
(
    i = 0; loop(PtrsInWA,
        ((b = DuplWA[i]) > BASE_MEMORY) ? (
            (b[-2] === KW_lcbl) ? memset(b + its_Lin_BF1ST, 0, 128); // (pointers of the saved line : not ours)
            mSL_Dyn_Free(b);
        );
        DuplWA[i] = 0;
        i += 1;
    );
);

function recreate_structures()
local (ln, renew, nlcbl, olcbl, nrcbl, nwcbl, alt, i, nl, nr, nw, nf, bad)
(
    // what was loaded (see the log)
    nl = nr = nw = nf = bad = 0;
    i = 0; loop(LN_CNT + 1, (Lines_Set[i + AltWAdec] !== 0) ? (nl += 1); i += 1;);
    i = 0; loop(RD_CNT + 1, (Readers_set[i + AltWAdec] !== 0) ? (nr += 1); i += 1;);
    i = 0; loop(WR_CNT + 1, (Writers_set[i + AltWAdec] !== 0) ? (nw += 1); i += 1;);
    i = 0; loop(FX_CNT + 1, (Effects_set[i + AltWAdec] !== 0) ? (nf += 1); i += 1;);
    // the old lines : their Tmp1 tells if they are reused (see below)
    ln = 0; loop(LN_CNT + 1, ((olcbl = Lines_Set[ln]) !== 0) ? (olcbl[its_Lin_Tmp1] = 0); ln += 1;);
    // Update newly loaded line structures : first, the lines that can reuse the buffers of an old line
    ln = 0; loop(LN_CNT + 1,
        renew = -1;
        nlcbl = Lines_Set[ln+AltWAdec]; // nouvelle "ln"
        (nlcbl !== 0) ? (
            memset(nlcbl+its_Lin_BF1ST, 0, 128); // (pointers of the saved line : not ours)
            olcbl = Lines_Set[ln]; // ancienne "ln"
            (olcbl !== 0) ? (
                // Peut-on réutiliser l'ancienne ligne ?
                ((olcbl[its_Lin_ChCnt] === nlcbl[its_Lin_ChCnt]) // meme nombre de canaux
                    && (olcbl[its_Lin_SmplCnt] === nlcbl[its_Lin_SmplCnt]) // meme nombre de sample
                    && (olcbl[its_Lin_Tmp1] === 0)) ? ( // non encore utilisé
                    renew = ln;
                    olcbl[its_Lin_Tmp1] = 1000 + ln;
                );
            );
            // peut-on retrouver une ancienne ligne similaire ?
            alt = 0;
            while ((renew < 0) && (alt < LN_CNT)) (
                olcbl = Lines_Set[alt];
                ((olcbl != 0) && (olcbl[its_Lin_ChCnt] === nlcbl[its_Lin_ChCnt])
                    && (olcbl[its_Lin_SmplCnt] === nlcbl[its_Lin_SmplCnt])
                    && (olcbl[its_Lin_Tmp1] === 0)) ? ( // the old line is not yet used (was nlcbl)
                    renew = alt;
                    olcbl[its_Lin_Tmp1] = 2000 + ln;
                );
                alt += 1; // (was missing : the loop ran up to the JSFX limit)
            );

            (renew < 0) ? (
                nlcbl[its_Lin_Tmp1] = -1; // new buffers : allocated below, once the old lines not reused are freed
            ) : (
                // On réutilise les buffers de l'ancienne ligne
                olcbl = Lines_Set[renew];
                i = its_Lin_BF1ST; loop (128,
                    nlcbl[i] = olcbl[i];
sprintf(#A007,"buff-r  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i-1, nlcbl[i-1]);
sprintf(#A008,"buff-r  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i, nlcbl[i]);
                    olcbl[i] = 0; i += 1;
                );
            );
            nlcbl[its_Lin_Check] = 0; // for future fast check
sprintf(#A006,"nlcbl %d {%d  ch=%d  sz=%d}", ln, nlcbl, nlcbl[its_Lin_ChCnt], nlcbl[its_Lin_SmplCnt]);
            dbg_show_2(i__mem,66)
        );
        ln += 1;
    );
    // the old lines not reused are freed first : a large line could not be allocated while the old ones still exist
    ln = 0; loop(LN_CNT + 1,
        (((olcbl = Lines_Set[ln]) !== 0) && (olcbl[its_Lin_Tmp1] === 0)) ? Ln_Delete(ln);
        ln += 1;
    );
    // then the new buffers (a line that cannot get all its buffers is not created : error 2610 in its pad)
    ln = 0; loop(LN_CNT + 1,
        nlcbl = Lines_Set[ln+AltWAdec];
        ((nlcbl !== 0) && (nlcbl[its_Lin_Tmp1] === -1)) ? (
            nlcbl[its_Lin_Tmp1] = 0;
            renew = 1; // all the buffers allocated
            i = its_Lin_BF1ST; loop(nlcbl[its_Lin_ChCnt],
                ((nlcbl[i] = mSL_Dyn_Alloc(nlcbl[its_Lin_ActBSize], KW_buff, mSL_StM_FlClear)) < BASE_MEMORY) ? (
                    nlcbl[i] = 0; renew = 0;
                );
                i += 1;
            );
            (renew) ? (
                Ln_MemErr[ln] = 0;
            ) : (
                i = its_Lin_BF1ST; loop(128, (nlcbl[i] > BASE_MEMORY) ? mSL_Dyn_Free(nlcbl[i]); nlcbl[i] = 0; i += 1;);
                mSL_Dyn_Free(nlcbl);
                Lines_Set[ln+AltWAdec] = 0;
                Ln_MemErr[ln] = 1;
                bad += 1;
            );
        );
        ln += 1;
    );
    // On peut libérer les anciennes lignes
    ln = 0; loop(LN_CNT + 1,
        Ln_Delete(ln);
        ln += 1;
    );

    // Update readers
    ln = 0; loop(RD_CNT + 1,
        nrcbl = Readers_set[ln+AltWAdec];
        (nrcbl !== 0) ? (
            // update lines addresses
            (nrcbl[its_Rdr_Lcbl] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_Lcbl] = Lines_Set[nrcbl[its_Rdr_LineNb]+AltWAdec];
sprintf(#A004,"UpdRd %d bn=%d ba=%d", ln, nrcbl[its_Rdr_LineNb], Lines_Set[nrcbl[its_Rdr_LineNb]+AltWAdec]);
            );
            // reader lié à un writer ?
            (nrcbl[its_Rdr_WrBPtr] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_WrBPtr] = Writers_set[nrcbl[its_Rdr_WrSrc]+AltWAdec];
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens lecteurs
    ln = 0; loop(RD_CNT + 1,
        Rd_Delete(ln);
        ln += 1;
    );

    // Update writers
    ln = 0; loop(WR_CNT + 1,
        nwcbl = Writers_set[ln+AltWAdec];
        (nwcbl !== 0) ? (
            (nwcbl[its_Wrt_Lcbl] > BASE_MEMORY) ? (
                // Update with the new address
                nwcbl[its_Wrt_Lcbl] = Lines_Set[nwcbl[its_Wrt_LineNb]+AltWAdec];
sprintf(#A005,"UpdWr %d st=%d bn=%d ba=%d", ln, nwcbl[its_Wrt_Status], nwcbl[its_Wrt_LineNb], Lines_Set[nwcbl[its_Wrt_LineNb]+AltWAdec]);
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens écrivains
    ln = 0; loop(WR_CNT + 1,
        Wr_Delete(ln);
        ln += 1;
    );

    // On peut libérer les anciens effets
    ln = 0; loop(FX_CNT + 1,
        FX_Delete(ln);
        ln += 1;
    );

    // mise en place du nouveau bloc d'addresses
    memcpy(StaticWA, DuplWA, StaticWASize);
    memset(DuplWA, 0, StaticWASize);
    updt_tables(StaticWA);
    sprintf(#its_LdMsg, "Load : %d lines, %d readers, %d writers, %d effects ; %d lines without memory", nl, nr, nw, nf, bad);
    its_LdMsgOn = 1; // written in the log by @gfx
);

/*
    Gather all information needed for a preset
    SVASIZ is at least 32
*/
function build_savarea()
(
    memset(savarea, 0, SVASIZ);
    savarea[0] = savcode;

    savarea[10] = its_GlSmpl; // (not read : always Merge after a load)
    savarea[13] = its_GlInGain;
    savarea[14] = its_GlOutVol;

    savarea[SVASIZ-1] = savcode;
);

function load_loadarea()
(
    // after a preset load, always back to "Merge" (the saved mode lodarea[10] is ignored)
    its_GlSmpl = 0;
    its_GlInGain = lodarea[13];
    its_GlOutVol = lodarea[14];
    its_Gl_Apply();
);

/*
    put in place the structures of a load (@serialize) : by @block, between two audio blocks ; but REAPER does not call
    @block when the track is not processed (after a load, until the audio restarts) : then @gfx does it, once @block has
    not run for its_LdWait seconds (its_Hold stops @sample meanwhile, in case the audio restarts)
*/
its_LdWait = 0.25;
its_BlkCnt = its_LdBlk = its_LdTime = its_LdSeen = its_Hold = 0;
function its_Load_Install()
(
    perform_loading = 0;
    its_LnKeep = 1; // the old lines are deleted, the names of the files just loaded are kept (its_LnFile, 'lfil')
    recreate_structures(); // also update tables
    its_LnKeep = 0;
    load_loadarea();
    its_PatchForce = 1; // the cables and the cells of all the modules (see its_Patch_Update)
    rdupdt = lnupdt = 1;
    handling_load = 0;
    its_LnRldPend = 1; its_LnRldIdx = its_LnRldOk = its_LnRldErr = 0; // the files of the lines are read again (@gfx)
);



// Print a sequence of strings
function mSL_133(argc, argv)
(
    while (argc > 0) (
        mSL_log(SysLogBox, argv[0]);
        argc -= 1; argv += 1;
    );
);

// This redefines the function "mSL_134" as the product of its operands
function mSL_134(argc, argv)
local (product, ip)
(
    product = 1;
    ip = 0;
    loop(argc, product *= argv[ip]; ip += 1;);
    product;
);

// External access to some useful data structures
function mSL_135(argc, argv)
local (item)
(
    item = argv[0];
    (item == KodedSchPads) ? (
        SchedPadSet; // A 16 entries array
    ) :
    (
        -1;
    );
);

function mSL_define_extensions()
(
    mSL_define_opcode("GM_Log", 133); // define "GM_Log"
    mSL_define_opcode("print", 133); // define print as a synonyp for "GM_Log"
    mSL_define_opcode("prod", 134); // define "prod"
    mSL_define_opcode("GM_Addr", 135); // etc.
);

// define our new extensions
mSL_define_extensions();


initAllParameters();
dclAllParameters();

// GC bounds : roots (mm_usr_prot, StaticWA, paramBlock...) and the dynamic memory must be
// between mm_lowblocks and mm_highblocks, otherwise gc_mark ignores them
mm_highblocks = make_array(2); // no block with memory references beyond that
mm_highblocks[0] = 'High'; mm_highblocks[1] = '_Mem';


/*
    Gui operations
*/
function mSL_gui_ops(argc, argv)
local(res, kw, npar, pp, r, sr, n, cnt, i, j, v, chk, idt,
      s, k, w, xbox, chkprev, res_end, ptb, ptw, pts, pta, lct, ds, ref, txt)
(
    res = Undef;
    (argc > 1) ? (
        kw = argv[0];
        npar = argv[1];

        (kw === mSL_KW_slider) ? (
            pp = 0;
            ((npar === (0|npar)) && (npar >= paramBase) && (npar <= paramNMax)) ? (
                pp = paramBlock + npar * paramEntSize;
            ) :
            ((npar > mSL_Sym_Low) && (npar < mSL_Sym_High) && (mSL_getinHT(paramHashTbl, npar) >= 0)) ? (
                pp = paramBlock + (npar = mSL_getinHTaux) * paramEntSize;
            );
            (pp != 0) ? (
                (argc >= 11) ? (
                    parDclMode = 1;
                    r = parDcl(npar, argv[2], argv[3], argv[4], argv[5], argv[6], argv[7], argv[8], argv[9], argv[10],
                        ((argc >= 12) ? argv[11]: 0), ((argc >= 13) ? argv[12]: 0), ((argc >= 14) ? argv[13]: 0),
                        ((argc >= 15) ? argv[14]: 0), ((argc >= 16) ? argv[15]: 0), ((argc >= 17) ? argv[16]: 0));
                    (r === 0) ? (
                        argc = 2; // return/build the entry
                    ) : (
                        // signal error
                        sprintf(#u, "++Slider error: %d - %d", npar, r);mSL_log(SysLogBox, #u);
                        argc = 2;
                    );
                );
                ((argc === 2) && (pp[pp_Name] != 0) && (pp[pp_Name] != #pUndef)) ? (
                    // return, if any, the slider block reference
                    sr = pp[pp_mSL_Ref];
                    ((sr > 0) && (mSL_bl_check(sr, 'sldr')) && (sr[-1] >= 12)) ? (
                        res = sr;
                    ) : (
                        pp[pp_mSL_Ref] = res = mSL_Dyn_Alloc(12, 'sldr', mSL_StM_FlClear);
                    );
                    // Create/update the slider descriptor
                    pp[pp_Addr] = res + 3;
                    paramFlags[npar] |= pflg_ChkWrite;
                    res[0] = mSL_KW_slider;
                    res[1] = npar;
                    res[2] = pp[pp_mSL_Code];
                    res[3] = parGetV(npar);
                    res[4] = pp[pp_Name];
                    res[5] = pp[pp_SFmt];
                    res[6] = pp[pp_MFmt];
                );
            );
        ) :
        (kw === mSL_KW_declare) ? (
            (mSL_bl_check(npar, 'umod') && (argc >= 4)) ? (
                idt = argv[2]; // uname
                n = argv[3]; // module. num
                (mSL_isString(idt) && (n === (0|n)) && (n >= 0) && (n <= dcbUModsSiz)) ? (
                    // declare the module
                    blockUsrNames[n] = idt;
                    blockUsrRefs[n] = npar;
                    res = n;
                );
            );
        ) :
        (kw === mSL_KW_update) ? (
            ((npar === mSL_KW_sliders) || (npar === mSL_KW_Params)) ? (
                // Rebuild parameters sliders
                menu_Param_mSL = 0;
                menu_Param_UBS = 0;
                menu_Param_UBD = 0;
                parDclMode = 0;
                dclAllParameters();
            ) :
            (npar === mSL_KW_modules) ? (
                // After creating new users modules
                checkUsrMods(); // valid blocks
                mkModuleMenu();// rebuild the menu
            );
        ) :
        (kw === mSL_KW_sbox) ? (
            // Creating a Slider Box
            cnt = argc - 1; // count of expected sliders references
            i = 1; n = 0; loop(cnt,
                v = argv[i];
                // lets check that v is a slider reference
                mSL_bl_check(v, 'sldr') ? (n += 1);
                i += 1;
            );
            (n === cnt) ? (
                // all parameters are sliders. Let's create the container
                res = mSL_Dyn_Alloc(ubx_isiz+cnt, 'sbox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'sbox'; // this is a slider box
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res;  // points to itself
                res[ubx_anc] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // no direct descendants
                res[ubx_icnt] = cnt; // items count
                res[ubx_1st] = 0; // not relevant for now
                res[ubx_tcnt] = 0; // no descendants at all
                //----
                res[ubx_l] = 0; // not relevant for now
                res[ubx_t] = 0; // not relevant for now
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_slidh * cnt; // actual value in pixels, "correct"
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                i = 1; j = ubx_isiz; loop(cnt,
                    res[j] = argv[i]; i += 1; j += 1;
                );
            );
        ) :
        (kw === mSL_KW_ibox) ? (
            // Create an info box with a set of infos to display
            cnt = argc - 1; // count of expected parameters
            (cnt > 1) ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+cnt+1), 'ibox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'ibox'; // This is an infobox
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // direct descendants count
                res[ubx_icnt] = 1;  // one item
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = 0; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_tboxs+5; // appropriate height
                //----
                res[ubx_minw] = ui_MinSubColSize; // min size
                res[ubx_maxw] = 5 * ui_MinSubColSize; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy
                ptb[0] = cnt;
                i = 0; loop(cnt,
                    i += 1; ptb += 1;
                    ptb[0] = argv[i];
                );
            );
        ) :
        ((kw === mSL_KW_hbox)) ? (
            // Create an horizontal box, expect a set of '*box'
            xbox = 'hbox';
            k = argc - 1; // count of parameters
            chk = i = 1; chkprev = cnt = w = n = 0;
            loop(k,
                v = argv[i];
                ((chk && chkprev && (v < 1024))) ? (
                    w += 1;
                    chkprev = 0;
                ) :
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                    cnt += 1;
                    chkprev = 1;
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+2*cnt), xbox, mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = xbox; // This is an horizontal box
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy references
                ptw = ptb + cnt; // where to copy widths
                k = argc - 1; // count of parameters
                i = 1; chkprev = 0; w = 0;
                loop(k,
                    v = argv[i];
                    ((chkprev && (v < 1024))) ? (
                        ptw[w-1] = v;
                        chkprev = 0;
                    ) :
                    (mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box')) ? (
                        ptb[w] = v;
                        ptw[w] = Undef; // default width
                        chkprev = 1;
                        w += 1;
                    );
                    i += 1;
                );
            );
        ) :
        ((kw === mSL_KW_vbox)) ? (
            // Create a vertical box, expect a set of '*box'
            xbox = 'vbox';
            cnt = argc - 1; // count of expected references
            chk = i = 1; n = 0; loop(cnt,
                v = argv[i];
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+n), xbox, mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = xbox; // This is a vertical box
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy
                i = 1; loop(cnt,
                    ptb[0] = argv[i]; i += 1; ptb += 1;
                );
            );
        ) :
        (kw === mSL_KW_tbox) ? (
            // Create a text box - Expect a string as parameter
            txt = argv[1];
            (chk = mSL_isString(txt)) ? (
                res = mSL_Dyn_Alloc((s = ubx_isiz+1), 'tbox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'tbox'; // this is a slider box
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res;  // points to itself
                res[ubx_anc] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // no direct descendants
                res[ubx_icnt] = 1; // items count
                res[ubx_1st] = 0; // not relevant for now
                res[ubx_tcnt] = 0; // no descendants at all
                //----
                res[ubx_l] = 0; // not relevant for now
                res[ubx_t] = 0; // not relevant for now
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_vtext; // actual value in pixels, "correct"
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                res[ubx_isiz] = txt; // the string number
            );
        ) :
        (kw === mSL_KW_module) ? (
            // Expect a module name
            // idt = argv[1];
            // chk = mSL_isString(idt);
            cnt = argc - 1; // count of expected references
            chk = i = 1; n = 0; loop(cnt,
                v = argv[i];
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+n*ubx_isiz), 'umod', mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = 'umod'; // This is a module
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                res[ubx_thread] = mSL_current_thread; //current thread
                res[ubx_thrdid] = mSL_current_thread[mSL_THR_UTId]; // current thread id
                // res[ubx_xxxx] = 0; // ubx_xxxx is not defined : would overwrite res[ubx_ty]
                //sprintf(#b, "a ===>    0:%d   //", res[ubx_ty]); mSL_log(SysLogBox, #b);
                //----
                // First insert direct references
                ptb = res + ubx_isiz; // where to copy / create the boxes descriptions
                pts = argv + 1; // local sources
                lct = cnt; // local count
                pta = res; // current ancestor : the module we are creating
                while ((chk) && (ptb < res_end)) (
                    // Create a local box from current src
                    while ((chk) && (lct > 0)) (
                        ds = pts[0];
                        // this must be a correct reference
                        (chk = (mSL_bl_check(ds) && ((ds[-2] & 0xffffff) === 'box'))) ? (
                            // indicate first descendant
                            (pta[ubx_1st] === 0) ? (pta[ubx_1st] = ptb - res;);
                            lct -= 1;
                            // insert the source
                            //----
                            ptb[ubx_ty] = ds[ubx_ty];
                            ptb[ubx_flgs] = ds[ubx_flgs];
                            ptb[ubx_mref] = ds;
                            ptb[ubx_anc] = pta - res;
                            //----
                            ptb[ubx_lcnt] = ds[ubx_lcnt];
                            ptb[ubx_icnt] = ds[ubx_icnt];;
                            ptb[ubx_1st] = 0;
                            ptb[ubx_tcnt] = ds[ubx_tcnt];
                            //----
                            ptb[ubx_t] = ds[ubx_t];
                            ptb[ubx_l] = ds[ubx_l];
                            ptb[ubx_w] = ds[ubx_w];
                            ptb[ubx_h] = ds[ubx_h];
                            //----
                            ptb[ubx_minw] = ds[ubx_minw];
                            ptb[ubx_maxw] = ds[ubx_maxw];
                            //----
                            pts += 1; // next source
                            ptb += ubx_isiz; // where we will copy it
                        );
                    );
                    (chk && (ptb < res_end) && (lct <= 0)) ? (
                        // skip to next set source
                        pta = pta + ubx_isiz; // new ancestor
                        ref = pta[ubx_mref]; // just recheck
                        (chk = (mSL_bl_check(ref))) ? (
                            lct = ref[ubx_lcnt]; // number of direct references to include
                            pts = ref + ubx_isiz; // point to this box references
                        );
                    );
                );
                // sprintf(#b, "b ===>    0:%d   //", res[ubx_ty]); mSL_log(SysLogBox, #b);
            );
            (!chk) ? (
                res = Undef;
            );
        ) :
        (kw === mSL_KW_delete) ? (
            (npar === mSL_KW_modules) ? (
                deleteUsrMods(); // delete all, then
                mkModuleMenu();// rebuild the menu
            ) :
            (npar === mSL_KW_sliders) ? (
                i = p_ActSize;
                while (i < paramCount) (
                    parRemove(i);
                    i += 1;
                );
                menu_Param_mSL = 0;
                menu_Param_UBS = 0;
                menu_Param_UBD = 0;
                parDclMode = 0;
                dclAllParameters();
            );
        );
    );
    res;
);//mSL_gui_ops


// A text file written by GMAuxiliary.eel, in a folder of the project (see "Exports (2)" below)
<? include("GM-Libs/mSL_Export.jsfx-inc"); ?>

//============== mSL "table" : the description of a patch ===============
/*
    table(data( [Interstys] block block ... ))     (tests : Scripts/Ex-1NNN.mSL)
    A flat stream of words ; a block starts with its header and ends at the next header :
        Clear                           deletes all the lines, readers, writers and effects
        Clear All                       and the algorithms, the curves, the values of the controls (a session starts with it)
        Line id [length s] [chan n] [spls n] [file "name"]
                                        creates the line ; keeps it if it is the same, replaces it otherwise ;
                                        file : reads the sound file into the line (its size and channels : length, chan,
                                        spls are then ignored) ; a relative name is in the folder of the project
                                        (its writers and readers follow, Ln_Rebind) ; "status" and "freq" are
                                        accepted and ignored, so that a Dump can be read again
        Writer id  line L  source S  status Ready|Paused|Writing  gain dB  overdub %  mode XFade|Sum|WMix  first n  used n
                   direction Forward|Backward|Both (modes XFade, Sum)
                   WMix : fade s  plateau s  wait s  direction d (a number in [-1, 1])  desync %
                   mod Gain|Overdub|Fade|Plateau|Wait|Dir|Desync S [options] (the inputs of the pad)
        Reader id  line L | writer W  delay s  speed x  status Ready|Paused|Reading  out D  vol dB  first n  used n
                   loop once|repeat|catch|loop|exit|stop  loopspeed s/s  desync s  outchan n
                   cross On|Off (the free loop at the end of the line : it crosses it, or it jumps to the other end)
                   follow W|none (the loop follows the writer W : a forward writer of the line, not in W-Mix)
                   mode Read|Delay|Stretch|Brage|Grains ("Reader" : Read)
                   Stretch, Brage : block ms  overlap %  search ms  transp st ; Stretch : stretch x (the tempo)
                   Grains : size ms  sizernd r  plateau %  platrnd r  fadein %  fadernd r  curve id|none  gvol dB
                            volrnd r  speedrnd r  direction d  density /s  onsetrnd u (r : a random factor in [1, 5])
                   mod Offset|Speed|Volume|LoopSpd|Desync S [options] (Offset : doppler Off|On, modes Delay and Read)
                   from s  to s (the limits of the loop, modes on a line ; Dump : when it is not the whole line)
                   looplen s (the length of a loop that follows a writer)  xfade ms (Dump : when it is not 10)
                   mute On|Off  solo On|Off (Dump : when they are On)
                                        "line" : the modes on a line (Read by default), "writer" : the mode Delay ; the
                                        mode is set after them ; Dump : the keys of the mode, the optional ones when
                                        they are not the default, the modulations connected ; the status is set last
        Effect id  type T  status On|Off|Bypass  phase Std|Pre|Post  chan n  out D  limiter On|Off  (+ the keys of the type)
                   T : None, Mixer : src1 S gain1 dB ... src8 S gain8 dB ; AutoMix : src1 S ... src8 S (gains computed) ;
                   Filter : source S  gain dB  freq Hz  q x  mode LP1|HP1|LP|HP|BP|Notch  stages 1|2|4|8|16|32
                            mod Cutoff|Reso S [depth d] [att a] ;
                   LFO : freq Hz  mode Sine|Triangle|SawUp|SawDown|Square|Curve  amp a  offset o  spread s
                            curve id (the mode Curve : a curve, its number or its name) (no limiter) ;
                   Saturation : source S  gain dB  mode Soft|Hard|Fold|SineFold|XSin|Cheb|ChebSum|Curve  drive dB  bias b
                            mix %  os 1|2|4|8  output dB  order n  stretch s  amount A  harm w1 [... w16]  curve id
                            adaa On|Off (the modes Soft, Hard, Fold, SineFold, XSin ; a new Saturation : On, os 2)
                   Matrix : source S  gain dB  mode Householder|Hadamard|Ring  mix %  decay s  damp Hz  dmin ms  dmax ms
                            diffusion d  loop Decay|Freeze|Grow  seed n  delays Geometric|Linear|Harmonic|Equal|Random
                            hp Hz  inject Direct|Spread  wow ms  rate Hz  spread turns  glide s
                            mod Decay|Damping|Diffusion S [options] ;
                            mod Drive|Bias|Order S [depth d] [att a]  ("Order" : the stretch in the mode ChebSum) ;
                            harm : 1 to 16 weights, the others are 0 ; Dump : only the keys used by the mode
                                        "source", "gain" : src1, gain1 ; a new type gives its default values first
                                        (FX_Set_Type, as in the pad), the status is set last ; "mod X none" disconnects
                   mod : after the source, in any order, depth d  att a  law Add|Scale|Oct|dB  shape Lin|Exp|Log|Curve id
                            polarity Bi|Uni  bypass Off|On (the law of the input, see its_Mod_Law ; the actions possible
                            depend on the input ; Dump : the law when it is not the default one) ; the same for the
                            writers and the readers
        Global  samples Merge|Ignore|Pass  input dB  output dB
                action StartAll|StopAll|PauseAll|ResumeAll|RewindAll|MuteAll|UnmuteAll|ClearAll  chan n
                display None|Essential|All (what the patches show : see its_XpShow)
                                        the settings of the module "Globals" ; the action is performed last, at once ;
                                        "chan" (the channels of the track) is accepted and ignored, checked by Check
        Control n  value v              the generic slider Ctl n (v in [-1, 1]) ; Dump Control n
        Tab n  name "text"  panes p  widths w1 w2 w3 w4  live On|Off  pane1 "module" ...  pane4 "module" ...
                                        the tab n (1 ... dcbTabsCount) : its name ("" : the default one), its panes, the
                                        modules of each pane by their names (as Display "name" ; a pane key, even without a
                                        module : all the panes of the tab are replaced ; an unknown name : a message) ; Dump Tab n
        View "module"  Reader|Writer|Line|Effect|Curve id  words w ...
                                        what a view shows (Reader A ... H, Writer, Line, Effect A ... P, Curves A ... H : the
                                        object, it is required) and the words of its display block (as saved with the project ;
                                        also "Controls", "Connections", "Patch", "Readers", "Writers", "Effects", without an
                                        object) ; Dump View "module"
        Dump Line|Writer|Reader|Effect id | Global | Order (the execution order of the effects, see its_Fx_Order)
                                        logs the module in the same syntax ; Dump All : Global and all the modules
        Check Line|Writer|Reader|Effect id key value ... | Check Global key value ...
                                        logs "Check Writer n OK", or an error 2759 for each difference
        Free Line|Writer|Reader|Effect id
                                        deletes the module
        Curve id  type Env|Wave|HEnv|QWave|HWave  periodic Off|On  name N  sustain n|Off  points x y c  x y c ...
                                        an envelope (y in [0, 1]) or a waveform (y in [-1, 1]) : 2 ... its_CrvPMx points,
                                        x from 0 to 1 (not decreasing), c in [-1, 1] the curvature of the segment that
                                        starts at the point (see its_Crv_Shape) ; periodic : the last y is the first one ;
                                        HEnv, QWave, HWave : a half envelope, a quarter or a half of a waveform (the rest
                                        is deduced by symmetry, see the module Curves ; not periodic ; QWave : the first y
                                        is 0 ; HWave : the first and the last y are 0) ;
                                        sustain : the sustain point of an Env (1 ... the count of points ; 0 or Off :
                                        none ; new points without sustain : none) ;
                                        id : 1 ... its_CrvMx, or a name : the curves keep their names (a new name gets a
                                        free curve) ; a name (id, or the key name) : a word (not a reserved one), or a text
                                        between double quotes (1 ... its_CrvNmMx characters, without "), case sensitive :
                                        Curve "Attaque lente" ..., Curve 3 name "Env" ; a new curve : Env, from (0, 0) to
                                        (1, 1) ; Dump, Check, Free Curve id
    id : a number 1 ... LN_CNT (WR_CNT, RD_CNT, FX_CNT), or a name (not a reserved word) valid in this table only ;
    a new name gets a free module, that no number of the table designates.
    Sources S : In:c  Out:c  Bus n[:c]  Ctl n  Reader id[:c]  Effect id[:c]  none ; outputs D : Own  Out:c  Bus n[:c]
    (channels from 0, modules from 1, as in the pads).
    An omitted key keeps the value of the module, or takes its default (a line : 1 s, 2 channels).
    Four passes on the words, nothing is modified before the last one :
        0 marks the modules designated by a number, 1 gives a module to the names of the headers,
        2 checks everything on a simulation (lines, channels...), 3 executes.
    Algorithm, Instance, Free Instance|Algorithm, Dump Instance : see "Algorithms" below.
    Export Patch Line|Writer|Reader|Effect id ["name"], Export Session ["name"], Dump Patch ..., Dump Session : see "Exports (2)".
    Errors 2750 ... 2775, 2780 ... 2790, 2792 ... 2799 ; the result of "table" is 0, or the first error.
    It runs in @gfx (the mSL threads of Interstys) : the state of the analysis is global.
*/
its_TK_Cnt = 0;
its_TK_Max = 640;
its_TK_List = make_array(its_TK_Max); // the reserved words (they can't be names)
function its_TK(name) local(s)
(
    s = mSL_symbol(name);
    (its_TK_Cnt < its_TK_Max) ? ( its_TK_List[its_TK_Cnt] = s; its_TK_Cnt += 1; ) : (err_sys_ini = 2718); // (too many : its_TK_Max)
    s;
);
its_TK_Interstys = its_TK("Interstys");
its_TK_End = its_TK("End");
its_TK_EofMark = its_TK("EofMark");
its_TK_Clear = its_TK("Clear");
its_TK_Line = its_TK("Line");
its_TK_Writer = its_TK("Writer");
its_TK_Reader = its_TK("Reader");
its_TK_Effect = its_TK("Effect");
its_TK_Global = its_TK("Global");
its_TK_Dump = its_TK("Dump");
its_TK_Check = its_TK("Check");
its_TK_Free = its_TK("Free");
its_TK_Display = its_TK("Display");
its_TK_Remove = its_TK("Remove");
its_TK_All = its_TK("All");
its_TK_In = its_TK("In");
its_TK_Out = its_TK("Out");
its_TK_Bus = its_TK("Bus");
its_TK_Ctl = its_TK("Ctl");
its_TK_Own = its_TK("Own");
its_TK_length = its_TK("length");
its_TK_chan = its_TK("chan");
its_TK_spls = its_TK("spls");
its_TK_freq = its_TK("freq");
its_TK_status = its_TK("status");
its_TK_Ready = its_TK("Ready");
its_TK_Undefined = its_TK("Undefined");
its_TK_Colon = ':' + mSL_CharConst; // as mSL_cstComma
its_TK_none = its_TK("none");
its_TK_source = its_TK("source");
its_TK_gain = its_TK("gain");
its_TK_mod = its_TK("mod");
its_TK_depth = its_TK("depth");
its_TK_att = its_TK("att");
its_TK_law = its_TK("law"); // the law of a modulation input : law, shape, polarity, bypass (see its_Tb_ModOpts)
its_TK_shape = its_TK("shape");
its_TK_polarity = its_TK("polarity");
its_TK_bypass = its_TK("bypass");
its_TK_doppler = its_TK("doppler"); // (the offset of a reader in mode Delay or Read : its_ModF_Dop)
its_TK_file = its_TK("file");
its_TK_Algorithm = its_TK("Algorithm");
its_TK_Instance = its_TK("Instance");
its_TK_input = its_TK("input");
its_TK_output = its_TK("output");
its_TK_param = its_TK("param");
its_TK_Set = its_TK("Set");
its_TK_Curve = its_TK("Curve");
its_TK_points = its_TK("points");
its_TK_periodic = its_TK("periodic");
its_TK_sustain = its_TK("sustain");
its_TK_name = its_TK("name");
its_TK_Control = its_TK("Control");
its_TK_Export = its_TK("Export");
its_TK_Tab = its_TK("Tab");
its_TK_View = its_TK("View");
its_TK_Order = mSL_symbol("Order"); // (Dump Order ; reserved : a modulation input of the Saturation)
// markers of the expanded table (its_Al_Expand : never in a data) : the begin of an instance (followed by the index of its
// pending record, its_IP...), its end, the begin and the end of an argument (read in the scope outside the instance)
its_TbM_Base = -(2^50);
its_TbM_Ins = its_TbM_Base - 1;
its_TbM_InsEnd = its_TbM_Base - 2;
its_TbM_Out = its_TbM_Base - 3;
its_TbM_In = its_TbM_Base - 4;
its_TbM_Set = its_TbM_Base - 5; // the begin of a Set (followed by the index of its record, its_SP...)
its_TbM_SetEnd = its_TbM_Base - 6;
its_TbM_Chg = its_TbM_Base - 7; // the value which follows comes from a changed argument (Set)

// the keys of the writers and of the readers : their symbol, their name ; values (enumerations : the symbol of each value) ;
// the keys its_TbWMod ..., its_TbRMod ... : "mod" for each modulation input (its_TbWMI, its_TbRMI)
its_TbWMod = 14; its_TbWMINb = its_Wrt_ModN;
its_TbWNk = its_TbWMod + its_TbWMINb;
its_TbWKey = make_array(its_TbWNk); its_TbWNam = make_array(its_TbWNk);
its_TbRMod = 40; its_TbRMINb = its_Rdr_ModN;
its_TbRNk = its_TbRMod + its_TbRMINb;
its_TbRKey = make_array(its_TbRNk); its_TbRNam = make_array(its_TbRNk);
function its_TbKey(keys, nams, i, name) ( nams[i] = name; keys[i] = its_TK(name); );
its_TbKey(its_TbWKey, its_TbWNam, 0, "line"); its_TbKey(its_TbWKey, its_TbWNam, 1, "source");
its_TbKey(its_TbWKey, its_TbWNam, 2, "status"); its_TbKey(its_TbWKey, its_TbWNam, 3, "gain");
its_TbKey(its_TbWKey, its_TbWNam, 4, "overdub"); its_TbKey(its_TbWKey, its_TbWNam, 5, "mode");
its_TbKey(its_TbWKey, its_TbWNam, 6, "first"); its_TbKey(its_TbWKey, its_TbWNam, 7, "used");
its_TbKey(its_TbWKey, its_TbWNam, 8, "fade"); its_TbKey(its_TbWKey, its_TbWNam, 9, "plateau"); // W-Mix (its_Wrt_WFade ...)
its_TbKey(its_TbWKey, its_TbWNam, 10, "wait"); its_TbKey(its_TbWKey, its_TbWNam, 11, "direction");
its_TbKey(its_TbWKey, its_TbWNam, 12, "desync");
its_TbKey(its_TbRKey, its_TbRNam, 0, "line"); its_TbKey(its_TbRKey, its_TbRNam, 1, "writer");
its_TbKey(its_TbRKey, its_TbRNam, 2, "delay"); its_TbKey(its_TbRKey, its_TbRNam, 3, "speed");
its_TbKey(its_TbRKey, its_TbRNam, 4, "status"); its_TbKey(its_TbRKey, its_TbRNam, 5, "out");
its_TbKey(its_TbRKey, its_TbRNam, 6, "vol"); its_TbKey(its_TbRKey, its_TbRNam, 7, "first");
its_TbKey(its_TbRKey, its_TbRNam, 8, "used"); its_TbKey(its_TbRKey, its_TbRNam, 9, "loop");
its_TbKey(its_TbRKey, its_TbRNam, 10, "loopspeed"); its_TbKey(its_TbRKey, its_TbRNam, 11, "desync");
its_TbKey(its_TbRKey, its_TbRNam, 12, "outchan"); // count of output channels (0 : the count of channels used)
its_TbKey(its_TbRKey, its_TbRNam, 13, "cross"); // the free loop at the end of the line : Off it jumps, On it crosses
// the writer : "direction" Forward|Backward|Both (modes X-fade, Sum : its_Wrt_Dir), the same word as the direction of W-Mix
// (a number : the key 11), see its_Tb_Key
its_TbKey(its_TbWKey, its_TbWNam, 13, "direction");
// the reader : its mode (Read, Delay, Stretch, Brage, Grains), the settings of the modes Stretch and Brage (block ...
// transp : the fields its_Rdr_StBlkMs ... in this order ; stretch : mode Stretch), of the mode Grains (size ... onsetrnd :
// the fields its_Rdr_GrSize ... in this order), the writer that its loop follows
its_TbKey(its_TbRKey, its_TbRNam, 14, "mode");
its_TbKey(its_TbRKey, its_TbRNam, 15, "block"); its_TbKey(its_TbRKey, its_TbRNam, 16, "overlap");
its_TbKey(its_TbRKey, its_TbRNam, 17, "search"); its_TbKey(its_TbRKey, its_TbRNam, 18, "transp");
its_TbKey(its_TbRKey, its_TbRNam, 19, "stretch");
its_TbKey(its_TbRKey, its_TbRNam, 20, "size"); its_TbKey(its_TbRKey, its_TbRNam, 21, "sizernd");
its_TbKey(its_TbRKey, its_TbRNam, 22, "plateau"); its_TbKey(its_TbRKey, its_TbRNam, 23, "platrnd");
its_TbKey(its_TbRKey, its_TbRNam, 24, "fadein"); its_TbKey(its_TbRKey, its_TbRNam, 25, "fadernd");
its_TbKey(its_TbRKey, its_TbRNam, 26, "curve"); its_TbKey(its_TbRKey, its_TbRNam, 27, "gvol");
its_TbKey(its_TbRKey, its_TbRNam, 28, "volrnd"); its_TbKey(its_TbRKey, its_TbRNam, 29, "speedrnd");
its_TbKey(its_TbRKey, its_TbRNam, 30, "direction"); its_TbKey(its_TbRKey, its_TbRNam, 31, "density");
its_TbKey(its_TbRKey, its_TbRNam, 32, "onsetrnd");
its_TbKey(its_TbRKey, its_TbRNam, 33, "follow");
// the limits of the loop (its_Rdr_LowPosSec, its_Rdr_HighPosSec ; the region follows, Rd_Update), the length of a loop that follows
// a writer (its_Rdr_RegSizeSec), the cross fade, mute and solo
its_TbKey(its_TbRKey, its_TbRNam, 34, "from"); its_TbKey(its_TbRKey, its_TbRNam, 35, "to");
its_TbKey(its_TbRKey, its_TbRNam, 36, "xfade"); its_TbKey(its_TbRKey, its_TbRNam, 37, "looplen");
its_TbKey(its_TbRKey, its_TbRNam, 38, "mute"); its_TbKey(its_TbRKey, its_TbRNam, 39, "solo");
i__ii = its_TbWMod; loop(its_TbWMINb, its_TbWKey[i__ii] = its_TK_mod; its_TbWNam[i__ii] = "mod"; i__ii += 1;);
i__ii = its_TbRMod; loop(its_TbRMINb, its_TbRKey[i__ii] = its_TK_mod; its_TbRNam[i__ii] = "mod"; i__ii += 1;);
// the modulation inputs of the writers and of the readers in a table : their name, their symbol (as its_ModN_Wrt, its_ModN_Rdr)
its_TbWMIN = make_array(its_TbWMINb); its_TbWMI = make_array(its_TbWMINb);
its_TbWMIN[0] = "Gain"; its_TbWMIN[1] = "Overdub"; its_TbWMIN[2] = "Fade"; its_TbWMIN[3] = "Plateau"; its_TbWMIN[4] = "Wait";
its_TbWMIN[5] = "Dir"; its_TbWMIN[6] = "Desync";
i__ii = 0; loop(its_TbWMINb, its_TbWMI[i__ii] = its_TK(its_TbWMIN[i__ii]); i__ii += 1;);
its_TbRMIN = make_array(its_TbRMINb); its_TbRMI = make_array(its_TbRMINb);
its_TbRMIN[0] = "Offset"; its_TbRMIN[1] = "Speed"; its_TbRMIN[2] = "Volume"; its_TbRMIN[3] = "LoopSpd"; its_TbRMIN[4] = "Desync";
i__ii = 0; loop(its_TbRMINb, its_TbRMI[i__ii] = its_TK(its_TbRMIN[i__ii]); i__ii += 1;);
// the modes of the reader (its_RdrMode_... ; "Reader" is also accepted for Read), the directions of the writer (its_WrtDir_...)
its_TbRMdN = make_array(its_RdrModeCnt); its_TbRMd = make_array(its_RdrModeCnt);
its_TbRMdN[its_RdrMode_Read] = "Read"; its_TbRMdN[its_RdrMode_Delay] = "Delay"; its_TbRMdN[its_RdrMode_Stretch] = "Stretch";
its_TbRMdN[its_RdrMode_Brage] = "Brage"; its_TbRMdN[its_RdrMode_Grains] = "Grains";
i__ii = 0; loop(its_RdrModeCnt, its_TbRMd[i__ii] = mSL_symbol(its_TbRMdN[i__ii]); i__ii += 1;);
its_TbWDrN = make_array(its_WrtDirCnt); its_TbWDr = make_array(its_WrtDirCnt);
its_TbWDrN[its_WrtDir_Fwd] = "Forward"; its_TbWDrN[its_WrtDir_Bwd] = "Backward"; its_TbWDrN[its_WrtDir_Both] = "Both";
i__ii = 0; loop(its_WrtDirCnt, its_TbWDr[i__ii] = mSL_symbol(its_TbWDrN[i__ii]); i__ii += 1;);
// statuses (its_WrtStat_..., its_RdrStat_... : 0 ... 4), modes of the writer, loops of the reader (its_RdrLoopType...)
its_TbWSt = make_array(5); its_TbRSt = make_array(5);
its_TbWSt[0] = its_TbRSt[0] = its_TK_Undefined; its_TbWSt[1] = its_TbRSt[1] = its_TK("Created");
its_TbWSt[2] = its_TbRSt[2] = its_TK_Ready; its_TbWSt[3] = its_TbRSt[3] = its_TK("Paused");
its_TbWSt[4] = its_TK("Writing"); its_TbRSt[4] = its_TK("Reading");
its_TbWMd = make_array(its_WrtModeCnt); its_TbWMd[its_WrtMode_XFade] = mSL_symbol("XFade"); its_TbWMd[its_WrtMode_Sum] = mSL_symbol("Sum");
its_TbWMd[its_WrtMode_WMix] = mSL_symbol("WMix");
its_TbRLp = make_array(6);
i__ii = 0; loop(6, its_TbRLp[i__ii] = mSL_symbol(menu_Rdr_Loop_N[i__ii]); i__ii += 1;);

// the keys of the effects (one table for all the types : its_Tb_FxOk tells which keys a type takes) ; "source" and "gain"
// are src1 and gain1 ; the keys its_TbFMod ... : "mod" for each modulation input (its_TbFMI)
its_TbFMod = 100;
its_TbFMINb = 21;
its_TbFNk = its_TbFMod + its_TbFMINb;
its_TbFKey = make_array(its_TbFNk); its_TbFNam = make_array(its_TbFNk);
its_TbKey(its_TbFKey, its_TbFNam, 0, "type"); its_TbKey(its_TbFKey, its_TbFNam, 1, "status");
its_TbKey(its_TbFKey, its_TbFNam, 2, "phase"); its_TbKey(its_TbFKey, its_TbFNam, 3, "chan");
its_TbKey(its_TbFKey, its_TbFNam, 4, "out"); its_TbKey(its_TbFKey, its_TbFNam, 5, "limiter");
its_TbKey(its_TbFKey, its_TbFNam, 6, "src1"); its_TbKey(its_TbFKey, its_TbFNam, 7, "src2");
its_TbKey(its_TbFKey, its_TbFNam, 8, "src3"); its_TbKey(its_TbFKey, its_TbFNam, 9, "src4");
its_TbKey(its_TbFKey, its_TbFNam, 10, "src5"); its_TbKey(its_TbFKey, its_TbFNam, 11, "src6");
its_TbKey(its_TbFKey, its_TbFNam, 12, "src7"); its_TbKey(its_TbFKey, its_TbFNam, 13, "src8");
its_TbKey(its_TbFKey, its_TbFNam, 14, "gain1"); its_TbKey(its_TbFKey, its_TbFNam, 15, "gain2");
its_TbKey(its_TbFKey, its_TbFNam, 16, "gain3"); its_TbKey(its_TbFKey, its_TbFNam, 17, "gain4");
its_TbKey(its_TbFKey, its_TbFNam, 18, "gain5"); its_TbKey(its_TbFKey, its_TbFNam, 19, "gain6");
its_TbKey(its_TbFKey, its_TbFNam, 20, "gain7"); its_TbKey(its_TbFKey, its_TbFNam, 21, "gain8");
its_TbKey(its_TbFKey, its_TbFNam, 22, "freq"); its_TbKey(its_TbFKey, its_TbFNam, 23, "q");
its_TbKey(its_TbFKey, its_TbFNam, 24, "mode"); its_TbKey(its_TbFKey, its_TbFNam, 25, "stages");
its_TbKey(its_TbFKey, its_TbFNam, 26, "amp"); its_TbKey(its_TbFKey, its_TbFNam, 27, "offset");
its_TbKey(its_TbFKey, its_TbFNam, 28, "spread");
its_TbKey(its_TbFKey, its_TbFNam, 29, "drive"); its_TbKey(its_TbFKey, its_TbFNam, 30, "bias");
its_TbKey(its_TbFKey, its_TbFNam, 31, "mix"); its_TbKey(its_TbFKey, its_TbFNam, 32, "os");
its_TbKey(its_TbFKey, its_TbFNam, 33, "output"); its_TbKey(its_TbFKey, its_TbFNam, 34, "order");
its_TbKey(its_TbFKey, its_TbFNam, 35, "stretch"); its_TbKey(its_TbFKey, its_TbFNam, 36, "amount");
its_TbKey(its_TbFKey, its_TbFNam, 37, "harm"); its_TbKey(its_TbFKey, its_TbFNam, 38, "curve");
its_TbKey(its_TbFKey, its_TbFNam, 39, "adaa"); // Saturation : ADAA On|Off (Par11)
// Matrix : decay (Par1), damp (Par3), dmin dmax (Par5, Par6), diffusion (Par7), loop (Par8), seed (Par9), delays (Par10 : their spread),
// hp (Par11), inject (Par12) ; its matrix : "mode"
its_TbKey(its_TbFKey, its_TbFNam, 40, "decay"); its_TbKey(its_TbFKey, its_TbFNam, 41, "damp");
its_TbKey(its_TbFKey, its_TbFNam, 42, "dmin"); its_TbKey(its_TbFKey, its_TbFNam, 43, "dmax");
its_TbKey(its_TbFKey, its_TbFNam, 44, "diffusion"); its_TbKey(its_TbFKey, its_TbFNam, 45, "loop");
its_TbKey(its_TbFKey, its_TbFNam, 46, "seed"); its_TbKey(its_TbFKey, its_TbFNam, 47, "delays"); // ("spread" : the LFO)
its_TbKey(its_TbFKey, its_TbFNam, 48, "hp"); its_TbKey(its_TbFKey, its_TbFNam, 49, "inject");
// Matrix : wow, rate, spread (the phases : a word of the LFO too, see its_TbFAlt), glide (its_Efx_MxX ...)
its_TbKey(its_TbFKey, its_TbFNam, 50, "wow"); its_TbKey(its_TbFKey, its_TbFNam, 51, "rate");
its_TbKey(its_TbFKey, its_TbFNam, 52, "spread"); its_TbKey(its_TbFKey, its_TbFNam, 53, "glide");
// Flanger, Chorus : delay (Par1), sweep (MxX), feedback (Par7), wave (Par8 : the shape of the sweep ; "shape" is a word of
// "mod"), voices (Par10), cross (Par12), jitter (MxX + 4), mix (Par4, in [-100, 100] : a word of the Saturation and of the Matrix too, see its_TbFAlt) ; and the keys of the LFO and of
// the Matrix : mode (Par2), spread (Par5), curve (Par6), damp (Par3), seed (Par9), hp (Par11), rate (MxX + 1), glide (MxX + 3)
its_TbKey(its_TbFKey, its_TbFNam, 54, "delay"); its_TbKey(its_TbFKey, its_TbFNam, 55, "sweep");
its_TbKey(its_TbFKey, its_TbFNam, 56, "feedback"); its_TbKey(its_TbFKey, its_TbFNam, 57, "wave");
its_TbKey(its_TbFKey, its_TbFNam, 58, "voices"); its_TbKey(its_TbFKey, its_TbFNam, 59, "cross");
its_TbKey(its_TbFKey, its_TbFNam, 60, "jitter"); its_TbKey(its_TbFKey, its_TbFNam, 61, "mix");
// Phaser : sweep (Par3, octaves : a word of the Flanger too), stages (Par10, 1 ... its_PhMaxS : a word of the Filter too), q (Par11 :
// the Filter too), spacing (MxX) ; and the keys of the others : freq (Par1), mode (Par2), mix (Par4), spread (Par5), curve
// (Par6), feedback (Par7), wave (Par8), seed (Par9), cross (Par12), rate (MxX + 1), glide (MxX + 3), jitter (MxX + 4)
its_TbKey(its_TbFKey, its_TbFNam, 62, "sweep"); its_TbKey(its_TbFKey, its_TbFNam, 63, "stages");
its_TbKey(its_TbFKey, its_TbFNam, 64, "q"); its_TbKey(its_TbFKey, its_TbFNam, 65, "spacing");
// Shimmer : shimmer (MxX + 4, %), shift and shift2 (MxX + 5, 6 : semitones), grain (MxX + 7, ms) ; Matrix, Shimmer : lines (MxX + 8)
its_TbKey(its_TbFKey, its_TbFNam, 66, "shimmer"); its_TbKey(its_TbFKey, its_TbFNam, 67, "shift");
its_TbKey(its_TbFKey, its_TbFNam, 68, "shift2"); its_TbKey(its_TbFKey, its_TbFNam, 69, "grain");
its_TbKey(its_TbFKey, its_TbFNam, 70, "lines");
// Noise : color (Par2), density (Par5), corr (Par4), chaos (Par7) ; and the keys of the others : output (Par6, dB : the
// Saturation), damp (Par3), hp (Par11)
its_TbKey(its_TbFKey, its_TbFNam, 71, "color"); its_TbKey(its_TbFKey, its_TbFNam, 72, "density");
its_TbKey(its_TbFKey, its_TbFNam, 73, "corr"); its_TbKey(its_TbFKey, its_TbFNam, 74, "chaos");
// Noise : tilt (Par8, Mix), power (Par9 : the exponent of the shape ; "shape" is a word of "mod"), rumble (Par1, %), rfreq
// (Par10)
its_TbKey(its_TbFKey, its_TbFNam, 75, "tilt"); its_TbKey(its_TbFKey, its_TbFNam, 76, "power");
its_TbKey(its_TbFKey, its_TbFNam, 77, "rumble"); its_TbKey(its_TbFKey, its_TbFNam, 78, "rfreq");
// Random : dist (Par7 : the law of the draws ; "law" is a word of "mod"), clock (Par8), steps (Par9), walk (Par10) ; and the
// keys of the others : mode (Par2), amp (Par3), offset (Par4), corr (Par5), curve (Par6), rate (MxX + 1), glide (MxX + 3),
// jitter (MxX + 4)
its_TbKey(its_TbFKey, its_TbFNam, 79, "dist"); its_TbKey(its_TbFKey, its_TbFNam, 80, "clock");
its_TbKey(its_TbFKey, its_TbFNam, 81, "steps"); its_TbKey(its_TbFKey, its_TbFNam, 82, "walk");
// Random : thresh (Par11 : the threshold of the trigger, its source : "source", "gain"), detect (Par12 : Wave|Env), release
// (MxX + 5 : of the envelope, ms)
its_TbKey(its_TbFKey, its_TbFNam, 83, "thresh");
its_TbKey(its_TbFKey, its_TbFNam, 84, "detect"); its_TbKey(its_TbFKey, its_TbFNam, 85, "release");
// Math : value (Par5 : B without source B), bchan (Par6 : Auto|One), attack (Par7, ms) ; and the keys of the others : mode
// (Par2 : the operation), amp (Par3 : the scale), offset (Par4), release (Par8, ms), src1 (source : A), src2 (B)
its_TbKey(its_TbFKey, its_TbFNam, 86, "value"); its_TbKey(its_TbFKey, its_TbFNam, 87, "bchan");
its_TbKey(its_TbFKey, its_TbFNam, 88, "attack");
// Ring : detune (Par7, Hz) ; and the keys of the others : freq (Par1), mode (Par2), mix (Par4, %), spread (Par5, turns),
// curve (Par6), wave (Par8 : the shape), amount (Par9 : AM), bchan (Par10), src1 (source : A), src2 (B : the carrier)
its_TbKey(its_TbFKey, its_TbFNam, 89, "detune");
// Limiter : limit (Par1, dB), shown (Par2 : the channels displayed), zoom (Par3), distortion (Par4, %), pregain (Par5, dB) ;
// and the keys of the others : output (Par6, dB : the volume out), attack (Par7, ms : the anticipation), release (Par8, ms)
its_TbKey(its_TbFKey, its_TbFNam, 90, "limit"); its_TbKey(its_TbFKey, its_TbFNam, 91, "shown");
its_TbKey(its_TbFKey, its_TbFNam, 92, "zoom"); its_TbKey(its_TbFKey, its_TbFNam, 93, "distortion");
its_TbKey(its_TbFKey, its_TbFNam, 94, "pregain");
// VU meter : time (Par1, ms : the sample time), highlight (Par3), thresh (Par4 : the saturation threshold, dB ; a word of the
// Random too), color (Par5 : a word of the Noise too), autoclear (Par6 : minutes, 0 permanent) ; and "mode" (Par2 : the GUI)
its_TbKey(its_TbFKey, its_TbFNam, 95, "time"); its_TbKey(its_TbFKey, its_TbFNam, 96, "highlight");
its_TbKey(its_TbFKey, its_TbFNam, 97, "thresh"); its_TbKey(its_TbFKey, its_TbFNam, 98, "color");
its_TbKey(its_TbFKey, its_TbFNam, 99, "autoclear");
// the order of the keys of a Flanger, of a Chorus in a Dump (from the key 22 ; the others : 22, not one of their keys)
its_TbFlOrdN = 16; its_TbFlOrd = make_array(its_TbFlOrdN);
its_TbFlOrd[0] = 24; its_TbFlOrd[1] = 54; its_TbFlOrd[2] = 55; its_TbFlOrd[3] = 51; its_TbFlOrd[4] = 57; // mode delay sweep rate wave
its_TbFlOrd[5] = 38; its_TbFlOrd[6] = 56; its_TbFlOrd[7] = 61; its_TbFlOrd[8] = 28; // curve feedback mix spread
its_TbFlOrd[9] = 58; its_TbFlOrd[10] = 60; its_TbFlOrd[11] = 46; its_TbFlOrd[12] = 59; // voices jitter seed cross
its_TbFlOrd[13] = 41; its_TbFlOrd[14] = 48; its_TbFlOrd[15] = 53; // damp hp glide
its_TbPhOrd = make_array(its_TbFlOrdN); // (the Phaser)
its_TbPhOrd[0] = 24; its_TbPhOrd[1] = 22; its_TbPhOrd[2] = 62; its_TbPhOrd[3] = 51; its_TbPhOrd[4] = 57; // mode freq sweep rate wave
its_TbPhOrd[5] = 38; its_TbPhOrd[6] = 56; its_TbPhOrd[7] = 61; its_TbPhOrd[8] = 63; // curve feedback mix stages
its_TbPhOrd[9] = 65; its_TbPhOrd[10] = 64; its_TbPhOrd[11] = 28; its_TbPhOrd[12] = 60; // spacing q spread jitter
its_TbPhOrd[13] = 46; its_TbPhOrd[14] = 59; its_TbPhOrd[15] = 53; // seed cross glide
its_TbNzOrdN = 11; its_TbNzOrd = make_array(its_TbNzOrdN); // (the Noise)
its_TbNzOrd[0] = 71; its_TbNzOrd[1] = 33; its_TbNzOrd[2] = 75; its_TbNzOrd[3] = 72; its_TbNzOrd[4] = 74; // color output tilt density chaos
its_TbNzOrd[5] = 76; its_TbNzOrd[6] = 73; its_TbNzOrd[7] = 41; its_TbNzOrd[8] = 48; // power corr damp hp
its_TbNzOrd[9] = 77; its_TbNzOrd[10] = 78; // rumble rfreq
its_TbRnOrdN = 15; its_TbRnOrd = make_array(its_TbRnOrdN); // (the Random ; thresh, detect, release after its source and its gain)
its_TbRnOrd[0] = 83; its_TbRnOrd[1] = 84; its_TbRnOrd[2] = 85; // thresh detect release
its_TbRnOrd[3] = 24; its_TbRnOrd[4] = 79; its_TbRnOrd[5] = 51; its_TbRnOrd[6] = 60; its_TbRnOrd[7] = 80; // mode dist rate jitter clock
its_TbRnOrd[8] = 53; its_TbRnOrd[9] = 81; its_TbRnOrd[10] = 82; its_TbRnOrd[11] = 73; // glide steps walk corr
its_TbRnOrd[12] = 26; its_TbRnOrd[13] = 27; its_TbRnOrd[14] = 38; // amp offset curve
its_TbMtOrdN = 7; its_TbMtOrd = make_array(its_TbMtOrdN); // (the Math)
its_TbMtOrd[0] = 24; its_TbMtOrd[1] = 86; its_TbMtOrd[2] = 87; its_TbMtOrd[3] = 88; // mode value bchan attack
its_TbMtOrd[4] = 85; its_TbMtOrd[5] = 26; its_TbMtOrd[6] = 27; // release amp offset
its_TbRgOrdN = 9; its_TbRgOrd = make_array(its_TbRgOrdN); // (the Ring)
its_TbRgOrd[0] = 24; its_TbRgOrd[1] = 22; its_TbRgOrd[2] = 57; its_TbRgOrd[3] = 38; its_TbRgOrd[4] = 89; // mode freq wave curve detune
its_TbRgOrd[5] = 28; its_TbRgOrd[6] = 36; its_TbRgOrd[7] = 87; its_TbRgOrd[8] = 31; // spread amount bchan mix
its_TbLmOrdN = 8; its_TbLmOrd = make_array(its_TbLmOrdN); // (the Limiter : the order of the sliders of the plugin)
its_TbLmOrd[0] = 90; its_TbLmOrd[1] = 94; its_TbLmOrd[2] = 33; its_TbLmOrd[3] = 88; // limit pregain output attack
its_TbLmOrd[4] = 85; its_TbLmOrd[5] = 93; its_TbLmOrd[6] = 92; its_TbLmOrd[7] = 91; // release distortion zoom shown
its_TbVuOrdN = 6; its_TbVuOrd = make_array(its_TbVuOrdN); // (the VU meter)
its_TbVuOrd[0] = 24; its_TbVuOrd[1] = 95; its_TbVuOrd[2] = 97; its_TbVuOrd[3] = 99; // mode time thresh autoclear
its_TbVuOrd[4] = 98; its_TbVuOrd[5] = 96; // color highlight
i__ii = its_TbFMod; loop(its_TbFMINb, its_TbFKey[i__ii] = its_TK_mod; its_TbFNam[i__ii] = "mod"; i__ii += 1;);
// a word may name several keys, for different types (each one with its own slot, range or kind of value : the key of the
// type is chosen when the block is read, see its_Tb_FxKey) : its_TbFAlt[k] the next key of the same word (0 : none)
its_TbFAlt = make_array(its_TbFNk);
i__ii = 0; loop(its_TbFMod,
    i__jj = i__ii + 1; its_TbFAlt[i__ii] = 0;
    while ((its_TbFAlt[i__ii] === 0) && (i__jj < its_TbFMod)) ( (its_TbFKey[i__jj] === its_TbFKey[i__ii]) ? (its_TbFAlt[i__ii] = i__jj); i__jj += 1; );
    i__ii += 1;
);
its_Tb_fxk = -1; its_Tb_fxty = -1; // the effect of the block being read, its type (its_Tb_FxTyAhead)
// the modulation inputs : symbol, name, the types of effect (a mask : 1 << type), input number, default depth
its_TbFMI = make_array(its_TbFMINb); its_TbFMIN = make_array(its_TbFMINb); its_TbFMIt = make_array(its_TbFMINb);
its_TbFMIj = make_array(its_TbFMINb); its_TbFMId = make_array(its_TbFMINb); its_TbFMIk = make_array(its_TbFMINb); // (its law)
its_TbFMIN[0] = "Cutoff"; its_TbFMIN[1] = "Reso"; // (as its_ModN_Flt)
its_TbFMIN[2] = "Drive"; its_TbFMIN[3] = "Bias"; its_TbFMIN[4] = "Order"; // (as its_ModN_Sat : "Order" is also the stretch)
