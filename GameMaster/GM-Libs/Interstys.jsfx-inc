    ) : (
        (ki === 0) ? (its_Rd_Lined(b[its_Rdr_Mode]) ? b[its_Rdr_LineNb] : -1) :
        (ki === 1) ? ((b[its_Rdr_Mode] === its_RdrMode_Delay) ? b[its_Rdr_WrSrc] : -1) :
        (ki === 2) ? b[its_Rdr_WOffset] :
        (ki === 3) ? b[its_Rdr_Speed] :
        (ki === 4) ? ((b[its_Rdr_Status] > its_RdrStat_Reading) ? its_RdrStat_Reading : b[its_Rdr_Status]) : // (stopping, starting)
        (ki === 5) ? ( its_Tb_g2 = b[its_Rdr_OutOff]; b[its_Rdr_OutK]; ) :
        (ki === 6) ? b[its_Rdr_OutVoldB] :
        (ki === 7) ? b[its_Rdr_Bf1stChan] :
        (ki === 8) ? b[its_Rdr_BfChanUsed] :
        (ki === 9) ? b[its_Rdr_LoopType] :
        (ki === 10) ? b[its_Rdr_LoopSpd] :
        (ki === 11) ? b[its_Rdr_Desync] :
        (ki === 12) ? b[its_Rdr_OutCnt] :
        (ki === 13) ? (b[its_Rdr_LoopCross] !== 0) :
        (ki === 14) ? b[its_Rdr_Mode] :
        (ki < 19) ? b[its_Rdr_StBlkMs + ki - 15] : // block, overlap, search, transp
        (ki === 19) ? b[its_Rdr_Stretch] :
