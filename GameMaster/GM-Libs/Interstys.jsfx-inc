/* Add a file name to the compiler list */
function doMslCompile(fname)
(
    // Do not accept empty strings
    (strlen(fname) != 0) ? (
        (uuuMslTabs[uuuMslTPt] !== 0) ? (
            // the list is full : refuse the file, rather than replacing a file still waiting
            sprintf(#gfxu, "ERR: 2407    too many files to compile, \"%s\" ignored.", fname);
            mSL_log(SysLogBox, #gfxu);
        ) : (
            0 ? (sprintf(#s, "::About to doMslCompile: \"%s\"", fname); mSL_log(SysLogBox, #s););
            atomic_set(mSL_Lock, max(1,atomic_get(mSL_Lock)));
            uuuMslTabs[uuuMslTPt] = fname; uuuMslTPt = (uuuMslTPt + 1) % uuuMslTSiz;
            atomic_add(mSL_loc_tim,mSL_loc_tadd);
            uuuMslFn = 1; // set flag
        );
    )
);

/* After a compilation attempt (successful or not) : free the compiler's structures,
   keep the lock if other files are waiting (several files dropped : they are compiled next),
   otherwise empty the list and release the lock taken by doMslCompile */
function doMslCompileDone()
local (i)
(
    mSL_bl_clear(mSL_GC_Protected); // free compiler's structures
    i = 0; while ((i < uuuMslTSiz) && (uuuMslTabs[i] === 0)) (i += 1;);
    (i >= uuuMslTSiz) ? (
        uuuMslTPt = uuuMslFn = 0; // the list is empty
        atomic_set(mSL_Lock,  max(0, atomic_get(mSL_Lock) - 1));
    );
);



