            ((writer[its_Wrt_Start] != lcbl[its_Lin_Start])
                || (writer[its_Wrt_Last] != lcbl[its_Lin_Last])) ? (
                writer[its_Wrt_Start] = lcbl[its_Lin_Start];
                writer[its_Wrt_Last] = lcbl[its_Lin_Last];
                writer[its_Wrt_SmplCnt] = lcbl[its_Lin_SmplCnt];
            );
            ((writer[its_Wrt_Abspos] < writer[its_Rdr_Start])
                || (writer[its_Wrt_Abspos] > writer[its_Rdr_Last])) ? (
                writer[its_Wrt_Abspos] = reader[its_Rdr_Start];
            );
            writer[its_Wrt_Check] = BLOCK_CHECK;
            its_WrtErrXe = 0;
        );
    );
    (its_WrtErrXe === 0) ? (
        k = writer[its_Wrt_Abspos];
        x = writer[its_Wrt_Ovrdb];
        vol = writer[its_Wrt_InGain];
