        (g === 1) ? (ttl = ">Readers"; fid = blockReaderA;) :
        (g === 2) ? (ttl = ">Writers"; fid = blockWriterA;) : (ttl = ">Effects"; fid = blockEffectA;);
        blockDispNames[it] = ttl; blockDispIdts[it] = 0; it += 1;
