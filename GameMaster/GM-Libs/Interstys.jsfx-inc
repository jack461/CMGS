        (ki === 34) ? b[its_Rdr_LowPosSec] :
        (ki === 35) ? b[its_Rdr_HighPosSec] :
        (ki === 36) ? b[its_Rdr_XFade_mSec] :
        (ki === 37) ? b[its_Rdr_RegSizeSec] :
        (ki === 38) ? ((b[its_Rdr_StFlgs] & its_RdrFlg_mute) !== 0) :
        (ki === 39) ? ((b[its_Rdr_StFlgs] & its_RdrFlg_solo) !== 0) :
