        i += 1;
    );
    sg;
);

// @gfx : the order, computed again when its signature changes (the previous one taken by @block)
function its_Fx_Order()
local (sg, m, a, b, fa, fb, k, best, i, chg)
(
    ((its_FxOrdRdy === 0) && ((sg = its_Fx_OrdSig()) !== its_FxSig)) ? (
        its_FxSig = sg;
        m = 0; i = 0; loop(FX_CNT,
            b = Effects_set[i];
            ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? ( its_FxLst[m] = i; its_FxWK[m] = its_Fx_WKey(b, i); m += 1; );
            i += 1;
