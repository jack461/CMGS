(perform_loading === 0) ? its_Ln_AutoReload(); // the files of the lines, after a load



mSL_loc_tim = max(mSL_loc_tim - 1, 0);

(atomic_get(mSL_Lock) && (mSL_loc_tim <= 0))? (
