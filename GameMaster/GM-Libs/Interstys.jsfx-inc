// Random : a draw of the law "lw" (ct : the table of the curve of the law Curve)
function its_Rn_Draw(lw, ct)
(
    // Gauss : the sum of 4 uniforms in [0, 1] (sigma sqrt(4 / 12)), brought to sigma 1/3 : (sum - 2) x 0.5774
    (lw === its_RnGauss) ? max(-1, min(1, (rand(1) + rand(1) + rand(1) + rand(1) - 2) * 0.5774)) :
    (lw === its_RnBin) ? ((rand(1) < 0.5) ? -1 : 1) :
