function exec_ring(fx, ccnt, out)
local (wk, hd, cw, md, sh, ct, hb, sa, sb, bs, ga, gb, mp, fr, am, mx, spr, dtn, c, p, a, car, inc, pe, ai, aq, ci, cq, y)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
        hd = wk + its_FxW_Hdr; cw = hd + its_RgH;
        (wk[its_FxW_Md] !== 1) ? ( memset(cw, 0, its_RgCW * ccnt); wk[its_FxW_Md] = 1; );
        md = max(0, min(its_RgModeCnt - 1, floor(fx[its_Efx_Par1 + 1])));
        sh = max(0, min(its_FlShCnt - 1, floor(fx[its_Efx_Par1 + 7])));
        ct = its_CrvTab + max(0, min(its_CrvMx - 1, 0|fx[its_Efx_Par1 + 5])) * its_CrvTbSz + its_CrvTbG;
        mp = fx + its_Efx_Mod1;
        fr = max(-0.5 * srate, min(0.5 * srate, its_Mod_Apply(mp, fx[its_Efx_Par1], its_ModA_Oct, 1)));
        am = max(0, min(2, its_Mod_Apply(mp + its_ModDist, fx[its_Efx_Par1 + 8], its_ModA_Add, 1)));
        mx = max(0, min(1, its_Mod_Apply(mp + 2 * its_ModDist, fx[its_Efx_Par1 + 3], its_ModA_Add, 1)));
        spr = fx[its_Efx_Par1 + 4]; dtn = fx[its_Efx_Par1 + 6];
        sa = smpl_tab + fx[its_Efx_Cell1]; ga = fx[its_Efx_Vol1];
        sb = fx[its_Efx_Cell1 + its_EfxDist]; hb = (sb > 0); sb = hb ? smpl_tab + sb : 0; gb = fx[its_Efx_Vol1 + its_EfxDist];
        bs = fx[its_Efx_St1];
        c = 0; p = cw;
        loop(ccnt,
            a = ga * sa[c];
            hb ? (
                car = gb * sb[bs ? c : 0];
            ) : (
                inc = max(-0.5, min(0.5, (fr + c * dtn) / srate));
