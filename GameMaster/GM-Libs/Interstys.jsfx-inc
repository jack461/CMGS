// Noise : one sample of the generator of the color "cl" whose states are at "p" (tf : the period of the density in samples,
// pd : the density per sample, pc : the parameter of Crackle, rl : the one of Logistic)
function its_Nz_Gen(p, cl, tf, pd, pc, rl) local(y)
(
    (cl === its_NzVelvet) ? (
        // a period of tf samples, one impulse on one of its samples, p[1] (p[2] : it was given)
        ((p[0] += 1) >= tf) ? (
            p[0] -= tf; p[0] = max(0, min(p[0], tf - 1));
            p[1] = p[0] + floor(rand(max(1, ceil(tf - p[0])))); p[2] = 0;
        );
        ((p[2] === 0) && (p[0] >= p[1])) ? ( p[2] = 1; (rand(1) < 0.5) ? -1 : 1; ) : 0;
    ) :
    (cl === its_NzDust) ? (
        (rand(1) < pd) ? rand(2) - 1 : 0;
    ) :
    (cl === its_NzCrackle) ? (
        y = abs(p[3] * pc - p[4] - 0.05); p[4] = p[3];
        (y < 10) ? ( p[3] = y; ) : ( p[3] = rand(0.5); p[4] = rand(0.5); y = 0; ); // (it went away : again from random states)
