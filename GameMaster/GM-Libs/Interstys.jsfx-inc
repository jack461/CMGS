    i = 0; loop(blockUsrLast + 1, blockModNames[i] = blockDispNames[i]; i += 1;);
    it = blockFirst;
    g = 0; loop(5,
        (g === 0) ? (ttl = ">Lines"; fid = blockLineA; sid = blockLines;) :
        (g === 1) ? (ttl = ">Readers"; fid = blockReaderA; sid = blockReaders;) :
        (g === 2) ? (ttl = ">Writers"; fid = blockWriterA; sid = blockWriters;) :
        (g === 3) ? (ttl = ">Effects"; fid = blockEffectA; sid = blockEffects;) : (ttl = ">Curves"; fid = blockCurvesA; sid = blockCurves;);
        blockDispNames[it] = ttl; blockDispIdts[it] = 0; it += 1;
