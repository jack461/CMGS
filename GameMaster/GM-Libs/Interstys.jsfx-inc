);
//==========================================================
//===== EFFECTS Handling
// Effects_set[FX_CNT]
// Réinitialiser un effet
// (the effect keeps its work areas : its_Patch_Update frees them)
function FX_Clear(enum)
local (fxcb, w0, w1, w2)
(
    ((enum >= 0) && (enum <= FX_CNT) && ((fxcb = Effects_set[enum]) > BASE_MEMORY) && (fxcb[-2] === KW_effx)) ? (
        w0 = fxcb[its_Efx_Work]; w1 = fxcb[its_Efx_WkNew]; w2 = fxcb[its_Efx_WkOld];
        memset(fxcb, 0, its_Efx_BlkSize);
        fxcb[its_Efx_Work] = w0; fxcb[its_Efx_WkNew] = w1; fxcb[its_Efx_WkOld] = w2;
        fxcb[its_Efx_Status] = its_Efx_Unspecified;
        fxcb[its_Efx_Phase] = its_Efx_PhaseStd;
        fxcb[its_Efx_Numb] = enum;
        fxcb[its_Run_Kind] = its_RunK_Effect;
        fxcb[its_Efx_CCnt] = 1;
        its_Mod_Init(fxcb + its_Efx_Mod1, 3); // modulation attenuverters
        fxcb[its_Efx_Unuz1] = fxcb[its_Efx_Unuz2] = SECURE_BL;
    );
);
// Obtenir l'espace pour représenter un effet
function FX_make(enum)
local (fxcb)
(
    fxcb = mSL_Dyn_Alloc(its_Efx_BlkSize, KW_effx, mSL_StM_FlClear); // allocate memory
    Effects_set[enum] = fxcb;
    FX_Clear(enum);
    fxcb;
);

// Delete an effect from Effects_set
function FX_Delete(enum)
local (fxcb)
(
    ((enum >= 0) && (enum <= FX_CNT) && ((fxcb = Effects_set[enum]) > BASE_MEMORY) && (fxcb[-2] === KW_effx)) ? (
        Effects_set[enum] = 0; // first : the audio thread no longer sees it
        its_Run_Free(fxcb); // (with its work areas)
    );
    Effects_set[enum] = 0;
);

// Copy the effect "src" into "dst" (Copy, Paste) : "dst" keeps its own work areas
function FX_Copy(dst, src)
local (w0, w1, w2, d, n)
(
    w0 = dst[its_Efx_Work]; w1 = dst[its_Efx_WkNew]; w2 = dst[its_Efx_WkOld];
    d = dst[its_Run_Delay]; n = dst[its_Run_Num];
    memcpy(dst, src, its_Efx_BlkSize);
    dst[its_Efx_Work] = w0; dst[its_Efx_WkNew] = w1; dst[its_Efx_WkOld] = w2;
    dst[its_Run_Delay] = d; dst[its_Run_Num] = n;
    its_Run_Check(dst);
);

// Auto Mixer : the same gain -20*log10(N) (rounded to 0.01 dB) for the N sources not null
function FX_Auto_Gains(fx)
local (n, g, p)
(
    n = 0; p = fx + its_Efx_Src1;
    loop(8, (p[0] > 0) ? (n += 1); p += its_EfxDist;);
    g = (n > 0) ? floor(0.5 - 2000 * log10(n)) / 100 : 0;
    p = fx + its_Efx_Src1;
    loop(8, p[its_Efx_VoldB1 - its_Efx_Src1] = (p[0] > 0) ? g : -120; p += its_EfxDist;);
    fx[its_Efx_Check] = 0;
);

// the weights "hw" of the mode Cheb. sum : a preset "k" (menu_Efx_Harm)
function its_Harm_Preset(hw, k)
local (i, m)
(
    (k === 6) ? (
        // normalize : the largest |weight| becomes 1
        m = 0; i = 0; loop(its_SatHarm, m = max(m, abs(hw[i])); i += 1;);
        (m > 0) ? (i = 0; loop(its_SatHarm, hw[i] /= m; i += 1;));
    ) : (
        i = 0; loop(its_SatHarm,
            // i + 1 : the rank of the harmonic
            hw[i] = (k === 0) ? (i === 0) :
                    (k === 1) ? ((i & 1) === 0) / (i + 1) :
                    (k === 2) ? 1 / (i + 1) :
                    (k === 3) ? ((i & 1) === 0) / sqr(i + 1) :
                    (k === 4) ? ((i === 0) ? 1 : ((i & 1) === 1) / (i + 1)) :
                    (k === 5) ? rand(2) - 1 : 0;
            i += 1;
        );
    );
);

// the type "ty" of the effect "fx" (the pad, the tables) : the parameters of the new type get their default values
function FX_Set_Type(fx, ty)
local (k)
(
    k = fx[its_Efx_Type]; // the previous type
    fx[its_Efx_Type] = ty;
    fx[its_Efx_Check] = 0;
    (ty === its_Efx_TyAutoMix) ? FX_Auto_Gains(fx);
    ((ty === its_Efx_TyLFO) && (fx[its_Efx_Par1] === 0)) ? (
        fx[its_Efx_Par1] = 1; // 1 Hz
        fx[its_Efx_Par1 + 2] = 1; // amplitude 1
    );
    ((ty === its_Efx_TyFilter) && (fx[its_Efx_Par1] < 10)) ? (
        fx[its_Efx_Par1] = 1000; // 1 kHz
        fx[its_Efx_Par1 + 1] = 0.707; // Q
        fx[its_Efx_Par1 + 2] = its_FltLP; // biquad low pass
        fx[its_Efx_Par1 + 3] = 0; // 12 dB/oct
    );
    ((ty === its_Efx_TySat) && (k !== its_Efx_TySat)) ? (
        fx[its_Efx_Par1] = 12; // drive (dB)
        fx[its_Efx_Par1 + 1] = its_SatSoft;
        fx[its_Efx_Par1 + 2] = 0; // bias
        fx[its_Efx_Par1 + 3] = 1; // mix : 100 %
        fx[its_Efx_Par1 + 4] = 1; // oversampling 2x, with ADAA (at 1x, ADAA attenuates the highs : -12 dB at 20 kHz, 48 kHz)
        fx[its_Efx_Par1 + 10] = 1; // ADAA
        fx[its_Efx_Par1 + 5] = -6; // output (dB)
        fx[its_Efx_Par1 + 6] = 3; // order (x - sin, Chebyshev)
        fx[its_Efx_Par1 + 7] = 1; // stretch (Cheb. sum)
        fx[its_Efx_Par1 + 8] = 1; // A (x - A sin)
        fx[its_Efx_Par1 + 9] = 0; // the curve (mode Curve)
        fx[its_Efx_Lim] = 1; // the auto-limiter in service
        its_Harm_Preset(fx + its_Efx_Harm1, 0); // the fundamental only
    );
    ((ty === its_Efx_TyMatrix) && (k !== its_Efx_TyMatrix)) ? (
        fx[its_Efx_Par1] = its_Mx_Def(ty, 0); // decay (s)
        fx[its_Efx_Par1 + 1] = its_MxHouse;
        fx[its_Efx_Par1 + 2] = its_Mx_Def(ty, 1); // damping (Hz)
        fx[its_Efx_Par1 + 3] = its_Mx_Def(ty, 2); // mix : 100 %
        fx[its_Efx_Par1 + 4] = its_Mx_Def(ty, 3); // delays (ms)
        fx[its_Efx_Par1 + 5] = its_Mx_Def(ty, 4);
        fx[its_Efx_Par1 + 6] = 1; // diffusion
        fx[its_Efx_Par1 + 7] = its_MxLpDecay; // the loop
        fx[its_Efx_Par1 + 8] = 1; // seed
        fx[its_Efx_Par1 + 9] = its_MxSpGeom; // the spread of the delays
        fx[its_Efx_Par1 + 10] = its_Mx_Def(ty, 5); // high pass (Hz) : none
        fx[its_Efx_Par1 + 11] = its_MxInDirect; // the input
        fx[its_Efx_MxX] = its_Mx_Def(ty, 6); fx[its_Efx_MxX + 1] = its_Mx_Def(ty, 7); // wow, rate
        fx[its_Efx_MxX + 2] = 0.25; fx[its_Efx_MxX + 3] = 0.05; // spread, glide
        fx[its_Efx_MxX + 8] = its_Mx_Def(ty, 8); // lines : the channels
        fx[its_Efx_Lim] = 1; // the auto-limiter in service
    );
    ((ty === its_Efx_TyShimmer) && (k !== ty)) ? (
        fx[its_Efx_Par1] = its_Mx_Def(ty, 0); // decay (s)
        fx[its_Efx_Par1 + 1] = its_MxHadam;
        fx[its_Efx_Par1 + 2] = its_Mx_Def(ty, 1); // damping (Hz)
        fx[its_Efx_Par1 + 3] = its_Mx_Def(ty, 2); // mix : 50 %
        fx[its_Efx_Par1 + 4] = its_Mx_Def(ty, 3); // delays (ms)
        fx[its_Efx_Par1 + 5] = its_Mx_Def(ty, 4);
        fx[its_Efx_Par1 + 6] = 1; // diffusion
        fx[its_Efx_Par1 + 7] = its_MxLpDecay; // the loop
        fx[its_Efx_Par1 + 8] = 1; // seed
        fx[its_Efx_Par1 + 9] = its_MxSpGeom; // the spread of the delays
        fx[its_Efx_Par1 + 10] = its_Mx_Def(ty, 5); // high pass (Hz)
        fx[its_Efx_Par1 + 11] = its_MxInDirect; // the input
        fx[its_Efx_MxX] = its_Mx_Def(ty, 6); fx[its_Efx_MxX + 1] = its_Mx_Def(ty, 7); // wow, rate
        fx[its_Efx_MxX + 2] = 0.25; fx[its_Efx_MxX + 3] = 0.05; // spread, glide
        fx[its_Efx_MxX + 4] = 0.6; // shimmer : 60 %
        fx[its_Efx_MxX + 5] = fx[its_Efx_MxX + 6] = 12; // shift, shift2 : an octave up
        fx[its_Efx_MxX + 7] = 80; // grain (ms)
        fx[its_Efx_MxX + 8] = its_Mx_Def(ty, 8); // lines : 8 at least
        fx[its_Efx_Lim] = 1; // the auto-limiter in service
    );
    (its_Fl_Is(ty) && (k !== ty)) ? (
        fx[its_Efx_Par1] = its_Fl_Def(ty, 0); // the delay (ms)
        fx[its_Efx_Par1 + 1] = its_FlClassic; // the mode
        fx[its_Efx_Par1 + 2] = 0; // damping (Hz) : none
        fx[its_Efx_Par1 + 3] = 0.5; // mix : 50 %
        fx[its_Efx_Par1 + 4] = 0.25; // spread (turns per channel)
        fx[its_Efx_Par1 + 5] = 0; // the curve (shape Curve)
        fx[its_Efx_Par1 + 6] = its_Fl_Def(ty, 3); // feedback
        fx[its_Efx_Par1 + 7] = its_LfoSine; // the shape of the sweep
        fx[its_Efx_Par1 + 8] = 1; // seed
        fx[its_Efx_Par1 + 9] = its_Fl_Def(ty, 4); // voices
        fx[its_Efx_Par1 + 10] = 0; // high pass (Hz) : none
        fx[its_Efx_Par1 + 11] = 0; // cross
        fx[its_Efx_MxX] = its_Fl_Def(ty, 1); fx[its_Efx_MxX + 1] = its_Fl_Def(ty, 2); fx[its_Efx_MxX + 2] = 0; // sweep (ms), rate (Hz)
        fx[its_Efx_MxX + 3] = 0.05; fx[its_Efx_MxX + 4] = its_Fl_Def(ty, 5); // glide (s), jitter
        fx[its_Efx_Lim] = 1; // the auto-limiter in service
    );
    ((ty === its_Efx_TyPhaser) && (k !== ty)) ? (
        fx[its_Efx_Par1] = 800; // the frequency (Hz)
        fx[its_Efx_Par1 + 1] = its_PhClassic; // the mode
        fx[its_Efx_Par1 + 2] = 4; // the sweep (octaves)
        fx[its_Efx_Par1 + 3] = 0.5; // mix : 50 %
        fx[its_Efx_Par1 + 4] = 0.25; // spread (turns per channel)
        fx[its_Efx_Par1 + 5] = 0; // the curve (shape Curve)
        fx[its_Efx_Par1 + 6] = 0.5; // feedback
        fx[its_Efx_Par1 + 7] = its_LfoSine; // the shape of the sweep
        fx[its_Efx_Par1 + 8] = 1; // seed
        fx[its_Efx_Par1 + 9] = 8; // stages
        fx[its_Efx_Par1 + 10] = 2; // Q (Resonant)
        fx[its_Efx_Par1 + 11] = 0; // cross
        fx[its_Efx_MxX] = 0; fx[its_Efx_MxX + 1] = 0.3; fx[its_Efx_MxX + 2] = 0; // spacing (octaves), rate (Hz)
        fx[its_Efx_MxX + 3] = 0.05; fx[its_Efx_MxX + 4] = 0; // glide (s), jitter
        fx[its_Efx_Lim] = 1; // the auto-limiter in service
    );
    ((ty === its_Efx_TyNoise) && (k !== ty)) ? (
        fx[its_Efx_Par1 + 1] = its_NzWhite; // the color
        fx[its_Efx_Par1 + 2] = 0; // damping (Hz) : none
        fx[its_Efx_Par1 + 3] = 0; // correlation : each channel its own noise
        fx[its_Efx_Par1 + 4] = 1000; // density (per second)
        fx[its_Efx_Par1 + 5] = -12; // level (dB)
        fx[its_Efx_Par1 + 6] = 0.9; // chaos
        fx[its_Efx_Par1 + 7] = 0; // tilt (Mix) : white
        fx[its_Efx_Par1 + 8] = 1; // power (the exponent of the shape) : 1, none
        fx[its_Efx_Par1] = 0; fx[its_Efx_Par1 + 9] = 40; // rumble : none ; its frequency (Hz)
        fx[its_Efx_Par1 + 10] = 0; // high pass (Hz) : none
        fx[its_Efx_Lim] = 1; // the auto-limiter in service
    );
    ((ty === its_Efx_TyRandom) && (k !== ty)) ? (
        fx[its_Efx_Par1 + 1] = its_RnSmooth; // the mode
        fx[its_Efx_Par1 + 2] = 1; fx[its_Efx_Par1 + 3] = 0; // amplitude, offset
        fx[its_Efx_Par1 + 4] = 0; // correlation : each channel its own values
        fx[its_Efx_Par1 + 5] = 0; // the curve (law Curve)
        fx[its_Efx_Par1 + 6] = its_RnUnif; // the law of the draws
        fx[its_Efx_Par1 + 7] = 0; // the clock : common
        fx[its_Efx_Par1 + 8] = 0; // steps : none (continuous values)
        fx[its_Efx_Par1 + 9] = 0.2; // walk : the size of the steps of the mode Walk
        fx[its_Efx_Par1 + 10] = 0; // the threshold of the trigger
        fx[its_Efx_Par1 + 11] = its_RnDtWave; fx[its_Efx_MxX + 5] = 50; // its detection : the wave ; the release of the envelope (ms)
        fx[its_Efx_MxX + 1] = 1; fx[its_Efx_MxX + 3] = 0; fx[its_Efx_MxX + 4] = 0; // rate (Hz), glide (s), jitter
        fx[its_Efx_Src1] = fx[its_Efx_Off1] = 0; fx[its_Efx_VoldB1] = 0; // no trigger (the source of the previous type)
    );
    ((ty === its_Efx_TyMath) && (k !== ty)) ? (
        fx[its_Efx_Par1 + 1] = its_MtScale; // the operation : A as it is
        fx[its_Efx_Par1 + 2] = 1; fx[its_Efx_Par1 + 3] = 0; // scale, offset
        fx[its_Efx_Par1 + 4] = 1; // the value of B (without source B)
        fx[its_Efx_Par1 + 5] = 0; // B : all the channels it has
        fx[its_Efx_Par1 + 6] = 1; fx[its_Efx_Par1 + 7] = 100; // attack, release (ms)
        fx[its_Efx_Lim] = 0; // no auto-limiter (control signals ; it can be turned on)
    );
    ((ty === its_Efx_TyRing) && (k !== ty)) ? (
        fx[its_Efx_Par1] = 440; // the frequency of the oscillator (Hz)
        fx[its_Efx_Par1 + 1] = its_RgRing; // the mode
        fx[its_Efx_Par1 + 3] = 1; // mix : 100 %
        fx[its_Efx_Par1 + 4] = 0; fx[its_Efx_Par1 + 5] = 0; fx[its_Efx_Par1 + 6] = 0; // spread, curve, detune
        fx[its_Efx_Par1 + 7] = its_LfoSine; // the shape
        fx[its_Efx_Par1 + 8] = 1; // amount (AM)
        fx[its_Efx_Par1 + 9] = 0; // B : all the channels it has
        fx[its_Efx_Lim] = 1; // the auto-limiter in service
    );
    // the VU meter, the Limiter : the default values of the plugins (GM-Meters) ; no auto-limiter
    ((ty === its_Efx_TyVU) && (k !== ty)) ? (
        vu_Default(fx + its_Efx_Par1);
        fx[its_Efx_Lim] = 0;
    );
    ((ty === its_Efx_TyLimiter) && (k !== ty)) ? (
        lm_Default(fx + its_Efx_Par1);
        fx[its_Efx_Lim] = 0;
    );
);


// Menu 1 for Effects : their names, in sub-menus of 32 effects (the ">" headers are not counted in the results)
<? fx_grp = 32; fx_mnc = FX_CNT + (0|((FX_CNT + fx_grp - 1) / fx_grp)); ?>menu_Efx_Ids_N = make_array(<? printf("%d", fx_mnc); ?>);
<? i=0; j=0; loop(FX_CNT, (i % fx_grp) == 0 ? (printf("menu_Efx_Ids_N[%d] = \">Effects %d-%d\";", j, i+1, min(i+fx_grp, FX_CNT)); j += 1;); printf("menu_Efx_Ids_N[%d] = \"%sEffect %d\";", j, (((i % fx_grp) == fx_grp-1) || (i == FX_CNT-1)) ? "<" : "", i+1); i += 1; j += 1;); ?>
menu_Efx_Ids = make_jmenu(
    ui_jmenu_typ_opt | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "effect-num", <? printf("%d", fx_mnc); ?>, menu_Efx_Ids_N);
menu_Efx_Grp = <? printf("%d", fx_grp); ?>; // effects per sub-menu : the header of group g is item g * (menu_Efx_Grp + 1)

// Menu 2 for Effects : the types (entry n is the type n)
menu_Efx_Type_N = make_array(its_Efx_TyCnt);
menu_Efx_Type_N[0] = "Undefined";
menu_Efx_Type_N[1] = "None";
menu_Efx_Type_N[2] = "Mixer";
menu_Efx_Type_N[3] = "Auto Mixer";
menu_Efx_Type_N[4] = "Mover";
menu_Efx_Type_N[5] = "Action";
menu_Efx_Type_N[6] = "Script";
menu_Efx_Type_N[7] = "LFO";
menu_Efx_Type_N[8] = "Filter";
menu_Efx_Type_N[9] = "Saturation";
menu_Efx_Type_N[10] = "Matrix";
menu_Efx_Type_N[11] = "Flanger";
menu_Efx_Type_N[12] = "Chorus";
menu_Efx_Type_N[13] = "Phaser";
menu_Efx_Type_N[14] = "Shimmer";
menu_Efx_Type_N[15] = "Noise";
menu_Efx_Type_N[16] = "Random";
menu_Efx_Type_N[17] = "Math";
menu_Efx_Type_N[18] = "Ring";
menu_Efx_Type_N[19] = "VU meter";
menu_Efx_Type_N[20] = "Limiter";
menu_Efx_Type = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "effect-type", its_Efx_TyCnt, menu_Efx_Type_N);

// Menu 6 for Effects : the modes of the Filter (entry n is the mode n)
menu_Efx_FltMode_N = make_array(6);
menu_Efx_FltMode_N[0] = "LP 1 pole";
menu_Efx_FltMode_N[1] = "HP 1 pole";
menu_Efx_FltMode_N[2] = "Low pass";
menu_Efx_FltMode_N[3] = "High pass";
menu_Efx_FltMode_N[4] = "Band pass";
menu_Efx_FltMode_N[5] = "Notch";
menu_Efx_FltMode = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "filter-mode", 6, menu_Efx_FltMode_N);

// Menu 7 for Effects : the modes of the Saturation (entry n is the mode n)
