        reader[its_Rdr_StFlgs] &= -1 ~ its_RdrFlg_Mod;
    );
);


/*
    associate line bloc number "lnbr" [1 ... LN_CNT] to reader number "rdrn" [0 ... RD_CNT-1]
    "lnbr == 0" to remove the line from the reader
*/
function Rd_Set_Line(rdrn, lnbr)
local(reader, lcbl, err, w)
(
    err = 0;
    // The reader must be defined
    ((rdrn < 0) || (rdrn >= RD_CNT)) ? (
        err = 102; // erreur
    ) :
    ((lnbr < 0) || (lnbr > LN_CNT)) ? ( // in [0 ... LN_CNT]
        err = 105; // erreur
    ) :
    (((reader = Readers_set[rdrn]) <= BASE_MEMORY) || (reader[-2] !== KW_read)) ? (
        (reader === 0) ? (
            // Try to create the reader
            reader = Rd_Create(rdrn);
            (reader === 0) ? (
                err = 104; // erreur : reader undefined - should not arrive
            );
        ) : (
            err = 103;
        );
    );
    // Is the line set to zero ?
    (err === 0) ? (
        (lnbr === 0) ? (
            // Remove the line from buffer
            reader[its_Rdr_Flgs] = 0;
            reader[its_Rdr_Status] = its_RdrStat_Created; // marks inactive
            reader[its_Rdr_Relpos] = 0;
            reader[its_Rdr_LineNb] = -1;
            reader[its_Rdr_Lcbl] = 0;
        ) :
        (((lcbl = Lines_Set[lnbr-1]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ?(
            err = 107; // erreur : lcbl undefined - should not arrive
        ) : (
            // what if the same line is chosen ? choose to reinitialize
            reader[its_Rdr_Lcbl] = lcbl;
            reader[its_Rdr_LineNb] = lnbr-1; // in [0 LN_CNT-1]
            reader[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
            // Set region to the size of buffer
            reader[its_Rdr_RegSizeSec] = reader[its_Rdr_SmplCntSec] = w = lcbl[its_Lin_SmplCntSec];
            // Set in the center the region pointer
            reader[its_Rdr_RegPosSec] = w/2;
            reader[its_Rdr_ChNbr] = reader[its_Rdr_BfChanUsed] = lcbl[its_Lin_ChCnt];
            reader[its_Rdr_Start] = lcbl[its_Lin_Start];
            reader[its_Rdr_Low] = reader[its_Rdr_Start] - B_FADESIZ;
            reader[its_Rdr_Last] = lcbl[its_Lin_Last];
            reader[its_Rdr_High] = reader[its_Rdr_Last] + B_FADESIZ;
            reader[its_Rdr_Abspos] = lcbl[its_Lin_Start];
            reader[its_Rdr_LinSfreq] = lcbl[its_Lin_RecFreq];
            reader[its_Rdr_AdjInc] = lcbl[its_Lin_RecFreq] / srate;
            reader[its_Rdr_Flgs] |= its_RdrFlg_init;
            // Choose a default speed of 1
            reader[its_Rdr_Speed] = 1;
            reader[its_Rdr_AbsInc] = 1;
            reader[its_Rdr_NxtPosSec] = -1;
            reader[its_Rdr_XFade_mSec] = 10;  // Set X-fade to 10 ms.
            reader[its_Rdr_Status] = max(reader[its_Rdr_Status], its_RdrStat_Ready);
            reader[its_Rdr_SpeedPrev] = reader[its_Rdr_RegSizeSecPrv]
                = reader[its_Rdr_RegPosSecPrv] = reader[its_Rdr_XFade_mSecPrv] = -1;
            (reader[its_Rdr_RCell] === 0) ? reader[its_Rdr_RCell] = rdrn + OUT_P;
            updateRdCellIdent(reader);
            Rd_Update(rdrn); // Update other fields
        );
        reader[its_Rdr_Check] = -1;
    );
    err;
);


function Rd_Set_Status(rdrn, nstat)
local (reader, md, rdst)
(
    err = 0;
    // The reader must be defined
    ((rdrn < 0) || (rdrn >= RD_CNT)) ? (
        err = 101; // erreur
    ) :
    (((reader = Readers_set[rdrn]) <= BASE_MEMORY) || (reader[-2] !== KW_read)) ? (
        (reader === 0) ? (
            // Try to create the reader
            reader = Rd_Create(rdrn);
            (reader === 0) ? (
                err = 109; // erreur : reader undefined - should not arrive
            );
        ) : (
            err = 110;
        );
    );
    (err === 0) ? (
        // The reader exists -
        rdst = reader[its_Rdr_Status];
        (nstat === -1) ? (
            (rdst === its_RdrStat_Reading) ? (nstat = its_RdrStat_Paused) :
            (rdst === its_RdrStat_Paused) ? (nstat = its_RdrStat_Reading) :
            (nstat = its_RdrStat_Created)
        );
    );
    ((nstat < 0) || (nstat > its_RdrStat_Reading)) ? (
        err = 108; // erreur
    ) :
    (err === 0) ? (
        md = reader[its_Rdr_Mode];
        lcbl = reader[its_Rdr_Lcbl];
        // Type is "reader"
        (md === its_RdrMode_Read) ? (
            ((lcbl === 0) || (reader[its_Rdr_RCell] === 0)) ? (
                // No line or no output cell
                ns = its_RdrStat_Created;
            ) :
            (nstat === its_RdrStat_Paused) ? (
                ns = its_RdrStat_Paused;
            ) :
            (nstat === its_RdrStat_Reading) ? (
                (reader[its_Rdr_Status] === its_RdrStat_Ready) ? (
                    // Restart reading from the appropriate end
                    reader[its_Rdr_Abspos] = (reader[its_Rdr_Speed] >= 0) ? reader[its_Rdr_Start] : reader[its_Rdr_Last];
                );
