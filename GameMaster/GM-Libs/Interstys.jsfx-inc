                    p[7] = 0.99765 * p[7] + u * 0.0990460;
                    p[8] = 0.96300 * p[8] + u * 0.2965164;
                    p[9] = 0.57000 * p[9] + u * 1.0526913;
                    y += wp * (p[7] + p[8] + p[9] + u * 0.1848);
                );
                ((wb !== 0) || mx) ? ( p[10] = its_NzBrK * p[10] + its_NzBrG * u; y += wb * p[10]; );
                ((wv !== 0) || mx) ? ( y += wv * (u - p[11]); p[11] = u; );
                u = y;
