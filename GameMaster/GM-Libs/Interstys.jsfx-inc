/*
    Noise : "ccnt" channels, each one its own generator, mixed with a common generator (the slot after the channels) by the
    correlation c : sqrt(c) common + sqrt(1 - c) own (the power is kept ; 0 : a diffuse field, 1 : the same noise
    everywhere) ; the generators : random values (White, Pink, Brown, Violet, Mix), the trains Velvet and Dust, the chaotic
    maps Crackle (p = 1 + chaos : a folded rotation, high pitched near 1, crackles near 2) and Logistic (r = 3 + chaos, the
    density = its iterations per second, held : the periods 2, 4, 8 ... up to 3.57, then chaos) ; each sample shaped :
    sign(x) |x|^e (2 : x |x|, 3 : x^3, 4 : x |x^3|, 5 : x^5 ; 0 : +-1) ; then, per channel, the colors (Pink : the filter of
    Paul Kellet, 3 poles ; Brown : a leaky integrator ; Violet : the difference ; Mix : the two colors around the tilt,
    linear between them), each one brought to the peaks of the white noise, a DC blocker (Crackle, Logistic), the low pass
    (damp) and the high pass (hp), one pole each ; the rumble : another noise (the same correlation), two one pole low pass
    at its frequency, its amplitude swelling at random on each channel (a new target every 4 s), its rare peaks (with the
    swells) at the level, a soft knee above (its_Nz_Knee : it never exceeds the level), in a share of the output ; the
    level (dB : the peaks)
*/
function exec_noise(fx, ccnt, out)
local (wk, hd, tb, cw, mp, cl, mx, lv, dn, cr, a, b, tf, pd, pc, rl, kd, kh, fc, c, p, g0, u, y, x, e, sh, cb, cp,
       tl, ww, wp, wb, wv, rm, rk, rg, r0, sw, s)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
        hd = wk + its_FxW_Hdr; tb = hd + its_NzT; cw = hd + its_NzH;
        cl = its_Nz_Color(fx); mx = (cl === its_NzMix);
        // a new area, after a bypass, after a value not finite, another color : the states from zero (the maps, the swells :
        // at random)
