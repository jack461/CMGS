);

function exec_fx(fx, nbr)
local (fxcbl, ty, ptsrc, dst, cc, ccnt, i, zp)
(
    (err_effect = (fx[its_Efx_Check] !== BLOCK_CHECK)) ? (
        err_effect = 0;
        ((ty = fx[its_Efx_Type]) === its_Efx_TyMixer) ? (
            cc = 0; ptsrc = its_Efx_Src1 + fx;
            loop (8,
                dst = ptsrc[0];
                ((dst < 0) || (dst >= SMPL_SIZE)) ? (
                    err_effect = 320;
                ) :
                (dst > 0) ? (
                    cc += 1;
                );
                ptsrc += its_EfxDist;
            );
            (cc === 0) ? (
                err_effect = 321;
            );
            (((dst = fx[its_Efx_Out]) <= 0) || (dst >= SMPL_SIZE)) ? (
                err_effect = 310;
            );
            (((ccnt = fx[its_Efx_CCnt]) <= 0) || (ccnt > 128)) ? (
                err_effect = 312;
            );
        ) : (
            err_effect = 810;
        );
        (err_effect === 0) ? (
            fx[its_Efx_Check] !== BLOCK_CHECK;
        );
    );
    (err_effect === 0) ? (
        ((ty = fx[its_Efx_Type]) === its_Efx_TyMixer) ? (
            dst = fx[its_Efx_Out] + smpl_tab;
            ccnt = fx[its_Efx_CCnt];
            i = 0; loop(ccnt, dst[i] = 0; i += 1;);
            ptsrc = its_Efx_Src1 + fx;
            loop (8,
                (zp = ptsrc[0] > 0) ? (
                    i = 0; loop(ccnt,
                        dst[i] += smpl_tab[zp+i] * zp[2];
                        i += 1;
                    );
                );
                ptsrc += its_EfxDist;
            );
            exec_effect += 1;
        );
    );

);




//======== Serialize Procedures
/*
    savwrk is of size 2*WRKSIZ
*/
whi = wlo = 0;
function save_mem(file, area, size)
local (ps, pt, sv, sz)
(
    ps = sv = 0;
    while (size > 0) (
        sz = min(size, WRKSIZ);
        pt = 0;
        loop(sz,
            double_to_double_single(area[ps], whi, wlo);
            savwrk[pt] = whi; savwrk[pt+1] = wlo;
            ps += 1; pt += 2;
        );
        sv += file_mem(file, savwrk, pt);
        size -= sz;
    );
    sv >> 1;
);

function load_mem(file, area, size)
local (pd, pt, sl)
(
    pd = sl = 0;
    while (size > 0) (
        sz = min(size, WRKSIZ);
        sl += (rcr = file_mem(file, savwrk, sz * 2));
        (rcr === sz * 2) ? (
            pt = 0;
            loop (sz,
                area[pd] = double_single_to_double(savwrk[pt], savwrk[pt+1]);
                pd += 1; pt += 2;
            );
        );
        size -= sz;
    );
    sl >> 1;
);

function check_its_block(cbl)
(
    (cbl[0] !== SECURE_BL) || (cbl[cbl[-1]-1] !== SECURE_BL);
);

function recreate_structures()
local (ln, renew, nlcbl, olcbl, nrcbl, nwcbl, alt, i)
(
    // Update newly loaded line structures
    ln = 0; loop(LN_CNT + 1,
        renew = -1;
        nlcbl = Lines_Set[ln+AltWAdec]; // nouvelle "ln"
        (nlcbl !== 0) ? (
            olcbl = Lines_Set[ln]; // ancienne "ln"
            (olcbl !== 0) ? (
                // Peut-on réutiliser l'ancienne ligne ?
                ((olcbl[its_Lin_ChCnt] === nlcbl[its_Lin_ChCnt]) // meme nombre de canaux
                    && (olcbl[its_Lin_SmplCnt] === nlcbl[its_Lin_SmplCnt]) // meme nombre de sample
                    && (olcbl[its_Lin_Tmp1] === 0)) ? ( // non encore utilisé
                    renew = ln;
                    olcbl[its_Lin_Tmp1] = 1000 + ln;
                );
            );
            // peut-on retrouver une ancienne ligne similaire ?
            alt = 0;
            while ((renew < 0) && (alt < LN_CNT)) (
                olcbl = Lines_Set[alt];
                ((olcbl != 0) && (olcbl[its_Lin_ChCnt] === nlcbl[its_Lin_ChCnt])
                    && (olcbl[its_Lin_SmplCnt] === nlcbl[its_Lin_SmplCnt])
                    && (nlcbl[its_Lin_Tmp1] === 0)) ? (
                    renew = alt;
                    olcbl[its_Lin_Tmp1] = 2000 + ln;
                );
            );

            (renew < 0) ? (
                // recréons de nouveaux buffers
                memset(nlcbl+its_Lin_BF1ST, 0, 128); // clear previous content
                i = its_Lin_BF1ST; loop(nlcbl[its_Lin_ChCnt],
                    nlcbl[i] = mSL_Dyn_Alloc(nlcbl[its_Lin_ActBSize], KW_buff, mSL_StM_FlClear);
sprintf(#A007,"buff-n  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i-1-its_Lin_BF1ST, nlcbl[i-1]);
sprintf(#A008,"buff-n  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i-its_Lin_BF1ST, nlcbl[i]);
                    i += 1;
                );
            ) : (
                // On réutilise les buffers de l'ancienne ligne
                olcbl = Lines_Set[renew];
                i = its_Lin_BF1ST; loop (128,
                    nlcbl[i] = olcbl[i];
sprintf(#A007,"buff-r  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i-1, nlcbl[i-1]);
sprintf(#A008,"buff-r  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i, nlcbl[i]);
                    olcbl[i] = 0; i += 1;
                );
            );
            nlcbl[its_Lin_Check] = 0; // for future fast check
sprintf(#A006,"nlcbl %d {%d  ch=%d  sz=%d}", ln, nlcbl, nlcbl[its_Lin_ChCnt], nlcbl[its_Lin_SmplCnt]);
            dbg_show_2(mem,66)
        );
        ln += 1;
    );
    // On peut libérer les anciennes lignes
    ln = 0; loop(LN_CNT + 1,
        Ln_Delete(ln);
        ln += 1;
    );

    // Update readers
    ln = 0; loop(RD_CNT + 1,
        nrcbl = Readers_set[ln+AltWAdec];
        (nrcbl !== 0) ? (
            // update lines addresses
            (nrcbl[its_Rdr_Lcbl] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_Lcbl] = Lines_Set[nrcbl[its_Rdr_LineNb]+AltWAdec];
sprintf(#A004,"UpdRd %d bn=%d ba=%d", ln, nrcbl[its_Rdr_LineNb], Lines_Set[nrcbl[its_Rdr_LineNb]+AltWAdec]);
            );
            // reader lié à un writer ?
            (nrcbl[its_Rdr_WrBPtr] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_WrBPtr] = Writers_set[nrcbl[its_Rdr_WrSrc]+AltWAdec];
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens lecteurs
    ln = 0; loop(RD_CNT + 1,
        Rd_Delete(ln);
        ln += 1;
    );

    // Update writers
    ln = 0; loop(WR_CNT + 1,
        nwcbl = Writers_set[ln+AltWAdec];
        (nwcbl !== 0) ? (
            (nwcbl[its_Wrt_Lcbl] > BASE_MEMORY) ? (
                // Update with the new address
                nwcbl[its_Wrt_Lcbl] = Lines_Set[nwcbl[its_Wrt_LineNb]+AltWAdec];
sprintf(#A005,"UpdWr %d st=%d bn=%d ba=%d", ln, nwcbl[its_Wrt_Status], nwcbl[its_Wrt_LineNb], Lines_Set[nwcbl[its_Wrt_LineNb]+AltWAdec]);
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens écrivains
    ln = 0; loop(WR_CNT + 1,
        Wr_Delete(ln);
        ln += 1;
    );

    // On peut libérer les anciens effets
    ln = 0; loop(FX_CNT + 1,
        FX_Delete(ln);
        ln += 1;
    );

    // mise en place du nouveau bloc d'addresses
    memcpy(StaticWA, DuplWA, StaticWASize);
    memset(DuplWA, 0, StaticWASize);
    updt_tables(StaticWA);
);

/*
    Gather all information needed for a preset
    SVASIZ is at least 32
*/
function build_savarea()
(
    memset(savarea, 0, SVASIZ);
    savarea[0] = savcode;

    savarea[10] = pgmode;
    savarea[11] = vol_inp;
    savarea[12] = vol_out;

    savarea[SVASIZ-1] = savcode;
);

function load_loadarea()
(
    pgmode = lodarea[10];
    vol_inp = lodarea[12];
    vol_out = lodarea[12];
);



// Print a sequence of strings
function mSL_133(argc, argv)
(
    while (argc > 0) (
        mSL_log(SysLogBox, argv[0]);
        argc -= 1; argv += 1;
    );
);

// This redefines the function "mSL_134" as the product of its operands
function mSL_134(argc, argv)
local (product, ip)
(
    product = 1;
    ip = 0;
    loop(argc, product *= argv[ip]; ip += 1;);
    product;
);

// External access to some useful data structures
function mSL_135(argc, argv)
local (item)
(
    item = argv[0];
    (item == KodedSchPads) ? (
        SchedPadSet; // A 16 entries array
    ) :
    (
        -1;
    );
);

function mSL_define_extensions()
(
    mSL_define_opcode("GM_Log", 133); // define "GM_Log"
    mSL_define_opcode("print", 133); // define print as a synonyp for "GM_Log"
    mSL_define_opcode("prod", 134); // define "prod"
    mSL_define_opcode("GM_Addr", 135); // etc.
);

// define our new extensions
mSL_define_extensions();


initAllParameters();
dclAllParameters();


// Insert here the mSL interpreter
<? include("GM-Libs/mSL_Evaluator.jsfx-inc"); ?>


TabAddrMax = mSL_StM_FreePt; // max. address recognized for an array
SharedHighMemory = lastmemory = make_array(2); // last use of the function



// Initial memory check
mSL_StM_Check(0);



Last_in_memory_alloc = mSL_StM_FreePt;
Free_Memory = __memtop() - mSL_StM_FreePt;
str_mess = "Interstys started";

mSL_log(SysLogBox, "*** Interstys started ***");

@slider

update_sliders();



@serialize


doingLoad = doingSave = 0;
handling_load = perform_loading = 0;
loadMode = file_avail(0) >= 0;


loadMode ? (


    // ===LOAD===

    doingLoad = 1;
    handling_load = 1;
    lditmc = 0;
    ldtotal = 0;
    lderr = 0;
    memset(DuplWA, 0, StaticWASize); // clean the load area pointer
    // First, load the block
    slz1 = load_mem(0, lodarea, SVASIZ);
    ldtotal += slz1;
    ldok = (lodarea[0] == savcode) && (lodarea[SVASIZ-1] == savcode);
    while (ldok && (file_avail(0) > 0)) (
        slz2 = load_mem(0, savtmp, TMPSIZ);
        ldtotal += slz2;
        (savtmp[0] === 'stwa') ? (
            si = savtmp[1];
            sbty = savtmp[2];
            sbsz = savtmp[3];
            ((si < 0) || (si >= StaticWASize)) ? (
                ldok = 0;
                lderr = 180
            ) : (
                // Create a memory area for the block
                sbl = mSL_Dyn_Alloc(sbsz, sbty, 0); // allocate memory
                (sbl === 0) ? (
                    ldok = 0; // can't allocate
                    lderr = 170;
                ) : (
                    rdsz = load_mem(0, sbl, sbsz); // Read the block
                    ldtotal += rdsz;
                    (rdsz !== sbsz) ? (
                        ldok = 0;
                        lderr = 160;
                    ) :
                    (check_its_block(sbl)) ? (
                        ldok = 0;
                        lderr = 156;
                    ) : (
                        DuplWA[si] = sbl;
                        lditmc += 1;
                    );
                );
            );
        ) :
        (
            zzz_savtmp = savtmp[0];
            zzz_sastwa = 'stwa';
            zzz_sequal = zzz_savtmp == zzz_sastwa;
            ldok = 0;
            lderr = 150;
        );

    );
    (
        // load is ok
        str_mess += 1; str_mess > 32 ? str_mess = 16;
        sprintf(str_mess, "Load (%d / %d), %d items.", ldok, lderr, lditmc);
    );

    (lderr === 0) ? (
        perform_loading = 1;
        handling_load = 1;
    );


) : (

    //  ===SAVE===

    doingSave = 1;
    svitmc = 0;
    sverr = 0;
    svtotal = 0;
    build_savarea();
    siz1 = save_mem(0, savarea, SVASIZ);
    svtotal += siz1;
    // siz4 = 0;
    // Save all objects, except lines set pointers and contents
    si = 0; loop(PtrsInWA,
        (((sbl = StaticWA[si]) > BASE_MEMORY) && (mSL_bl_check(sbl))) ? (
            // A block to save
            savtmp[0] = 'stwa'; // the type of save
            savtmp[1] = si; // the entry in the area
            savtmp[2] = sbl[-2]; // the type of the block to be recreated
            savtmp[3] = sbsz = sbl[-1]; // the length of the block
            siz2 = save_mem(0, savtmp, TMPSIZ);
            siz3 = save_mem(0, sbl, sbsz);
            svtotal += siz2 + siz3;
            svitmc += 1;
        );
        si += 1;
    );


    (
        // load is ok
        str_mess += 1; str_mess > 32 ? str_mess = 16;
        sprintf(str_mess, "Save (%d / %d), %d items; %d words.", ldok, sverr, svitmc,svtotal);
    );
);


doingLoad = doingSave = 0;







@block
chcnt = num_ch;

// We achieve preset loading here to avoid conflicts with readers/writers
(perform_loading !== 0) ? (
    perform_loading = 0;
    recreate_structures(); // also update tables
    load_loadarea();
    // force sliders update
    lnupdt = slupdt = wrupdt = rdupdt = fxupdt = 1;
    handling_load = 0;
);

dbg_show_2(Readers_set[0],67);


// Count Solo Readers
i = j = 0;
loop(RD_CNT,
    ((r = Readers_set[i]) !== 0)  ? (
        (r[its_Rdr_StFlgs] & its_RdrFlg_solo) ? j += 1;
        (r[its_Rdr_StFlgs] & its_RdrFlg_Mod) ? Rd_Update(i);
    );
    i += 1;
);
its_RdrSolos = j; // count of readers in solo mode


@sample

(pgmode < 2) ? (
    // Phase 1 --
    // reset all temporaries tables
    memset(smpl_tab, 0, TEMP_SIZE);
    // get input samples ;
    i = 0; j = smpl_tab + SPL_P; loop (chcnt,
        j[0] = vol_inp * spl(i);
        spl(i) = 0;
        i += 1; j += 1;
    );

    // Phase 2 -- Pre READERS Effects
    fxn = 0; loop(FX_CNT,
        (((fx = Effects_set[fxn]) != 0) && (fx[its_Efx_Status] != 0)
            && (fx[its_Efx_Phase] === its_Efx_PhasePre)) ? (
            exec_fx(fx, fxn);
        );
        fxn += 1;
    );

    // Phase 3 -- Run READERS
    rdn = 0; loop(RD_CNT,
        (((X_rd = Readers_set[rdn]) !== 0) && (X_rd[its_Rdr_Flgs] !== 0) && (X_rd[its_Rdr_Status] === its_RdrStat_Reading)) ? (
            Trace_X_exec_reader = X_rd;
            exec_reader(X_rd, rdn);
        );
        rdn += 1;
    );

Trace_D_Readers_addr_0 = X_rdz = Readers_set[0];
Trace_D_Readers_flg_0 = X_rdz[its_Rdr_Flgs];
Trace_D_Readers_stat_0 = X_rdz[its_Rdr_Status];

    // Phase 4 -- Run Standard effects
    fxn = 0; loop(FX_CNT,
        (((fx = Effects_set[fxn]) != 0) && (fx[its_Efx_Status] != 0)
            && (fx[its_Efx_Phase] === its_Efx_PhaseStd)) ? (
            exec_fx(fx, fxn);
        );
        fxn += 1;
    );

    // Phase 5 -- Run Writers
    wrn = 0; loop(WR_CNT,
        (((X_wr = Writers_set[wrn]) != 0) && (X_wr[its_Wrt_Flgs] != 0) && (X_wr[its_Wrt_Status] == its_WrtStat_Writing)) ? (
            Trace_X_exec_writer = X_wr;
            exec_writer(X_wr, wrn);
        );
        wrn += 1;
    );

Trace_D_Writers_addr_0 = X_wr = Writers_set[0];
Trace_D_writers_flg_0 = X_wr[its_Wrt_Flgs];
Trace_D_writers_stat_0 = X_wr[its_Wrt_Status];
Trace_D_writers_count_0 += 1;

    // Phase 6 -- Post Writers Effects
    fxn = 0; loop(FX_CNT,
        (((fx = Effects_set[fxn]) != 0) && (fx[its_Efx_Status] != 0)
            && (fx[its_Efx_Phase] === its_Efx_PhasePost)) ? (
            exec_fx(fx, fxn);
        );
        fxn += 1;
    );

    // generate output samples
    i = 0; j = smpl_tab + OUT_P; loop (chcnt, spl(i) += vol_out * j[0]; i += 1; j+= 1;);

);

Trace_X_sample_count += 1;



// Trace a few work area
<? i=0; loop(8, printf("work%02d = smpl_tab[%d];", i, i); i+=1;); ?>





@gfx

function xBlack() (gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 1.0;);

gfxStartTime = time_precise();
gfxWStat = gfx_getchar(65536);
zz_graphic_exec += 1;

// Minimalist work
gfx_clear = 0xeeeeee; // light grey background color identical to sliders background

ctime = time();
(prvtime != ctime) ? (
    prvtime = ctime;
    disptime = (prvtime % 30) === 0;
    mcp_indic = max(0, mcp_indic-1);
    speedchanged = max(0, speedchanged-1);

    slTimer = ctime % 60;
    // slupdt = 1;
);

// gfxMaxDur = 0.01; // 10 ms
gfxStrtT = time_precise() + timeD;


function do_GenericKeyRead()
(
    (KeyedT === 0) ? (KeyedT = Keyed; Keyed = 0; );
    (KeyedT === 0) ? (KeyedT = ui_key(); );
    (KeyedT === 0) ? (KeyedT = ui_key_next(); );
    (KeyedT > 0) ? AAAA_lastKeyedT = KeyedT;
    KeyedT;
);



function
do_Generic_Commands()
local (z, SKeyedT)
(
    do_GenericKeyRead();
    AAAA_uix_jmbsel = uix_jmbsel;
    (KeyedT > 0) ? (
        SKeyedT = KeyedT; // Save keyed character
        AAAA_Key40 = KeyedT;
        AAAA_Kmouse_cap2 = Kmouse_cap ;
        AAAA_KcolMouseWasIn = colMouseWasIn;
        AAAA_KstudDispPCnt = studDispPCnt;

        ((KeyedT === 8)) ? (
            flagStopOne += 1;
        ) :
        (
            KeyedT = SKeyedT; // restore Keyed character
        ) ;
        ui_GFXdoNow |= 1;
        ui_GFXReason = 15;
    );

    (KeyedT === 0) ? ui_key_next();
);

function do_GenericTabStart()
(
    ui_jmouse_cap |= mouse_cap;
    KeyedT = Keyed = 0; AAAA_Kmouse_cap = Kmouse_cap = ui_jmouse_cap;
    studio_pad_active = 0;
    do_Generic_Commands();
);

function do_GenericTabEnd()
(
    //do_Generic_Commands();
    0;
);



1 ? (
    (strlen(#dbg_trace0) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace0);
        #dbg_trace0 = "";
    );
    (strlen(#dbg_trace1) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace1);
        #dbg_trace1 = "";
    );
    (strlen(#dbg_trace2) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace2);
        #dbg_trace2 = "";
    );
    (strlen(#dbg_trace3) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace3);
        #dbg_trace3 = "";
    );
    (strlen(#dbg_trace4) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace4);
        #dbg_trace4 = "";
    );
    (strlen(#dbg_trace5) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace5);
        #dbg_trace5 = "";
    );
    (strlen(#dbg_trace6) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace6);
        #dbg_trace6 = "";
    );
    (strlen(#dbg_trace7) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace7);
        #dbg_trace7 = "";
    );
);

// ch = gfx_getchar();
ch = do_GenericKeyRead();
uix_latestchar = KeyedT = 0;
mcp = mouse_cap;
(mcp & 2) ? (
    mcp_indic = 20; // right clic in the graphic area
);

(ch === 'm') ? (
    gui_show_memory = gui_show_memory ? 0 : 1;
) :
(ch === 'l') ? (
    gui_show_syslog = gui_show_syslog ? 0 : 1;
) :
(ch === 'u') ? (
    gui_show_UI = gui_show_UI ? 0 : 1;
) :
(ch === 's') ? (
    (gui_show_sliders = gui_show_sliders ? 0 : 1) ? (
        slupdt = wrupdt = rdupdt = fxupdt = lnupdt = forceupdt = 1;
    ) : (
        slupdt = wrupdt = rdupdt = fxupdt = lnupdt = forceupdt = 0;
        mod_sliders(0);
    );
) :
(ch === 9) ? (
    currScreenNb = (currScreenNb  + 1 + dcbTabsCount) % dcbTabsCount;
    ui_screen_switch(uix_jG_menuscr[currScreenNb]);
) :
(
    uix_latestchar = ch; // restore keyed
);


(speedchanged && mcp_indic && (speedchanged < 2)) ? (
       Currreader[its_Rdr_Speed] = slRSpeedPrv = slRSpeed = floor(0.5 + 2 * slRSpeed)/2;
       Currreader[its_Rdr_AbsInc] = Currreader[its_Rdr_Speed];
       Currreader[its_Rdr_Abspos] = floor(0.5 + Currreader[its_Rdr_Abspos]);
       sliderchange(slRSpeed);
       speedchanged = 0;
);


(str_mess !== 0) ? (
    mSL_log(SysLogBox, str_mess);
    str_mess = 0;
);



efi = 1; idx = efs = 0;
while (efi) (
  (efi = gfx_getdropfile(idx, #s)) ? (
    msx = mouse_x; msy = mouse_y; msc = mouse_cap;
    efs = mSL_Str_Tmp();
    strcpy(efs, #s);

    (match ("*.mSL", efs)) ? (
        //sprintf(#s, "*  Compile: %s  (%d)  *", efs, strlen(#efs)); mSL_log(SysLogBox, #s);
        doMslCompile(efs); // add to compile list
    ) :
    (match ("*wav", efs) || match ("*aif", efs) || match ("*flac", efs) || match ("*mp3", efs) || match ("*aiff", efs) || match ("*ogg", efs) || match ("*wmv", efs)) ? (
        strcpy(#efs, efs); // save in #efs
        dpa = 1; // an audio file is available
        /*
        sprintf(#s, "::drop file : \"%s\" - %d, %d, %d", efs, msx, msy, msc);
        mSL_log(SysLogBox, #s);
        */
    ) : (
        sprintf(#s, "::unknown file type : \"%s\"", efs);
        mSL_log(SysLogBox, #s);
    );
    ui_GFXdoNow |= 1; // Make sure we react as soon as possible
    idx += 1;
  );
);

(idx != 0) ? gfx_getdropfile(-1);



mSL_loc_tim = max(mSL_loc_tim - 1, 0);

(atomic_get(mSL_Lock) && (mSL_loc_tim <= 0))? (
    // we may have a GC to run
    (gc_run_phaz != 0) ? (
        (gc_run_phaz === 1) ? (
            gc_count += 1;
            (mSL_Dyn_Tr & 4) ? ( sprintf(#gfxu, "Starting a GC [free:%d  used:%d] ", mm_show_ttf, mm_show_ttu); mSL_log(SysLogBox, #gfxu); );
            mSL_loc_tim = max(2, mSL_loc_tim + 2); // no GC for some time
            // Perform a GC
            mSL_gc_start = time_precise() + timeD;
            mSL_errX = mSL_errC = 0;
            gc_start();
            gc_release_unused_thread();
            gc_mark_active();
            gc_mark(0); // make sure the last blocks have been checked
            // execute the sweep phase
            gc_sweep();
            gc_run_phaz = 3; // This is over
            mSL_gc_end = time_precise() + timeD;
            mSL_errX = max(mSL_errX, mSL_errC);
            ((FlagsTbVals[Flgs_GC] & 1) && mSL_errX) ? (
                sprintf(#gfxu, "GC Err: %d - Dur %.2f ms", mSL_errX,
                        1000 * (mSL_gc_end - mSL_gc_start));
                mSL_log(SysLogBox, #gfxu);
            );
            mSL_gc_MaxDur = max(mSL_gc_end - mSL_gc_start, mSL_gc_MaxDur);
        );
    ) :
    (
        // If we have a func to compile, do it A.S.A.P.
        (uuuMslFn != 0) ? (
            // Do we have enough memory to run a compilation ?
            !((gc_run_phaz > 1) || (mm_bl_huge > 0) || (mm_bl_big > 0) || (mm_bl_large >= 4) || (mm_bl_medium >= 64)) ? (
                // we may need a GC
                gc_run_phaz = 1; // start it
            ) : (
                ((mSL_active_Thread <= 0) && (uuuMslFent === 0)) ? (
                    // We are sure there are no active mSL thread...
                    // or compiler structure used
                    // and none can be started yet...
                    // look for a file to compile
                    uuuMslFname = 0;
                    ig = 0; while ((uuuMslFname === 0) && (ig < uuuMslTSiz)) (
                        (uuuMslFname = uuuMslTabs[ig]) ? (
                            uuuMslTabs[ig] = 0;
                        );
                        ig += 1;
                    );
                    (uuuMslFname === 0) ? ( // no file found to compile
                        uuuMslTPt = uuuMslFent = uuuMslFn = 0; // reset indicators
                    ) : (
                        uuuMslFent = mSL_load_file_inGFX(uuuMslFname);
                    );
                );
                mSL_loc_tim += 2; // again save some time
            );
        );


        // Do we have an mSL file loaded and compiled, ready to execute ?
        (uuuMslFent != 0) ? (
            (FlagsTbVals[Flgs_Scripts] & 1) ? (
                (mSL_errX === 0) ? (
                    // ready to introduce in the queue
                    sprintf(#s, "Loaded %s", uuuMslFname);
                ) : (
                    sprintf(#s, "File %s: err %d", uuuMslFname, mSL_errX);
                );
                mSL_log(SysLogBox, #s);
            );
            mSL_bl_clear(mSL_GC_Protected); // free compiler's structures
            uuuMslFent = 0;
            uuuMslLastFname = uuuMslFname;
            uuuMslFname = 0;
            atomic_set(mSL_Lock,  max(0, mSL_Lock - 1));
        );
    );

);




// Have we just achieved a GC ?
(gc_run_phaz > 2) ? (
    // gc is over
    gc_run_phaz = 0;
    mem_walk(0);
    (mSL_Dyn_Tr & 4) ? ( mem_show(); );
    FlagsTbVals[Flgs_GC] = 0;
    atomic_set(mSL_Lock,  max(0, mSL_Lock - 1));
);



//====== Scheduler management ======
while (ent = Scheduler()) (
    AAAA_Sch_code = code = SchedCode[ent];
    AAAA_Sch_par1 = par1 = SchedPar1[ent];
    AAAA_Sch_par2 = par2 = SchedPar2[ent];
    AAAA_Sch_par3 = par3 = SchedPar3[ent];
    AAAA_Sch_par3 = par4 = SchedPar4[ent];

    // do some work...

    (code & SchedWBit) ? (
        SchedCode[ent] &= SchedWBMask ; // suppress wait bit
        SchedInsertTail(SchedActivPts, ent, SchETypeThrd);
        ent = 0;
    ) :
    (code === 1) ? (
        // A defered action to perform
        (par1 === 'task') ? (
            // introduce this task in active list
            // par2 can be an entry number (in 1... 4096) or an entry address
            zact = par2;
            ((par2 > 0) && (par2 < SchedNEmax)) ? (
                zact = SchedFirstEnt + SchedEntSiz * par2;
            );
            ((zact >= SchedFirstEnt) && (zact <= SchedLastEnt)) ? (
                // This refers to an entry to execute
                SchedInsertTail(SchedActivPts, zact, SchETypeThrd);
            );
            SchedPar2[ent] = 0; // ok
        ) :
        (par1 === 'smsg') ? (
            // send a message to some task.
            // par2 is supposed to be a message - this is checked by event_send_msg
            (SchETypeMess === mSL_Mbl_check(par2)) ? (
                SchevDateSent[par2] = 0; // clear send date
                event_send_msg(par2);
            );
            SchedPar2[ent] = 0; // message has been transmitted
        );
    ) :
    (code === 8) ? (
        // Run entry "0" of tasks
        k = 0; // should refer to a compiled code
        mSL_errX = 0;
        ((mSL_bl_check(k, Undef, 9793) === 0) && (k[mSL_CC_Key] === mSL_CC_KeyCKod)) ? (
            // try to execute the gizmo
            (ent = getNewThread()) ? (
                SchedPar1[ent] = k; // keep the code to execute
                SchedPar4[ent] = 0; // use current own variables
                SchedCode[ent] = KRun_mSL_Thread; // ready to start running a thread
                mSL_init_thread(ent);
            ) : (
                err_sys_rtm = 9606;
            );
            (mSL_errX === 0) ? (
                SchedInsertTail(SchedActivPts, ent, SchETypeThrd);
                ent = 0;
            ) : (
                sprintf(#u, "Code 8: Ent: %d - Err: %04d", ent, mSL_errX);
                mSL_log(SysLogBox, #u);
                // ADump(k);
            );
        );
    ) :
    (code === 9) ? (
        // execute a delayed list of "simple actions"
        Simple_Action(par1);
    ) :
    (code === KRun_mSL_Thread)? ( // 10
        // A delayed mSL Thread
        // reintroduce the thread in the queue
        SchedInsertTail(SchedActivPts, ent, SchETypeThrd);

        // GMW2("E"); // *DBG*
        ent = 0;
    );
    // possibly free the entry
    ent ? SchedFree(ent); // appropriate free operation
);


// Unlock all waiting processes after a "load" or a "gc"
while (SchedListNonEmpty(SchedLockdPts) && (atomic_get(mSL_Lock) === 0)) (
    SchX = SchedDetachHead(SchedLockdPts);
    SchedInsertTail(SchedActivPts, SchX, SchETypeThrd);
);



XeSched = 1; // set to 1 to make sure we execute at least 1 task during each @block execution
//============ GLOBAL Interpreter ==============
while (SchedActive &&
    ((((TLeft = gfxMaxDur + gfxStrtT - (gstrt = time_precise() + timeD)) > 0)) || XeSched) &&
    ((SchX = SchedDetachHead(SchedActivPts)) != SchedNone))
(
    // Get some parameters
    // Execute the action
    XeSched = 0;
    xop = SchedCode[SchX];   // actually, only 1 to 13 are being used
    curr_Proc_PID = SchedPid[SchX]; // current process ident
    curr_Proc_Name = SchedThrName[SchX]; // current process name
    mSL_xop_cnt = (mSL_xop_cnt + 1) % 1000000;


    (xop === 10) ? (
        //++++10++++//
        //====== mSL EXECUTION ======
        // mSL_errX=10;
        mSL_dispatch_entry = SchX;
        atomic_get(mSL_Lock) ? (
            // We are doing some exclusive operation. mSL Threads are not allowed to execute
            SchedInsertTail(SchedLockdPts, SchX, SchETypeThrd); // insert the thread in locked pts
            SchX = -1;
        ) : (
            tstrt = time_precise() + timeD;
            mSL_active_Thread = SchedThrdPt[SchX]; // the thread
            ((SchedStatus[mSL_dispatch_entry] & SchmSLThrUsed) != SchmSLThrUsed) ? (
                (mSL_errX === 0) ? mSL_errX = 3381; // thread not noted active ?
            );
            mSL_load_thread(mSL_active_Thread);
            mSL_max_TOS = mSL_active_Thread[mSL_THR_basePhStack];

            (mSL_errX != 0) ? (
                thread_error(mSL_active_Thread, mSL_errX, SchX);
            ) : (
                mm_xec_mm[mm_xec_ptr] -=  mSL_ICount;
                mm_cyc_mm[mm_cyc_ptr] -=  mSL_ICount;
                // Curr_Block_Alloc
                AAAAAAAA_mSL_rpeat = mSL_rpeat = max(8192, min(16384, 0|(mSL_insts_per_s * TLeft * 0.35)));
                mSL_evaluate();

                //GMW2("A2");
                AAAAAAAA_mSL_evaluate_count += 1;
                mSL_High_Stack = max(mSL_High_Stack, mSL_max_TOS - mSL_active_Thread[mSL_THR_basePhStack]);
                // sprintf(#uuu, "End of evaluation - CR: %d - XC: %d", mSL_CodeStop, AAAAAAAA_mSL_evaluate_count);
                // mSL_log(SysLogBox, #uuu);
                // GMW2("B");
                mSL_save_thread(mSL_active_Thread);
                ((mSL_CodeStop === 0) || (mSL_CodeStop === mSL_RC_Yield)) ? (
                    // reintroduce the thread in the queue
                    SchedInsertTail(SchedActivPts, SchX, SchETypeThrd);
                    SchX = -1;
                ) :
                (mSL_CodeStop === mSL_RC_Wait) ? (
                    (mSL_WaitDuration > 0) ? (
                        // introduce the entry in the wait queue
                        Schedule(SchedRelative, mSL_WaitDuration, 0, SchX, 0, 0, 0);
                    ) : (
                        // reintroduce the thread in the queue
                        SchedInsertTail(SchedActivPts, SchX, SchETypeThrd);
                    );
                    SchX = -1;
                ) :
                (mSL_CodeStop === mSL_RC_Stop) ? (
                    // finished, free the thread
                    //
                    freeSchedThread(SchX);
                    // SchedStatus[SchX] &= SchThrNotUsed;
                    // SchedInsertTail(SchedInactPts, SchX, SchETypeThrd);
                    mSL_dispatch_entry = SchX = -1;
                    flagShowMemory = 1;
                ) :
                (mSL_CodeStop === mSL_RC_WEvent) ? (
                    // introduce the entry in the wait queue
                    SchedInsertTail(SchedEvntPts, SchX, SchETypeThrd);
                    (FlagsTbVals[Flgs_Thrds] & 2) ? ( // trace flags
                        sprintf(#s, "Insert in Evnt : ent: %d thrd: %d siz: %d ", SchX, mSL_active_Thread, SchedListSize(SchedEvntPts));
                        mSL_log(SysLogBox, #s);
                    );
                    AAAAA__Schx = Schx;
                    AAAAA__SchxNum = ent[SchedPid] & SchedNMask;
                    SchX = -1;
                ) :
                (mSL_CodeStop === mSL_RC_WAITGC) ? (
                    // introduce in the wait for GC list
                    SchedInsertTail(SchedLockdPts, SchX, SchETypeThrd);
                    SchX = -1;
                ) :
                (
                    //AAAAAAAA_Errx = mSL_errX;
                    thread_error(mSL_active_Thread, mSL_errX, mSL_CodeStop);
                    // SchedStatus[SchX] &= SchThrNotUsed;
                    // SchedInsertTail(SchedInactPts, SchX, SchETypeThrd);
                    // sprintf(#uuu, "End of evaluation [%d]  CR: %d  Err: %d", SchX, mSL_CodeStop, mSL_errX);
                    // (mSL_wbl != 0) ? ( sprintf(#uuu, "Block damaged @ %d", mSL_wbl);mSL_log(SysLogBox, #uuu); );
                    mSL_error_analysis(mSL_active_Thread);
                    SchedFree(SchX);
                    SchX = -1;
                    flagShowMemory = 1;
                    mSL_errC = 0; mSL_errX = 1717; // "error previously detected"
                    mSL_errX = 0; // let other threads progress
                );
                mm_xec_mm[mm_xec_ptr] += mSL_ICount;
                mm_cyc_mm[mm_cyc_ptr] += mSL_ICount;
            );
            mm_dur_mm[mm_cyc_ptr] += time_precise() + timeD - tstrt;
        );
        mSL_active_Thread = -1;

        //++++10++++//
    );



    SchX > 0 ? SchedFree(SchX);
);








(slupdt || wrupdt || rdupdt || fxupdt || lnupdt || forceupdt) ? (
    update_sliders();
    forceupdt = 0;
);


function keepBlockInfos(bCurrent)
local(i)
(
    blockDesc ? (
        // keep position
        i = 0; loop (dcbMSize - 1,
            (blockDesc[i] === bCurrent) ? (
                blockDesc[i+dcbMSize] = A99PBlock = (ui_top_retina()*10000)+ui_height_retina();
            );
            i += 1;
        );
    );
);



function mSL_Dbg_Memory_Updt(membox)
local (n, w)
(
    (membox[14] & 0x100) ? (
        w = 0;
        n = membox[7];
        (n === 5) ? (
            w = StaticWA;
        ) :
        (n === 6) ? (
            w = DuplWA;
        ) :
        (n === 7) ? (
            w = Readers_set;
        ) :
        (n === 8) ? (
            w = Lines_set;
        ) :
        (n === 9) ? (
            w = Writers_set;
        ) :
        (n === 10) ? (
            w = Effects_set;
        ) :
        (n === 11) ? (
            w = smpl_tab + SPL_P;
        ) :
        (n === 12) ? (
            w = alt_tab + OUT_P;
        ) :
        (n === 21) ? (
            w = Readers_set[0];
        ) :
        (n === 22) ? (
            w = Lines_set[0];
        ) :
        (n === 23) ? (
            w = Writers_set[0];
        ) :
        (n === 24) ? (
            w = Effects_set[0];
        ) :
        (n === 25) ? (
            w = Readers_set[1];
        ) :
        (n === 26) ? (
            w = Lines_set[1];
        ) :
        (n === 27) ? (
            w = Writers_set[1];
        ) :
        (n === 28) ? (
            w = Effects_set[1];
        ) :
        (
            w = 0;
        );
        membox[9] = membox[8] = membox[7] = w;
    );
);




<? include("GM-Libs/mSL_Dbg_Memory.jsfx-inc"); ?>



function show_local_Infos()
local (uix_jneed, uix_jmini, h1, k, w, siz, u_ch, ent)
(
    (gui_show_syslog && gui_show_memory) ? (
        SysLogBox[4] = 20;
        memoryBox1[17] = memoryBox2[17] = 52;
    ) :
    (gui_show_syslog) ? (
        SysLogBox[4] = 80;
    ) :
    (gui_show_memory) ? (
        memoryBox1[17] = memoryBox2[17] = 96;
    );
);



/*
   Display a log/trace
*/
function show_SysLog(blnb, box)
local (h1, h3, disps, mini, avail, uix_jneed, uix_jmini, ptr, nc, as, fl, flg, zzmi, xx, ii, u_ch, siz, dep, had, thgh)
(
    disps = box[4]; mini = 2;
    h1 = uix_jBoxHeight(mini);
    h3 = uix_jBoxHeight(disps);
    // (box[6] <= 0) ? box[6] = ui_jd_tboxs;
    uix_jneed = h3 + ui_jd_delta2 + ui_jd_ctgr;
    uix_jmini = max(h1 + ui_jd_ctgr, ui_jd_min_block);
    (ui_height() >= uix_jmini) ? (
        ui_split_top(uix_jneed);
            //ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blnb);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group("Script Syslog");
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
            ui_align(0,0);
            as = box[2]; // array size
            fl = box[1]; // first line
            xx = control_jmenu(menu_uix_jlog);
            (xx > 0) ? (
                (xx === 1) ? (
                    box[5] = 1;
                ) :
                (xx === 2) ? (
                    box[5] = 2;
                ) :
                (xx === 3) ? (
                    box[5] = 3;
                ) :
                (xx === 4) ? (
                    box[5] = 4;
                ) :
                (xx === 5) ? (
                    box[6] = min(20, box[6]+1);
                ) :
                (xx === 6) ? (
                    box[6] = max(0, box[6]-1);
                ) :
                (xx === 7) ? (
                    mSL_log(box, "");
                ) :
                (xx === 8) ? (
                    ii = 0; loop(as,
                        strcpy(fl + ii, ""); ii += 1;
                    );
                );
            );

            (zzmi) ? (
                u_ch = do_GenericKeyRead();
                (u_ch != 0) ? (
                    sprintf(#gfx_uc, "Keyed: '%c' [%d]", u_ch, kcnt); kcnt+= 1;
                    // mSL_log(SysLogBox, #gfx_uc);
                    (FlagsTbVals[Flgs_Traces] & 1) ? (
                        sprintf(#sq, "***Key  @  %d  %d  %d [%02x+%02x -> '%c']", mouse_x, mouse_y, mouse_cap, mouse_cap, u_ch, u_ch);
                        mSL_log(SysLogBox, #sq);
                    );
                    ui_key_next();
                    Keyed = 0;
                    ((u_ch === ' ') || (u_ch ===  0x0d)) ? (mSL_log(box, " ");) :
                    (u_ch === 'm') ? (box[6] = min(20, box[6]+1);) :
                    (u_ch === 'l') ? (box[6] = max(0, box[6]-1);) :
                    (u_ch === 'z') ? (box[7] = 0;) :
                    (u_ch === 'k') ? (box[7] = max(0, box[7]-1);) :
                    (u_ch === 'j') ? (box[7] = (box[7]+1) % box[2];) :
                    (u_ch === 't') ? (nowTime(); mSL_log(SysLogBox, #nowis);) :
                    //(u_ch === 'v') ? (ShowConfig();) :
                    (u_ch === 'up') ? (box[7] = max(0, box[7]-10);) :
                    (u_ch === 'down') ? (box[7] = (box[7]+10) % box[2];) :
                    ((ui_jmouse_cap === 0) && (u_ch === 'left')) ? (box[7] = 0;) :
                    ((ui_jmouse_cap === 0) && (u_ch === 'rght')) ? (box[7] = (box[7]+100) % box[2];) :
                    (u_ch === '1') ? (box[5] = 1;) :
                    (u_ch === '2') ? (box[5] = 2;) :
                    (u_ch === '3') ? (box[5] = 3;) :
                    (u_ch === '4') ? (box[5] = 4;) :
                    (u_ch === '5') ? (box[5] = 5;) :
                    (u_ch === '6') ? (box[5] = 6;) :
                    (u_ch === '7') ? (box[5] = 7;) :
                    (u_ch === '8') ? (box[5] = 8;) ;
                    //(u_ch === 'p') ? (sysout(SysLogBox);) :
                    Keyed = KeyedT = 0;  // u_ch has not been used
                );
            );
            nc = max(1, min(8, 0|box[5])); // number of columns to show
            nc = min(nc, floor(gfx_w/gfx_colL_width));

            ui_jshow_color = ui_jcolor_text;
            siz = box[2];
            dep = siz - 1; had = box[6];
            ptr = (box[3] + dep + 16*siz - box[7]) % siz; // last inserted line
            loop (nc,
                (nc != 0) ? ui_new_column(1/nc) : ui_new_column();
                nc = 0;
                ui_pad(3,0);ui_align(0, 0.5);
                ui_pcolor(ui_jshow_color);
                flg = 1;
                while (flg) (
                    /*
                    ui_jd_tboxh = had + ui_wraptext_height(#txt);
                    #txt = fl + ptr; // line to print
                    twdt = ui_text_width(#txt);
                    (twdt < wdth) ? (
                        (ui_height() >= ui_jd_tboxh) ? (
                            // put the string
                            uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                ui_pcolor(ui_jshow_color);
                                ui_wraptext(#txt);
                            ui_pop();
                            ptr = (ptr + dep) % siz;
                        ) : (
                            flg = 0;
                        );
                    ) : (
                    */
                    // Mono or Multi-line text
                    #txt = fl + ptr; // line to print
                    (strlen(#txt) === 0) ? #txt = " ";
                    thgh = ui_wraptext_height(#txt) + had;
                    (ui_height() >= thgh) ? (
                        // put the string
                        ui_split_top(thgh);
                            // ui_pcolor(ui_jshow_color);
                            ui_wraptext(#txt);
                        ui_pop();
                        ptr = (ptr + dep) % siz;
                    ) : (
                        flg = 0;
                    );
                    /*
                    lg = strlen(#txt);
                    k = max(1,ceil(lg / maxl));
                    (flg = (av = av - k) >= 0) ? (
                        (k === 1) ? (
                            // put the string
                            uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                ui_pcolor(ui_jshow_color);
                                ui_wraptext(#txt);
                            ui_pop();
                        ) : (
                            off = 0; sz = maxl;
                            while (k > 0) (
                                // cut the string in a few parts
                                strcpy_substr(#txt1,#txt, off, sz);
                                // put the string
                                uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                    // ui_pad(0,1,0,0);
                                    ui_pcolor(ui_jshow_color);
                                    ui_wraptext(#txt1);
                                ui_pop();
                                k -=1; off += maxl; sz = min(maxl, lg); lg -= sz;
                            );
                        );
                        ptr = (ptr + dep) % siz;
                    );
                    */
                );
            );
            ui_pop();


        ui_pop();
    );
);

/*
   RDBL[0] = reader to display
   RDBL[1] = reader type
   RDBL[2] = UI Error
   RDBL[3] = Exec error
   RDBL[4] = Speed display option
   RDBL[5] = Neded sliders count
   RDBL[6] = region length size option
   RDBL[7] = region length option
*/
function show_Reader_Pad(RDBL, blockId)
local (h1, h2, uix_jneed, uix_jmini, rdr, rcbl, rok, lnb, lcbl, dfCol, zzmi, i, xx, w, k, r, jmc,
        rp, zi, zz, zzch, zzent, zzmcl, zzmmd, p1, p2)
(
    h1 = uix_jpadHeight(pad_Rdr_NL); // height
    h2 = (RDBL[5] > 0) ? ui_jd_slidh * RDBL[5] + 6 : 0;
    uix_jneed = uix_jmini = h1+h2+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(uix_jneed);
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            rdr = RDBL[0]; // number of reader to be displayed
            rcbl = Readers_set[rdr];
            rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
                (dpa != 0) ? (
                    // audio file droped here
                    sprintf(#s, "Reader::drop file : \"%s\" - %d, %d, %d", efs, msx, msy, msc);
                    mSL_log(SysLogBox, #s);
                    dpa = 0;
                    // should we create the reader ?
                    (!rok) ? (
                        // Create the reader
                        rcbl = Rd_Create(rdr);
                        rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
                    );
                    (rok) ? (
                        // Does this reader has a line ?
                        p1 = p2 = -1;
                        (((lnb = rcbl[its_Rdr_LineNb]) >= 0) && ((lcbl = rcbl[its_Rdr_Lcbl]) > BASE_MEMORY)
                            && (lcbl[-2] === KW_lcbl)) ? (
                            p1 = lnb; p2 = lcbl;
                        );
                        newlnb = File_Handle(efs, p1, p2);
                        ((newlnb >= 0)) ? (
                            // Update reader
                            Rd_Set_Line(rdr, newlnb+1);
                        );
                    );
                );
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Rdr_Labs, pad_Rdr_Siz);

                CL1 = Color_Cornflower_Blue;
                (rok) ? (
                    dfCol = Col_InfoA ;
                    RDBL[5] = 8;
                    i = 0; loop(pad_Rdr_Siz,
                        pad_Rdr_Colrs[i] = dfCol;
                        strcpy(pad_Rdr_Labs[i],"");
                        i += 1;);
                    strcpy(pad_Rdr_Labs[1],menu_Rdr_Type_N[rcbl[its_Rdr_Mode]]);
                    pad_Rdr_Colrs[1] = dfCol;
                    strcpy(pad_Rdr_Labs[2],menu_Rdr_Status_N[rcbl[its_Rdr_Status]]);
                    pad_Rdr_Colrs[2] = dfCol;
                    (rcbl[its_Rdr_LineNb] >= 0) ? (
                        sprintf(pad_Rdr_Labs[3], "Line %d", rcbl[its_Rdr_LineNb]+1);
                        sprintf(pad_Rdr_Labs[4], "Size %.3f s", floor(1000*rcbl[its_Rdr_SmplCnt]/srate)/1000);
                        sprintf(pad_Rdr_Labs[5], "Channels %d", rcbl[its_Rdr_ChNbr]);
                        sprintf(pad_Rdr_Labs[6], "First %d", rcbl[its_Rdr_Bf1stChan]);
                        sprintf(pad_Rdr_Labs[7], "Used %d", rcbl[its_Rdr_BfChanUsed]);
                        sprintf(pad_Rdr_Labs[11], "Pos %.2f %%", max(0,min(100, 100 * (rcbl[its_Rdr_Abspos] - rcbl[its_Rdr_Start])/max(1, rcbl[its_Rdr_Last] - rcbl[its_Rdr_Start]))));
                        sprintf(pad_Rdr_Labs[12], "Speed %.3f", rcbl[its_Rdr_Speed]);
                        // setCellIdent(rcbl[its_Rdr_RCell], pad_Rdr_Labs+10, pad_Rdr_Labs+11);
                        pad_Rdr_Colrs[3] = pad_Rdr_Colrs[4] = pad_Rdr_Colrs[5] =
                        pad_Rdr_Colrs[6] = pad_Rdr_Colrs[7] = Color_Heliotrope;
                        k = rcbl[its_Rdr_RCell] -1;
                        (k < 0) ? (
                            strcpy(pad_Rdr_Labs[10],"none");
                        ) : (
                            sprintf(pad_Rdr_Labs[10],"%s(%d)", menu_XCells_Ids_D[menu_XCells_Ids_Names + (k >> 8)],
                                        k & 0xFF);
                        );
                    );
                    // Mute
                    (rcbl[its_Rdr_StFlgs] & its_RdrFlg_mute) ? (
                        strcpy(pad_Rdr_Labs[8],"** Mute **");
                        pad_Rdr_Colrs[8] = CP6;
                    ) : (
                        strcpy(pad_Rdr_Labs[8],"Mute");
                        pad_Rdr_Colrs[8] = CP1;
                    );
                    // Solo
                    (rcbl[its_Rdr_StFlgs] & its_RdrFlg_solo) ? (
                        strcpy(pad_Rdr_Labs[9],"** Solo **");
                        pad_Rdr_Colrs[9] = CP7;
                    ) : (
                        strcpy(pad_Rdr_Labs[9],"Solo");
                        pad_Rdr_Colrs[9] = CP1;
                    );
                    pad_Rdr_Colrs[10] = CP3;
                    pad_Rdr_Colrs[11] = pad_Rdr_Colrs[12] = CL1;
                    pad_Rdr_Colrs[13] = pad_Rdr_Colrs[14] = pad_Rdr_Colrs[15] = CP1;

                    k = RDBL[6];
                    (k === 0) ? (
                        pad_Rdr_Colrs[19] = pad_Rdr_Colrs[20] = dfCol;
                    ) :
                    (k === 1) ? (
                        pad_Rdr_Colrs[19] = pad_Rdr_Colrs[20] = Color_Heliotrope;
                    ) : (
                        pad_Rdr_Colrs[19] = pad_Rdr_Colrs[20] = Color_Light_Steel_Blue;
                    );
                    (rcbl[its_Rdr_Status] === its_RdrStat_Reading) ? (
                        ((k = rcbl[its_Rdr_Speed]) >= 0) ? (
                            pad_Rdr_Colrs[k > 1.3 ? (k > 2.8 ? 23 : 22) : 21] = CL1;
                        ) : (
                            pad_Rdr_Colrs[k < -1.3 ? (k < -2.8 ? 16 : 17) : 18] = CL1;
                        );
                    ) :
                    (rcbl[its_Rdr_Status] === its_RdrStat_Paused) ? (
                        pad_Rdr_Colrs[20] = CL1;
                    ) :
                    (rcbl[its_Rdr_Status] === its_RdrStat_Ready) ? (
                        pad_Rdr_Colrs[19] = CL1;
                    );
                    rerr = rcbl[its_Rdr_Error];
                ) : (
                    dfCol = Col_Inactive ;
                    RDBL[5] = 0;
                    i = 0; loop(pad_Rdr_Siz,
                        pad_Rdr_Colrs[i] = dfCol;
                        strcpy(pad_Rdr_Labs[i],"");
                        i += 1;);
                    strcpy(pad_Rdr_Labs[1],menu_Rdr_Type_N[RDBL[1]]);
                    strcpy(pad_Rdr_Labs[2],menu_Rdr_Status_N[0]);
                    strcpy(pad_Rdr_Labs[3],"Line: None");
                    rerr = RDBL[2];
                );
                sprintf(pad_Rdr_Labs[0],"Reader %d", rdr+1);
                (rok) ? (
                    (rerr) ? (
                        sprintf(pad_Rdr_Labs[14],"Err: %d", rerr);
                        pad_Rdr_Colrs[14] = CP6;
                    );
                );
                strcpy(pad_Rdr_Labs[15],"Action");
                strcpy(pad_Rdr_Labs[16],"<<<");
                strcpy(pad_Rdr_Labs[17],"<<");
                strcpy(pad_Rdr_Labs[18],"<");
                (rok) ? (
                    strcpy(pad_Rdr_Labs[19], menu_Rdr_Loop_N[rcbl[its_Rdr_LoopType]]);
                ) : (
                    strcpy(pad_Rdr_Labs[19],"[.]");
                );
                strcpy(pad_Rdr_Labs[20],"[=]");
                strcpy(pad_Rdr_Labs[21],">");
                strcpy(pad_Rdr_Labs[22],">>");
                strcpy(pad_Rdr_Labs[23],">>>");


                zz = control_jpad(pad_Reader);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzch = pad_Reader[ui_jpad_lkey];
                    zzent = pad_Reader[ui_jpad_entkey]-1;
                    zzmcl = pad_Reader[ui_jpad_last]-1;
                    zzmmd = pad_Reader[ui_jpad_lmods];
                    /*
                            sprintf(#itm, "PAD -> %d %d %d %d %d", zz, zzch, zzent, zzmcl, zzmmd);
                            mSL_log(SysLogBox, #itm);
                    */
                    //==============================================
                    (zz & ui_jpad_ev_rmc) ? (  // right mouse clic
                        (zzmcl === 0) ? (
                            k = rdr+1;
                            ui_menu_tick(menu_Rdr_Ids, k, 1);
                            xx = control_jmenu(menu_Rdr_Ids);
                            sprintf(#itm, "Menu 0 -> %d", xx);
                            mSL_log(SysLogBox, #itm);
                            (xx != 0) ? (
                                RDBL[0] = xx - 1; // select a new reader
                            );
                            ui_menu_tick(menu_Rdr_Ids, k, 0);
                        ) :
                        (zzmcl === 1) ? (
                            k = 1 + (rok ? ( rcbl[its_Rdr_Mode] ) : ( RDBL[1] ));
                            ui_menu_tick(menu_Rdr_Type, k, 1);
                            xx = control_jmenu(menu_Rdr_Type);
                            sprintf(#itm, "Menu 1 -> %d", xx);
                            mSL_log(SysLogBox, #itm);
                            (xx != 0) ? (
                                (rok) ? (
                                    rcbl[its_Rdr_Mode] = xx - 1; // change mode
                                ) : (
                                    RDBL[1] = xx - 1; // "pre mode"
                                );
                            );
                            ui_menu_tick(menu_Rdr_Type, -1, 0);
                        ) :
                        (zzmcl === 2) ? (
                            (rok) ? (
                                k = rcbl[its_Rdr_Status]+1;
                                ui_menu_tick(menu_Rdr_Status, k, 1);
                                xx = control_jmenu(menu_Rdr_Status);
                                (xx != 0) ? (
                                    x = Rd_Set_Status(rdr, xx - 1);
                                    sprintf(#itm, "Menu 2 : %d -> %d -> %d", rdr, xx, x);
                                    mSL_log(SysLogBox, #itm);
                                );
                                ui_menu_tick(menu_Rdr_Status, -1, 0);
                            );
                        ) :
                        (zzmcl === 3) ? (
                            k = (rok) ? rcbl[its_Rdr_LineNb]+2 : 1;
                            ui_menu_tick(menu_Lin_SIds, -1, 0);
                            ui_menu_tick(menu_Lin_SIds, k, 1);
                            xx = control_jmenu(menu_Lin_SIds); // select a line
                            (xx != 0) ? (
                                x = Rd_Set_Line(rdr, xx - 1); // 0 for "none"
                                sprintf(#itm, "Menu 3 : %d -> %d -> %d", rdr, xx, x);
                                mSL_log(SysLogBox, #itm);
                            );
                            ui_menu_tick(menu_Lin_SIds, -1, 0);
                        ) :
                        (zzmcl === 6) ? (
                            (rok) ? (
                                k = rcbl[its_Rdr_Bf1stChan] + 1;
                                ui_menu_tick(menu_128_0_Ids, -1, 0);
                                ui_menu_tick(menu_128_0_Ids, k, 1);
                                xx = control_jmenu(menu_128_0_Ids); // select a number
                                (xx != 0) ? (
                                    rcbl[its_Rdr_Bf1stChan] = xx - 1;
                                );
                                ui_menu_tick(menu_128_0_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 7) ? (
                            (rok) ? (
                                k = rcbl[its_Rdr_BfChanUsed];
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                                ui_menu_tick(menu_128_1_Ids, k, 1);
                                xx = control_jmenu(menu_128_1_Ids); // select a count
                                (xx != 0) ? (
                                    rcbl[its_Rdr_BfChanUsed] = xx;
                                );
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 10) ? (
                            (rok) ? (
                                k = rcbl[its_Rdr_RCell] -1;
                                ui_menu_tick(menu_XCells_Ids, -1, 0);
                                (k < 0) ? (
                                    ui_menu_tick(menu_XCells_Ids, 1, 1);
                                ) : (
                                    ui_menu_tick(menu_XCells_Ids, (k >> 8) + 2, 1);
                                    ui_menu_tick(menu_XCells_Ids, (k & 0xFF) + menu_XCells_Ids_Nums + 2, 1);
                                );
                                xx = control_jmenu(menu_XCells_Ids); // select a count
                                (xx != 0) ? (
                                    x = xx - 2;
                                    sprintf(#itm, "Menu 8 : %d -> %d -> %d", rdr, xx, x);
                                    mSL_log(SysLogBox, #itm);
                                    (x < 0) ? (
                                        rcbl[its_Rdr_RCell] = rcbl[its_Rdr_RCellT] = rcbl[its_Rdr_RCellN] = 0;
                                    ) : (
                                        (x < menu_XCells_Ids_Nums) ? (
                                            rcbl[its_Rdr_RCellT] = x;
                                        ) : (
                                            rcbl[its_Rdr_RCellN] = (x - menu_XCells_Ids_Nums) % 0xFF;
                                        );
                                        rcbl[its_Rdr_RCell] = rcbl[its_Rdr_RCellT] * 256 + rcbl[its_Rdr_RCellN] + 1;
                                    );
                                );
                                ui_menu_tick(menu_XCells_Ids, -1, 0);
                            );
                            /*
                            (rok) ? (
                                w = rcbl[its_Rdr_RCellT];
                                k = rcbl[its_Rdr_RCellT]+1;
                                ui_menu_tick(menu_Cells_Ids, k, 1);
                                xx = control_jmenu(menu_Cells_Ids);
                                (xx != 0) ? (
                                    rcbl[its_Rdr_RCellT] = ty = xx - 1;
                                    (ty === 0) ? (rcbl[its_Rdr_RCellN] = 0);
                                    rcbl[its_Rdr_RCell] = getCellIdent(rcbl[its_Rdr_RCellT], rcbl[its_Rdr_RCellN] % (w <= 4 ? 128 : 256));
                                    updateRdCellIdent(rcbl);
                                    sprintf(#itm, "Menu 10 -> %d %d %d", rcbl[its_Rdr_RCellT],
                                        rcbl[its_Rdr_RCellN], rcbl[its_Rdr_RCell]);
                                    mSL_log(SysLogBox, #itm);
                                );
                                ui_menu_tick(menu_Cells_Ids, k, 0);
                            );
                            */
                        ) :
                        (zzmcl === 11) ? (
                                w = rcbl[its_Rdr_RCellT];
                            /*
                            (rok) ? (
                                k = rcbl[its_Rdr_RCellN]+1;
                                (w <= 0) ? (
                                    rcbl[its_Rdr_RCellN] = rcbl[its_Rdr_RCell] = 0;
                                ) :
                                (w <= 4) ? (
                                    ui_menu_tick(menu_128_0_Ids, k, 1);
                                    xx = control_jmenu(menu_128_0_Ids);
                                    ui_menu_tick(menu_128_0_Ids, k, 0);
                                ) : (
                                    ui_menu_tick(menu_256_1_Ids, k, 1);
                                    xx = control_jmenu(menu_256_1_Ids);
                                    ui_menu_tick(menu_256_1_Ids, k, 0);
                                );
                                (xx != 0) ? (
                                    rcbl[its_Rdr_RCellN] = xx - 1;
                                    rcbl[its_Rdr_RCell] = getCellIdent(rcbl[its_Rdr_RCellT], rcbl[its_Rdr_RCellN]);
                                    sprintf(#itm, "Menu 11 -> %d %d %d", rcbl[its_Rdr_RCellT],
                                        rcbl[its_Rdr_RCellN], rcbl[its_Rdr_RCell]);
                                    mSL_log(SysLogBox, #itm);
                                );
                            );
                            */
                        ) :
                        (zzmcl === 12) ? (
                            (rok) ? (
                                k = RDBL[4];
                                ui_menu_tick(menu_Rdr_Speed, -1, 0);
                                ui_menu_tick(menu_Rdr_Speed, k+1, 1);
                                xx = control_jmenu(menu_Rdr_Speed);
                                (xx != 0) ? (
                                    RDBL[4] = xx - 1;
                                );
                                ui_menu_tick(menu_Rdr_Speed, -1, 0);
                            );
                        ) :
                        (zzmcl === 14) ? (
                            (rcbl != 0) ? (
                                rcbl[its_Rdr_Error] = 0;
                                //known corrections
                                rcbl[its_Rdr_Unuz1] = SECURE_BL;
                            );
                            RDBL[2] = 0;
                        ) :
                        (zzmcl === 15) ? (
                            xx = control_jmenu(menu_Rdr_Action);
                            (xx != 0) ? (
                                wrk1[0] = (rcbl === 0) ? ( RDBL[1] ) : ( rcbl[its_Rdr_Mode] );
                                Rd_Action(rdr, xx - 1, wrk1);
                            );
                        );
                        spd = (rcbl === 0) ? 1 : rcbl[its_Rdr_Speed];
                        d1 = 1/1024;
                        (zzmcl === 16) ? (
                            Rd_Set_Speed(rdr, spd - 256*d1, 1);
                        ) :
                        (zzmcl === 17) ? (
                            Rd_Set_Speed(rdr, spd - 16*d1, 1);
                        ) :
                        (zzmcl === 18) ? (
                            Rd_Set_Speed(rdr, spd - d1, 1);
                        ) :
                        (zzmcl === 19) ? (
                            (rok) ? (
                                k = rcbl[its_Rdr_LoopType];
                                ui_menu_tick(menu_Rdr_Loop, -1, 0);
                                ui_menu_tick(menu_Rdr_Loop, k+1, 1);
                                xx = control_jmenu(menu_Rdr_Loop);
                                (xx != 0) ? (
                                    rcbl[its_Rdr_LoopType] = xx - 1;
                                );
                                ui_menu_tick(menu_Rdr_Loop, -1, 0);
                            );
                        ) :
                        (zzmcl === 20) ? (
                            (rok) ? (
                                k = RDBL[6];
                                ui_menu_tick(menu_Rdr_RegLen, -1, 0);
                                ui_menu_tick(menu_Rdr_RegLen, k+1, 1);
                                xx = control_jmenu(menu_Rdr_RegLen);
                                (xx != 0) ? (
                                    RDBL[6] = xx - 1;
                                );
                                ui_menu_tick(menu_Rdr_RegLen, -1, 0);
                            );
                        ) :
                        (zzmcl === 21) ? (
                            Rd_Set_Speed(rdr, spd + d1, 1);
                        ) :
                        (zzmcl === 22) ? (
                            Rd_Set_Speed(rdr, spd + 16*d1, 1);
                        ) :
                        (zzmcl === 23) ? (
                            Rd_Set_Speed(rdr, spd + 256*d1, 1);
                        );
                    );


                    //==============================================
                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        k = (jmc & cmdCap) ? 4 : (jmc & altCap) ? 16 : 1;
                        (zzmcl === 8) ? (
                            // mute on/off
                            (rcbl[its_Rdr_StFlgs] & its_RdrFlg_mute) ? (
                                rcbl[its_Rdr_StFlgs] &= -1 ~ its_RdrFlg_mute;
                            ) : (
                                rcbl[its_Rdr_StFlgs] |= its_RdrFlg_mute;
                            );
                        );
                        (zzmcl === 9) ? (
                            // mute on/off
                            (rcbl[its_Rdr_StFlgs] & its_RdrFlg_solo) ? (
                                rcbl[its_Rdr_StFlgs] &= -1 ~ its_RdrFlg_solo;
                            ) : (
                                rcbl[its_Rdr_StFlgs] |= its_RdrFlg_solo;
                            );
                        ) :
                        (zzmcl === 14) ? (
                            rcbl[its_Rdr_Check] = 0; //this will check for errors in reading
                        );
                        (jmc & shfCap) ? (
                            // Left clic with "shift"
                            spd = rcbl[its_Rdr_Speed];
                            d1 = 1/1024;
                            (zzmcl === 16) ? (
                                Rd_Set_Speed(rdr, spd - 256*d1, 1);
                            ) :
                            (zzmcl === 17) ? (
                                Rd_Set_Speed(rdr, spd - 16*d1, 1);
                            ) :
                            (zzmcl === 18) ? (
                                Rd_Set_Speed(rdr, spd - d1, 1);
                            ) :
                            (zzmcl === 19) ? (
                                x = (rcbl[its_Rdr_Status] === its_RdrStat_Ready) ? its_RdrStat_Reading : its_RdrStat_Ready;
                                Rd_Set_Status(rdr, x);
                            ) :
                            (zzmcl === 20) ? (
                                Rd_Set_Status(rdr, its_RdrStat_Paused);
                            ) :
                            (zzmcl === 21) ? (
                                Rd_Set_Speed(rdr, spd + d1, 1);
                            ) :
                            (zzmcl === 22) ? (
                                Rd_Set_Speed(rdr, spd + 16*d1, 1);
                            ) :
                            (zzmcl === 23) ? (
                                Rd_Set_Speed(rdr, spd + 256*d1, 1);
                            );
                        ) : (
                            // Left clic
                            (zzmcl === 16) ? (
                                Rd_Set_Speed(rdr, -3 / k, 1);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 17) ? (
                                Rd_Set_Speed(rdr, -2 / k, 1);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 18) ? (
                                Rd_Set_Speed(rdr, -1 / k, 1);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 19) ? (
                                rcbl[its_Rdr_LoopType] = (rcbl[its_Rdr_LoopType] + 1) % its_RdrLoopTypeCnt;
                            ) :
                            (zzmcl === 20) ? (
                                x = (rcbl[its_Rdr_Status] === its_RdrStat_Paused) ? its_RdrStat_Reading : its_RdrStat_Paused;
                                Rd_Set_Status(rdr, x);
                            ) :
                            (zzmcl === 21) ? (
                                Rd_Set_Speed(rdr, 1 / k, 1);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 22) ? (
                                Rd_Set_Speed(rdr, 2 / k, 1);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 23) ? (
                                Rd_Set_Speed(rdr, 3 / k, 1);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            );
                        );
                        (zzmcl === 14) ? (
                            (rcbl != 0) ? (
                                rcbl[its_Rdr_Error] = 0;
                            );
                            RDBL[2] = 0;
                        );
                    );


                    //==============================================
                    (zz & ui_jpad_ev_key) ? (
                            sprintf(#itm, "PAD -> %d %d %d %d %d", zz, zzch, zzent, zzmcl, zzmmd);
                            mSL_log(SysLogBox, #itm);
                        (zzch === 'r') ? (
                            // toggle run/pause state
                            Rd_Set_Status(rdr, -1);
                        ) :
                        (zzch === 't') ? (
                            RDBL[6] = (RDBL[6] + 1) % 3;
                        ) : (
                            uix_latestchar = zzch; // do not use this key
                        );
                    );
                    /*
                    (zzmi) ? (
                        u_ch = do_GenericKeyRead();
                        (u_ch != 0) ? (
                            sprintf(#gfx_uc, "Keyed: '%c' [%d]", u_ch, kcnt); kcnt+= 1;
                            // mSL_log(SysLogBox, #gfx_uc);
                            rdupdt = 1;
                        );
                    );
                    */
                );

            ui_pop();

            rok ? (
                // Displayed only when reader is defined

                // Sliders
                ui_split_top(h2);
                    zzmx = ui_hover();
                    ui_pad(1,3,1,0);


                    // Play volume
                    rp = rcbl[its_Rdr_RegPosSec]; // region position
                    clen =  smp2sec(rcbl[its_Rdr_SmplCnt]); // clip length in seconds
                    mvl =

                    paramValues[p_playVol] = zi = rcbl[its_Rdr_OutVoldB];
                    r = parCtl(p_playVol);
                    (r != 0) ? (
                        sprintf(#itm, "Vol -> %d %.3f", r, parV(p_playVol));
                        mSL_log(SysLogBox, #itm);
                        (r === 8) ? (
                            // right clic to reset
                            rcbl[its_Rdr_OutVoldB] = 0;
                            rcbl[its_Rdr_OutVol] = 1;
                        ) : (
                            (paramValues[p_playVol] !== zi) ? (
                                rcbl[its_Rdr_OutVoldB] = zi = paramValues[p_playVol];
                                rcbl[its_Rdr_OutVol] = (zi <= -120) ? 0 : 10^(zi/20);
                            );
                        );
                        rdupdt = 1;
                    );

                    // Play speed
                    k = RDBL[4];
                    (k === 0) ? (
                        parSetPP(p_playSpeed, pp_Max, 4);
                        parSetPP(p_playSpeed, pp_Min, -4);
                        parSetPP(p_playSpeed, pp_Slope, 0);
                    ) :
                    (k === 1) ? (
                        parSetPP(p_playSpeed, pp_Max, 4);
                        parSetPP(p_playSpeed, pp_Min, 0);
                        parSetPP(p_playSpeed, pp_Slope, 3);
                    ) :
                    (k === 2) ? (
                        parSetPP(p_playSpeed, pp_Max, 1);
                        parSetPP(p_playSpeed, pp_Min, 0);
                        parSetPP(p_playSpeed, pp_Slope, 5);
                    ) :
                    (k === 3) ? (
                        parSetPP(p_playSpeed, pp_Max, 0);
                        parSetPP(p_playSpeed, pp_Min, -1);
                        parSetPP(p_playSpeed, pp_Slope, -5);
                    ) :
                    (k === 4) ? (
                        parSetPP(p_playSpeed, pp_Max, 0);
                        parSetPP(p_playSpeed, pp_Min, -4);
                        parSetPP(p_playSpeed, pp_Slope, -3);
                    ) :
                    (k === 5) ? (
                        parSetPP(p_playSpeed, pp_Max, 1);
                        parSetPP(p_playSpeed, pp_Min, -1);
                        parSetPP(p_playSpeed, pp_Slope, 0);
                    );
                    paramValues[p_playSpeed] = zi = rcbl[its_Rdr_Speed];
                    r = parCtl(p_playSpeed);
                    (r != 0) ? (
                        sprintf(#itm, "Speed -> %d %.3f", r, parV(p_playSpeed));
                        mSL_log(SysLogBox, #itm);
                        (r === 8) ? (
                            // right clic to reset
                            Rd_Set_Speed(rdr, 1, 1);
                            RDBL[4] = 0;
                        ) : (
                            (paramValues[p_playSpeed] !== zi) ? (
                                Rd_Set_Speed(rdr, paramValues[p_playSpeed], 0);
                            );
                        );
                        rdupdt = 1;
                    );


                    // Play position
                    paramValues[p_playPos] = smp2sec(max(rcbl[its_Rdr_Start], min(rcbl[its_Rdr_Last], rcbl[its_Rdr_Abspos])) - rcbl[its_Rdr_Start]);
                    k = RDBL[6];
                    (k === 0) ? (
                        parSetPP(p_playPos, pp_Min, 0);
                        parSetPP(p_playPos, pp_Max, clen);
                        parSetPP(p_playPos, pp_Step, 0.001);
                    ) :
                    (k === 1) ? (
                        parSetPP(p_playPos, pp_Min, max(0, rp - 10));
                        parSetPP(p_playPos, pp_Max, min(clen, rp + 10));
                        parSetPP(p_playPos, pp_Step, 0.00001);
                    ) :
                    (k === 2) ? (
                        parSetPP(p_playPos, pp_Min, max(0, rp - 1));
                        parSetPP(p_playPos, pp_Max, min(clen, rp + 1));
                        parSetPP(p_playPos, pp_Step, 0.000001);
                    ) : (
                        parSetPP(p_playPos, pp_Min, 0);
                        parSetPP(p_playPos, pp_Max, clen);
                        parSetPP(p_playPos, pp_Step, 0.001);
                    );
                    r = parCtl(p_playPos);
                    (r != 0) ? (
                        sprintf(#itm, "Position -> %d %.3f", r, parV(p_playPos));
                        mSL_log(SysLogBox, #itm);
                        rcbl[its_Rdr_NxtPosSec] = parV(p_playPos); // Relative, in seconds
                        /*
                        (r === 8) ? (
                            // right clic to reset
                            Rd_Set_Speed(rdr, 1, 1);
                        ) : (
                            (paramValues[p_playPos] !== zi) ? (
                                Rd_Set_Speed(rdr, paramValues[p_playPos], 0);
                            );
                        );
                        */
                        rdupdt = 1;
                    );

                    // Play low limit (seconds)
                    k = RDBL[6];
                    (k === 0) ? (
                        parSetPP(p_play_S_Low, pp_Min, 0);
                        parSetPP(p_play_S_Low, pp_Max, clen);
                        parSetPP(p_play_S_Low, pp_Step, 0.001);
                    ) :
                    (k === 1) ? (
                        parSetPP(p_play_S_Low, pp_Min, max(0, rp - 10));
                        parSetPP(p_play_S_Low, pp_Max, min(clen, rp + 10));
                        parSetPP(p_play_S_Low, pp_Step, 0.00001);
                    ) :
                    (k === 2) ? (
                        parSetPP(p_play_S_Low, pp_Min, max(0, rp - 1));
                        parSetPP(p_play_S_Low, pp_Max, min(clen, rp + 1));
                        parSetPP(p_play_S_Low, pp_Step, 0.000001);
                    );
                    paramValues[p_play_S_Low] = rcbl[its_Rdr_LowPosSec] ;
                    parSetPP(p_play_S_Low, pp_Max, clen);
                    r = parCtl(p_play_S_Low);
                    (r != 0) ? (
                        zi = parV(p_play_S_Low);
                        (zi > rcbl[its_Rdr_HighPosSec]) ? (
                            rcbl[its_Rdr_LowPosSec] = rcbl[its_Rdr_HighPosSec];
                            rcbl[its_Rdr_HighPosSec] = zi;
                        ) : (
                            rcbl[its_Rdr_LowPosSec] = zi;
                        );
                        rdupdt = 1;
                    );

                    // Play high limit (seconds)
                    k = RDBL[6];
                    (k === 0) ? (
                        parSetPP(p_play_S_High, pp_Min, 0);
                        parSetPP(p_play_S_High, pp_Max, clen);
                        parSetPP(p_play_S_High, pp_Step, 0.001);
                    ) :
                    (k === 1) ? (
                        parSetPP(p_play_S_High, pp_Min, max(0, rp - 10));
                        parSetPP(p_play_S_High, pp_Max, min(clen, rp + 10));
                        parSetPP(p_play_S_High, pp_Step, 0.00001);
                    ) :
                    (k === 2) ? (
                        parSetPP(p_play_S_High, pp_Min, max(0, rp - 1));
                        parSetPP(p_play_S_High, pp_Max, min(clen, rp + 1));
                        parSetPP(p_play_S_High, pp_Step, 0.000001);
                    );
                    paramValues[p_play_S_High] = rcbl[its_Rdr_HighPosSec];
                    parSetPP(p_play_S_High, pp_Max, clen);
                    r = parCtl(p_play_S_High);
                    (r != 0) ? (
                        zi = parV(p_play_S_High);
                        (zi < rcbl[its_Rdr_LowPosSec]) ? (
                            rcbl[its_Rdr_HighPosSec] = rcbl[its_Rdr_LowPosSec];
                            rcbl[its_Rdr_LowPosSec] = zi;
                        ) : (
                            rcbl[its_Rdr_HighPosSec] = zi;
                        );
                        rdupdt = 1;
                    );

                    // Region position (seconds)
                    k = RDBL[6];
                    (k === 0) ? (
                        parSetPP(p_play_S_Pos, pp_Min, 0);
                        parSetPP(p_play_S_Pos, pp_Max, clen);
                        parSetPP(p_play_S_Pos, pp_Step, 0.001);
                    ) :
                    (k === 1) ? (
                        parSetPP(p_play_S_Pos, pp_Min, max(0, rp - 10));
                        parSetPP(p_play_S_Pos, pp_Max, min(clen, rp + 10));
                        parSetPP(p_play_S_Pos, pp_Step, 0.00001);
                    ) :
                    (k === 2) ? (
                        parSetPP(p_play_S_Pos, pp_Min, max(0, rp - 1));
                        parSetPP(p_play_S_Pos, pp_Max, min(clen, rp + 1));
                        parSetPP(p_play_S_Pos, pp_Step, 0.000001);
                    );
                    paramValues[p_play_S_Pos] = rcbl[its_Rdr_RegPosSec];
                    parSetPP(p_play_S_Pos, pp_Max, clen);
                    r = parCtl(p_play_S_Pos);
                    (r != 0) ? (
                        rcbl[its_Rdr_RegPosSec] = parV(p_play_S_Pos);
                        rdupdt = 1;
                    );

                    // region size (seconds)
                    // Play speed
                    k = RDBL[6];
                    (k === 0) ? (
                        parSetPP(p_play_S_Len, pp_Max, clen);
                        parSetPP(p_play_S_Len, pp_Step, 0.00001);
                    ) :
                    (k === 1) ? (
                        parSetPP(p_play_S_Len, pp_Max, 10);
                        parSetPP(p_play_S_Len, pp_Step, 0.00001);
                    ) :
                    (k === 2) ? (
                        parSetPP(p_play_S_Len, pp_Max, 1);
                        parSetPP(p_play_S_Len, pp_Step, 0.000001);
                    );
                    paramValues[p_play_S_Len] = rcbl[its_Rdr_RegSizeSec];
                    r = parCtl(p_play_S_Len);
                    (r != 0) ? (
                        rcbl[its_Rdr_RegSizeSec] = parV(p_play_S_Len);
                        rdupdt = 1;
                    );

                    // cross fade time (ms)
                    paramValues[p_play_XFade] = rcbl[its_Rdr_XFade_mSec];
                    r = parCtl(p_play_XFade);
                    (r != 0) ? (
                        rcbl[its_Rdr_XFade_mSec] = parV(p_play_XFade);
                        rdupdt = 1;
                    );

                ui_pop();

            ); // rok

            (rdupdt) ? (
                rcbl[its_Rdr_StFlgs] |= its_RdrFlg_Mod;
            );

            do_ModuleKeySave();
        ui_pop();
    );
);


/*
   LDBL[0] = Line to display
   LDBL[1] = size in seconds
   LDBL[2] = channel count
*/
function show_Line_Pad(LDBL, blockId)
local (h1, h2, uix_jneed, uix_jmini, i, r, x, xx, zz, zzmi, jmc, lnr, lcbl, dfCol, zzch, zzent, zzmcl,
        zzmmd, p1, p2, nlnr)
(
    h1 = uix_jpadHeight(pad_Lin_NL); // height
    h2 = ui_jd_slidh * 1 + 4;
    uix_jneed = uix_jmini = h1+h2+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(uix_jneed);
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            lnr = LDBL[0]; // number of line to be displayed
            lcbl = Lines_Set[lnr];
            lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
                (dpa != 0) ? (
                    // audio file droped here
                    sprintf(#s, "Line::drop file : \"%s\" - %d, %d, %d", efs, msx, msy, msc);
                    mSL_log(SysLogBox, #s);
                    dpa = 0;
                    (!lok) ? (
                        p1 = p2 = -1;
                    ) : (
                        p1 = lnr; p2 = lcbl;
                    );
                    nlnr = File_Handle(efs, p1, p2);
                    (nlnr >= 0) ? (
                        lnr = LDBL[0] = nlnr;
                        lcbl = Lines_Set[lnr];
                        lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
                    );
                );
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Lin_Labs, pad_Lin_Siz);
                jmc = ui_jmouse_cap;

                CL1 = Color_Medium_Spring_Green;
                (lcbl === 0) ? (
                    // Line undefined
                    dfCol = Col_Inactive;
                    i = 0; loop(pad_Lin_Siz,
                        pad_Lin_Colrs[i] = dfCol;
                        strcpy(pad_Lin_Labs[i],"");
                        i += 1;
                    );
                    strcpy(pad_Lin_Labs[1],menu_Lin_Status_N[0]);
                    sprintf(pad_Lin_Labs[2], "Length %.3f s", LDBL[1]);
                    sprintf(pad_Lin_Labs[3], "%d spls.", floor(LDBL[1]*srate));
                    sprintf(pad_Lin_Labs[4], "%d chan.", LDBL[2]);
                ) : (
                    // Line existing
                    dfCol = Color_Limegreen;
                    i = 0; loop(pad_Lin_Siz,
                        pad_Lin_Colrs[i] = dfCol;
                        strcpy(pad_Lin_Labs[i],"");
                        i += 1;
                    );
                    strcpy(pad_Lin_Labs[1],menu_Lin_Status_N[lcbl[its_Lin_Status]]);
                    sprintf(pad_Lin_Labs[2], "%.3f s", lcbl[its_Lin_SmplCntSec]);
                    sprintf(pad_Lin_Labs[3], "%d spls", lcbl[its_Lin_SmplCnt]);
                    sprintf(pad_Lin_Labs[4], "%d chan.", lcbl[its_Lin_ChCnt]);
                    sprintf(pad_Lin_Labs[5], "F. %d Hz", lcbl[its_Lin_RecFreq]);
                );
                sprintf(pad_Lin_Labs[0],"Line %d", lnr+1);
                strcpy(pad_Lin_Labs[7],"Action");

                zz = control_jpad(pad_Line);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzch = pad_Line[ui_jpad_lkey];
                    zzent = pad_Line[ui_jpad_entkey]-1;
                    zzmcl = pad_Line[ui_jpad_last]-1;
                    zzmmd = pad_Line[ui_jpad_lmods];

                    (zz & ui_jpad_ev_rmc) ? (  // right mouse clic
                        (zzmcl === 0) ? (
                            k = lnr+1;
                            ui_menu_tick(menu_Lin_Ids, k, 1);
                            xx = control_jmenu(menu_Lin_Ids);
                            sprintf(#itm, "Menu 0 -> %d", xx);
                            mSL_log(SysLogBox, #itm);
                            (xx != 0) ? (
                                LDBL[0] = xx - 1; // select a new line to display
                            );
                            ui_menu_tick(menu_Lin_Ids, -1, 0);
                        ) :
                        (zzmcl === 1) ? (
                            (lcbl === 0) ? (
                                ui_menu_tick(menu_Lin_Status, 1, 1);
                                xx = control_jmenu(menu_Lin_Status);
                                sprintf(#itm, "Menu 1 -> %d", xx);
                                mSL_log(SysLogBox, #itm);
                                (xx != 0) ? (
                                    (xx === 2) ? (
                                        // create the line
                                        Ln_Make(lnr, srate, LDBL[1], LDBL[2]);
                                    );
                                );
                                ui_menu_tick(menu_Lin_Status, -1, 0);
                            );
                        ) :
                        (zzmcl === 4) ? (
                            (lcbl === 0) ? (
                                k = max(1,LDBL[2]);
                                ui_menu_tick(menu_128_1_Ids, k, 1);
                                xx = control_jmenu(menu_128_1_Ids);
                                sprintf(#itm, "Menu 4 -> %d", xx);
                                mSL_log(SysLogBox, #itm);
                                (xx != 0) ? (
                                    LDBL[2] = xx ; // actual channel count
                                );
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 7) ? (
                            xx = control_jmenu(menu_Lin_Action);
                            (xx != 0) ? (
                                Ln_Action(lnr, xx - 1, LDBL);
                            );
                        );
                    );
                    wrupdt = 1;
                );

            ui_pop();

            // Sliders
            ui_split_top(h2);
                zzmx = ui_hover();
                ui_pad(1,3,1,0);
                paramValues[p_lineSize] = zi = (lcbl === 0) ? LDBL[1] : lcbl[its_Lin_SmplCntSec];
                r = parCtl(p_lineSize);
                (r != 0) ? (
                    sprintf(#itm, "Size -> %d %.3f", r, parV(p_lineSize));
                    mSL_log(SysLogBox, #itm);
                    (r === 8) ? (
                        // right clic to reset
                        paramValues[p_lineSize] = 1;
                    );
                    (paramValues[p_lineSize] !== zi) ? (
                        (lcbl === 0) ? (
                            x = paramValues[p_lineSize];
                            LDBL[1] = (jmc & shfCap) ? floor(0.5 + x) : x; // on peut modifier
                        );
                    );
                    wrupdt = 1;
                );
            ui_pop();

            do_ModuleKeySave();
        ui_pop();
    );
);


/*
   RDBL[0] = effect to display
   RDBL[1] = effect type
   RDBL[2] = effect class
   RDBL[3] = effect height
   RDBL[4] = Speed display option
   RDBL[5] = Neded sliders count
   RDBL[6] = region length size option
   RDBL[7] = region length option
*/
function show_Effect_Pad(RDBL, blockId)
local ()
(
    h1 = uix_jpadHeight(RDBL[3] = max(1, RDBL[3])); // height depending on effect
    h2 = (RDBL[5] > 0) ? ui_jd_slidh * RDBL[5] + 3 : 0;
    uix_jneed = uix_jmini = h1+h2+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(uix_jneed);
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
                (dpa != 0) ? (
                    // audio file droped here
                    sprintf(#s, "Effect::drop file : \"%s\" - %d, %d, %d", efs, msx, msy, msc);
                    mSL_log(SysLogBox, #s);
                    dpa = 0;
                );
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            rdr = RDBL[0]; // number of effect to be displayed
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Efx_Labs, pad_Rdr_Siz);

                rcbl = Effects_set[rdr];
                rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_effx);
                CL1 = Color_Cornflower_Blue;

                (rok) ? (
                    dfCol = Col_InfoA ;
                    i = 0; loop(pad_Efx_Siz,
                        pad_Efx_Colrs[i] = dfCol;
                        strcpy(pad_Efx_Labs[i],"");
                        i += 1;);
                ) : (
                    dfCol = Col_Inactive ;
                    RDBL[5] = 0;
                    i = 0; loop(pad_Efx_Siz,
                        pad_Efx_Colrs[i] = dfCol;
                        strcpy(pad_Efx_Labs[i],"");
                        i += 1;);
                );
                sprintf(pad_Efx_Labs[0],"Effect %d", rdr+1);
                zz = control_jpad(pad_Effect, RDBL[3], -1, 1);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzch = pad_Effect[ui_jpad_lkey];
                    zzent = pad_Effect[ui_jpad_entkey]-1;
                    zzmcl = pad_Effect[ui_jpad_last]-1;
                    zzmmd = pad_Effect[ui_jpad_lmods];
                );
            ui_pop();

            do_ModuleKeySave();
        ui_pop();
    );
);

flagpr = 1;
function show_UserModule(module)
local(umid, chk, i, statn, recomp, modInst, modSrc, ucod, uent, err)
(
    // module is a module number
    // Lets check the existence of the object
    modInst = err = recomp = 0;
    umid = module - blockUsrFirst; // user module. number, in 0 .. 31
    statn = blockUsrNum[umid]; // inverse reference number : from umid (dyn. computed) to statn (static number)
    modSrc = blockUsrRefs[statn]; // Memory address of the module prototype
    (chk = (mSL_bl_check(modSrc, 'umod') && mSL_bl_check(modSrc[ubx_mref], 'umod'))) ? (
        ucod = 0x10000 | (PanIdt << 8) | umid; // internal code for the module in this position
        uent = -1; // entry number of the module if it exists
        i = 0;
        while ((uent === -1) && (i < dcbUXRefsSiz)) (
            (blockUsrCode[i] === ucod) ? (uent = i; modInst = blockUsrDesc[i]);
            i += 1;
        );
        (uent === -1) ? (
            i = 0;
            while ((blockUsrCode[i] != 0) && (i < dcbUXRefsSiz)) ( i+= 1; );
            (i < dcbUXRefsSiz) ? (
                uent = i;
                modInst = blockUsrDesc[i] = mSL_bl_Dup(modSrc);
                blockUsrCode[i] = ucod;
                // (FlagsTbVals[Flgs_Umods] & 1) ? (
                    sprintf(#u, "Creating umod %x at %d from %d", ucod, modInst, modSrc);
                    mSL_log(SysLogBox, #u);
                // );
            );
        );
        // Now, modInst is the instance in this position of the module prototype
        chk = mSL_bl_check(modInst, 'umod');
    );

    (chk) ? (
        thrd = modInst[ubx_thread];
        chk = ((thrd[-2] === mSL_THR_KeyStrt) && (thrd[mSL_THR_UTId] === modInst[ubx_thrdid]));
    );

    (chk) ? (
        ut = user_top = ui_top();
        ul = user_left = ui_left();
        uw = user_width = ui_width();
        uh = user_height = ui_height(); // total available height
        // Are our computations still valid ?
        (ui_Resized || (modInst[ubx_flgs] & 1) || (user_top !== modInst[ubx_t]) || (user_left !== modInst[ubx_l]) ||
            (user_width !== modInst[ubx_w])) ? (    //  || (user_height < modInst[ubx_h])
            // Recompute positions off all fields
            recomp = 1;
            modInst[ubx_flgs] &= 0x7ffffffe;
            rptb = ubx_isiz; ptbl = modInst[-1];
            modInst[ubx_t] = user_top;
            modInst[ubx_l] = user_left;
            modInst[ubx_w] = user_width;
            modInst[ubx_h] = ui_jd_ctgr;
            // Compute internal needed height
            //sprintf(#u, "Recomputing umod %x positions", ucod);
            // mSL_log(SysLogBox, #u);
            state = 1; // start in state 1
            prvstk = ptstk = 0; stack = wa256;
            // AWA! Almost Working Algorithm
            uh = 0;
            while (state != 0) (
                (state === 1) ? (
                    // Push the umod infos
                    stack[0] = -1;
                    ptstk += stk_isiz;
                    stack[ptstk+stk_btyp] = 'umod';
                    stack[ptstk+stk_cbx] = 0;
                    stack[ptstk+stk_rtsk] = 0; // return stack
                    stack[ptstk+stk_rtst] = 0; // return state
                    stack[ptstk+stk_mode] = 0; // work mode = vertical
                    stack[ptstk+stk_h] = 0;
                    stack[ptstk+stk_i] = 0;
                    stack[ptstk+stk_b] = ubx_isiz; // first box in the sequence of siblings
                    state = 2; // goto state 2
                ) :
                (state === 2) ? (
                    anc = stack[ptstk+stk_cbx]; // position ancestor
                    typanc = stack[ptstk+stk_btyp]; // type of ancestor
                    k = anc + ubx_isiz * stack[ptstk+stk_i];
                    cbxrpt = stack[ptstk + stk_b] + k; // relative pointer to current box instance
                    cbxref = modInst[cbxrpt + ubx_mref]; // reference to current box prototype
                    typtb = cbxref[ubx_ty];
                    mode = stack[ptstk+stk_mode];
                    (typtb === 'sbox') ? (
                        // Add the height of the sbox
                        modInst[cbxrpt + ubx_h] = h = cbxref[ubx_h];
                        /*
                        sprintf(#u, "   ++ sbox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]);
                        mSL_log(SysLogBox, #u);
                        */
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'ibox') ? (
                        // Add the height of the sbox
                        modInst[cbxrpt + ubx_h] = h = cbxref[ubx_h];
                        /*
                        sprintf(#u, "   ++ ibox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]);
                        mSL_log(SysLogBox, #u);
                        */
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'tbox') ? (
                        // Get the size with the text wrap function
                        // cbxref is the ref to the text box
                        txt = cbxref[ubx_isiz]; // the text string
                        // evaluate the height
                        modInst[cbxrpt + ubx_h] = (h = ui_wraptext_height(txt));
                        // sprintf(#u, "   ++ tbox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]); mSL_log(SysLogBox, #u);
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'vbox') ? (
                        // A vertical box
                        // Push this box
                        prvstk = ptstk;
                        ptstk += stk_isiz;
                        stack[ptstk+stk_btyp] = typtb;
                        stack[ptstk+stk_cbx] = k;
                        stack[ptstk+stk_rtsk] = prvstk; // return stack
                        stack[ptstk+stk_rtst] = 2; // return state
                        stack[ptstk+stk_mode] = 0; // work mode = vertical
                        stack[ptstk+stk_h] = 0; // height so far
                        stack[ptstk+stk_i] = 0; // index in descendants
                        stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first box in the sequence of siblings
                        state = 2; // goto state 2
                    ) :
                    (typtb === 'hbox') ? (
                        // An horizontal box
                        // Push this box
                        prvstk = ptstk;
                        ptstk += stk_isiz;
                        stack[ptstk+stk_btyp] = typtb;
                        stack[ptstk+stk_cbx] = k;
                        stack[ptstk+stk_rtsk] = prvstk; // return stack
                        stack[ptstk+stk_rtst] = 2; // return state
                        stack[ptstk+stk_mode] = 1; // work mode = horizontal
                        stack[ptstk+stk_h] = 0; // height so far
                        stack[ptstk+stk_i] = 0; // index in descendants
                        stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first box in the sequence of siblings
                        state = 2; // goto state 2
                    ) :
                    (
                        err = 0871;
                        state = 0;
                    );
                    //== Skip to next sibling
                    i = (stack[ptstk+stk_i] += 1); // number of next sibling
                    (i >= modInst[anc + ubx_lcnt]) ? (
                        // return to previous state
                        state = stack[ptstk+stk_rtst]; // return state
                        ptstk = stack[ptstk+stk_rtsk]; // return stack
                    );
                ) :
                (
                    err = 0870;
                    state = 0;
                );
            );
            modInst[ubx_h] = stack[stk_isiz+stk_h] + ui_jd_ctgr; // computed height
        );

        uix_jneed = uix_jmini = modInst[ubx_h];
        (chk && (ui_height() >= uix_jmini)) ? (
            ui_split_top(uix_jneed);
                ui_set_rect(ui_left(), ui_top(), max(ui_MinSize1Pane, min(ui_BestSize1Pane, ui_width())), ui_height());
                zzmi = ui_hover();  // true if we are "in"
                // Keep block position
                keepBlockInfos(module);
                (zzmi) ? (
                    ui_push();
                        // stack is now 2 levels deep
                        ui_color(Col_Frame);
                        ui_border(); // draws in orange
                    ui_pop();
                );
                control_group(blockDispNames[blockDispInverts[module]]);

                ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
                // Inside of the module dimensions
                ut = ui_top();
                ul = ui_left();
                uw = ui_width();
                uh = ui_height();

                // Should we recomp item sizes ?
                (recomp) ? (
                    state = 1; prvstk = ptstk = 0; stack = wa256;
                    rptb = ubx_isiz; ptbl = modInst[-1];
                    while (state != 0) (
                        (state === 1) ? (
                            // Push the umod infos
                            stack[0] = -1;
                            ptstk += stk_isiz;
                            stack[ptstk+stk_btyp] = 'umod';
                            stack[ptstk+stk_cbx] = 0; // position of the box in the umod
                            stack[ptstk+stk_rtsk] = 0; // return stack
                            stack[ptstk+stk_rtst] = 0; // return state
                            stack[ptstk+stk_h] = uh;
                            stack[ptstk+stk_w] = uw;
                            stack[ptstk+stk_l] = ul;
                            stack[ptstk+stk_t] = ut;
                            stack[ptstk+stk_i] = 0;
                            stack[ptstk+stk_b] = ubx_isiz; // first box in the sequence of siblings
                            state = 2; // goto state 2
                        ) :
                        (state === 2) ? (
                            anc = stack[ptstk+stk_cbx]; // position ancestor
                            typanc = stack[ptstk+stk_btyp]; // type of ancestor
                            k = anc + ubx_isiz * stack[ptstk+stk_i];
                            cbxrpt = stack[ptstk + stk_b] + k; // relative pointer to current box instance
                            cbxref = modInst[cbxrpt + ubx_mref]; // reference to current box prototype
                            typtb = cbxref[ubx_ty];
                            (typtb === 'sbox') ? (
                                // Set the size of the rectangle for the 'sbox'
                                h = cbxref[ubx_h]; // height - already computed
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ sbox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'ibox') ? (
                                h = cbxref[ubx_h]; // height - already computed
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                w = min(stack[ptstk+stk_w], cbxref[ubx_maxw]);
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ ibox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'tbox') ? (
                                // recheck the size of the text
                                txt = cbxref[ubx_isiz]; // the text string
                                // re-evaluate the height
                                modInst[cbxrpt + ubx_h] = (h = ui_wraptext_height(txt));
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ tbox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'vbox') ? (
                                // A vertical box
                                prvstk = ptstk;
                                // Push this box
                                prvstk = ptstk;
                                ptstk += stk_isiz;
                                stack[ptstk+stk_btyp] = typtb;
                                stack[ptstk+stk_cbx] = k;
                                stack[ptstk+stk_rtsk] = prvstk; // return stack
                                stack[ptstk+stk_rtst] = 2; // return state
                                stack[ptstk+stk_l] = stack[ptstk+stk_l]; // left from ancestor
                                stack[ptstk+stk_t] = stack[ptstk+stk_t]; // top from ancestor
                                stack[ptstk+stk_w] = stack[ptstk+stk_w]; // width from ancestor
                                stack[ptstk+stk_h] = h = cbxref[ubx_h]; // height - already computed;
                                stack[ptstk+stk_i] = 0; // index in descendants
                                stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first sibling
                                state = 2; // goto state 2
                            ) :
                            (
                                err = 0881;
                                state = 0;
                            );
                            //== Skip to next sibling
                            i = (stack[ptstk+stk_i] += 1); // number of next sibling
                            (i >= modInst[anc + ubx_lcnt]) ? (
                                // return to previous state
                                state = stack[ptstk+stk_rtst]; // return state
                                ptstk = stack[ptstk+stk_rtsk]; // return stack
                            );
                        ) :
                        (
                            err = 0880;
                            state = 0;
                        );
                    );


                    (FlagsTbVals[Flgs_Umods] & 2) ? (
                sprintf(#u, "User Block %x : %d / %d / %d / %d / %d => %d [t:%d  l:%d  w:%d  h:%d]  =>  [%d  %d  %d  %d]",
                ucod, module, umid, statn, blockUsrChecks[statn], blockUsrRefs[statn], modInst, user_top, user_left, user_width,
                user_height, ut, ul, uw, uh); mSL_log(SysLogBox, #u);
                    );

                );
                // ui_text(#u);


                // (Finally !) Let's put out items...
                rptb = ubx_isiz; ptbl = modInst[-1];
                while (rptb < ptbl) (
                    crptb = rptb;
                    (modInst[rptb + ubx_flgs] & ubx_final) ? (
                        ty = modInst[rptb + ubx_ty];
                        (ty === 'sbox') ? (
                            // position the rectangle for all sliders
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            //ui_pad(0,2,1,0);
                            ui_pcolor(ui_jcolor_text);
                            // Put the various sliders
                            addb = modInst[rptb + ubx_mref] + modInst[rptb + ubx_lcnt];
                            rcnt = addb[ubx_icnt]; // number of references
                            (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                sprintf(#u, "Slider box: %d -- %d refs.", addb, rcnt); mSL_log(SysLogBox, #u);
                            );
                            i = 0;
                            while (rcnt > 0) (
                                adds = addb[ubx_isiz+i]; // final "slider" address
                                pnum = adds[1]; // its parameter number
                                (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                    sprintf(#u, "Slider %d in [%d %d %d %d]  %d / %d / %d", pnum,
                                        ui_top(), ui_left(), ui_width(), ui_height(), i, rcnt, adds);
                                        mSL_log(SysLogBox, #u);
                                );
                                flgm = parCtl(pnum);
                                i += 1; rcnt -= 1;
                            );
                        ) :
                        (ty === 'ibox') ? (
                            // position the rectangle for the info block
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            blk = modInst[crptb + ubx_mref]; // ref to the info box
                            cnt = blk[ubx_isiz]; // parameter count
                            thrd = modInst[ubx_thread];
                            (recomp) ? (
                                sprintf(#u, "Info box: %d thrd: %d -- %d pars.", blk, thrd, cnt);
                                mSL_log(SysLogBox, #u);
                            );
                            wa = wa128; memset(wa, 0, 32);
                            i = 0; loop(cnt,
                                k = blk[ubx_isiz+i+1]; // next parameter
                                ((k >= mSL_Sym_Low) && (k <= mSL_Sym_High)) ? (k = mSL_idt_addr(thrd, k));
                                wa[i+16] = k; // keep address
                                (!mSL_isString(k)) ? ((k >= 0) ? (k = k[0]) : (k = gmem[-k]));
                                wa[i] = k; i += 1;
                            );
                            (recomp) ? (
                                sprintf(#u, "Info [%d/%d  %d/%d  %d/%d  %d/%d  %d/%d  %d/%d]",
                                            wa[16+0], wa[0], wa[16+1], wa[1], wa[16+2], wa[2],
                                            wa[16+3], wa[3], wa[16+4], wa[4], wa[16+5], wa[5]);
                                mSL_log(SysLogBox, #u);
                            );
                            (cnt === 0) ? (
                                ui_show();
                            ) :
                            (cnt === 1) ? (
                                ui_show(wa[0]);
                            ) :
                            (cnt === 2) ? (
                                ui_show(wa[0], wa[1]);
                            ) :
                            (cnt === 3) ? (
                                ui_show(wa[0], wa[1], wa[2]);
                            ) :
                            (cnt === 4) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3]);
                            ) :
                            (cnt === 5) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3], wa[4]);
                            ) :
                            (cnt === 6) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3], wa[4], wa[5]);
                            ) : (
                                ui_show("Error 8793");
                            );
                        ) :
                        (ty === 'tbox') ? (
                            // position the rectangle for the text
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            blk = modInst[crptb + ubx_mref]; // ref to the text box
                            txt = blk[ubx_isiz]; // the text string
                            ui_align(0.5, 0.5);
                            reh = w3 = ui_wraptext(txt);
                            (reh != modInst[crptb + ubx_h]) ? (
                                modInst[rptb + ubx_h] = reh;
                                // we have to adjust the height
                                modInst[ubx_flgs] |= 1;
                            );
                            (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                sprintf(#u, "Text box %d in [%d %d %d %d]   %d / %d / %d", txt,
                                ui_top(), ui_left(), ui_width(), ui_height(), w1, w2, w3);
                                mSL_log(SysLogBox, #u);
                            );
                        );
                    );
                    rptb += ubx_isiz;
                );

            ui_pop();
        );
    );

    (!chk) ? (
        h1 = uix_jpadHeight(1); // A 1 line to display info
        uix_jneed = uix_jmini = h1+ui_jd_ctgr;
        (ui_height() >= uix_jmini) ? (
            ui_split_top(uix_jneed);
                ui_set_rect(ui_left(), ui_top(), max(ui_MinSize1Pane, min(ui_BestSize1Pane, ui_width())), ui_height());
                zzmi = ui_hover();  // true if we are "in
                // Keep block position
                keepBlockInfos(module);
                (zzmi) ? (
                    ui_push();
                        // stack is now 2 levels deep
                        ui_color(Col_Frame);
                        ui_border(); // draws in purple
                    ui_pop();
                );
                control_group(blockDispNames[blockDispInverts[module]]);
                statn = blockUsrNum[umid];
                ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
                sprintf(#u, "Error: User Block %d / %d / %d / %d / %d [t:%d  l:%d  w:%d  h:%d]", module, umid, statn,
                    blockUsrChecks[statn], blockUsrRefs[statn], user_top, user_left, user_width, user_height);
                ui_text(#u);
            ui_pop();
        );
    );

    (!chk) ? (
        // module doesn't exist anymore
        blockDesc[Bigx] = 0; // remove reference
        blockUsrRefs[statn] = 0;
        blockUsrNames[statn] = 0;
        blockUsrChecks[statn] = 0;
        blockUsrIds[statn] = 0;
        blockUsrNum[umid] = 0;
    );
);



function genericItemsPos(bNumb)
local(xx, xy, igb, u, v, w, m, myp, i, j, k, p, s, wst, kit)
(
    blockMouseWasIn = 0;
    PanIdt = bNumb;
    // wst = #;
    ((bNumb >=0) && (bNumb < dcbMCount) && menu_Stud_Mod) ? (
        blockDesc = dcbBlocksAll + bNumb * dcbWSize;
        (ui_hover()) ? (
            colMouseWasIn = studDispCol;
            ((KeyedT === 'rght') && (Kmouse_cap === 8)) ? (
                // try to increase colum size
                p = serialBlock + Pr7_StudRat + 4 * TabIdt;
                ((colMouseWasIn === 0) && (studDispPCnt >= 2)) ? (
                    // increase first col. size
                    k = min(20, max(0, p[1] - ui_MinSize1Pane));p[0] += k; p[1] -= k;
                ) :
                ((colMouseWasIn === 1) && (studDispPCnt === 2)) ? (
                    // increase 2nd col. size
                    k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[1] += k; p[0] -= k;
                ) :
                ((colMouseWasIn === 1) && (studDispPCnt >= 3)) ? (
                    // increase 2nd col. size
                    k = min(20, max(0, p[2] - ui_MinSize1Pane)); p[1] += k; p[2] -= k;
                ) :
                ((colMouseWasIn === 2) && (studDispPCnt === 3)) ? (
                    // increase 3nd col. size
                    k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[2] += k; p[0] -= k;
                ) :
                ((colMouseWasIn === 2) && (studDispPCnt === 4)) ? (
                    // increase 3nd col. size
                    k = min(20, max(0, p[3] - ui_MinSize1Pane)); p[2] += k; p[3] -= k;
                ) :
                ((colMouseWasIn === 3) && (studDispPCnt === 4)) ? (
                    // increase 4nd col. size
                    k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[3] += k; p[0] -= k;
                ) ;
                KeyedT = 0;
            ) :
            ((KeyedT === 'left') && (Kmouse_cap === 8)) ? (
                // try to increase colum size
                p = serialBlock + Pr7_StudRat + 4 * TabIdt;
                ((colMouseWasIn === 0) && (studDispPCnt === 4)) ? (
                    // increase first col. size
                    k = min(20, max(0, p[3] - ui_MinSize1Pane));p[0] += k; p[3] -= k;
                ) :
                ((colMouseWasIn === 0) && (studDispPCnt === 3)) ? (
                    // increase first col. size
                    k = min(20, max(0, p[2] - ui_MinSize1Pane));p[0] += k; p[2] -= k;
                ) :
                ((colMouseWasIn === 0) && (studDispPCnt === 2)) ? (
                    // increase first col. size
                    k = min(20, max(0, p[1] - ui_MinSize1Pane));p[0] += k; p[1] -= k;
                ) :
                ((colMouseWasIn === 1) && (studDispPCnt >= 2)) ? (
                    // increase first col. size
                    k = min(20, max(0, p[0] - ui_MinSize1Pane));p[1] += k; p[0] -= k;
                ) :
                ((colMouseWasIn === 2) && (studDispPCnt >= 3)) ? (
                    // increase 2nd col. size
                    k = min(20, max(0, p[1] - ui_MinSize1Pane)); p[2] += k; p[1] -= k;
                ) :
                ((colMouseWasIn === 3) && (studDispPCnt === 4)) ? (
                    // increase 2nd col. size
                    k = min(20, max(0, p[2] - ui_MinSize1Pane)); p[3] += k; p[2] -= k;
                ) ;
                KeyedT = 0;
            );
            // Update col. size
            blockMouseWasIn = blockDesc[dcbWSize - 1];
            // we may need to update the menu
            p = menu_Stud_Mod + ui_jmenu_items;
            i=0; while (i < blockMenuITC) (
                s = p[i]; // u = str_getchar(s, 2, 'cu');
                //((u === ui_jmenu_chSP) || (u === ui_jmenu_noSel))? (
                    str_setchar(s, 1, ui_jmenu_chSP);
                //);
                i += 1;
            );
            i=0; loop(dcbMSize,
                (k = blockDesc[i]) ? (
                    ((k > 0) && (k < blockDispITC)) ? (
                        j = blockDispInverts[k];
                        s = p[j]; str_setchar(s, 1, '!');
                    ) : (
                        blockDesc[i] = 0;
                    );
                );
                i += 1;
            );
            //is there a "current" block ?
            // update "clicked in"
            blockDesc[dcbWSize - 1] = 0;
            A99m = mouse_y;
            i = 0; while ((k = blockDesc[i]) != 0) (
                u = blockDesc[i+dcbMSize]; v = u/10000; u = u %10000; // the block
                ((A99m >= v) && (A99m < (u+v))) ? (
                    // clicked in the box
                    blockDesc[dcbWSize - 1] = k;
                );
                i += 1;
            );
            cModule = A99CBlock = k = blockDesc[dcbWSize - 1];
            strncpy(#Aws3, p[0], 6);
            (k != 0) ? (
                strcat(#Aws3, blockDispNames[blockDispInverts[k]]);
                str_setchar(#Aws3, 1, '!');
            ) : (
                strcat(#Aws3, "-");
            );
            strcpy(p[0], #Aws3);
            // Indicates the pane preferences
            s = p[block1Pane -1 + studDispPrf];
            str_setchar(s, 1, '!');
            0 ? (
                sprintf(#dbg_trace1, "*ZZZ* [%d]  \"%s\"  (%d)  \"%s\" ", A99CBlock, blockDispNames[blockDispInverts[A99CBlock]], p[0],#Aws3);
            );


            // ADump(blockDesc);

            xx = control_jmenu(menu_Stud_Mod);
            xx ? (
                ui_GFXdoNow |= 1;
                blockRent = xx; // entry selected (trace only)
                kit = jmenu_res2item(menu_Stud_Mod, xx);
                0 ? (
                    sprintf(#dbg_trace0, "[%d/%d] XX  %d \"%s\" %d", TabIdt, bNumb, xx, ui_menu_item(menu_Stud_Mod, xx), kit);
                    mSL_log(SysLogBox, #dbg_trace0);
                );
                // ADump(blockDesc);
                //xx2 = ui_menu_ent(menu_Stud_Mod, xx);
                //p = menu_Stud_Mod + ui_jmenu_items + xx -1; wst = p[0]; k = blockDispIdts[xx-1];
                //    #dbg_desc = #sfc;
                (kit === 0) ? (
                    (cModule > 0) ? (
                        copiedMod = cModule;
                        i = j = 0;
                        while (i < dcbMax) (
                            (cModule === blockDesc[j]) ? (  j+= 1; );
                            blockDesc[i] = blockDesc[j];
                            i += 1 ; j += 1;
                        );
                    );
                ) :
                ((kit >= blockFirst) && (kit < blockDispITC)) ? (
                    // we choose a module entry
                    p = menu_Stud_Mod + ui_jmenu_items + kit ; // correct here
                    wst = p[0]; k = blockDispIdts[kit]; // k is ok

                    (x = (str_getchar(wst, 1, 'cu') === '!')) ? (
                        // We must add the new module at the end of the list
                        i = 0; while (blockDesc[i] != 0) ( i+= 1;);
                        blockDesc[i] = e = k; d = i;
                    ) : (
                        // the module was selected. We suppress it from the list
                        i = j = 0;
                        while (j < dcbMax) (
                            (k === blockDesc[j]) ? ( d = j; e = k; j+= 1; );
                            blockDesc[i] = blockDesc[j];
                            i += 1 ; j += 1;
                        );
                    );
                    0 ? (
                        x ? (
                            sprintf(#dbg_trace1, "*ADD* [%d] %d \"%s\" p:%d  n:%d  xx:%d  B:%d", blockDesc, k, wst, d, e, xx, blockMouseWasIn);
                        ) : (
                            sprintf(#dbg_trace1, "*DEL* [%d] %d \"%s\" p:%d  x:%d  xx:%d  B:%d", blockDesc, k, wst, d, e, xx, blockMouseWasIn);
                        );
                        mSL_log(SysLogBox, #dbg_trace1);
                    );
                    // ADump(blockDesc);
                ) :
                (kit === blockTabRename) ? (
                    sprintf(#tmp, "New name for tabulation %d...", TabIdt);
                    ui_screen_open("control.prompt");
                    ui_screen_arg(0, altTabsNames[TabIdt]);
                    ui_screen_arg(1, #tmp);
                ) :
                (kit >= blockThemeDefault) ? (
                    uix_jtheme = kit - blockThemeDefault;
                ) :
                (
                    mSL_GUI_Generic(3, bNumb, cModule, kit);
                );


            );
        );


        // move bottom system log if present
        1 ? (
            i = 0; while (i < dcbMax) (
                u = blockDesc[i]; v = blockDesc[i+1];
                ((u === blockSysLog) && (v !== 0))  ? (
                    blockDesc[i] = v; blockDesc[i+1] = u;
                );
                i += 1;
            );
        );


        // Hors interaction : mise en place des blocs
        Bigx = 0; loop(dcbMSize, igb = blockDesc[Bigx];  // = DISPLAY BLOCKS =
            (igb > 0) ? (
                (igb === blockReaderA) ? (
                    show_Reader_Pad(ReadersStructA, blockReaderA);
                ) :
                (igb === blockReaderB) ? (
                    show_Reader_Pad(ReadersStructB, blockReaderB);
                ) :
                (igb === blockReaderC) ? (
                    show_Reader_Pad(ReadersStructC, blockReaderC);
                ) :
                (igb === blockReaderD) ? (
                    show_Reader_Pad(ReadersStructD, blockReaderD);
                ) :
                (igb === blockReaderE) ? (
                    show_Reader_Pad(ReadersStructE, blockReaderE);
                ) :
                (igb === blockReaderF) ? (
                    show_Reader_Pad(ReadersStructF, blockReaderF);
                ) :
                (igb === blockReaderG) ? (
                    show_Reader_Pad(ReadersStructG, blockReaderG);
                ) :
                (igb === blockReaderH) ? (
                    show_Reader_Pad(ReadersStructH, blockReaderH);
                ) :
                (igb === blockLineA) ? (
                    show_Line_Pad(LinesStructA, blockLineA);
                ) :
                (igb === blockLineB) ? (
                    show_Line_Pad(LinesStructB, blockLineB);
                ) :
                (igb === blockLineC) ? (
                    show_Line_Pad(LinesStructC, blockLineC);
                ) :
                (igb === blockLineD) ? (
                    show_Line_Pad(LinesStructD, blockLineD);
                ) :
                (igb === blockLineE) ? (
                    show_Line_Pad(LinesStructE, blockLineE);
                ) :
                (igb === blockLineF) ? (
                    show_Line_Pad(LinesStructF, blockLineF);
                ) :
                (igb === blockLineG) ? (
                    show_Line_Pad(LinesStructG, blockLineG);
                ) :
                (igb === blockLineH) ? (
                    show_Line_Pad(LinesStructH, blockLineH);
                ) :
                (igb === blockEffectA) ? (
                    show_Effect_Pad(EffectsStructA, blockEffectA);
                ) :
                (igb === blockEffectB) ? (
                    show_Effect_Pad(EffectsStructB, blockEffectB);
                ) :
                (igb === blockEffectC) ? (
                    show_Effect_Pad(EffectsStructC, blockEffectC);
                ) :
                (igb === blockEffectD) ? (
                    show_Effect_Pad(EffectsStructD, blockEffectD);
                ) :
                (igb === blockMemory1) ? (
                    show_Memory(memoryBox1);
                ) :
                (igb === blockMemory2) ? (
                    show_Memory(memoryBox2);
                ) :
                (igb === blockSysLog) ? (
                    show_SysLog(blockSysLog, SysLogBox);
                ) :
                ((igb >= blockUsrFirst) && (igb <= blockUsrLast)) && (blockUsrChecks[blockUsrNum[igb - blockUsrFirst]]) ? (
                    show_UserModule(igb);
                );
            );
            Bigx += 1;
        );


    );
    blockDesc = 0;
    studDispCol += 1;
);


function genericTabSet(tbNum)
local (ww, t)
(
    do_GenericTabStart();
    //colMouseWasIn = -1;
    BankLink = 1;
    TabIdt = max(0, min(7, 0|tbNum));
    studDispPrf = studDispPCnt = max(1, min(4, 0|(serialBlock[Pr7_StudConf+TabIdt])));

    ww = gfx_w / ui_retina();


    (studDispPCnt === 4) ? (
        (ww < ui_MinSize4Panes) ? studDispPCnt = 3;
    );
    (studDispPCnt === 3) ? (
        (ww < ui_MinSize3Panes) ? studDispPCnt = 2;
    );
    (studDispPCnt === 2) ? (
        (ww < ui_MinSize2Panes) ? studDispPCnt = 1;
    );
    /*
    (studDispPCnt === 1) ? (
        (ww > ui_MaxSize1Pane) ? studDispPCnt = 2;
    );
    */

    studDispCol = 0;
    p = serialBlock + Pr7_StudRat + 4 * TabIdt;
    (studDispPCnt === 4)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1] + p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
        ui_split_leftratio(max(1, p[1])/max(1, p[1] + p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
        ui_pop();
        ui_split_leftratio(max(1, p[2])/max(1, p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax + 2);
        ui_pop();
            genericItemsPos(TabIdt * dcbPannelsMax + 3);
    ) :
    (studDispPCnt === 3)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1] + p[2]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
        ui_split_leftratio(max(1, p[1])/max(1, p[1] + p[2]));
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
        ui_pop();
        //ui_split_leftratio(1);
            genericItemsPos(TabIdt * dcbPannelsMax + 2);
        //ui_pop();
    ) :
    (studDispPCnt === 2)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
    ) : (
        genericItemsPos(TabIdt * dcbPannelsMax);
    );
    do_GenericTabEnd();
);



//====== GRAPHIC EXECUTION START ======

(gui_show_UI) ? (
    must_do_gfx() ? (

        gfx_executed += 1; // just a trace
        // do here the graphic stuff...

        do_gfx_init ? (
            do_gfx_init = 0; // perform only once
            uix_default_fontsize = ui_jdefault_fontsize;
            // uix_default_fontface = "Verdana";
            // uix_default_fontface = "Times";
            // uix_default_fontface = "Futura";
            uix_default_fontface = ui_jdefault_fontface;
        );

        update_theme();

        currScreen = ui_screen();
        ui_Xtime_period = 1; // refresh screen every second


        ui_font();

        my_menu_bar(uix_jG_menuscr);



        //SCREENS

        ui_screen() === "Main" ? (
            /*
            show_local_Infos();

            gui_show_syslog ? show_SysLog(0, SysLogBox);
            gui_show_memory ? (
                (gfx_w > gfx_colM_width) ? (
                    ui_split_leftratio(0.5);
                    show_Memory(memoryBox1);
                    ui_pop();
                );
                show_Memory(memoryBox2);
            );
            */
            genericTabSet(0);
        ) :

        ui_screen() === "Logs" ? (
            /*
            SysLogBox[4] = 80;
            show_SysLog(0, SysLogBox);
            (gfx_w > gfx_colM_width) ? (
                ui_split_leftratio(0.5);
                show_Memory(memoryBox1);
                ui_pop();
            );
            show_Memory(memoryBox2);
            */
            genericTabSet(1);
        ) :

        ui_screen() === "Dump" ? (
            /*
            memoryBox1[17] = memoryBox2[17] = 96;
            (gfx_w > gfx_colM_width) ? (
                ui_split_leftratio(0.5);
                show_Memory(memoryBox1);
                ui_pop();
            );
            show_Memory(memoryBox2);
            */
            genericTabSet(2);
        ) :

        ui_screen() === "Settings" ? (
            genericTabSet(3);
        ) :

        ui_screen() === "Live 1" ? (
            genericTabSet(4);
        ) :

        ui_screen() === "Live 2" ? (
            genericTabSet(5);
        ) :

        ui_screen() === "Live 3" ? (
            genericTabSet(6);
        ) :

        ui_screen() === "Live 4" ? (
            genericTabSet(7);
        ) :

        //SCREEN--DEFAULT
        (
        ui_GFXdoNow |= 3;
        do_GenericTabStart();
            control_system();
        do_GenericTabEnd();
        );

    );
) : (
    // Clear screen

    // Minimalist work
    gfx_clear = 0xeeeeee; // light grey background color identical to sliders background
    gfx_x = gfx_y = 0;
    gfx_setpixel(0xee,0xee,0xee);
);

uix_latestchar = 0;
