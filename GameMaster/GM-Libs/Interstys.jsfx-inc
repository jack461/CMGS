                        );
                        // mode Grains : the curve of the envelope (left clic : the next one ; Shift + clic : linear)
                        ((zzmcl === 30) && rok && (rcbl[its_Rdr_Mode] === its_RdrMode_Grains)) ? its_Gr_CrvClick(rcbl, zz, jmc & shfCap);
                        (zzmcl === 0) ? (
                            // the next reader (shift : the previous one)
                            RDBL[0] = (jmc & shfCap) ? (rdr + RD_CNT - 1) % RD_CNT : (rdr + 1) % RD_CNT;
                        );
                        // (the reader must exist : rcbl is 0 otherwise)
                        ((zzmcl === 1) && rok) ? (
                            // status : Ready or Paused -> Reading ; Reading -> Paused
                            w = rcbl[its_Rdr_Status];
                            ((w === its_RdrStat_Ready) || (w === its_RdrStat_Paused) || (w === its_RdrStat_Reading)) ? (
                                Rd_Set_Status(rdr, (w === its_RdrStat_Reading) ? its_RdrStat_Paused : its_RdrStat_Reading);
                            );
                        );
                        ((zzmcl === 8) && rok) ? (
                            // mute on/off
                            (rcbl[its_Rdr_StFlgs] & its_RdrFlg_mute) ? (
                                rcbl[its_Rdr_StFlgs] &= -1 ~ its_RdrFlg_mute;
                            ) : (
                                rcbl[its_Rdr_StFlgs] |= its_RdrFlg_mute;
                            );
                        );
                        ((zzmcl === 9) && rok) ? (
                            // solo on/off
                            (rcbl[its_Rdr_StFlgs] & its_RdrFlg_solo) ? (
                                rcbl[its_Rdr_StFlgs] &= -1 ~ its_RdrFlg_solo;
                            ) : (
                                rcbl[its_Rdr_StFlgs] |= its_RdrFlg_solo;
                            );
                        ) :
                        ((zzmcl === 10) && rok) ? (
                            ((k = its_Off_Choose(rcbl[its_Rdr_OutOff])) >= 0) ? (
                                rcbl[its_Rdr_OutOff] = k;
                                rcbl[its_Rdr_Check] = 0;
                            );
                        ) :
                        ((zzmcl === 11) && rok) ? (
                            rcbl[its_Rdr_OutCnt] = 0; // the count of output channels : the count of channels used
                            rcbl[its_Rdr_Check] = 0;
                        ) :
                        ((zzmcl === 14) && rok) ? (
                            rcbl[its_Rdr_Check] = 0; //this will check for errors in reading
                        );
                        (jmc & shfCap) ? (
                            // Left clic with "shift"
                            spd = its_Rd_Dir(rcbl);
                            d1 = 1/1024;
                            (zzmcl === 16) ? (
                                its_Rd_SetDir(rdr, spd - 256*d1);
                            ) :
                            (zzmcl === 17) ? (
                                its_Rd_SetDir(rdr, spd - 16*d1);
                            ) :
                            (zzmcl === 18) ? (
                                its_Rd_SetDir(rdr, spd - d1);
                            ) :
                            (zzmcl === 19) ? (
                                x = (rcbl[its_Rdr_Status] === its_RdrStat_Ready) ? its_RdrStat_Reading : its_RdrStat_Ready;
                                Rd_Set_Status(rdr, x);
                            ) :
                            (zzmcl === 20) ? (
                                Rd_Set_Status(rdr, its_RdrStat_Paused);
                            ) :
                            (zzmcl === 21) ? (
                                its_Rd_SetDir(rdr, spd + d1);
                            ) :
                            (zzmcl === 22) ? (
                                its_Rd_SetDir(rdr, spd + 16*d1);
                            ) :
                            (zzmcl === 23) ? (
                                its_Rd_SetDir(rdr, spd + 256*d1);
                            );
                        ) : (
                            // Left clic
                            (zzmcl === 16) ? (
                                its_Rd_SetDir(rdr, -3 / k);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 17) ? (
                                its_Rd_SetDir(rdr, -2 / k);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 18) ? (
                                its_Rd_SetDir(rdr, -1 / k);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 19) ? (
                                rcbl[its_Rdr_LoopType] = (rcbl[its_Rdr_LoopType] + 1) % its_RdrLoopTypeCnt;
                            ) :
                            (zzmcl === 20) ? (
                                x = (rcbl[its_Rdr_Status] === its_RdrStat_Paused) ? its_RdrStat_Reading : its_RdrStat_Paused;
                                Rd_Set_Status(rdr, x);
                            ) :
                            (zzmcl === 21) ? (
                                its_Rd_SetDir(rdr, 1 / k);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 22) ? (
                                its_Rd_SetDir(rdr, 2 / k);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            ) :
                            (zzmcl === 23) ? (
                                its_Rd_SetDir(rdr, 3 / k);
                                Rd_Set_Status(rdr, its_RdrStat_Reading);
                            );
                        );
                        (zzmcl === 14) ? (
                            (rcbl != 0) ? (
                                rcbl[its_Rdr_Error] = 0;
                            );
                            RDBL[2] = 0;
                        );
                    );


                    //==============================================
                    (zz & ui_jpad_ev_key) ? (
                        GM_key_take('r') ? (
                            // toggle run/pause state
                            Rd_Set_Status(rdr, -1);
                        ) :
                        GM_key_take('t') ? (
                            RDBL[6] = (RDBL[6] + 1) % 3;
                        ); // (the other keys are left to the next levels)
                    );
                    /*
                    (zzmi) ? (
                        u_ch = do_GenericKeyRead();
                        (u_ch != 0) ? (
                            sprintf(#gfx_uc, "Keyed: '%c' [%d]", u_ch, kcnt); kcnt+= 1;
                            // mSL_log(SysLogBox, #gfx_uc);
                            rdupdt = 1;
                        );
                    );
                    */
                );

            ui_pop();

            // the modulation inputs (the pad may have deleted the reader)
            rcbl = Readers_set[rdr];
            rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
            (rok && (h4 > 0)) ? (
                ui_split_top(h4);
                    ui_pad(1,2,2,2);
                    its_ModK_Rdr[0] = its_Rd_OffKind(rcbl[its_Rdr_Mode]); // (the actions of the offset : by mode)
                    its_Mod_Row(rcbl + its_Rdr_Mod1, its_Rdr_ModN, its_ModN_Rdr, its_Rdr_ModOk(rcbl), its_ModD_Rdr, its_ModK_Rdr) ?
                        (rcbl[its_Rdr_Check] = 0);
                ui_pop();
            );
            // their sliders : the depths of the inputs used, their attenuverters if shown
            (rok && (h5 > 0)) ? (
                ui_split_top(h5);
                    ui_pad(1,3,1,0);
                    its_Mod_Sliders(rcbl + its_Rdr_Mod1, its_Rdr_ModN, its_Rdr_ModOk(rcbl), p_rdModDepth1, p_rdModAtt1,
                        its_ModN_Rdr, its_ModK_Rdr);
                ui_pop();
            );

            // Waveform of the channels read (see its_wave_reader and mSL_ui_audio.jsfx-inc)
            (rok && (h3 > 0)) ? (
                lcbl = rcbl[its_Rdr_Lcbl];
                w = min(h3, ui_height() - h2); // the sliders keep their place
                (((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) && (w >= its_RdrWaveMin)) ? (
                    ui_split_top(w);
                        ui_pad(1,2,1,2);
                        its_wave_reader(lcbl, rcbl, rdr, RDBL[9], its_Wave_Flags(RDBL + 10));
                    ui_pop();
                );
            );

            rok ? (
                // Displayed only when reader is defined
                // (its loop moved by hand : while the left button is down, see its_Rd_HandMove)
                (its_WvNoCatch === rcbl) ? ((mouse_cap & 1) ? (its_WvNoCatchT = time_precise()) : (its_WvNoCatch = 0));

                // Sliders
                ui_split_top(h2);
                    zzmx = ui_hover();
                    ui_pad(1,3,1,0);


                    // Play volume
                    rp = rcbl[its_Rdr_RegPosSec]; // region position
                    clen =  smp2sec(rcbl[its_Rdr_SmplCnt]); // clip length in seconds
                    mvl =

                    paramValues[p_playVol] = zi = rcbl[its_Rdr_OutVoldB];
                    r = parCtl(p_playVol);
                    (r != 0) ? (
                        sprintf(#itm, "Vol -> %d %.3f", r, parV(p_playVol));
                        mSL_log(SysLogBox, #itm);
                        (r === 8) ? (
                            // right clic to reset
                            rcbl[its_Rdr_OutVoldB] = 0;
                            rcbl[its_Rdr_OutVol] = 1;
                        ) : (
                            (paramValues[p_playVol] !== zi) ? (
                                rcbl[its_Rdr_OutVoldB] = zi = paramValues[p_playVol];
                                rcbl[its_Rdr_OutVol] = (zi <= -120) ? 0 : 10^(zi/20);
                            );
                        );
                        rdupdt = 1;
                    );

                    (rcbl[its_Rdr_Mode] === its_RdrMode_Delay) ? (
                        // Delay mode : the reader follows its writer at the same speed, only its offset (seconds) can be changed
                        parSetPP(p_rdOffset, pp_Max, max(0.001, clen));
                        paramValues[p_rdOffset] = rcbl[its_Rdr_WOffset];
                        r = parCtl(p_rdOffset);
                        (r != 0) ? (
                            zi = (r === 8) ? 0 : parV(p_rdOffset); // right clic : minimal offset
                            Rd_Set_Offset(rcbl, zi * srate); // with a short cross fade if the reader plays
                            rdupdt = 1;
                        );
                    ) : (
                        // Reader mode
                        // Play speed (its range : the menu of the cell 13 ; modes Stretch and Brage : the read rate of the
                        // blocks, of the segments)
                        its_Rd_SpdRange(p_playSpeed, RDBL[4]);
                        paramValues[p_playSpeed] = zi = rcbl[its_Rdr_Speed];
                        r = parCtl(p_playSpeed);
                        (r != 0) ? (
                            sprintf(#itm, "Speed -> %d %.3f", r, parV(p_playSpeed));
                            mSL_log(SysLogBox, #itm);
                            (r === 8) ? (
                                // right clic to reset
                                Rd_Set_Speed(rdr, 1, 1);
                                RDBL[4] = 0;
                            ) : (
                                (paramValues[p_playSpeed] !== zi) ? (
                                    Rd_Set_Speed(rdr, paramValues[p_playSpeed], 0);
                                );
                            );
                            rdupdt = 1;
                        );

                        // mode Stretch : the stretch, the progression in the line (the tempo ; its range : the menu of the
                        // cell 28 ; right clic : 1)
                        (rcbl[its_Rdr_Mode] === its_RdrMode_Stretch) ? (
                            its_Rd_SpdRange(p_rdStretch, RDBL[11]);
                            paramValues[p_rdStretch] = rcbl[its_Rdr_Stretch];
                            r = parCtl(p_rdStretch);
                            (r != 0) ? (
                                (r === 8) ? (
                                    rcbl[its_Rdr_Stretch] = 1;
                                    RDBL[11] = 0;
                                ) : (
                                    rcbl[its_Rdr_Stretch] = max(-SPDMAX, min(SPDMAX, parV(p_rdStretch)));
                                );
                                rdupdt = 1;
                            );
                        );


                        // Play position
                        paramValues[p_playPos] = smp2sec(its_Rd_PosSmp(rcbl));
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_playPos, pp_Min, 0);
                            parSetPP(p_playPos, pp_Max, clen);
                            parSetPP(p_playPos, pp_Step, 0.001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_playPos, pp_Min, max(0, rp - 10));
                            parSetPP(p_playPos, pp_Max, min(clen, rp + 10));
                            parSetPP(p_playPos, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_playPos, pp_Min, max(0, rp - 1));
                            parSetPP(p_playPos, pp_Max, min(clen, rp + 1));
                            parSetPP(p_playPos, pp_Step, 0.000001);
                        ) : (
                            parSetPP(p_playPos, pp_Min, 0);
                            parSetPP(p_playPos, pp_Max, clen);
                            parSetPP(p_playPos, pp_Step, 0.001);
                        );
                        r = parCtl(p_playPos);
                        (r != 0) ? (
                            sprintf(#itm, "Position -> %d %.3f", r, parV(p_playPos));
                            mSL_log(SysLogBox, #itm);
                            rcbl[its_Rdr_NxtPosSec] = parV(p_playPos); // Relative, in seconds
                            /*
                            (r === 8) ? (
                                // right clic to reset
                                Rd_Set_Speed(rdr, 1, 1);
                            ) : (
                                (paramValues[p_playPos] !== zi) ? (
                                    Rd_Set_Speed(rdr, paramValues[p_playPos], 0);
                                );
                            );
                            */
                            rdupdt = 1;
                        );

                        // Play low limit (seconds)
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_play_S_Low, pp_Min, 0);
                            parSetPP(p_play_S_Low, pp_Max, clen);
                            parSetPP(p_play_S_Low, pp_Step, 0.001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_play_S_Low, pp_Min, max(0, rp - 10));
                            parSetPP(p_play_S_Low, pp_Max, min(clen, rp + 10));
                            parSetPP(p_play_S_Low, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_play_S_Low, pp_Min, max(0, rp - 1));
                            parSetPP(p_play_S_Low, pp_Max, min(clen, rp + 1));
                            parSetPP(p_play_S_Low, pp_Step, 0.000001);
                        );
                        // (the loop follows a writer : its limits and its position are shown, they come from the writer)
                        paramValues[p_play_S_Low] = its_Rd_LimSec(rcbl, rcbl[its_Rdr_LowPosSec]);
                        parSetPP(p_play_S_Low, pp_Max, clen);
                        r = parCtl(p_play_S_Low);
                        ((r != 0) && !(rcbl[its_Rdr_LfSt] & its_RdrLf_On)) ? (
                            // (the loop crosses the end of the line : the limit in the frame centered on the loop)
                            zi = its_Rd_CrossT(rcbl, parV(p_play_S_Low));
                            (zi > rcbl[its_Rdr_HighPosSec]) ? (
                                rcbl[its_Rdr_LowPosSec] = rcbl[its_Rdr_HighPosSec];
                                rcbl[its_Rdr_HighPosSec] = zi;
                            ) : (
                                rcbl[its_Rdr_LowPosSec] = zi;
                            );
                            its_Rd_HandMove(rcbl);
                            rdupdt = 1;
                        );

                        // Play high limit (seconds)
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_play_S_High, pp_Min, 0);
                            parSetPP(p_play_S_High, pp_Max, clen);
                            parSetPP(p_play_S_High, pp_Step, 0.001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_play_S_High, pp_Min, max(0, rp - 10));
                            parSetPP(p_play_S_High, pp_Max, min(clen, rp + 10));
                            parSetPP(p_play_S_High, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_play_S_High, pp_Min, max(0, rp - 1));
                            parSetPP(p_play_S_High, pp_Max, min(clen, rp + 1));
                            parSetPP(p_play_S_High, pp_Step, 0.000001);
                        );
                        paramValues[p_play_S_High] = its_Rd_LimSec(rcbl, rcbl[its_Rdr_HighPosSec]);
                        parSetPP(p_play_S_High, pp_Max, clen);
                        r = parCtl(p_play_S_High);
                        ((r != 0) && !(rcbl[its_Rdr_LfSt] & its_RdrLf_On)) ? (
                            // (the loop crosses the end of the line : the limit in the frame centered on the loop)
                            zi = its_Rd_CrossT(rcbl, parV(p_play_S_High));
                            (zi < rcbl[its_Rdr_LowPosSec]) ? (
                                rcbl[its_Rdr_HighPosSec] = rcbl[its_Rdr_LowPosSec];
                                rcbl[its_Rdr_LowPosSec] = zi;
                            ) : (
                                rcbl[its_Rdr_HighPosSec] = zi;
                            );
                            its_Rd_HandMove(rcbl);
                            rdupdt = 1;
                        );

                        // Region position (seconds)
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_play_S_Pos, pp_Min, 0);
                            parSetPP(p_play_S_Pos, pp_Max, clen);
                            parSetPP(p_play_S_Pos, pp_Step, 0.001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_play_S_Pos, pp_Min, max(0, rp - 10));
                            parSetPP(p_play_S_Pos, pp_Max, min(clen, rp + 10));
                            parSetPP(p_play_S_Pos, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_play_S_Pos, pp_Min, max(0, rp - 1));
                            parSetPP(p_play_S_Pos, pp_Max, min(clen, rp + 1));
                            parSetPP(p_play_S_Pos, pp_Step, 0.000001);
                        );
                        paramValues[p_play_S_Pos] = rcbl[its_Rdr_RegPosSec];
                        parSetPP(p_play_S_Pos, pp_Max, clen);
                        r = parCtl(p_play_S_Pos);
                        ((r != 0) && !(rcbl[its_Rdr_LfSt] & its_RdrLf_On)) ? (
                            rcbl[its_Rdr_RegPosSec] = parV(p_play_S_Pos);
                            its_Rd_HandMove(rcbl);
                            rdupdt = 1;
                        );

                        // the move of the loop (s/s, see its_Rdr_LoopMove ; right clic : 0, still ; no effect while the loop
                        // follows a writer, see its_Rdr_LoopFollow)
                        paramValues[p_rdLoopSpd] = rcbl[its_Rdr_LoopSpd];
                        r = parCtl(p_rdLoopSpd);
                        (r != 0) ? (
                            rcbl[its_Rdr_LoopSpd] = (r === 8) ? 0 : max(-1, min(1, parV(p_rdLoopSpd)));
                        );

                        // the desync of the channels (s : the channel c reads c * desync s before the channel 0 ; right clic : 0)
                        paramValues[p_rdDesync] = rcbl[its_Rdr_Desync];
                        r = parCtl(p_rdDesync);
                        (r != 0) ? (
                            rcbl[its_Rdr_Desync] = (r === 8) ? 0 : max(-1, min(1, parV(p_rdDesync)));
                        );

                        // region size (seconds)
                        // Play speed
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_play_S_Len, pp_Max, clen);
                            parSetPP(p_play_S_Len, pp_Step, 0.00001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_play_S_Len, pp_Max, 10);
                            parSetPP(p_play_S_Len, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_play_S_Len, pp_Max, 1);
                            parSetPP(p_play_S_Len, pp_Step, 0.000001);
                        );
                        paramValues[p_play_S_Len] = rcbl[its_Rdr_RegSizeSec];
                        r = parCtl(p_play_S_Len);
                        (r != 0) ? (
                            rcbl[its_Rdr_RegSizeSec] = parV(p_play_S_Len);
                            its_Rd_HandMove(rcbl);
                            rdupdt = 1;
                        );

                        // cross fade time (ms)
                        paramValues[p_play_XFade] = rcbl[its_Rdr_XFade_mSec];
                        r = parCtl(p_play_XFade);
                        (r != 0) ? (
                            rcbl[its_Rdr_XFade_mSec] = parV(p_play_XFade);
                            rdupdt = 1;
                        );
                    );

                    // zoom of the waveform (a display property : RDBL[9]), not in delay mode
                    ((rcbl[its_Rdr_Mode] !== its_RdrMode_Delay) && (h3 > 0)) ? (
                        paramValues[p_play_Zoom] = RDBL[9];
                        r = parCtl(p_play_Zoom);
                        (r != 0) ? (
                            RDBL[9] = (r === 8) ? 1 : max(1, min(100, parV(p_play_Zoom))); // right clic : zoom 1
                        );
                    );

                ui_pop();

            ); // rok

            (rdupdt) ? (
                rcbl[its_Rdr_StFlgs] |= its_RdrFlg_Mod;
            );

        ui_pop();
    );
);


/*
   LDBL[0] = Line to display
   LDBL[1] = size in seconds
   LDBL[2] = channel count
   LDBL[5] = waveform height (0 : its_LinWaveH)
   LDBL[6] = waveform flags (its_WaveHide, its_WaveOver ; keys 'w', '+', '-', 'v' : see its_Wave_Keys)
*/
function show_Line_Pad(LDBL, blockId)
local (h1, h2, h3, h4, uix_jneed, uix_jmini, i, r, x, xx, zz, zzmi, jmc, lnr, lcbl, dfCol, zzch, zzent, zzmcl,
        zzmmd, p1, p2, nlnr, lgh, fsh)
(
    h1 = uix_jpadHeight(pad_Lin_NL); // height
    h4 = uix_jpadHeight(1); // the file of the line
    h2 = ui_jd_slidh * 1 + 4;
    (LDBL[1] <= 0) ? (LDBL[1] = 1); // the length asked for a new line (1 s, as the reset by right clic)
    // waveform, if the line exists (see mSL_ui_audio.jsfx-inc)
    lcbl = Lines_Set[LDBL[0]];
    h3 = ((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? its_Wave_H(LDBL + 5, LDBL + 6, its_LinWaveH) : 0;
    uix_jneed = h1+h4+h2+h3+ui_jd_ctgr;
    uix_jmini = h1+h4+h2+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(uix_jneed);
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            lnr = LDBL[0]; // number of line to be displayed
            lcbl = Lines_Set[lnr];
            lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            // 'd' : dump of the line in the log (taken before the pad)
            (zzmi && GM_key_take('d')) ? GM_Dump(lcbl, its_Lin_BlkSize, sprintf(#, "Line %d", lnr+1));
            (zzmi) ? its_Wave_Keys(LDBL + 5, LDBL + 6, its_LinWaveH);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Lin_Labs, pad_Lin_Siz);
                jmc = ui_jmouse_cap;

                CL1 = Color_Medium_Spring_Green;
                (lcbl === 0) ? (
                    // Line undefined
                    dfCol = Col_Inactive;
                    i = 0; loop(pad_Lin_Siz,
                        pad_Lin_Colrs[i] = dfCol;
                        strcpy(pad_Lin_Labs[i],"");
                        i += 1;
                    );
                    strcpy(pad_Lin_Labs[1],menu_Lin_Status_N[0]);
                    sprintf(pad_Lin_Labs[2], "Length %.3f s", LDBL[1]);
                    sprintf(pad_Lin_Labs[3], "%d spls.", floor(LDBL[1]*srate));
                    sprintf(pad_Lin_Labs[4], "%d chan.", LDBL[2]);
                    (Ln_MemErr[lnr]) ? (
                        strcpy(pad_Lin_Labs[6], "Err 2610 : memory");
                        pad_Lin_Colrs[6] = Col_Error;
                    );
                ) : (
                    // Line existing
                    dfCol = Color_Limegreen;
                    i = 0; loop(pad_Lin_Siz,
                        pad_Lin_Colrs[i] = dfCol;
                        strcpy(pad_Lin_Labs[i],"");
                        i += 1;
                    );
                    strcpy(pad_Lin_Labs[1],menu_Lin_Status_N[lcbl[its_Lin_Status]]);
                    sprintf(pad_Lin_Labs[2], "%.3f s", lcbl[its_Lin_SmplCntSec]);
                    sprintf(pad_Lin_Labs[3], "%d spls", lcbl[its_Lin_SmplCnt]);
                    sprintf(pad_Lin_Labs[4], "%d chan.", lcbl[its_Lin_ChCnt]);
                    sprintf(pad_Lin_Labs[5], "F. %d Hz", lcbl[its_Lin_RecFreq]);
                );
                (lok && (lcbl[its_Lin_Owner] > 0)) ? sprintf(pad_Lin_Labs[0],"Line %d (%s)", lnr+1, its_Al_OwnName(#its_OwnN, lcbl[its_Lin_Owner])) :
                    sprintf(pad_Lin_Labs[0],"Line %d", lnr+1);
                strcpy(pad_Lin_Labs[7],"Action");

                zz = control_jpad(pad_Line);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzch = pad_Line[ui_jpad_lkey];
                    zzent = pad_Line[ui_jpad_entkey]-1;
                    zzmcl = pad_Line[ui_jpad_last]-1;
                    zzmmd = pad_Line[ui_jpad_lmods];

                    // right mouse clic (the cell "Action", and the cells "status" and "chan." of a line not created : left clic too)
                    ((zz & ui_jpad_ev_rmc) || ((zz & ui_jpad_ev_lmc) && ((zzmcl === 7) || ((lcbl === 0) && ((zzmcl === 1) || (zzmcl === 4)))))) ? (
                        (zzmcl === 0) ? (
                            k = lnr+1;
                            ui_menu_tick(menu_Lin_Ids, k, 1);
                            // also tick the header of the sub-menu that holds the current line (reset below by the tick -1)
                            lgh = menu_Lin_Ids[ui_jmenu_items + (0|(lnr / menu_Lin_Grp)) * (menu_Lin_Grp + 1)];
                            str_setchar(lgh, 1, '!');
                            xx = control_jmenu(menu_Lin_Ids);
                            (xx != 0) ? (
                                LDBL[0] = xx - 1; // select a new line to display
                            );
                            ui_menu_tick(menu_Lin_Ids, -1, 0);
                        ) :
                        (zzmcl === 1) ? (
                            (lcbl === 0) ? (
                                ui_menu_tick(menu_Lin_Status, 1, 1);
                                xx = its_Menu_Clic(menu_Lin_Status, zz);
                                (xx != 0) ? (
                                    (xx === 2) ? (
                                        // create the line
                                        Ln_Make(lnr, srate, LDBL[1], LDBL[2]);
                                    );
                                );
                                ui_menu_tick(menu_Lin_Status, -1, 0);
                            );
                        ) :
                        (zzmcl === 4) ? (
                            (lcbl === 0) ? (
                                k = max(1,LDBL[2]);
                                ui_menu_tick(menu_128_1_Ids, k, 1);
                                // also tick the header of the sub-menu that holds the current count (reset below by the tick -1)
                                (k >= 1) ? (
                                    lgh = menu_128_1_Ids[ui_jmenu_items + (0|((k - 1) / menu_128_Grp)) * (menu_128_Grp + 1)];
                                    str_setchar(lgh, 1, '!');
                                );
                                xx = its_Menu_Clic(menu_128_1_Ids, zz);
                                (xx != 0) ? (
                                    LDBL[2] = xx ; // actual channel count
                                    Ln_MemErr[lnr] = 0; // new request : no error yet
                                );
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 7) ? (
                            xx = its_Menu_Clic(menu_Lin_Action, zz);
                            (xx === its_LinAct_Patch + 1) ? (
                                its_Xp_Ask(1, its_TK_Line, lnr);
                            ) :
                            ((xx != 0) && (xx !== its_LinAct_Patch)) ? (
                                Ln_Action(lnr, xx - 1, LDBL);
                            );
                        );
                    );

                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        (zzmcl === 0) ? (
                            // the next line (shift : the previous one)
                            LDBL[0] = (jmc & shfCap) ? (lnr + LN_CNT - 1) % LN_CNT : (lnr + 1) % LN_CNT;
                        );
                    );
                );

            ui_pop();

            // The file of the line : a sound file dropped here is read into this line (Ln_Load_File) ; left clic : the full
            // path for its_LnFShowDur s (a second clic : the name again) ; right clic : menu (Reload, Forget the name, Path in the log)
            ui_split_top(h4);
                ui_pad(1,0,2,2);
                ((g__dpa != 0) && (g__msx >= ui_left()) && (g__msx < ui_left() + ui_width())
                    && (g__msy >= ui_top()) && (g__msy < ui_top() + ui_height())) ? (
                    g__dpa = 0;
                    sprintf(#s, "Line %d : file \"%s\"", lnr+1, g__efs);
                    mSL_log(SysLogBox, #s);
                    Ln_Load_File(lnr, g__efs); // (an error is logged)
                    lcbl = Lines_Set[lnr];
                    lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
                );
                mSL_setStrArray(pad_LnF_Labs, 1);
                fsh = (its_LnFShow === lnr) && (time_precise() < its_LnFShowT);
                (strlen(its_LnFile[lnr]) > 0) ? (
                    fsh ? strcpy(pad_LnF_Labs[0], its_LnFile[lnr]) : its_Ln_BaseName(pad_LnF_Labs[0], its_LnFile[lnr]);
                    pad_LnF_Colrs[0] = fsh ? Color_Goldenrod : Col_P3;
                ) : (
                    strcpy(pad_LnF_Labs[0], "No file");
                    pad_LnF_Colrs[0] = Col_P1;
                );
                fsh ? (ui_GFXdoNow |= 4); // (the name comes back after its_LnFShowDur s)
                zz = control_jpad(pad_LnF);
                ((zz > 0) && (strlen(its_LnFile[lnr]) > 0)) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    (zz & ui_jpad_ev_lmc) ? (
                        fsh ? (its_LnFShowT = 0) : (its_LnFShow = lnr; its_LnFShowT = time_precise() + its_LnFShowDur;);
                    ) :
                    (zz & ui_jpad_ev_rmc) ? (
                        xx = control_jmenu(menu_LnF_Action);
                        (xx === 1) ? (
                            strcpy(#its_LnFTmp, its_LnFile[lnr]); // (Ln_Load_File writes its_LnFile)
                            Ln_Load_File(lnr, #its_LnFTmp);
                            lcbl = Lines_Set[lnr];
                            lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
                        ) :
                        (xx === 2) ? (
                            strcpy(its_LnFile[lnr], "");
                        ) :
                        (xx === 3) ? (
                            sprintf(#s, "Line %d : file \"%s\"", lnr+1, its_LnFile[lnr]);
                            mSL_log(SysLogBox, #s);
                        );
                    );
                );
            ui_pop();

            // an audio file dropped elsewhere in the module : read into this line if it fits, into a new line otherwise
            (zzmi && (g__dpa != 0)) ? (
                sprintf(#s, "Line::drop file : \"%s\" - %d, %d, %d", g__efs, g__msx, g__msy, g__msc);
                mSL_log(SysLogBox, #s);
                g__dpa = 0;
                (!lok) ? (
                    p1 = p2 = -1;
                ) : (
                    p1 = lnr; p2 = lcbl;
                );
                nlnr = File_Handle(g__efs, p1, p2);
                (nlnr >= 0) ? (
                    lnr = LDBL[0] = nlnr;
                    lcbl = Lines_Set[lnr];
                    lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
                );
            );

            // Sliders
            ui_split_top(h2);
                zzmx = ui_hover();
                ui_pad(1,3,1,0);
                paramValues[p_lineSize] = zi = (lcbl === 0) ? LDBL[1] : lcbl[its_Lin_SmplCntSec];
                r = parCtl(p_lineSize);
                (r != 0) ? (
                    (r === 8) ? (
                        // right clic to reset
                        paramValues[p_lineSize] = 1;
                    );
                    (paramValues[p_lineSize] !== zi) ? (
                        (lcbl === 0) ? (
                            x = paramValues[p_lineSize];
                            LDBL[1] = (jmc & shfCap) ? floor(0.5 + x) : x; // on peut modifier
                            Ln_MemErr[lnr] = 0; // new request : no error yet
                        );
                    );
                );
            ui_pop();

            // Waveform of the line (all the channels buffers, the loudest ones)
            (lok && (h3 > 0) && (ui_height() > 8)) ? (
                ui_push();
                    ui_pad(1,2,1,2);
                    // heads of the writers and of all the readers of this line (numbered)
                    its_wave_marks(lcbl, -1);
                    // the samples are in [its_Lin_Start, its_Lin_Last) of each buffer (BF_LIM guard samples around)
                    ui_audio_wave(h3, lcbl[its_Lin_ChCnt], lcbl + its_Lin_BF1ST, lcbl[its_Lin_ActBSize],
                        lcbl[its_Lin_Start], lcbl[its_Lin_Last], its_Wave_Flags(LDBL + 6), its_LinWaveMax);
                ui_pop();
            );

        ui_pop();
    );
);


/*
    The part of the pad specific to a type : one function per type, "what" tells what to do
        FXP_Dims : set RDBL[3] (lines of the pad, the common line included) and RDBL[5] (count of sliders)
        FXP_Fill : labels and colors of the cells of the lines 1 ... RDBL[3]-1 (cells 8 ...)
        FXP_Click : event "ev" (ui_jpad_ev_...) on the cell "cell" (8 ...)
        FXP_Sliders : draw and handle the sliders
        FXP_Graph : draw and handle the graphic area (its height in RDBL[6], set by FXP_Dims ; 0 : none)
    After a modification, the function resets fx[its_Efx_Check] (the effect is checked again by exec_fx)
*/
FXP_Dims = 0;
FXP_Fill = 1;
FXP_Click = 2;
FXP_Sliders = 3;
FXP_Graph = 4;

/*
    the editor of the weights "hw" of the mode Cheb. sum, in the current rect : a bar per harmonic, in [-1, 1]
    left clic / drag : the weight at the height of the mouse (near 0 : 0) ; right clic / drag : 0 ; the bar under the mouse : its value
*/
function its_Harm_Edit(hw)
local (x0, y0, w, h, bw, hh, ym, k, v, b, act)
(
    ui_push();
        ui_pad(4, 2, 4, 2);
        x0 = ui_left(); y0 = ui_top(); w = ui_width(); h = ui_height();
        bw = w / its_SatHarm; hh = max(1, floor(h / 2) - 1); ym = y0 + floor(h / 2);
        // the mouse
        act = ((mouse_cap & 1) && uix_clickwasinside(1)) ? 1 : ((mouse_cap & 2) && uix_clickwasinside(2)) ? 2 : 0;
        (act) ? (
            k = max(0, min(its_SatHarm - 1, floor((uix_mouse_x - x0) / bw)));
            v = max(-1, min(1, (ym - uix_mouse_y) / hh));
            hw[k] = ((act === 2) || (abs(v) < 0.03)) ? 0 : v;
            ui_GFXdoNow |= 4; ui_GFXReason = 37;
        );
        // the bars
        ui_pcolor(0x808080, 0.15);
        gfx_rect(x0, y0, w, h);
        ui_pcolor(0x808080, 0.6);
        gfx_line(x0, ym, x0 + w - 1, ym);
        ui_pcolor(uix_theme_accent(), 0.85);
        k = 0; loop(its_SatHarm,
            b = floor(abs(hw[k]) * hh + 0.5);
            (b > 0) ? gfx_rect(x0 + floor(k * bw) + 1, (hw[k] > 0) ? ym - b : ym + 1, max(1, floor(bw) - 2), b);
            k += 1;
        );
        // the rank and the weight of the bar under the mouse
        ui_hover() ? (
            k = max(0, min(its_SatHarm - 1, floor((uix_mouse_x - x0) / bw)));
            ui_pcolor(0x909090, 1);
            gfx_x = x0 + 3; gfx_y = y0 + 2;
            gfx_drawstr(sprintf(#its_HarmTxt, "H%d : %.3f", k + 1, hw[k]));
        );
    ui_pop();
);

// Mixer and Auto Mixer : line 1 = the 8 sources (right clic : the source ; left clic : its first channel) ; the gains of the Mixer as sliders
function FX_Mixer_Pad(RDBL, fx, fxn, what, cell, ev)
local (i, k, p, r, zi, mix)
(
    mix = (fx[its_Efx_Type] === its_Efx_TyMixer); // the Auto Mixer computes its gains
    (what === FXP_Dims) ? (
        RDBL[3] = 3; // line 2 : the auto-limiter only (cell 23, see show_Effect_Pad)
        k = 0; p = fx + its_Efx_Src1;
        loop(8, (p[0] > 0) ? (k += 1); p += its_EfxDist;);
        RDBL[5] = mix ? k : 0;
    ) :
    (what === FXP_Fill) ? (
        i = 0; p = fx + its_Efx_Src1;
        loop(8,
            k = p[0];
            (k > 0) ? (
                its_Src_Label(pad_Efx_Labs[8 + i], k, p[its_Efx_Off1 - its_Efx_Src1]);
                pad_Efx_Colrs[8 + i] = Col_P3;
            ) : (
                sprintf(pad_Efx_Labs[8 + i], "Src %d", i + 1);
                pad_Efx_Colrs[8 + i] = Col_P1;
            );
            i += 1; p += its_EfxDist;
        );
    ) :
    (what === FXP_Click) ? (
        ((cell >= 8) && (cell < 16)) ? (
            p = fx + its_Efx_Src1 + (cell - 8) * its_EfxDist;
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(p[0], p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
                    p[0] = k;
                    p[its_Efx_Off1 - its_Efx_Src1] = its_Src_ChOff;
                    mix ? (fx[its_Efx_Check] = 0) : FX_Auto_Gains(fx);
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
                    p[its_Efx_Off1 - its_Efx_Src1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        );
    ) :
    (what === FXP_Sliders) ? (
        mix ? (
            i = 0; p = fx + its_Efx_Src1;
            loop(8,
                (p[0] > 0) ? (
                    paramValues[p_fxGain1 + i] = p[its_Efx_VoldB1 - its_Efx_Src1];
                    r = parCtl(p_fxGain1 + i);
                    (r != 0) ? (
                        zi = (r === 8) ? 0 : parV(p_fxGain1 + i); // right clic : 0 dB
                        p[its_Efx_VoldB1 - its_Efx_Src1] = zi;
                        fx[its_Efx_Check] = 0; // exec_fx computes the linear gain
                    );
                );
                i += 1; p += its_EfxDist;
            );
        );
    );
);

// the cell of a curve (LFO, Saturation) : "pc" the parameter (its number), cell "c" ; its name, or "Curve n" (gray if it does not exist)
function FX_Crv_Fill(pc, c) local(k)
(
    k = max(0, min(its_CrvMx - 1, 0|pc[0]));
    (strlen(its_CrvNm[k]) > 0) ? strcpy(pad_Efx_Labs[c], its_CrvNm[k]) : sprintf(pad_Efx_Labs[c], "Curve %d", k + 1);
    pad_Efx_Colrs[c] = (its_CrvBlk[k] > BASE_MEMORY) ? Color_Goldenrod : Col_Inactive; // (no curve : silence)
);

// a clic on the cell of a curve : left clic, the next curve that exists ; right clic, the menu of the curves
function FX_Crv_Click(pc, ev) local(k, r, xx)
(
    k = max(0, min(its_CrvMx - 1, 0|pc[0]));
    (ev & ui_jpad_ev_rmc) ? (
        ui_menu_tick(menu_Crv_Ids, -1, 0);
        ui_menu_tick(menu_Crv_Ids, k + 1, 1);
        str_setchar(menu_Crv_Ids[ui_jmenu_items + (0|(k / menu_Crv_Grp)) * (menu_Crv_Grp + 1)], 1, '!'); // (its sub-menu)
        xx = control_jmenu(menu_Crv_Ids);
        (xx != 0) ? (pc[0] = xx - 1);
        ui_menu_tick(menu_Crv_Ids, -1, 0);
    ) :
    (ev & ui_jpad_ev_lmc) ? (
        // the next curve that exists (none : the next one)
        r = 1; while ((r < its_CrvMx) && (its_CrvBlk[(k + r) % its_CrvMx] <= BASE_MEMORY)) ( r += 1; );
        pc[0] = (k + ((r < its_CrvMx) ? r : 1)) % its_CrvMx;
    );
);

/*
    LFO : line 1, cell 8 = the shape (left clic : the next one ; right clic : menu), cell 9 = the curve of the shape "Curve"
    (left clic : the next curve that exists ; right clic : menu) ; sliders : frequency, amplitude, offset, phase spread
    between the channels (Par1, Par3, Par4, Par5 : read at each sample, no check needed)
*/
function FX_LFO_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx, pw)
(
    (what === FXP_Dims) ? (
        RDBL[3] = 2;
        RDBL[5] = 4;
    ) :
    (what === FXP_Fill) ? (
        strcpy(pad_Efx_Labs[8], menu_Efx_LfoShape_N[max(0, min(its_LfoCnt - 1, fx[its_Efx_Par1 + 1]))]);
        pad_Efx_Colrs[8] = Col_P3;
        (fx[its_Efx_Par1 + 1] === its_LfoCurve) ? FX_Crv_Fill(fx + its_Efx_Par1 + 5, 9);
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_LfoShape, -1, 0);
                ui_menu_tick(menu_Efx_LfoShape, fx[its_Efx_Par1 + 1] + 1, 1);
                xx = control_jmenu(menu_Efx_LfoShape);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_LfoShape, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (fx[its_Efx_Par1 + 1] + 1) % its_LfoCnt;
            );
        ) :
        ((cell === 9) && (fx[its_Efx_Par1 + 1] === its_LfoCurve)) ? FX_Crv_Click(fx + its_Efx_Par1 + 5, ev);
    ) :
    (what === FXP_Sliders) ? (
        k = 0; loop(4,
            pw = its_Efx_Par1 + ((k === 0) ? 0 : k + 1); // Par1, Par3, Par4, Par5
            paramValues[p_fxLfoFreq + k] = fx[pw];
            r = parCtl(p_fxLfoFreq + k);
            (r != 0) ? (
                // right clic : 1 Hz, amplitude 1, no offset, no spread
                fx[pw] = (r === 8) ? ((k === 0) ? 1 : (k === 1) ? 1 : 0) : parV(p_fxLfoFreq + k);
            );
            k += 1;
        );
    );
);

// Filter : line 1, cell 8 = the source (right clic : menu ; left clic : its first channel), cell 9 = the mode (left clic :
// the next one ; right clic : menu), cell 10 = the slope (left clic : the next one ; right clic : the previous one) ;
// line 2 : the modulation inputs (cutoff, resonance) ; sliders : cutoff, resonance (biquads, or 4 and 8 one pole stages : a
// ladder), input gain, and the modulations used
function FX_Filter_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx, zi, ns, md)
(
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 2 + (its_Flt_ModOk(fx) > 1) + its_Mod_SlCount(fx + its_Efx_Mod1, 2, its_Flt_ModOk(fx));
    ) :
    (what === FXP_Fill) ? (
        (fx[its_Efx_Src1] !== 0) ? (
            its_Src_Label(pad_Efx_Labs[8], fx[its_Efx_Src1], fx[its_Efx_Off1]);
            pad_Efx_Colrs[8] = Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[8], "Source");
            pad_Efx_Colrs[8] = Col_P1;
        );
        strcpy(pad_Efx_Labs[9], menu_Efx_FltMode_N[max(0, min(5, fx[its_Efx_Par1 + 2]))]);
        pad_Efx_Colrs[9] = Col_P3;
        ns = its_Flt_Stages(fx);
        md = fx[its_Efx_Par1 + 2];
        (md === its_FltNotch) ? sprintf(pad_Efx_Labs[10], "%d stage%s", ns, (ns > 1) ? "s" : "") :
            sprintf(pad_Efx_Labs[10], "%d dB/oct", ((md === its_FltLP) || (md === its_FltHP)) ? 12 * ns : 6 * ns);
        pad_Efx_Colrs[10] = Col_P3;
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 2, its_ModN_Flt, its_Flt_ModOk(fx));
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(fx[its_Efx_Src1], fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Src1] = k;
                    fx[its_Efx_Off1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Off1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 9) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_FltMode, -1, 0);
                ui_menu_tick(menu_Efx_FltMode, fx[its_Efx_Par1 + 2] + 1, 1);
                xx = control_jmenu(menu_Efx_FltMode);
                (xx != 0) ? (fx[its_Efx_Par1 + 2] = xx - 1);
                ui_menu_tick(menu_Efx_FltMode, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 2] = (fx[its_Efx_Par1 + 2] + 1) % 6;
            );
        ) :
        (cell === 10) ? (
            k = max(0, min(its_FltSlopes - 1, floor(fx[its_Efx_Par1 + 3])));
            (ev & ui_jpad_ev_rmc) ? (fx[its_Efx_Par1 + 3] = (k + its_FltSlopes - 1) % its_FltSlopes) :
            (ev & ui_jpad_ev_lmc) ? (fx[its_Efx_Par1 + 3] = (k + 1) % its_FltSlopes);
        ) :
        ((cell === 17) || (cell === 18)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Flt, its_ModK_Flt) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // cutoff, resonance : read at each sample
        paramValues[p_fxFltFreq] = fx[its_Efx_Par1];
        r = parCtl(p_fxFltFreq);
        (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? 1000 : parV(p_fxFltFreq));
        (its_Flt_ModOk(fx) > 1) ? (
            paramValues[p_fxFltQ] = fx[its_Efx_Par1 + 1];
            r = parCtl(p_fxFltQ);
            (r != 0) ? (fx[its_Efx_Par1 + 1] = (r === 8) ? 0.707 : parV(p_fxFltQ));
        );
        // input gain : its linear value is computed by the check
        paramValues[p_fxGain1] = fx[its_Efx_VoldB1];
        r = parCtl(p_fxGain1);
        (r != 0) ? (
            fx[its_Efx_VoldB1] = (r === 8) ? 0 : parV(p_fxGain1);
            fx[its_Efx_Check] = 0;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 2, its_Flt_ModOk(fx), p_fxFltModD1, p_fxFltModA1, its_ModN_Flt, its_ModK_Flt);
    );
);

// Saturation : line 1, cell 8 = the source (right clic : menu ; left clic : its first channel), cell 9 = the mode (left clic :
// the next one ; right clic : menu), cell 10 = the oversampling (left clic : the next one ; right clic : the previous one) ;
// cell 12 = ADAA (clic : On / Off ; gray in the modes without a primitive : Cheb, Cheb. sum, Curve) ;
// cell 11 = the presets of the weights (menu, mode Cheb. sum) or the curve (mode Curve : left clic, the next curve that exists ;
// right clic, menu) ; line 2 : the modulation inputs (drive, bias, order or stretch) ;
// sliders : drive, bias, mix, output, order (modes x - A sin, Chebyshev) and A (x - A sin) or stretch (Cheb. sum), input gain, and the modulations
// used ; the graphic area (Cheb. sum) : the editor of the weights of the harmonics
function FX_Sat_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx)
(
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 5 + ((fx[its_Efx_Par1 + 1] >= its_SatXSin) && (fx[its_Efx_Par1 + 1] <= its_SatChebSum))
            + (fx[its_Efx_Par1 + 1] === its_SatXSin) + its_Mod_SlCount(fx + its_Efx_Mod1, 3, its_Sat_ModOk(fx));
        RDBL[6] = (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? its_HarmH : 0;
    ) :
    (what === FXP_Fill) ? (
        (fx[its_Efx_Src1] !== 0) ? (
            its_Src_Label(pad_Efx_Labs[8], fx[its_Efx_Src1], fx[its_Efx_Off1]);
            pad_Efx_Colrs[8] = Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[8], "Source");
            pad_Efx_Colrs[8] = Col_P1;
        );
        strcpy(pad_Efx_Labs[9], menu_Efx_SatMode_N[max(0, min(its_SatModeCnt - 1, fx[its_Efx_Par1 + 1]))]);
        pad_Efx_Colrs[9] = Col_P3;
        sprintf(pad_Efx_Labs[10], "Oversampling %dx", 2^max(0, min(its_SatOSCnt - 1, floor(fx[its_Efx_Par1 + 4]))));
        pad_Efx_Colrs[10] = Col_P3;
        strcpy(pad_Efx_Labs[12], (fx[its_Efx_Par1 + 10] !== 0) ? "ADAA On" : "ADAA Off");
        pad_Efx_Colrs[12] = !its_Sat_AdOk(fx[its_Efx_Par1 + 1]) ? Col_Inactive : (fx[its_Efx_Par1 + 10] !== 0) ? Col_P2 : Col_P3;
        (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? (
            strcpy(pad_Efx_Labs[11], "Harmonics");
            pad_Efx_Colrs[11] = Col_P3;
        );
        (fx[its_Efx_Par1 + 1] === its_SatCurve) ? FX_Crv_Fill(fx + its_Efx_Par1 + 9, 11);
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_ModN_Sat[2] = (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? "Stretch" : "Order";
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Sat, its_Sat_ModOk(fx));
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(fx[its_Efx_Src1], fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Src1] = k;
                    fx[its_Efx_Off1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Off1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 9) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_SatMode, -1, 0);
                ui_menu_tick(menu_Efx_SatMode, fx[its_Efx_Par1 + 1] + 1, 1);
                xx = control_jmenu(menu_Efx_SatMode);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_SatMode, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (fx[its_Efx_Par1 + 1] + 1) % its_SatModeCnt;
            );
        ) :
        (cell === 10) ? (
            k = max(0, min(its_SatOSCnt - 1, floor(fx[its_Efx_Par1 + 4])));
            (ev & ui_jpad_ev_rmc) ? (fx[its_Efx_Par1 + 4] = (k + its_SatOSCnt - 1) % its_SatOSCnt) :
            (ev & ui_jpad_ev_lmc) ? (fx[its_Efx_Par1 + 4] = (k + 1) % its_SatOSCnt);
        ) :
        ((cell === 11) && (fx[its_Efx_Par1 + 1] === its_SatChebSum)) ? (
            xx = control_jmenu(menu_Efx_Harm);
            (xx != 0) ? its_Harm_Preset(fx + its_Efx_Harm1, xx - 1);
        ) :
        ((cell === 11) && (fx[its_Efx_Par1 + 1] === its_SatCurve)) ? FX_Crv_Click(fx + its_Efx_Par1 + 9, ev) :
        ((cell === 12) && (ev & (ui_jpad_ev_lmc | ui_jpad_ev_rmc))) ? (
            fx[its_Efx_Par1 + 10] = (fx[its_Efx_Par1 + 10] !== 0) ? 0 : 1;
        ) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Sat, its_ModK_Sat) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // drive, bias, mix, output : read at each sample
        paramValues[p_fxSatDrive] = fx[its_Efx_Par1];
        r = parCtl(p_fxSatDrive);
        (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? 12 : parV(p_fxSatDrive));
        paramValues[p_fxSatBias] = fx[its_Efx_Par1 + 2];
        r = parCtl(p_fxSatBias);
        (r != 0) ? (fx[its_Efx_Par1 + 2] = (r === 8) ? 0 : parV(p_fxSatBias));
        paramValues[p_fxSatMix] = 100 * fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxSatMix);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? 1 : parV(p_fxSatMix) / 100);
        paramValues[p_fxSatOut] = fx[its_Efx_Par1 + 5];
        r = parCtl(p_fxSatOut);
        (r != 0) ? (fx[its_Efx_Par1 + 5] = (r === 8) ? -6 : parV(p_fxSatOut)); // (-6 dB : as FX_Set_Type)
        (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? (
            paramValues[p_fxSatStretch] = fx[its_Efx_Par1 + 7];
            r = parCtl(p_fxSatStretch);
            (r != 0) ? (fx[its_Efx_Par1 + 7] = (r === 8) ? 1 : parV(p_fxSatStretch));
        ) :
        ((fx[its_Efx_Par1 + 1] >= its_SatXSin) && (fx[its_Efx_Par1 + 1] <= its_SatChebSum)) ? (
            paramValues[p_fxSatOrder] = fx[its_Efx_Par1 + 6];
            r = parCtl(p_fxSatOrder);
            (r != 0) ? (fx[its_Efx_Par1 + 6] = (r === 8) ? 3 : parV(p_fxSatOrder));
            (fx[its_Efx_Par1 + 1] === its_SatXSin) ? (
                paramValues[p_fxSatAmp] = fx[its_Efx_Par1 + 8];
                r = parCtl(p_fxSatAmp);
                (r != 0) ? (fx[its_Efx_Par1 + 8] = (r === 8) ? 1 : parV(p_fxSatAmp));
            );
        );
        // input gain : its linear value is computed by the check
        paramValues[p_fxGain1] = fx[its_Efx_VoldB1];
        r = parCtl(p_fxGain1);
        (r != 0) ? (
            fx[its_Efx_VoldB1] = (r === 8) ? 0 : parV(p_fxGain1);
            fx[its_Efx_Check] = 0;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, its_Sat_ModOk(fx), p_fxSatModD1, p_fxSatModA1, its_ModN_Sat, its_ModK_Sat);
    ) :
    (what === FXP_Graph) ? (
        (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? its_Harm_Edit(fx + its_Efx_Harm1);
    );
);

/*
    a value of an effect edited in the prompt (the numeric edit window of the sliders ; Shift + left clic on its cell : the
    seed) : the effect "fxn", the word "w" of its block, its bounds (an integer) ; taken when the prompt is closed with a
    new text (its_FxEd_Take, at the start of show_Effect_Pad), if the effect still exists with the same type
*/
function its_FxEd_Open(fx, fxn, w, mini, maxi, title)
(
    its_FxEdN = fxn; its_FxEdW = w; its_FxEdT = fx[its_Efx_Type]; its_FxEdMin = mini; its_FxEdMax = maxi;
    sprintf(#its_FxEdO, "%d", fx[w]);
    strcpy(#its_FxEdS, #its_FxEdO);
    sprintf(#its_FxEdTt, "New value for  %s (%d ... %d)", title, mini, maxi);
    ui_screen_open("control.prompt");
    ui_screen_arg(0, #its_FxEdS);
    ui_screen_arg(1, #its_FxEdTt);
);

function its_FxEd_Take()
local (fx)
(
    ((its_FxEdN >= 0) && !(ui_screen() == "control.prompt")) ? (
        fx = Effects_set[its_FxEdN];
        ((strcmp(#its_FxEdS, #its_FxEdO) !== 0) && (fx > BASE_MEMORY) && (fx[-2] === KW_effx) && (fx[its_Efx_Type] === its_FxEdT)) ? (
            fx[its_FxEdW] = max(its_FxEdMin, min(its_FxEdMax, floor(ui_parsenumber(#its_FxEdS, fx[its_FxEdW]) + 0.5)));
        );
        its_FxEdN = -1;
    );
);

// Matrix : line 1, cell 8 = the source (right clic : menu ; left clic : its first channel), cell 9 = the matrix (left clic :
// the next one ; right clic : menu), cell 10 = the loop Decay / Freeze / Grow (left clic : the next one ; right clic : menu),
// cell 11 = the lines (Hadamard : with the inner ones) and the longest delay possible, cell 12 = the seed of the delays
// (left clic : + 1 ; right clic : - 1 ; Shift + left clic : the prompt), cell 13 = the spread of the delays (left clic : the
// next one ; right clic : menu),
// cell 14 = the input Direct / Spread (clic), cell 15 = "Loop sat." when the loop saturates (it can grow) ; line 2 : the
// modulation inputs (decay, damping, diffusion) ; sliders : decay, damping, high pass, mix, delay min, delay max, diffusion
// (not Hadamard), input gain, and the modulations used
function FX_Matrix_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx, ok, np, lm, sh, ty)
(
    ok = its_Mx_ModOk(fx);
    ty = fx[its_Efx_Type];
    sh = (ty === its_Efx_TyShimmer);
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 12 + ((ok & 4) ? 1 : 0) + (sh ? 4 : 0) + its_Mod_SlCount(fx + its_Efx_Mod1, 3, ok);
        RDBL[6] = 0;
    ) :
    (what === FXP_Fill) ? (
        (fx[its_Efx_Src1] !== 0) ? (
            its_Src_Label(pad_Efx_Labs[8], fx[its_Efx_Src1], fx[its_Efx_Off1]);
            pad_Efx_Colrs[8] = Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[8], "Source");
            pad_Efx_Colrs[8] = Col_P1;
        );
        strcpy(pad_Efx_Labs[9], menu_Efx_MxType_N[max(0, min(its_MxTypeCnt - 1, fx[its_Efx_Par1 + 1]))]);
        pad_Efx_Colrs[9] = Col_P3;
        lm = max(0, min(its_MxLpCnt - 1, fx[its_Efx_Par1 + 7]));
        sprintf(pad_Efx_Labs[10], "Loop %s", menu_Efx_MxLoop_N[lm]);
        pad_Efx_Colrs[10] = (lm === its_MxLpFreeze) ? Color_Goldenrod : (lm === its_MxLpGrow) ? Color_Dark_Orange : Col_P3;
        np = its_Mx_Lines(fx); k = max(1, min(its_MxMaxL, floor(fx[its_Efx_CCnt])));
        (np > k) ? sprintf(pad_Efx_Labs[11], "%d+%d lines, %.1f s", k, np - k, its_Mx_MaxDelay(fx)) :
            sprintf(pad_Efx_Labs[11], "%d lines, %.1f s", np, its_Mx_MaxDelay(fx));
        pad_Efx_Colrs[11] = Col_InfoA;
        sprintf(pad_Efx_Labs[12], "Seed %d", fx[its_Efx_Par1 + 8]);
        pad_Efx_Colrs[12] = Col_P3;
        strcpy(pad_Efx_Labs[13], menu_Efx_MxSpread_N[max(0, min(its_MxSpCnt - 1, fx[its_Efx_Par1 + 9]))]);
        pad_Efx_Colrs[13] = Col_P3;
        strcpy(pad_Efx_Labs[14], (fx[its_Efx_Par1 + 11] === its_MxInSpread) ? "Input spread" : "Input direct");
        pad_Efx_Colrs[14] = (fx[its_Efx_Par1 + 11] === its_MxInSpread) ? Col_P2 : Col_P3;
        its_Mx_Grows(fx, fx[its_Efx_Par1 + 6]) ? (
            strcpy(pad_Efx_Labs[15], "Loop sat.");
            pad_Efx_Colrs[15] = Color_Dark_Orange;
        );
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Mx, ok);
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(fx[its_Efx_Src1], fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Src1] = k;
                    fx[its_Efx_Off1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Off1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 9) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_MxType, -1, 0);
                ui_menu_tick(menu_Efx_MxType, fx[its_Efx_Par1 + 1] + 1, 1);
                xx = control_jmenu(menu_Efx_MxType);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_MxType, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (fx[its_Efx_Par1 + 1] + 1) % its_MxTypeCnt;
            );
        ) :
        (cell === 10) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_MxLoop, -1, 0);
                ui_menu_tick(menu_Efx_MxLoop, fx[its_Efx_Par1 + 7] + 1, 1);
                xx = control_jmenu(menu_Efx_MxLoop);
                (xx != 0) ? (fx[its_Efx_Par1 + 7] = xx - 1);
                ui_menu_tick(menu_Efx_MxLoop, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 7] = (fx[its_Efx_Par1 + 7] + 1) % its_MxLpCnt;
            );
        ) :
        (cell === 12) ? (
            ((ev & ui_jpad_ev_lmc) && (its_PadJmc & shfCap)) ? its_FxEd_Open(fx, fxn, its_Efx_Par1 + 8, 0, 100000, "the seed") :
            (ev & ui_jpad_ev_rmc) ? (fx[its_Efx_Par1 + 8] = max(0, fx[its_Efx_Par1 + 8] - 1)) :
            (ev & ui_jpad_ev_lmc) ? (fx[its_Efx_Par1 + 8] = min(100000, fx[its_Efx_Par1 + 8] + 1));
        ) :
        (cell === 13) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_MxSpread, -1, 0);
                ui_menu_tick(menu_Efx_MxSpread, fx[its_Efx_Par1 + 9] + 1, 1);
                xx = control_jmenu(menu_Efx_MxSpread);
                (xx != 0) ? (fx[its_Efx_Par1 + 9] = xx - 1);
                ui_menu_tick(menu_Efx_MxSpread, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 9] = (fx[its_Efx_Par1 + 9] + 1) % its_MxSpCnt;
            );
        ) :
        ((cell === 14) && (ev & (ui_jpad_ev_lmc | ui_jpad_ev_rmc))) ? (
            fx[its_Efx_Par1 + 11] = (fx[its_Efx_Par1 + 11] === its_MxInSpread) ? its_MxInDirect : its_MxInSpread;
        ) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Mx, its_ModK_Mx) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // read at each sample (the delays : the lines are computed again)
        paramValues[p_fxMxDecay] = fx[its_Efx_Par1];
        r = parCtl(p_fxMxDecay);
        (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? its_Mx_Def(ty, 0) : parV(p_fxMxDecay));
        paramValues[p_fxMxDamp] = fx[its_Efx_Par1 + 2];
        r = parCtl(p_fxMxDamp);
        (r != 0) ? (fx[its_Efx_Par1 + 2] = (r === 8) ? its_Mx_Def(ty, 1) : parV(p_fxMxDamp));
        paramValues[p_fxMxHp] = max(1, fx[its_Efx_Par1 + 10]);
        r = parCtl(p_fxMxHp);
        (r != 0) ? (fx[its_Efx_Par1 + 10] = (r === 8) ? its_Mx_Def(ty, 5) : parV(p_fxMxHp)); // (1 Hz and below : none)
        paramValues[p_fxMxMix] = 100 * fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxMxMix);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? its_Mx_Def(ty, 2) : parV(p_fxMxMix) / 100);
        paramValues[p_fxMxDmin] = fx[its_Efx_Par1 + 4];
        r = parCtl(p_fxMxDmin);
        (r != 0) ? (fx[its_Efx_Par1 + 4] = (r === 8) ? its_Mx_Def(ty, 3) : parV(p_fxMxDmin));
        paramValues[p_fxMxDmax] = fx[its_Efx_Par1 + 5];
        r = parCtl(p_fxMxDmax);
        (r != 0) ? (fx[its_Efx_Par1 + 5] = (r === 8) ? its_Mx_Def(ty, 4) : parV(p_fxMxDmax));
        (ok & 4) ? (
            paramValues[p_fxMxDiff] = fx[its_Efx_Par1 + 6];
            r = parCtl(p_fxMxDiff);
            (r != 0) ? (fx[its_Efx_Par1 + 6] = (r === 8) ? 1 : parV(p_fxMxDiff));
        );
        // the wow (the modulation of the delays) and the glide
        paramValues[p_fxMxWow] = fx[its_Efx_MxX];
        r = parCtl(p_fxMxWow);
        (r != 0) ? (fx[its_Efx_MxX] = (r === 8) ? its_Mx_Def(ty, 6) : parV(p_fxMxWow));
        paramValues[p_fxMxRate] = fx[its_Efx_MxX + 1];
        r = parCtl(p_fxMxRate);
        (r != 0) ? (fx[its_Efx_MxX + 1] = (r === 8) ? its_Mx_Def(ty, 7) : parV(p_fxMxRate));
        paramValues[p_fxMxSpread] = fx[its_Efx_MxX + 2];
        r = parCtl(p_fxMxSpread);
        (r != 0) ? (fx[its_Efx_MxX + 2] = (r === 8) ? 0.25 : parV(p_fxMxSpread));
        paramValues[p_fxMxGlide] = fx[its_Efx_MxX + 3];
        r = parCtl(p_fxMxGlide);
        (r != 0) ? (fx[its_Efx_MxX + 3] = (r === 8) ? 0.05 : parV(p_fxMxGlide));
        // the minimum count of lines (more than the channels : inner lines)
        paramValues[p_fxMxLines] = max(1, fx[its_Efx_MxX + 8]);
        r = parCtl(p_fxMxLines);
        (r != 0) ? (fx[its_Efx_MxX + 8] = (r === 8) ? its_Mx_Def(ty, 8) : max(1, min(its_MxMaxL, floor(parV(p_fxMxLines) + 0.5))));
        // Shimmer : its share, the intervals of the even and of the odd lines, the grain
        sh ? (
            paramValues[p_fxShAmt] = 100 * fx[its_Efx_MxX + 4];
            r = parCtl(p_fxShAmt);
            (r != 0) ? (fx[its_Efx_MxX + 4] = (r === 8) ? 0.6 : parV(p_fxShAmt) / 100);
            k = 0; loop(2,
                paramValues[p_fxShShift + k] = fx[its_Efx_MxX + 5 + k];
                r = parCtl(p_fxShShift + k);
                (r != 0) ? (fx[its_Efx_MxX + 5 + k] = (r === 8) ? 12 : parV(p_fxShShift + k));
                k += 1;
            );
            paramValues[p_fxShGrain] = fx[its_Efx_MxX + 7];
            r = parCtl(p_fxShGrain);
            (r != 0) ? (fx[its_Efx_MxX + 7] = (r === 8) ? 80 : parV(p_fxShGrain));
        );
        // input gain : its linear value is computed by the check
        paramValues[p_fxGain1] = fx[its_Efx_VoldB1];
        r = parCtl(p_fxGain1);
        (r != 0) ? (
            fx[its_Efx_VoldB1] = (r === 8) ? 0 : parV(p_fxGain1);
            fx[its_Efx_Check] = 0;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, ok, p_fxMxModD1, p_fxMxModA1, its_ModN_Mx, its_ModK_Mx);
    );
);

// Flanger, Chorus : line 1, cell 8 = the source (right clic : menu ; left clic : its first channel), cell 9 = the mode (left
// clic : the next one ; right clic : menu), cell 10 = the shape of the sweep (left clic : the next one ; right clic : menu ;
// gray in the barber modes : their ramps), cell 11 = the curve of the shape Curve (left clic : the next curve that exists ;
// right clic : menu), cell 12 = the voices (left clic : + 1 ; right clic : - 1), cell 13 = the seed of the jitter (left
// clic : + 1 ; right clic : - 1 ; Shift + left clic : the prompt), cell 14 = the longest delay possible, cell 15 = "Loop
// sat." when the loop saturates (it
// can grow) ; line 2 : the modulation inputs (delay, rate, feedback) ; sliders : delay, sweep, rate, feedback, mix, spread,
// cross, jitter, damping, high pass, glide, input gain, and the modulations used
function FX_Flanger_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx, ty, md, sh, nv, bm)
(
    ty = fx[its_Efx_Type];
    md = max(0, min(its_FlModeCnt - 1, fx[its_Efx_Par1 + 1]));
    bm = its_Fl_Barber(fx);
    sh = max(0, min(its_FlShCnt - 1, fx[its_Efx_Par1 + 7]));
    nv = max(bm ? 2 : 1, min(its_FlMaxV, floor(fx[its_Efx_Par1 + 9])));
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 12 + its_Mod_SlCount(fx + its_Efx_Mod1, 3, 7);
        RDBL[6] = 0;
    ) :
    (what === FXP_Fill) ? (
        (fx[its_Efx_Src1] !== 0) ? (
            its_Src_Label(pad_Efx_Labs[8], fx[its_Efx_Src1], fx[its_Efx_Off1]);
            pad_Efx_Colrs[8] = Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[8], "Source");
            pad_Efx_Colrs[8] = Col_P1;
        );
        strcpy(pad_Efx_Labs[9], menu_Efx_FlMode_N[md]);
        pad_Efx_Colrs[9] = bm ? Col_P2 : Col_P3;
        strcpy(pad_Efx_Labs[10], menu_Efx_FlShape_N[sh]);
        pad_Efx_Colrs[10] = bm ? Col_Inactive : Col_P3;
        ((sh === its_LfoCurve) && !bm) ? FX_Crv_Fill(fx + its_Efx_Par1 + 5, 11);
        (nv > 1) ? sprintf(pad_Efx_Labs[12], "%d voices", nv) : strcpy(pad_Efx_Labs[12], "1 voice");
        pad_Efx_Colrs[12] = Col_P3;
        sprintf(pad_Efx_Labs[13], "Seed %d", fx[its_Efx_Par1 + 8]);
        pad_Efx_Colrs[13] = Col_P3;
        sprintf(pad_Efx_Labs[14], "Max %.2f s", its_Fl_MaxDelay(fx));
        pad_Efx_Colrs[14] = Col_InfoA;
        its_Fl_Grows(fx, fx[its_Efx_Par1 + 6]) ? (
            strcpy(pad_Efx_Labs[15], "Loop sat.");
            pad_Efx_Colrs[15] = Color_Dark_Orange;
        );
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Fl, 7);
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(fx[its_Efx_Src1], fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Src1] = k;
                    fx[its_Efx_Off1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Off1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 9) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_FlMode, -1, 0);
                ui_menu_tick(menu_Efx_FlMode, md + 1, 1);
                xx = control_jmenu(menu_Efx_FlMode);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_FlMode, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (md + 1) % its_FlModeCnt;
            );
        ) :
        (cell === 10) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_FlShape, -1, 0);
                ui_menu_tick(menu_Efx_FlShape, sh + 1, 1);
                xx = control_jmenu(menu_Efx_FlShape);
                (xx != 0) ? (fx[its_Efx_Par1 + 7] = xx - 1);
                ui_menu_tick(menu_Efx_FlShape, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 7] = (sh + 1) % its_FlShCnt;
            );
        ) :
        ((cell === 11) && (sh === its_LfoCurve) && !bm) ? FX_Crv_Click(fx + its_Efx_Par1 + 5, ev) :
        (cell === 12) ? (
            (ev & ui_jpad_ev_rmc) ? (fx[its_Efx_Par1 + 9] = max(bm ? 2 : 1, nv - 1)) :
            (ev & ui_jpad_ev_lmc) ? (fx[its_Efx_Par1 + 9] = min(its_FlMaxV, nv + 1));
        ) :
        (cell === 13) ? (
            ((ev & ui_jpad_ev_lmc) && (its_PadJmc & shfCap)) ? its_FxEd_Open(fx, fxn, its_Efx_Par1 + 8, 0, 100000, "the seed") :
            (ev & ui_jpad_ev_rmc) ? (fx[its_Efx_Par1 + 8] = max(0, fx[its_Efx_Par1 + 8] - 1)) :
            (ev & ui_jpad_ev_lmc) ? (fx[its_Efx_Par1 + 8] = min(100000, fx[its_Efx_Par1 + 8] + 1));
        ) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Fl, its_ModK_Fl) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // read at each sample (the delay and the sweep : the size of the lines, a new area beyond a power of 2)
        paramValues[p_fxFlDelay] = fx[its_Efx_Par1];
        r = parCtl(p_fxFlDelay);
        (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? its_Fl_Def(ty, 0) : parV(p_fxFlDelay));
        paramValues[p_fxFlSweep] = fx[its_Efx_MxX];
        r = parCtl(p_fxFlSweep);
        (r != 0) ? (fx[its_Efx_MxX] = (r === 8) ? its_Fl_Def(ty, 1) : parV(p_fxFlSweep));
        paramValues[p_fxFlRate] = fx[its_Efx_MxX + 1];
        r = parCtl(p_fxFlRate);
        (r != 0) ? (fx[its_Efx_MxX + 1] = (r === 8) ? its_Fl_Def(ty, 2) : parV(p_fxFlRate));
        paramValues[p_fxFlFb] = fx[its_Efx_Par1 + 6];
        r = parCtl(p_fxFlFb);
        (r != 0) ? (fx[its_Efx_Par1 + 6] = (r === 8) ? its_Fl_Def(ty, 3) : parV(p_fxFlFb));
        paramValues[p_fxFlMix] = 100 * fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxFlMix);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? 0.5 : parV(p_fxFlMix) / 100);
        paramValues[p_fxFlSpread] = fx[its_Efx_Par1 + 4];
        r = parCtl(p_fxFlSpread);
        (r != 0) ? (fx[its_Efx_Par1 + 4] = (r === 8) ? 0.25 : parV(p_fxFlSpread));
        paramValues[p_fxFlCross] = fx[its_Efx_Par1 + 11];
        r = parCtl(p_fxFlCross);
        (r != 0) ? (fx[its_Efx_Par1 + 11] = (r === 8) ? 0 : parV(p_fxFlCross));
        paramValues[p_fxFlJitter] = fx[its_Efx_MxX + 4];
        r = parCtl(p_fxFlJitter);
        (r != 0) ? (fx[its_Efx_MxX + 4] = (r === 8) ? its_Fl_Def(ty, 5) : parV(p_fxFlJitter));
        // the filters of the feedback (0 : none ; the slider of the damping shows none at 24000 Hz)
        paramValues[p_fxMxDamp] = (fx[its_Efx_Par1 + 2] <= 0) ? 24000 : fx[its_Efx_Par1 + 2];
        r = parCtl(p_fxMxDamp);
        (r != 0) ? (fx[its_Efx_Par1 + 2] = (r === 8) ? 0 : parV(p_fxMxDamp));
        paramValues[p_fxMxHp] = max(1, fx[its_Efx_Par1 + 10]);
        r = parCtl(p_fxMxHp);
        (r != 0) ? (fx[its_Efx_Par1 + 10] = (r === 8) ? 0 : parV(p_fxMxHp)); // (1 Hz and below : none)
        paramValues[p_fxMxGlide] = fx[its_Efx_MxX + 3];
        r = parCtl(p_fxMxGlide);
        (r != 0) ? (fx[its_Efx_MxX + 3] = (r === 8) ? 0.05 : parV(p_fxMxGlide));
        // input gain : its linear value is computed by the check
        paramValues[p_fxGain1] = fx[its_Efx_VoldB1];
        r = parCtl(p_fxGain1);
        (r != 0) ? (
            fx[its_Efx_VoldB1] = (r === 8) ? 0 : parV(p_fxGain1);
            fx[its_Efx_Check] = 0;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, 7, p_fxFlModD1, p_fxFlModA1, its_ModN_Fl, its_ModK_Fl);
    );
);

// Phaser : line 1, cell 8 = the source (right clic : menu ; left clic : its first channel), cell 9 = the mode (left clic :
// the next one ; right clic : menu), cell 10 = the shape of the sweep (left clic : the next one ; right clic : menu ; gray
// in the barber modes : their ramps), cell 11 = the curve of the shape Curve (left clic : the next curve that exists ; right
// clic : menu), cell 12 = the seed of the jitter (left clic : + 1 ; right clic : - 1 ; Shift + left clic : the prompt),
// cell 13 = the count of notches and the cut of the highs, the lows or both (its_Ph_Label), cell
// 15 = "Loop sat." when the loop saturates ; line 2 : the modulation inputs (frequency, rate, feedback) ; sliders :
// frequency, sweep, rate, feedback, mix, stages, spacing, Q (Resonant), spread, cross, jitter, glide, input gain, and the
// modulations used
function FX_Phaser_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx, md, sh, bm, rs)
(
    md = max(0, min(its_PhModeCnt - 1, fx[its_Efx_Par1 + 1]));
    bm = its_Ph_Barber(fx);
    rs = (md === its_PhReson);
    sh = max(0, min(its_FlShCnt - 1, fx[its_Efx_Par1 + 7]));
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 12 + rs + its_Mod_SlCount(fx + its_Efx_Mod1, 3, 7);
        RDBL[6] = 0;
    ) :
    (what === FXP_Fill) ? (
        (fx[its_Efx_Src1] !== 0) ? (
            its_Src_Label(pad_Efx_Labs[8], fx[its_Efx_Src1], fx[its_Efx_Off1]);
            pad_Efx_Colrs[8] = Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[8], "Source");
            pad_Efx_Colrs[8] = Col_P1;
        );
        strcpy(pad_Efx_Labs[9], menu_Efx_PhMode_N[md]);
        pad_Efx_Colrs[9] = bm ? Col_P2 : Col_P3;
        strcpy(pad_Efx_Labs[10], menu_Efx_FlShape_N[sh]);
        pad_Efx_Colrs[10] = bm ? Col_Inactive : Col_P3;
        ((sh === its_LfoCurve) && !bm) ? FX_Crv_Fill(fx + its_Efx_Par1 + 5, 11);
        sprintf(pad_Efx_Labs[12], "Seed %d", fx[its_Efx_Par1 + 8]);
        pad_Efx_Colrs[12] = Col_P3;
        its_Ph_Label(pad_Efx_Labs[13], fx);
        pad_Efx_Colrs[13] = Col_InfoA;
        (abs(fx[its_Efx_Par1 + 6]) >= 1) ? (
            strcpy(pad_Efx_Labs[15], "Loop sat.");
            pad_Efx_Colrs[15] = Color_Dark_Orange;
        );
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Ph, 7);
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(fx[its_Efx_Src1], fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Src1] = k;
                    fx[its_Efx_Off1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Off1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 9) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_PhMode, -1, 0);
                ui_menu_tick(menu_Efx_PhMode, md + 1, 1);
                xx = control_jmenu(menu_Efx_PhMode);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_PhMode, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (md + 1) % its_PhModeCnt;
            );
        ) :
        (cell === 10) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_FlShape, -1, 0);
                ui_menu_tick(menu_Efx_FlShape, sh + 1, 1);
                xx = control_jmenu(menu_Efx_FlShape);
                (xx != 0) ? (fx[its_Efx_Par1 + 7] = xx - 1);
                ui_menu_tick(menu_Efx_FlShape, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 7] = (sh + 1) % its_FlShCnt;
            );
        ) :
        ((cell === 11) && (sh === its_LfoCurve) && !bm) ? FX_Crv_Click(fx + its_Efx_Par1 + 5, ev) :
        (cell === 12) ? (
            ((ev & ui_jpad_ev_lmc) && (its_PadJmc & shfCap)) ? its_FxEd_Open(fx, fxn, its_Efx_Par1 + 8, 0, 100000, "the seed") :
            (ev & ui_jpad_ev_rmc) ? (fx[its_Efx_Par1 + 8] = max(0, fx[its_Efx_Par1 + 8] - 1)) :
            (ev & ui_jpad_ev_lmc) ? (fx[its_Efx_Par1 + 8] = min(100000, fx[its_Efx_Par1 + 8] + 1));
        ) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Ph, its_ModK_Ph) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // read at each sample
        paramValues[p_fxPhFreq] = fx[its_Efx_Par1];
        r = parCtl(p_fxPhFreq);
        (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? 800 : parV(p_fxPhFreq));
        paramValues[p_fxPhSweep] = fx[its_Efx_Par1 + 2];
        r = parCtl(p_fxPhSweep);
        (r != 0) ? (fx[its_Efx_Par1 + 2] = (r === 8) ? 4 : parV(p_fxPhSweep));
        paramValues[p_fxFlRate] = fx[its_Efx_MxX + 1];
        r = parCtl(p_fxFlRate);
        (r != 0) ? (fx[its_Efx_MxX + 1] = (r === 8) ? 0.3 : parV(p_fxFlRate));
        paramValues[p_fxFlFb] = fx[its_Efx_Par1 + 6];
        r = parCtl(p_fxFlFb);
        (r != 0) ? (fx[its_Efx_Par1 + 6] = (r === 8) ? 0.5 : parV(p_fxFlFb));
        paramValues[p_fxFlMix] = 100 * fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxFlMix);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? 0.5 : parV(p_fxFlMix) / 100);
        paramValues[p_fxPhStages] = fx[its_Efx_Par1 + 9];
        r = parCtl(p_fxPhStages);
        (r != 0) ? (fx[its_Efx_Par1 + 9] = (r === 8) ? 8 : max(1, min(its_PhMaxS, floor(parV(p_fxPhStages) + 0.5))));
        paramValues[p_fxPhSpacing] = fx[its_Efx_MxX];
        r = parCtl(p_fxPhSpacing);
        (r != 0) ? (fx[its_Efx_MxX] = (r === 8) ? 0 : parV(p_fxPhSpacing));
        rs ? (
            paramValues[p_fxPhQ] = fx[its_Efx_Par1 + 10];
            r = parCtl(p_fxPhQ);
            (r != 0) ? (fx[its_Efx_Par1 + 10] = (r === 8) ? 2 : parV(p_fxPhQ));
        );
        paramValues[p_fxFlSpread] = fx[its_Efx_Par1 + 4];
        r = parCtl(p_fxFlSpread);
        (r != 0) ? (fx[its_Efx_Par1 + 4] = (r === 8) ? 0.25 : parV(p_fxFlSpread));
        paramValues[p_fxFlCross] = fx[its_Efx_Par1 + 11];
        r = parCtl(p_fxFlCross);
        (r != 0) ? (fx[its_Efx_Par1 + 11] = (r === 8) ? 0 : parV(p_fxFlCross));
        paramValues[p_fxFlJitter] = fx[its_Efx_MxX + 4];
        r = parCtl(p_fxFlJitter);
        (r != 0) ? (fx[its_Efx_MxX + 4] = (r === 8) ? 0 : parV(p_fxFlJitter));
        paramValues[p_fxMxGlide] = fx[its_Efx_MxX + 3];
        r = parCtl(p_fxMxGlide);
        (r != 0) ? (fx[its_Efx_MxX + 3] = (r === 8) ? 0.05 : parV(p_fxMxGlide));
        // input gain : its linear value is computed by the check
        paramValues[p_fxGain1] = fx[its_Efx_VoldB1];
        r = parCtl(p_fxGain1);
        (r != 0) ? (
            fx[its_Efx_VoldB1] = (r === 8) ? 0 : parV(p_fxGain1);
            fx[its_Efx_Check] = 0;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, 7, p_fxPhModD1, p_fxPhModA1, its_ModN_Ph, its_ModK_Ph);
    );
);

// Noise : line 1, cell 8 = the color (left clic : the next one ; right clic : menu), cell 9 = its spectrum, the two colors
// of the mode Mix, its kind or the regime of its chaotic map (its_Nz_Label) ; line 2 : the modulation inputs (level,
// density, correlation) ; sliders : level, tilt (Mix), density (Velvet, Dust, Logistic), chaos (Crackle, Logistic), power
// (the shape, not Velvet), correlation, damping, high pass, rumble, its frequency, and the modulations used
function FX_Noise_Pad(RDBL, fx, fxn, what, cell, ev)
local (r, xx, cl, ud, uc, um, us, ok)
(
    cl = its_Nz_Color(fx);
    ud = its_Nz_Dens(cl); uc = its_Nz_Chaos(cl); um = (cl === its_NzMix); us = its_Nz_Shaped(cl);
    ok = its_Nz_ModOk(fx);
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 6 + um + ud + uc + us + its_Mod_SlCount(fx + its_Efx_Mod1, 3, ok);
        RDBL[6] = 0;
    ) :
    (what === FXP_Fill) ? (
        strcpy(pad_Efx_Labs[8], menu_Efx_NzColor_N[cl]);
        pad_Efx_Colrs[8] = Col_P3;
        its_Nz_Label(pad_Efx_Labs[9], fx);
        pad_Efx_Colrs[9] = Col_InfoA;
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Nz, ok);
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_NzColor, -1, 0);
                ui_menu_tick(menu_Efx_NzColor, cl + 1, 1);
                xx = control_jmenu(menu_Efx_NzColor);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_NzColor, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (cl + 1) % its_NzCnt;
            );
        ) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Nz, its_ModK_Nz) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // read at each sample
        paramValues[p_fxNzLevel] = fx[its_Efx_Par1 + 5];
        r = parCtl(p_fxNzLevel);
        (r != 0) ? (fx[its_Efx_Par1 + 5] = (r === 8) ? -12 : parV(p_fxNzLevel));
        um ? (
            paramValues[p_fxNzTilt] = fx[its_Efx_Par1 + 7];
            r = parCtl(p_fxNzTilt);
            (r != 0) ? (fx[its_Efx_Par1 + 7] = (r === 8) ? 0 : parV(p_fxNzTilt));
        );
        ud ? (
            paramValues[p_fxNzDens] = fx[its_Efx_Par1 + 4];
            r = parCtl(p_fxNzDens);
            (r != 0) ? (fx[its_Efx_Par1 + 4] = (r === 8) ? 1000 : parV(p_fxNzDens));
        );
        uc ? (
            paramValues[p_fxNzChaos] = fx[its_Efx_Par1 + 6];
            r = parCtl(p_fxNzChaos);
            (r != 0) ? (fx[its_Efx_Par1 + 6] = (r === 8) ? 0.9 : parV(p_fxNzChaos));
        );
        us ? (
            paramValues[p_fxNzPower] = fx[its_Efx_Par1 + 8];
            r = parCtl(p_fxNzPower);
            (r != 0) ? (fx[its_Efx_Par1 + 8] = (r === 8) ? 1 : parV(p_fxNzPower));
        );
        paramValues[p_fxNzCorr] = fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxNzCorr);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? 0 : parV(p_fxNzCorr));
        // the filters (0 : none ; the slider of the damping shows none at 24000 Hz)
        paramValues[p_fxMxDamp] = (fx[its_Efx_Par1 + 2] <= 0) ? 24000 : fx[its_Efx_Par1 + 2];
        r = parCtl(p_fxMxDamp);
        (r != 0) ? (fx[its_Efx_Par1 + 2] = (r === 8) ? 0 : parV(p_fxMxDamp));
        paramValues[p_fxMxHp] = max(1, fx[its_Efx_Par1 + 10]);
        r = parCtl(p_fxMxHp);
        (r != 0) ? (fx[its_Efx_Par1 + 10] = (r === 8) ? 0 : parV(p_fxMxHp)); // (1 Hz and below : none)
        // the rumble
        paramValues[p_fxNzRumble] = 100 * fx[its_Efx_Par1];
        r = parCtl(p_fxNzRumble);
        (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? 0 : parV(p_fxNzRumble) / 100);
        paramValues[p_fxNzRFreq] = fx[its_Efx_Par1 + 9];
        r = parCtl(p_fxNzRFreq);
        (r != 0) ? (fx[its_Efx_Par1 + 9] = (r === 8) ? 40 : parV(p_fxNzRFreq));
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, ok, p_fxNzModD1, p_fxNzModA1, its_ModN_Nz, its_ModK_Nz);
    );
);

// Random : line 1, cell 8 = the mode (left clic : the next one ; right clic : menu), cell 9 = the law of the draws (the
// same), cell 10 = the clock, common or own (clic), cell 11 = the curve of the law Curve (left clic : the next curve that
// exists ; right clic : menu), cell 12 = the trigger (right clic : menu ; left clic : its first channel), cell 13 = its
// detection, the wave or the envelope (clic ; a trigger) ; line 2 : the modulation inputs (amplitude, rate, jitter) ;
// sliders : rate, amplitude, offset, jitter, correlation, glide, steps, walk (Walk), the threshold (a trigger), the release
// (a trigger, detect Env), and the modulations used
function FX_Random_Pad(RDBL, fx, fxn, what, cell, ev)
local (r, k, xx, md, lw, wm, tr, ev1)
(
    md = max(0, min(its_RnModeCnt - 1, floor(fx[its_Efx_Par1 + 1])));
    lw = max(0, min(its_RnLawCnt - 1, floor(fx[its_Efx_Par1 + 6])));
    wm = (md === its_RnWalk);
    tr = (fx[its_Efx_Src1] !== 0); // a trigger
    ev1 = tr && (fx[its_Efx_Par1 + 11] === its_RnDtEnv); // detected on its envelope
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 7 + wm + tr + ev1 + its_Mod_SlCount(fx + its_Efx_Mod1, 3, 7);
        RDBL[6] = 0;
    ) :
    (what === FXP_Fill) ? (
        strcpy(pad_Efx_Labs[8], menu_Efx_RnMode_N[md]);
        pad_Efx_Colrs[8] = Col_P3;
        strcpy(pad_Efx_Labs[9], menu_Efx_RnLaw_N[lw]);
        pad_Efx_Colrs[9] = Col_P3;
        strcpy(pad_Efx_Labs[10], (fx[its_Efx_Par1 + 7] !== 0) ? "Clock own" : "Clock common");
        pad_Efx_Colrs[10] = (fx[its_Efx_Par1 + 7] !== 0) ? Col_P2 : Col_P3;
        (lw === its_RnCurve) ? FX_Crv_Fill(fx + its_Efx_Par1 + 5, 11);
        tr ? (
            sprintf(pad_Efx_Labs[12], "Trig. %s", its_Src_Label(#its_RnTrig, fx[its_Efx_Src1], fx[its_Efx_Off1]));
            pad_Efx_Colrs[12] = Col_P3;
            strcpy(pad_Efx_Labs[13], ev1 ? "Detect env." : "Detect wave");
            pad_Efx_Colrs[13] = ev1 ? Col_P2 : Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[12], "Trigger");
            pad_Efx_Colrs[12] = Col_P1;
        );
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Rn, 7);
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_RnMode, -1, 0);
                ui_menu_tick(menu_Efx_RnMode, md + 1, 1);
                xx = control_jmenu(menu_Efx_RnMode);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_RnMode, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (md + 1) % its_RnModeCnt;
            );
        ) :
        (cell === 9) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_RnLaw, -1, 0);
                ui_menu_tick(menu_Efx_RnLaw, lw + 1, 1);
                xx = control_jmenu(menu_Efx_RnLaw);
                (xx != 0) ? (fx[its_Efx_Par1 + 6] = xx - 1);
                ui_menu_tick(menu_Efx_RnLaw, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 6] = (lw + 1) % its_RnLawCnt;
            );
        ) :
        ((cell === 10) && (ev & (ui_jpad_ev_lmc | ui_jpad_ev_rmc))) ? (
            fx[its_Efx_Par1 + 7] = (fx[its_Efx_Par1 + 7] !== 0) ? 0 : 1;
            fx[its_Efx_Check] = 0; // (the channels of the trigger : one, or all)
        ) :
        ((cell === 11) && (lw === its_RnCurve)) ? FX_Crv_Click(fx + its_Efx_Par1 + 5, ev) :
        (cell === 12) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(fx[its_Efx_Src1], fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Src1] = k;
                    fx[its_Efx_Off1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Off1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        ((cell === 13) && tr && (ev & (ui_jpad_ev_lmc | ui_jpad_ev_rmc))) ? (
            fx[its_Efx_Par1 + 11] = ev1 ? its_RnDtWave : its_RnDtEnv;
        ) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Rn, its_ModK_Rn) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // read at each sample
        paramValues[p_fxRnRate] = fx[its_Efx_MxX + 1];
        r = parCtl(p_fxRnRate);
        (r != 0) ? (fx[its_Efx_MxX + 1] = (r === 8) ? 1 : parV(p_fxRnRate));
        paramValues[p_fxRnAmp] = fx[its_Efx_Par1 + 2];
        r = parCtl(p_fxRnAmp);
        (r != 0) ? (fx[its_Efx_Par1 + 2] = (r === 8) ? 1 : parV(p_fxRnAmp));
        paramValues[p_fxRnDC] = fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxRnDC);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? 0 : parV(p_fxRnDC));
        paramValues[p_fxRnJitter] = fx[its_Efx_MxX + 4];
        r = parCtl(p_fxRnJitter);
        (r != 0) ? (fx[its_Efx_MxX + 4] = (r === 8) ? 0 : parV(p_fxRnJitter));
        paramValues[p_fxNzCorr] = fx[its_Efx_Par1 + 4];
        r = parCtl(p_fxNzCorr);
        (r != 0) ? (fx[its_Efx_Par1 + 4] = (r === 8) ? 0 : parV(p_fxNzCorr));
        paramValues[p_fxRnGlide] = fx[its_Efx_MxX + 3];
        r = parCtl(p_fxRnGlide);
        (r != 0) ? (fx[its_Efx_MxX + 3] = (r === 8) ? 0 : parV(p_fxRnGlide));
        paramValues[p_fxRnSteps] = fx[its_Efx_Par1 + 8];
        r = parCtl(p_fxRnSteps);
        (r != 0) ? (fx[its_Efx_Par1 + 8] = (r === 8) ? 0 : max(0, min(128, floor(parV(p_fxRnSteps) + 0.5))));
        wm ? (
            paramValues[p_fxRnWalk] = fx[its_Efx_Par1 + 9];
            r = parCtl(p_fxRnWalk);
            (r != 0) ? (fx[its_Efx_Par1 + 9] = (r === 8) ? 0.2 : parV(p_fxRnWalk));
        );
        tr ? (
            paramValues[p_fxRnThr] = fx[its_Efx_Par1 + 10];
            r = parCtl(p_fxRnThr);
            (r != 0) ? (fx[its_Efx_Par1 + 10] = (r === 8) ? 0 : parV(p_fxRnThr));
        );
        ev1 ? (
            paramValues[p_fxRnRel] = fx[its_Efx_MxX + 5];
            r = parCtl(p_fxRnRel);
            (r != 0) ? (fx[its_Efx_MxX + 5] = (r === 8) ? 50 : parV(p_fxRnRel));
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, 7, p_fxRnModD1, p_fxRnModA1, its_ModN_Rn, its_ModK_Rn);
    );
);

// Math : line 1, cell 8 = the source A, cell 9 = the source B (right clic : menu ; left clic : its first channel), cell 10 =
// the operation (left clic : the next one ; right clic : menu), cell 11 = the channels of B, all or one (clic ; a source
// B) ; line 2 : the modulation inputs (scale, value, offset) ; sliders : scale, offset, value (an operation that reads B,
// without source B), attack and release (Env, Slew), the gains of A and B, and the modulations used
function FX_Math_Pad(RDBL, fx, fxn, what, cell, ev)
local (r, k, xx, op, hb, p, ok)
(
    op = max(0, min(its_MtCnt - 1, floor(fx[its_Efx_Par1 + 1])));
    hb = (fx[its_Efx_Src2] !== 0); // a source B
    ok = its_Mt_ModOk(fx);
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 3 + hb + (its_Mt_UsesB(op) && !hb) + 2 * its_Mt_UsesT(op) + its_Mod_SlCount(fx + its_Efx_Mod1, 3, ok);
        RDBL[6] = 0;
    ) :
    (what === FXP_Fill) ? (
        k = 0; loop(2,
            p = fx + its_Efx_Src1 + k * its_EfxDist;
            (p[0] !== 0) ? (
                sprintf(pad_Efx_Labs[8 + k], "%s %s", k ? "B" : "A", its_Src_Label(#its_MtSrcL, p[0], p[its_Efx_Off1 - its_Efx_Src1]));
                pad_Efx_Colrs[8 + k] = Col_P3;
            ) : (
                strcpy(pad_Efx_Labs[8 + k], k ? "Source B" : "Source A");
                pad_Efx_Colrs[8 + k] = Col_P1;
            );
            k += 1;
        );
        strcpy(pad_Efx_Labs[10], menu_Efx_MtOp_N[op]);
        pad_Efx_Colrs[10] = Col_P3;
        hb ? (
            strcpy(pad_Efx_Labs[11], (fx[its_Efx_Par1 + 5] !== 0) ? "B : one" : "B : all");
            pad_Efx_Colrs[11] = (fx[its_Efx_Par1 + 5] !== 0) ? Col_P2 : Col_P3;
        );
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Mt, ok);
    ) :
    (what === FXP_Click) ? (
        ((cell === 8) || (cell === 9)) ? (
            p = fx + its_Efx_Src1 + (cell - 8) * its_EfxDist;
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(p[0], p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
                    p[0] = k;
                    p[its_Efx_Off1 - its_Efx_Src1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
                    p[its_Efx_Off1 - its_Efx_Src1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 10) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_MtOp, -1, 0);
                ui_menu_tick(menu_Efx_MtOp, op + 1, 1);
                xx = control_jmenu(menu_Efx_MtOp);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_MtOp, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (op + 1) % its_MtCnt;
            );
        ) :
        ((cell === 11) && hb && (ev & (ui_jpad_ev_lmc | ui_jpad_ev_rmc))) ? (
            fx[its_Efx_Par1 + 5] = (fx[its_Efx_Par1 + 5] !== 0) ? 0 : 1;
            fx[its_Efx_Check] = 0; // (the channels read from B)
        ) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Mt, its_ModK_Mt) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // read at each sample
        paramValues[p_fxMtScale] = fx[its_Efx_Par1 + 2];
        r = parCtl(p_fxMtScale);
        (r != 0) ? (fx[its_Efx_Par1 + 2] = (r === 8) ? 1 : parV(p_fxMtScale));
        paramValues[p_fxMtDC] = fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxMtDC);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? 0 : parV(p_fxMtDC));
        (its_Mt_UsesB(op) && !hb) ? (
            paramValues[p_fxMtVal] = fx[its_Efx_Par1 + 4];
            r = parCtl(p_fxMtVal);
            (r != 0) ? (fx[its_Efx_Par1 + 4] = (r === 8) ? 1 : parV(p_fxMtVal));
        );
        its_Mt_UsesT(op) ? (
            paramValues[p_fxMtAtt] = fx[its_Efx_Par1 + 6];
            r = parCtl(p_fxMtAtt);
            (r != 0) ? (fx[its_Efx_Par1 + 6] = (r === 8) ? 1 : parV(p_fxMtAtt));
            paramValues[p_fxMtRel] = fx[its_Efx_Par1 + 7];
            r = parCtl(p_fxMtRel);
            (r != 0) ? (fx[its_Efx_Par1 + 7] = (r === 8) ? 100 : parV(p_fxMtRel));
        );
        // the gains of A and B : their linear values are computed by the check
        k = 0; loop(1 + hb,
            p = fx + its_Efx_Src1 + k * its_EfxDist;
            paramValues[p_fxGain1 + k] = p[its_Efx_VoldB1 - its_Efx_Src1];
            r = parCtl(p_fxGain1 + k);
            (r != 0) ? (
                p[its_Efx_VoldB1 - its_Efx_Src1] = (r === 8) ? 0 : parV(p_fxGain1 + k);
                fx[its_Efx_Check] = 0;
            );
            k += 1;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, ok, p_fxMtModD1, p_fxMtModA1, its_ModN_Mt, its_ModK_Mt);
    );
);

// Ring : line 1, cell 8 = the source A, cell 9 = the carrier B (right clic : menu ; left clic : its first channel), cell 10 =
// the mode (left clic : the next one ; right clic : menu), cell 11 = the shape of the oscillator (no source B : left clic,
// the next one ; right clic, menu) or the channels of B, all or one (clic), cell 12 = the curve of the shape Curve ;
// line 2 : the modulation inputs (frequency, amount, mix) ; sliders : frequency, detune, spread (the oscillator), amount
// (AM), mix, the gains of A and B, and the modulations used
function FX_Ring_Pad(RDBL, fx, fxn, what, cell, ev)
local (r, k, xx, md, sh, hb, p, ok)
(
    md = max(0, min(its_RgModeCnt - 1, floor(fx[its_Efx_Par1 + 1])));
    sh = max(0, min(its_FlShCnt - 1, floor(fx[its_Efx_Par1 + 7])));
    hb = (fx[its_Efx_Src2] !== 0); // a carrier B
    ok = its_Rg_ModOk(fx);
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 2 + 3 * !hb + (md === its_RgAM) + hb + its_Mod_SlCount(fx + its_Efx_Mod1, 3, ok);
        RDBL[6] = 0;
    ) :
    (what === FXP_Fill) ? (
        k = 0; loop(2,
            p = fx + its_Efx_Src1 + k * its_EfxDist;
            (p[0] !== 0) ? (
                sprintf(pad_Efx_Labs[8 + k], "%s %s", k ? "B" : "A", its_Src_Label(#its_MtSrcL, p[0], p[its_Efx_Off1 - its_Efx_Src1]));
                pad_Efx_Colrs[8 + k] = Col_P3;
            ) : (
                strcpy(pad_Efx_Labs[8 + k], k ? "Carrier B" : "Source A");
                pad_Efx_Colrs[8 + k] = Col_P1;
            );
            k += 1;
        );
        strcpy(pad_Efx_Labs[10], menu_Efx_RgMode_N[md]);
        pad_Efx_Colrs[10] = Col_P3;
        hb ? (
            strcpy(pad_Efx_Labs[11], (fx[its_Efx_Par1 + 9] !== 0) ? "B : one" : "B : all");
            pad_Efx_Colrs[11] = (fx[its_Efx_Par1 + 9] !== 0) ? Col_P2 : Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[11], menu_Efx_FlShape_N[sh]);
            pad_Efx_Colrs[11] = Col_P3;
            (sh === its_LfoCurve) ? FX_Crv_Fill(fx + its_Efx_Par1 + 5, 12);
        );
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Rg, ok);
    ) :
    (what === FXP_Click) ? (
        ((cell === 8) || (cell === 9)) ? (
            p = fx + its_Efx_Src1 + (cell - 8) * its_EfxDist;
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(p[0], p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
                    p[0] = k;
                    p[its_Efx_Off1 - its_Efx_Src1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
                    p[its_Efx_Off1 - its_Efx_Src1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 10) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_RgMode, -1, 0);
                ui_menu_tick(menu_Efx_RgMode, md + 1, 1);
                xx = control_jmenu(menu_Efx_RgMode);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_RgMode, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (md + 1) % its_RgModeCnt;
            );
        ) :
        ((cell === 11) && hb && (ev & (ui_jpad_ev_lmc | ui_jpad_ev_rmc))) ? (
            fx[its_Efx_Par1 + 9] = (fx[its_Efx_Par1 + 9] !== 0) ? 0 : 1;
            fx[its_Efx_Check] = 0; // (the channels read from B)
        ) :
        ((cell === 11) && !hb) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_FlShape, -1, 0);
                ui_menu_tick(menu_Efx_FlShape, sh + 1, 1);
                xx = control_jmenu(menu_Efx_FlShape);
                (xx != 0) ? (fx[its_Efx_Par1 + 7] = xx - 1);
                ui_menu_tick(menu_Efx_FlShape, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 7] = (sh + 1) % its_FlShCnt;
            );
        ) :
        ((cell === 12) && !hb && (sh === its_LfoCurve)) ? FX_Crv_Click(fx + its_Efx_Par1 + 5, ev) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Rg, its_ModK_Rg) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // read at each sample
        !hb ? (
            paramValues[p_fxRgFreq] = fx[its_Efx_Par1];
            r = parCtl(p_fxRgFreq);
            (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? 440 : parV(p_fxRgFreq));
            paramValues[p_fxRgDetune] = fx[its_Efx_Par1 + 6];
            r = parCtl(p_fxRgDetune);
            (r != 0) ? (fx[its_Efx_Par1 + 6] = (r === 8) ? 0 : parV(p_fxRgDetune));
            paramValues[p_fxRgSpread] = fx[its_Efx_Par1 + 4];
            r = parCtl(p_fxRgSpread);
            (r != 0) ? (fx[its_Efx_Par1 + 4] = (r === 8) ? 0 : parV(p_fxRgSpread));
        );
        (md === its_RgAM) ? (
            paramValues[p_fxRgAmt] = fx[its_Efx_Par1 + 8];
            r = parCtl(p_fxRgAmt);
            (r != 0) ? (fx[its_Efx_Par1 + 8] = (r === 8) ? 1 : parV(p_fxRgAmt));
        );
        paramValues[p_fxRgMix] = 100 * fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxRgMix);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? 1 : parV(p_fxRgMix) / 100);
        // the gains of A and B : their linear values are computed by the check
        k = 0; loop(1 + hb,
            p = fx + its_Efx_Src1 + k * its_EfxDist;
            paramValues[p_fxGain1 + k] = p[its_Efx_VoldB1 - its_Efx_Src1];
            r = parCtl(p_fxGain1 + k);
            (r != 0) ? (
                p[its_Efx_VoldB1 - its_Efx_Src1] = (r === 8) ? 0 : parV(p_fxGain1 + k);
                fx[its_Efx_Check] = 0;
            );
            k += 1;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, ok, p_fxRgModD1, p_fxRgModA1, its_ModN_Rg, its_ModK_Rg);
    );
);

// the cell of the source of a meter (VU meter, Limiter : cell 8) : its label ; a clic (right : the menu of the sources ;
// left : its first channel)
function FX_Meter_Src(fx, what, ev) local(p, k)
(
    p = fx + its_Efx_Src1;
    (what === FXP_Fill) ? (
        (p[0] !== 0) ? (
            its_Src_Label(pad_Efx_Labs[8], p[0], p[its_Efx_Off1 - its_Efx_Src1]);
            pad_Efx_Colrs[8] = Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[8], "Source");
            pad_Efx_Colrs[8] = Col_P1;
        );
    ) :
    (ev & ui_jpad_ev_rmc) ? (
        ((k = its_Src_Choose(p[0], p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
            p[0] = k;
            p[its_Efx_Off1 - its_Efx_Src1] = its_Src_ChOff;
            fx[its_Efx_Check] = 0;
        );
    ) :
    (ev & ui_jpad_ev_lmc) ? (
        ((k = its_Off_Choose(p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
            p[its_Efx_Off1 - its_Efx_Src1] = k;
            fx[its_Efx_Check] = 0;
        );
    );
);

// the engine of a meter (VU meter, Limiter) : after the header of its work area, when it is in place and made (0 : none)
function FX_Meter_Eng(fx) local(wk)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx)) && (wk[its_FxW_Md] === 1)) ? wk + its_FxW_Hdr : 0;
);

/*
    VU meter (2026-11-11 : the plugin Multichannel_VU_meter, see GM-Meters) : line 1, cell 8 = the source (right clic :
    menu ; left clic : its first channel), 9 = the GUI mode, 10 = the saturation threshold, 11 = the meter color, 12 = the
    saturation auto clear (left clic : the next one, Shift : the previous one ; right clic : menu), 13 = clear the peaks ;
    sliders : the sample time, the highlighted channel, the gain of the source ; the graphic area (all the height left) :
    the meters of the plugin (left clic : clear the peaks ; right clic : the menu of the plugin) ; the source goes
    unchanged to the output (the settings : Par1 ... Par6, see GM-Meters)
*/
function FX_VU_Pad(RDBL, fx, fxn, what, cell, ev)
local (p, k, m, d, r, st, e)
(
    st = fx + its_Efx_Par1;
    (what === FXP_Dims) ? (
        RDBL[3] = 2;
        RDBL[5] = 3;
        RDBL[6] = -its_VuGraphH; // (negative : all the height left, see show_Effect_Pad)
    ) :
    (what === FXP_Fill) ? (
        FX_Meter_Src(fx, what, 0);
        vu_Nth(vu_ModeList, max(0, min(3, 0|st[1])), pad_Efx_Labs[9]);
        sprintf(pad_Efx_Labs[10], "Over %s", vu_Nth(vu_ThrList, max(0, min(8, 0|st[3])), #its_VuS));
        vu_Nth(vu_ColList, max(0, min(5, 0|st[4])), pad_Efx_Labs[11]);
        sprintf(pad_Efx_Labs[12], "Clear: %s", vu_Nth(vu_HoldList, max(0, min(3, 0|st[5])), #its_VuS));
        strcpy(pad_Efx_Labs[13], "Clear peaks");
        pad_Efx_Colrs[9] = pad_Efx_Colrs[10] = pad_Efx_Colrs[11] = pad_Efx_Colrs[12] = Col_P3;
        pad_Efx_Colrs[13] = Col_InfoA;
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            FX_Meter_Src(fx, what, ev);
        ) :
        ((cell >= 9) && (cell <= 12)) ? (
            k = (cell === 9) ? 1 : (cell === 10) ? 3 : (cell === 11) ? 4 : 5; // the setting
            m = (cell === 9) ? 4 : (cell === 10) ? 9 : (cell === 11) ? 6 : 4; // its count of values
            d = (its_PadJmc & shfCap) ? -1 : 1;
            (ev & ui_jpad_ev_rmc) ? (
                r = vu_ListMenu((cell === 9) ? vu_ModeLong : (cell === 10) ? vu_ThrList : (cell === 11) ? vu_ColList : vu_HoldLong,
                    m, 0|st[k]);
                (r >= 0) ? (st[k] = r);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                st[k] = ((0|st[k]) + d + m) % m;
            );
        ) :
        ((cell === 13) && (ev & (ui_jpad_ev_lmc | ui_jpad_ev_rmc))) ? (
            ((e = FX_Meter_Eng(fx)) > 0) ? (e[vu_Clr] = 1);
        );
    ) :
    (what === FXP_Sliders) ? (
        // read by the engine at each sample
        paramValues[p_fxVuTime] = st[0];
        r = parCtl(p_fxVuTime);
        (r != 0) ? (st[0] = (r === 8) ? 45 : max(25, min(1000, parV(p_fxVuTime))));
        paramValues[p_fxVuHl] = st[2];
        r = parCtl(p_fxVuHl);
        (r != 0) ? (st[2] = (r === 8) ? 0 : max(0, min(128, floor(parV(p_fxVuHl) + 0.5))));
        // the gain of the source : its linear value is computed by the check
        p = fx + its_Efx_Src1;
        paramValues[p_fxGain1] = p[its_Efx_VoldB1 - its_Efx_Src1];
        r = parCtl(p_fxGain1);
        (r != 0) ? (
            p[its_Efx_VoldB1 - its_Efx_Src1] = (r === 8) ? 0 : parV(p_fxGain1);
            fx[its_Efx_Check] = 0;
        );
    ) :
    (what === FXP_Graph) ? (
        e = FX_Meter_Eng(fx);
        ui_push();
            ui_pad(2, 2, 2, 2);
            !(mouse_cap & 8) ? vu_Mouse(st, e); // (Shift + right clic : the Studio menu)
            vu_Draw(st, e, max(1, min(128, floor(fx[its_Efx_CCnt]))), 0);
        ui_pop();
        (fx[its_Efx_Status] === its_EfxStat_On) ? (ui_GFXdoNow |= 4); // (the meters move)
    );
);

/*
    Limiter (2026-11-11 : the plugin SmoothMultiLimiter, see GM-Meters) : line 1, cell 8 = the source (right clic : menu ;
    left clic : its first channel), 9 = the gain reduction (its max since the last frame), 10 = the latency (the
    anticipation : the source is delayed by it) ; sliders : the 8 sliders of the plugin (limit, pre-gain, volume out,
    attack = the anticipation, release, distortion, zoom, channels displayed) ; the graphic area (all the height left) : the
    response of the soft clipper, the history of the loudest channels and of the peak envelope (the settings : Par1 ...
    Par8, see GM-Meters)
*/
function FX_Limiter_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, j, r, v, st, e)
(
    st = fx + its_Efx_Par1;
    (what === FXP_Dims) ? (
        RDBL[3] = 2;
        RDBL[5] = 8;
        RDBL[6] = -its_VuGraphH; // (negative : all the height left, see show_Effect_Pad)
    ) :
    (what === FXP_Fill) ? (
        FX_Meter_Src(fx, what, 0);
        v = lm_Reduction(FX_Meter_Eng(fx));
        sprintf(pad_Efx_Labs[9], "Reduction %.1f dB", v);
        pad_Efx_Colrs[9] = (v > 0.1) ? Color_Goldenrod : Color_Limegreen;
        sprintf(pad_Efx_Labs[10], "Latency %.1f ms", lm_Latency(st));
        pad_Efx_Colrs[10] = Col_P1;
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? FX_Meter_Src(fx, what, ev);
    ) :
    (what === FXP_Sliders) ? (
        // read by the engine at each sample ; the order of the sliders of the plugin : limit, pre-gain, volume, attack,
        // release, distortion, zoom, display (right clic : their default value)
        k = 0;
        loop(8,
            j = (k === 0) ? 0 : (k === 1) ? 4 : (k === 2) ? 5 : (k === 3) ? 6 : (k === 4) ? 7 : (k === 5) ? 3 : (k === 6) ? 2 : 1;
            paramValues[p_fxLmLimit + k] = st[j];
            r = parCtl(p_fxLmLimit + k);
            (r != 0) ? (
                st[j] = (r === 8) ? ((j === 0) ? -3 : (j === 1) ? 4 : (j === 2) ? 1 : (j === 6) ? 10 : (j === 7) ? 100 : 0) :
                    parV(p_fxLmLimit + k);
                (j === 1) ? (st[1] = max(1, min(lm_NDMax, floor(st[1] + 0.5))));
            );
            k += 1;
        );
    ) :
    (what === FXP_Graph) ? (
        ui_push();
            ui_pad(2, 2, 2, 2);
            lm_Draw(FX_Meter_Eng(fx), 0);
        ui_pop();
        (fx[its_Efx_Status] === its_EfxStat_On) ? (ui_GFXdoNow |= 4); // (the history moves)
    );
);

// the dispatcher : calls the function of the type of the effect (a type without function : the common line only)
function FX_Type_Pad(RDBL, fx, fxn, what, cell, ev)
local (ty)
(
    ty = fx[its_Efx_Type];
    ((ty === its_Efx_TyMixer) || (ty === its_Efx_TyAutoMix)) ? (
        FX_Mixer_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyLFO) ? (
        FX_LFO_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyFilter) ? (
        FX_Filter_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TySat) ? (
        FX_Sat_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    its_Mx_Is(ty) ? (
        FX_Matrix_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    its_Fl_Is(ty) ? (
        FX_Flanger_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyPhaser) ? (
        FX_Phaser_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyNoise) ? (
        FX_Noise_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyRandom) ? (
        FX_Random_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyMath) ? (
        FX_Math_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyRing) ? (
        FX_Ring_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyVU) ? (
        FX_VU_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyLimiter) ? (
        FX_Limiter_Pad(RDBL, fx, fxn, what, cell, ev);
    ) : (
        (what === FXP_Dims) ? (RDBL[3] = 1; RDBL[5] = 0;);
    );
);

/*
    RDBL[0] : number of the effect to display
    RDBL[3] : lines of the pad (set by the function of the type)
    RDBL[5] : count of sliders (set by the function of the type)
    Line 0, common to all types :
        0 effect number (left clic : next one, shift : previous one ; right clic : menu)
        1 type (right clic : menu ; creates the effect if needed)
        2 phase (left clic : next one ; right clic : menu)
        3 On / Off / Bypass (left clic : On / Off ; right clic : Bypass / On)
        4 channel count (right clic : menu)
        5 output : own cable, Out or a bus (right clic : menu ; left clic : first channel in the bus)
        6 error (last error of exec_fx)
        7 actions (right clic : menu)
    Lines 1 ... 3 and the sliders : the function of the type (FX_Type_Pad) ; cell 23 (not the LFO) : the auto-limiter
        (clic : On / Off ; On : the gain reduction in dB)
    Key 'd' : dump of the effect in the log
*/
function show_Effect_Pad(RDBL, blockId)
local (h1, h2, h3, uix_jneed, zzmi, jmc, fxn, fx, fok, dfCol, CL1, i, k, r, xx, wgh, zz, zzmcl, act)
(
    its_FxEd_Take(); // (a value edited in the prompt, its_FxEd_Open)
    fxn = RDBL[0]; // number of the effect to be displayed
    fx = Effects_set[fxn];
    fok = (fx > BASE_MEMORY) && (fx[-2] === KW_effx);
    RDBL[6] = 0; // graphic area : set by the type
    fok ? FX_Type_Pad(RDBL, fx, fxn, FXP_Dims, 0, 0) : (RDBL[3] = 1; RDBL[5] = 0;);
    h1 = uix_jpadHeight(RDBL[3]);
    h2 = (RDBL[5] > 0) ? ui_jd_slidh * RDBL[5] + 6 : 0;
    h3 = RDBL[6];
    (h3 < 0) ? (h3 = max(-h3, ui_height() - h1 - h2 - ui_jd_ctgr)); // (negative : all the height left, at least -h3)
    uix_jneed = h1+h2+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            // 'd' : dump of the effect in the log (taken before the pad)
            (zzmi && fok && GM_key_take('d')) ? GM_Dump(fx, its_Efx_BlkSize, sprintf(#, "Effect %d", fxn+1));
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
                (g__dpa != 0) ? (
                    // audio file droped here : ignored (but consumed)
                    sprintf(#s, "Effect::drop file : \"%s\" - %d, %d, %d", g__efs, g__msx, g__msy, g__msc);
                    mSL_log(SysLogBox, #s);
                    g__dpa = 0;
                );
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Efx_Labs, pad_Efx_Siz);
                CL1 = Color_Cornflower_Blue;
                dfCol = fok ? Col_InfoA : Col_Inactive;
                i = 0; loop(pad_Efx_Siz,
                    pad_Efx_Colrs[i] = dfCol;
                    strcpy(pad_Efx_Labs[i],"");
                    i += 1;);
                (fok && (fx[its_Efx_Owner] > 0)) ? sprintf(pad_Efx_Labs[0],"Effect %d (%s)", fxn+1, its_Al_OwnName(#its_OwnN, fx[its_Efx_Owner])) :
                    sprintf(pad_Efx_Labs[0],"Effect %d", fxn+1);
                (fok) ? (
                    strcpy(pad_Efx_Labs[1], menu_Efx_Type_N[max(0, min(its_Efx_TyCnt - 1, fx[its_Efx_Type]))]);
                    pad_Efx_Colrs[1] = Col_P3;
                    strcpy(pad_Efx_Labs[2], menu_Efx_PhShort_N[max(0, min(2, fx[its_Efx_Phase]))]);
                    pad_Efx_Colrs[2] = CL1;
                    (fx[its_Efx_Status] === its_EfxStat_Bypass) ? (
                        strcpy(pad_Efx_Labs[3], "Bypass");
                        pad_Efx_Colrs[3] = Color_Goldenrod;
                    ) :
                    (fx[its_Efx_Status] !== its_EfxStat_Off) ? (
                        strcpy(pad_Efx_Labs[3], "On");
                        pad_Efx_Colrs[3] = Color_Limegreen;
                    ) : (
                        strcpy(pad_Efx_Labs[3], "Off");
                        pad_Efx_Colrs[3] = Color_Dark_Orange;
                    );
                    sprintf(pad_Efx_Labs[4], "Channels %d", fx[its_Efx_CCnt]);
                    pad_Efx_Colrs[4] = Color_Heliotrope;
                    its_Out_Label(pad_Efx_Labs[5], fx[its_Efx_OutK], fx[its_Efx_OutOff]);
                    pad_Efx_Colrs[5] = Col_P3;
                    (fx[its_Efx_Status] === its_EfxStat_Off) ? (
                        strcpy(pad_Efx_Labs[6], "---");
                    ) :
                    ((k = fx[its_Efx_Error]) !== 0) ? (
                        sprintf(pad_Efx_Labs[6], "Err: %04d", k);
                        pad_Efx_Colrs[6] = Col_P6;
                    ) :
                    (fx[its_Efx_Check] === BLOCK_CHECK) ? (
                        strcpy(pad_Efx_Labs[6], "OK");
                        pad_Efx_Colrs[6] = Color_Limegreen;
                    ) : (
                        strcpy(pad_Efx_Labs[6], "...");
                    );
                    FX_Type_Pad(RDBL, fx, fxn, FXP_Fill, 0, 0);
                    !its_Fx_Ctl(fx[its_Efx_Type]) ? (
                        (fx[its_Efx_Lim]) ? (
                            sprintf(pad_Efx_Labs[23], "Limiter %.1f dB", -20 * log10(max(1, fx[its_Efx_LimEnv])));
                            pad_Efx_Colrs[23] = (fx[its_Efx_LimEnv] > 1.012) ? Color_Goldenrod : Color_Limegreen; // > 0.1 dB
                        ) : (
                            strcpy(pad_Efx_Labs[23], "Limiter Off");
                            pad_Efx_Colrs[23] = Col_P1;
                        );
                    );
                ) : (
                    strcpy(pad_Efx_Labs[1], menu_Efx_Type_N[0]);
                    pad_Efx_Colrs[1] = Col_P1;
                );
                strcpy(pad_Efx_Labs[7],"Action");
                pad_Efx_Colrs[7] = Col_P1;

                its_PadJmc = jmc; // mouse modifiers, for the functions of the types (see its_Mod_Click)
                zz = control_jpad(pad_Effect, RDBL[3], -1, 1);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzmcl = pad_Effect[ui_jpad_last]-1;

                    ((zz & ui_jpad_ev_rmc) || ((zz & ui_jpad_ev_lmc) && (zzmcl === 7))) ? (  // right mouse clic (the cell "Action" : left clic too)
                        ((zzmcl === 3) && fok) ? (
                            fx[its_Efx_Status] = (fx[its_Efx_Status] !== its_EfxStat_Bypass) ? its_EfxStat_Bypass : its_EfxStat_On;
                            its_Run_Check(fx);
                        ) :
                        (zzmcl === 0) ? (
                            // the effect to display
                            ui_menu_tick(menu_Efx_Ids, fxn+1, 1);
                            // also tick the header of the sub-menu that holds the current effect (reset below by the tick -1)
                            wgh = menu_Efx_Ids[ui_jmenu_items + (0|(fxn / menu_Efx_Grp)) * (menu_Efx_Grp + 1)];
                            str_setchar(wgh, 1, '!');
                            xx = control_jmenu(menu_Efx_Ids);
                            (xx != 0) ? (
                                RDBL[0] = xx - 1; // select a new effect to display
                            );
                            ui_menu_tick(menu_Efx_Ids, -1, 0);
                        ) :
                        (zzmcl === 1) ? (
                            // the type (the effect is created if needed)
                            ui_menu_tick(menu_Efx_Type, -1, 0);
                            ui_menu_tick(menu_Efx_Type, (fok ? fx[its_Efx_Type] : 0) + 1, 1);
                            xx = control_jmenu(menu_Efx_Type);
                            (xx != 0) ? (
                                (!fok) ? (fx = FX_make(fxn); fok = 1;);
                                FX_Set_Type(fx, xx - 1);
                            );
                            ui_menu_tick(menu_Efx_Type, -1, 0);
                        ) :
                        ((zzmcl === 2) && fok) ? (
                            ui_menu_tick(menu_Efx_Phase, -1, 0);
                            ui_menu_tick(menu_Efx_Phase, fx[its_Efx_Phase] + 1, 1);
                            xx = control_jmenu(menu_Efx_Phase);
                            (xx != 0) ? (
                                fx[its_Efx_Phase] = xx - 1;
                            );
                            ui_menu_tick(menu_Efx_Phase, -1, 0);
                        ) :
                        ((zzmcl === 4) && fok) ? (
                            k = fx[its_Efx_CCnt];
                            ui_menu_tick(menu_128_1_Ids, -1, 0);
                            ui_menu_tick(menu_128_1_Ids, k, 1);
                            // also tick the header of the sub-menu that holds the current count (reset below by the tick -1)
                            (k >= 1) ? (
                                wgh = menu_128_1_Ids[ui_jmenu_items + (0|((k - 1) / menu_128_Grp)) * (menu_128_Grp + 1)];
                                str_setchar(wgh, 1, '!');
                            );
                            xx = control_jmenu(menu_128_1_Ids); // select a count
                            (xx != 0) ? (
                                fx[its_Efx_CCnt] = xx;
                                fx[its_Efx_Check] = 0;
                            );
                            ui_menu_tick(menu_128_1_Ids, -1, 0);
                        ) :
                        ((zzmcl === 5) && fok) ? (
                            ((k = its_Dst_Choose(fx[its_Efx_OutK], fx[its_Efx_OutOff])) >= 0) ? (
                                fx[its_Efx_OutK] = k;
                                fx[its_Efx_OutOff] = its_Src_ChOff;
                                fx[its_Efx_Check] = 0;
                            );
                        ) :
                        (zzmcl === 7) ? (
                            xx = its_Menu_Clic(menu_Efx_Action, zz);
                            act = xx - 1;
                            (act === its_EfxAct_Create) ? (
                                (!fok) ? FX_make(fxn);
                            ) :
                            (!fok) ? (
                                0; // the other actions need an effect
                            ) :
                            (act === its_EfxAct_Patch) ? (
                                its_Xp_Ask(1, its_TK_Effect, fxn);
                            ) :
                            (act === its_EfxAct_Copy) ? (
                                (Effects_set[FX_CNT] === 0) ? FX_make(FX_CNT); // the reserve
                                FX_Copy(Effects_set[FX_CNT], fx);
                            ) :
                            (act === its_EfxAct_Paste) ? (
                                (Effects_set[FX_CNT] !== 0) ? (
                                    FX_Copy(fx, Effects_set[FX_CNT]);
                                    fx[its_Efx_Numb] = fxn;
                                    fx[its_Efx_Check] = 0;
                                );
                            ) :
                            (act === its_EfxAct_Clear) ? (
                                FX_Clear(fxn);
                            ) :
                            (act === its_EfxAct_AutoGains) ? (
                                FX_Auto_Gains(fx);
                            ) :
                            (act === its_EfxAct_Show) ? (
                                GM_Dump(fx, its_Efx_BlkSize, sprintf(#, "Effect %d", fxn+1));
                            ) :
                            (act === its_EfxAct_Delete) ? (
                                FX_Delete(fxn);
                                fok = 0;
                            );
                        ) :
                        ((zzmcl === 23) && fok && !its_Fx_Ctl(fx[its_Efx_Type])) ? (
                            // the auto-limiter : On / Off
                            fx[its_Efx_Lim] = !fx[its_Efx_Lim];
                            fx[its_Efx_LimEnv] = 0;
                        ) :
                        ((zzmcl >= 8) && fok) ? (
                            FX_Type_Pad(RDBL, fx, fxn, FXP_Click, zzmcl, zz);
                        );
                    );

                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        (zzmcl === 0) ? (
                            // the next effect (shift : the previous one)
                            RDBL[0] = (jmc & shfCap) ? (fxn + FX_CNT - 1) % FX_CNT : (fxn + 1) % FX_CNT;
                        ) :
                        ((zzmcl === 2) && fok) ? (
                            fx[its_Efx_Phase] = (fx[its_Efx_Phase] + 1) % 3;
                        ) :
                        ((zzmcl === 3) && fok) ? (
                            fx[its_Efx_Status] = (fx[its_Efx_Status] === its_EfxStat_On) ? its_EfxStat_Off : its_EfxStat_On;
                            its_Run_Check(fx);
                        ) :
                        ((zzmcl === 5) && fok) ? (
                            ((k = its_Off_Choose(fx[its_Efx_OutOff])) >= 0) ? (
                                fx[its_Efx_OutOff] = k;
                                fx[its_Efx_Check] = 0;
                            );
                        ) :
                        ((zzmcl === 23) && fok && !its_Fx_Ctl(fx[its_Efx_Type])) ? (
                            // the auto-limiter : On / Off
                            fx[its_Efx_Lim] = !fx[its_Efx_Lim];
                            fx[its_Efx_LimEnv] = 0;
                        ) :
                        ((zzmcl >= 8) && fok) ? (
                            FX_Type_Pad(RDBL, fx, fxn, FXP_Click, zzmcl, zz);
                        );
                    );
                );
            ui_pop();

            // Graphic area of the type (the pad may have changed the effect)
            fx = Effects_set[RDBL[0]];
            ((h3 > 0) && (RDBL[0] === fxn) && (fx > BASE_MEMORY) && (fx[-2] === KW_effx)) ? (
                ui_split_top(h3);
                    FX_Type_Pad(RDBL, fx, fxn, FXP_Graph, 0, 0);
                ui_pop();
            );

            // Sliders of the type (the pad may have changed the effect)
            fx = Effects_set[RDBL[0]];
            ((h2 > 0) && (RDBL[0] === fxn) && (fx > BASE_MEMORY) && (fx[-2] === KW_effx)) ? (
                ui_split_top(h2);
                    ui_pad(1,3,1,0);
                    FX_Type_Pad(RDBL, fx, fxn, FXP_Sliders, 0, 0);
                ui_pop();
            );

        ui_pop();
    );
);

/*
    WDBL[0] : number of writer to display
    WDBL[5] : waveform height (0 : its_LinWaveH) ; WDBL[6] : waveform flags (its_WaveHide, its_WaveOver)
    The pad (2 lines of 8 cells), the waveform of the line of the writer (if any), the sliders (record gain, overdub)
    Key 'd' : dump of the writer in the log ; keys 'w', '+', '-', 'v' : the waveform (see its_Wave_Keys)
    Cells : 0 writer number (left clic : next one, shift : previous one), 1 status, 2 mode (left clic : X-fade -> Sum -> W-Mix),
            3 line, 4 size, 5 channels, 6 first channel written, 7 channels used (3, 6, 7 : right or left clic, menus),
            10 source (right clic : menu ; left clic : first channel taken), 11 write position (s), 13 W-Mix : the phase of the cycle,
            15 actions (right or left clic : menus)
*/
function show_Writer_Pad(WDBL, blockId)
local (h1, h2, h3, h4, h5, uix_jneed, uix_jmini, zzmi, jmc, wrt, wcbl, wok, lcbl, lok, CL1, dfCol, i, k, r, w, x, xx, zi, zz, zzch,
        zzent, zzmcl, zzmmd, wgh, f, n, wm)
(
    h1 = uix_jpadHeight(pad_Wrt_NL); // height
    wrt = WDBL[0]; // number of writer to be displayed
    wcbl = Writers_set[wrt];
    wok = (wcbl > BASE_MEMORY) && (wcbl[-2] === KW_writ);
    lcbl = wok ? wcbl[its_Wrt_Lcbl] : 0;
    lok = wok && (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
    // sliders : record gain, overdub (W-Mix : its 5 settings)
    wm = wok && (wcbl[its_Wrt_Mode] === its_WrtMode_WMix);
    h2 = wok ? ui_jd_slidh * (wm ? 6 : 2) + 6 : 0;
    h3 = lok ? its_Wave_H(WDBL + 5, WDBL + 6, its_LinWaveH) : 0; // waveform of the line, between the pad and the sliders
    h4 = wok ? uix_jpadHeight(1) : 0; // the modulation inputs
    // under their line : the sliders of the inputs used (depth, attenuverter if shown)
    h5 = wok ? its_Mod_SlCount(wcbl + its_Wrt_Mod1, its_Wrt_ModShown(wcbl), its_Wrt_ModOk(wcbl)) : 0;
    h5 = (h5 > 0) ? ui_jd_slidh * h5 + 6 : 0;
    uix_jneed = h1+h2+h3+h4+h5+ui_jd_ctgr;
    uix_jmini = h1+h2+h4+h5+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(min(uix_jneed, ui_height()));
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            // 'd' : dump of the writer in the log (taken before the pad)
            (zzmi && GM_key_take('d')) ? GM_Dump(wcbl, its_Wrt_BlkSize, sprintf(#, "Writer %d", wrt+1));
            (zzmi) ? its_Wave_Keys(WDBL + 5, WDBL + 6, its_LinWaveH);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Wrt_Labs, pad_Wrt_Siz);
                CL1 = Color_Cornflower_Blue;
                dfCol = wok ? Col_InfoA : Col_Inactive;
                i = 0; loop(pad_Wrt_Siz,
                    pad_Wrt_Colrs[i] = dfCol;
                    strcpy(pad_Wrt_Labs[i],"");
                    i += 1;);
                (wok && (wcbl[its_Wrt_Owner] > 0)) ? sprintf(pad_Wrt_Labs[0],"Writer %d (%s)", wrt+1, its_Al_OwnName(#its_OwnN, wcbl[its_Wrt_Owner])) :
                    sprintf(pad_Wrt_Labs[0],"Writer %d", wrt+1);
                (wok) ? (
                    strcpy(pad_Wrt_Labs[1],menu_Wrt_Status_N[wcbl[its_Wrt_Status]]);
                    // status : Ready (blue), Paused (orange), Writing (green), else the default color (as for the readers)
                    k = wcbl[its_Wrt_Status];
                    pad_Wrt_Colrs[1] = (k === its_WrtStat_Ready) ? Color_Light_Steel_Blue :
                        (k === its_WrtStat_Paused) ? Color_Dark_Orange :
                        (k === its_WrtStat_Writing) ? Color_Limegreen : dfCol;
                    (lok) ? (
                        // the channels written, as in exec_writer
                        f = max(0, min(wcbl[its_Wrt_ChNbr] - 1, wcbl[its_Wrt_Bf1stChan]));
                        n = wcbl[its_Wrt_ChNbr] - f;
                        (wcbl[its_Wrt_BfChanUsed] > 0) ? (n = min(n, wcbl[its_Wrt_BfChanUsed]));
                        sprintf(pad_Wrt_Labs[3], "Line %d", wcbl[its_Wrt_LineNb]+1);
                        sprintf(pad_Wrt_Labs[4], "Size %.3f s", floor(1000*wcbl[its_Wrt_SmplCnt]/srate)/1000);
                        sprintf(pad_Wrt_Labs[5], "Channels %d", wcbl[its_Wrt_ChNbr]);
                        sprintf(pad_Wrt_Labs[6], "First %d", f);
                        sprintf(pad_Wrt_Labs[7], "Used %d", n);
                        sprintf(pad_Wrt_Labs[11], "Pos %.3f s", (wcbl[its_Wrt_Abspos] - wcbl[its_Wrt_Start]) / srate);
                        pad_Wrt_Colrs[3] = pad_Wrt_Colrs[4] = pad_Wrt_Colrs[5] =
                        pad_Wrt_Colrs[6] = pad_Wrt_Colrs[7] = Color_Heliotrope;
                        pad_Wrt_Colrs[11] = CL1;
                    ) : (
                        strcpy(pad_Wrt_Labs[3],"Line: None");
                    );
                    its_Src_Label(pad_Wrt_Labs[10], wcbl[its_Wrt_Src], wcbl[its_Wrt_SrcOff]);
                    pad_Wrt_Colrs[10] = Col_P3;
                    k = wcbl[its_Wrt_Mode];
                    strcpy(pad_Wrt_Labs[2], (k === its_WrtMode_WMix) ? "W-Mix" : (k === its_WrtMode_Sum) ? "Overdub Sum" : "Overdub X-fade");
                    pad_Wrt_Colrs[2] = CL1;
                    // modes X-fade and Sum : the direction of the writing (orange while it goes backward, forward and
                    // backward : green while it goes forward ; W-Mix has its own)
                    (k !== its_WrtMode_WMix) ? (
                        strcpy(pad_Wrt_Labs[8], menu_Wrt_Dir_N[max(0, min(its_WrtDirCnt - 1, 0|wcbl[its_Wrt_Dir]))]);
                        pad_Wrt_Colrs[8] = (wcbl[its_Wrt_Step] < 0) ? Color_Dark_Orange :
                            (wcbl[its_Wrt_Dir] === its_WrtDir_Both) ? Color_Limegreen : CL1;
                    );
                    (k === its_WrtMode_WMix) ? (
                        // the phase of the cycle, and its remaining time
                        k = wcbl[its_Wrt_WPhase];
                        (k === its_WMix_FadeIn) ? sprintf(pad_Wrt_Labs[13], "Fade-in %.2f s", wcbl[its_Wrt_WCnt] / srate) :
                        (k === its_WMix_Plateau) ? sprintf(pad_Wrt_Labs[13], "Plateau %.2f s", wcbl[its_Wrt_WCnt] / srate) :
                        (k === its_WMix_FadeOut) ? sprintf(pad_Wrt_Labs[13], "Fade-out %.2f s", wcbl[its_Wrt_WCnt] / srate) :
                        (k === its_WMix_Wait) ? sprintf(pad_Wrt_Labs[13], "Wait %.2f s", wcbl[its_Wrt_WCnt] / srate) :
                        strcpy(pad_Wrt_Labs[13], "New cycle");
                        pad_Wrt_Colrs[13] = ((k === its_WMix_Wait) || (k === its_WMix_Cycle)) ? Col_P1 :
                            (wcbl[its_Wrt_WInc] < 0) ? Color_Dark_Orange : Color_Limegreen; // (backwards : orange)
                    );
                ) : (
                    strcpy(pad_Wrt_Labs[1],menu_Wrt_Status_N[0]);
                    strcpy(pad_Wrt_Labs[3],"Line: None");
                );
                strcpy(pad_Wrt_Labs[15],"Action");
                pad_Wrt_Colrs[15] = Col_P1;

                zz = control_jpad(pad_Writer);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzch = pad_Writer[ui_jpad_lkey];
                    zzent = pad_Writer[ui_jpad_entkey]-1;
                    zzmcl = pad_Writer[ui_jpad_last]-1;
                    zzmmd = pad_Writer[ui_jpad_lmods];

                    // right mouse clic (the cells "Line", "first", "used" and "Action" : left clic too)
                    ((zz & ui_jpad_ev_rmc) || ((zz & ui_jpad_ev_lmc) && ((zzmcl === 3) || (zzmcl === 6) || (zzmcl === 7) || (zzmcl === 15)))) ? (
                        (zzmcl === 0) ? (
                            // the writer to display
                            k = wrt+1;
                            ui_menu_tick(menu_Wrt_Ids, k, 1);
                            // also tick the header of the sub-menu that holds the current writer (reset below by the tick -1)
                            wgh = menu_Wrt_Ids[ui_jmenu_items + (0|(wrt / menu_Wrt_Grp)) * (menu_Wrt_Grp + 1)];
                            str_setchar(wgh, 1, '!');
                            xx = control_jmenu(menu_Wrt_Ids);
                            (xx != 0) ? (
                                WDBL[0] = xx - 1; // select a new writer to display
                            );
                            ui_menu_tick(menu_Wrt_Ids, -1, 0);
                        ) :
                        (zzmcl === 1) ? (
                            (wok) ? (
                                k = wcbl[its_Wrt_Status]+1;
                                ui_menu_tick(menu_Wrt_Status, -1, 0);
                                ui_menu_tick(menu_Wrt_Status, k, 1);
                                xx = control_jmenu(menu_Wrt_Status);
                                (xx != 0) ? (
                                    r = Wr_Set_Status(wrt, xx - 1);
                                );
                                ui_menu_tick(menu_Wrt_Status, -1, 0);
                            );
                        ) :
                        (zzmcl === 3) ? (
                            // the line written (the writer is created if needed)
                            k = (wok) ? wcbl[its_Wrt_LineNb]+2 : 1;
                            ui_menu_tick(menu_Lin_SIds, -1, 0);
                            ui_menu_tick(menu_Lin_SIds, k, 1);
                            // also tick the header of the sub-menu that holds the current line (reset below by the tick -1)
                            (k > 1) ? (
                                wgh = menu_Lin_SIds[ui_jmenu_items + 2 + (0|((k - 2) / menu_Lin_Grp)) * (menu_Lin_Grp + 1)];
                                str_setchar(wgh, 1, '!');
                            );
                            xx = its_Menu_Clic(menu_Lin_SIds, zz); // select a line (right or left clic)
                            (xx != 0) ? (
                                (xx === 1) ? (
                                    r = (wok) ? Wr_Set_Line(wrt, -1) : 0; // "None"
                                ) : (
                                    (!wok) ? (wcbl = Wr_Action(its_WrtAct_Create, wrt, 0));
                                    r = Wr_Set_Line(wrt, xx - 2);
                                );
                            );
                            ui_menu_tick(menu_Lin_SIds, -1, 0);
                        ) :
                        (zzmcl === 6) ? (
                            (lok) ? (
                                k = f + 1;
                                ui_menu_tick(menu_128_0_Ids, -1, 0);
                                ui_menu_tick(menu_128_0_Ids, k, 1);
                                // also tick the header of the sub-menu that holds the current channel (reset below by the tick -1)
                                wgh = menu_128_0_Ids[ui_jmenu_items + (0|((k - 1) / menu_128_Grp)) * (menu_128_Grp + 1)];
                                str_setchar(wgh, 1, '!');
                                xx = its_Menu_Clic(menu_128_0_Ids, zz); // select a number
                                (xx != 0) ? (
                                    wcbl[its_Wrt_Bf1stChan] = xx - 1;
                                    wcbl[its_Wrt_Check] = 0; // (source width)
                                );
                                ui_menu_tick(menu_128_0_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 7) ? (
                            (lok) ? (
                                k = n;
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                                ui_menu_tick(menu_128_1_Ids, k, 1);
                                // also tick the header of the sub-menu that holds the current count (reset below by the tick -1)
                                (k >= 1) ? (
                                    wgh = menu_128_1_Ids[ui_jmenu_items + (0|((k - 1) / menu_128_Grp)) * (menu_128_Grp + 1)];
                                    str_setchar(wgh, 1, '!');
                                );
                                xx = its_Menu_Clic(menu_128_1_Ids, zz); // select a count
                                (xx != 0) ? (
                                    wcbl[its_Wrt_BfChanUsed] = xx;
                                    wcbl[its_Wrt_Check] = 0; // (source width)
                                );
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 8) ? (
                            // the direction of the writing (modes X-fade and Sum)
                            (wok && (wcbl[its_Wrt_Mode] !== its_WrtMode_WMix)) ? (
                                ui_menu_tick(menu_Wrt_Dir, -1, 0);
                                ui_menu_tick(menu_Wrt_Dir, max(0, min(its_WrtDirCnt - 1, 0|wcbl[its_Wrt_Dir])) + 1, 1);
                                xx = control_jmenu(menu_Wrt_Dir);
                                (xx != 0) ? Wr_Set_Dir(wcbl, xx - 1);
                                ui_menu_tick(menu_Wrt_Dir, -1, 0);
                            );
                        ) :
                        (zzmcl === 10) ? (
                            // the source (left clic : the first channel taken in the source)
                            ((wok) && ((x = its_Src_Choose(wcbl[its_Wrt_Src], wcbl[its_Wrt_SrcOff])) >= 0)) ? (
                                wcbl[its_Wrt_Src] = x;
                                wcbl[its_Wrt_SrcOff] = its_Src_ChOff;
                                wcbl[its_Wrt_Check] = 0;
                                Wr_Set_Status(wrt, wcbl[its_Wrt_Status]); // no source : "Created"
                            );
                        ) :
                        (zzmcl === 15) ? (
                            xx = its_Menu_Clic(menu_Wrt_Action, zz);
                            (xx === its_WrtAct_Patch + 1) ? (
                                its_Xp_Ask(1, its_TK_Writer, wrt);
                            ) :
                            ((xx > 1) && (xx !== its_WrtAct_Patch)) ? (
                                wcbl = Wr_Action(xx - 1, wrt, 0);
                            );
                        );
                    );

                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        (zzmcl === 0) ? (
                            // the next writer (shift : the previous one)
                            WDBL[0] = (jmc & shfCap) ? (wrt + WR_CNT - 1) % WR_CNT : (wrt + 1) % WR_CNT;
                        );
                        ((zzmcl === 1) && wok) ? (
                            // status : Ready or Paused -> Writing ; Writing -> Paused
                            w = wcbl[its_Wrt_Status];
                            ((w === its_WrtStat_Ready) || (w === its_WrtStat_Paused) || (w === its_WrtStat_Writing)) ? (
                                r = Wr_Set_Status(wrt, (w === its_WrtStat_Writing) ? its_WrtStat_Paused : its_WrtStat_Writing);
                            );
                        );
                        ((zzmcl === 10) && wok) ? (
                            ((x = its_Off_Choose(wcbl[its_Wrt_SrcOff])) >= 0) ? (
                                wcbl[its_Wrt_SrcOff] = x;
                                wcbl[its_Wrt_Check] = 0;
                            );
                        );
                        ((zzmcl === 2) && wok) ? (
                            // the mode : X-fade -> Sum -> W-Mix -> X-fade (shift : the other way) ; W-Mix starts a new cycle
                            wcbl[its_Wrt_Mode] = (max(0, min(its_WrtModeCnt - 1, 0|wcbl[its_Wrt_Mode])) +
                                ((jmc & shfCap) ? its_WrtModeCnt - 1 : 1)) % its_WrtModeCnt;
                            wcbl[its_Wrt_WPhase] = its_WMix_Cycle;
                            wcbl[its_Wrt_Check] = 0; // (the modulation inputs meaningful)
                        );
                        ((zzmcl === 8) && wok && (wcbl[its_Wrt_Mode] !== its_WrtMode_WMix)) ? (
                            // the direction : forward -> backward -> forward and backward -> forward (shift : the other way)
                            Wr_Set_Dir(wcbl, (max(0, min(its_WrtDirCnt - 1, 0|wcbl[its_Wrt_Dir])) +
                                ((jmc & shfCap) ? its_WrtDirCnt - 1 : 1)) % its_WrtDirCnt);
                        );
                    );
                );
            ui_pop();

            // the pad may have changed the writer
            wcbl = Writers_set[wrt];
            wok = (wcbl > BASE_MEMORY) && (wcbl[-2] === KW_writ);
            lcbl = wok ? wcbl[its_Wrt_Lcbl] : 0;
            lok = wok && (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);

            // the modulation inputs : record gain, overdub (W-Mix : record gain, its 5 settings)
            (wok && (h4 > 0)) ? (
                ui_split_top(h4);
                    ui_pad(1,2,2,2);
                    its_Mod_Row(wcbl + its_Wrt_Mod1, its_Wrt_ModShown(wcbl), its_ModN_Wrt, its_Wrt_ModOk(wcbl), its_ModD_Wrt,
                        its_ModK_Wrt) ? (wcbl[its_Wrt_Check] = 0);
                ui_pop();
            );
            // their sliders : the depths of the inputs used, their attenuverters if shown
            (wok && (h5 > 0)) ? (
                ui_split_top(h5);
                    ui_pad(1,3,1,0);
                    its_Mod_Sliders(wcbl + its_Wrt_Mod1, its_Wrt_ModShown(wcbl), its_Wrt_ModOk(wcbl), p_wrModDepth1, p_wrModAtt1,
                        its_ModN_Wrt, its_ModK_Wrt);
                ui_pop();
            );

            // Waveform of the line (all its channels), with the heads of the writers and readers of the line
            (lok && (h3 > 0)) ? (
                w = min(h3, ui_height() - h2); // the sliders keep their place
                (w >= its_RdrWaveMin) ? (
                    ui_split_top(w);
                        ui_pad(1,2,1,2);
                        its_wave_marks(lcbl, -1);
                        ui_audio_wave(w, lcbl[its_Lin_ChCnt], lcbl + its_Lin_BF1ST, lcbl[its_Lin_ActBSize],
                            lcbl[its_Lin_Start], lcbl[its_Lin_Last], its_Wave_Flags(WDBL + 6), its_LinWaveMax);
                    ui_pop();
                );
            );

            // Sliders
            (wok && (h2 > 0)) ? (
                ui_split_top(h2);
                    ui_pad(1,3,1,0);

                    // Record gain
                    paramValues[p_wrGain] = zi = wcbl[its_Wrt_InGaindB];
                    r = parCtl(p_wrGain);
                    (r != 0) ? (
                        zi = (r === 8) ? 0 : parV(p_wrGain); // right clic : 0 dB
                        wcbl[its_Wrt_InGaindB] = zi;
                        wcbl[its_Wrt_InGain] = (zi <= -120) ? 0 : 10^(zi/20);
                    );

                    (wcbl[its_Wrt_Mode] === its_WrtMode_WMix) ? (
                        // W-Mix : fade, plateau, wait, direction, desync (right clic : the default)
                        i = 0; loop(5,
                            paramValues[p_wrWFade + i] = wcbl[its_Wrt_WFade + i];
                            r = parCtl(p_wrWFade + i);
                            (r != 0) ? (wcbl[its_Wrt_WFade + i] = (r === 8) ? its_WMix_Def[i] : parV(p_wrWFade + i));
                            i += 1;
                        );
                    ) : (
                        // Overdub
                        paramValues[p_wrOvrdb] = wcbl[its_Wrt_Ovrdb];
                        r = parCtl(p_wrOvrdb);
                        (r != 0) ? (
                            zi = (r === 8) ? 0 : max(-150, min(150, parV(p_wrOvrdb))); // right clic : no overdub
                            wcbl[its_Wrt_Ovrdb] = zi;
                        );
                    );
                ui_pop();
            );

        ui_pop();
    );
);



flagpr = 1;

/*
    The generic sliders (automatable by REAPER, -1 ... 1) : they write the control cells Ctl 1 ... NB_GSL (see @block),
    that the modules take as sources (menu of the sources : "Controls").
    The module : one line of cells (0 "Controls", 1 ... the pages of 8 sliders : left clic), then the 8 sliders of the page
    (right clic on a slider : 0)
*/
// set the generic slider "k" [0 ... NB_GSL-1] to "v", for REAPER too (automation)
function show_Controls_Pad(blockId)
local (h1, h2, uix_jneed, zzmi, i, n, r, zz, zzmcl, pg, npg)
(
    npg = pad_Ctl_Siz - 1; // pages of 8 sliders
    pg = ControlsStruct[0] = max(0, min(npg - 1, 0|ControlsStruct[0]));
    h1 = uix_jpadHeight(1);
    h2 = 8 * ui_jd_slidh + 6;
    uix_jneed = h1+h2+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Ctl_Labs, pad_Ctl_Siz);
                i = 0; loop(pad_Ctl_Siz,
                    pad_Ctl_Colrs[i] = Col_InfoA;
                    strcpy(pad_Ctl_Labs[i],"");
                    i += 1;);
                strcpy(pad_Ctl_Labs[0],"Controls");
                i = 0; loop(npg,
                    sprintf(pad_Ctl_Labs[1 + i], "%d-%d", 8 * i + 1, min(NB_GSL, 8 * i + 8));
                    pad_Ctl_Colrs[1 + i] = (i === pg) ? Color_Limegreen : Col_P1;
                    i += 1;
                );
                zz = control_jpad(pad_Controls);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 35;
                    zzmcl = pad_Controls[ui_jpad_last]-1;
                    ((zz & ui_jpad_ev_lmc) && (zzmcl >= 1) && (zzmcl <= npg)) ? (
                        ControlsStruct[0] = pg = zzmcl - 1; // the page shown
                    );
                );
            ui_pop();

            // the 8 sliders of the page
            ui_split_top(h2);
                ui_pad(1,3,1,0);
                i = 0; loop(8,
                    n = 8 * pg + i;
                    (n < NB_GSL) ? (
                        sprintf(#ctllab, "Ctl %d: %%.3f", n + 1);
                        r = slider_ctl(#ctllab, slider(GSL_FIRST + n), -1, 1, 0, 0, 0.001);
                        (r & 8) ? its_Ctl_Set(n, 0) : (r != 0) ? its_Ctl_Set(n, uix_jsl_val);
                    );
                    i += 1;
                );
            ui_pop();

        ui_pop();
    );
);

// the own cables that exist (readers 0 ... RD_CNT-1, then effects RD_CNT ...) : its_PchCbl[0 ... its_PchCblN-1]
function its_Pch_Cables()
local (i)
(
    its_PchCblN = 0;
    i = 0; loop(RD_CNT + FX_CNT,
        (((i < RD_CNT) ? CblRdStart[i] : CblFxStart[i - RD_CNT]) > 0) ? (
            its_PchCbl[its_PchCblN] = i;
            its_PchCblN += 1;
        );
        i += 1;
    );
);

// the cell shown in the entry "e" of the grid of the view "v" (page "pg") ; 0 : none (a cable : its first cell)
function its_Pch_GridCell(v, pg, e)
local (k, m)
(
    k = pg * pad_PchG_Siz + e;
    (v === its_PchV_In) ? ((k < CH_NB) ? IN_P + k : 0) :
    (v === its_PchV_Out) ? ((k < CH_NB) ? OUT_P + k : 0) :
    (v === its_PchV_Bus) ? ((k < BusActN) ? BusStart[BusAct[k]] : 0) :
    (v === its_PchV_Ctl) ? ((k < NB_CTL) ? CTL_P + k : 0) :
    (k < its_PchCblN) ? (
        m = its_PchCbl[k];
        (m < RD_CNT) ? CblRdStart[m] : CblFxStart[m - RD_CNT];
    ) : 0;
);

// the count of the readers of the cable "m" (its_PchCbl), and its width in its_PchCblW
function its_Pch_CblReads(m)
local (c, kr)
(
    c = (m < RD_CNT) ? CblRdStart[m] : CblFxStart[m - RD_CNT];
    its_PchCblW = (m < RD_CNT) ? CblRdWidth[m] : CblFxWidth[m - RD_CNT];
    kr = 0; loop(its_PchCblW, kr += its_PchR[c]; c += 1;);
    kr;
);

// the text of the writer "the track" of the cells In (Patch) : with the input gain if it is very low, or the samples ignored
function its_Pch_TrackTxt(str)
(
    (its_GlSmpl === 1) ? strcpy(str, "the track (ignored : Globals)") :
    ((its_GlSmpl === 0) && (its_GlInGain <= its_InGainLow)) ? sprintf(str, "the track (Input Gain %.0f dB)", its_GlInGain) :
    strcpy(str, "the track");
    str;
);

// the cell of the entry "k" (all pages) of the view "v", and who writes and who reads it (see its_Patch_Scan(cell)) ; 0 : none
function its_Pch_Info(v, k)
local (c, m)
(
    ((c = its_Pch_GridCell(v, 0, k)) > 0) ? (
        // a cable, a bus : all its cells
        m = its_PchCbl[k];
        its_PchCellW = (v === its_PchV_Cbl) ? ((m < RD_CNT) ? CblRdWidth[m] : CblFxWidth[m - RD_CNT]) :
            (v === its_PchV_Bus) ? BusWidth[BusAct[k]] : 1;
        its_Patch_Scan(c);
        its_PchCellW = 1;
    );
    c;
);

/*
    open the module "t" ('R' reader, 'W' writer, 'E' effect, 'L' line, 'C' curve) n° "n" (menu of a cell of the module
    "Connections", the summary modules, "Patch") : nothing to do if a display module (Reader A ... H, Writer A ... H,
    Effect A ... P, Line A ... H, Curves A ... H) of
    the visible panes of the tab shows it ; else the first one of these panes shows it ("nw" : not this way) ; else a display
    module not used in the tab is added just below the module "bk" (the one that asks), in its pane (blockDesc : the pane
    being drawn) ; 0 : no room
*/
function its_Mod_Open(t, n, bk, nw)
local (b0, st, sz, p, d, i, m, fd, fs, used, k, nv)
(
    nv = 8; // the views of the type (the effects : its_EfxViews)
    (t === 'R') ? (b0 = blockReaderA; st = ReadersStructA; sz = ReadersBlockSize;) :
    (t === 'W') ? (b0 = blockWriterA; st = WriterStructA; sz = WriterBlockSize;) :
    (t === 'L') ? (b0 = blockLineA; st = LinesStructA; sz = LinesBlockSize;) :
    (t === 'C') ? (b0 = blockCurvesA; st = its_CrvEd; sz = its_CrvEdSz; nv = its_CrvEdN;) : // (the curve shown : its_CrvEd[e * its_CrvEdSz])
    (b0 = blockEffectA; st = EffectsStructA; sz = LinesBlockSize; nv = its_EfxViews;); // (the effects : LinesBlockSize, see EffectsStructA)
    fd = fs = -1; used = 0;
    p = 0; loop(dcbPannelsMax,
        d = dcbBlocksAll + (TabIdt * dcbPannelsMax + p) * dcbWSize;
        i = 0; loop(dcbMax,
            m = d[i] - b0;
            ((m >= 0) && (m < nv)) ? (
                used |= 2 ^ m;
                (p < studDispPCnt) ? (
                    (st[m * sz] === n) ? (fs = m) : (fd < 0) ? (fd = m);
                );
            );
            i += 1;
        );
        p += 1;
    );
    (fs >= 0) ? 1 :
    ((fd >= 0) && !nw) ? (
        st[fd * sz] = n;
        1;
    ) : (
        m = 0; while ((m < nv) && (used & (2 ^ m))) (m += 1;);
        k = 0; while ((k < dcbMax) && (blockDesc[k] !== bk)) (k += 1;);
        ((blockDesc > 0) && (m < nv) && (k < dcbMax - 1) && (blockDesc[dcbMax - 1] === 0)) ? (
            i = dcbMax - 1; while (i > k + 1) (blockDesc[i] = blockDesc[i - 1]; i -= 1;);
            blockDesc[k + 1] = b0 + m;
            st[m * sz] = n;
            1;
        ) : 0;
    );
);

/*
    The pad of the module "Connections" (blockPatch, PatchStruct ; until 2026-11-07 its name was "Patch")
    line 1 : 0 "Connections", 1 ... 5 the views (In, Out, Buses, Controls, Cables ; the buses and the cables that exist), 6 the page (left clic : the next one ;
    right clic : the previous one), 7 the count of problems (connections not valid, buses read but not written,
    cables not read)
    the grid : one cell of the patch per entry (the cables : one cable per entry) ; colors : green written and read,
    orange written but not read, red read but not written (buses), grey unused ; left clic : pins the entry (again : unpins it),
    shown [between brackets] ; right clic : the menu of the modules that write or read it, the chosen one is opened (its_Mod_Open)
    the text : the cell under the mouse (else the pinned one), its value, who writes it, who reads it
*/
function show_Patch_Pad(blockId)
local (h1, h2, h3, uix_jneed, zzmi, i, k, c, w, v, pg, npg, ncel, nl, zz, zzmcl, nbad, hc, hk, hx, hy, kw, kr, ch, e, xx, pin)
(
    v = PatchStruct[0] = max(0, min(its_PchV_Cnt - 1, 0|PatchStruct[0]));
    its_Pch_Cables();
    ncel = ((v === its_PchV_In) || (v === its_PchV_Out)) ? CH_NB :
        (v === its_PchV_Bus) ? BusActN : (v === its_PchV_Ctl) ? NB_CTL : its_PchCblN;
    npg = max(1, ceil(ncel / pad_PchG_Siz));
    pg = PatchStruct[1] = max(0, min(npg - 1, 0|PatchStruct[1]));
    nl = max(1, min(pad_PchG_NL, ceil((ncel - pg * pad_PchG_Siz) / 8)));
    h1 = uix_jpadHeight(1);
    h2 = uix_jpadHeight(nl);
    h3 = uix_jBoxHeight(3);
    uix_jneed = h1+h2+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            its_Patch_Scan(-1);
            // the problems : connections not valid, buses read but not written, cables not read
            nbad = its_PchBad;
            i = 0; loop(BusActN,
                k = BusStart[BusAct[i]]; kw = kr = 0;
                loop(BusWidth[BusAct[i]], kw += its_PchW[k]; kr += its_PchR[k]; k += 1;);
                ((kr > 0) && (kw === 0)) ? (nbad += 1);
                i += 1;
            );
            i = 0; loop(its_PchCblN,
                (its_Pch_CblReads(its_PchCbl[i]) === 0) ? (nbad += 1);
                i += 1;
            );

            // the views
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Pch_Labs, pad_Pch_Siz);
                i = 0; loop(pad_Pch_Siz, pad_Pch_Colrs[i] = Col_InfoA; i += 1;);
                strcpy(pad_Pch_Labs[0], "Connections");
                strcpy(pad_Pch_Labs[1], "In");
                strcpy(pad_Pch_Labs[2], "Out");
                strcpy(pad_Pch_Labs[3], "Buses");
                strcpy(pad_Pch_Labs[4], "Controls");
                strcpy(pad_Pch_Labs[5], "Cables");
                i = 0; loop(its_PchV_Cnt, pad_Pch_Colrs[1 + i] = (i === v) ? Color_Limegreen : Col_P1; i += 1;);
                sprintf(pad_Pch_Labs[6], "Page %d / %d", pg + 1, npg);
                pad_Pch_Colrs[6] = (npg > 1) ? Col_P3 : Col_Inactive;
                (nbad > 0) ? (
                    sprintf(pad_Pch_Labs[7], "Problems %d", nbad);
                    pad_Pch_Colrs[7] = Col_P6;
                ) : (
                    strcpy(pad_Pch_Labs[7], "No problem");
                    pad_Pch_Colrs[7] = Color_Limegreen;
                );
                zz = control_jpad(pad_Patch);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    zzmcl = pad_Patch[ui_jpad_last]-1;
                    ((zz & ui_jpad_ev_lmc) && (zzmcl >= 1) && (zzmcl <= its_PchV_Cnt)) ? (
                        PatchStruct[0] = zzmcl - 1; // another view : its first page
                        PatchStruct[1] = 0;
                    ) :
                    (zzmcl === 6) ? (
                        (zz & ui_jpad_ev_lmc) ? (PatchStruct[1] = (pg + 1) % npg) :
                        (zz & ui_jpad_ev_rmc) ? (PatchStruct[1] = (pg + npg - 1) % npg);
                    );
                );
            ui_pop();

            // the grid of the cells
            ui_split_top(h2);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_PchG_Labs, 8 * nl);
                hk = 0; // the entry under the mouse + 1 (all pages)
                i = 0; loop(8 * nl,
                    c = its_Pch_GridCell(v, pg, i);
                    k = pg * pad_PchG_Siz + i;
                    pad_PchG_Colrs[i] = Col_Inactive;
                    (c > 0) ? (
                        (v === its_PchV_Cbl) ? (
                            // a cable : read if one of its cells is read
                            ch = its_PchCbl[k];
                            kr = its_Pch_CblReads(ch);
                            (ch < RD_CNT) ? sprintf(pad_PchG_Labs[i], "R%d [%d]", ch + 1, its_PchCblW) :
                                sprintf(pad_PchG_Labs[i], "E%d [%d]", ch - RD_CNT + 1, its_PchCblW);
                            pad_PchG_Colrs[i] = (kr > 0) ? Color_Limegreen : Color_Dark_Orange;
                        ) :
                        (v === its_PchV_Bus) ? (
                            // a bus : all its channels
                            ch = BusAct[k];
                            kw = kr = 0; w = c; loop(BusWidth[ch], kw += its_PchW[w]; kr += its_PchR[w]; w += 1;);
                            sprintf(pad_PchG_Labs[i], "Bus %d [%d]", ch + 1, BusWidth[ch]);
                            pad_PchG_Colrs[i] = ((kw > 0) && (kr > 0)) ? Color_Limegreen :
                                (kw > 0) ? Color_Dark_Orange : (kr > 0) ? Col_P6 : Col_Inactive;
                        ) : (
                            kw = its_PchW[c]; kr = its_PchR[c];
                            (v === its_PchV_In) ? sprintf(pad_PchG_Labs[i], "In:%d", k) :
                            (v === its_PchV_Out) ? sprintf(pad_PchG_Labs[i], "Out:%d", k) :
                            sprintf(pad_PchG_Labs[i], "Ctl %d", k + 1);
                            // In (the channels of the track) and the controls are written by REAPER (the track, the sliders),
                            // Out is read by REAPER (the channels of the track)
                            // (the input muted : In is not written, a cell read is red)
                            (v === its_PchV_In) ? (kw = (k < chcnt) && (vol_inp !== 0)) : (v === its_PchV_Ctl) ? (kw = 1) :
                            (v === its_PchV_Out) ? (kr += ((kw > 0) && (k < chcnt)));
                            pad_PchG_Colrs[i] = ((kw > 0) && (kr > 0)) ? Color_Limegreen :
                                (kw > 0) ? Color_Dark_Orange : (kr > 0) ? Col_P6 : Col_Inactive;
                            (((v === its_PchV_In) || (v === its_PchV_Ctl)) && (kr === 0)) ? (pad_PchG_Colrs[i] = Col_Inactive);
                        );
                        ((PatchStruct[2] === k + 1) && (PatchStruct[3] === v)) ? (
                            strcpy(#its_PchName, pad_PchG_Labs[i]);
                            sprintf(pad_PchG_Labs[i], "[%s]", #its_PchName);
                        );
                    );
                    i += 1;
                );
                zz = control_jpad(pad_PatchG, nl, -1, 1);
                // the entry under the mouse (geometry of the pad just drawn, see ui_jpad_cell_pos)
                (ui_hover() && (ui_jpad_lst_wi > 0) && (ui_jpad_lst_he > 0)) ? (
                    hx = floor((uix_mouse_x - ui_jpad_lst_left) / ui_jpad_lst_wi);
                    hy = floor((uix_mouse_y - ui_jpad_lst_top) / ui_jpad_lst_he);
                    ((hx >= 0) && (hx < 8) && (hy >= 0) && (hy < nl)) ? (hk = pg * pad_PchG_Siz + hy * 8 + hx + 1);
                );
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    e = pad_PatchG[ui_jpad_last] - 1; // the entry in the page
                    k = pg * pad_PchG_Siz + e;
                    ((e >= 0) && (e < 8 * nl) && (its_Pch_GridCell(v, pg, e) > 0)) ? (
                        (zz & ui_jpad_ev_lmc) ? (
                            // pin (or unpin) the entry : its text stays shown
                            ((PatchStruct[2] === k + 1) && (PatchStruct[3] === v)) ? (PatchStruct[2] = 0) : (
                                PatchStruct[2] = k + 1; PatchStruct[3] = v;
                            );
                        ) :
                        (zz & ui_jpad_ev_rmc) ? (
                            // the modules that write or read the entry : the chosen one is opened
                            its_Pch_Info(v, k);
                            (its_PchLstN === 0) ? (
                                strcpy(menu_Pch_Mods[ui_jmenu_items], "*--#--No module writes or reads it");
                                menu_Pch_Mods[ui_jmenu_itc] = 1;
                            ) : (
                                menu_Pch_Mods[ui_jmenu_itc] = its_PchLstN;
                            );
                            xx = control_jmenu(menu_Pch_Mods);
                            ((xx >= 1) && (xx <= its_PchLstN)) ? (
                                !its_Mod_Open(its_PchLstT[xx - 1], its_PchLstM[xx - 1], blockId, 0) ?
                                    mSL_log(SysLogBox, "Connections : no room in the pane to open this module");
                            );
                        );
                    );
                );
            ui_pop();

            // the text : the cell under the mouse, else the pinned one (if it still exists)
            ui_split_top(h3);
                ui_pad(4,2,4,2);
                ui_pcolor(ui_jcolor_text);
                ui_align(0, 0);
                pin = (hk === 0) && (PatchStruct[2] > 0) && (PatchStruct[3] === v);
                k = (hk > 0) ? hk - 1 : pin ? PatchStruct[2] - 1 : -1;
                hc = (k >= 0) ? its_Pch_Info(v, k) : 0;
                (hc > 0) ? (
                    (v === its_PchV_Cbl) ? (
                        ch = its_PchCbl[k];
                        (ch < RD_CNT) ? sprintf(#its_PchName, "Cable of Reader %d", ch + 1) :
                            sprintf(#its_PchName, "Cable of Effect %d", ch - RD_CNT + 1);
                    ) :
                    (v === its_PchV_Bus) ? sprintf(#its_PchName, "Bus %d [%d]", BusAct[k] + 1, BusWidth[BusAct[k]]) :
                    (v === its_PchV_In) ? sprintf(#its_PchName, "In:%d", k) :
                    (v === its_PchV_Out) ? sprintf(#its_PchName, "Out:%d", k) :
                    sprintf(#its_PchName, "Ctl %d", k + 1);
                    sprintf(#its_PchTxt, "%s%s = %.4f", pin ? "(pinned) " : "", #its_PchName, smpl_tab[hc]);
                    ui_split_top(ui_texth()); ui_text(#its_PchTxt); ui_pop();
                    sprintf(#its_PchTxt, "Written by: %s", (strlen(#its_PchWs) > 0) ? #its_PchWs :
                        ((v === its_PchV_In) ? ((k < chcnt) ? its_Pch_TrackTxt(#its_PchTrk) : "nobody (not a channel of the track)") :
                        (v === its_PchV_Ctl) ? "the slider" : "nobody"));
                    ui_split_top(ui_texth()); ui_text(#its_PchTxt); ui_pop();
                    sprintf(#its_PchTxt, "Read by: %s", (strlen(#its_PchRs) > 0) ? #its_PchRs :
                        ((v === its_PchV_Out) ? ((k < chcnt) ? "the track" : "nobody (not a channel of the track)") : "nobody"));
                    ui_split_top(ui_texth()); ui_text(#its_PchTxt); ui_pop();
                ) :
                ((v === its_PchV_Bus) && (BusActN === 0)) ? (
                    ui_split_top(ui_texth()); ui_text("No bus in use : a bus exists while a module writes or reads it"); ui_pop();
                    ui_split_top(ui_texth()); ui_text("(output or source 'Bus n' of a reader, a writer, an effect)."); ui_pop();
                ) :
                ((v === its_PchV_Cbl) && (its_PchCblN === 0)) ? (
                    ui_split_top(ui_texth()); ui_text("No cable : a reader or an effect gets its own cable"); ui_pop();
                    ui_split_top(ui_texth()); ui_text("when its output is 'Own cable'."); ui_pop();
                ) : (
                    sprintf(#its_PchTxt, "%d connections not valid ; %d channels in the track", its_PchBad, chcnt);
                    ui_split_top(ui_texth()); ui_text("Mouse over a cell : who writes it, who reads it."); ui_pop();
                    ui_split_top(ui_texth()); ui_text(#its_PchTxt); ui_pop();
                );
            ui_pop();

        ui_pop();
    );
);

// the patch of the module "o" of the kind "t" ('R', 'W', 'E', 'L') shown by the module "Patch" (its_XpTy, its_XpK : the module
// designated, also for the module "Scripts"), from its first column ; the module "Patch" shown in the tab if it is not there
// (its_Mod_Show : else in another tab)
function its_Pg_ShowPatch(t, o)
(
    its_XpTy = (t === 'R') ? its_TK_Reader : (t === 'W') ? its_TK_Writer : (t === 'L') ? its_TK_Line : its_TK_Effect;
    its_XpK = o;
    PGraphStruct[0] = PGraphStruct[2] = 0;
    its_PgForce = 1;
    !its_Mod_Show('M', blockPGraph) ? mSL_log(SysLogBox, "Patch : no room in the panes to show the module Patch");
);

/*
    The summary modules (show_Summary_Pad) : "t" is 'R' ("Readers"), 'W' ("Writers"), 'E' ("Effects"), 'L' ("Lines"), 'C'
    ("Curves") ; the module "Modules" shows all these kinds
*/
// the state of the object block "b" of the module "t" : 1 running (reading, writing ; effects : on), 2 paused (effects :
// off), 3 ready (effects : bypass), 0 another one (created : no line, no source)
function its_Sum_State(t, b)
local (s)
(
    (t === 'R') ? (
        s = b[its_Rdr_Status]; // (stopping, starting : reading)
        (s >= its_RdrStat_Reading) ? 1 : (s === its_RdrStat_Paused) ? 2 : (s === its_RdrStat_Ready) ? 3 : 0;
    ) :
    (t === 'W') ? (
        s = b[its_Wrt_Status];
        (s === its_WrtStat_Writing) ? 1 : (s === its_WrtStat_Paused) ? 2 : (s === its_WrtStat_Ready) ? 3 : 0;
    ) : (
        s = b[its_Efx_Status];
        (s === its_EfxStat_Bypass) ? 3 : (s !== its_EfxStat_Off) ? 1 : 2;
    );
);

// the color of the state "k" (its_Sum_State) : as in the modules of the objects
function its_Sum_Color(t, k)
(
    (k === 1) ? Color_Limegreen : (k === 2) ? Color_Dark_Orange :
    (k === 3) ? ((t === 'E') ? Color_Goldenrod : Color_Light_Steel_Blue) : Col_InfoA;
);

// the kinds of the summary modules : 'R' readers, 'W' writers, 'L' lines, 'C' curves, 'E' effects ; its_Sum_Kind(g), g = 0 ... 4 :
// their order in the module "Modules" ; its_Sum_Cnt(t) : the count of the objects of the kind ; its_Sum_Blk(t, i) : the block
// of the object "i" of the kind "t", 0 if it does not exist ; its_Sum_Idx(t) : the page of the module in SummaryStruct ('M' :
// the module "Modules")
function its_Sum_Kind(g) ( (g === 0) ? 'R' : (g === 1) ? 'W' : (g === 2) ? 'L' : (g === 3) ? 'C' : 'E'; );
function its_Sum_Cnt(t) ( (t === 'R') ? RD_CNT : (t === 'W') ? WR_CNT : (t === 'L') ? LN_CNT : (t === 'C') ? its_CrvMx : FX_CNT; );
function its_Sum_Blk(t, i) local(b)
(
    (t === 'C') ? (
        b = its_CrvBlk[i];
        (b > BASE_MEMORY) ? b : 0;
    ) : (
        b = (t === 'R') ? Readers_set[i] : (t === 'W') ? Writers_set[i] : (t === 'L') ? Lines_Set[i] : Effects_set[i];
        ((b > BASE_MEMORY) && (b[-2] === ((t === 'R') ? KW_read : (t === 'W') ? KW_writ : (t === 'L') ? KW_lcbl : KW_effx))) ? b : 0;
    );
);
function its_Sum_Idx(t) ( (t === 'R') ? 0 : (t === 'W') ? 1 : (t === 'E') ? 2 : (t === 'L') ? 3 : (t === 'C') ? 4 : 5; );

// the curve "c" is used by the object stamped "s" (see its_Sum_CrvOf) : counted in its_SumCU (once per object) ; when the
// curve its_SumCK is looked for (not -1) : its_SumCF = 1 if it is this one
function its_Sum_CrvHit(c, s)
(
    c = 0|c;
    ((c >= 0) && (c < its_CrvMx)) ? (
        (its_SumCK < 0) ? (
            (its_SumCO[c] !== s) ? ( its_SumCO[c] = s; its_SumCU[c] += 1; );
        ) : (c === its_SumCK) ? (
            its_SumCF = 1;
        );
    );
);

// the curves used by the object "b" of the kind "t" ('R', 'W', 'E' ; "s" : a stamp of the object, see its_Sum_CrvHit) : the
// envelope of the grains (a reader in mode Grains), the curve of an effect (its key "curve" : the shape Curve of an LFO, a
// Flanger..., the mode Curve of a Saturation, the law Curve of a Random), the shape Curve of a modulation input connected
function its_Sum_CrvOf(t, b, s) local(ty, mp, n, j, p, f)
(
    (t === 'R') ? (
        (b[its_Rdr_Mode] === its_RdrMode_Grains) ? its_Sum_CrvHit(b[its_Rdr_GrCurve] - 1, s);
        mp = b + its_Rdr_Mod1; n = its_Rdr_ModN;
    ) :
    (t === 'W') ? (
        mp = b + its_Wrt_Mod1; n = its_Wrt_ModN;
    ) : (
        ty = b[its_Efx_Type];
        its_Tb_FxShown(b, ty, 38) ? its_Sum_CrvHit(b[its_Efx_Par1 + ((ty === its_Efx_TySat) ? 9 : 5)], s);
        mp = b + its_Efx_Mod1; n = 3; // (3 inputs, see its_Efx_Mod1)
    );
    j = 0; loop(n,
        p = mp + j * its_ModDist; f = p[its_Mod_Flags];
        ((p[its_Mod_Src] !== 0) && (((f >> 5) & 3) === its_ModS_Crv)) ? its_Sum_CrvHit((f >> 8) & 63, s);
        j += 1;
    );
);

// the use of the lines (its_SumLW the writers, its_SumLR the readers that use each line, its_SumLA the ones of them that run)
// and of the curves (its_SumCU : the readers, the writers, the effects that use each curve, see its_Sum_CrvOf)
function its_Sum_Usage() local(i, b, k)
(
    memset(its_SumLW, 0, LN_CNT); memset(its_SumLR, 0, LN_CNT); memset(its_SumLA, 0, LN_CNT);
    memset(its_SumCU, 0, its_CrvMx); memset(its_SumCO, 0, its_CrvMx);
    its_SumCK = -1;
    i = 0; loop(RD_CNT,
        ((b = its_Sum_Blk('R', i)) !== 0) ? (
            k = b[its_Rdr_LineNb];
            ((k >= 0) && (k < LN_CNT)) ? (
                its_SumLR[k] += 1;
                (b[its_Rdr_Status] >= its_RdrStat_Reading) ? (its_SumLA[k] += 1);
            );
            its_Sum_CrvOf('R', b, i + 1);
        );
        i += 1;
    );
    i = 0; loop(WR_CNT,
        ((b = its_Sum_Blk('W', i)) !== 0) ? (
            k = b[its_Wrt_LineNb];
            ((k >= 0) && (k < LN_CNT)) ? (
                its_SumLW[k] += 1;
                (b[its_Wrt_Status] === its_WrtStat_Writing) ? (its_SumLA[k] += 1);
            );
            its_Sum_CrvOf('W', b, 1000 + i + 1);
        );
        i += 1;
    );
    i = 0; loop(FX_CNT,
        ((b = its_Sum_Blk('E', i)) !== 0) ? its_Sum_CrvOf('E', b, 2000 + i + 1);
        i += 1;
    );
);

// the state of the object "o" (block "b") of the kind "t" (as its_Sum_State ; the lines and the curves : after its_Sum_Usage) :
// lines 1 active (a writer writes it, or a reader reads it), 2 idle (used, but nothing runs), 3 unused ; curves 1 used,
// 3 unused
function its_Sum_StateO(t, o, b)
(
    (t === 'L') ? ( (its_SumLA[o] > 0) ? 1 : ((its_SumLW[o] + its_SumLR[o]) > 0) ? 2 : 3; ) :
    (t === 'C') ? ( (its_SumCU[o] > 0) ? 1 : 3; ) :
    its_Sum_State(t, b);
);

// the text of the cell of the object "o" (block "b") of the kind "t", in "str" : its kind and its number ; effects : and their
// type ; lines : and their length ; curves : and their name, else their type
function its_Sum_Label(str, t, o, b)
(
    (t === 'E') ? sprintf(str, "E%d %s", o + 1, its_EfxTyS[max(0, min(its_Efx_TyCnt - 1, b[its_Efx_Type]))]) :
    (t === 'L') ? sprintf(str, "L%d %.4gs", o + 1, b[its_Lin_SmplCntSec]) :
    (t === 'C') ? sprintf(str, "C%d %s", o + 1,
        (strlen(its_CrvNm[o]) > 0) ? its_CrvNm[o] : its_CrvTyN[max(0, min(its_CrvTyCnt - 1, b[its_Crv_Type]))]) :
    sprintf(str, (t === 'R') ? "R%d" : "W%d", o + 1);
);

// the modules that use the line "o", in "str" : " ; written by W1 W2 ; read by R3" (12 of each at most), or " ; unused"
function its_Sum_LineUsers(str, o) local(i, b, nw, nr)
(
    strcpy(str, "");
    nw = nr = 0;
    i = 0; loop(WR_CNT,
        (((b = its_Sum_Blk('W', i)) !== 0) && (b[its_Wrt_LineNb] === o)) ? (
            nw += 1;
            (nw === 1) ? strcat(str, " ; written by");
            (nw <= 12) ? strcat(str, sprintf(#its_SumT3, " W%d", i + 1)) : (nw === 13) ? strcat(str, " ...");
        );
        i += 1;
    );
    i = 0; loop(RD_CNT,
        (((b = its_Sum_Blk('R', i)) !== 0) && (b[its_Rdr_LineNb] === o)) ? (
            nr += 1;
            (nr === 1) ? strcat(str, " ; read by");
            (nr <= 12) ? strcat(str, sprintf(#its_SumT3, " R%d", i + 1)) : (nr === 13) ? strcat(str, " ...");
        );
        i += 1;
    );
    ((nw + nr) === 0) ? strcpy(str, " ; unused");
    str;
);

// the modules that use the curve "k", in "str" : " ; used by R1 E5 ..." (24 at most), or " ; unused" (see its_Sum_CrvOf)
function its_Sum_CrvUsers(str, k) local(i, g, t, b, n)
(
    strcpy(str, "");
    n = 0; its_SumCK = k;
    g = 0; loop(3,
        t = (g === 0) ? 'R' : (g === 1) ? 'W' : 'E';
        i = 0; loop(its_Sum_Cnt(t),
            ((b = its_Sum_Blk(t, i)) !== 0) ? (
                its_SumCF = 0;
                its_Sum_CrvOf(t, b, 0);
                its_SumCF ? (
                    n += 1;
                    (n === 1) ? strcat(str, " ; used by");
                    (n <= 24) ? strcat(str, sprintf(#its_SumT3, (t === 'R') ? " R%d" : (t === 'W') ? " W%d" : " E%d", i + 1)) :
                    (n === 25) ? strcat(str, " ...");
                );
            );
            i += 1;
        );
        g += 1;
    );
    its_SumCK = -1;
    (n === 0) ? strcpy(str, " ; unused");
    str;
);

// the circles mute (k = 1) and solo (2) of a cell of the module "Readers" : the x of their center from the left of the
// cell (radius "rr", the solo on the right ; they take the 4 rr + 11 pixels on the right, the text is centered in the
// rest : ui_jpad_txt_rpad) ; its_Sum_DotAt : the circle at "lx" from the left of the cell (0 : none)
function its_Sum_DotX(k, rr)
(
    ui_jpad_lst_wi - rr - 7 - ((k === 1) ? 2 * rr + 4 : 0);
);
function its_Sum_DotAt(lx, rr)
(
    (lx < its_Sum_DotX(1, rr) - rr - 2) ? 0 : (lx < (its_Sum_DotX(1, rr) + its_Sum_DotX(2, rr)) / 2) ? 1 : 2;
);

// the color of a ring "off" centered at (x, y) (pixels) : dark on a light background, light on a dark one (the color under
// it : the themes, the soft style)
function its_Sum_RingCol(x, y)
local (r, g, b)
(
    gfx_x = x; gfx_y = y;
    r = g = b = 0;
    gfx_getpixel(r, g, b);
    (0.299 * r + 0.587 * g + 0.114 * b < 0.5) ? gfx_set(0.85, 0.85, 0.85, 0.8) : gfx_set(0.15, 0.15, 0.15, 0.7);
);

// draws the circles of the reader block "b" in the cell at ui_jpad_cx, ui_jpad_cy (radius "rr", retina scaling "rsc") :
// mute (red) and solo (yellow), filled when on, else a ring (its_Sum_RingCol) ; muted by another reader in solo : a red ring
function its_Sum_Dots(b, rr, rsc)
local (f, x, y, u)
(
    f = b[its_Rdr_StFlgs];
    u = (its_RdrSolos !== 0) && !(f & its_RdrFlg_solo);
    y = rsc * (ui_jpad_cy + (0|((ui_jpad_lst_he - ui_jd_padinter) / 2)) + 1);
    x = rsc * (ui_jpad_cx + its_Sum_DotX(1, rr));
    ((f & its_RdrFlg_mute) || u) ? gfx_set(0.9, 0.1, 0.1, 1) : its_Sum_RingCol(x, y);
    gfx_circle(x, y, rsc * rr, (f & its_RdrFlg_mute) ? 1 : 0, 1);
    x = rsc * (ui_jpad_cx + its_Sum_DotX(2, rr));
    (f & its_RdrFlg_solo) ? gfx_set(0.95, 0.85, 0.1, 1) : its_Sum_RingCol(x, y);
    gfx_circle(x, y, rsc * rr, (f & its_RdrFlg_solo) ? 1 : 0, 1);
);

// draws a red circle in the cell of the effect block "b" (at ui_jpad_cx, ui_jpad_cy) when it is in error and not off (as
// "Err: nnnn" in its module), at the place of the circle solo of the readers (the text keeps 2 rr + 8 pixels on the right)
function its_Sum_ErrDot(b, rr, rsc)
(
    ((b[its_Efx_Error] !== 0) && (b[its_Efx_Status] !== its_EfxStat_Off)) ? (
        gfx_set(0.9, 0.1, 0.1, 1);
        gfx_circle(rsc * (ui_jpad_cx + its_Sum_DotX(2, rr)),
            rsc * (ui_jpad_cy + (0|((ui_jpad_lst_he - ui_jd_padinter) / 2)) + 1), rsc * rr, 1, 1);
    );
);

// left clic on the object "o" (block "b") of the module "t" : a reader or a writer starts (from ready or paused) or
// pauses ; an effect, on or off (bypass : on, as the left clic on the cell of its state)
function its_Sum_Toggle(t, o, b)
local (k)
(
    k = its_Sum_State(t, b);
    (t === 'R') ? (
        (k === 1) ? Rd_Set_Status(o, its_RdrStat_Paused) : (k >= 2) ? Rd_Set_Status(o, its_RdrStat_Reading);
    ) :
    (t === 'W') ? (
        (k === 1) ? Wr_Set_Status(o, its_WrtStat_Paused) : (k >= 2) ? Wr_Set_Status(o, its_WrtStat_Writing);
    ) : (
        b[its_Efx_Status] = (b[its_Efx_Status] === its_EfxStat_On) ? its_EfxStat_Off : its_EfxStat_On;
        its_Run_Check(b);
    );
);

// opens the object "o" of the module "t" in a module of the tab (its_Mod_Open ; "bk" : the summary module, "nw" : in a
// new module)
function its_Sum_Open(t, o, bk, nw)
(
    !its_Mod_Open(t, o, bk, nw) ? mSL_log(SysLogBox, "Open : no free module of this kind in the tab, or no room in the pane");
);

// right clic on the object "o" (block "b") of the module "t" ("bk") : the menu of its states, (readers) mute and solo,
// open it in a module of the tab, in a new module, show its patch (menu_SumR, menu_SumW, menu_SumE) ; a line : open, its
// patch (menu_PgL) ; a curve : open, its dump (menu_SumC)
function its_Sum_Menu(t, o, b, bk)
local (m, k, f, xx)
(
    ((t === 'L') || (t === 'C')) ? (
        // a line (menu_PgL), a curve (menu_SumC) : open it in a module of the tab, in a new module ; a line : its patch ;
        // a curve : its dump in the log
        m = (t === 'L') ? menu_PgL : menu_SumC;
        ui_menu_tick(m, -1, 0);
        xx = control_jmenu(m);
        ((xx === 1) || (xx === 2)) ? its_Sum_Open(t, o, bk, xx === 2) :
        (xx === 3) ? ((t === 'L') ? its_Pg_ShowPatch('L', o) : its_Crv_Dump(o));
    ) : (
        m = (t === 'R') ? menu_SumR : (t === 'W') ? menu_SumW : menu_SumE;
        k = its_Sum_State(t, b); // its item : running 3 (effects : on 1), paused 2, ready 1 (effects : bypass 3)
        ui_menu_tick(m, -1, 0);
        (k > 0) ? ui_menu_tick(m, (t === 'E') ? k : 4 - k, 1);
        (t === 'R') ? (
            f = b[its_Rdr_StFlgs];
            (f & its_RdrFlg_mute) ? ui_menu_tick(m, 4, 1);
            (f & its_RdrFlg_solo) ? ui_menu_tick(m, 5, 1);
        );
        xx = control_jmenu(m);
        ui_menu_tick(m, -1, 0);
        ((xx >= 1) && (xx <= 3)) ? (
            (t === 'R') ? Rd_Set_Status(o, its_RdrStat_Ready + xx - 1) :
            (t === 'W') ? Wr_Set_Status(o, its_WrtStat_Ready + xx - 1) : (
                b[its_Efx_Status] = (xx === 1) ? its_EfxStat_On : (xx === 2) ? its_EfxStat_Off : its_EfxStat_Bypass;
                its_Run_Check(b);
            );
        ) :
        ((t === 'R') && (xx === 4)) ? (b[its_Rdr_StFlgs] = b[its_Rdr_StFlgs] ~ its_RdrFlg_mute) :
        ((t === 'R') && (xx === 5)) ? (b[its_Rdr_StFlgs] = b[its_Rdr_StFlgs] ~ its_RdrFlg_solo) :
        (xx === ((t === 'R') ? 8 : 6)) ? its_Pg_ShowPatch(t, o) :
        (xx > 3) ? its_Sum_Open(t, o, bk, xx === ((t === 'R') ? 7 : 5));
    );
);

// the text of the object "o" (block "b") of the module "t" (under the mouse) : in #its_SumTxt
function its_Sum_Text(t, o, b)
local (s, k, f)
(
    (t === 'L') ? (
        // a line : its length, its channels, its file, the modules that write and read it
        sprintf(#its_SumTxt, "Line %d", o + 1);
        ((k = its_Xp_Owner(its_TK_Line, b)) > 0) ? (sprintf(#its_SumT2, " (%s)", its_Al_OwnName(#its_OwnN, k)); strcat(#its_SumTxt, #its_SumT2););
        sprintf(#its_SumT2, " : %.3f s, %d channels", b[its_Lin_SmplCntSec], b[its_Lin_ChCnt]);
        strcat(#its_SumTxt, #its_SumT2);
        (strlen(its_LnFile[o]) > 0) ? (sprintf(#its_SumT2, ", file %s", its_LnFile[o]); strcat(#its_SumTxt, #its_SumT2););
        strcat(#its_SumTxt, its_Sum_LineUsers(#its_SumT2, o));
    ) :
    (t === 'C') ? (
        // a curve : its name, its type, its points, periodic, its sustain point, the modules that use it
        sprintf(#its_SumTxt, "Curve %d", o + 1);
        (strlen(its_CrvNm[o]) > 0) ? (sprintf(#its_SumT2, " \"%s\"", its_CrvNm[o]); strcat(#its_SumTxt, #its_SumT2););
        sprintf(#its_SumT2, " : %s, %d points", its_CrvTyL[max(0, min(its_CrvTyCnt - 1, b[its_Crv_Type]))], b[its_Crv_N]);
        strcat(#its_SumTxt, #its_SumT2);
        (b[its_Crv_Flags] & its_CrvFl_Periodic) ? strcat(#its_SumTxt, ", periodic");
        (b[its_Crv_Sus] >= 0) ? (sprintf(#its_SumT2, ", sustain %d", b[its_Crv_Sus] + 1); strcat(#its_SumTxt, #its_SumT2););
        strcat(#its_SumTxt, its_Sum_CrvUsers(#its_SumT2, o));
    ) : (
        k = b[(t === 'R') ? its_Rdr_Owner : (t === 'W') ? its_Wrt_Owner : its_Efx_Owner];
        sprintf(#its_SumTxt, "%s %d", (t === 'R') ? "Reader" : (t === 'W') ? "Writer" : "Effect", o + 1);
        (k > 0) ? (sprintf(#its_SumT2, " (%s)", its_Al_OwnName(#its_OwnN, k)); strcat(#its_SumTxt, #its_SumT2););
        (t === 'R') ? (
            s = b[its_Rdr_Status];
            sprintf(#its_SumT2, " : %s, mode %s", menu_Rdr_Status_N[(s > 4) ? 4 : max(0, s)], menu_Rdr_Type_N[b[its_Rdr_Mode]]);
            strcat(#its_SumTxt, #its_SumT2);
            (b[its_Rdr_LineNb] >= 0) ? sprintf(#its_SumT2, ", line %d", b[its_Rdr_LineNb] + 1) : strcpy(#its_SumT2, ", no line");
            strcat(#its_SumTxt, #its_SumT2);
            f = b[its_Rdr_StFlgs];
            (f & its_RdrFlg_mute) ? strcat(#its_SumTxt, ", muted") :
            ((its_RdrSolos !== 0) && !(f & its_RdrFlg_solo)) ? strcat(#its_SumTxt, ", muted by a solo");
            (f & its_RdrFlg_solo) ? strcat(#its_SumTxt, ", solo");
            ((k = b[its_Rdr_Error]) !== 0) ? (sprintf(#its_SumT2, ", error %04d", k); strcat(#its_SumTxt, #its_SumT2););
        ) :
        (t === 'W') ? (
            s = b[its_Wrt_Status];
            k = b[its_Wrt_Mode];
            sprintf(#its_SumT2, " : %s, %s", menu_Wrt_Status_N[max(0, min(4, s))],
                (k === its_WrtMode_WMix) ? "W-Mix" : (k === its_WrtMode_Sum) ? "Overdub Sum" : "Overdub X-fade");
            strcat(#its_SumTxt, #its_SumT2);
            (k !== its_WrtMode_WMix) ? (
                sprintf(#its_SumT2, ", %s", menu_Wrt_Dir_N[max(0, min(its_WrtDirCnt - 1, 0|b[its_Wrt_Dir]))]);
                strcat(#its_SumTxt, #its_SumT2);
            );
            (b[its_Wrt_LineNb] >= 0) ? sprintf(#its_SumT2, ", line %d", b[its_Wrt_LineNb] + 1) : strcpy(#its_SumT2, ", no line");
            strcat(#its_SumTxt, #its_SumT2);
        ) : (
            s = b[its_Efx_Status];
            sprintf(#its_SumT2, " : %s, %s", (s === its_EfxStat_Bypass) ? "Bypass" : (s !== its_EfxStat_Off) ? "On" : "Off",
                menu_Efx_Type_N[max(0, min(its_Efx_TyCnt - 1, b[its_Efx_Type]))]);
            strcat(#its_SumTxt, #its_SumT2);
            ((k = b[its_Efx_Error]) !== 0) ? (sprintf(#its_SumT2, ", error %04d", k); strcat(#its_SumTxt, #its_SumT2););
        );
    );
);

/*
    The summary modules ("t") : "Readers" 'R', "Writers" 'W', "Effects" 'E', "Lines" 'L', "Curves" 'C', and "Modules" 'M' (all
    these kinds) : the objects that exist, one cell each
    line 1 : 0 the name, 1 the count ; readers, writers, effects : 2 ... 4 the counts by state (readers, writers : running,
    paused, ready ; effects : on, off, bypass ; left clic on 2 : all the running ones pause, effects off ; on 3 : all the paused
    ones run, effects on ; effects, on 4 : all the bypassed ones on) ; readers : 5 the muted ones, 6 the ones in solo (left
    clic : none) ; lines : 2 ... 4 the active ones (a writer writes it, or a reader reads it), the idle ones (used, but nothing
    runs), the unused ones, 5 the ones loaded from a file ; curves : 2 the used ones, 3 the unused ones, 4 the envelopes, 5 the
    waveforms ; "Modules" : 1 all the kinds, 2 ... 6 the readers, the writers, the lines, the curves, the effects (left clic :
    this kind only ; again : all the kinds) ; 7 the page (left clic : the next one ; right clic : the previous one)
    the grid (8 cells per line, up to pad_SumG_NL lines per page) : one cell per object, its kind and its number (effects : and
    their type ; lines : their length ; curves : their name, else their type ; "Modules" : each kind starts a line) ; its
    color : its state, as in its module (running green, paused orange, ready light blue ; effects : on green, off orange,
    bypass golden ; lines : active green, idle orange, unused light blue ; curves : used green, unused light blue) ; readers :
    two small circles on the right, mute (red) and solo (yellow), filled when on (a red ring : muted by another reader in
    solo) ; effects : a red circle on the right when in error (its_Sum_ErrDot)
    left clic : starts or pauses the object (effects : on or off ; lines, curves : opens it in a module of the tab) ; readers,
    on a circle : mute or solo on or off ; Alt + left clic : opens it in a module of the tab (its_Mod_Open) ; right clic : a
    menu (its_Sum_Menu)
    the text : the object under the mouse (lines : the writers and the readers that use it ; curves : the modules that use it)
*/
function show_Summary_Pad(t, blockId)
local (h1, h2, h3, uix_jneed, zzmi, jmc, ki, ns, nt, n1, n2, n3, n4, n5, i, k, o, b, f, g, tc, fl, pg, npg, nl, zz, e, hk,
       hx, hy, rr, rsc, hr, he)
(
    ((t === 'L') || (t === 'C') || (t === 'M')) ? its_Sum_Usage();
    ki = its_Sum_Idx(t);
    // the objects shown (its_SumL, its_SumT), their counts by state (n1 running, n2 paused, n3 ready ; readers : n4 muted, n5
    // solo ; lines : n4 loaded from a file ; curves : n4 envelopes, n5 waveforms) ; "Modules" : the count of each kind
    // (its_SumNK), nt all of them, fl the kind shown (0 : all)
    ns = nt = n1 = n2 = n3 = n4 = n5 = fl = 0;
    (t === 'M') ? (
        fl = SummaryStruct[6] = max(0, min(5, 0|SummaryStruct[6]));
        g = 0; loop(5,
            tc = its_Sum_Kind(g);
            its_SumNK[g] = 0;
            i = 0; loop(its_Sum_Cnt(tc),
                (its_Sum_Blk(tc, i) !== 0) ? (
                    its_SumNK[g] += 1;
                    ((fl === 0) || (fl === g + 1)) ? ( its_SumL[ns] = i; its_SumT[ns] = tc; ns += 1; );
                );
                i += 1;
            );
            nt += its_SumNK[g];
            // (each kind starts a line of the grid : empty cells)
            while (ns % 8) ( its_SumL[ns] = -1; its_SumT[ns] = 0; ns += 1; );
            g += 1;
        );
        while ((ns > 0) && (its_SumT[ns - 1] === 0)) ( ns -= 1; );
    ) : (
        i = 0; loop(its_Sum_Cnt(t),
            ((b = its_Sum_Blk(t, i)) !== 0) ? (
                its_SumL[ns] = i; its_SumT[ns] = t; ns += 1;
                k = its_Sum_StateO(t, i, b);
                (k === 1) ? (n1 += 1) : (k === 2) ? (n2 += 1) : (k === 3) ? (n3 += 1);
                (t === 'R') ? (
                    (b[its_Rdr_StFlgs] & its_RdrFlg_mute) ? (n4 += 1);
                    (b[its_Rdr_StFlgs] & its_RdrFlg_solo) ? (n5 += 1);
                ) :
                (t === 'L') ? (
                    (strlen(its_LnFile[i]) > 0) ? (n4 += 1);
                ) :
                (t === 'C') ? (
                    ((b[its_Crv_Type] === its_CrvEnv) || (b[its_Crv_Type] === its_CrvHEnv)) ? (n4 += 1) : (n5 += 1);
                );
            );
            i += 1;
        );
        nt = ns;
    );
    npg = max(1, ceil(ns / pad_SumG_Siz));
    pg = SummaryStruct[ki] = max(0, min(npg - 1, 0|SummaryStruct[ki]));
    nl = max(1, min(pad_SumG_NL, ceil((ns - pg * pad_SumG_Siz) / 8)));
    h1 = uix_jpadHeight(1);
    h2 = uix_jpadHeight(nl);
    h3 = uix_jBoxHeight(2);
    uix_jneed = h1+h2+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            // the counts
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Sum_Labs, pad_Sum_Siz);
                i = 0; loop(pad_Sum_Siz, pad_Sum_Colrs[i] = Col_Inactive; strcpy(pad_Sum_Labs[i], ""); i += 1;);
                strcpy(pad_Sum_Labs[0], blockDispNames[blockDispInverts[blockId]]);
                pad_Sum_Colrs[0] = Col_InfoA;
                (t === 'M') ? (
                    // all the kinds, each kind (the kind shown : green)
                    sprintf(pad_Sum_Labs[1], "All %d", nt);
                    pad_Sum_Colrs[1] = (fl === 0) ? Color_Limegreen : Col_P1;
                    g = 0; loop(5,
                        sprintf(pad_Sum_Labs[2 + g], (g === 0) ? "Readers %d" : (g === 1) ? "Writers %d" : (g === 2) ? "Lines %d" :
                            (g === 3) ? "Curves %d" : "Effects %d", its_SumNK[g]);
                        pad_Sum_Colrs[2 + g] = (fl === g + 1) ? Color_Limegreen : (its_SumNK[g] > 0) ? Col_P1 : Col_Inactive;
                        g += 1;
                    );
                ) : (
                    sprintf(pad_Sum_Labs[1], "Count %d", ns);
                    pad_Sum_Colrs[1] = Col_P1;
                    (t === 'C') ? (
                        sprintf(pad_Sum_Labs[2], "Used %d", n1);
                        sprintf(pad_Sum_Labs[3], "Unused %d", n3);
                        sprintf(pad_Sum_Labs[4], "Envelopes %d", n4);
                        sprintf(pad_Sum_Labs[5], "Waveforms %d", n5);
                        (n1 > 0) ? (pad_Sum_Colrs[2] = its_Sum_Color(t, 1));
                        (n3 > 0) ? (pad_Sum_Colrs[3] = its_Sum_Color(t, 3));
                        (n4 > 0) ? (pad_Sum_Colrs[4] = Col_P1);
                        (n5 > 0) ? (pad_Sum_Colrs[5] = Col_P1);
                    ) : (
                        sprintf(pad_Sum_Labs[2], (t === 'R') ? "Reading %d" : (t === 'W') ? "Writing %d" : (t === 'L') ? "Active %d" :
                            "On %d", n1);
                        sprintf(pad_Sum_Labs[3], (t === 'E') ? "Off %d" : (t === 'L') ? "Idle %d" : "Paused %d", n2);
                        sprintf(pad_Sum_Labs[4], (t === 'E') ? "Bypass %d" : (t === 'L') ? "Unused %d" : "Ready %d", n3);
                        (n1 > 0) ? (pad_Sum_Colrs[2] = its_Sum_Color(t, 1));
                        (n2 > 0) ? (pad_Sum_Colrs[3] = its_Sum_Color(t, 2));
                        (n3 > 0) ? (pad_Sum_Colrs[4] = its_Sum_Color(t, 3));
                        (t === 'R') ? (
                            sprintf(pad_Sum_Labs[5], "Muted %d", n4);
                            sprintf(pad_Sum_Labs[6], "Solo %d", n5);
                            (n4 > 0) ? (pad_Sum_Colrs[5] = Col_P6);
                            (n5 > 0) ? (pad_Sum_Colrs[6] = Col_P7);
                        ) :
                        (t === 'L') ? (
                            sprintf(pad_Sum_Labs[5], "Files %d", n4);
                            (n4 > 0) ? (pad_Sum_Colrs[5] = Col_P1);
                        );
                    );
                );
                sprintf(pad_Sum_Labs[7], "Page %d / %d", pg + 1, npg);
                pad_Sum_Colrs[7] = (npg > 1) ? Col_P3 : Col_Inactive;
                zz = control_jpad(pad_Sum);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    e = pad_Sum[ui_jpad_last] - 1;
                    (e === 7) ? (
                        (zz & ui_jpad_ev_lmc) ? (SummaryStruct[ki] = (pg + 1) % npg) :
                        (zz & ui_jpad_ev_rmc) ? (SummaryStruct[ki] = (pg + npg - 1) % npg);
                    ) :
                    ((t === 'M') && (zz & ui_jpad_ev_lmc) && (e >= 1) && (e <= 6)) ? (
                        // the kind shown : all of them (1), one kind (2 ... 6 ; again : all of them) ; from the first page
                        SummaryStruct[6] = ((e === 1) || (fl === e - 1)) ? 0 : e - 1;
                        SummaryStruct[ki] = 0;
                    ) :
                    (((t === 'R') || (t === 'W') || (t === 'E')) && (zz & ui_jpad_ev_lmc)
                        && ((e === 2) || (e === 3) || ((t === 'E') && (e === 4)))) ? (
                        // all the objects running (2) pause, all the paused ones (3) run ; effects : on (2) -> off,
                        // off (3) -> on, bypass (4) -> on (as a clic on their cell)
                        k = e - 1; // the state (its_Sum_State)
                        i = 0; loop(ns,
                            o = its_SumL[i]; b = its_Sum_Blk(t, o);
                            ((b !== 0) && (its_Sum_State(t, b) === k)) ? its_Sum_Toggle(t, o, b);
                            i += 1;
                        );
                    ) :
                    ((t === 'R') && (zz & ui_jpad_ev_lmc) && ((e === 5) || (e === 6))) ? (
                        // no more reader muted (5), in solo (6)
                        f = (e === 5) ? its_RdrFlg_mute : its_RdrFlg_solo;
                        i = 0; loop(ns, b = Readers_set[its_SumL[i]]; b[its_Rdr_StFlgs] &= -1 ~ f; i += 1;);
                    );
                );
            ui_pop();

            // the grid of the objects (hr, he : readers, effects in the page)
            ui_split_top(h2);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_SumG_Labs, 8 * nl);
                hr = he = 0;
                i = 0; loop(8 * nl,
                    k = pg * pad_SumG_Siz + i;
                    pad_SumG_Colrs[i] = Col_Inactive;
                    strcpy(pad_SumG_Labs[i], "");
                    ((k < ns) && ((tc = its_SumT[k]) !== 0)) ? (
                        o = its_SumL[k];
                        ((b = its_Sum_Blk(tc, o)) !== 0) ? (
                            its_Sum_Label(pad_SumG_Labs[i], tc, o, b);
                            pad_SumG_Colrs[i] = its_Sum_Color(tc, its_Sum_StateO(tc, o, b));
                            (tc === 'R') ? (hr = 1) : (tc === 'E') ? (he = 1);
                        );
                    );
                    i += 1;
                );
                // readers : the radius of the circles mute and solo (smaller if the cells are narrow : the text keeps
                // at least 20 pixels), the room they take on the right of the text ; effects : the circle of the errors
                rr = 0;
                (hr || he) ? (
                    i = 0|(ui_width() / 8); // the width of the cells (as computed by control_jpad)
                    rr = max(2, min(0|(ui_jd_padline / 4), 0|((i - 32) / 4)));
                    ui_jpad_txt_rpad = hr ? 4 * rr + 12 : 2 * rr + 8;
                );
                zz = control_jpad(pad_SumG, nl, -1, 1);
                ui_jpad_txt_rpad = 0;
                // readers : the circles mute and solo ; effects : the circle of the errors
                (hr || he) ? (
                    rsc = uix_drawconfig_current[9]; // retina scaling
                    i = 0; loop(min(8 * nl, ns - pg * pad_SumG_Siz),
                        k = pg * pad_SumG_Siz + i;
                        tc = its_SumT[k];
                        (((tc === 'R') || (tc === 'E')) && ((b = its_Sum_Blk(tc, its_SumL[k])) !== 0)) ? (
                            ui_jpad_cell_pos(i);
                            (tc === 'R') ? its_Sum_Dots(b, rr, rsc) : its_Sum_ErrDot(b, rr, rsc);
                        );
                        i += 1;
                    );
                );
                // the object under the mouse (geometry of the pad just drawn, see ui_jpad_cell_pos)
                hk = 0;
                (ui_hover() && (ui_jpad_lst_wi > 0) && (ui_jpad_lst_he > 0)) ? (
                    hx = floor((uix_mouse_x - ui_jpad_lst_left) / ui_jpad_lst_wi);
                    hy = floor((uix_mouse_y - ui_jpad_lst_top) / ui_jpad_lst_he);
                    k = pg * pad_SumG_Siz + hy * 8 + hx;
                    ((hx >= 0) && (hx < 8) && (hy >= 0) && (hy < nl) && (k < ns) && (its_SumT[k] !== 0)) ? (hk = k + 1);
                );
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    e = pad_SumG[ui_jpad_last] - 1; // the cell in the page
                    k = pg * pad_SumG_Siz + e;
                    tc = ((e >= 0) && (e < 8 * nl) && (k < ns)) ? its_SumT[k] : 0;
                    o = (tc !== 0) ? its_SumL[k] : -1;
                    ((tc !== 0) && ((b = its_Sum_Blk(tc, o)) !== 0)) ? (
                        ((zz & ui_jpad_ev_lmc) && ((jmc & altCap) || (tc === 'L') || (tc === 'C'))) ? (
                            its_Sum_Open(tc, o, blockId, 0);
                        ) :
                        (zz & ui_jpad_ev_lmc) ? (
                            // readers : on a circle, mute or solo
                            ui_jpad_cell_pos(e);
                            f = (tc === 'R') ? its_Sum_DotAt(uix_mouse_x - ui_jpad_cx, rr) : 0;
                            (f === 1) ? (b[its_Rdr_StFlgs] = b[its_Rdr_StFlgs] ~ its_RdrFlg_mute) :
                            (f === 2) ? (b[its_Rdr_StFlgs] = b[its_Rdr_StFlgs] ~ its_RdrFlg_solo) :
                            its_Sum_Toggle(tc, o, b);
                        ) :
                        (zz & ui_jpad_ev_rmc) ? (
                            its_Sum_Menu(tc, o, b, blockId);
                        );
                    );
                );
            ui_pop();

            // the text : the object under the mouse
            ui_split_top(h3);
                ui_pad(4,2,4,2);
                ui_pcolor(ui_jcolor_text);
                ui_align(0, 0);
                (hk > 0) ? (
                    tc = its_SumT[hk - 1]; o = its_SumL[hk - 1];
                    ((b = its_Sum_Blk(tc, o)) !== 0) ? its_Sum_Text(tc, o, b) : strcpy(#its_SumTxt, "");
                ) :
                (ns === 0) ? (
                    strcpy(#its_SumTxt, (t === 'R') ? "No reader." : (t === 'W') ? "No writer." : (t === 'E') ? "No effect." :
                        (t === 'L') ? "No line." : (t === 'C') ? "No curve." : (fl === 0) ? "No module." : "No module of this kind.");
                ) : (
                    strcpy(#its_SumTxt, (t === 'R') ? "Mouse over a cell : its reader." :
                        (t === 'W') ? "Mouse over a cell : its writer." : (t === 'E') ? "Mouse over a cell : its effect." :
                        (t === 'L') ? "Mouse over a cell : its line, the modules that write and read it." :
                        (t === 'C') ? "Mouse over a cell : its curve, the modules that use it." : "Mouse over a cell : its module.");
                );
                ui_split_top(ui_texth()); ui_text(#its_SumTxt); ui_pop();
                ui_split_top(ui_texth());
                    ui_text((t === 'R') ? "Clic : start or pause ; on a circle : mute, solo ; Alt + clic : open ; right clic : menu" :
                        (t === 'W') ? "Clic : start or pause ; Alt + clic : open it in a module ; right clic : menu" :
                        (t === 'E') ? "Clic : on or off ; red circle : in error ; Alt + clic : open ; right clic : menu" :
                        (t === 'L') ? "Clic : open it in a module ; right clic : menu (open, its patch)" :
                        (t === 'C') ? "Clic : open it in a module ; right clic : menu (open, dump)" :
                        "Line 1 : the kinds shown ; clic : start / pause, on / off, open ; Alt + clic : open ; right clic : menu");
                ui_pop();
            ui_pop();

        ui_pop();
    );
);

/*
    The module "Instances" : the instances of algorithms (see "Algorithms", table(data(...)))
    line 1 : 0 "Instances", 1 their count, 2 the count of templates, 7 actions (right clic : Dump all, Templates in the log,
    Free all instances)
    the grid : one cell per instance (its number : 1 ... its_InsMx), "name : Template" ; left clic : selects it ; right clic :
    menu (Dump, Free)
    the text : the instance under the mouse (or the selected one) : its call, the count of its modules
*/
function show_Instances_Pad(blockId)
local (h1, h2, h3, uix_jneed, zzmi, i, k, n, nt, mx, nl, zz, zzmcl, xx, hk, hx, hy, b, nln, nwr, nrd, nfx)
(
    n = nt = mx = 0;
    k = 1; loop(its_InsMx, (its_InsSym[k] !== 0) ? ( n += 1; mx = k; ); k += 1;);
    i = 0; loop(its_AlgMx, (its_AlgSym[i] !== 0) ? (nt += 1); i += 1;);
    (its_InsSym[its_InsUiSel] === 0) ? (its_InsUiSel = 0);
    nl = max(1, ceil(mx / 8));
    h1 = uix_jpadHeight(1);
    h2 = uix_jpadHeight(nl);
    h3 = uix_jBoxHeight(2);
    uix_jneed = h1+h2+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            // line 1
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Ins_Labs, pad_Ins_Siz);
                i = 0; loop(pad_Ins_Siz, pad_Ins_Colrs[i] = Col_InfoA; strcpy(pad_Ins_Labs[i], ""); i += 1;);
                strcpy(pad_Ins_Labs[0], "Instances");
                sprintf(pad_Ins_Labs[1], "%d instance%s", n, (n > 1) ? "s" : "");
                sprintf(pad_Ins_Labs[2], "%d template%s", nt, (nt > 1) ? "s" : "");
                pad_Ins_Colrs[1] = pad_Ins_Colrs[2] = Color_Heliotrope;
                strcpy(pad_Ins_Labs[7], "Action");
                pad_Ins_Colrs[7] = Col_P1;
                zz = control_jpad(pad_Ins);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    zzmcl = pad_Ins[ui_jpad_last]-1;
                    ((zz & (ui_jpad_ev_rmc | ui_jpad_ev_lmc)) && (zzmcl === 7)) ? ( // the cell "Action" : right or left clic
                        xx = its_Menu_Clic(menu_InsAll_Action, zz);
                        (xx === 1) ? (
                            k = 1; loop(its_InsMx, (its_InsSym[k] !== 0) ? its_Al_DumpIns(k); k += 1;);
                            (n === 0) ? mSL_log(SysLogBox, "No instance");
                        ) :
                        (xx === 2) ? (
                            its_Al_DumpTpls();
                        ) :
                        (xx === 4) ? (
                            k = 1; loop(its_InsMx, (its_InsSym[k] !== 0) ? its_Al_Delete(k); k += 1;);
                            its_InsUiSel = 0;
                        );
                    );
                );
            ui_pop();

            // the grid : the instances
            ui_split_top(h2);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_InsG_Labs, 8 * nl);
                hk = 0;
                i = 0; loop(8 * nl,
                    k = i + 1;
                    (its_InsSym[k] !== 0) ? (
                        sprintf(pad_InsG_Labs[i], "%s : %s", mSL_edit_value(#its_TbV, its_InsSym[k]), mSL_edit_value(#its_TbV1, its_InsAName[k]));
                        pad_InsG_Colrs[i] = (k === its_InsUiSel) ? Color_Goldenrod : Color_Limegreen;
                    ) : (
                        strcpy(pad_InsG_Labs[i], "");
                        pad_InsG_Colrs[i] = Col_Inactive;
                    );
                    i += 1;
                );
                zz = control_jpad(pad_InsG, nl, -1, 1);
                // the instance under the mouse (geometry of the pad just drawn, see ui_jpad_cell_pos)
                (ui_hover() && (ui_jpad_lst_wi > 0) && (ui_jpad_lst_he > 0)) ? (
                    hx = floor((uix_mouse_x - ui_jpad_lst_left) / ui_jpad_lst_wi);
                    hy = floor((uix_mouse_y - ui_jpad_lst_top) / ui_jpad_lst_he);
                    ((hx >= 0) && (hx < 8) && (hy >= 0) && (hy < nl) && (its_InsSym[hy * 8 + hx + 1] !== 0)) ? (hk = hy * 8 + hx + 1);
                );
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    k = pad_InsG[ui_jpad_last];
                    ((k >= 1) && (k <= its_InsMx) && (its_InsSym[k] !== 0)) ? (
                        (zz & ui_jpad_ev_lmc) ? (
                            its_InsUiSel = (its_InsUiSel === k) ? 0 : k;
                        ) :
                        (zz & ui_jpad_ev_rmc) ? (
                            xx = control_jmenu(menu_Ins_Action);
                            (xx === 1) ? its_Al_DumpIns(k) :
                            (xx === 2) ? ( its_Al_Delete(k); (its_InsUiSel === k) ? (its_InsUiSel = 0); );
                        );
                    );
                );
            ui_pop();

            // the text : the instance under the mouse, or the selected one
            ui_split_top(h3);
                ui_pad(4,2,4,2);
                ui_pcolor(ui_jcolor_text);
                ui_align(0, 0);
                k = (hk > 0) ? hk : its_InsUiSel;
                (k > 0) ? (
                    ui_split_top(ui_texth()); ui_text(its_Al_CallText(#its_InsTxt, k)); ui_pop();
                    nln = nwr = nrd = nfx = 0;
                    i = 0; loop(LN_CNT, (((b = Lines_Set[i]) > BASE_MEMORY) && (b[its_Lin_Owner] === k)) ? (nln += 1); i += 1;);
                    i = 0; loop(WR_CNT, (((b = Writers_set[i]) > BASE_MEMORY) && (b[its_Wrt_Owner] === k)) ? (nwr += 1); i += 1;);
                    i = 0; loop(RD_CNT, (((b = Readers_set[i]) > BASE_MEMORY) && (b[its_Rdr_Owner] === k)) ? (nrd += 1); i += 1;);
                    i = 0; loop(FX_CNT, (((b = Effects_set[i]) > BASE_MEMORY) && (b[its_Efx_Owner] === k)) ? (nfx += 1); i += 1;);
                    sprintf(#its_InsTxt, "Modules : %d lines, %d writers, %d readers, %d effects", nln, nwr, nrd, nfx);
                    ui_split_top(ui_texth()); ui_text(#its_InsTxt); ui_pop();
                ) : (
                    ui_split_top(ui_texth()); ui_text("Mouse over an instance : its call and its modules."); ui_pop();
                );
            ui_pop();

        ui_pop();
    );
);

/*
    The module "Scripts" : the exports of the patches and of the session, in scripts (see "Exports (2)", table(data(...)))
    line 1 : 0 "Scripts", 1 what a patch shows when it is read (its_XpShow : menu), 2 the name of the files (clic : the prompt),
    3 and 4 the module designated (clic : menus of the kinds, of the numbers ; the cell 4 shows its name in its instance),
    5 Export patch, 6 Export session, 7 actions (the texts in the log)
    the text : the graph of the module designated, its modules, the last file (or the state of the auxiliary script)
*/
function show_Scripts_Pad(blockId)
local (h1, h3, uix_jneed, zzmi, i, c, b, o, zz, zzmcl, xx)
(
    h1 = uix_jpadHeight(1);
    h3 = uix_jBoxHeight(3);
    uix_jneed = h1+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            // line 1
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Scr_Labs, pad_Scr_Siz);
                i = 0; loop(pad_Scr_Siz, pad_Scr_Colrs[i] = Col_InfoA; strcpy(pad_Scr_Labs[i], ""); i += 1;);
                strcpy(pad_Scr_Labs[0], "Scripts");
                c = xpt_Ready();
                strcpy(pad_Scr_Labs[1], (its_XpShow === 0) ? "Show nothing" : (its_XpShow === 2) ? "Show all" : "Show essential");
                pad_Scr_Colrs[1] = Col_P1;
                (strlen(#its_XpName) > 0) ? strcpy(pad_Scr_Labs[2], #its_XpName) : strcpy(pad_Scr_Labs[2], "Name ?");
                pad_Scr_Colrs[2] = (strlen(#its_XpName) > 0) ? Col_P1 : Color_Goldenrod;
                strcpy(pad_Scr_Labs[3], its_Tb_TyName(its_XpTy));
                pad_Scr_Colrs[3] = Col_P1;
                b = its_Xp_Blk(its_XpTy, its_XpK);
                sprintf(pad_Scr_Labs[4], "%d", its_XpK + 1);
                ((b !== 0) && ((o = its_Xp_Owner(its_XpTy, b)) > 0) && ((xx = its_Xp_InsName(o, its_XpTy, its_XpK)) !== 0)) ?
                    strcat(pad_Scr_Labs[4], sprintf(#its_XpV1, " %s", mSL_edit_value(#its_XpV2, xx)));
                pad_Scr_Colrs[4] = (b !== 0) ? Col_P1 : Col_Inactive;
                strcpy(pad_Scr_Labs[5], "Export patch");
                pad_Scr_Colrs[5] = ((c === 0) && (b !== 0)) ? Color_Limegreen : Col_Inactive;
                strcpy(pad_Scr_Labs[6], "Export session");
                pad_Scr_Colrs[6] = (c === 0) ? Color_Limegreen : Col_Inactive;
                strcpy(pad_Scr_Labs[7], "Action");
                pad_Scr_Colrs[7] = Col_P1;
                zz = control_jpad(pad_Scr);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 37;
                    zzmcl = pad_Scr[ui_jpad_last]-1;
                    (zz & (ui_jpad_ev_rmc | ui_jpad_ev_lmc)) ? (
                        (zzmcl === 1) ? (
                            xx = its_Menu_Clic(menu_Xp_Show, zz);
                            (xx > 0) ? (its_XpShow = xx - 1);
                        ) :
                        (zzmcl === 2) ? (
                            its_Xp_Prompt(0);
                        ) :
                        (zzmcl === 3) ? (
                            xx = its_Menu_Clic(menu_Xp_Kind, zz);
                            (xx > 0) ? (
                                its_XpTy = its_Xp_TyOf(xx - 1);
                                its_XpK = min(its_XpK, its_Tb_Count(its_XpTy) - 1);
                            );
                        ) :
                        (zzmcl === 4) ? (
                            xx = its_Menu_Clic((its_XpTy === its_TK_Effect) ? menu_Efx_Ids : (its_XpTy === its_TK_Reader) ? menu_Rdr_Ids :
                                (its_XpTy === its_TK_Writer) ? menu_Wrt_Ids : menu_Lin_Ids, zz);
                            (xx > 0) ? (its_XpK = xx - 1);
                        ) :
                        (zzmcl === 5) ? (
                            its_Xp_Ask(1, its_XpTy, its_XpK);
                        ) :
                        (zzmcl === 6) ? (
                            its_Xp_Ask(2, 0, 0);
                        ) :
                        (zzmcl === 7) ? (
                            xx = its_Menu_Clic(menu_Xp_Act, zz);
                            (xx === 1) ? (
                                (b !== 0) ? its_Xp_Text(1, its_XpTy, its_XpK, 0) : mSL_log(SysLogBox, "Export : no module designated");
                            ) :
                            (xx === 2) ? (
                                its_Xp_Text(2, 0, 0, 0);
                            );
                        );
                    );
                );
            ui_pop();

            // the text : twice per second, the graph of the module designated
            (gfxStartTime - its_XpPvT > 0.5) ? (
                its_XpPvT = gfxStartTime;
                (its_Xp_Blk(its_XpTy, its_XpK) === 0) ? (
                    sprintf(#its_XpS1, "%s %d does not exist : no patch.", its_Tb_TyName(its_XpTy), its_XpK + 1);
                    strcpy(#its_XpS2, "");
                ) : (
                    its_Xp_Select(its_XpTy, its_XpK);
                    sprintf(#its_XpS1, "The patch of %s %d : %d effects, %d readers, %d writers, %d lines", its_Tb_TyName(its_XpTy), its_XpK + 1,
                        its_Xp_Cnt(its_TK_Effect), its_Xp_Cnt(its_TK_Reader), its_Xp_Cnt(its_TK_Writer), its_Xp_Cnt(its_TK_Line));
                    its_Xp_ListAll(#its_XpS2);
                );
            );
            ui_split_top(h3);
                ui_pad(4,2,4,2);
                ui_pcolor(ui_jcolor_text);
                ui_align(0, 0);
                ui_split_top(ui_texth()); ui_text(#its_XpS1); ui_pop();
                ui_split_top(ui_texth()); ui_text(#its_XpS2); ui_pop();
                (c === 1) ? strcpy(#its_XpS3, "No auxiliary script (GMAuxiliary.eel) : no export.") :
                (c === 2) ? strcpy(#its_XpS3, "GMAuxiliary.eel must be started again (an old version) : no export.") :
                (its_XpWr === 1) ? sprintf(#its_XpS3, "Writing %s", #its_XpFile) :
                (its_XpWr === 2) ? sprintf(#its_XpS3, "Written : %s", #its_XpFile) :
                (its_XpWr === 3) ? sprintf(#its_XpS3, "Not written : %s", #its_XpFile) :
                sprintf(#its_XpS3, "The files go to the folder %s of the project.", #xpt_Folder);
                ui_split_top(ui_texth()); ui_text(#its_XpS3); ui_pop();
            ui_pop();

        ui_pop();
    );
);

/*
    The module "Patch" : the graph of the patch of the module designated (its_XpTy, its_XpK, shared with the module "Scripts"),
    or of all the modules, from left to right (its_Pg_Compute, twice per second) ; the boxes : the modules (their color : their
    state, as in the modules "Readers", "Writers", "Effects" ; the module designated : a thick frame ; a red dot : an effect in
    error, a reader muted), the lines, the buses, In, Out, the controls ; the links : the sound (green), a modulation (blue,
    dashed), the writer that a loop follows (grey, dotted) ; a link that goes back to the left closes a loop ; the links of a
    column not shown end at the border
    line 1 : 0 "Patch", 1 and 2 the module designated (clic : the menus of the kinds, of the numbers ; the cell 2 : also its name
    in its instance), 3 its patch or all the modules (clic), 4 In and the controls shown or not (clic), 5 the columns shown (left
    clic : one more to the right ; right clic : to the left ; also the wheel over the graph), 6 the count of modules, 7 actions
    (export the patch, the patch in the log)
    the graph : the box under the mouse and its links stand out ; left clic : a reader, a writer starts or pauses, an effect on
    or off (as in the modules "Readers" ...) ; Alt + left clic : opens it (a line too) in a module of the tab ; right clic : its
    menu (its states, open it, show its patch)
    the text : the box under the mouse and its links, else the patch
*/

// the geometry of the graph in the current rect (logical pixels) : the columns shown (its_PgSc ... + its_PgNv), their width, the
// boxes, the rows
function its_Pg_Geo() local(th)
(
    th = ui_texth();
    its_PgAx = ui_left(); its_PgAy = ui_top(); its_PgAw = ui_width(); its_PgAh = ui_height();
    its_PgNv = max(1, min(its_PgNC, floor(its_PgAw / (7.5 * th)))); // (7.5 th : the narrowest column)
    its_PgSc = PGraphStruct[2] = max(0, min(its_PgNC - its_PgNv, 0|PGraphStruct[2]));
    its_PgColW = min(its_PgAw / its_PgNv, 14 * th);
    its_PgGx = its_PgAx + (its_PgAw - its_PgNv * its_PgColW) / 2;
    its_PgNodW = min(0.72 * its_PgColW, 10 * th);
    its_PgPitch = its_PgAh / max(1, its_PgRows);
    its_PgNodH = max(4, min(its_PgPitch - 4, th + 8));
);
// the node "v" : in a column shown, its box (left, top)
function its_Pg_Vis(v) ( (its_PgCol[v] >= its_PgSc) && (its_PgCol[v] < its_PgSc + its_PgNv); );
function its_Pg_NX(v) ( its_PgGx + (its_PgCol[v] - its_PgSc) * its_PgColW + (its_PgColW - its_PgNodW) / 2; );
function its_Pg_NY(v) ( its_PgAy + its_PgPos[v] * its_PgPitch + (its_PgPitch - its_PgNodH) / 2; );

// the kind of the node "v" : 'L' line, 'W' writer, 'R' reader, 'E' effect, 'B' bus, 'O' Out, 'I' In, 'C' control ; its number
// in its_PgNum
function its_Pg_Kind(v)
(
    (v < its_Tb_RBase(its_TK_Writer)) ? ( its_PgNum = v; 'L'; ) :
    (v < its_Tb_RBase(its_TK_Reader)) ? ( its_PgNum = v - its_Tb_RBase(its_TK_Writer); 'W'; ) :
    (v < its_Tb_RBase(its_TK_Effect)) ? ( its_PgNum = v - its_Tb_RBase(its_TK_Reader); 'R'; ) :
    (v < its_XpMN) ? ( its_PgNum = v - its_Tb_RBase(its_TK_Effect); 'E'; ) :
    (v < its_XpMN + NB_BUS) ? ( its_PgNum = v - its_XpMN; 'B'; ) :
    (v < its_PgIn) ? ( its_PgNum = 0; 'O'; ) :
    (v === its_PgIn) ? ( its_PgNum = 0; 'I'; ) : ( its_PgNum = v - its_PgCtl; 'C'; );
);

// the block of the module "k" of the kind "t" ('L', 'W', 'R', 'E') ; 0 : it does not exist (any more)
function its_Pg_Blk(t, k)
(
    its_Xp_Blk((t === 'L') ? its_TK_Line : (t === 'W') ? its_TK_Writer : (t === 'R') ? its_TK_Reader : its_TK_Effect, k);
);

// the name of the box "v" in "str" (an effect : its type)
function its_Pg_Label(str, v) local(t, b)
(
    t = its_Pg_Kind(v);
    (t === 'L') ? sprintf(str, "Line %d", its_PgNum + 1) :
    (t === 'W') ? sprintf(str, "Writer %d", its_PgNum + 1) :
    (t === 'R') ? sprintf(str, "Reader %d", its_PgNum + 1) :
    (t === 'E') ? (
        b = its_Pg_Blk(t, its_PgNum);
        sprintf(str, "%s %d", (b !== 0) ? its_EfxTyS[max(0, min(its_Efx_TyCnt - 1, b[its_Efx_Type]))] : "Effect", its_PgNum + 1);
    ) :
    (t === 'B') ? sprintf(str, "Bus %d", its_PgNum + 1) :
    (t === 'O') ? strcpy(str, "Out") :
    (t === 'I') ? strcpy(str, "In") : sprintf(str, "Ctl %d", its_PgNum + 1);
    str;
);

// the links of the box "v" after #its_PgT2 : those that come to it (fr = 1), those that go from it
function its_Pg_Links(v, fr) local(e, f, w)
(
    f = 0; e = 0; loop(its_PgEN,
        ((fr ? its_PgEB[e] : its_PgEA[e]) === v) ? (
            (strlen(#its_PgT2) < 500) ? (
                strcat(#its_PgT2, f ? ", " : " ");
                w = fr ? its_PgEA[e] : its_PgEB[e];
                strcat(#its_PgT2, its_Pg_Label(#its_PgLb, w));
                (its_PgEK[e] === 1) ? strcat(#its_PgT2, " (mod.)") : (its_PgEK[e] === 2) ? strcat(#its_PgT2, " (loop)");
            );
            f = 1;
        );
        e += 1;
    );
    !f ? strcat(#its_PgT2, " nothing");
);

// the text of the box "v" (#its_PgT1) and its links (#its_PgT2)
function its_Pg_Text(v) local(t, k, b, o)
(
    t = its_Pg_Kind(v); k = its_PgNum;
    ((t === 'R') || (t === 'W') || (t === 'E')) ? (
        ((b = its_Pg_Blk(t, k)) !== 0) ? ( its_Sum_Text(t, k, b); strcpy(#its_PgT1, #its_SumTxt); ) :
            sprintf(#its_PgT1, "%s : deleted", its_Pg_Label(#its_PgLb, v));
    ) :
    (t === 'L') ? (
        ((b = its_Pg_Blk(t, k)) !== 0) ? (
            sprintf(#its_PgT1, "Line %d : %.3f s, %d channels", k + 1, b[its_Lin_SmplCntSec], b[its_Lin_ChCnt]);
            ((o = its_Xp_Owner(its_TK_Line, b)) > 0) ? strcat(#its_PgT1, sprintf(#its_PgLb, " (%s)", its_Al_OwnName(#its_OwnN, o)));
            (strlen(its_LnFile[k]) > 0) ? strcat(#its_PgT1, sprintf(#its_PgLb, ", file %s", its_LnFile[k]));
        ) : sprintf(#its_PgT1, "Line %d : deleted", k + 1);
    ) :
    (t === 'B') ? sprintf(#its_PgT1, "Bus %d : %d channels", k + 1, BusWidth[k]) :
    (t === 'O') ? strcpy(#its_PgT1, "Out : the outputs of the track") :
    (t === 'I') ? sprintf(#its_PgT1, "In : %s", its_Pch_TrackTxt(#its_PchTrk)) :
    sprintf(#its_PgT1, "Ctl %d : the slider Ctl %d", k + 1, k + 1);
    strcpy(#its_PgT2, "From"); its_Pg_Links(v, 1);
    strcat(#its_PgT2, "  -  to"); its_Pg_Links(v, 0);
);

// the box under the mouse : its node, or -1
function its_Pg_Hover() local(r, i, v, x, y)
(
    r = -1;
    ui_hover() ? (
        i = 0; while ((r < 0) && (i < its_PgN)) (
            v = its_PgOrd[i];
            its_Pg_Vis(v) ? (
                x = its_Pg_NX(v); y = its_Pg_NY(v);
                ((uix_mouse_x >= x) && (uix_mouse_x < x + its_PgNodW) && (uix_mouse_y >= y) && (uix_mouse_y < y + its_PgNodH)) ?
                    (r = v);
            );
            i += 1;
        );
    );
    r;
);

// draws the graph in the current rect (its_Pg_Geo) ; the box "hk" under the mouse (-1 : none) and its links stand out
function its_Pg_Draw(hk)
local (rs, e, a, b, va, vb, xa, ya, xb, yb, dx, i, n, t, u, x1, y1, x2, y2, kd, hl, k, v, x, y, o, c, j, ty, f)
(
    rs = uix_drawconfig_current[9]; // retina scaling
    // the links : from the right of "a" to the left of "b" (a column not shown : the border), a cubic Bezier horizontal at its
    // ends, in 20 segments (a modulation : dashed ; the writer that a loop follows : dotted), an arrow
    e = 0; loop(its_PgEN,
        a = its_PgEA[e]; b = its_PgEB[e];
        va = its_Pg_Vis(a); vb = its_Pg_Vis(b);
        (va || vb) ? (
            kd = its_PgEK[e];
            hl = (hk >= 0) && ((a === hk) || (b === hk));
            xa = va ? its_Pg_NX(a) + its_PgNodW : (its_PgCol[a] < its_PgSc) ? its_PgAx : its_PgAx + its_PgAw;
            xb = vb ? its_Pg_NX(b) : (its_PgCol[b] < its_PgSc) ? its_PgAx : its_PgAx + its_PgAw;
            ya = its_Pg_NY(a) + its_PgNodH / 2; yb = its_Pg_NY(b) + its_PgNodH / 2;
            dx = max(0.4 * its_PgColW, abs(xb - xa) / 2);
            ui_pcolor((kd === 0) ? Color_Limegreen : (kd === 1) ? Color_Light_Sky_Blue : 0x909090, hl ? 1 : (hk >= 0) ? 0.25 : 0.7);
            n = 20; x1 = xa; y1 = ya;
            i = 1; loop(n,
                t = i / n; u = 1 - t;
                x2 = max(its_PgAx, min(its_PgAx + its_PgAw, u * u * u * xa + 3 * u * t * (u * (xa + dx) + t * (xb - dx)) + t * t * t * xb));
                y2 = ya + (yb - ya) * t * t * (3 - 2 * t);
                ((kd === 0) || ((kd === 1) && (i & 2)) || ((kd === 2) && (i & 1))) ? (
                    gfx_line(x1 * rs, y1 * rs, x2 * rs, y2 * rs, 1);
                    (hl || (rs > 1)) ? gfx_line(x1 * rs, y1 * rs + 1, x2 * rs, y2 * rs + 1, 1);
                );
                x1 = x2; y1 = y2;
                i += 1;
            );
            vb ? (
                k = (hl ? 4 : 3) * rs;
                gfx_triangle(xb * rs, yb * rs, xb * rs - 2 * k, yb * rs - k, xb * rs - 2 * k, yb * rs + k);
            );
        );
        e += 1;
    );
    // the boxes
    i = 0; loop(its_PgN,
        v = its_PgOrd[i];
        its_Pg_Vis(v) ? (
            x = its_Pg_NX(v); y = its_Pg_NY(v);
            ty = its_Pg_Kind(v); k = its_PgNum; o = 0;
            c = (ty === 'L') ? Color_Heliotrope : (ty === 'B') ? Col_P3 : (ty === 'C') ? Color_Light_Sky_Blue :
                ((ty === 'I') || (ty === 'O')) ? 0xB0B0B0 :
                ((o = its_Pg_Blk(ty, k)) !== 0) ? its_Sum_Color(ty, its_Sum_State(ty, o)) : Col_Inactive;
            ui_pcolor(c, (v === hk) ? 0.5 : 0.22);
            gfx_rect(x * rs, y * rs, its_PgNodW * rs, its_PgNodH * rs);
            // its frame ; the module designated (its patch) : a thick one
            ui_pcolor(c, 1);
            n = (((PGraphStruct[0] === 0) && (v === its_Tb_RBase(its_XpTy) + its_XpK)) ? 3 : 1) * max(1, floor(rs));
            j = 0; loop(n, gfx_rect(x * rs + j, y * rs + j, its_PgNodW * rs - 2 * j, its_PgNodH * rs - 2 * j, 0); j += 1;);
            // a red dot : an effect in error (not off), a reader muted (or by another one in solo)
            f = (o !== 0) && (((ty === 'E') && (o[its_Efx_Error] !== 0) && (o[its_Efx_Status] !== its_EfxStat_Off)) ||
                ((ty === 'R') && ((o[its_Rdr_StFlgs] & its_RdrFlg_mute) || ((its_RdrSolos !== 0) && !(o[its_Rdr_StFlgs] & its_RdrFlg_solo)))));
            f ? (
                gfx_set(0.9, 0.1, 0.1, 1);
                gfx_circle((x + its_PgNodW - 5) * rs, (y + 5) * rs, 2.5 * rs, 1, 1);
            );
            ui_push();
                ui_set_rect(x + 3, y, its_PgNodW - 6, its_PgNodH);
                ui_pcolor(ui_jcolor_text);
                ui_align(0.5, 0.5);
                uix_font_dirty = 1; // (a long name : ui_text makes the font smaller ; the next box : the usual one again)
                ui_text(its_Pg_Label(#its_PgLb, v));
            ui_pop();
        );
        i += 1;
    );
    uix_font_dirty = 1;
);

function show_PGraph_Pad(blockId)
local (h1, h3, gh, pt, uix_jneed, zzmi, i, b, o, zz, zzmcl, xx, hk, ty, k)
(
    // the graph : twice per second, at once after a change
    (its_PgForce || (gfxStartTime - its_PgT > 0.5)) ? ( its_PgT = gfxStartTime; its_PgForce = 0; its_Pg_Compute(); );
    h1 = uix_jpadHeight(1);
    h3 = uix_jBoxHeight(2);
    pt = ui_texth() + 12; // (the height of a row)
    // the graph : its rows ; not much room : smaller rows (two at least)
    gh = min(max(2, its_PgRows) * pt + 8, max(2 * pt + 8, ui_height() - h1 - h3 - ui_jd_ctgr));
    uix_jneed = h1+gh+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            // line 1
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Pg_Labs, pad_Pg_Siz);
                i = 0; loop(pad_Pg_Siz, pad_Pg_Colrs[i] = Col_InfoA; strcpy(pad_Pg_Labs[i], ""); i += 1;);
                strcpy(pad_Pg_Labs[0], "Patch");
                b = its_Xp_Blk(its_XpTy, its_XpK);
                strcpy(pad_Pg_Labs[1], its_Tb_TyName(its_XpTy));
                pad_Pg_Colrs[1] = Col_P1;
                sprintf(pad_Pg_Labs[2], "%d", its_XpK + 1);
                ((b !== 0) && ((o = its_Xp_Owner(its_XpTy, b)) > 0) && ((xx = its_Xp_InsName(o, its_XpTy, its_XpK)) !== 0)) ?
                    strcat(pad_Pg_Labs[2], sprintf(#its_PgLb, " %s", mSL_edit_value(#its_PgV, xx)));
                pad_Pg_Colrs[2] = (b !== 0) ? Col_P1 : Col_Inactive;
                strcpy(pad_Pg_Labs[3], (PGraphStruct[0] === 1) ? "All modules" : "Its patch");
                pad_Pg_Colrs[3] = Col_P3;
                strcpy(pad_Pg_Labs[4], PGraphStruct[1] ? "In, Ctl hidden" : "In, Ctl shown");
                pad_Pg_Colrs[4] = PGraphStruct[1] ? Col_Inactive : Col_P3;
                (its_PgN === 0) ? strcpy(pad_Pg_Labs[5], "No column") :
                (its_PgNC > its_PgNv) ? sprintf(pad_Pg_Labs[5], "Columns %d-%d / %d", its_PgSc + 1, its_PgSc + its_PgNv, its_PgNC) :
                    sprintf(pad_Pg_Labs[5], "Columns %d", its_PgNC);
                pad_Pg_Colrs[5] = (its_PgNC > its_PgNv) ? Col_P3 : Col_Inactive;
                sprintf(pad_Pg_Labs[6], "Modules %d", its_PgNbE + its_PgNbR + its_PgNbW + its_PgNbL);
                strcpy(pad_Pg_Labs[7], "Action");
                pad_Pg_Colrs[7] = Col_P1;
                zz = control_jpad(pad_Pg);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    its_PgForce = 1;
                    zzmcl = pad_Pg[ui_jpad_last]-1;
                    (zz & (ui_jpad_ev_rmc | ui_jpad_ev_lmc)) ? (
                        (zzmcl === 1) ? (
                            xx = its_Menu_Clic(menu_Xp_Kind, zz);
                            (xx > 0) ? (
                                its_XpTy = its_Xp_TyOf(xx - 1);
                                its_XpK = min(its_XpK, its_Tb_Count(its_XpTy) - 1);
                                PGraphStruct[0] = PGraphStruct[2] = 0;
                            );
                        ) :
                        (zzmcl === 2) ? (
                            xx = its_Menu_Clic((its_XpTy === its_TK_Effect) ? menu_Efx_Ids : (its_XpTy === its_TK_Reader) ? menu_Rdr_Ids :
                                (its_XpTy === its_TK_Writer) ? menu_Wrt_Ids : menu_Lin_Ids, zz);
                            (xx > 0) ? ( its_XpK = xx - 1; PGraphStruct[0] = PGraphStruct[2] = 0; );
                        ) :
                        (zzmcl === 3) ? ( PGraphStruct[0] = !PGraphStruct[0]; PGraphStruct[2] = 0; ) :
                        (zzmcl === 4) ? ( PGraphStruct[1] = !PGraphStruct[1]; ) :
                        (zzmcl === 5) ? (
                            PGraphStruct[2] = max(0, min(its_PgNC - its_PgNv, its_PgSc + ((zz & ui_jpad_ev_lmc) ? 1 : -1)));
                        ) :
                        (zzmcl === 7) ? (
                            xx = its_Menu_Clic(menu_Pg_Act, zz);
                            ((xx > 0) && (b === 0)) ? (
                                sprintf(#its_PgT1, "Patch : %s %d does not exist", its_Tb_TyName(its_XpTy), its_XpK + 1);
                                mSL_log(SysLogBox, #its_PgT1);
                            ) :
                            (xx === 1) ? its_Xp_Ask(1, its_XpTy, its_XpK) :
                            (xx === 2) ? its_Xp_Text(1, its_XpTy, its_XpK, 0);
                        );
                    );
                );
            ui_pop();

            // the graph
            ui_split_top(gh);
                ui_pad(2,4,2,4);
                its_Pg_Geo();
                // the wheel : the columns
                ((xx = ui_scroll_y()) !== 0) ? (
                    PGraphStruct[2] = max(0, min(its_PgNC - its_PgNv, its_PgSc + ((xx < 0) ? 1 : -1)));
                    its_Pg_Geo();
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                );
                hk = its_Pg_Hover();
                (its_PgN > 0) ? its_Pg_Draw(hk);
                // the clics on a box (a module)
                (hk >= 0) ? (
                    ty = its_Pg_Kind(hk); k = its_PgNum;
                    (((ty === 'R') || (ty === 'W') || (ty === 'E') || (ty === 'L')) && ((o = its_Pg_Blk(ty, k)) !== 0)) ? (
                        ui_click(1) ? (
                            (uix_clickmods & altCap) ? its_Sum_Open(ty, k, blockId, 0) : (ty !== 'L') ? its_Sum_Toggle(ty, k, o);
                            its_PgForce = 1; ui_GFXdoNow |= 4; ui_GFXReason = 36;
                        ) :
                        ui_click(2) ? (
                            (ty === 'L') ? (
                                ui_menu_tick(menu_PgL, -1, 0);
                                xx = control_jmenu(menu_PgL);
                                ui_menu_tick(menu_PgL, -1, 0);
                                ((xx === 1) || (xx === 2)) ? its_Sum_Open('L', k, blockId, xx === 2) :
                                (xx === 3) ? its_Pg_ShowPatch('L', k);
                            ) : (
                                its_Sum_Menu(ty, k, o, blockId);
                            );
                            its_PgForce = 1; ui_GFXdoNow |= 4; ui_GFXReason = 36;
                        );
                    );
                );
            ui_pop();

            // the text : the box under the mouse and its links, else the patch
            ui_split_top(h3);
                ui_pad(4,2,4,2);
                ui_pcolor(ui_jcolor_text);
                ui_align(0, 0);
                (hk >= 0) ? its_Pg_Text(hk) :
                !its_PgOk ? (
                    sprintf(#its_PgT1, "%s %d does not exist : no patch.", its_Tb_TyName(its_XpTy), its_XpK + 1);
                    strcpy(#its_PgT2, "Choose a module (its kind, its number), or all the modules.");
                ) : (
                    (PGraphStruct[0] === 1) ? strcpy(#its_PgT1, "All the modules") :
                        sprintf(#its_PgT1, "The patch of %s %d", its_Tb_TyName(its_XpTy), its_XpK + 1);
                    strcat(#its_PgT1, sprintf(#its_PgLb, " : %d effects, %d readers, %d writers, %d lines", its_PgNbE, its_PgNbR,
                        its_PgNbW, its_PgNbL));
                    its_PgEOv ? strcat(#its_PgT1, " (too many links : some are not shown)");
                    strcpy(#its_PgT2, "Clic : start / pause, on / off ; Alt + clic : open ; right clic : menu ; wheel : the columns");
                );
                ui_split_top(ui_texth()); ui_text(#its_PgT1); ui_pop();
                ui_split_top(ui_texth()); ui_text(#its_PgT2); ui_pop();
                uix_font_dirty = 1;
            ui_pop();

        ui_pop();
    );
);

/*
    the curve "b" in the current rect (retina coordinates) : the guides, the segments, the points (the first and the last :
    another color ; the selected one, b[its_Crv_Sel] : Goldenrod ; the sustain point : an orange frame and a vertical line) ;
    also the y of a point "px", "py" (see its_Crv_Py)
*/
its_CrvPad = 6; // margin of the graphic area (pixels), so that the points at the edges are seen
// the pixel (retina) of x in [0, 1], of y in [lo, 1]
function its_Crv_Px(x0, w, x) ( x0 + its_CrvPad + x * (w - 1 - 2 * its_CrvPad); );
function its_Crv_Py(y0, h, lo, y) ( y0 + its_CrvPad + (1 - y) / (1 - lo) * (h - 1 - 2 * its_CrvPad); );

// the state of the curve "k" when a gesture starts (its_Crv_Pre), kept for the Undo once the curve changes (its_Crv_Commit)
function its_Crv_Pre(k) local(b)
(
    b = its_CrvBlk[k];
    its_CrvPreK = k; its_CrvPreE = (b > BASE_MEMORY); strcpy(#its_CrvPreN, its_CrvNm[k]);
    its_CrvPreE ? memcpy(its_CrvPreB, b, its_Crv_BlkSize);
);
function its_Crv_Commit()
(
    (its_CrvPreK >= 0) ? (
        its_CrvUndoK = its_CrvPreK; its_CrvUndoE = its_CrvPreE; strcpy(#its_CrvUndoN, #its_CrvPreN);
        its_CrvPreE ? memcpy(its_CrvUndoB, its_CrvPreB, its_Crv_BlkSize);
        its_CrvPreK = -1;
    );
);
// Undo : the curve "k" and the one kept are exchanged (a second Undo restores the change)
function its_Crv_Undo(k) local(b, e)
(
    (its_CrvUndoK === k) ? (
        b = its_CrvBlk[k]; e = (b > BASE_MEMORY); strcpy(#its_CrvTmpN, its_CrvNm[k]);
        e ? memcpy(its_CrvTmpB, b, its_Crv_BlkSize);
        its_CrvUndoE ? (
            (!e) ? ( ((b = mSL_Dyn_Alloc(its_Crv_BlkSize, KW_crvb, 0)) > BASE_MEMORY) ? (its_CrvBlk[k] = b) : (b = 0); );
            (b > BASE_MEMORY) ? memcpy(b, its_CrvUndoB, its_Crv_BlkSize);
        ) : (
            e ? ( mSL_Dyn_Free(b); its_CrvBlk[k] = 0; );
        );
        strcpy(its_CrvNm[k], #its_CrvUndoN);
        e ? memcpy(its_CrvUndoB, its_CrvTmpB, its_Crv_BlkSize);
        its_CrvUndoE = e; strcpy(#its_CrvUndoN, #its_CrvTmpN);
    );
);

// a value on the grid (its_CrvGrid divisions of [lo, 1]), or as is
function its_Crv_Snap(v, lo)
(
    (its_CrvGrid > 0) ? lo + floor((v - lo) / (1 - lo) * its_CrvGrid + 0.5) / its_CrvGrid * (1 - lo) : v;
);

// the selection of points (its_CrvSelF, of the curve its_CrvSelK) : cleared, counted ; the point "i" deleted
function its_Crv_SelClear() ( memset(its_CrvSelF, 0, its_CrvPMx); );
function its_Crv_SelCount(n) local(i, c) ( c = 0; i = 0; loop(n, c += its_CrvSelF[i]; i += 1;); c; );
function its_Crv_SelDel(i, n) ( memcpy(its_CrvSelF + i, its_CrvSelF + i + 1, n - i - 1); its_CrvSelF[n - 1] = 0; );

/*
    the selected points move by (dx, dy) from their places when the gesture started (its_CrvOrig), as far as the frame and
    the points not selected allow (the first and the last point : y only) ; "r" : the point taken by the mouse
*/
function its_Crv_Move(b, r, x, y, lo) local(n, p, o, i, j, dx, dy, dmin, dmax, emin, emax, mv)
(
    n = b[its_Crv_N]; p = b + its_Crv_Pts; o = its_CrvOrig;
    dx = x - o[3 * r]; dy = y - o[3 * r + 1];
    dmin = emin = -(10^30); dmax = emax = 10^30; // (-10^30 is (-10)^30 > 0 in EEL2)
    i = 0; loop(n,
        its_CrvSelF[i] ? (
            // y : in the frame
            emin = max(emin, lo - o[3 * i + 1]); emax = min(emax, 1 - o[3 * i + 1]);
            // x : between the nearest points that do not move in x (not selected, or the first, the last)
            ((i > 0) && (i < n - 1)) ? (
                j = i - 1; while ((j > 0) && its_CrvSelF[j]) ( j -= 1; );
                dmin = max(dmin, o[3 * j] - o[3 * i]);
                j = i + 1; while ((j < n - 1) && its_CrvSelF[j]) ( j += 1; );
                dmax = min(dmax, o[3 * j] - o[3 * i]);
            );
        );
        i += 1;
    );
    dx = max(dmin, min(dmax, dx)); dy = max(emin, min(emax, dy));
    i = 0; loop(n,
        its_CrvSelF[i] ? (
            ((i > 0) && (i < n - 1)) ? (p[3 * i] = o[3 * i] + dx);
            p[3 * i + 1] = o[3 * i + 1] + dy;
        );
        i += 1;
    );
    // periodic : the first and the last y stay equal
    (b[its_Crv_Flags] & its_CrvFl_Periodic) ? (
        (its_CrvSelF[0] && !its_CrvSelF[n - 1]) ? (p[3 * (n - 1) + 1] = p[1]) :
        (its_CrvSelF[n - 1] && !its_CrvSelF[0]) ? (p[1] = p[3 * (n - 1) + 1]);
    );
);

/*
    the mouse in the graphic area of the curve "b" (number "k"), in the current rect (retina coordinates) :
    left clic on a point : it is the selection (a point already in a selection of several : the selection is kept), moved
    while the button is down ; shift + left clic on a point : the points from the first selected (b[its_Crv_Sel]) to it are
    added to the selection ; cmd + left clic : the point is added to the selection, or removed ; the selected points move
    together (x between the points not selected ; the first and the last : y only) ; shift and cmd + clic never create a
    point : they take the nearest point within 16 pixels, or do nothing ;
    left clic near the curve, between two points : drag up or down for the curvature of the segment (a clic without moving : 0) ;
    left clic elsewhere : a new point, the selection (moved while the button is down) ; right clic on a point : deletes it,
    or all the selection if it is selected (not the first and the last point ; the sustain point deleted : no sustain) ;
    shift while moving : fine moves (1/10, no grid) ; the grid (cell 5)
*/
function its_Crv_Edit(b, k)
local (x0, y0, w, h, lo, rp, mx, my, cap, ins, press, rpress, n, p, i, j, hs, hit, xv, yv, ya, f, dxm, dym, x, y, sg)
(
    x0 = ui_left_retina(); y0 = ui_top_retina(); w = ui_width_retina(); h = ui_height_retina();
    // the distances of the mouse in screen points (screen pixels / rp) : the same at all display sizes
    rp = gfx_ext_retina ? gfx_ext_retina : 1;
    lo = its_Crv_Lo(b[its_Crv_Type]);
    cap = mouse_cap; mx = mouse_x; my = mouse_y;
    ins = ui_hover();
    press = (cap & 1) && !(its_CrvMPrev & 1) && ins;
    rpress = (cap & 2) && !(its_CrvMPrev & 2) && ins;
    its_CrvMPrev = cap;
    n = b[its_Crv_N]; p = b + its_Crv_Pts;
    // the point under the mouse (the nearest one), the x and y of the mouse
    hs = 8 * rp; hit = -1; f = 10^30;
    i = 0; loop(n,
        x = abs(mx - its_Crv_Px(x0, w, p[3 * i])); y = abs(my - its_Crv_Py(y0, h, lo, p[3 * i + 1]));
        ((x <= hs) && (y <= hs) && (x + y < f)) ? ( hit = i; f = x + y; );
        i += 1;
    );
    // shift or cmd + clic : the nearest point, a little further (these clics select : no new point, no curvature)
    (press && (hit < 0) && (cap & (shfCap | cmdCap))) ? (
        hs = 16 * rp; f = 10^30;
        i = 0; loop(n,
            x = abs(mx - its_Crv_Px(x0, w, p[3 * i])); y = abs(my - its_Crv_Py(y0, h, lo, p[3 * i + 1]));
            ((x <= hs) && (y <= hs) && (x + y < f)) ? ( hit = i; f = x + y; );
            i += 1;
        );
        (hit < 0) ? (press = 0);
    );
    xv = max(0, min(1, (mx - x0 - its_CrvPad) / max(1, w - 1 - 2 * its_CrvPad)));
    yv = max(lo, min(1, 1 - (my - y0 - its_CrvPad) / max(1, h - 1 - 2 * its_CrvPad) * (1 - lo)));
    press ? (
        its_Crv_Pre(k);
        its_CrvM0x = mx; its_CrvM0y = my; its_CrvMoved = 0;
        ((hit >= 0) && (cap & shfCap) && (b[its_Crv_Sel] >= 0) && (b[its_Crv_Sel] < n) && its_CrvSelF[b[its_Crv_Sel]]) ? (
            // shift : the points from the first selected to this one
            i = min(hit, b[its_Crv_Sel]); loop(abs(hit - b[its_Crv_Sel]) + 1, its_CrvSelF[i] = 1; i += 1;);
        ) :
        ((hit >= 0) && (cap & (cmdCap | shfCap))) ? (
            // cmd (or shift without a selected point) : this point added to the selection, or removed
            its_CrvSelF[hit] = !its_CrvSelF[hit];
            its_CrvSelF[hit] ? (b[its_Crv_Sel] = hit) : (b[its_Crv_Sel] === hit) ? (b[its_Crv_Sel] = -1);
        ) :
        (hit >= 0) ? (
            // this point (or the selection that holds it) is moved
            !(its_CrvSelF[hit] && (its_Crv_SelCount(n) > 1)) ? ( its_Crv_SelClear(); its_CrvSelF[hit] = 1; b[its_Crv_Sel] = hit; );
            its_CrvDrag = 1; its_CrvDragI = hit;
            its_CrvP0x = p[3 * hit]; its_CrvP0y = p[3 * hit + 1];
            memcpy(its_CrvOrig, p, 3 * n);
        ) : (
            // the segment under the mouse : i ... i + 1
            i = 0; while ((i < n - 2) && (p[3 * (i + 1)] <= xv)) ( i += 1; );
            ya = its_Crv_Py(y0, h, lo, its_Crv_Val(b, xv));
            ((abs(my - ya) <= 6 * rp) && (p[3 * (i + 1)] > p[3 * i])) ? (
                its_CrvDrag = 2; its_CrvDragI = i; its_CrvC0 = p[3 * i + 2];
            ) :
            (n < its_CrvPMx) ? (
                // a new point after the point i (its x : between them), the selection
                its_Crv_Commit();
                memcpy(p + 3 * (i + 2), p + 3 * (i + 1), 3 * (n - i - 1));
                x = max(p[3 * i], min(p[3 * (i + 2)], its_Crv_Snap(xv, 0)));
                p[3 * (i + 1)] = x; p[3 * (i + 1) + 1] = max(lo, min(1, its_Crv_Snap(yv, lo))); p[3 * (i + 1) + 2] = 0;
                n += 1; b[its_Crv_N] = n;
                (b[its_Crv_Sus] > i) ? (b[its_Crv_Sus] += 1);
                its_Crv_SelClear(); its_CrvSelF[i + 1] = 1; b[its_Crv_Sel] = i + 1;
                its_CrvDrag = 1; its_CrvDragI = i + 1;
                its_CrvP0x = p[3 * (i + 1)]; its_CrvP0y = p[3 * (i + 1) + 1];
                memcpy(its_CrvOrig, p, 3 * n);
            ) : (
                sprintf(#its_CrvMsg, "Curve %d : %d points at most", k + 1, its_CrvPMx);
                mSL_log(SysLogBox, #its_CrvMsg);
            );
        );
        ui_GFXdoNow |= 4; ui_GFXReason = 38;
    );
    (rpress && (hit >= 0)) ? (
        // delete the point (a selected point : all the selection), not the first and the last
        its_Crv_Pre(k);
        !its_CrvSelF[hit] ? ( its_Crv_SelClear(); its_CrvSelF[hit] = 1; );
        j = 0;
        i = n - 2; while (i > 0) (
            its_CrvSelF[i] ? (
                (j === 0) ? its_Crv_Commit(); j += 1;
                memcpy(p + 3 * i, p + 3 * (i + 1), 3 * (n - i - 1));
                its_Crv_SelDel(i, n);
                (b[its_Crv_Sus] === i) ? (b[its_Crv_Sus] = -1) : (b[its_Crv_Sus] > i) ? (b[its_Crv_Sus] -= 1);
                n -= 1;
            );
            i -= 1;
        );
        b[its_Crv_N] = n;
        its_Crv_SelClear(); b[its_Crv_Sel] = -1;
        ui_GFXdoNow |= 4; ui_GFXReason = 38;
    );
    // the button held : the selected points or the curvature follow the mouse (shift : 1/10)
    ((cap & 1) && its_CrvDrag) ? (
        f = (cap & shfCap) ? 0.1 : 1;
        dxm = (mx - its_CrvM0x) * f; dym = (my - its_CrvM0y) * f;
        ((abs(mx - its_CrvM0x) + abs(my - its_CrvM0y) > 2) && !its_CrvMoved) ? ( its_CrvMoved = 1; its_Crv_Commit(); );
        its_CrvMoved ? (
            i = its_CrvDragI;
            (its_CrvDrag === 1) ? (
                x = its_CrvP0x + dxm / max(1, w - 1 - 2 * its_CrvPad);
                y = its_CrvP0y - dym / max(1, h - 1 - 2 * its_CrvPad) * (1 - lo);
                (f === 1) ? ( x = its_Crv_Snap(x, 0); y = its_Crv_Snap(y, lo); );
                its_Crv_Move(b, i, x, y, lo);
                its_Crv_Clamp(b); // (QWave, HWave : the y fixed at 0)
            ) : (
                // drag up : the segment bulges up (rising : c > 0 ; falling : c < 0)
                sg = (p[3 * (i + 1) + 1] >= p[3 * i + 1]) ? 1 : -1;
                p[3 * i + 2] = max(-1, min(1, its_CrvC0 - sg * dym / max(1, h / 2)));
            );
            ui_GFXdoNow |= 4; ui_GFXReason = 38;
        );
    );
    // the button released : a clic on a segment, without moving : its curvature is 0
    (!(cap & 1) && its_CrvDrag) ? (
        ((its_CrvDrag === 2) && !its_CrvMoved && (p[3 * its_CrvDragI + 2] !== 0)) ? ( its_Crv_Commit(); p[3 * its_CrvDragI + 2] = 0; );
        its_CrvDrag = 0; its_CrvPreK = -1;
        ui_GFXdoNow |= 4; ui_GFXReason = 38;
    );
);
function its_Crv_Draw(b)
local (x0, y0, w, h, rsc, lo, i, n, p, xa, ya, xb, yb, d, k)
(
    x0 = ui_left_retina(); y0 = ui_top_retina(); w = ui_width_retina(); h = ui_height_retina();
    rsc = max(1, floor(uix_drawconfig_current[9])); // retina scaling
    lo = its_Crv_Lo(b[its_Crv_Type]);
    ui_pcolor(0x808080, 0.15);
    gfx_rect(x0, y0, w, h);
    // the guides : y = 0, 1 (and -1), the middle
    ui_pcolor(0x808080, 0.6);
    gfx_line(x0, its_Crv_Py(y0, h, lo, 0), x0 + w - 1, its_Crv_Py(y0, h, lo, 0));
    ui_pcolor(0x808080, 0.3);
    gfx_line(x0, its_Crv_Py(y0, h, lo, 1), x0 + w - 1, its_Crv_Py(y0, h, lo, 1));
    gfx_line(x0, its_Crv_Py(y0, h, lo, lo), x0 + w - 1, its_Crv_Py(y0, h, lo, lo));
    (lo === 0) ? gfx_line(x0, its_Crv_Py(y0, h, lo, 0.5), x0 + w - 1, its_Crv_Py(y0, h, lo, 0.5));
    // the sustain point : a vertical line between the rise and the fall
    (b[its_Crv_Sus] >= 0) ? (
        ui_pcolor(Color_Dark_Orange, 0.55);
        xa = floor(its_Crv_Px(x0, w, b[its_Crv_Pts + 3 * b[its_Crv_Sus]]));
        gfx_line(xa, y0, xa, y0 + h - 1);
        (rsc > 1) ? gfx_line(xa + 1, y0, xa + 1, y0 + h - 1);
    );
    (its_CrvGrid > 0) ? (
        ui_pcolor(0x808080, 0.18);
        i = 1; loop(its_CrvGrid - 1,
            d = i / its_CrvGrid;
            gfx_line(its_Crv_Px(x0, w, d), y0, its_Crv_Px(x0, w, d), y0 + h - 1);
            gfx_line(x0, its_Crv_Py(y0, h, lo, lo + d * (1 - lo)), x0 + w - 1, its_Crv_Py(y0, h, lo, lo + d * (1 - lo)));
            i += 1;
        );
    );
    // the curve : each segment from its first point to the next one (exactly : the vertical jumps are complete), one value per pixel
    ui_pcolor(uix_theme_accent(), 0.95);
    p = b + its_Crv_Pts;
    loop(b[its_Crv_N] - 1,
        xa = its_Crv_Px(x0, w, p[0]); ya = its_Crv_Py(y0, h, lo, p[1]);
        n = max(1, ceil(its_Crv_Px(x0, w, p[3]) - xa)); // pixels of the segment
        i = 1; loop(n,
            d = i / n;
            xb = xa + (its_Crv_Px(x0, w, p[3]) - its_Crv_Px(x0, w, p[0])) / n;
            yb = its_Crv_Py(y0, h, lo, p[1] + (p[4] - p[1]) * its_Crv_Shape(d, p[2]));
            gfx_line(xa, ya, xb, yb, 1);
            (rsc > 1) ? gfx_line(xa, ya + 1, xb, yb + 1, 1);
            xa = xb; ya = yb;
            i += 1;
        );
        p += 3;
    );
    // the points
    k = 3 * rsc;
    p = b + its_Crv_Pts; i = 0;
    loop(b[its_Crv_N],
        xa = its_Crv_Px(x0, w, p[0]); ya = its_Crv_Py(y0, h, lo, p[1]);
        its_CrvSelF[i] ? ui_pcolor(Color_Goldenrod, 1) :
        ((i === 0) || (i === b[its_Crv_N] - 1)) ? ui_pcolor(Color_Light_Steel_Blue, 1) : ui_pcolor(Color_Limegreen, 1);
        gfx_rect(xa - k, ya - k, 2 * k + 1, 2 * k + 1);
        // the sustain point : also a frame
        (i === b[its_Crv_Sus]) ? (
            ui_pcolor(Color_Dark_Orange, 1);
            gfx_rect(xa - 2 * k, ya - 2 * k, 4 * k + 1, 4 * k + 1, 0);
            (rsc > 1) ? gfx_rect(xa - 2 * k + 1, ya - 2 * k + 1, 4 * k - 1, 4 * k - 1, 0);
        );
        p += 3; i += 1;
    );
);

/*
    the name "txt" given to the curve "k" (the prompt of the module) : the spaces at the ends removed ; "" : no name ; with Undo
*/
function its_Crv_Rename(k, txt) local(i, l)
(
    l = strlen(txt); i = 0;
    while ((i < l) && (str_getchar(txt, i, 'cu') === ' ')) ( i += 1; );
    while ((l > i) && (str_getchar(txt, l - 1, 'cu') === ' ')) ( l -= 1; );
    strcpy_substr(#its_CrvRenX, txt, i, l - i);
    (its_CrvBlk[k] <= BASE_MEMORY) ? 0 :
    (strcmp(#its_CrvRenX, its_CrvNm[k]) === 0) ? 0 :
    ((strlen(#its_CrvRenX) > 0) && !its_Crv_NmOk(#its_CrvRenX)) ? (
        sprintf(#its_CrvMsg, "Curve %d : a name has 1 ... %d characters, without \"", k + 1, its_CrvNmMx);
        mSL_log(SysLogBox, #its_CrvMsg);
    ) :
    (((i = its_Crv_Find(#its_CrvRenX, 0)) >= 0) && (i !== k)) ? (
        sprintf(#its_CrvMsg, "Curve %d : the name \"%s\" is the one of the curve %d", k + 1, #its_CrvRenX, i + 1);
        mSL_log(SysLogBox, #its_CrvMsg);
    ) : (
        its_Crv_Pre(k); its_Crv_Commit();
        strcpy(its_CrvNm[k], #its_CrvRenX);
    );
);

/*
    the sustain point of the envelope "b" (number "k") : "i" (a point), -1 (none), -2 (the selected point ; already the sustain :
    none) ; with Undo
*/
function its_Crv_SetSus(b, k, i)
(
    (i === -2) ? (
        i = b[its_Crv_Sel];
        ((i >= 0) && (i < b[its_Crv_N]) && its_CrvSelF[i]) ? ( (i === b[its_Crv_Sus]) ? (i = -1); ) : (i = -2);
    );
    (b[its_Crv_Type] !== its_CrvEnv) ? (
        sprintf(#its_CrvMsg, "Curve %d : only an envelope (not a half one) has a sustain point", k + 1);
        mSL_log(SysLogBox, #its_CrvMsg);
    ) :
    (i === -2) ? (
        sprintf(#its_CrvMsg, "Curve %d : sustain : select a point first", k + 1);
        mSL_log(SysLogBox, #its_CrvMsg);
    ) :
    (i !== b[its_Crv_Sus]) ? (
        its_Crv_Pre(k); its_Crv_Commit();
        b[its_Crv_Sus] = i;
    );
);

// the state of the editor "e" (see its_CrvEd) in the globals of the editor drawn ; kept again by its_Crv_EdPut
function its_Crv_EdGet(e) local(p)
(
    p = its_CrvEd + e * its_CrvEdSz;
    its_CrvUiK = p[0]; its_CrvGrid = p[1]; its_CrvMPrev = p[2]; its_CrvDrag = p[3]; its_CrvDragI = p[4];
    its_CrvM0x = p[5]; its_CrvM0y = p[6]; its_CrvMoved = p[7]; its_CrvC0 = p[8]; its_CrvP0x = p[9]; its_CrvP0y = p[10];
    its_CrvSelK = p[11]; its_CrvSelF = its_CrvEdSel + e * its_CrvPMx;
);
function its_Crv_EdPut(e) local(p)
(
    p = its_CrvEd + e * its_CrvEdSz;
    p[0] = its_CrvUiK; p[1] = its_CrvGrid; p[2] = its_CrvMPrev; p[3] = its_CrvDrag; p[4] = its_CrvDragI;
    p[5] = its_CrvM0x; p[6] = its_CrvM0y; p[7] = its_CrvMoved; p[8] = its_CrvC0; p[9] = its_CrvP0x; p[10] = its_CrvP0y;
    p[11] = its_CrvSelK;
);

/*
    The modules "Curves A ... H" (editor "e" : its state in its_CrvEd) : the envelopes (y in [0, 1]) and the waveforms
    (y in [-1, 1]), see "Curve" in table(data(...)) ; several editors may show the same curve (the point b[its_Crv_Sel] is shared) ;
    the half envelopes, the quarters and the halves of waveforms : the part edited only (see its_CrvHEnv ...)
    Cmd + A : all the points are selected (see its_Crv_Edit for the mouse) ; key 'd' : the curve in the log (Dump Curve) ;
    key 's' : the selected point becomes the sustain point of the envelope (again : no sustain)
    line 1 : 0 the curve (left clic : next one, shift : previous one ; right clic : menu), 1 its name (left clic : a prompt,
    see its_Crv_Rename), 2 its type (left clic :
    the next one in its_CrvTyO, shift : the previous one), 3 its count of points, 4 periodic (left clic ; Env and Wave only),
    5 the grid (left clic : Off, 4, 8, 16, 32 ; shift : the other way), 6 Undo (left clic ; again : Redo), 7 actions (right
    or left clic : New envelope, H-envelope, waveform, Q-waveform, H-waveform, Dump, Export the curve, Export all the curves
    (see its_Crv_Export), Sustain : the selected point, Sustain : none, Delete)
    the graphic area (its_CrvGraphH, see its_Crv_Edit), then a line of text : x and y under the mouse, or the selected point
*/
function show_Curves_Pad(blockId, e)
local (h1, h2, h3, uix_jneed, zzmi, jmc, i, k, b, ok, zz, zzmcl, xx, cgh, x0, w, mx, v)
(
    its_Crv_EdGet(e); // (the state of this editor, kept at the end)
    // the prompt of the name closed (OK or Cancel) : the new name, if it changed
    ((its_CrvRenK >= 0) && !(ui_screen() == "control.prompt")) ? ( its_Crv_Rename(its_CrvRenK, #its_CrvRen); its_CrvRenK = -1; );
    k = its_CrvUiK = max(0, min(its_CrvMx - 1, its_CrvUiK));
    b = its_CrvBlk[k];
    ok = (b > BASE_MEMORY) && (b[-2] === KW_crvb);
    (its_CrvSelK !== k) ? ( its_Crv_SelClear(); its_CrvSelK = k; ok ? (b[its_Crv_Sel] = -1); );
    h1 = uix_jpadHeight(1);
    h2 = ok ? its_CrvGraphH : 0;
    h3 = ok ? uix_jBoxHeight(1) : 0;
    uix_jneed = h1+h2+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            // 'd' : the curve in the log, in the syntax of table (Dump Curve)
            (zzmi && ok && GM_key_take('d')) ? its_Crv_Dump(k);
            // 's' : the selected point is the sustain point (again : none)
            (zzmi && ok && GM_key_take('s')) ? its_Crv_SetSus(b, k, -2);
            // Cmd + A : all the points are selected
            (zzmi && ok && (GM_key_mods() & 4) && (GM_key_take('a') || GM_key_take(1))) ? (
                i = 0; loop(b[its_Crv_N], its_CrvSelF[i] = 1; i += 1;);
                b[its_Crv_Sel] = 0;
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            // line 1
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Crv_Labs, pad_Crv_Siz);
                i = 0; loop(pad_Crv_Siz, pad_Crv_Colrs[i] = ok ? Col_InfoA : Col_Inactive; strcpy(pad_Crv_Labs[i], ""); i += 1;);
                sprintf(pad_Crv_Labs[0], "Curve %d", k + 1);
                ok ? (
                    (strlen(its_CrvNm[k]) > 0) ? strcpy(pad_Crv_Labs[1], its_CrvNm[k]) : strcpy(pad_Crv_Labs[1], "(no name)");
                    strcpy(pad_Crv_Labs[2], its_CrvTyL[b[its_Crv_Type]]);
                    sprintf(pad_Crv_Labs[3], "%d points", b[its_Crv_N]);
                    strcpy(pad_Crv_Labs[4], (b[its_Crv_Flags] & its_CrvFl_Periodic) ? "Periodic" : "Not periodic");
                    pad_Crv_Colrs[1] = Color_Goldenrod;
                    pad_Crv_Colrs[2] = pad_Crv_Colrs[4] = Col_P3;
                    ((b[its_Crv_Type] !== its_CrvEnv) && (b[its_Crv_Type] !== its_CrvWave)) ? (pad_Crv_Colrs[4] = Col_Inactive);
                    pad_Crv_Colrs[3] = Color_Heliotrope;
                    (its_CrvGrid > 0) ? sprintf(pad_Crv_Labs[5], "Grid %d", its_CrvGrid) : strcpy(pad_Crv_Labs[5], "No grid");
                    pad_Crv_Colrs[5] = (its_CrvGrid > 0) ? Col_P3 : Col_P1;
                ) : (
                    strcpy(pad_Crv_Labs[1], "No curve");
                );
                strcpy(pad_Crv_Labs[6], "Undo");
                pad_Crv_Colrs[6] = (its_CrvUndoK === k) ? Col_P3 : Col_Inactive;
                strcpy(pad_Crv_Labs[7], "Action");
                pad_Crv_Colrs[7] = Col_P1;
                zz = control_jpad(pad_Crv);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 38;
                    zzmcl = pad_Crv[ui_jpad_last]-1;
                    (zzmcl === 0) ? (
                        (zz & ui_jpad_ev_lmc) ? (
                            // the next curve (shift : the previous one)
                            its_CrvUiK = (jmc & shfCap) ? (k + its_CrvMx - 1) % its_CrvMx : (k + 1) % its_CrvMx;
                        ) :
                        (zz & ui_jpad_ev_rmc) ? (
                            ui_menu_tick(menu_Crv_Ids, -1, 0);
                            ui_menu_tick(menu_Crv_Ids, k + 1, 1);
                            // also tick the header of the sub-menu that holds the current curve (reset below by the tick -1)
                            str_setchar(menu_Crv_Ids[ui_jmenu_items + (0|(k / menu_Crv_Grp)) * (menu_Crv_Grp + 1)], 1, '!');
                            xx = control_jmenu(menu_Crv_Ids);
                            (xx != 0) ? (its_CrvUiK = xx - 1);
                            ui_menu_tick(menu_Crv_Ids, -1, 0);
                        );
                    ) :
                    ((zz & ui_jpad_ev_lmc) && ok && (zzmcl === 1)) ? (
                        // the name : edited by the prompt in #its_CrvRen, taken when the prompt is closed (its_Crv_Rename)
                        strcpy(#its_CrvRen, its_CrvNm[k]); its_CrvRenK = k;
                        sprintf(#its_CrvRenT, "Name of the curve %d (empty : no name)...", k + 1);
                        ui_screen_open("control.prompt");
                        ui_screen_arg(0, #its_CrvRen);
                        ui_screen_arg(1, #its_CrvRenT);
                    ) :
                    ((zz & ui_jpad_ev_lmc) && ok && (zzmcl === 2)) ? (
                        // the next type (shift : the previous one), in the order of its_CrvTyO
                        its_Crv_Pre(k); its_Crv_Commit();
                        i = 0; while ((i < its_CrvTyCnt - 1) && (its_CrvTyO[i] !== b[its_Crv_Type])) ( i += 1; );
                        b[its_Crv_Type] = its_CrvTyO[(i + ((jmc & shfCap) ? its_CrvTyCnt - 1 : 1)) % its_CrvTyCnt];
                        its_Crv_Clamp(b);
                    ) :
                    ((zz & ui_jpad_ev_lmc) && ok && (zzmcl === 4) && ((b[its_Crv_Type] === its_CrvEnv) || (b[its_Crv_Type] === its_CrvWave))) ? (
                        its_Crv_Pre(k); its_Crv_Commit();
                        b[its_Crv_Flags] = b[its_Crv_Flags] ~ its_CrvFl_Periodic;
                        its_Crv_Clamp(b);
                    ) :
                    ((zz & ui_jpad_ev_lmc) && (zzmcl === 5)) ? (
                        i = 0; while ((i < 4) && (its_CrvGridN[i] !== its_CrvGrid)) ( i += 1; );
                        its_CrvGrid = its_CrvGridN[(i + ((jmc & shfCap) ? 4 : 1)) % 5];
                    ) :
                    ((zz & ui_jpad_ev_lmc) && (zzmcl === 6)) ? (
                        its_Crv_Undo(k);
                        its_Crv_SelClear();
                    ) :
                    ((zz & (ui_jpad_ev_rmc | ui_jpad_ev_lmc)) && (zzmcl === 7)) ? ( // the cell "Action" : right or left clic
                        xx = its_Menu_Clic(menu_Crv_Action, zz);
                        (((xx >= 1) && (xx <= 5)) || ((xx === 12) && ok)) ? ( its_Crv_Pre(k); its_Crv_Commit(); ); // (Undo)
                        ((xx >= 1) && (xx <= 5)) ? (
                            // a new curve (the one shown, replaced)
                            (!ok) ? (
                                ((b = mSL_Dyn_Alloc(its_Crv_BlkSize, KW_crvb, 0)) > BASE_MEMORY) ? (its_CrvBlk[k] = b) : (
                                    sprintf(#its_CrvMsg, "Error 2797 : Curve %d : not enough memory", k + 1);
                                    mSL_log(SysLogBox, #its_CrvMsg);
                                );
                            );
                            (its_CrvBlk[k] > BASE_MEMORY) ? its_Crv_Default(its_CrvBlk[k], its_CrvTyO[xx - 1]);
                            its_Crv_SelClear();
                        ) :
                        ((xx === 6) && ok) ? (
                            its_Crv_Dump(k);
                        ) :
                        ((xx === 7) && ok) ? (
                            its_Crv_Export(k);
                        ) :
                        (xx === 8) ? (
                            its_Crv_Export(-1);
                        ) :
                        ((xx === 9) && ok) ? (
                            // (the selected point, even if it is already the sustain)
                            i = b[its_Crv_Sel];
                            its_Crv_SetSus(b, k, ((i >= 0) && (i < b[its_Crv_N]) && its_CrvSelF[i]) ? i : -2);
                        ) :
                        ((xx === 10) && ok) ? (
                            its_Crv_SetSus(b, k, -1);
                        ) :
                        ((xx === 12) && ok) ? (
                            mSL_Dyn_Free(b);
                            its_CrvBlk[k] = 0; strcpy(its_CrvNm[k], "");
                        );
                    );
                );
            ui_pop();

            // the graphic area, then x and y under the mouse
            b = its_CrvBlk[k];
            ((b > BASE_MEMORY) && (h2 > 0)) ? (
                ui_split_top(h2);
                    ui_pad(1,2,2,2);
                    its_Crv_Edit(b, k);
                    its_Crv_Draw(b);
                    cgh = ui_hover();
                    x0 = ui_left_retina(); w = ui_width_retina();
                ui_pop();
                ui_split_top(h3);
                    ui_pad(4,2,4,2);
                    ui_pcolor(ui_jcolor_text);
                    ui_align(0, 0.5);
                    (((i = its_Crv_SelCount(b[its_Crv_N])) > 1) && (its_CrvDrag || !cgh)) ? (
                        ui_text(sprintf(#its_CrvTxt, "%d points selected", i));
                    ) :
                    (((i = b[its_Crv_Sel]) >= 0) && (i < b[its_Crv_N]) && its_CrvSelF[i] && (its_CrvDrag || !cgh)) ? (
                        v = b + its_Crv_Pts + 3 * i;
                        ui_text(sprintf(#its_CrvTxt, "Point %d :  x %.4f   y %.4f   c %.3f%s", i + 1, v[0], v[1], v[2],
                            (i === b[its_Crv_Sus]) ? "   (sustain)" : ""));
                    ) :
                    cgh ? (
                        mx = max(0, min(1, (mouse_x - x0 - its_CrvPad) / max(1, w - 1 - 2 * its_CrvPad)));
                        v = its_Crv_Val(b, mx);
                        ui_text(sprintf(#its_CrvTxt, "x %.4f   y %.4f", mx, v));
                    ) :
                    ((i = b[its_Crv_Sus]) >= 0) ? (
                        v = b + its_Crv_Pts + 3 * i;
                        ui_text(sprintf(#its_CrvTxt, "y in [0, 1]   sustain : point %d (x %.4f, y %.4f)", i + 1, v[0], v[1]));
                    ) : (
                        i = b[its_Crv_Type];
                        ui_text(sprintf(#its_CrvTxt, "%s", (i === its_CrvEnv) ? "y in [0, 1]" : (i === its_CrvWave) ? "y in [-1, 1]" :
                            (i === its_CrvHEnv) ? "the rise, y in [0, 1] (the fall : its mirror)" :
                            (i === its_CrvQWave) ? "a quarter of the waveform, y in [-1, 1] (the first y : 0)" :
                            "the first half of the waveform, y in [-1, 1] (the second : its symmetric about the middle)"));
                    );
                ui_pop();
            );
        ui_pop();
    );
    its_Crv_EdPut(e);
);

/*
    The globals of Interstys (they replace the last native sliders) : one line of 8 cells
    0 : "Globals"  1 : channels  2 : track samples (menu)  3..6 : count of lines, readers, writers, effects
    7 : global action (menu)
    then the sliders "Input Gain" (in "Merge" mode) and "Output Volume" (in "Merge" and "Ignore" modes).
    The values : its_GlSmpl, its_GlInGain, its_GlOutVol (its_Gl_Apply computes the gains) ; the action : its_actions.
*/
function show_Global_Pad(blockId)
local (h1, h2, uix_jneed, zzmi, jmc, i, k, r, xx, zi, zz, zzmcl, nLn, nRd, nWr, nFx, cbl, shIn, shOut)
(
    shIn = (its_GlSmpl === 0);
    shOut = (its_GlSmpl === 0) || (its_GlSmpl === 1);
    h1 = uix_jpadHeight(pad_Glb_NL); // height
    h2 = (shIn + shOut) * (ui_jd_slidh + 3) + 3; // sliders : input gain, output volume
    uix_jneed = h1+h2+ui_jd_ctgr;
    (ui_height() >= h1+ui_jd_ctgr) ? (
        ui_split_top(min(uix_jneed, ui_height()));
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            // the structures in use
            nLn = nRd = nWr = nFx = 0;
            i = 0; loop(LN_CNT, cbl = Lines_Set[i]; ((cbl > BASE_MEMORY) && (cbl[-2] === KW_lcbl)) ? nLn += 1; i += 1;);
            i = 0; loop(RD_CNT, cbl = Readers_set[i]; ((cbl > BASE_MEMORY) && (cbl[-2] === KW_read)) ? nRd += 1; i += 1;);
            i = 0; loop(WR_CNT, cbl = Writers_set[i]; ((cbl > BASE_MEMORY) && (cbl[-2] === KW_writ)) ? nWr += 1; i += 1;);
            i = 0; loop(FX_CNT, cbl = Effects_set[i]; ((cbl > BASE_MEMORY) && (cbl[-2] === KW_effx)) ? nFx += 1; i += 1;);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Glb_Labs, pad_Glb_Siz);
                i = 0; loop(pad_Glb_Siz,
                    pad_Glb_Colrs[i] = Col_InfoA;
                    strcpy(pad_Glb_Labs[i],"");
                    i += 1;);
                strcpy(pad_Glb_Labs[0],"Globals");
                sprintf(pad_Glb_Labs[1],"Channels %d", chcnt);
                // the input almost muted by the input gain (its slider, below) : in red
                ((its_GlSmpl === 0) && (its_GlInGain <= its_InGainLow)) ? (
                    sprintf(pad_Glb_Labs[1],"Channels %d, In %.0f dB", chcnt, its_GlInGain);
                    pad_Glb_Colrs[1] = Col_P6;
                );
                k = max(0, min(2, its_GlSmpl));
                strcpy(pad_Glb_Labs[2],menu_Glb_Smpl_N[k]);
                // track samples : Merge (green), Ignore (orange), Pass (blue)
                pad_Glb_Colrs[2] = (k === 0) ? Color_Limegreen : (k === 1) ? Color_Dark_Orange : Color_Light_Steel_Blue;
                sprintf(pad_Glb_Labs[3],"Lines %d", nLn);
                sprintf(pad_Glb_Labs[4],"Readers %d", nRd);
                sprintf(pad_Glb_Labs[5],"Writers %d", nWr);
                sprintf(pad_Glb_Labs[6],"Effects %d", nFx);
                pad_Glb_Colrs[3] = pad_Glb_Colrs[4] = pad_Glb_Colrs[5] = pad_Glb_Colrs[6] = Color_Heliotrope;
                strcpy(pad_Glb_Labs[7],"Action");
                pad_Glb_Colrs[7] = Col_P1;

                zz = control_jpad(pad_Global);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 35;
                    zzmcl = pad_Global[ui_jpad_last]-1;
                    ((zz & ui_jpad_ev_rmc) || ((zz & ui_jpad_ev_lmc) && (zzmcl === 7))) ? (  // right mouse clic (the cell "Action" : left clic too)
                        (zzmcl === 2) ? (
                            ui_menu_tick(menu_Glb_Smpl, -1, 0);
                            ui_menu_tick(menu_Glb_Smpl, k+1, 1);
                            xx = control_jmenu(menu_Glb_Smpl);
                            (xx != 0) ? (
                                its_GlSmpl = xx - 1; its_Gl_Apply();
                            );
                            ui_menu_tick(menu_Glb_Smpl, -1, 0);
                        ) :
                        (zzmcl === 7) ? (
                            xx = its_Menu_Clic(menu_Glb_Action, zz);
                            (xx > 1) ? its_actions(xx - 1);
                        );
                    );
                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        (zzmcl === 2) ? (
                            // track samples : the next mode (shift : the previous one)
                            its_GlSmpl = (jmc & shfCap) ? (k + 2) % 3 : (k + 1) % 3; its_Gl_Apply();
                        );
                    );
                );
            ui_pop();

            // Sliders
            (h2 > 3) ? (
                ui_split_top(min(h2, ui_height()));
                    ui_pad(1,3,1,0);
                    (shIn) ? (
                        // Global input gain
                        paramValues[p_glInGain] = its_GlInGain;
                        r = parCtl(p_glInGain);
                        (r != 0) ? (
                            its_GlInGain = (r === 8) ? 0 : parV(p_glInGain); // right clic : 0 dB
                            its_Gl_Apply();
                        );
                    );
                    (shOut) ? (
                        // Global output volume
                        paramValues[p_glOutVol] = its_GlOutVol;
                        r = parCtl(p_glOutVol);
                        (r != 0) ? (
                            its_GlOutVol = (r === 8) ? 0 : parV(p_glOutVol); // right clic : 0 dB
                            its_Gl_Apply();
                        );
                    );
                ui_pop();
            );

        ui_pop();
    );
);

function show_UserModule(module)
local(w, umid, chk, i, statn, recomp, modInst, modSrc, ucod, uent, err, ut, user_top, ul, user_left, uw, user_width, uh, user_height, rptb, ptbl, prvstk, ptstk, anc, typanc, cbxrpt, cbxref, typtb, crptb, addb, rcnt, adds, flgm, reh, w3)
(
    // module is a module number
    // Lets check the existence of the object
    modInst = err = recomp = 0;
    umid = module - blockUsrFirst; // user module. number, in 0 .. 31
    statn = blockUsrNum[umid]; // inverse reference number : from umid (dyn. computed) to statn (static number)
    modSrc = blockUsrRefs[statn]; // Memory address of the module prototype
    (chk = (mSL_bl_check(modSrc, 'umod') && mSL_bl_check(modSrc[ubx_mref], 'umod'))) ? (
        ucod = 0x10000 | (PanIdt << 8) | umid; // internal code for the module in this position
        uent = -1; // entry number of the module if it exists
        i = 0;
        while ((uent === -1) && (i < dcbUXRefsSiz)) (
            (blockUsrCode[i] === ucod) ? (uent = i; modInst = blockUsrDesc[i]);
            i += 1;
        );
        (uent === -1) ? (
            i = 0;
            while ((blockUsrCode[i] != 0) && (i < dcbUXRefsSiz)) ( i+= 1; );
            (i < dcbUXRefsSiz) ? (
                uent = i;
                modInst = blockUsrDesc[i] = mSL_bl_Dup(modSrc);
                blockUsrCode[i] = ucod;
                // (FlagsTbVals[Flgs_Umods] & 1) ? (
                    sprintf(#u, "Creating umod %x at %d from %d", ucod, modInst, modSrc);
                    mSL_log(SysLogBox, #u);
                // );
            );
        );
        // Now, modInst is the instance in this position of the module prototype
        chk = mSL_bl_check(modInst, 'umod');
    );

    (chk) ? (
        thrd = modInst[ubx_thread];
        chk = ((thrd[-2] === mSL_THR_KeyStrt) && (thrd[mSL_THR_UTId] === modInst[ubx_thrdid]));
    );

    (chk) ? (
        ut = user_top = ui_top();
        ul = user_left = ui_left();
        uw = user_width = ui_width();
        uh = user_height = ui_height(); // total available height
        // Are our computations still valid ?
        (ui_Resized || (modInst[ubx_flgs] & 1) || (user_top !== modInst[ubx_t]) || (user_left !== modInst[ubx_l]) ||
            (user_width !== modInst[ubx_w])) ? (    //  || (user_height < modInst[ubx_h])
            // Recompute positions off all fields
            recomp = 1;
            modInst[ubx_flgs] &= 0x7ffffffe;
            rptb = ubx_isiz; ptbl = modInst[-1];
            modInst[ubx_t] = user_top;
            modInst[ubx_l] = user_left;
            modInst[ubx_w] = user_width;
            modInst[ubx_h] = ui_jd_ctgr;
            // Compute internal needed height
            //sprintf(#u, "Recomputing umod %x positions", ucod);
            // mSL_log(SysLogBox, #u);
            state = 1; // start in state 1
            prvstk = ptstk = 0; stack = wa256;
            // AWA! Almost Working Algorithm
            uh = 0;
            while (state != 0) (
                (state === 1) ? (
                    // Push the umod infos
                    stack[0] = -1;
                    ptstk += stk_isiz;
                    stack[ptstk+stk_btyp] = 'umod';
                    stack[ptstk+stk_cbx] = 0;
                    stack[ptstk+stk_rtsk] = 0; // return stack
                    stack[ptstk+stk_rtst] = 0; // return state
                    stack[ptstk+stk_mode] = 0; // work mode = vertical
                    stack[ptstk+stk_h] = 0;
                    stack[ptstk+stk_i] = 0;
                    stack[ptstk+stk_b] = ubx_isiz; // first box in the sequence of siblings
                    state = 2; // goto state 2
                ) :
                (state === 2) ? (
                    anc = stack[ptstk+stk_cbx]; // position ancestor
                    typanc = stack[ptstk+stk_btyp]; // type of ancestor
                    k = anc + ubx_isiz * stack[ptstk+stk_i];
                    cbxrpt = stack[ptstk + stk_b] + k; // relative pointer to current box instance
                    cbxref = modInst[cbxrpt + ubx_mref]; // reference to current box prototype
                    typtb = cbxref[ubx_ty];
                    mode = stack[ptstk+stk_mode];
                    (typtb === 'sbox') ? (
                        // Add the height of the sbox
                        modInst[cbxrpt + ubx_h] = h = cbxref[ubx_h];
                        /*
                        sprintf(#u, "   ++ sbox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]);
                        mSL_log(SysLogBox, #u);
                        */
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'ibox') ? (
                        // Add the height of the sbox
                        modInst[cbxrpt + ubx_h] = h = cbxref[ubx_h];
                        /*
                        sprintf(#u, "   ++ ibox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]);
                        mSL_log(SysLogBox, #u);
                        */
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'tbox') ? (
                        // Get the size with the text wrap function
                        // cbxref is the ref to the text box
                        txt = cbxref[ubx_isiz]; // the text string
                        // evaluate the height
                        modInst[cbxrpt + ubx_h] = (h = ui_wraptext_height(txt));
                        // sprintf(#u, "   ++ tbox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]); mSL_log(SysLogBox, #u);
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'vbox') ? (
                        // A vertical box
                        // Push this box
                        prvstk = ptstk;
                        ptstk += stk_isiz;
                        stack[ptstk+stk_btyp] = typtb;
                        stack[ptstk+stk_cbx] = k;
                        stack[ptstk+stk_rtsk] = prvstk; // return stack
                        stack[ptstk+stk_rtst] = 2; // return state
                        stack[ptstk+stk_mode] = 0; // work mode = vertical
                        stack[ptstk+stk_h] = 0; // height so far
                        stack[ptstk+stk_i] = 0; // index in descendants
                        stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first box in the sequence of siblings
                        state = 2; // goto state 2
                    ) :
                    (typtb === 'hbox') ? (
                        // An horizontal box
                        // Push this box
                        prvstk = ptstk;
                        ptstk += stk_isiz;
                        stack[ptstk+stk_btyp] = typtb;
                        stack[ptstk+stk_cbx] = k;
                        stack[ptstk+stk_rtsk] = prvstk; // return stack
                        stack[ptstk+stk_rtst] = 2; // return state
                        stack[ptstk+stk_mode] = 1; // work mode = horizontal
                        stack[ptstk+stk_h] = 0; // height so far
                        stack[ptstk+stk_i] = 0; // index in descendants
                        stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first box in the sequence of siblings
                        state = 2; // goto state 2
                    ) :
                    (
                        err = 0871;
                        state = 0;
                    );
                    //== Skip to next sibling
                    i = (stack[ptstk+stk_i] += 1); // number of next sibling
                    (i >= modInst[anc + ubx_lcnt]) ? (
                        // return to previous state
                        state = stack[ptstk+stk_rtst]; // return state
                        ptstk = stack[ptstk+stk_rtsk]; // return stack
                    );
                ) :
                (
                    err = 0870;
                    state = 0;
                );
            );
            modInst[ubx_h] = stack[stk_isiz+stk_h] + ui_jd_ctgr; // computed height
        );

        uix_jneed = uix_jmini = modInst[ubx_h];
        (chk && (ui_height() >= uix_jmini)) ? (
            ui_split_top(uix_jneed);
                ui_set_rect(ui_left(), ui_top(), max(ui_MinSize1Pane, min(ui_BestSize1Pane, ui_width())), ui_height());
                zzmi = ui_hover();  // true if we are "in"
                // Keep block position
                keepBlockInfos(module);
                (zzmi) ? (
                    ui_push();
                        // stack is now 2 levels deep
                        ui_color(Col_Frame);
                        ui_border(); // draws in orange
                    ui_pop();
                );
                control_group(blockDispNames[blockDispInverts[module]]);

                ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
                // Inside of the module dimensions
                ut = ui_top();
                ul = ui_left();
                uw = ui_width();
                uh = ui_height();

                // Should we recomp item sizes ?
                (recomp) ? (
                    state = 1; prvstk = ptstk = 0; stack = wa256;
                    rptb = ubx_isiz; ptbl = modInst[-1];
                    while (state != 0) (
                        (state === 1) ? (
                            // Push the umod infos
                            stack[0] = -1;
                            ptstk += stk_isiz;
                            stack[ptstk+stk_btyp] = 'umod';
                            stack[ptstk+stk_cbx] = 0; // position of the box in the umod
                            stack[ptstk+stk_rtsk] = 0; // return stack
                            stack[ptstk+stk_rtst] = 0; // return state
                            stack[ptstk+stk_h] = uh;
                            stack[ptstk+stk_w] = uw;
                            stack[ptstk+stk_l] = ul;
                            stack[ptstk+stk_t] = ut;
                            stack[ptstk+stk_i] = 0;
                            stack[ptstk+stk_b] = ubx_isiz; // first box in the sequence of siblings
                            state = 2; // goto state 2
                        ) :
                        (state === 2) ? (
                            anc = stack[ptstk+stk_cbx]; // position ancestor
                            typanc = stack[ptstk+stk_btyp]; // type of ancestor
                            k = anc + ubx_isiz * stack[ptstk+stk_i];
                            cbxrpt = stack[ptstk + stk_b] + k; // relative pointer to current box instance
                            cbxref = modInst[cbxrpt + ubx_mref]; // reference to current box prototype
                            typtb = cbxref[ubx_ty];
                            (typtb === 'sbox') ? (
                                // Set the size of the rectangle for the 'sbox'
                                h = cbxref[ubx_h]; // height - already computed
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ sbox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'ibox') ? (
                                h = cbxref[ubx_h]; // height - already computed
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                w = min(stack[ptstk+stk_w], cbxref[ubx_maxw]);
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ ibox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'tbox') ? (
                                // recheck the size of the text
                                txt = cbxref[ubx_isiz]; // the text string
                                // re-evaluate the height
                                modInst[cbxrpt + ubx_h] = (h = ui_wraptext_height(txt));
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ tbox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'vbox') ? (
                                // A vertical box
                                prvstk = ptstk;
                                // Push this box
                                prvstk = ptstk;
                                ptstk += stk_isiz;
                                stack[ptstk+stk_btyp] = typtb;
                                stack[ptstk+stk_cbx] = k;
                                stack[ptstk+stk_rtsk] = prvstk; // return stack
                                stack[ptstk+stk_rtst] = 2; // return state
                                stack[ptstk+stk_l] = stack[ptstk+stk_l]; // left from ancestor
                                stack[ptstk+stk_t] = stack[ptstk+stk_t]; // top from ancestor
                                stack[ptstk+stk_w] = stack[ptstk+stk_w]; // width from ancestor
                                stack[ptstk+stk_h] = h = cbxref[ubx_h]; // height - already computed;
                                stack[ptstk+stk_i] = 0; // index in descendants
                                stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first sibling
                                state = 2; // goto state 2
                            ) :
                            (
                                err = 0881;
                                state = 0;
                            );
                            //== Skip to next sibling
                            i = (stack[ptstk+stk_i] += 1); // number of next sibling
                            (i >= modInst[anc + ubx_lcnt]) ? (
                                // return to previous state
                                state = stack[ptstk+stk_rtst]; // return state
                                ptstk = stack[ptstk+stk_rtsk]; // return stack
                            );
                        ) :
                        (
                            err = 0880;
                            state = 0;
                        );
                    );


                    (FlagsTbVals[Flgs_Umods] & 2) ? (
                sprintf(#u, "User Block %x : %d / %d / %d / %d / %d => %d [t:%d  l:%d  w:%d  h:%d]  =>  [%d  %d  %d  %d]",
                ucod, module, umid, statn, blockUsrChecks[statn], blockUsrRefs[statn], modInst, user_top, user_left, user_width,
                user_height, ut, ul, uw, uh); mSL_log(SysLogBox, #u);
                    );

                );
                // ui_text(#u);


                // (Finally !) Let's put out items...
                rptb = ubx_isiz; ptbl = modInst[-1];
                while (rptb < ptbl) (
                    crptb = rptb;
                    (modInst[rptb + ubx_flgs] & ubx_final) ? (
                        ty = modInst[rptb + ubx_ty];
                        (ty === 'sbox') ? (
                            // position the rectangle for all sliders
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            //ui_pad(0,2,1,0);
                            ui_pcolor(ui_jcolor_text);
                            // Put the various sliders
                            addb = modInst[rptb + ubx_mref] + modInst[rptb + ubx_lcnt];
                            rcnt = addb[ubx_icnt]; // number of references
                            (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                sprintf(#u, "Slider box: %d -- %d refs.", addb, rcnt); mSL_log(SysLogBox, #u);
                            );
                            i = 0;
                            while (rcnt > 0) (
                                adds = addb[ubx_isiz+i]; // final "slider" address
                                pnum = adds[1]; // its parameter number
                                (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                    sprintf(#u, "Slider %d in [%d %d %d %d]  %d / %d / %d", pnum,
                                        ui_top(), ui_left(), ui_width(), ui_height(), i, rcnt, adds);
                                        mSL_log(SysLogBox, #u);
                                );
                                flgm = parCtl(pnum);
                                i += 1; rcnt -= 1;
                            );
                        ) :
                        (ty === 'ibox') ? (
                            // position the rectangle for the info block
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            blk = modInst[crptb + ubx_mref]; // ref to the info box
                            cnt = blk[ubx_isiz]; // parameter count
                            thrd = modInst[ubx_thread];
                            (recomp) ? (
                                sprintf(#u, "Info box: %d thrd: %d -- %d pars.", blk, thrd, cnt);
                                mSL_log(SysLogBox, #u);
                            );
                            wa = wa128; memset(wa, 0, 32);
                            i = 0; loop(cnt,
                                k = blk[ubx_isiz+i+1]; // next parameter
                                ((k >= mSL_Sym_Low) && (k <= mSL_Sym_High)) ? (k = mSL_idt_addr(thrd, k));
                                wa[i+16] = k; // keep address
                                (!mSL_isString(k)) ? ((k >= 0) ? (k = k[0]) : (k = gmem[-k]));
                                wa[i] = k; i += 1;
                            );
                            (recomp) ? (
                                sprintf(#u, "Info [%d/%d  %d/%d  %d/%d  %d/%d  %d/%d  %d/%d]",
                                            wa[16+0], wa[0], wa[16+1], wa[1], wa[16+2], wa[2],
                                            wa[16+3], wa[3], wa[16+4], wa[4], wa[16+5], wa[5]);
                                mSL_log(SysLogBox, #u);
                            );
                            (cnt === 0) ? (
                                ui_show();
                            ) :
                            (cnt === 1) ? (
                                ui_show(wa[0]);
                            ) :
                            (cnt === 2) ? (
                                ui_show(wa[0], wa[1]);
                            ) :
                            (cnt === 3) ? (
                                ui_show(wa[0], wa[1], wa[2]);
                            ) :
                            (cnt === 4) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3]);
                            ) :
                            (cnt === 5) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3], wa[4]);
                            ) :
                            (cnt === 6) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3], wa[4], wa[5]);
                            ) : (
                                ui_show("Error 8793");
                            );
                        ) :
                        (ty === 'tbox') ? (
                            // position the rectangle for the text
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            blk = modInst[crptb + ubx_mref]; // ref to the text box
                            txt = blk[ubx_isiz]; // the text string
                            ui_align(0.5, 0.5);
                            reh = w3 = ui_wraptext(txt);
                            (reh != modInst[crptb + ubx_h]) ? (
                                modInst[rptb + ubx_h] = reh;
                                // we have to adjust the height
                                modInst[ubx_flgs] |= 1;
                            );
                            (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                sprintf(#u, "Text box %d in [%d %d %d %d]   %d / %d / %d", txt,
                                ui_top(), ui_left(), ui_width(), ui_height(), w1, w2, w3);
                                mSL_log(SysLogBox, #u);
                            );
                        );
                    );
                    rptb += ubx_isiz;
                );

            ui_pop();
        );
    );

    (!chk) ? (
        h1 = uix_jpadHeight(1); // A 1 line to display info
        uix_jneed = uix_jmini = h1+ui_jd_ctgr;
        (ui_height() >= uix_jmini) ? (
            ui_split_top(uix_jneed);
                ui_set_rect(ui_left(), ui_top(), max(ui_MinSize1Pane, min(ui_BestSize1Pane, ui_width())), ui_height());
                zzmi = ui_hover();  // true if we are "in
                // Keep block position
                keepBlockInfos(module);
                (zzmi) ? (
                    ui_push();
                        // stack is now 2 levels deep
                        ui_color(Col_Frame);
                        ui_border(); // draws in purple
                    ui_pop();
                );
                control_group(blockDispNames[blockDispInverts[module]]);
                statn = blockUsrNum[umid];
                ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
                sprintf(#u, "Error: User Block %d / %d / %d / %d / %d [t:%d  l:%d  w:%d  h:%d]", module, umid, statn,
                    blockUsrChecks[statn], blockUsrRefs[statn], user_top, user_left, user_width, user_height);
                ui_text(#u);
            ui_pop();
        );
    );

    (!chk) ? (
        // module doesn't exist anymore
        blockDesc[Bigx] = 0; // remove reference
        blockUsrRefs[statn] = 0;
        blockUsrNames[statn] = 0;
        blockUsrChecks[statn] = 0;
        blockUsrIds[statn] = 0;
        blockUsrNum[umid] = 0;
    );
);



function genericItemsPos(bNumb)
local(x, xx, xy, igb, u, v, w, m, myp, i, j, k, p, s, wst, kit, blockRent, pn_in)
(
    blockMouseWasIn = 0;
    PanIdt = bNumb;
    // wst = #;
    ((bNumb >=0) && (bNumb < dcbMCount) && menu_Stud_Mod) ? (
        blockDesc = dcbBlocksAll + bNumb * dcbWSize;
        pn_in = ui_hover(); // (the rect of the pane : the modules below split it)
        (pn_in) ? (
            colMouseWasIn = studDispCol;
            // Update col. size
            blockMouseWasIn = blockDesc[dcbWSize - 1];
            // we may need to update the menu
            p = menu_Stud_Mod + ui_jmenu_items;
            i=0; while (i < blockMenuITC) (
                s = p[i]; // u = str_getchar(s, 2, 'cu');
                //((u === ui_jmenu_chSP) || (u === ui_jmenu_noSel))? (
                    str_setchar(s, 1, ui_jmenu_chSP);
                //);
                i += 1;
            );
            i=0; loop(dcbMSize,
                (k = blockDesc[i]) ? (
                    ((k > 0) && (k < blockDispITC)) ? (
                        j = blockDispInverts[k];
                        s = p[j]; str_setchar(s, 1, '!');
                    ) : (
                        blockDesc[i] = 0;
                    );
                );
                i += 1;
            );
            //is there a "current" block ?
            // update "clicked in"
            blockDesc[dcbWSize - 1] = 0;
            A99m = mouse_y;
            i = 0; while ((k = blockDesc[i]) != 0) (
                u = blockDesc[i+dcbMSize]; v = u/10000; u = u %10000; // the block
                ((A99m >= v) && (A99m < (u+v))) ? (
                    // clicked in the box
                    blockDesc[dcbWSize - 1] = k;
                );
                i += 1;
            );
            cModule = A99CBlock = k = blockDesc[dcbWSize - 1];
            strncpy(#Aws3, p[0], 6);
            (k != 0) ? (
                strcat(#Aws3, blockDispNames[blockDispInverts[k]]);
                str_setchar(#Aws3, 1, '!');
            ) : (
                strcat(#Aws3, "-");
            );
            strcpy(p[0], #Aws3);
            // Indicates the pane preferences
            s = p[block1Pane -1 + studDispPrf];
            str_setchar(s, 1, '!');
            (serialBlock[Pr7_StudLive + TabIdt]) ? str_setchar(p[blockTabLive], 1, '!');
            ui_jstyle ? str_setchar(p[blockStyleSoft], 1, '!');
            str_setchar(p[blockThemeDefault + uix_jtheme], 1, '!'); // current theme
            ui_jzoom_menu_tick(p); // current display size
            0 ? (
                sprintf(#dbg_trace1, "*ZZZ* [%d]  \"%s\"  (%d)  \"%s\" ", A99CBlock, blockDispNames[blockDispInverts[A99CBlock]], p[0],#Aws3);
            );


            // ADump(blockDesc);

            // Shift + right click : the menu ; a plain right click too where no module is under the mouse
            // (an unused zone of the pane : see keepBlockInfos)
            xx = control_jmenu_clicks(menu_Stud_Mod, (cModule === 0) ? ui_jmenu_opt_sorclick : ui_jmenu_opt_shrclick);
            xx ? (
                ui_GFXdoNow |= 1;
                blockRent = xx; // entry selected (trace only)
                kit = jmenu_res2item(menu_Stud_Mod, xx);
                0 ? (
                    sprintf(#dbg_trace0, "[%d/%d] XX  %d \"%s\" %d", TabIdt, bNumb, xx, ui_menu_item(menu_Stud_Mod, xx), kit);
                    mSL_log(SysLogBox, #dbg_trace0);
                );
                // ADump(blockDesc);
                //xx2 = ui_menu_ent(menu_Stud_Mod, xx);
                //p = menu_Stud_Mod + ui_jmenu_items + xx -1; wst = p[0]; k = blockDispIdts[xx-1];
                //    #dbg_desc = #sfc;
                (kit === 0) ? (
                    (cModule > 0) ? (
                        copiedMod = cModule;
                        i = j = 0;
                        while (i < dcbMax) (
                            (cModule === blockDesc[j]) ? (  j+= 1; );
                            blockDesc[i] = blockDesc[j];
                            i += 1 ; j += 1;
                        );
                    );
                ) :
                ((kit >= blockFirst) && (kit < blockDispITC) && (blockDispIdts[kit] > 0)) ? (
                    // we choose a module entry
                    p = menu_Stud_Mod + ui_jmenu_items + kit ; // correct here
                    wst = p[0]; k = blockDispIdts[kit]; // k is ok

                    (x = (str_getchar(wst, 1, 'cu') === '!')) ? (
                        // We must add the new module at the end of the list
                        i = 0; while (blockDesc[i] != 0) ( i+= 1;);
                        blockDesc[i] = e = k; d = i;
                    ) : (
                        // the module was selected. We suppress it from the list
                        i = j = 0;
                        while (j < dcbMax) (
                            (k === blockDesc[j]) ? ( d = j; e = k; j+= 1; );
                            blockDesc[i] = blockDesc[j];
                            i += 1 ; j += 1;
                        );
                    );
                    0 ? (
                        x ? (
                            sprintf(#dbg_trace1, "*ADD* [%d] %d \"%s\" p:%d  n:%d  xx:%d  B:%d", blockDesc, k, wst, d, e, xx, blockMouseWasIn);
                        ) : (
                            sprintf(#dbg_trace1, "*DEL* [%d] %d \"%s\" p:%d  x:%d  xx:%d  B:%d", blockDesc, k, wst, d, e, xx, blockMouseWasIn);
                        );
                        mSL_log(SysLogBox, #dbg_trace1);
                    );
                    // ADump(blockDesc);
                ) :
                (kit === blockTabLive) ? (
                    // switch this tab to the "live" display
                    serialBlock[Pr7_StudLive + TabIdt] = 1;
                ) :
                (kit === blockTabRename) ? (
                    sprintf(#tmp, "New name for tabulation %d...", TabIdt);
                    ui_screen_open("control.prompt");
                    ui_screen_arg(0, altTabsNames[TabIdt]);
                    ui_screen_arg(1, #tmp);
                ) :
                ui_jzoom_menu_click(kit) ? (
                    0; // a display size (see ui-lib-JJ-GUI)
                ) :
                (kit === blockStyleSoft) ? (
                    serialBlock[Pr7_UiStyle] = ui_jstyle = !ui_jstyle;
                ) :
                (kit >= blockThemeDefault) ? (
                    uix_jtheme = kit - blockThemeDefault;
                ) :
                (
                    mSL_GUI_Generic(3, bNumb, cModule, kit);
                );


            );
        );


        // move bottom system log if present
        1 ? (
            i = 0; while (i < dcbMax) (
                u = blockDesc[i]; v = blockDesc[i+1];
                ((u === blockSysLog) && (v !== 0))  ? (
                    blockDesc[i] = v; blockDesc[i+1] = u;
                );
                i += 1;
            );
        );


        // Hors interaction : mise en place des blocs
        Bigx = 0; loop(dcbMSize, igb = blockDesc[Bigx];  // = DISPLAY BLOCKS =
            (igb > 0) ? (
                (igb === blockReaderA) ? (
                    show_Reader_Pad(ReadersStructA, blockReaderA);
                ) :
                (igb === blockReaderB) ? (
                    show_Reader_Pad(ReadersStructB, blockReaderB);
                ) :
                (igb === blockReaderC) ? (
                    show_Reader_Pad(ReadersStructC, blockReaderC);
                ) :
                (igb === blockReaderD) ? (
                    show_Reader_Pad(ReadersStructD, blockReaderD);
                ) :
                (igb === blockReaderE) ? (
                    show_Reader_Pad(ReadersStructE, blockReaderE);
                ) :
                (igb === blockReaderF) ? (
                    show_Reader_Pad(ReadersStructF, blockReaderF);
                ) :
                (igb === blockReaderG) ? (
                    show_Reader_Pad(ReadersStructG, blockReaderG);
                ) :
                (igb === blockReaderH) ? (
                    show_Reader_Pad(ReadersStructH, blockReaderH);
                ) :
                (igb === blockLineA) ? (
                    show_Line_Pad(LinesStructA, blockLineA);
                ) :
                (igb === blockLineB) ? (
                    show_Line_Pad(LinesStructB, blockLineB);
                ) :
                (igb === blockLineC) ? (
                    show_Line_Pad(LinesStructC, blockLineC);
                ) :
                (igb === blockLineD) ? (
                    show_Line_Pad(LinesStructD, blockLineD);
                ) :
                (igb === blockLineE) ? (
                    show_Line_Pad(LinesStructE, blockLineE);
                ) :
                (igb === blockLineF) ? (
                    show_Line_Pad(LinesStructF, blockLineF);
                ) :
                (igb === blockLineG) ? (
                    show_Line_Pad(LinesStructG, blockLineG);
                ) :
                (igb === blockLineH) ? (
                    show_Line_Pad(LinesStructH, blockLineH);
                ) :
                ((igb >= blockEffectA) && (igb <= blockEffectP)) ? (
                    // the views Effect A ... P (consecutive numbers, their states EffectsStructA + k * LinesBlockSize)
                    show_Effect_Pad(EffectsStructA + (igb - blockEffectA) * LinesBlockSize, igb);
                ) :
                (igb === blockWriterA) ? (
                    show_Writer_Pad(WriterStructA, blockWriterA);
                ) :
                (igb === blockWriterB) ? (
                    show_Writer_Pad(WriterStructB, blockWriterB);
                ) :
                (igb === blockWriterC) ? (
                    show_Writer_Pad(WriterStructC, blockWriterC);
                ) :
                (igb === blockWriterD) ? (
                    show_Writer_Pad(WriterStructD, blockWriterD);
                ) :
                (igb === blockWriterE) ? (
                    show_Writer_Pad(WriterStructE, blockWriterE);
                ) :
                (igb === blockWriterF) ? (
                    show_Writer_Pad(WriterStructF, blockWriterF);
                ) :
                (igb === blockWriterG) ? (
                    show_Writer_Pad(WriterStructG, blockWriterG);
                ) :
                (igb === blockWriterH) ? (
                    show_Writer_Pad(WriterStructH, blockWriterH);
                ) :
                (igb === blockMemory1) ? (
                    show_Memory(memoryBox1);
                ) :
                (igb === blockMemory2) ? (
                    show_Memory(memoryBox2);
                ) :
                (igb === blockSysLog) ? (
                    show_SysLog(blockSysLog, SysLogBox);
                ) :
                (igb === blockScheduler) ? (
                    show_Scheduler_Pad(blockDispNames[blockDispInverts[blockScheduler]], blockScheduler);
                ) :
                (igb === blockProcessesMgr) ? (
                    show_ProcessesMgr(blockDispNames[blockDispInverts[blockProcessesMgr]], blockProcessesMgr);
                ) :
                (igb === blockGlobal) ? (
                    show_Global_Pad(blockGlobal);
                ) :
                (igb === blockControls) ? (
                    show_Controls_Pad(blockControls);
                ) :
                (igb === blockPatch) ? (
                    show_Patch_Pad(blockPatch);
                ) :
                (igb === blockInstances) ? (
                    show_Instances_Pad(blockInstances);
                ) :
                (igb === blockScripts) ? (
                    show_Scripts_Pad(blockScripts);
                ) :
                (igb === blockPGraph) ? (
                    show_PGraph_Pad(blockPGraph);
                ) :
                ((igb >= blockCurvesA) && (igb <= blockCurvesH)) ? (
                    show_Curves_Pad(igb, igb - blockCurvesA);
                ) :
                ((igb >= blockReaders) && (igb <= blockEffects)) ? (
                    show_Summary_Pad((igb === blockReaders) ? 'R' : (igb === blockWriters) ? 'W' : 'E', igb);
                ) :
                (igb === blockLines) ? (
                    show_Summary_Pad('L', igb);
                ) :
                (igb === blockCurves) ? (
                    show_Summary_Pad('C', igb);
                ) :
                (igb === blockAllMods) ? (
                    show_Summary_Pad('M', igb);
                ) :
                ((igb >= blockUsrFirst) && (igb <= blockUsrLast)) && (blockUsrChecks[blockUsrNum[igb - blockUsrFirst]]) ? (
                    show_UserModule(igb);
                );
            );
            Bigx += 1;
        );

        // the pane : Shift + arrows change the width of the columns (after its modules, that may use these keys)
        (pn_in && (GM_key_mods() === 8) && GM_key_take('rght')) ? (
            // try to increase colum size
            p = serialBlock + Pr7_StudRat + 4 * TabIdt;
            ((colMouseWasIn === 0) && (studDispPCnt >= 2)) ? (
                // increase first col. size
                k = min(20, max(0, p[1] - ui_MinSize1Pane));p[0] += k; p[1] -= k;
            ) :
            ((colMouseWasIn === 1) && (studDispPCnt === 2)) ? (
                // increase 2nd col. size
                k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[1] += k; p[0] -= k;
            ) :
            ((colMouseWasIn === 1) && (studDispPCnt >= 3)) ? (
                // increase 2nd col. size
                k = min(20, max(0, p[2] - ui_MinSize1Pane)); p[1] += k; p[2] -= k;
            ) :
            ((colMouseWasIn === 2) && (studDispPCnt === 3)) ? (
                // increase 3nd col. size
                k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[2] += k; p[0] -= k;
            ) :
            ((colMouseWasIn === 2) && (studDispPCnt === 4)) ? (
                // increase 3nd col. size
                k = min(20, max(0, p[3] - ui_MinSize1Pane)); p[2] += k; p[3] -= k;
            ) :
            ((colMouseWasIn === 3) && (studDispPCnt === 4)) ? (
                // increase 4nd col. size
                k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[3] += k; p[0] -= k;
            ) ;
        ) :
        (pn_in && (GM_key_mods() === 8) && GM_key_take('left')) ? (
            // try to increase colum size
            p = serialBlock + Pr7_StudRat + 4 * TabIdt;
            ((colMouseWasIn === 0) && (studDispPCnt === 4)) ? (
                // increase first col. size
                k = min(20, max(0, p[3] - ui_MinSize1Pane));p[0] += k; p[3] -= k;
            ) :
            ((colMouseWasIn === 0) && (studDispPCnt === 3)) ? (
                // increase first col. size
                k = min(20, max(0, p[2] - ui_MinSize1Pane));p[0] += k; p[2] -= k;
            ) :
            ((colMouseWasIn === 0) && (studDispPCnt === 2)) ? (
                // increase first col. size
                k = min(20, max(0, p[1] - ui_MinSize1Pane));p[0] += k; p[1] -= k;
            ) :
            ((colMouseWasIn === 1) && (studDispPCnt >= 2)) ? (
                // increase first col. size
                k = min(20, max(0, p[0] - ui_MinSize1Pane));p[1] += k; p[0] -= k;
            ) :
            ((colMouseWasIn === 2) && (studDispPCnt >= 3)) ? (
                // increase 2nd col. size
                k = min(20, max(0, p[1] - ui_MinSize1Pane)); p[2] += k; p[1] -= k;
            ) :
            ((colMouseWasIn === 3) && (studDispPCnt === 4)) ? (
                // increase 2nd col. size
                k = min(20, max(0, p[2] - ui_MinSize1Pane)); p[3] += k; p[2] -= k;
            ) ;
        );


    );
    blockDesc = 0;
    studDispCol += 1;
);


// Studio menu while a tab uses the "live" display (shift right click anywhere in the tab)
function genericLiveMenu(bNumb)
local (p, i, xx, kit)
(
    PanIdt = bNumb;
    blockDesc = dcbBlocksAll + bNumb * dcbWSize;
    p = menu_Stud_Mod + ui_jmenu_items;
    i = 0; while (i < blockMenuITC) ( str_setchar(p[i], 1, ui_jmenu_chSP); i += 1; );
    str_setchar(p[block1Pane -1 + studDispPrf], 1, '!');
    str_setchar(p[blockTabLive], 1, '!');
    ui_jstyle ? str_setchar(p[blockStyleSoft], 1, '!');
    str_setchar(p[blockThemeDefault + uix_jtheme], 1, '!'); // current theme
    ui_jzoom_menu_tick(p); // current display size
    xx = control_jmenu(menu_Stud_Mod);
    xx ? (
        ui_GFXdoNow |= 1;
        kit = jmenu_res2item(menu_Stud_Mod, xx);
        (kit === blockTabLive) ? (
            // back to the panes display
            serialBlock[Pr7_StudLive + TabIdt] = 0;
        ) :
        (kit === blockTabRename) ? (
            sprintf(#tmp, "New name for tabulation %d...", TabIdt);
            ui_screen_open("control.prompt");
            ui_screen_arg(0, altTabsNames[TabIdt]);
            ui_screen_arg(1, #tmp);
        ) :
        ui_jzoom_menu_click(kit) ? (
            0; // a display size (see ui-lib-JJ-GUI)
        ) :
        (kit === blockStyleSoft) ? (
            serialBlock[Pr7_UiStyle] = ui_jstyle = !ui_jstyle;
        ) :
        (kit >= blockThemeDefault) ? (
            uix_jtheme = kit - blockThemeDefault;
        ) :
        ((kit >= blockFirst) && (kit < blockDispITC)) ? (
            0; // modules are not shown in the "live" display
        ) :
        (kit > 0) ? (
            mSL_GUI_Generic(3, bNumb, 0, kit); // panes, tabs...
        );
    );
);

// "Live" display of a tab : animated background and display boxes (see mSL_Live_Screen)
function genericLiveTab()
(
    live_tab_active = 1;
    live_screen_tick();
    live_screen();
    uix_gfx_clear = gfx_clear; // keep the live background (used by update_theme / control_start)
    genericLiveMenu(TabIdt * dcbPannelsMax);
);


function genericTabSet(tbNum)
local (p, ww, t, BankLink)
(
    do_GenericTabStart();
    //colMouseWasIn = -1;
    BankLink = 1;
    TabIdt = max(0, min(7, 0|tbNum));
    studDispPrf = studDispPCnt = max(1, min(4, 0|(serialBlock[Pr7_StudConf+TabIdt])));

    (serialBlock[Pr7_StudLive + TabIdt]) ? (
        genericLiveTab();
    ) : (
    ww = gfx_w / ui_retina();


    (studDispPCnt === 4) ? (
        (ww < ui_MinSize4Panes) ? studDispPCnt = 3;
    );
    (studDispPCnt === 3) ? (
        (ww < ui_MinSize3Panes) ? studDispPCnt = 2;
    );
    (studDispPCnt === 2) ? (
        (ww < ui_MinSize2Panes) ? studDispPCnt = 1;
    );
    /*
    (studDispPCnt === 1) ? (
        (ww > ui_MaxSize1Pane) ? studDispPCnt = 2;
    );
    */

    studDispCol = 0;
    p = serialBlock + Pr7_StudRat + 4 * TabIdt;
    (studDispPCnt === 4)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1] + p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
        ui_split_leftratio(max(1, p[1])/max(1, p[1] + p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
        ui_pop();
        ui_split_leftratio(max(1, p[2])/max(1, p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax + 2);
        ui_pop();
            genericItemsPos(TabIdt * dcbPannelsMax + 3);
    ) :
    (studDispPCnt === 3)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1] + p[2]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
        ui_split_leftratio(max(1, p[1])/max(1, p[1] + p[2]));
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
        ui_pop();
        //ui_split_leftratio(1);
            genericItemsPos(TabIdt * dcbPannelsMax + 2);
        //ui_pop();
    ) :
    (studDispPCnt === 2)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
    ) : (
        genericItemsPos(TabIdt * dcbPannelsMax);
    );
    ); // live / panes
    do_GenericTabEnd();
);



//====== GRAPHIC EXECUTION START ======

(gui_show_UI) ? (
    must_do_gfx() ? (

        gfx_executed += 1; // just a trace
        // do here the graphic stuff...

        do_gfx_init ? (
            do_gfx_init = 0; // perform only once
            uix_default_fontsize = ui_jdefault_fontsize;
            // uix_default_fontface = "Verdana";
            // uix_default_fontface = "Times";
            // uix_default_fontface = "Futura";
            uix_default_fontface = ui_jdefault_fontface;
        );

        (live_tab_active == 0) ? uix_gfx_clear = -1; // live background only for "live" tabs
        live_tab_active = 0;
        serialBlock[Pr7_UiTheme] = uix_jtheme; // saved with the preset ('stud' block)
        serialBlock[Pr7_UiSize] = ui_jzoom_pc(ui_jzoomK);
        update_theme();
        GM_key_frame(); // the key of the frame (see mSL_ui_LibJJ, Keyboard)
        GM_Size_Keys(); // Cmd + '-', '+', '0' : the display size, before the modules (see ui-lib-JJ-GUI)

        currScreen = ui_screen();
        ui_Xtime_period = 1; // refresh screen every second


        ui_font();

        my_menu_bar(uix_jG_menuscr);



        //SCREENS

        ui_screen() === uix_jG_menuscr[0] ? (
            /*
            show_local_Infos();

            gui_show_syslog ? show_SysLog(0, SysLogBox);
            gui_show_memory ? (
                (gfx_w/ui_jscale() > gfx_colM_width) ? (
                    ui_split_leftratio(0.5);
                    show_Memory(memoryBox1);
                    ui_pop();
                );
                show_Memory(memoryBox2);
            );
            */
            genericTabSet(0);
        ) :

        ui_screen() === uix_jG_menuscr[1] ? (
            /*
            SysLogBox[4] = 80;
            show_SysLog(0, SysLogBox);
            (gfx_w/ui_jscale() > gfx_colM_width) ? (
                ui_split_leftratio(0.5);
                show_Memory(memoryBox1);
                ui_pop();
            );
            show_Memory(memoryBox2);
            */
            genericTabSet(1);
        ) :

        ui_screen() === uix_jG_menuscr[2] ? (
            /*
            memoryBox1[17] = memoryBox2[17] = 96;
            (gfx_w/ui_jscale() > gfx_colM_width) ? (
                ui_split_leftratio(0.5);
                show_Memory(memoryBox1);
                ui_pop();
            );
            show_Memory(memoryBox2);
            */
            genericTabSet(2);
        ) :

        ui_screen() === uix_jG_menuscr[3] ? (
            genericTabSet(3);
        ) :

        ui_screen() === uix_jG_menuscr[4] ? (
            genericTabSet(4);
        ) :

        ui_screen() === uix_jG_menuscr[5] ? (
            genericTabSet(5);
        ) :

        ui_screen() === uix_jG_menuscr[6] ? (
            genericTabSet(6);
        ) :

        ui_screen() === uix_jG_menuscr[7] ? (
            genericTabSet(7);
        ) :

        //SCREEN--DEFAULT
        (
            ui_GFXdoNow |= 3;
            do_GenericTabStart();
            control_system();
            do_GenericTabEnd();
        );
        my_menu_bar_overlay(uix_jG_menuscr); // "soft" look : the tabs bar over the panes (see ui-lib-JJ-GUI)

    );
) : (
    // Clear screen

    // Minimalist work
    gfx_clear = 0xeeeeee; // light grey background color identical to sliders background
    gfx_x = gfx_y = 0;
    gfx_setpixel(0xee,0xee,0xee);
);

// The keys left by the modules and the tabs : the commands of Interstys, then the system commands
(!gui_show_UI) ? GM_key_frame(); // (no UI : the key is read here, for 'U')
do_Plugin_Keys();
do_System_Keys();
GM_key_end(); // the key not used is dropped

ui_end_do_gfx();

