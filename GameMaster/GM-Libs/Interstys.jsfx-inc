// Audio waveforms (mSL_ui_audio.jsfx-inc) : work tables and colors ; waveform of a line in show_Line_Pad
ui_audio_init();
its_LinWaveH = 120; // height of the waveform of a line
its_LinWaveMax = 4; // max channels shown (the loudest ones)
// The waveform of a module (Line, Reader, Writer) : its height and flags are kept in the display block of the module
its_WaveHide = 1; // flag : the waveform is not shown
its_WaveOver = 2; // flag : the channels are superposed (else one band per channel)
its_WaveHMin = 40; // heights (keys '+' and '-')
its_WaveHMax = 600;
its_WaveHStep = 20;
// height of the waveform ("hp" : the height kept, 0 for the default "dflt" ; "fp" : the flags) ; 0 if hidden
function its_Wave_H(hp, fp, dflt)
(
    (fp[0] & its_WaveHide) ? 0 : (hp[0] > 0) ? hp[0] : dflt;
);
// the flags of ui_audio_wave
function its_Wave_Flags(fp)
(
    (fp[0] & its_WaveOver) ? ui_aud_Axis : ui_aud_Sep | ui_aud_Axis;
);
// keys of the waveform, the mouse over the module : 'w' shows / hides it, '+' (or '=') and '-' change its height,
// 'v' superposes / separates the channels
function its_Wave_Keys(hp, fp, dflt)
local (h)
(
    h = (hp[0] > 0) ? hp[0] : dflt;
    GM_key_take('w') ? (
        fp[0] = fp[0] ~ its_WaveHide; // show / hide the waveform
    ) :
    (GM_key_take('+') || GM_key_take('=')) ? (
        hp[0] = min(its_WaveHMax, h + its_WaveHStep); // taller waveform
        fp[0] -= fp[0] & its_WaveHide;
    ) :
    GM_key_take('-') ? (
        hp[0] = max(its_WaveHMin, h - its_WaveHStep); // smaller waveform
        fp[0] -= fp[0] & its_WaveHide;
    ) :
    GM_key_take('v') ? (
        fp[0] = fp[0] ~ its_WaveOver; // channels superposed / separate
    );
);
// Colors of the markers and of the region in the waveforms
// (set by its_wave_colors before each waveform : darker hues with the light themes, see uix_theme_thickline)
its_WaveColWrt = 0x20FF20; // writing head : green
its_WaveColRdr = 0xFFE020; // reading head : yellow
its_WaveColAux = 0xFF8C20; // auxiliary reading head (during a cross fade) : orange
its_WaveColReg = 0x4080FF; // loop region (shaded)
its_WaveColRegLim = 0x909090; // limits of the cross fades around the region
function its_wave_colors()
(
    uix_theme_thickline() ? (
        // light background
        its_WaveColWrt = 0x008C00; // dark green
        its_WaveColRdr = 0xA87800; // ochre
        its_WaveColAux = 0xD04800; // dark orange
        its_WaveColRegLim = 0x505050;
    ) : (
        its_WaveColWrt = 0x20FF20;
        its_WaveColRdr = 0xFFE020;
        its_WaveColAux = 0xFF8C20;
        its_WaveColRegLim = 0x909090;
    );
);

