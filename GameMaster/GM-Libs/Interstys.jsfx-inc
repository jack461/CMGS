    parDcl(p_fxLmLimit+4, "Release",  "LmRel",  i_UB|i_SP, "%ims", "release: %ims",   1,   1000,    100,  1, 4);
    parDcl(p_fxLmLimit+5, "Distortion",  "LmDist",  i_UB|i_SP, "%i%%", "distortion: %i%%",   0,   100,    0,  1, 0);
    parDcl(p_fxLmLimit+6, "Zoom",  "LmZoom",  i_UB|i_SP, "%0.2f", "zoom: %0.2f",   0.1,   10,    1,  0.01, 5);
    parDcl(p_fxLmLimit+7, "Display",  "LmDisp",  i_UB|i_SP, "%i ch.", "display: %i ch.",   1,   8,    4,  1, 0);
);



/*
    Try to read a file in a line new or existing
*/
function File_Handle(fname, lnb, lcbl)
local (FFrRate, FlCC, Fhandle, Fformat, FFSize, cbfsiz, bread, ptbuf, bcnt, addbuffs, rdcnt,
        rc, i, pb, ends, its_FilErr, bflen)
(
    FFrRate = FlCC = its_FilErr = 0;
    Fhandle = file_open(fname);
    Fformat = 1;
    (Fhandle < 0) ? (
        its_FilErr = 400;
    ) :
    (
        file_riff(Fhandle, FlCC, FFrRate);
        (FlCC < 1) ? (
            its_FilErr = 401;
        ) :
        (FlCC > 128) ? (
            its_FilErr = 402;
        ) :
        ((FFrRate < 2400) || (FFrRate > 384000)) ? (
            its_FilErr = 403;
        ) :
        (
            FAdjRate = FFrRate / srate;
            FFSize = file_avail(Fhandle); // Size for all samples
            (FFSize <= 480) ? (
                its_FilErr = 408;
            ); // File too short
        );
    );

    sprintf(#s, "File-1  %d  %d=[%d  / %d]  %.5f  %d", its_FilErr, Fhandle, FlCC, FFrRate, FAdjRate, FFSize);
    mSL_log(SysLogBox, #s);

    (its_FilErr === 0) ? (
        // channels buffer sizes
        cbfsiz = FFSize / FlCC + BF_LIM * 2;
        bflen = FFSize / FlCC; // durée d'un buffer
        // Is the line already existing ?
        ((lnb < 0) || (lcbl < BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)
            || (lcbl[its_Lin_SmplCnt] < cbfsiz) || (lcbl[its_Lin_ChCnt] != FlCC)) ? (
            // We need a larger buffer
            lnb = lcbl = -1;
        );
        (lnb < 0) ? (
            // Create the appropriate buffer
            lnb = Ln_New();
            (lnb < 0) ? (
                its_FilErr = 411;
            ) : (
                lcbl = Ln_Make(lnb, srate, bflen/srate, FlCC);
                (lcbl === 0) ? (
                    its_FilErr = 412;
                );
            );
        );
    );

    (its_FilErr === 0) ? (
        // On va lire par blocs de BFFSIZ samples
        bread = 0; // what has been read
        ptbuf = BF_LIM; // start adress in buffer
        bcnt = FlCC * floor(BFFSIZ/FlCC); // How much to read in one call
        addbuffs = lcbl + its_Lin_BF1ST;
        while (bread < FFSize) (
            rdcnt = min(bcnt, FFSize - bread);
            rc = file_mem(Fhandle, savwrk, rdcnt);
            (rc != rdcnt) ? (
                its_FilErr = 416;
                bread = FFSize;
            ) : (
                // Update buffers
                i = 0; while (i < rdcnt) (
                    pb = addbuffs[i % FlCC];
                    pb[ptbuf] = savwrk[i];
                    i += 1;
                    ((i % FlCC) === 0) ? ptbuf += 1;
                );
            );
            bread += rdcnt;
        );
    );

    (its_FilErr === 0) ? (
        ends = FFSize / FlCC;
        lcbl[its_Lin_RecFreq] = FFrRate;
        lcbl[its_Lin_Used] = ends + BF_LIM;
        // Duplicate start and end samples in the buffer
        i = 0; loop (FlCC,
            pb = addbuffs[i];
            memcpy(pb, pb + ends, BF_LIM);
            memcpy(pb+ends + BF_LIM, pb + BF_LIM, BF_LIM);
            i += 1;
        );
    ) : (
        lnb = -1;
    );

    (lnb >= 0) ? strcpy(its_LnFile[lnb], fname); // the file of the line
    sprintf(#s, "File-2  %d  %d; lin=%d  %f  ptb=%d", its_FilErr, Fhandle, lnb, ends, ptbuf);
    mSL_log(SysLogBox, #s);

    file_close(Fhandle);
    Fhandle = -1;

    // Return the actual line number
    lnb;
);


/*
    Execute a read - the reader is defined and in status "reading"
*/
// the position "x" of the reader "r", brought back in its line [Start ... Last) (the desync of a channel can be far)
function its_Rd_Wrap(r, x)
local (st, n)
(
    st = r[its_Rdr_Start]; n = r[its_Rdr_SmplCnt];
    ((x < st) || (x >= st + n)) ? (x -= n * floor((x - st) / n));
    x;
);

// the displacement (samples of the line, backward) of the reader "r" by its input Offset, in the modes on a line : the
// modulation alone (no base : the action Add), not smoothed (the cross fades, the blocks, the grains do it) ; 0 if the
// input is not connected
function its_Rd_OffDisp(r)
local (p)
(
    p = r + its_Rdr_Mod1;
    (p[its_Mod_Src] === 0) ? 0 : its_Mod_Law(p, smpl_tab[p[its_Mod_Cell]], 0, its_ModA_Add, srate * r[its_Rdr_AdjInc] / 1000);
);

// the position "x" of the reader "r" (mode reader) after a jump of its input Offset : in its loop when it is in it (types
// loop and exit, catch caught : [RegSOut, RegEIn), as the loop repeats), else in its line (following a writer, "lf" :
// in the frame of the writer, as it is)
function its_Rd_PosIn(r, x, lf)
local (ty, a, n)
(
    ty = r[its_Rdr_LoopType]; a = r[its_Rdr_RegSOut]; n = r[its_Rdr_RegEIn] - a;
    (((ty === its_RdrLoopTypeLoop) || (ty === its_RdrLoopTypeExit) || ((ty === its_RdrLoopTypeCatch) && r[its_Rdr_Caught]))
        && (n > 0)) ? (x - n * floor((x - a) / n)) :
    lf ? x : its_Rd_Wrap(r, x);
);

/*
    Mode Stretch (SOLA : Synchronized Overlap-Add) : the stretch of the reader (its_Rdr_Stretch) is the tempo, the speed
    is the read rate of the blocks (the pitch, and their direction), times the transposition. The output is a sequence of
    blocks of N samples (its_Rdr_StBlkMs), each one read in the line at the rate rho = speed * transposition (backward if
    the speed is negative) ; the block k+1 starts Hs = N - L samples after the block k : during their overlap (L samples,
    its_Rdr_StOvlPc of the block), the tail of the block k fades out and the head of the block k+1 fades in (cos², sin² :
    a sum of 1, the blocks being aligned). The nominal starts of the blocks move at the stretch : Ha = stretch * Hs (the
    samples of the line ; the signs are independent : stretch = speed gives the reading of the mode Reader, -1 and -1 the
    sound reversed) ; the start of a block is its nominal start plus the lag (+- its_Rdr_StSrchMs) that best matches its
    head with the tail of the previous block : the normalized cross correlation, computed by slices during the previous
    block (its_St_Work : a coarse search, then a fine one), on the sum of the first channels read (at most 8) ; the same
    lag for all the channels (their image). The settings, the stretch and the speed (with its modulation) are taken at the
    start of each block (its_St_Next) ; the loop types act on the nominal starts (the overlap of the blocks makes the
    jump), "once" and "exit" end with a fade out. Mode Brage : the same blocks (the segments), read at the speed times the
    transposition, their nominal starts drawn at random in the loop (its_Br_Pick).
*/

// the value of the buffer "bfr" of the reader at the position "x" (brought back in the line ; interpolated if fractional)
function its_St_Get(reader, bfr, x)
(
    x = its_Rd_Wrap(reader, x);
    (x === floor(x)) ? bfr[x] : inter_cube(bfr, x);
);

// the sum of the "nc" channels of the line "lcbl" from the index "d" (its_Lin_BF1ST + first), at the nearest integer
// position of "x" (brought back in the line) : the signal of the correlation
function its_St_Mono(reader, lcbl, x, d, nc)
local (s, v, b)
(
    x = its_Rd_Wrap(reader, floor(x + 0.5));
    v = s = 0;
    loop(nc, ((b = lcbl[d + s]) !== 0) ? (v += b[x]); s += 1;);
    v;
);

// a nominal start drawn at random in the loop [ra, rb) for a segment of extent "ext" read at the rate "rho" (mode
// Brage) : the segment is in the loop (backward : it ends at its start) ; a loop shorter than a segment : its middle
function its_Br_Pick(ra, rb, ext, rho)
local (sp)
(
    sp = rb - ra - ext;
    (sp > 0) ? ((rho >= 0) ? ra + rand(sp) : rb - rand(sp)) : (ra + rb + ((rho >= 0) ? -ext : ext)) / 2;
);

// the next block (@sample) : at the end of the hop of the current block, or at the start (its_Rdr_StHs = 0) ; "v" is the
// speed (modulated) : the read rate of the blocks (Stretch) or of the segments (Brage), times the transposition ; the
// progression of the mode Stretch is its stretch ; prepares the correlation for the block after it
function its_St_Next(reader, v)
local (N, L, Hs, r, rho, a, lag, cur, nom, nn, ty, st, ln, en, ra, rb, ext, stop, w, K, Lc, Xn, x0, wk, sz, br, cs,
        t, e1, e2, lf, tr, dsp)
(
    a = reader[its_Rdr_AdjInc]; // the samples of the line for a sample of the output, at speed 1
    br = (reader[its_Rdr_Mode] === its_RdrMode_Brage);
    dsp = its_Rd_OffDisp(reader); // the input Offset : Brage, the segments move back ; Stretch, the progression jumps
    // the previous block : its tail
    reader[its_Rdr_StTail] = (reader[its_Rdr_StCur] === LOW_VALUE) ? LOW_VALUE :
        reader[its_Rdr_StCur] + reader[its_Rdr_StHs] * reader[its_Rdr_StRho];
    reader[its_Rdr_StPRho] = reader[its_Rdr_StRho];
    // this block : its settings
    N = max(32, floor(max(10, min(5000, reader[its_Rdr_StBlkMs])) * srate / 1000));
    L = max(8, floor(N * max(5, min(50, reader[its_Rdr_StOvlPc])) / 100));
    Hs = N - L;
    // the blocks are read at the speed of the reader (not 0 : a very slow reading), times the transposition
    r = 2 ^ (max(-24, min(24, reader[its_Rdr_StTransp])) / 12);
    rho = ((abs(v) < 0.01) ? ((v < 0) ? -0.01 : 0.01) : v) * r * a;
    t = max(-SPDMAX, min(SPDMAX, reader[its_Rdr_Stretch])); // (Stretch : the progression, the tempo)
    ext = N * abs(rho); // the extent of a block in the line
    e1 = min(0, N * rho); e2 = max(0, N * rho); // a block from x covers [x + e1, x + e2] (backward : below x)
    // the search of the correlation, +- (samples of the line)
    K = floor(max(0, min(1000 * its_RdW_KMax, reader[its_Rdr_StSrchMs])) * srate * a / 1000);
    // the line, and the loop (the region)
    st = reader[its_Rdr_Start]; ln = reader[its_Rdr_SmplCnt]; en = st + ln;
    ra = st + floor(reader[its_Rdr_LowPosSec] * srate); rb = st + floor(reader[its_Rdr_HighPosSec] * srate);
    lf = reader[its_Rdr_LfSt]; // the loop follows a writer (its_Rdr_LoopFollow) : it ends at the head of the writer
    (lf & its_RdrLf_On) ? (
        // no block reads beyond the writer, its lag and the window of its correlation included (the writer moves during
        // the block : a block read faster than it goes further) ; Brage : the segments are in the loop, their lag too
        br ? ( ra += K; rb -= K; ) : (
            rb -= K + max(0, N * (rho - its_Rd_LfSpd(reader))) + min(L, its_RdW_LcMax * srate) * max(0, rho);
            (rb - ra < ext) ? (ra = rb - ext); // (a loop shorter than a block : a block before the writer)
        );
    ) :
    (!br && (rb - ra < ext)) ? ( ra = st; rb = en; ); // (Stretch, a region shorter than a block : the whole line)
    // its overlap with the previous block (at the start : the fade in), at most its hop (the settings may have changed)
    reader[its_Rdr_StLin] = (reader[its_Rdr_StHs] > 0) ? min(reader[its_Rdr_StL], Hs) : L;
    // its start : the nominal start plus the lag found by the correlation, or the end (silence) ; the first block :
    // Brage, at random in the loop ; Stretch, from the read position, in the line (the speed and the stretch may have
    // opposite signs : a block read forward from the end of the line would read its start)
    lag = ((reader[its_Rdr_StCPh] === 4) && (reader[its_Rdr_StBestV] > 0)) ? reader[its_Rdr_StBest] : 0;
    nom = (reader[its_Rdr_StHs] > 0) ? reader[its_Rdr_StNNom] :
        br ? its_Br_Pick(ra, rb, ext, rho) - dsp :
        (lf & its_RdrLf_Frame) ? ( // (in the frame : of the writer, not beyond its head ; of a loop that crosses the end)
            (lf & its_RdrLf_On) ? min(rb, its_Rd_LfIn(reader, reader[its_Rdr_StNNom])) : its_Rd_LfIn(reader, reader[its_Rdr_StNNom]);
        ) :
        max(st - e1, min(en - e2, reader[its_Rdr_StNNom]));
    cur = reader[its_Rdr_StEnd] ? LOW_VALUE : nom + lag;
    ((cur !== LOW_VALUE) && (rho === floor(rho))) ? (cur = floor(cur + 0.5)); // an integer rate : integer positions
    reader[its_Rdr_StLag] = (cur !== LOW_VALUE) ? lag : 0;
    reader[its_Rdr_StCur] = cur; reader[its_Rdr_StNom] = nom;
    reader[its_Rdr_StHs] = Hs; reader[its_Rdr_StL] = L; reader[its_Rdr_StRho] = rho;
    reader[its_Rdr_StJ] = 0;
    reader[its_Rdr_StCPh] = 0;
    // the nominal start of the next block : Brage, at random in the loop (it ends when the loop has reached the end of
    // the line, type "once", see its_Rdr_LoopMove) ; Stretch, a jump asked (the position), else the stretch (the tempo),
    // then the loop types
    ty = reader[its_Rdr_LoopType];
    stop = 0;
    br ? (
        nn = its_Br_Pick(ra, rb, ext, rho) - dsp;
        stop = reader[its_Rdr_BrEnd] || (ty === its_RdrLoopTypeStop);
        reader[its_Rdr_NxtPosSec] = -1; // (no position : the loop)
    ) :
    ((w = reader[its_Rdr_NxtPosSec]) >= 0) ? (
        nn = its_Rd_LfIn(reader, st + floor(w * srate));
        reader[its_Rdr_NxtPosSec] = -1;
        reader[its_Rdr_Caught] = 0; // (type "catch" : free again, caught if it is in the loop)
    ) : (
        // (the input Offset : the change of its displacement, backward ; then in the loop or the line, as the progression)
        nn = nom + t * Hs * a + reader[its_Rdr_PosDisp] - dsp;
        reader[its_Rdr_PosDisp] = dsp;
        // the direction of the progression (following a writer : relative to the loop, that moves with the writer)
        tr = (lf & its_RdrLf_Frame) ? t * a - its_Rd_LfSpd(reader) : t;
        // type "catch" : caught when its nominal start is in the loop (or crosses its end, below), then it stays in it,
        // as with the type "loop" (a moving loop could pass over it between two blocks) ; the loop moved by hand : no new
        // catch while it moves (its_Rd_HandMove)
        (ty !== its_RdrLoopTypeCatch) ? (reader[its_Rdr_Caught] = 0) :
        ((reader !== its_RdNoCatch) && (nom >= ra) && (nom < rb)) ? (reader[its_Rdr_Caught] = 1);
        (ty === its_RdrLoopTypeStop) ? (stop = 1) :
        ((ty === its_RdrLoopTypeLoop) || ((ty === its_RdrLoopTypeCatch) && reader[its_Rdr_Caught])) ? (
            // in the region at once
            nn = ra + (nn - ra) - (rb - ra) * floor((nn - ra) / (rb - ra));
        ) :
        (tr >= 0) ? (
            (ty === its_RdrLoopTypeOnce) ? ((nn + e2 > en) ? (stop = 1)) :
            (ty === its_RdrLoopTypeCatch) ? (((reader !== its_RdNoCatch) && (nom < rb) && (nn >= rb)) ? ( nn -= rb - ra; reader[its_Rdr_Caught] = 1; )) :
            (ty === its_RdrLoopTypeExit) ? (((nom < rb) && (nn + e2 > rb)) ? (stop = 1)) :
            (nn = its_Rd_Wrap(reader, nn)); // repeat
        ) : (
            (ty === its_RdrLoopTypeOnce) ? ((nn + e1 < st) ? (stop = 1)) :
            (ty === its_RdrLoopTypeCatch) ? (((reader !== its_RdNoCatch) && (nom >= ra) && (nn < ra)) ? ( nn += rb - ra; reader[its_Rdr_Caught] = 1; )) :
            (ty === its_RdrLoopTypeExit) ? (((nom >= ra) && (nn + e1 < ra)) ? (stop = 1)) :
            (nn = its_Rd_Wrap(reader, nn)); // repeat
        );
    );
    reader[its_Rdr_StNNom] = nn;
    reader[its_Rdr_StEnd] = stop;
    // the correlation of the next block (its_St_Work, during this block) : the tail of this block (Lc terms, at most 20 ms
    // of the overlap) against the head of the next one, for the lags in [-K, K] ; in the room of the work area
    wk = reader[its_Rdr_Work];
    ((K > 0) && (cur !== LOW_VALUE) && !stop && (wk > BASE_MEMORY)) ? (
        // (a rate above its_RdW_RhoMax : a shorter window, its reads stay in the room of the work area)
        Lc = max(4, min(L, floor(its_RdW_LcMax * srate * min(1, its_RdW_RhoMax * a / max(0.001, abs(rho))))));
        cs = its_St_Step(srate * a); // the coarse step (4 at 48 kHz)
        sz = wk[its_RdW_Size] - its_RdW_Hdr - 2 * Lc - 8; // the room of X (every cs samples of the line)
        K = min(K, floor(((sz - 2) * cs - ceil(Lc * abs(rho)) - 4) / 2));
        (K > 0) ? (
            Xn = ceil((2 * K + ceil(Lc * abs(rho)) + 4) / cs) + 1; // (points of X)
            x0 = floor(nn - K + min(0, Lc * rho)) - 1; // (the head reads backward if rho < 0)
            reader[its_Rdr_StK] = K; reader[its_Rdr_StCn] = Lc; reader[its_Rdr_StXn] = Xn; reader[its_Rdr_StX0] = x0;
            reader[its_Rdr_StStep] = cs;
            reader[its_Rdr_StCI] = 0;
            reader[its_Rdr_StCq] = ceil((Lc + Xn) / max(1, floor(0.25 * Hs))); // the filling : in the first quarter of the hop
            reader[its_Rdr_StBest] = 0; reader[its_Rdr_StBestV] = -(10^30);
            reader[its_Rdr_StCPh] = 1;
        );
    );
);

// a slice of the correlation of the next block (@sample, at each sample of the current block) : 1 fill T, D, X ;
// 2 the coarse search (a lag every StStep, a term every StStep, X every StStep) ; 3 the fine search around the best lag,
// at full resolution (the line itself) ; 4 done. The cost is linear in the search (the window is at most 20 ms)
function its_St_Work(reader, lcbl)
local (ph, wk, tA, dA, xA, Lc, Xn, x0, K, cs, m, q, d, nc, cur, rho, hs, nn, i, c, e, x, sc, hi, mc)
(
    ph = reader[its_Rdr_StCPh];
    ((ph >= 1) && (ph <= 3) && ((wk = reader[its_Rdr_Work]) > BASE_MEMORY)) ? (
        Lc = reader[its_Rdr_StCn]; Xn = reader[its_Rdr_StXn]; x0 = reader[its_Rdr_StX0];
        K = reader[its_Rdr_StK]; cs = reader[its_Rdr_StStep]; hs = reader[its_Rdr_StHs];
        tA = wk + its_RdW_Hdr; dA = tA + Lc; xA = dA + Lc; // T, D, X
        m = reader[its_Rdr_StCI]; q = reader[its_Rdr_StCq];
        d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan];
        nc = max(1, min(8, min(reader[its_Rdr_BfChanUsed], reader[its_Rdr_OutW])));
        rho = reader[its_Rdr_StRho]; nn = reader[its_Rdr_StNNom];
        (ph === 1) ? (
            // T : the tail of this block ; D : the position in X of the head of the next block (lag 0), term by term ;
            // X : the candidates, every cs samples from x0
            cur = reader[its_Rdr_StCur];
            loop(min(q, Lc + Xn - m),
                (m < Lc) ? (
                    tA[m] = its_St_Mono(reader, lcbl, cur + (hs + m) * rho, d, nc);
                    dA[m] = (floor(nn + m * rho + 0.5) - x0) / cs;
                ) : (
                    xA[m - Lc] = its_St_Mono(reader, lcbl, x0 + (m - Lc) * cs, d, nc);
                );
                m += 1;
            );
            (m >= Lc + Xn) ? (
                m = -K;
                reader[its_Rdr_StCq] = ceil((floor(2 * K / cs) + 1) / max(1, floor(0.5 * hs))); // in the next half of the hop
                reader[its_Rdr_StCPh] = 2;
            );
        ) :
        (ph === 2) ? (
            loop(q,
                (m <= K) ? (
                    c = e = 0; i = 0; mc = m / cs + 0.5;
                    loop(ceil(Lc / cs), x = xA[floor(dA[i] + mc)]; c += tA[i] * x; e += x * x; i += cs;);
                    sc = c / sqrt(e + 0.000000000001);
                    (sc > reader[its_Rdr_StBestV]) ? ( reader[its_Rdr_StBestV] = sc; reader[its_Rdr_StBest] = m; );
                    m += cs;
                );
            );
            (m > K) ? (
                // the fine search : all the lags around the best one, all the terms (a lag per sample)
                x = reader[its_Rdr_StBest];
                m = max(-K, x - cs + 1);
                reader[its_Rdr_StCHi] = min(K, x + cs - 1);
                reader[its_Rdr_StBestV] = -(10^30); // (the scores of the coarse search have fewer terms)
                reader[its_Rdr_StCPh] = 3;
            );
        ) : (
            hi = reader[its_Rdr_StCHi];
            (m <= hi) ? (
                c = e = 0; i = 0;
                loop(Lc, x = its_St_Mono(reader, lcbl, nn + m + i * rho, d, nc); c += tA[i] * x; e += x * x; i += 1;);
                sc = c / sqrt(e + 0.000000000001);
                (sc > reader[its_Rdr_StBestV]) ? ( reader[its_Rdr_StBestV] = sc; reader[its_Rdr_StBest] = m; );
                m += 1;
            );
            (m > hi) ? (reader[its_Rdr_StCPh] = 4);
        );
        reader[its_Rdr_StCI] = m;
    );
);

// execute a reader in mode Stretch or Brage (@sample) : the channels "lcn" of the line "lcbl" read, to the cells from "oc"
function exec_stretch(reader, nbr, lcbl, lcn, vol, oc, playing)
local (v, j, lin, cur, tail, rho, prho, p, q, wn, wo, s, d, ds, b, val)
(
    // the speed, modulated : the read rate of the blocks (Stretch) or of the segments (Brage)
    v = max(-SPDMAX, min(SPDMAX, its_Mod_Apply(reader + its_Rdr_Mod1 + its_ModDist, reader[its_Rdr_AbsInc], its_ModA_Add, 1)));
    (reader[its_Rdr_StJ] < 0) ? (
        // the start, from the read position (Brage : at random in the loop) : the first block fades in (as after a
        // silent block)
        reader[its_Rdr_StCur] = LOW_VALUE; reader[its_Rdr_StHs] = 0; reader[its_Rdr_StRho] = 0;
        reader[its_Rdr_StNNom] = reader[its_Rdr_Abspos];
