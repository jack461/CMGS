    str;
);

// add " key value" to #its_TbW
function its_Tb_Cat(ty, ki, b)
(
    its_Tb_Get(ty, ki, b);
    strcat(#its_TbW, its_Xp_Sep());
    strcat(#its_TbW, (ty === its_TK_Writer) ? its_TbWNam[ki] : its_TbRNam[ki]);
    strcat(#its_TbW, " ");
    strcat(#its_TbW, its_Tb_ValText(#its_TbV1, ty, ki, its_Tb_g1, its_Tb_g2, its_Tb_g3, its_Tb_g4, its_Tb_g5));
);

// the block of the writer, the reader or the effect "k" (0 : none)
function its_Tb_Blk(ty, k) local(b)
(
    (ty === its_TK_Writer) ? (
        b = Writers_set[k];
        ((b > BASE_MEMORY) && (b[-2] === KW_writ)) ? b : 0;
    ) :
    (ty === its_TK_Reader) ? (
        b = Readers_set[k];
        ((b > BASE_MEMORY) && (b[-2] === KW_read)) ? b : 0;
    ) : (
        b = Effects_set[k];
        ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? b : 0;
    );
);

/*
    Dump Writer|Reader k : the keys of the module in the syntax of a table ; only the ones that have a meaning in its mode,
    the optional ones when they are not the default (a writer : its direction ; a reader : its mode, the moving loop...),
    the modulation inputs connected
