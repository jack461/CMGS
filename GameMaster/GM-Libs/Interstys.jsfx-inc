    loop(paramCount,
        parDcl(ix, #pUndef, #pUndef, 0, "-", "-", 0, 1, 0, 0.1, 0);
        ix += 1;
    );
    paramBlock[pp_Name] = "(unused)"; // this "locks" entry 0.
    menu_Param_mSL = 0;
    menu_Param_UBS = 0;
    menu_Param_UBD = 0;
    parDclMode = 0xf;
);

function
dclAllParameters()
local (ix, p, pdx, pp, pb, ii, ix, iy, u, w,mi, ma)
(
    paramBlock[pp_Name] = "(unused)"; // this "locks" entry 0.
    p = 2; // potentiometer curve for amplitude


    parDcl(p_uix_jtheme, "UI Theme",  "UITheme",   0,      "%d",   "UI Theme: %d", 0, 16, 0, 1, 0);

    parDcl(p_playSpeed, "Play Speed", "PlaySpd", i_UB|i_SP, "%.3f",  "Play Speed: %.3f", -SPDMAX, SPDMAX, 1, 0.001, 0);

    parDcl(p_playVol, "Play Volume",  "PlayVol",  i_UB|i_SP, "%.1f dB", "Play Volume: %.1f dB",   -120,   20,    0,  0.1, -3);

    parDcl(p_lineSize, "Line size",  "LineSize",  i_UB|i_SP, "%.3f s", "Line Size: %.3f s",   1,   3600,    1,  0.001, 3);

    parDcl(p_playPos, "Play position",  "PlayPos",  i_UB|i_SP, "%.3f s", "Play position: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Low, "Loop Low Lim.",  "LoopLLim",  i_UB|i_SP, "%.3f s", "Loop Low Lim.: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_High, "Loop High Lim.",  "LoopHLim",  i_UB|i_SP, "%.3f s", "Loop High Lim.: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Pos, "Loop position",  "LoopRPos",  i_UB|i_SP, "%.3f s", "Loop position: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Len, "Loop Length",  "LoopRLen",  i_UB|i_SP, "%.5f s", "Loop Length: %.5f s",   0.00001,   3600,    0,  0.00001, 6);
    parDcl(p_play_XFade, "Cross Fade", "CrssFade", i_UB|i_SP, "%.2f ms", "Cross Fade : %.2f ms", 0.01, 20000, 10, 0.01, 6);
    parDcl(p_play_Zoom, "Zoom", "WaveZoom", i_UB|i_SP, "%.0f", "Zoom : %.0f", 1, 100, 1, 1, 0);
    // strong exponential curve (slope 8) and 10 µs step : very fine choice of the small offsets
    parDcl(p_rdOffset, "Delay Offset", "RdOffset", i_UB|i_SP, "%.5f s", "Delay Offset: %.5f s", 0, 3600, 1, 0.00001, 8);
    parDcl(p_wrGain, "Record Gain",  "WrGain",  i_UB|i_SP, "%.1f dB", "Record Gain: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_wrOvrdb, "Overdub",  "WrOvrdb",  i_UB|i_SP, "%.1f %%", "Overdub: %.1f %%",   0,   100,    0,  0.1, 0);
    parDcl(p_glInGain, "Input Gain",  "GlInGain",  i_UB|i_SP, "%.1f dB", "Input Gain: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_glOutVol, "Output Volume",  "GlOutVol",  i_UB|i_SP, "%.1f dB", "Output Volume: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1, "Gain 1",  "FxGain1",  i_UB|i_SP, "%.1f dB", "Gain 1: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+1, "Gain 2",  "FxGain2",  i_UB|i_SP, "%.1f dB", "Gain 2: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+2, "Gain 3",  "FxGain3",  i_UB|i_SP, "%.1f dB", "Gain 3: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+3, "Gain 4",  "FxGain4",  i_UB|i_SP, "%.1f dB", "Gain 4: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+4, "Gain 5",  "FxGain5",  i_UB|i_SP, "%.1f dB", "Gain 5: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+5, "Gain 6",  "FxGain6",  i_UB|i_SP, "%.1f dB", "Gain 6: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+6, "Gain 7",  "FxGain7",  i_UB|i_SP, "%.1f dB", "Gain 7: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+7, "Gain 8",  "FxGain8",  i_UB|i_SP, "%.1f dB", "Gain 8: %.1f dB",   -120,   20,    0,  0.1, -3);
);



/*
    Try to read a file in a line new or existing
*/
function File_Handle(fname, lnb, lcbl)
local (FFrRate, FlCC, Fhandle, Fformat, FFSize, cbfsiz, bread, ptbuf, bcnt, addbuffs, rdcnt,
        rc, i, pb, ends, its_FilErr, bflen)
(
    FFrRate = FlCC = its_FilErr = 0;
    Fhandle = file_open(fname);
    Fformat = 1;
    (Fhandle < 0) ? (
        its_FilErr = 400;
    ) :
    (
        file_riff(Fhandle, FlCC, FFrRate);
        (FlCC < 1) ? (
            its_FilErr = 401;
        ) :
        (FlCC > 128) ? (
            its_FilErr = 402;
        ) :
        ((FFrRate < 2400) || (FFrRate > 384000)) ? (
            its_FilErr = 403;
        ) :
        (
            FAdjRate = FFrRate / srate;
            FFSize = file_avail(Fhandle); // Size for all samples
            (FFSize <= 480) ? (
                its_FilErr = 408;
            ); // File too short
        );
    );

    sprintf(#s, "File-1  %d  %d=[%d  / %d]  %.5f  %d", its_FilErr, Fhandle, FlCC, FFrRate, FAdjRate, FFSize);
    mSL_log(SysLogBox, #s);

    (its_FilErr === 0) ? (
        // channels buffer sizes
        cbfsiz = FFSize / FlCC + BF_LIM * 2;
        bflen = FFSize / FlCC; // durée d'un buffer
        // Is the line already existing ?
        ((lnb < 0) || (lcbl < BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)
            || (lcbl[its_Lin_SmplCnt] < cbfsiz) || (lcbl[its_Lin_ChCnt] != FlCC)) ? (
            // We need a larger buffer
            lnb = lcbl = -1;
        );
        (lnb < 0) ? (
            // Create the appropriate buffer
            lnb = Ln_New();
            (lnb < 0) ? (
                its_FilErr = 411;
            ) : (
                lcbl = Ln_Make(lnb, srate, bflen/srate, FlCC);
                (lcbl === 0) ? (
                    its_FilErr = 412;
                );
            );
        );
    );

    (its_FilErr === 0) ? (
        // On va lire par blocs de BFFSIZ samples
        bread = 0; // what has been read
        ptbuf = BF_LIM; // start adress in buffer
        bcnt = FlCC * floor(BFFSIZ/FlCC); // How much to read in one call
        addbuffs = lcbl + its_Lin_BF1ST;
        while (bread < FFSize) (
            rdcnt = min(bcnt, FFSize - bread);
            rc = file_mem(Fhandle, savwrk, rdcnt);
            (rc != rdcnt) ? (
                its_FilErr = 416;
                bread = FFSize;
            ) : (
                // Update buffers
                i = 0; while (i < rdcnt) (
                    pb = addbuffs[i % FlCC];
                    pb[ptbuf] = savwrk[i];
                    i += 1;
                    ((i % FlCC) === 0) ? ptbuf += 1;
                );
            );
            bread += rdcnt;
        );
    );

    (its_FilErr === 0) ? (
        ends = FFSize / FlCC;
        lcbl[its_Lin_RecFreq] = FFrRate;
        lcbl[its_Lin_Used] = ends + BF_LIM;
        // Duplicate start and end samples in the buffer
        i = 0; loop (FlCC,
            pb = addbuffs[i];
            memcpy(pb, pb + ends, BF_LIM);
            memcpy(pb+ends + BF_LIM, pb + BF_LIM, BF_LIM);
            i += 1;
        );
    ) : (
        lnb = -1;
    );

    sprintf(#s, "File-2  %d  %d; lin=%d  %f  ptb=%d", its_FilErr, Fhandle, lnb, ends, ptbuf);
    mSL_log(SysLogBox, #s);

    file_close(Fhandle);
    Fhandle = -1;

    // Return the actual line number
    lnb;
);


/*
    Execute a read - the reader is defined and in status "reading"
*/
function exec_reader(reader, nbr)
local (lcbl, wcbl, k, act, ty, w, s, d, f, it, lcn, vol, val, val_aux, mdr, loc, loc_aux, SP, A, A_aux, playing, l_valid, lax_valid, wps)
(
    its_RdrErrXe = (reader[its_Rdr_Check] !== BLOCK_CHECK);
    (its_RdrErrXe) ? (
        L__104 += 10000;
        // recheck all structure
        ((reader <= BASE_MEMORY) || (reader[-2] !== KW_read)) ? (
            its_RdrErrXe = 260; // erreur - reader is not a block
        ) :
        (reader[its_Rdr_Mode] === its_RdrMode_Read) ? (
            (((lcbl = reader[its_Rdr_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ? (
                its_RdrErrXe = 264; // erreur - line is not a block
            ) :
            ((reader[its_Rdr_Unuz1] != SECURE_BL) || (reader[its_Rdr_Unuz2] != SECURE_BL)) ? (
                its_RdrErrXe = 265; // erreur - reader block damaged
            ) :
            ((Lines_Set[reader[its_Rdr_LineNb]] != lcbl) || (reader[its_Rdr_ChNbr] != lcbl[its_Lin_ChCnt])) ? (
                its_RdrErrXe = 266; // erreur - line mismatched
            ) : (
                (lcbl[its_Lin_Check] !== BLOCK_CHECK) ? (
                    Ln_Check(reader[its_Rdr_LineNb]);
                );
                ((reader[its_Rdr_Start] != lcbl[its_Lin_Start])
                    || (reader[its_Rdr_Last] != lcbl[its_Lin_Last])) ? (
                    reader[its_Rdr_Start] = lcbl[its_Lin_Start];
                    reader[its_Rdr_Last] = lcbl[its_Lin_Last];
                    reader[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
                );
                ((reader[its_Rdr_Abspos] < reader[its_Rdr_Start])
                    || (reader[its_Rdr_Abspos] > reader[its_Rdr_Last])) ? (
                    reader[its_Rdr_Abspos] = reader[its_Rdr_Start];
                );
                reader[its_Rdr_Check] = BLOCK_CHECK;
                its_RdrErrXe = 0;
            );
        ) :
        (reader[its_Rdr_Mode] === its_RdrMode_Delay) ? (
            L__104 += 100;
            (((wcbl = reader[its_Rdr_WrBPtr]) <= BASE_MEMORY) || (wcbl[-2] !== KW_writ)) ? (
                its_RdrErrXe = 150; // writer referenced is not a block
            ) :
            (((lcbl = wcbl[its_Wrt_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ? (
                its_RdrErrXe = 154; // line is not a block
            ) : (
                reader[its_Rdr_Lcbl] = lcbl;
                reader[its_Rdr_LineNb] = wcbl[its_Wrt_LineNb]; // the line of the writer may have changed
                reader[its_Rdr_ChNbr] = lcbl[its_Lin_ChCnt];
                reader[its_Rdr_Bf1stChan] = 0;
                reader[its_Rdr_BfChanUsed] = (reader[its_Rdr_BfChanUsed] > 0) ? min(reader[its_Rdr_BfChanUsed], lcbl[its_Lin_ChCnt]) : lcbl[its_Lin_ChCnt];
                ((reader[its_Rdr_Start] != lcbl[its_Lin_Start])
                    || (reader[its_Rdr_Last] != lcbl[its_Lin_Last])) ? (
                    reader[its_Rdr_Start] = lcbl[its_Lin_Start];
                    reader[its_Rdr_Last] = lcbl[its_Lin_Last];
                    reader[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
                );
                reader[its_Rdr_WOffsetSmp] = max(1, min(reader[its_Rdr_WOffsetSmp], reader[its_Rdr_SmplCnt]));
                reader[its_Rdr_WOffset] = reader[its_Rdr_WOffsetSmp]/srate; // exact, not rounded to the ms
                rdupdt = 1;
                reader[its_Rdr_Check] = BLOCK_CHECK;
                its_RdrErrXe = 0;
                    L__104 += 1;
            );
        ) : (
            its_RdrErrXe = 130; // erreur - unknown exec mode
        );
    );



    (its_RdrErrXe === 0) ? (
        flgs = reader[its_Rdr_StFlgs];
        (flgs & its_RdrFlg_Mod) ? (
            // Update the reader
            Rd_Update(nbr);
        );
        playing = !(((flgs & its_RdrFlg_mute) || (its_RdrSolos !== 0)) && (!(flgs & its_RdrFlg_solo)));
    );



    (its_RdrErrXe === 0) ? (
        lcbl = reader[its_Rdr_Lcbl]; // the line
        lcn = reader[its_Rdr_BfChanUsed]; // count of used channels
        vol = reader[its_Rdr_OutVol]; // output read volume
        mdr = reader[its_Rdr_Mode]; // reader mode

        (mdr === its_RdrMode_Read) ? (
            // Mode reader
            loc = reader[its_Rdr_Abspos]; // loc is the index to read
            it = (loc === floor(loc)); // true if reading at integer positions
            ty = reader[its_Rdr_LoopType];
            // Are we in X-cross mode ?
            (reader[its_Rdr_XFadeCnt] > 0) ? (
                reader[its_Rdr_Tmp0] += 1;
                (playing) ? (
                    // Perform a double cross fade reading
                    // SP is the (increasing) index in the sinus table
                    SP = floor(reader[its_Rdr_XFadeIdxPos]);
                    A = sinus_table[SP]; // sin(x)
                    A_aux = sinus_table[SINUS_TABLE_SIZE - SP]; // cos(x)
                    loc_aux = reader[its_Rdr_AbsAuxpos]; // auxiliary read pointer; will finally disappear
                    l_valid = (loc >= reader[its_Rdr_Low]) && (loc <= reader[its_Rdr_High]);
                    lax_valid = (loc_aux >= reader[its_Rdr_Low]) && (loc_aux <= reader[its_Rdr_High]);
                    s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan]; // index of 1st buffer to read
                    val = val_aux = 0;
                    loop(lcn,
                        bfr = lcbl[s + d]; // the buffer to read
                        (bfr === 0) ? (
                            val = val_aux = 0;
                        ) : (
                            (it) ? (
                                // Read as integers
                                l_valid ? (val = bfr[loc]);
                                lax_valid ? (val_aux = bfr[loc_aux]);
                            ) : (
                                // Read as fractionnal
                                l_valid ? (val = inter_cube(bfr, loc));
                                lax_valid ? (val_aux = inter_cube(bfr, loc_aux));
                            );
                        );
                        smpl_tab[reader[its_Rdr_RCell] + s] += vol * (val * A + val_aux * A_aux);
                        s += 1;
                    );
                );
                // Update now the future position
                reader[its_Rdr_XFadeIdxPos] += reader[its_Rdr_XFadeIncr];
                reader[its_Rdr_Abspos] += reader[its_Rdr_AbsInc] * reader[its_Rdr_AdjInc];
                reader[its_Rdr_AbsAuxpos] += reader[its_Rdr_AbsInc] * reader[its_Rdr_AdjInc];
                reader[its_Rdr_XFadeCnt] -= 1;
                (reader[its_Rdr_XFadeCnt] <= 0) ? (
                    (reader[its_Rdr_Abspos] < MIN_VALUE) &&
                        ((ty === its_RdrLoopTypeOnce) || (ty === its_RdrLoopTypeExit) || (ty === its_RdrLoopTypeStop)) ? (
                        reader[its_Rdr_Tmp2] += 1;
                        // time to stop
                        Rd_Do_Stop(reader, nbr);
                    ) : (
                        reader[its_Rdr_Abspos] = max(reader[its_Rdr_Start], min(reader[its_Rdr_Last], reader[its_Rdr_Abspos]));
                    );
                );
            ) : (
                // Mode read standard
                (playing) ? (
                    s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan];
                    loop(lcn,
                        bfr = lcbl[s + d]; // the buffer to read
                        (bfr === 0) ? (
                            val = 0;
                        ) : (
                            (it) ? (
                                // Read as integers
                                val = bfr[loc];
                            ) : (
                                // Read as fractionnal
                                val = inter_cube(bfr, loc);;
                            );
                        );
                        smpl_tab[reader[its_Rdr_RCell] + s] += vol * val;
                        s += 1;
                    );
                );
                // Update now the future position
                reader[its_Rdr_Abspos] += reader[its_Rdr_AbsInc] * reader[its_Rdr_AdjInc];


                s = 0;
                // Has a change in position been requested ?
                ((w = reader[its_Rdr_NxtPosSec]) >= 0) ? (
                    // This becomes the new read position
                    reader[its_Rdr_Abspos] = reader[its_Rdr_Start] + floor(w * srate);
                    reader[its_Rdr_NxtPosSec] = -1;
                    F = reader[its_Rdr_XFadeCntNxt];
                    s = 1;
                ) ;

                // Action depending on mode

                k = reader[its_Rdr_Abspos];
                v = reader[its_Rdr_AbsInc];
                F = reader[its_Rdr_BFadeCntNxt];

                (ty === its_RdrLoopTypeCatch) ? (
                    // Normal read, is catched by a loop
                    ((k >= reader[its_Rdr_RegEIn]) && (k < reader[its_Rdr_RegEOut]) && (v >= 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegSOut]; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    ((k < reader[its_Rdr_RegSIn]) && (k >= reader[its_Rdr_RegSout]) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegEOut]; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeLoop) ? (
                    // immediately catched by the loop
                    (((k >= reader[its_Rdr_RegEIn]) || (k < reader[its_Rdr_RegSOut])) && (v >= 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegSOut]; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    (((k < reader[its_Rdr_RegSIn]) || (k > reader[its_Rdr_RegEOut])) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegEOut]; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeExit) ? (
                    // immediately catched by the loop
                    ((k >= reader[its_Rdr_RegEIn]) && (v >= 0)) ? (
                        // Time to start the end cross fade
                        reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    ((k < reader[its_Rdr_RegSIn]) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeStop) ? (
                    reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                    F = reader[its_Rdr_XFadeCntNxt];
                    s = 1;
                );

                (s === 0) ? (
                    // we may be at some end and need to loop
                    (ty !== its_RdrLoopTypeOnce) ? (
                        // loop at the end
                        ((k >= reader[its_Rdr_Last] - B_FADESIZ) && (v >= 0)) ? (
                            F = reader[its_Rdr_BFadeCntNxt];
                            // start cross fading
                            reader[its_Rdr_Abspos] = k - reader[its_Rdr_SmplCnt];
                            s = 1;
                        ) :
                        ((k < reader[its_Rdr_Start] + B_FADESIZ) && (v < 0)) ? (
                            F = reader[its_Rdr_BFadeCntNxt];
                            // start cross fading
                            reader[its_Rdr_Abspos] = k + reader[its_Rdr_SmplCnt];
                            s = 1;
                        );
                    ) :
                    (
                        // Stop at the end
                        ((k >= reader[its_Rdr_Last] - B_FADESIZ) && (v >= 0)) ? (
                            F = reader[its_Rdr_BFadeCntNxt];
                            // start fading, stop at the end
                            reader[its_Rdr_Abspos] = LOW_VALUE;
                            reader[its_Rdr_Tmp3] += 1;
                            s = 1;
                        ) :
                        ((k < reader[its_Rdr_Start] + B_FADESIZ) && (v < 0)) ? (
                            F = reader[its_Rdr_BFadeCntNxt];
                            // start fading, stop at the end
                            reader[its_Rdr_Abspos] = LOW_VALUE;
                            reader[its_Rdr_Tmp3] += 1;
                            s = 1;
                        );
                    );
                );

                (s) ? (
                    reader[its_Rdr_Tmp4] += 1;
                    reader[its_Rdr_AbsAuxpos] = k; // previous read position becomes the new aux
                    reader[its_Rdr_XFadeCnt] = F; // start counting
                    reader[its_Rdr_XFadeIncr] = SINUS_TABLE_SIZE / reader[its_Rdr_XFadeCnt];
                    reader[its_Rdr_XFadeIdxPos] = 0;
                );
            );
        ) :

        (mdr === its_RdrMode_Delay) ? (
            // we are in delay mode
            s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan];
            wcbl = reader[its_Rdr_WrBPtr]; // point to the writer block
            wps = wcbl[its_Wrt_Abspos];
            k = loc = wps - reader[its_Rdr_WOffsetSmp];
            (loc < reader[its_Rdr_Start]) ? (loc += reader[its_Rdr_SmplCnt]);
            reader[its_Rdr_Abspos] = loc; // the read position, for the display (waveform marker, "Pos")
            (reader[its_Rdr_XFadeCnt] > 0) ? (
                // offset changed : cross fade from the previous offset (its_Rdr_AbsAuxpos), see Rd_Set_Offset
                w = reader[its_Rdr_AbsAuxpos];
                ((w < 1) || (w > reader[its_Rdr_SmplCnt])) ? (
                    reader[its_Rdr_XFadeCnt] = 0; // not an offset : no cross fade
                ) : (
                    loc_aux = wps - w;
                    (loc_aux < reader[its_Rdr_Start]) ? (loc_aux += reader[its_Rdr_SmplCnt]);
                );
            );
            // mute / solo (playing) : no output, but the read position and the cross fade go on
            (playing && (wcbl[its_Wrt_Status] === its_WrtStat_Writing)) ? (
                (reader[its_Rdr_XFadeCnt] > 0) ? (
                    SP = floor(reader[its_Rdr_XFadeIdxPos]);
                    A = vol * sinus_table[SP]; // sin(x) : new offset
                    A_aux = vol * sinus_table[SINUS_TABLE_SIZE - SP]; // cos(x) : previous offset
                    loop(lcn,
                        ((bfr = lcbl[s + d]) !== (val = 0)) ? (
                            val = A * loc[bfr] + A_aux * loc_aux[bfr];
                        );
                        smpl_tab[reader[its_Rdr_RCell] + s] += val;
                        s += 1;
                    );
                ) : (
                    loop(lcn,
                        ((bfr = lcbl[s + d]) !== (val = 0)) ? (
                            val = vol * loc[bfr];
                        );
                        smpl_tab[reader[its_Rdr_RCell] + s] += val;
                        s += 1;
                    );
                );
            );
            (reader[its_Rdr_XFadeCnt] > 0) ? (
                reader[its_Rdr_XFadeIdxPos] += reader[its_Rdr_XFadeIncr];
                reader[its_Rdr_XFadeCnt] -= 1;
            );
        );

        ((nbr === slReader) && (rdtim !== ctime)) ? (
            rdtim = ctime; // so every second...
            slRPosPrv = slRPos = max(0,min(100, floor(0.5 + 10000 * (reader[its_Rdr_Abspos] - reader[its_Rdr_Start])/max(1, reader[its_Rdr_Last] - reader[its_Rdr_Start]))/100)) ;
        );

    ) : (

        // An error occured OR the reader is muted
        ((reader > BASE_MEMORY) && (reader[-2] === KW_read)) ? (
            // fill the output with zeroes (ex. mute)
            s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan];
            /*
            loop(reader[its_Rdr_BfChanUsed],
                smpl_tab[reader[its_Rdr_RCell] + s] = 0 ;
                s += 1;
            );
            */
            (its_RdrErrXe > 0) ? (
                (reader[its_Rdr_Status] === its_RdrStat_Reading) ? (
                        reader[its_Rdr_Tmp4] = 150;
                        reader[its_Rdr_Tmp5] = reader[its_Rdr_Status];
                        reader[its_Rdr_Tmp6] = ts();
                );
                ((reader[its_Rdr_Lcbl] > BASE_MEMORY) && (reader[its_Rdr_RCell] != 0)) ? (
                    reader[its_Rdr_Status] = its_RdrStat_Ready;
                ) : (
                    reader[its_Rdr_Status] = its_RdrStat_Created;
                );
                dbg_show_3(reader, 310);
            );
            reader[its_Rdr_Error] = max(0, its_RdrErrXe);
        );
        rdupdt = 1;
    );
);

function exec_writer(writer, nbr)
local (lcbl, k, s, x, bp, val, vol, f, n, md)
(
    its_WrtErrXe = (writer[its_Wrt_Check] !== BLOCK_CHECK);
    (its_WrtErrXe) ? (
        // recheck all struct
        ((writer <= BASE_MEMORY) || (writer[-2] !== KW_writ)) ? (
            its_WrtErrXe = 310; // erreur - invalid writer block
        ) :
        (((lcbl = writer[its_Wrt_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ?(
            its_WrtErrXe = 312; // erreur - invalid line reference
        ) :
        ((writer[its_Wrt_Unuz1] != SECURE_BL) || (writer[its_Wrt_Unuz2] != SECURE_BL)) ? (
            its_WrtErrXe = 317; // erreur - writer block damaged
        ) :
        ((writer[its_Wrt_SmplCnt] != lcbl[its_Lin_SmplCnt]) || (writer[its_Wrt_ChNbr] != lcbl[its_Lin_ChCnt])) ? (
            its_WrtErrXe = 318; // erreur - line information mismatched
            Trace_Z_001 = writer[its_Wrt_SmplCnt];
            Trace_Z_002 = lcbl[its_Lin_SmplCnt];
            Trace_Z_003 = writer[its_Wrt_ChNbr];
            Trace_Z_004 = lcbl[its_Lin_ChCnt];
        ) : (
            ((writer[its_Wrt_Start] != lcbl[its_Lin_Start])
                || (writer[its_Wrt_Last] != lcbl[its_Lin_Last])) ? (
                writer[its_Wrt_Start] = lcbl[its_Lin_Start];
                writer[its_Wrt_Last] = lcbl[its_Lin_Last];
                writer[its_Wrt_SmplCnt] = lcbl[its_Lin_SmplCnt];
            );
            ((writer[its_Wrt_Abspos] < writer[its_Wrt_Start])
                || (writer[its_Wrt_Abspos] >= writer[its_Wrt_Last])) ? (
                writer[its_Wrt_Abspos] = writer[its_Wrt_Start];
            );
            writer[its_Wrt_Check] = BLOCK_CHECK;
            its_WrtErrXe = 0;
        );
    );
    (its_WrtErrXe === 0) ? (
        k = writer[its_Wrt_Abspos];
        x = writer[its_Wrt_Ovrdb];
        vol = writer[its_Wrt_InGain];
        md = writer[its_Wrt_Mode];
        // Sample read
        lcbl = writer[its_Wrt_Lcbl];
        // the cells [Cell ... Cell+n-1] go to the channels [f ... f+n-1] of the line
        f = max(0, min(writer[its_Wrt_ChNbr] - 1, writer[its_Wrt_Bf1stChan])); // first channel
        n = writer[its_Wrt_ChNbr] - f;
        (writer[its_Wrt_BfChanUsed] > 0) ? (n = min(n, writer[its_Wrt_BfChanUsed])); // 0 : all
        s = 0; loop(n,
            // Allows null pointers as output buffers
            ((bp = lcbl[its_Lin_BF1ST + f + s]) !== 0) ? (
                val = smpl_tab[writer[its_Wrt_Cell] + s];
                (md === its_WrtMode_Sum) ? (
                    k[bp] = val = 0.01 * x * k[bp] + vol * val;
                ) : (
                    (x > 0) ? (
                        val = 0.01 * (x * k[bp] + (100 - x) * val);
                    );
                    k[bp] = val = vol * val;
                );
                // when at start/end of buffer, duplicate samples in guard area
                (k < writer[its_Wrt_Start] + BF_LIM) ? (
                    k[bp + writer[its_Wrt_SmplCnt]] = val;
                ) :
                (k > writer[its_Wrt_Last] - BF_LIM) ? (
                    k[bp - writer[its_Wrt_SmplCnt]] = val;
                );
            );
            s += 1;
        );
        /*
        Trace_X_its_Wrt_5_Loop = s;
        Trace_X_its_Wrt_4_smpl = val;
        Trace_X_its_Wrt_5_A1 = smpl_tab[writer[its_Wrt_Cell] + 0];
        Trace_X_its_Wrt_5_A2 = smpl_tab[writer[its_Wrt_Cell] + 1];
        Trace_X_its_Wrt_5_C1 = k[lcbl[its_Lin_BF1ST]];
        Trace_X_its_Wrt_5_C2 = k[lcbl[its_Lin_BF1ST + 1]];
        */
        k += 1;
        (k >= writer[its_Wrt_Last]) ? (k = writer[its_Wrt_Start];);
        writer[its_Wrt_Abspos] = k;
        /*
        Trace_X_its_Wrt_1_First = writer[its_Wrt_Start];
        Trace_X_its_Wrt_2_Abspos = k;
        Trace_X_its_Wrt_3_Last = writer[its_Wrt_Last];
        */
        ((nbr === slWriter) && (wrtim !== ctime)) ? (
            wrtim = ctime;
            slWrPosPrv = slWrPos = max(0,min(100, floor(0.5 + 10000 * (writer[its_Wrt_Abspos] - writer[its_Wrt_Start])/max(1, writer[its_Wrt_Last] - writer[its_Wrt_Start]))/100)) ;
        );
    ) : (
        // An error occured
        ((writer > BASE_MEMORY) && (writer[-2] === KW_writ)) ? (
            ((writer[its_Wrt_Lcbl] > BASE_MEMORY) && (writer[its_Wrt_Cell] != 0)) ? (
                writer[its_Wrt_Status] = its_WrtStat_Ready;
            ) : (
                writer[its_Wrt_Status] = its_WrtStat_Created;
            );
            dbg_show_4(writer, 730);
            writer[its_Wrt_Error] = max(0, its_WrtErrXe);
        );
        wrupdt = 1;
    );

);

/*
    execute the effect "fx" (number "nbr") : called by @sample, in the phase of the effect
    Mixer and EQ Mixer (the EQ Mixer only sets equal gains, see its_fx_actions) :
        Out[0 ... CCnt-1] = sum of Vol_i * Src_i[0 ... CCnt-1], for the sources i in [1 ... 8] not null
    the structure is checked again after each modification (its_Efx_Check reset to 0) ; the error is kept in its_Efx_Error
    the gains in dB (its_Efx_VoldB_i) are the reference : the linear gains (its_Efx_Vol_i) are computed by the check
*/
function exec_fx(fx, nbr)
local (ty, ptsrc, src, dst, cc, ccnt, g, i, err)
(
    (fx[its_Efx_Check] !== BLOCK_CHECK) ? (
        err = 0;
        ty = fx[its_Efx_Type];
        ccnt = fx[its_Efx_CCnt];
        dst = fx[its_Efx_Out];
        ((ty === its_Efx_TyMixer) || (ty === its_Efx_TyEQMixer)) ? (
            ((ccnt <= 0) || (ccnt > 128) || (ccnt !== floor(ccnt))) ? (
                err = 2701; // erreur : bad channel count
            ) :
            ((dst <= 0) || (dst + ccnt > SMPL_SIZE)) ? (
                err = 2702; // erreur : bad output cell
            ) : (
                cc = 0; ptsrc = fx + its_Efx_Src1;
                loop(8,
                    g = ptsrc[its_Efx_VoldB1 - its_Efx_Src1];
                    ptsrc[its_Efx_Vol1 - its_Efx_Src1] = (g > -120) ? 10^(g/20) : 0;
                    src = ptsrc[0];
                    ((src < 0) || (src + ccnt > SMPL_SIZE)) ? (
                        err = 2703; // erreur : bad source cell
                    ) :
                    ((src > 0) && (src < dst + ccnt) && (src + ccnt > dst)) ? (
                        err = 2704; // erreur : a source overlaps the output
                    ) :
                    (src > 0) ? (
                        cc += 1;
                    );
                    ptsrc += its_EfxDist;
                );
                ((err === 0) && (cc === 0)) ? (
                    err = 2705; // erreur : no source
                );
            );
        ) : (
            err = 2706; // erreur : type not (yet) executed
        );
        fx[its_Efx_Error] = err;
        (err === 0) ? (
            fx[its_Efx_Check] = BLOCK_CHECK;
        );
    );
    (fx[its_Efx_Check] === BLOCK_CHECK) ? (
        // Mixer, EQ Mixer
        dst = fx[its_Efx_Out] + smpl_tab;
        ccnt = fx[its_Efx_CCnt];
        i = 0; loop(ccnt, dst[i] = 0; i += 1;);
        ptsrc = fx + its_Efx_Src1;
        loop (8,
            ((src = ptsrc[0]) > 0) ? (
                src += smpl_tab;
                g = ptsrc[its_Efx_Vol1 - its_Efx_Src1];
                i = 0; loop(ccnt,
                    dst[i] += g * src[i];
                    i += 1;
                );
            );
            ptsrc += its_EfxDist;
        );
        exec_effect += 1;
    );
);




//======== Serialize Procedures : save_mem, load_mem (mSL_Serialize.jsfx-inc)

function check_its_block(cbl)
(
    (cbl[0] !== SECURE_BL) || (cbl[cbl[-1]-1] !== SECURE_BL);
);

function recreate_structures()
local (ln, renew, nlcbl, olcbl, nrcbl, nwcbl, alt, i)
(
    // Update newly loaded line structures
    ln = 0; loop(LN_CNT + 1,
        renew = -1;
        nlcbl = Lines_Set[ln+AltWAdec]; // nouvelle "ln"
        (nlcbl !== 0) ? (
            olcbl = Lines_Set[ln]; // ancienne "ln"
            (olcbl !== 0) ? (
                // Peut-on réutiliser l'ancienne ligne ?
                ((olcbl[its_Lin_ChCnt] === nlcbl[its_Lin_ChCnt]) // meme nombre de canaux
                    && (olcbl[its_Lin_SmplCnt] === nlcbl[its_Lin_SmplCnt]) // meme nombre de sample
                    && (olcbl[its_Lin_Tmp1] === 0)) ? ( // non encore utilisé
                    renew = ln;
                    olcbl[its_Lin_Tmp1] = 1000 + ln;
                );
            );
            // peut-on retrouver une ancienne ligne similaire ?
            alt = 0;
            while ((renew < 0) && (alt < LN_CNT)) (
                olcbl = Lines_Set[alt];
                ((olcbl != 0) && (olcbl[its_Lin_ChCnt] === nlcbl[its_Lin_ChCnt])
                    && (olcbl[its_Lin_SmplCnt] === nlcbl[its_Lin_SmplCnt])
                    && (olcbl[its_Lin_Tmp1] === 0)) ? ( // the old line is not yet used (was nlcbl)
                    renew = alt;
                    olcbl[its_Lin_Tmp1] = 2000 + ln;
                );
                alt += 1; // (was missing : the loop ran up to the JSFX limit)
            );

            (renew < 0) ? (
                // recréons de nouveaux buffers
                memset(nlcbl+its_Lin_BF1ST, 0, 128); // clear previous content
                i = its_Lin_BF1ST; loop(nlcbl[its_Lin_ChCnt],
                    nlcbl[i] = mSL_Dyn_Alloc(nlcbl[its_Lin_ActBSize], KW_buff, mSL_StM_FlClear);
sprintf(#A007,"buff-n  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i-1-its_Lin_BF1ST, nlcbl[i-1]);
sprintf(#A008,"buff-n  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i-its_Lin_BF1ST, nlcbl[i]);
                    i += 1;
                );
            ) : (
                // On réutilise les buffers de l'ancienne ligne
                olcbl = Lines_Set[renew];
                i = its_Lin_BF1ST; loop (128,
                    nlcbl[i] = olcbl[i];
sprintf(#A007,"buff-r  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i-1, nlcbl[i-1]);
sprintf(#A008,"buff-r  %d {%d  ch=%d  bf=%d}", ln, nlcbl, i, nlcbl[i]);
                    olcbl[i] = 0; i += 1;
                );
            );
            nlcbl[its_Lin_Check] = 0; // for future fast check
sprintf(#A006,"nlcbl %d {%d  ch=%d  sz=%d}", ln, nlcbl, nlcbl[its_Lin_ChCnt], nlcbl[its_Lin_SmplCnt]);
            dbg_show_2(mem,66)
        );
        ln += 1;
    );
    // On peut libérer les anciennes lignes
    ln = 0; loop(LN_CNT + 1,
        Ln_Delete(ln);
        ln += 1;
    );

    // Update readers
    ln = 0; loop(RD_CNT + 1,
        nrcbl = Readers_set[ln+AltWAdec];
        (nrcbl !== 0) ? (
            // update lines addresses
            (nrcbl[its_Rdr_Lcbl] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_Lcbl] = Lines_Set[nrcbl[its_Rdr_LineNb]+AltWAdec];
sprintf(#A004,"UpdRd %d bn=%d ba=%d", ln, nrcbl[its_Rdr_LineNb], Lines_Set[nrcbl[its_Rdr_LineNb]+AltWAdec]);
            );
            // reader lié à un writer ?
            (nrcbl[its_Rdr_WrBPtr] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_WrBPtr] = Writers_set[nrcbl[its_Rdr_WrSrc]+AltWAdec];
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens lecteurs
    ln = 0; loop(RD_CNT + 1,
        Rd_Delete(ln);
        ln += 1;
    );

    // Update writers
    ln = 0; loop(WR_CNT + 1,
        nwcbl = Writers_set[ln+AltWAdec];
        (nwcbl !== 0) ? (
            (nwcbl[its_Wrt_Lcbl] > BASE_MEMORY) ? (
                // Update with the new address
                nwcbl[its_Wrt_Lcbl] = Lines_Set[nwcbl[its_Wrt_LineNb]+AltWAdec];
sprintf(#A005,"UpdWr %d st=%d bn=%d ba=%d", ln, nwcbl[its_Wrt_Status], nwcbl[its_Wrt_LineNb], Lines_Set[nwcbl[its_Wrt_LineNb]+AltWAdec]);
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens écrivains
    ln = 0; loop(WR_CNT + 1,
        Wr_Delete(ln);
        ln += 1;
    );

    // On peut libérer les anciens effets
    ln = 0; loop(FX_CNT + 1,
        FX_Delete(ln);
        ln += 1;
    );

    // mise en place du nouveau bloc d'addresses
    memcpy(StaticWA, DuplWA, StaticWASize);
    memset(DuplWA, 0, StaticWASize);
    updt_tables(StaticWA);
);

/*
    Gather all information needed for a preset
    SVASIZ is at least 32
*/
function build_savarea()
(
    memset(savarea, 0, SVASIZ);
    savarea[0] = savcode;

    savarea[10] = pgmode;
    savarea[11] = vol_inp;
    savarea[12] = vol_out;

    savarea[SVASIZ-1] = savcode;
);

function load_loadarea()
(
    // after a preset load, always back to "Merge" (the saved mode lodarea[10] is ignored) ;
    // update_sliders() then sets pgmode and vol_inp, and shows the gain sliders
    slSmpl = 0; slSmplPrv = -1;
    sliderchange(slSmpl);
    vol_out = lodarea[12];
);



// Print a sequence of strings
function mSL_133(argc, argv)
(
    while (argc > 0) (
        mSL_log(SysLogBox, argv[0]);
        argc -= 1; argv += 1;
    );
);

// This redefines the function "mSL_134" as the product of its operands
function mSL_134(argc, argv)
local (product, ip)
(
    product = 1;
    ip = 0;
    loop(argc, product *= argv[ip]; ip += 1;);
    product;
);

// External access to some useful data structures
function mSL_135(argc, argv)
local (item)
(
    item = argv[0];
    (item == KodedSchPads) ? (
        SchedPadSet; // A 16 entries array
    ) :
    (
        -1;
    );
);

function mSL_define_extensions()
(
    mSL_define_opcode("GM_Log", 133); // define "GM_Log"
    mSL_define_opcode("print", 133); // define print as a synonyp for "GM_Log"
    mSL_define_opcode("prod", 134); // define "prod"
    mSL_define_opcode("GM_Addr", 135); // etc.
);

// define our new extensions
mSL_define_extensions();


initAllParameters();
dclAllParameters();

// GC bounds : roots (mm_usr_prot, StaticWA, paramBlock...) and the dynamic memory must be
// between mm_lowblocks and mm_highblocks, otherwise gc_mark ignores them
mm_highblocks = make_array(2); // no block with memory references beyond that
mm_highblocks[0] = 'High'; mm_highblocks[1] = '_Mem';


/*
    Gui operations
*/
function mSL_gui_ops(argc, argv)
local(res, kw, npar, pp, r, sr, n, cnt, i, j, v, chk, idt,
      s, k, w, xbox, chkprev, res_end, ptb, ptw, pts, pta, lct, ds, ref, txt)
(
    res = Undef;
    (argc > 1) ? (
        kw = argv[0];
        npar = argv[1];

        (kw === mSL_KW_slider) ? (
            pp = 0;
            ((npar === (0|npar)) && (npar >= 0) && (npar < paramCount)) ? (
                pp = paramBlock + npar * paramEntSize;
            ) :
            ((npar > mSL_Sym_Low) && (npar < mSL_Sym_High) && (mSL_getinHT(paramHashTbl, npar) >= 0)) ? (
                pp = paramBlock + (npar = mSL_getinHTaux) * paramEntSize;
            );
            (pp != 0) ? (
                (argc >= 11) ? (
                    parDclMode = 1;
                    r = parDcl(npar, argv[2], argv[3], argv[4], argv[5], argv[6], argv[7], argv[8], argv[9], argv[10],
                        ((argc >= 12) ? argv[11]: 0), ((argc >= 13) ? argv[12]: 0), ((argc >= 14) ? argv[13]: 0),
                        ((argc >= 15) ? argv[14]: 0), ((argc >= 16) ? argv[15]: 0), ((argc >= 17) ? argv[16]: 0));
                    (r === 0) ? (
                        argc = 2; // return/build the entry
                    ) : (
                        // signal error
                        sprintf(#u, "++Slider error: %d - %d", npar, r);mSL_log(SysLogBox, #u);
                        argc = 2;
                    );
                );
                ((argc === 2) && (pp[pp_Name] != 0) && (pp[pp_Name] != #pUndef)) ? (
                    // return, if any, the slider block reference
                    sr = pp[pp_mSL_Ref];
                    ((sr > 0) && (mSL_bl_check(sr, 'sldr')) && (sr[-1] >= 12)) ? (
                        res = sr;
                    ) : (
                        pp[pp_mSL_Ref] = res = mSL_Dyn_Alloc(12, 'sldr', mSL_StM_FlClear);
                    );
                    // Create/update the slider descriptor
                    pp[pp_Addr] = res + 3;
                    paramFlags[npar] |= pflg_ChkWrite;
                    res[0] = mSL_KW_slider;
                    res[1] = npar;
                    res[2] = pp[pp_mSL_Code];
                    res[3] = parGetV(npar);
                    res[4] = pp[pp_Name];
                    res[5] = pp[pp_SFmt];
                    res[6] = pp[pp_MFmt];
                );
            );
        ) :
        (kw === mSL_KW_declare) ? (
            (mSL_bl_check(npar, 'umod') && (argc >= 4)) ? (
                idt = argv[2]; // uname
                n = argv[3]; // module. num
                (mSL_isString(idt) && (n === (0|n)) && (n >= 0) && (n <= dcbUModsSiz)) ? (
                    // declare the module
                    blockUsrNames[n] = idt;
                    blockUsrRefs[n] = npar;
                    res = n;
                );
            );
        ) :
        (kw === mSL_KW_update) ? (
            ((npar === mSL_KW_sliders) || (npar === mSL_KW_Params)) ? (
                // Rebuild parameters sliders
                menu_Param_mSL = 0;
                menu_Param_UBS = 0;
                menu_Param_UBD = 0;
                parDclMode = 0;
                dclAllParameters();
            ) :
            (npar === mSL_KW_modules) ? (
                // After creating new users modules
                checkUsrMods(); // valid blocks
                mkModuleMenu();// rebuild the menu
            );
        ) :
        (kw === mSL_KW_sbox) ? (
            // Creating a Slider Box
            cnt = argc - 1; // count of expected sliders references
            i = 1; n = 0; loop(cnt,
                v = argv[i];
                // lets check that v is a slider reference
                mSL_bl_check(v, 'sldr') ? (n += 1);
                i += 1;
            );
            (n === cnt) ? (
                // all parameters are sliders. Let's create the container
                res = mSL_Dyn_Alloc(ubx_isiz+cnt, 'sbox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'sbox'; // this is a slider box
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res;  // points to itself
                res[ubx_anc] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // no direct descendants
                res[ubx_icnt] = cnt; // items count
                res[ubx_1st] = 0; // not relevant for now
                res[ubx_tcnt] = 0; // no descendants at all
                //----
                res[ubx_l] = 0; // not relevant for now
                res[ubx_t] = 0; // not relevant for now
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_slidh * cnt; // actual value in pixels, "correct"
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                i = 1; j = ubx_isiz; loop(cnt,
                    res[j] = argv[i]; i += 1; j += 1;
                );
            );
        ) :
        (kw === mSL_KW_ibox) ? (
            // Create an info box with a set of infos to display
            cnt = argc - 1; // count of expected parameters
            (cnt > 1) ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+cnt+1), 'ibox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'ibox'; // This is an infobox
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // direct descendants count
                res[ubx_icnt] = 1;  // one item
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = 0; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_tboxs+5; // appropriate height
                //----
                res[ubx_minw] = ui_MinSubColSize; // min size
                res[ubx_maxw] = 5 * ui_MinSubColSize; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy
                ptb[0] = cnt;
                i = 0; loop(cnt,
                    i += 1; ptb += 1;
                    ptb[0] = argv[i];
                );
            );
        ) :
        ((kw === mSL_KW_hbox)) ? (
            // Create an horizontal box, expect a set of '*box'
            xbox = 'hbox';
            k = argc - 1; // count of parameters
            chk = i = 1; chkprev = cnt = w = n = 0;
            loop(k,
                v = argv[i];
                ((chk && chkprev && (v < 1024))) ? (
                    w += 1;
                    chkprev = 0;
                ) :
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                    cnt += 1;
                    chkprev = 1;
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+2*cnt), xbox, mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = xbox; // This is an horizontal box
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy references
                ptw = ptb + cnt; // where to copy widths
                k = argc - 1; // count of parameters
                i = 1; chkprev = 0; w = 0;
                loop(k,
                    v = argv[i];
                    ((chkprev && (v < 1024))) ? (
                        ptw[w-1] = v;
                        chkprev = 0;
                    ) :
                    (mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box')) ? (
                        ptb[w] = v;
                        ptw[w] = Undef; // default width
                        chkprev = 1;
                        w += 1;
                    );
                    i += 1;
                );
            );
        ) :
        ((kw === mSL_KW_vbox)) ? (
            // Create a vertical box, expect a set of '*box'
            xbox = 'vbox';
            cnt = argc - 1; // count of expected references
            chk = i = 1; n = 0; loop(cnt,
                v = argv[i];
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+n), xbox, mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = xbox; // This is a vertical box
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                // Copy references
                ptb = res + ubx_isiz; // where to copy
                i = 1; loop(cnt,
                    ptb[0] = argv[i]; i += 1; ptb += 1;
                );
            );
        ) :
        (kw === mSL_KW_tbox) ? (
            // Create a text box - Expect a string as parameter
            txt = argv[1];
            (chk = mSL_isString(txt)) ? (
                res = mSL_Dyn_Alloc((s = ubx_isiz+1), 'tbox', mSL_StM_FlClear);
                //----
                res[ubx_ty] = 'tbox'; // this is a slider box
                res[ubx_flgs] = ubx_final; // object is final
                res[ubx_mref] = res;  // points to itself
                res[ubx_anc] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = 0; // no direct descendants
                res[ubx_icnt] = 1; // items count
                res[ubx_1st] = 0; // not relevant for now
                res[ubx_tcnt] = 0; // no descendants at all
                //----
                res[ubx_l] = 0; // not relevant for now
                res[ubx_t] = 0; // not relevant for now
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = ui_jd_vtext; // actual value in pixels, "correct"
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                //----
                res[ubx_isiz] = txt; // the string number
            );
        ) :
        (kw === mSL_KW_module) ? (
            // Expect a module name
            // idt = argv[1];
            // chk = mSL_isString(idt);
            cnt = argc - 1; // count of expected references
            chk = i = 1; n = 0; loop(cnt,
                v = argv[i];
                (chk = (chk && mSL_bl_check(v) && ((v[-2] & 0xffffff) === 'box'))) ? (
                    n += 1 + v[ubx_tcnt]; // count of internal objects
                );
                i += 1;
            );
            chk ? (
                // all objects seem ok. Let's create the module
                res = mSL_Dyn_Alloc((s = ubx_isiz+n*ubx_isiz), 'umod', mSL_StM_FlClear);
                res_end = res + s;
                //----
                res[ubx_ty] = 'umod'; // This is a module
                res[ubx_flgs] = 0; // not relevant for now
                res[ubx_mref] = res; // points to itself
                res[ubx_name] = 0; // not relevant for now
                //----
                res[ubx_lcnt] = cnt; // direct descendants count
                res[ubx_icnt] = 0;  // no items
                res[ubx_1st] = 0; // relative pointer to 1st descendant
                res[ubx_tcnt] = n; // total count of all descendants
                //----
                res[ubx_l] = Undef; // not known yet
                res[ubx_t] = Undef; // not known yet
                res[ubx_w] = Undef; // not known yet
                res[ubx_h] = Undef; // not known yet
                //----
                res[ubx_minw] = Undef; // not known yet
                res[ubx_maxw] = Undef; // not known yet
                res[ubx_thread] = mSL_current_thread; //current thread
                res[ubx_thrdid] = mSL_current_thread[mSL_THR_UTId]; // current thread id
                // res[ubx_xxxx] = 0; // ubx_xxxx is not defined : would overwrite res[ubx_ty]
                //sprintf(#b, "a ===>    0:%d   //", res[ubx_ty]); mSL_log(SysLogBox, #b);
                //----
                // First insert direct references
                ptb = res + ubx_isiz; // where to copy / create the boxes descriptions
                pts = argv + 1; // local sources
                lct = cnt; // local count
                pta = res; // current ancestor : the module we are creating
                while ((chk) && (ptb < res_end)) (
                    // Create a local box from current src
                    while ((chk) && (lct > 0)) (
                        ds = pts[0];
                        // this must be a correct reference
                        (chk = (mSL_bl_check(ds) && ((ds[-2] & 0xffffff) === 'box'))) ? (
                            // indicate first descendant
                            (pta[ubx_1st] === 0) ? (pta[ubx_1st] = ptb - res;);
                            lct -= 1;
                            // insert the source
                            //----
                            ptb[ubx_ty] = ds[ubx_ty];
                            ptb[ubx_flgs] = ds[ubx_flgs];
                            ptb[ubx_mref] = ds;
                            ptb[ubx_anc] = pta - res;
                            //----
                            ptb[ubx_lcnt] = ds[ubx_lcnt];
                            ptb[ubx_icnt] = ds[ubx_icnt];;
                            ptb[ubx_1st] = 0;
                            ptb[ubx_tcnt] = ds[ubx_tcnt];
                            //----
                            ptb[ubx_t] = ds[ubx_t];
                            ptb[ubx_l] = ds[ubx_l];
                            ptb[ubx_w] = ds[ubx_w];
                            ptb[ubx_h] = ds[ubx_h];
                            //----
                            ptb[ubx_minw] = ds[ubx_minw];
                            ptb[ubx_maxw] = ds[ubx_maxw];
                            //----
                            pts += 1; // next source
                            ptb += ubx_isiz; // where we will copy it
                        );
                    );
                    (chk && (ptb < res_end) && (lct <= 0)) ? (
                        // skip to next set source
                        pta = pta + ubx_isiz; // new ancestor
                        ref = pta[ubx_mref]; // just recheck
                        (chk = (mSL_bl_check(ref))) ? (
                            lct = ref[ubx_lcnt]; // number of direct references to include
                            pts = ref + ubx_isiz; // point to this box references
                        );
                    );
                );
                // sprintf(#b, "b ===>    0:%d   //", res[ubx_ty]); mSL_log(SysLogBox, #b);
            );
            (!chk) ? (
                res = Undef;
            );
        ) :
        (kw === mSL_KW_delete) ? (
            (npar === mSL_KW_modules) ? (
                deleteUsrMods(); // delete all, then
                mkModuleMenu();// rebuild the menu
            ) :
            (npar === mSL_KW_sliders) ? (
                i = p_ActSize;
                while (i < paramCount) (
                    parRemove(i);
                    i += 1;
                );
                menu_Param_mSL = 0;
                menu_Param_UBS = 0;
                menu_Param_UBD = 0;
                parDclMode = 0;
                dclAllParameters();
            );
        );
    );
    res;
);//mSL_gui_ops


// Insert here the mSL interpreter
<? include("GM-Libs/mSL_Evaluator.jsfx-inc"); ?>


TabAddrMax = mSL_StM_FreePt; // max. address recognized for an array
SharedHighMemory = lastmemory = make_array(2); // last use of the function
// End of the static allocations : from now on, make_array is refused (as in the other applications) ;
// mSL_Dyn_Alloc does not depend on this mode (it uses the dynamic memory created by mSL_make_memory)
current_Memory_Mode = mSL_MMd_Dynamic;  // change allocation mode



// Initial memory check
mSL_StM_Check(0);



Last_in_memory_alloc = mSL_StM_FreePt;
Free_Memory = __memtop() - mSL_StM_FreePt;
str_mess = "Interstys started";

mSL_log(SysLogBox, "*** Interstys started ***");
sprintf(#itm, "Memory : dynamic %.2f MW, free after the static allocations %.2f MW (top %.2f MW)",
    C_memrSize / 1048576, Free_Memory / 1048576, __memtop() / 1048576);
mSL_log(SysLogBox, #itm);

// the native JSFX sliders are hidden at start (key 'S' shows them)
(!gui_show_sliders) ? mod_sliders(0);

@slider

update_sliders();



@serialize


doingLoad = doingSave = 0;
handling_load = perform_loading = 0;
loadMode = file_avail(0) >= 0;


loadMode ? (


    // ===LOAD===

    doingLoad = 1;
    handling_load = 1;
    lditmc = 0; ldstud = 0; ldtnam = -1; // count of tabs names read (-1 : none in this preset)
    ldtotal = 0;
    lderr = 0;
    memset(DuplWA, 0, StaticWASize); // clean the load area pointer
    // First, load the block
    slz1 = load_mem(0, lodarea, SVASIZ);
    ldtotal += slz1;
    ldok = (lodarea[0] == savcode) && (lodarea[SVASIZ-1] == savcode);
    while (ldok && (file_avail(0) > 0)) (
        slz2 = load_mem(0, savtmp, TMPSIZ);
        ldtotal += slz2;
        (savtmp[0] === 'stwa') ? (
            si = savtmp[1];
            sbty = savtmp[2];
            sbsz = savtmp[3];
            ((si < 0) || (si >= StaticWASize)) ? (
                ldok = 0;
                lderr = 180
            ) : (
                // Create a memory area for the block
                sbl = mSL_Dyn_Alloc(sbsz, sbty, 0); // allocate memory
                (sbl === 0) ? (
                    ldok = 0; // can't allocate
                    lderr = 170;
                ) : (
                    rdsz = load_mem(0, sbl, sbsz); // Read the block
                    ldtotal += rdsz;
                    (rdsz !== sbsz) ? (
                        ldok = 0;
                        lderr = 160;
                    ) :
                    (check_its_block(sbl)) ? (
                        ldok = 0;
                        lderr = 156;
                    ) : (
                        DuplWA[si] = sbl;
                        lditmc += 1;
                    );
                );
            );
        ) :
        (savtmp[0] === 'stud') ? (
            // studio : tabs config (Pr7_*) and modules shown in each pane
            ((savtmp[1] <= 128) && (savtmp[2] <= dcbBSize)) ? (
                ldtotal += load_mem(0, serialBlock, savtmp[1]);
                ldtotal += load_mem(0, dcbBlocksAll, savtmp[2]);
                ldstud = 1;
                ui_jstyle = (serialBlock[Pr7_UiStyle] != 0); // look of the GUI
                uix_jtheme = max(0, min(uix_jtheme_rtc_max - 1, 0|serialBlock[Pr7_UiTheme])); // theme of the GUI
            ) : (
                ldok = 0;
                lderr = 140; // studio block too large
            );
        ) :
        (savtmp[0] === 'disp') ? (
            // display blocks of the modules (absent from the older presets : the modules then show the objects 1)
            si = min(savtmp[1], DispStructsSize); // another size (other version) : read up to the smallest one
            ldtotal += load_mem(0, ReadersStructA, si);
            loop(2 * (savtmp[1] - si), file_var(0, zzz_dskip)); // each value is saved in 2 words (see save_mem)
            // the numbers of the objects shown must stay in their sets
            si = 0; loop(8,
                sp = ReadersStructA + si * ReadersBlockSize; sp[0] = max(0, min(RD_CNT - 1, 0|sp[0]));
                sp = LinesStructA + si * LinesBlockSize; sp[0] = max(0, min(LN_CNT - 1, 0|sp[0]));
                sp = WriterStructA + si * WriterBlockSize; sp[0] = max(0, min(WR_CNT - 1, 0|sp[0]));
                si += 1;
            );
            si = 0; loop(10,
                sp = EffectsStructA + si * LinesBlockSize; sp[0] = max(0, min(FX_CNT - 1, 0|sp[0]));
                si += 1;
            );
        ) :
        (savtmp[0] === 'tnam') ? (
            ldtnam = savtmp[1]; // alternate tabs names (see "Rename tab...")
            si = 0; loop(savtmp[1],
                (si < dcbTabsCount) ? file_string(0, altTabsNames[si]) : file_string(0, #tnam_skip);
                si += 1;
            );
        ) :
        (
            zzz_savtmp = savtmp[0];
            zzz_sastwa = 'stwa';
            zzz_sequal = zzz_savtmp == zzz_sastwa;
            ldok = 0;
            lderr = 150;
        );

    );
    (
        // load is ok
        str_mess = str_mess_slot(); // a string in [16 .. 32]
        sprintf(str_mess, "Load (%d / %d), %d items, %d tab names, studio %d.", ldok, lderr, lditmc, ldtnam, ldstud);
    );

    (lderr === 0) ? (
        perform_loading = 1;
        handling_load = 1;
    );


) : (

    //  ===SAVE===

    doingSave = 1;
    svitmc = 0;
    sverr = 0;
    svtotal = 0;
    build_savarea();
    siz1 = save_mem(0, savarea, SVASIZ);
    svtotal += siz1;
    // Save the alternate tabs names (see "Rename tab...") : first, before the blocks
    savtmp[0] = 'tnam'; savtmp[1] = dcbTabsCount; savtmp[2] = savtmp[3] = 0;
    svtotal += save_mem(0, savtmp, TMPSIZ);
    si = 0; loop(dcbTabsCount, file_string(0, altTabsNames[si]); si += 1;);
    // Save the studio : tabs config (Pr7_* : panes count and widths, live display) and modules of each pane
    savtmp[0] = 'stud'; savtmp[1] = 128; savtmp[2] = dcbBSize; savtmp[3] = 0;
    svtotal += save_mem(0, savtmp, TMPSIZ);
    svtotal += save_mem(0, serialBlock, 128);
    svtotal += save_mem(0, dcbBlocksAll, dcbBSize);
    // Save the display blocks of the modules (reader, line, writer, effect shown in "Reader A", ...)
    savtmp[0] = 'disp'; savtmp[1] = DispStructsSize; savtmp[2] = savtmp[3] = 0;
    svtotal += save_mem(0, savtmp, TMPSIZ);
    svtotal += save_mem(0, ReadersStructA, DispStructsSize);

    // siz4 = 0;
    // Save all objects, except lines set pointers and contents
    si = 0; loop(PtrsInWA,
        (((sbl = StaticWA[si]) > BASE_MEMORY) && (mSL_bl_check(sbl))) ? (
            // A block to save
            savtmp[0] = 'stwa'; // the type of save
            savtmp[1] = si; // the entry in the area
            savtmp[2] = sbl[-2]; // the type of the block to be recreated
            savtmp[3] = sbsz = sbl[-1]; // the length of the block
            siz2 = save_mem(0, savtmp, TMPSIZ);
            siz3 = save_mem(0, sbl, sbsz);
            svtotal += siz2 + siz3;
            svitmc += 1;
        );
        si += 1;
    );

    (
        // load is ok
        str_mess = str_mess_slot(); // a string in [16 .. 32]
        sprintf(str_mess, "Save (%d / %d), %d items; %d words, %d tab names.", ldok, sverr, svitmc,svtotal, dcbTabsCount);
    );
);


doingLoad = doingSave = 0;







@block
gm_time_keep(); // shared gmem time fields, if nobody keeps them (see mSL_clip_lib)
chcnt = num_ch;

// We achieve preset loading here to avoid conflicts with readers/writers
(perform_loading !== 0) ? (
    perform_loading = 0;
    recreate_structures(); // also update tables
    load_loadarea();
    // force sliders update
    lnupdt = slupdt = wrupdt = rdupdt = fxupdt = 1;
    handling_load = 0;
);

dbg_show_2(Readers_set[0],67);


// Count Solo Readers
i = j = 0;
loop(RD_CNT,
    ((r = Readers_set[i]) !== 0)  ? (
        (r[its_Rdr_StFlgs] & its_RdrFlg_solo) ? j += 1;
        (r[its_Rdr_StFlgs] & its_RdrFlg_Mod) ? Rd_Update(i);
    );
    i += 1;
);
its_RdrSolos = j; // count of readers in solo mode

// Check users modules every minute (as in GamePlayer)
((0|(time() / 60)) !== usrModMn) ? (
    usrModMn = 0|(time() / 60);
    checkUsrMods();
);

// EVERY SECOND (as in Diffusion-3 / GamePlayer) : processes counting and mSL lock management
((0|time()) !== mslSecond) ? (
    mslSecond = 0|time();
    // Manage process counting (shown in the Scripts pad and the Processes Manager)
    mSL_act = count_p_list(SchedActivPts) + (mSL_active_Thread > 0);
    mSL_wait = count_p_list(SchedDlydPts) + count_p_list(SchedEvntPts);
    mSL_plck = count_p_list(SchedSuspPts) + count_p_list(SchedLockdPts);
    mSL_pmsg = count_p_list(SchedRcyclPts);
    mSL_inactv = SchedListSize(SchedFreePts);
    mSL_maxact = max(mSL_maxact, mSL_act);

    // Release a lock left for too long (unless all processes are locked after an error)
    ((mSL_Lock != 0) && (mSL_loc_tim <= 0) && (SchedLockAll === 0)) ? (
        mSL_Lock < 0 ? mSL_Lock = - mSL_Lock;
        atomic_add(mSL_loc_tim,20); // "gfx" ticks, so about 2"
        atomic_set(mSL_Lock,  max(0, mSL_Lock - 1));
    );

    // The compiler could not get memory : run a GC
    mSL_malloc_failed ? (
        atomic_add(mSL_Lock,1);
        atomic_add(mSL_loc_tim,10);
        gc_run_phaz = 1;
        mSL_malloc_failed = 0; // unset flag
    );

    // Restart the locked processes, one per second (Scripts pad, after an error)
    (Schedrestart1 && (SchedLockAll === 0)) ? (
        (SchedListNonEmpty(SchedEvntPts)) ? (
            xgent = SchedDetachHead(SchedEvntPts);
            SchedInsertTail(SchedLockdPts, xgent, SchETypeThrd);
            mSL_log(SysLogBox, "SchedEvntPts  ——> SchedLockdPts");
        ) :
        (SchedListNonEmpty(SchedSuspPts)) ? (
            xgent = SchedDetachHead(SchedSuspPts);
            SchedInsertTail(SchedLockdPts, xgent, SchETypeThrd);
            mSL_log(SysLogBox, "SchedSuspPts  ——> SchedLockdPts");
        ) ;
        Schedrestart1 = 0;
    );

    // Files still waiting to be compiled
    (uuuMslFn != 0) ? (
        atomic_set(mSL_Lock, max(1,atomic_get(mSL_Lock)));
    );
);


@sample

(pgmode < 2) ? (
    // Phase 1 --
    // reset all temporaries tables
    memset(smpl_tab, 0, TEMP_SIZE);
    // get input samples ;
    i = 0; j = smpl_tab + SPL_P; loop (chcnt,
        j[0] = vol_inp * spl(i);
        spl(i) = 0;
        i += 1; j += 1;
    );

    // Phase 2 -- Pre READERS Effects
    fxn = 0; loop(FX_CNT,
        (((fx = Effects_set[fxn]) != 0) && (fx[its_Efx_Status] != 0)
            && (fx[its_Efx_Phase] === its_Efx_PhasePre)) ? (
            exec_fx(fx, fxn);
        );
        fxn += 1;
    );

    // Phase 3 -- Run READERS
    rdn = 0; loop(RD_CNT,
        (((X_rd = Readers_set[rdn]) !== 0) && (X_rd[its_Rdr_Flgs] !== 0) && (X_rd[its_Rdr_Status] === its_RdrStat_Reading)) ? (
            Trace_X_exec_reader = X_rd;
            exec_reader(X_rd, rdn);
        );
        rdn += 1;
    );

Trace_D_Readers_addr_0 = X_rdz = Readers_set[0];
Trace_D_Readers_flg_0 = X_rdz[its_Rdr_Flgs];
Trace_D_Readers_stat_0 = X_rdz[its_Rdr_Status];

    // Phase 4 -- Run Standard effects
    fxn = 0; loop(FX_CNT,
        (((fx = Effects_set[fxn]) != 0) && (fx[its_Efx_Status] != 0)
            && (fx[its_Efx_Phase] === its_Efx_PhaseStd)) ? (
            exec_fx(fx, fxn);
        );
        fxn += 1;
    );

    // Phase 5 -- Run Writers
    wrn = 0; loop(WR_CNT,
        (((X_wr = Writers_set[wrn]) != 0) && (X_wr[its_Wrt_Flgs] != 0) && (X_wr[its_Wrt_Status] == its_WrtStat_Writing)) ? (
            Trace_X_exec_writer = X_wr;
            exec_writer(X_wr, wrn);
        );
        wrn += 1;
    );

Trace_D_Writers_addr_0 = X_wr = Writers_set[0];
Trace_D_writers_flg_0 = X_wr[its_Wrt_Flgs];
Trace_D_writers_stat_0 = X_wr[its_Wrt_Status];
Trace_D_writers_count_0 += 1;

    // Phase 6 -- Post Writers Effects
    fxn = 0; loop(FX_CNT,
        (((fx = Effects_set[fxn]) != 0) && (fx[its_Efx_Status] != 0)
            && (fx[its_Efx_Phase] === its_Efx_PhasePost)) ? (
            exec_fx(fx, fxn);
        );
        fxn += 1;
    );

    // generate output samples
    i = 0; j = smpl_tab + OUT_P; loop (chcnt, spl(i) += vol_out * j[0]; i += 1; j+= 1;);

);

Trace_X_sample_count += 1;



// Trace a few work area
<? i=0; loop(8, printf("work%02d = smpl_tab[%d];", i, i); i+=1;); ?>





@gfx

function xBlack() (gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 1.0;);

gfxStartTime = time_precise();
gfxWStat = gfx_getchar(65536);
zz_graphic_exec += 1;

// Minimalist work
gfx_clear = 0xeeeeee; // light grey background color identical to sliders background

ctime = time();
(prvtime != ctime) ? (
    prvtime = ctime;
    disptime = (prvtime % 30) === 0;
    mcp_indic = max(0, mcp_indic-1);
    speedchanged = max(0, speedchanged-1);

    // slupdt = 1;
);

// gfxMaxDur = 0.01; // 10 ms
gfxStrtT = time_precise() + timeD;


// The tab commands : the keys left by the modules of the tab (see mSL_ui_LibJJ, Keyboard)
// (none in Interstys)
function do_Generic_Commands()
(
    AAAA_uix_jmbsel = uix_jmbsel;
);

function do_GenericTabStart() local(studio_pad_active)
(
    ui_jmouse_cap |= mouse_cap;
    studio_pad_active = 0;
);

function do_GenericTabEnd()
(
    do_Generic_Commands(); // after the modules
);



1 ? (
    (strlen(#dbg_trace0) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace0);
        #dbg_trace0 = "";
    );
    (strlen(#dbg_trace1) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace1);
        #dbg_trace1 = "";
    );
    (strlen(#dbg_trace2) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace2);
        #dbg_trace2 = "";
    );
    (strlen(#dbg_trace3) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace3);
        #dbg_trace3 = "";
    );
    (strlen(#dbg_trace4) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace4);
        #dbg_trace4 = "";
    );
    (strlen(#dbg_trace5) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace5);
        #dbg_trace5 = "";
    );
    (strlen(#dbg_trace6) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace6);
        #dbg_trace6 = "";
    );
    (strlen(#dbg_trace7) != 0) ? (
        mSL_log(SysLogBox, #dbg_trace7);
        #dbg_trace7 = "";
    );
);

mcp = mouse_cap;
(mcp & 2) ? (
    mcp_indic = 20; // right clic in the graphic area
);

// The commands of Interstys : the keys left by the tabs, at the end of the frame (then do_System_Keys)
// (capitals for the displays, see mSL_ui_LibJJ, Keyboard)
function do_Plugin_Keys()
(
    GM_key_take('U') ? (
        gui_show_UI = gui_show_UI ? 0 : 1;
    ) :
    GM_key_take('S') ? (
        (gui_show_sliders = gui_show_sliders ? 0 : 1) ? (
            slupdt = wrupdt = rdupdt = fxupdt = lnupdt = forceupdt = 1;
        ) : (
            slupdt = wrupdt = rdupdt = fxupdt = lnupdt = forceupdt = 0;
            mod_sliders(0);
        );
    ) :
    GM_Tab_Keys(); // Tab, Shift + Tab : next, previous tabulation (see ui-lib-JJ-GUI)
);


(speedchanged && mcp_indic && (speedchanged < 2)) ? (
       Currreader[its_Rdr_Speed] = slRSpeedPrv = slRSpeed = floor(0.5 + 2 * slRSpeed)/2;
       Currreader[its_Rdr_AbsInc] = Currreader[its_Rdr_Speed];
       Currreader[its_Rdr_Abspos] = floor(0.5 + Currreader[its_Rdr_Abspos]);
       sliderchange(slRSpeed);
       speedchanged = 0;
);


(str_mess !== 0) ? (
    mSL_log(SysLogBox, str_mess);
    str_mess = 0;
);



efi = 1; idx = efs = 0;
while (efi) (
  (efi = gfx_getdropfile(idx, #s)) ? (
    msx = mouse_x; msy = mouse_y; msc = mouse_cap;
    efs = mSL_Str_Tmp();
    strcpy(efs, #s);

    (match ("*.mSL", efs)) ? (
        //sprintf(#s, "*  Compile: %s  (%d)  *", efs, strlen(#efs)); mSL_log(SysLogBox, #s);
        doMslCompile(efs); // add to compile list
    ) :
    (match ("*wav", efs) || match ("*aif", efs) || match ("*flac", efs) || match ("*mp3", efs) || match ("*aiff", efs) || match ("*ogg", efs) || match ("*wmv", efs)) ? (
        strcpy(#efs, efs); // save in #efs
        dpa = 1; // an audio file is available
        /*
        sprintf(#s, "::drop file : \"%s\" - %d, %d, %d", efs, msx, msy, msc);
        mSL_log(SysLogBox, #s);
        */
    ) : (
        sprintf(#s, "::unknown file type : \"%s\"", efs);
        mSL_log(SysLogBox, #s);
    );
    ui_GFXdoNow |= 1; // Make sure we react as soon as possible
    idx += 1;
  );
);

(idx != 0) ? gfx_getdropfile(-1);



mSL_loc_tim = max(mSL_loc_tim - 1, 0);

(atomic_get(mSL_Lock) && (mSL_loc_tim <= 0))? (
    // we may have a GC to run
    (gc_run_phaz != 0) ? (
        (gc_run_phaz === 1) ? (
            gc_count += 1;
            (mSL_Dyn_Tr & 4) ? ( sprintf(#gfxu, "Starting a GC [free:%d  used:%d] ", mm_show_ttf, mm_show_ttu); mSL_log(SysLogBox, #gfxu); );
            mSL_loc_tim = max(2, mSL_loc_tim + 2); // no GC for some time
            // Perform a GC
            mSL_gc_start = time_precise() + timeD;
            mSL_errX = mSL_errC = mSL_errM = 0;
            gc_start();
            gc_release_unused_thread();
            gc_mark_active();
            gc_mark(0); // make sure the last blocks have been checked
            // execute the sweep phase
            gc_sweep();
            mSL_Str_sweep_strings(0); // clear the strings marks, age the temporary strings
            gc_run_phaz = 3; // This is over
            mSL_gc_end = time_precise() + timeD;
            mSL_errX = max(mSL_errX, max(mSL_errC, mSL_errM));
            ((FlagsTbVals[Flgs_GC] & 1) && mSL_errX) ? (
                sprintf(#gfxu, "GC Err: %d - Dur %.2f ms", mSL_errX,
                        1000 * (mSL_gc_end - mSL_gc_start));
                mSL_log(SysLogBox, #gfxu);
            );
            mSL_gc_MaxDur = max(mSL_gc_end - mSL_gc_start, mSL_gc_MaxDur);
        );
    ) :
    (
        // If we have a func to compile, do it A.S.A.P.
        (uuuMslFn != 0) ? (
            // Do we have enough memory to run a compilation ?
            !((gc_run_phaz > 1) || (mm_bl_huge > 0) || (mm_bl_big > 0) || (mm_bl_large >= 4) || (mm_bl_medium >= 64)) ? (
                // we may need a GC
                gc_run_phaz = 1; // start it
            ) : (
                ((mSL_active_Thread <= 0) && (uuuMslFent === 0)) ? (
                    // We are sure there are no active mSL thread...
                    // or compiler structure used
                    // and none can be started yet...
                    // look for a file to compile
                    uuuMslFname = 0;
                    ig = 0; while ((uuuMslFname === 0) && (ig < uuuMslTSiz)) (
                        (uuuMslFname = uuuMslTabs[ig]) ? (
                            uuuMslTabs[ig] = 0;
                        );
                        ig += 1;
                    );
                    (uuuMslFname === 0) ? ( // no file found to compile
                        uuuMslTPt = uuuMslFent = uuuMslFn = 0; // reset indicators
                    ) : (
                        uuuMslFent = mSL_load_file_inGFX(uuuMslFname);
                        (uuuMslFent === 0) ? doMslCompileDone(); // compilation failed : go on with the other files
                    );
                );
                mSL_loc_tim += 2; // again save some time
            );
        );


        // Do we have an mSL file loaded and compiled, ready to execute ?
        (uuuMslFent != 0) ? (
            (FlagsTbVals[Flgs_Scripts] & 1) ? (
                (mSL_errX === 0) ? (
                    // ready to introduce in the queue
                    sprintf(#s, "Loaded %s", uuuMslFname);
                ) : (
                    sprintf(#s, "File %s: err %d", uuuMslFname, mSL_errX);
                );
                mSL_log(SysLogBox, #s);
            );
            uuuMslFent = 0;
            uuuMslLastFname = uuuMslFname;
            uuuMslFname = 0;
            doMslCompileDone(); // free the compiler's structures; release the lock if no other file is waiting
        );
    );

);




// Have we just achieved a GC ?
(gc_run_phaz > 2) ? (
    // gc is over
    gc_run_phaz = 0;
    mem_walk(0);
    (mSL_Dyn_Tr & 4) ? ( mem_show(); );
    FlagsTbVals[Flgs_GC] = 0;
    atomic_set(mSL_Lock,  max(0, mSL_Lock - 1));
);



//====== Scheduler management ======
while (ent = Scheduler()) (
    AAAA_Sch_code = code = SchedCode[ent];
    AAAA_Sch_par1 = par1 = SchedPar1[ent];
    AAAA_Sch_par2 = par2 = SchedPar2[ent];
    AAAA_Sch_par3 = par3 = SchedPar3[ent];
    AAAA_Sch_par3 = par4 = SchedPar4[ent];

    // do some work...

    (code & SchedWBit) ? (
        SchedCode[ent] &= SchedWBMask ; // suppress wait bit
        SchedInsertTail(SchedActivPts, ent, SchETypeThrd);
        ent = 0;
    ) :
    (code === 1) ? (
        // A defered action to perform
        (par1 === 'task') ? (
            // introduce this task in active list
            // par2 can be an entry number (in 1... 4096) or an entry address
            zact = par2;
            ((par2 > 0) && (par2 < SchedNEmax)) ? (
                zact = SchedFirstEnt + SchedEntSiz * par2;
            );
            ((zact >= SchedFirstEnt) && (zact <= SchedLastEnt)) ? (
                // This refers to an entry to execute
                SchedInsertTail(SchedActivPts, zact, SchETypeThrd);
            );
            SchedPar2[ent] = 0; // ok
        ) :
        (par1 === 'smsg') ? (
            // send a message to some task.
            // par2 is supposed to be a message - this is checked by event_send_msg
            (SchETypeMess === mSL_Mbl_check(par2)) ? (
                SchevDateSent[par2] = 0; // clear send date
                event_send_msg(par2);
            );
            SchedPar2[ent] = 0; // message has been transmitted
        );
    ) :
    (code === 8) ? (
        // Run entry "0" of tasks
        k = 0; // should refer to a compiled code
        mSL_errX = 0;
        ((mSL_bl_check(k, Undef, 9793) === 0) && (k[mSL_CC_Key] === mSL_CC_KeyCKod)) ? (
            // try to execute the gizmo
            (ent = getNewThread()) ? (
                SchedPar1[ent] = k; // keep the code to execute
                SchedPar4[ent] = 0; // use current own variables
                SchedCode[ent] = KRun_mSL_Thread; // ready to start running a thread
                mSL_init_thread(ent);
            ) : (
                err_sys_rtm = 9606;
            );
            (mSL_errX === 0) ? (
                SchedInsertTail(SchedActivPts, ent, SchETypeThrd);
                ent = 0;
            ) : (
                sprintf(#u, "Code 8: Ent: %d - Err: %04d", ent, mSL_errX);
                mSL_log(SysLogBox, #u);
                // ADump(k);
            );
        );
    ) :
    (code === 9) ? (
        // execute a delayed list of "simple actions"
        Simple_Action(par1);
    ) :
    (code === KRun_mSL_Thread)? ( // 10
        // A delayed mSL Thread
        // reintroduce the thread in the queue
        SchedInsertTail(SchedActivPts, ent, SchETypeThrd);

        // GMW2("E"); // *DBG*
        ent = 0;
    );
    // possibly free the entry
    ent ? SchedFree(ent); // appropriate free operation
);


// Unlock all waiting processes after a "load" or a "gc"
while (SchedListNonEmpty(SchedLockdPts) && (atomic_get(mSL_Lock) === 0)) (
    SchX = SchedDetachHead(SchedLockdPts);
    SchedInsertTail(SchedActivPts, SchX, SchETypeThrd);
);



XeSched = 1; // set to 1 to make sure we execute at least 1 task during each @block execution
//============ GLOBAL Interpreter ==============
while (SchedActive &&
    ((((TLeft = gfxMaxDur + gfxStrtT - (gstrt = time_precise() + timeD)) > 0)) || XeSched) &&
    ((SchX = SchedDetachHead(SchedActivPts)) != SchedNone))
(
    // Get some parameters
    // Execute the action
    XeSched = 0;
    xop = SchedCode[SchX];   // actually, only 1 to 13 are being used
    curr_Proc_PID = SchedPid[SchX]; // current process ident
    curr_Proc_Name = SchedThrName[SchX]; // current process name
    mSL_xop_cnt = (mSL_xop_cnt + 1) % 1000000;


    (xop === 10) ? (
        //++++10++++//
        //====== mSL EXECUTION ======
        // mSL_errX=10;
        mSL_dispatch_entry = SchX;
        atomic_get(mSL_Lock) ? (
            // We are doing some exclusive operation. mSL Threads are not allowed to execute
            SchedInsertTail(SchedLockdPts, SchX, SchETypeThrd); // insert the thread in locked pts
            SchX = -1;
        ) : (
            tstrt = time_precise() + timeD;
            mSL_active_Thread = SchedThrdPt[SchX]; // the thread
            ((SchedStatus[mSL_dispatch_entry] & SchmSLThrUsed) != SchmSLThrUsed) ? (
                (mSL_errX === 0) ? mSL_errX = 3381; // thread not noted active ?
            );
            mSL_load_thread(mSL_active_Thread);
            mSL_max_TOS = mSL_active_Thread[mSL_THR_basePhStack];

            (mSL_errX != 0) ? (
                thread_error(mSL_active_Thread, mSL_errX, SchX);
            ) : (
                mm_xec_mm[mm_xec_ptr] -=  mSL_ICount;
                mm_cyc_mm[mm_cyc_ptr] -=  mSL_ICount;
                // Curr_Block_Alloc
                AAAAAAAA_mSL_rpeat = mSL_rpeat = max(8192, min(16384, 0|(mSL_insts_per_s * TLeft * 0.35)));
                mSL_evaluate();

                //GMW2("A2");
                AAAAAAAA_mSL_evaluate_count += 1;
                mSL_High_Stack = max(mSL_High_Stack, mSL_max_TOS - mSL_active_Thread[mSL_THR_basePhStack]);
                // sprintf(#uuu, "End of evaluation - CR: %d - XC: %d", mSL_CodeStop, AAAAAAAA_mSL_evaluate_count);
                // mSL_log(SysLogBox, #uuu);
                // GMW2("B");
                mSL_save_thread(mSL_active_Thread);
                ((mSL_CodeStop === 0) || (mSL_CodeStop === mSL_RC_Yield)) ? (
                    // reintroduce the thread in the queue
                    SchedInsertTail(SchedActivPts, SchX, SchETypeThrd);
                    SchX = -1;
                ) :
                (mSL_CodeStop === mSL_RC_Wait) ? (
                    (mSL_WaitDuration > 0) ? (
                        // introduce the entry in the wait queue
                        Schedule(SchedRelative, mSL_WaitDuration, 0, SchX, 0, 0, 0);
                    ) : (
                        // reintroduce the thread in the queue
                        SchedInsertTail(SchedActivPts, SchX, SchETypeThrd);
                    );
                    SchX = -1;
                ) :
                (mSL_CodeStop === mSL_RC_Stop) ? (
                    // finished, free the thread
                    //
                    freeSchedThread(SchX);
                    // SchedStatus[SchX] &= SchThrNotUsed;
                    // SchedInsertTail(SchedInactPts, SchX, SchETypeThrd);
                    mSL_dispatch_entry = SchX = -1;
                    flagShowMemory = 1;
                ) :
                (mSL_CodeStop === mSL_RC_WEvent) ? (
                    // introduce the entry in the wait queue
                    SchedInsertTail(SchedEvntPts, SchX, SchETypeThrd);
                    (FlagsTbVals[Flgs_Thrds] & 2) ? ( // trace flags
                        sprintf(#s, "Insert in Evnt : ent: %d thrd: %d siz: %d ", SchX, mSL_active_Thread, SchedListSize(SchedEvntPts));
                        mSL_log(SysLogBox, #s);
                    );
                    AAAAA__Schx = Schx;
                    AAAAA__SchxNum = ent[SchedPid] & SchedNMask;
                    SchX = -1;
                ) :
                (mSL_CodeStop === mSL_RC_WAITGC) ? (
                    // introduce in the wait for GC list
                    SchedInsertTail(SchedLockdPts, SchX, SchETypeThrd);
                    SchX = -1;
                ) :
                (
                    //AAAAAAAA_Errx = mSL_errX;
                    thread_error(mSL_active_Thread, mSL_errX, mSL_CodeStop);
                    // SchedStatus[SchX] &= SchThrNotUsed;
                    // SchedInsertTail(SchedInactPts, SchX, SchETypeThrd);
                    // sprintf(#uuu, "End of evaluation [%d]  CR: %d  Err: %d", SchX, mSL_CodeStop, mSL_errX);
                    // (mSL_wbl != 0) ? ( sprintf(#uuu, "Block damaged @ %d", mSL_wbl);mSL_log(SysLogBox, #uuu); );
                    mSL_error_analysis(mSL_active_Thread);
                    SchedFree(SchX);
                    SchX = -1;
                    flagShowMemory = 1;
                    mSL_errC = 0; mSL_errX = 1717; // "error previously detected"
                    mSL_errX = 0; // let other threads progress
                );
                mm_xec_mm[mm_xec_ptr] += mSL_ICount;
                mm_cyc_mm[mm_cyc_ptr] += mSL_ICount;
            );
            mm_dur_mm[mm_cyc_ptr] += time_precise() + timeD - tstrt;
        );
        mSL_active_Thread = -1;

        //++++10++++//
    );



    SchX > 0 ? SchedFree(SchX);
);








(slupdt || wrupdt || rdupdt || fxupdt || lnupdt || forceupdt) ? (
    update_sliders();
    forceupdt = 0;
);

// A pad asked for too many cells (damaged pad ?) : see the guard in control_jpad (mSL_ui_Pads)
((ui_jpad_bad_cnt != ui_jpad_bad_seen) && (time() != ui_jpad_bad_t)) ? (
    ui_jpad_bad_seen = ui_jpad_bad_cnt; ui_jpad_bad_t = time(); // at most one message per second
    sprintf(#padbad, "PAD ANOMALY: pad %d asks %g lines x %g columns (pad_Reader %d, pad_Writer %d, pad_Effect %d, pad_Line %d)",
        ui_jpad_bad_pad, ui_jpad_bad_nl, ui_jpad_bad_nc, pad_Reader, pad_Writer, pad_Effect, pad_Line);
    mSL_log(SysLogBox, #padbad);
);


function keepBlockInfos(bCurrent)
local(i)
(
    blockDesc ? (
        // keep position
        i = 0; loop (dcbMSize - 1,
            (blockDesc[i] === bCurrent) ? (
                blockDesc[i+dcbMSize] = A99PBlock = (ui_top_retina()*10000)+ui_height_retina();
            );
            i += 1;
        );
    );
);

