//==========================================================
//===== LINES Handling
// Lines_Set[LN_CNT]

// A revoir
function Ln_Check(lnum)
local (lcbl)
(
    ((lnum >= 0) && (lnum <= LN_CNT) && ((lcbl = Lines_Set[lnum]) > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        (lcbl[its_Lin_Check] !== BLOCK_CHECK) ? (
            ((lcbl[its_Lin_Unuz1] === SECURE_BL) && (lcbl[its_Lin_Unuz1] === SECURE_BL)) ? (
                lcbl[its_Lin_Check] = BLOCK_CHECK;
            );
        );
        lcbl[its_Lin_Check];
    );
);

function Ln_Clear(lnum)
local (i, lcbl)
(
    ((lnum >= 0) && (lnum <= LN_CNT) && ((lcbl = Lines_Set[lnum]) > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        i = its_Lin_BF1ST; loop(lcbl[its_Lin_ChCnt],
            memset(lcbl[i], 0, lcbl[its_Lin_ActBSize]);
            l_cleared += lcbl[its_Lin_ActBSize];
            i += 1;
        );
    );
);


function Ln_New()
local (lnb, i)
(
    lnb = -1; i = 0;
    while ((i < LN_CNT) && (lnb < 0)) (
        (Lines_Set[i] === 0) ? (lnb = i);
        i += 1;
    );
    lnb;
);


function Ln_Make(lnum, freq, size, channels)
local (lcbl, buff, bsz, i, j, R, lng)
(
    // Create the buffer control bloc
    channels = max(1, min(128, 0|channels));
    // size is in seconds
    // freq is in Hz
    lng = max(48, min(67108864, ceil(size * freq)));
    lcbl = mSL_Dyn_Alloc(its_Lin_BlkSize, KW_lcbl, mSL_StM_FlClear);
    (lcbl > BASE_MEMORY) ? (
        lcbl[its_Lin_Unuz1] = SECURE_BL; // "Interstys buffer"
        lcbl[its_Lin_Status] = its_LinStat_Ready;
        lcbl[its_Lin_Flgs] = 1;
        lcbl[its_Lin_Numb] = lnum;
        lcbl[its_Lin_ChCnt] = channels;
        lcbl[its_Lin_SmplCnt] = lng;
        lcbl[its_Lin_RecFreq] = freq;
        lcbl[its_Lin_SmplCntSec] = floor(1000* lng/freq)/1000;
        lcbl[its_Lin_Start] = BF_LIM;
        lcbl[its_Lin_Last] = BF_LIM + lng;
        lcbl[its_Lin_Unuz2] = SECURE_BL;

        // Create the various buffers
        // lng is the expected size in samples, bsz is the size needed to represent the buffer
        lcbl[its_Lin_ActBSize] = bsz = lng + BF_LIM * 2;
        lcbl[its_Lin_Tmp2] = lcbl[its_Lin_RecFreq];
        i = its_Lin_BF1ST; R = j = 0;
        while (j < channels) (
            (((lcbl[i] = mSL_Dyn_Alloc(bsz, KW_buff, 0)) < BASE_MEMORY)) ? (
                R = 1; j = channels;
            );
            i += 1; j +=1;
        );
        (R === 0) ? (
            // Replace previous line if any
            (Lines_Set[lnum] > BASE_MEMORY) ? (mSL_Dyn_Free(Lines_Set[lnum]));
            Lines_Set[lnum] = lcbl;
            Ln_MemErr[lnum] = 0;
            Ln_Clear(lnum);
        ) : (
            // Can't create all buffers : free those already allocated
            i = its_Lin_BF1ST; loop(channels,
                (lcbl[i] > BASE_MEMORY) ? mSL_Dyn_Free(lcbl[i]);
                i += 1;
            );
            mSL_Dyn_Free(lcbl);
            lcbl = 0;
        );
    );
    (lcbl <= BASE_MEMORY) ? (
        Ln_MemErr[lnum] = 1; // shown in the pad of the line
        sprintf(#itm, "Error 2610 : line %d (%.3f s, %d chan., %.2f MW) : not enough memory (free %.2f MW)",
            lnum+1, size, channels, channels * (lng + BF_LIM * 2) / 1048576, mSL_Dyn_Dispo / 1048576);
        mSL_log(SysLogBox, #itm);
    );
    lcbl;
);

// delete buffer "lnum" from Lines_Set
function Ln_Delete(lnum)
local (lcbl, i, j, cb)
(
    ((lnum >= 0) && (lnum <= LN_CNT)) ? (
        (((lcbl = Lines_Set[lnum]) > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? ( // (was "lbcl =" : nothing was freed)
            // Check that the line is not used in any reader/writer
            i = 0; loop(RD_CNT+1,
                cb = Readers_set[i];
                ((cb !== 0) && (lcbl === cb[its_Rdr_Lcbl])) ? (
                    // stop reader
                cb[its_Rdr_Tmp4] = 210;
                cb[its_Rdr_Tmp5] = cb[its_Rdr_Status];
                cb[its_Rdr_Tmp6] = ts();
                    cb[its_Rdr_Status] = its_RdrStat_Created;
                    cb[its_Rdr_Check] = 0;
                    cb[its_Rdr_Lcbl] = 0;
                    cb[its_Rdr_LineNb] = -1;
                    rdupdt = 1;
                );
                i += 1;
            );
            i = 0; loop(WR_CNT+1,
                cb = Writers_set[i];
                ((cb !== 0) && (lcbl === cb[its_Wrt_Lcbl])) ? (
                    // stop writer
                    cb[its_Wrt_Flgs] &= -1 ~ (its_WrtFlg_init | 2);
                    cb[its_Wrt_Buff_1] = 0;
                    cb[its_Wrt_Status] = its_WrtStat_Created;
                    cb[its_Wrt_Check] = 0;
                    cb[its_Wrt_Lcbl] = 0;
                    cb[its_Wrt_LineNb] = -1;
                    wrupdt = 1;
                );
                i += 1;
            );
            i = 0; loop (128,
                j = lcbl[i+its_Lin_BF1ST];
                (j != 0) ? (mSL_Dyn_Free(j));
                i += 1;
            );
            mSL_Dyn_Free(lcbl);
            lnupdt = 1;
        );
        Lines_Set[lnum] = 0;
    );
);

function Ln_Action(lnb, act, tmp)
local (lcbl, err)
(
    err = 0;
    ((lnb < 0) || (lnb > LN_CNT)) ? (
        err = 2607; // bad line number
    ) :
    (((lcbl = Lines_Set[lnb]) < BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ? (
        (lcbl === 0) ? (
            (act === its_LinAct_Create) ? (
                // can create using tmp
                (Ln_Make(lnb, srate, tmp[1], tmp[2]) <= BASE_MEMORY) ? err = 2610; // not enough memory
            );
        ) : (
            err = 2608; // the entry of the line is not a valid line
        );
    ) :
    (act === its_LinAct_Clear) ? (
        Ln_Clear(lnb);
    ) :
    (act === its_LinAct_Delete) ? (
        Ln_Delete(lnb);
    ) :
    (
        err = 2609; // unknown action (or "Create" on an existing line)
    );
    (err != 0) ? (
        // (2610 : already written by Ln_Make)
        (err != 2610) ? (
            sprintf(#itm, "Error %04d : line %d, action %d (Lines_Set : %d)", err, lnb+1, act, Lines_Set[lnb]);
            mSL_log(SysLogBox, #itm);
        );
    );
    err;
);


// Ln_MemErr[line] : 1 when the last creation of the line failed for lack of memory, error 2610 (see Ln_Make, show_Line_Pad)
Ln_MemErr = make_array(LN_CNT+1);

// Pad for the Lines
pad_Lin_NL = 1;
pad_Lin_NC = 8;
pad_Lin_Siz = pad_Lin_NL * pad_Lin_NC;
pad_Line = make_jpad(
    ui_jpad_ty_act | ui_jpad_mk_labs | ui_jpad_mk_colors | ui_jpad_mk_values,
    pad_Lin_NL, pad_Lin_NC, pad_Lin_Siz);
pad_Lin_Labs = pad_Line + pad_Line[ui_jpad_labs]; // addresses of labels
pad_Lin_Colrs = pad_Line + pad_Line[ui_jpad_clrs]; // addresses of colors
pad_Lin_Cells = pad_Line + pad_Line[ui_jpad_cells]; // addresses of cells desc.
pad_Lin_Vals = pad_Line + pad_Line[ui_jpad_values]; // addresses of cells desc.
//
ii = 0; loop(pad_Lin_Siz,
            pad_Lin_Colrs[ii] = Col_Inactive;
            pad_Lin_Labs[ii] = "ZZZ";
            ii+=1;
);

// Menu 1 for LINES : their names, in sub-menus of 32 lines (the ">" headers are not counted in the results)
<? ln_grp = 32; ln_mnc = LN_CNT + (0|((LN_CNT + ln_grp - 1) / ln_grp)); ?>menu_Lin_Ids_N = make_array(<? printf("%d", ln_mnc); ?>);
<? i=0; j=0; loop(LN_CNT, (i % ln_grp) == 0 ? (printf("menu_Lin_Ids_N[%d] = \">Lines %d-%d\";", j, i+1, min(i+ln_grp, LN_CNT)); j += 1;); printf("menu_Lin_Ids_N[%d] = \"%sLine %d\";", j, (((i % ln_grp) == ln_grp-1) || (i == LN_CNT-1)) ? "<" : "", i+1); i += 1; j += 1;); ?>
menu_Lin_Ids = make_jmenu(
    ui_jmenu_typ_opt | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "line-num", <? printf("%d", ln_mnc); ?>, menu_Lin_Ids_N);
menu_Lin_Grp = <? printf("%d", ln_grp); ?>; // lines per sub-menu : the header of group g is item g * (menu_Lin_Grp + 1)


// Menu 2 for LINES : their names for selection
//    "None", a separator (an empty item, not counted), then the lines in sub-menus of menu_Lin_Grp lines
menu_Lin_SIds_N = make_array(<? printf("%d", ln_mnc + 2); ?>);
menu_Lin_SIds_N[0] = "None";
menu_Lin_SIds_N[1] = "";
<? i=0; j=2; loop(LN_CNT, (i % ln_grp) == 0 ? (printf("menu_Lin_SIds_N[%d] = \">Lines %d-%d\";", j, i+1, min(i+ln_grp, LN_CNT)); j += 1;); printf("menu_Lin_SIds_N[%d] = \"%sLine %d\";", j, (((i % ln_grp) == ln_grp-1) || (i == LN_CNT-1)) ? "<" : "", i+1); i += 1; j += 1;); ?>
menu_Lin_SIds = make_jmenu(
    ui_jmenu_typ_opt | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "line-names", <? printf("%d", ln_mnc + 2); ?>, menu_Lin_SIds_N);

// Menu 3 for LINES : the status
