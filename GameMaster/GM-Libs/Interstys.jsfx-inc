/*
    Phaser : a chain of "ns" allpass stages (trapezoidal : modulated without clics), the input "u", the frequency "f" (Hz), the
    factors of the frequencies of the stages "sf" (spacing ; all 1 : the coefficients of the first stage for all), their
    states "s" (2 per stage) ; "rs" : two pole stages (a state variable filter, its allpass x - 2 band / Q, kq = 1 / Q), else
    one pole stages (2 lp - x) ; returns the output of the chain
*/
function its_Ph_Chain(u, f, ns, sf, s, rs, kq)
local (k, one, fk, gg, cg, a1, a2, a3, v, v1, v2)
(
    one = (sf[0] === 1);
    k = 0;
    loop(ns,
        ((k === 0) || !one) ? (
            fk = max(5, min(0.45 * srate, f * sf[k]));
            gg = its_Tan_P($pi * fk / srate);
            rs ? ( a1 = 1 / (1 + gg * (gg + kq)); a2 = gg * a1; a3 = gg * a2; ) : ( cg = gg / (1 + gg); );
        );
