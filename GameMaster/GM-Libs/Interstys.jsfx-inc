        amp = its_Mod_Apply(mp, fx[its_Efx_Par1 + 2], its_ModA_Add, 1);
        rt = min(1, max(0, its_Mod_Apply(mp + its_ModDist, fx[its_Efx_MxX + 1], its_ModA_Oct, 1)) / srate);
        jt = max(0, min(1, its_Mod_Apply(mp + 2 * its_ModDist, fx[its_Efx_MxX + 4], its_ModA_Add, 1)));
        off = fx[its_Efx_Par1 + 3];
        cr = max(0, min(1, fx[its_Efx_Par1 + 4]));
        own = (fx[its_Efx_Par1 + 7] !== 0);
