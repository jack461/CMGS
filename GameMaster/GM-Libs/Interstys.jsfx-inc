function its_Tb_DumpMod(ty, k) local(b, i, md, ok)
(
    sprintf(#its_TbW, "%s %s", its_Tb_TyName(ty), its_Xp_Ref(#its_XpH, ty, k));
    ((b = its_Tb_Blk(ty, k)) === 0) ? (
        strcat(#its_TbW, " status Undefined");
    ) :
    (ty === its_TK_Writer) ? (
        its_Tb_Cat(ty, 2, b);
