    );
);

// the text of the value "v1" ... "v5" of the key "ki" (type "ty" ; mod : v3, v4 Undef if not given, v5 the flags of the law)
function its_Tb_ValText(str, ty, ki, v1, v2, v3, v4, v5)
(
    (ty === its_TK_Writer) ? (
        (ki === 0) ? ((v1 < 0) ? strcpy(str, "none") : its_Xp_Ref(str, its_TK_Line, v1)) :
        (ki === 1) ? its_Tb_SrcText(str, v1, v2) :
        (ki === 2) ? strcpy(str, menu_Wrt_Status_N[max(0, min(4, v1))]) :
        (ki === 5) ? strcpy(str, (v1 === its_WrtMode_WMix) ? "WMix" : (v1 === its_WrtMode_Sum) ? "Sum" : "XFade") :
        ((ki === 6) || (ki === 7)) ? sprintf(str, "%d", v1) :
        (ki === 13) ? strcpy(str, its_TbWDrN[max(0, min(its_WrtDirCnt - 1, 0|v1))]) :
        (ki >= its_TbWMod) ? its_Tb_ModText(str, its_TbWMIN[ki - its_TbWMod], v1, v2, v3, v4, v5) :
        sprintf(str, "%.10g", v1);
    ) : (
        ((v1 < 0) && ((ki === 0) || (ki === 1) || (ki === 33))) ? strcpy(str, "none") :
        (ki === 0) ? its_Xp_Ref(str, its_TK_Line, v1) :
        ((ki === 1) || (ki === 33)) ? its_Xp_Ref(str, its_TK_Writer, v1) :
        (ki === 4) ? strcpy(str, menu_Rdr_Status_N[(v1 > 4) ? 4 : max(0, v1)]) : // (stopping, starting : Reading)
        (ki === 5) ? ((v1 === 0) ? strcpy(str, "Own") : its_Tb_SrcText(str, v1, v2)) :
        ((ki === 7) || (ki === 8) || (ki === 12)) ? sprintf(str, "%d", v1) :
        (ki === 9) ? strcpy(str, menu_Rdr_Loop_N[max(0, min(5, v1))]) :
        ((ki === 13) || (ki === 38) || (ki === 39)) ? strcpy(str, v1 ? "On" : "Off") :
        (ki === 14) ? strcpy(str, its_TbRMdN[max(0, min(its_RdrModeCnt - 1, 0|v1))]) :
        (ki === 26) ? (((v1 >= 0) && (v1 < its_CrvMx)) ? its_Crv_TbName(str, v1) : strcpy(str, "none")) :
        (ki >= its_TbRMod) ? its_Tb_ModText(str, its_TbRMIN[ki - its_TbRMod], v1, v2, v3, v4, v5) :
        sprintf(str, "%.10g", v1);
