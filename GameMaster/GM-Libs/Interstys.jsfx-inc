        // the next one : the first whose dependencies are placed ; none : a loop, the first one not placed
        its_FxCycN = 0;
        k = 0; loop(m,
            best = -1; a = 0; while ((best < 0) && (a < m)) ( ((its_FxDone[a] === 0) && (its_FxDeg[a] === 0)) ? (best = a); a += 1; );
            (best < 0) ? (
                a = 0; while ((best < 0) && (a < m)) ( (its_FxDone[a] === 0) ? (best = a); a += 1; );
                its_FxCycN += 1;
            );
            its_FxDone[best] = 1;
            its_FxOrdNew[k] = its_FxLst[best];
