        Trace_X_its_Wrt_4_smpl = val;
        Trace_X_its_Wrt_5_A1 = smpl_tab[writer[its_Wrt_InCell] + 0];
        Trace_X_its_Wrt_5_A2 = smpl_tab[writer[its_Wrt_InCell] + 1];
        Trace_X_its_Wrt_5_C1 = k[lcbl[its_Lin_BF1ST]];
