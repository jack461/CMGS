            (ki === 3) ? ( its_Tb_v1 = its_Tb_Num(nm, -120, 40); ) :
            (ki === 4) ? ( its_Tb_v1 = its_Tb_Num(nm, -150, 150); ) :
            (ki === 5) ? ( its_Tb_v1 = its_Tb_Enum(nm, its_TbWMd, its_WrtModeCnt); ) :
            (ki === 6) ? ( its_Tb_v1 = its_Tb_Int(nm, 0, 127); ) :
            (ki === 7) ? ( its_Tb_v1 = its_Tb_Int(nm, 0, 128); ) :
            (ki === 8) ? ( its_Tb_v1 = its_Tb_Num(nm, 0.001, 10); ) :
