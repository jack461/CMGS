        ((its_Tb_error === 0) && its_TbKS[14]) ? (
            ((its_TbK1[14] === its_RdrMode_Delay) && its_TbKS[0]) ? (
                sprintf(#its_TbW, "Reader %d : mode Delay and a line (a delay follows a writer : the key writer)", k + 1);
                its_Tb_Err(2774, #its_TbW);
            ) :
            ((its_TbK1[14] !== its_RdrMode_Delay) && its_TbKS[1]) ? (
                sprintf(#its_TbW, "Reader %d : mode %s and a writer (the key writer gives the mode Delay)", k + 1,
                    its_TbRMdN[its_TbK1[14]]);
                its_Tb_Err(2774, #its_TbW);
            );
        );
