/*
    The modules executed by @sample : readers, writers, effects, and the specialised blocks "Clear", "Input", "Output".
    @sample runs the list its_RunX (addresses of blocks, ended by 0 ; see its_Run_Delay), in the order prepared by @gfx
    (its_Run_Schedule) : the active modules only. @gfx builds the next list in the work list its_RunWrk, then sets
    its_RunX to it and exchanges its_RunWrk and its_RunExe (the list executed). A module that stops, or that is deleted,
    gets the delay -1 (its_Run_Check, its_Run_Free) : @sample no longer executes it, until the next schedule leaves it out.
*/
its_RunSize = RD_CNT + WR_CNT + FX_CNT + 4; // (the 3 specialised blocks and the final 0)
its_RunExe = make_array(its_RunSize); // the list executed by @sample
its_RunWrk = make_array(its_RunSize); // the work list of @gfx
its_RunClr = make_array(its_Run_First); its_RunClr[its_Run_Kind] = its_RunK_Clear;
its_RunInp = make_array(its_Run_First); its_RunInp[its_Run_Kind] = its_RunK_Input;
its_RunOut = make_array(its_Run_First); its_RunOut[its_Run_Kind] = its_RunK_Output;
its_RunExe[0] = its_RunClr; its_RunExe[1] = its_RunInp; its_RunExe[2] = its_RunOut; // (until the first schedule)
its_RunX = its_RunExe;
its_RunPubN = 1; // count of the lists published
its_RunPubBlk = its_RunPubT = 0; // its_BlkCnt and time of the last one
its_RunTrW = 0; // 1 : a deleted block waits for a new list (see its_Run_TrashRun)
// the blocks deleted, freed by @gfx once @sample can no longer see them (its_Run_TrashRun)
its_RunTrSz = 2 * its_RunSize;
its_RunTrB = make_array(its_RunTrSz); // the block (0 : free entry)
mm_usr_prot[mm_usr_prot_ptr] = its_RunTrB; mm_usr_prot_ptr += 1; // (the garbage collector keeps them)
its_RunTrN = make_array(its_RunTrSz); // its_RunPubN when it was deleted (10^30 : being filled)
memset(its_RunTrN, 10^30, its_RunTrSz);
its_RunTrLost = 0; // trash full : blocks not freed (logged by @gfx)

// 1 : the module "b" is executed by @sample (the tests of the former loops of @sample)
function its_Run_Active(b)
local (k)
(
    k = b[its_Run_Kind];
    (k === its_RunK_Reader) ? ((b[its_Rdr_Flgs] !== 0) && (b[its_Rdr_Status] === its_RdrStat_Reading)) :
    (k === its_RunK_Writer) ? ((b[its_Wrt_Flgs] != 0) && (b[its_Wrt_Status] == its_WrtStat_Writing)) :
    (k === its_RunK_Effect) ? (b[its_Efx_Status] != 0) :
    0;
);

// the own cable of a module that no longer runs is silent (several readers of the cable may follow)
function its_Run_Silent(b)
local (k, n)
(
    k = b[its_Run_Kind]; n = b[its_Run_Num];
    ((k === its_RunK_Reader) && b[its_Rdr_OutDirty]) ? (
        (CblRdStart[n] > 0) ? memset(smpl_tab + CblRdStart[n], 0, CblRdWidth[n]);
        b[its_Rdr_OutDirty] = 0;
    ) :
    ((k === its_RunK_Effect) && b[its_Efx_OutDirty]) ? (
        (CblFxStart[n] > 0) ? memset(smpl_tab + CblFxStart[n], 0, CblFxWidth[n]);
        b[its_Efx_OutDirty] = 0;
    );
);

// a module no longer active (stopped, cleared...) : @sample does not execute it until the next schedule
function its_Run_Check(b)
(
    ((b > BASE_MEMORY) && (b[its_Run_Delay] >= 0) && (its_Run_Active(b) == 0)) ? (
        b[its_Run_Delay] = -1;
        its_Run_Silent(b);
    );
);

/*
    a module deleted (no longer in Readers_set, Writers_set, Effects_set) : never executed again, freed by @gfx (with the
    work areas of an effect) once the lists that may hold it are no longer used ; may be called by @block (load)
*/
function its_Run_Free(b)
local (i, ok)
(
    (b > BASE_MEMORY) ? (
        b[its_Run_Kind] = its_RunK_None;
        b[its_Run_Delay] = -1;
        ok = i = 0;
        while ((ok === 0) && (i < its_RunTrSz)) (
            (atomic_setifequal(its_RunTrB[i], 0, b) === 0) ? ( its_RunTrN[i] = its_RunPubN; ok = 1; ) : (i += 1);
        );
        (ok === 0) ? (its_RunTrLost += 1);
    );
);

// the specialised blocks : "Clear" (Out and the buses : several sources add into them), "Input", "Output"
function its_Run_Clear()
local (i, k)
(
    memset(smpl_tab + OUT_P, 0, CH_NB);
    i = 0; loop(BusActN, k = BusAct[i]; memset(smpl_tab + BusStart[k], 0, BusWidth[k]); i += 1;);
);
function its_Run_Input()
local (i, p)
(
    i = 0; p = smpl_tab + IN_P;
    loop(chcnt, p[0] = vol_inp * spl(i); spl(i) = 0; i += 1; p += 1;);
);
function its_Run_Output()
local (i, p)
(
    i = 0; p = smpl_tab + OUT_P;
    loop(chcnt, spl(i) += vol_out * p[0]; i += 1; p += 1;);
);

// the inputs of a reader meaningful in its mode : offset (delay mode), speed, loop speed and desync (reader and stretch modes),
// volume (all) ; in modes Stretch and Brage the speed (the read rate of the blocks) is taken at the start of each block
function its_Rdr_ModOk(rcbl)
(
    4 | 1 | ((rcbl[its_Rdr_Mode] === its_RdrMode_Delay) ? 0 : (2 | 8 | 16)); // (the offset : all the modes)
);

/*
    The module "Connections" : the use of the cells (the cables of the modular)
    its_Patch_Scan(-1) counts the writers (its_PchW) and the readers (its_PchR) of each cell, from the settings of the
    modules (On or Off), and the connections that are not valid (its_PchBad) ; its_Patch_Scan(cell) writes in #its_PchWs
    and #its_PchRs who writes and who reads the cells [cell, cell + its_PchCellW) (the text shown under the pad, for the
    cell under the mouse), and in its_PchLst... the menu of these modules (right clic) ; its_Patch_Scan(-2) computes the width asked for each bus (BusNeed, see its_Patch_Update)
    its_Pch_Use : the connection "code" (source or destination, kind * ITS_KMul + number), first channel "off", resolved
    in the cell "c" (0 : none, -1 : not valid), "w" channels, written (wr = 1) or read
*/
its_PchCellW = 1;
function its_Pch_Use(code, off, c, w, wr, kind, n, role)
local (k)
(
    (its_PchCell === -2) ? (
        k = floor(code / ITS_KMul);
        ((k === ITS_KBus) && ((k = code - k * ITS_KMul) < NB_BUS)) ? (BusNeed[k] = max(BusNeed[k], off + w));
    ) :
    (c < 0) ? (
        (its_PchCell === -1) ? (its_PchBad += 1);
    ) :
    (c > 0) ? (
