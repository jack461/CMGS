                ((f !== wk[its_FxW_F]) || (q !== wk[its_FxW_Q]) || (md !== wk[its_FxW_Md])) ? (
                    // the coefficients (biquads : RBJ cookbook)
                    wk[its_FxW_F] = f; wk[its_FxW_Q] = q; wk[its_FxW_Md] = md;
                    w = 2 * $pi * f / srate;
