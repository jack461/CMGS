        ) : (
            (slWrtAct === its_WrtAct_Paste) ? (
                // Il faut d'abord créer le writer
                act = 1;
                slWrtAct = its_WrtAct_Create;
            );
            (slWrtAct === its_WrtAct_Create) ? (
                str_mess = "Create writer configuration";
                // do create the writer
                Currwriter = Wr_Action(its_WrtAct_Create, slWriter, 0);
                ((act === 1) && (Currwriter !== 0)) ? (
