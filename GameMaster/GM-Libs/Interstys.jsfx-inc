menu_Chn_Ids = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "channels-num", CH_NB, menu_Chn_Ids_N);

menu_128_0_Ids_N = make_array(128);
<? i=0; loop(128, printf("menu_128_0_Ids_N[%d] = \"%d\";", i, i); i +=1;); ?>
menu_128_0_Ids = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "nums-128-0", 128, menu_128_0_Ids_N);

// counts 1 ... 128 (channels of a line, channels used), in 4 sub-menus of 32 (the ">" headers are not counted in the results)
menu_128_Grp = 32; // counts per sub-menu : the header of group g is item g * (menu_128_Grp + 1)
menu_128_1_Ids_N = make_array(128 + 4);
<? i=0; j=0; loop(128, (i % 32) == 0 ? (printf("menu_128_1_Ids_N[%d] = \">%d-%d\";", j, i+1, i+32); j += 1;); printf("menu_128_1_Ids_N[%d] = \"%s%d\";", j, ((i % 32) == 31) ? "<" : "", i+1); i += 1; j += 1;); ?>
menu_128_1_Ids = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "nums-128-1", 128 + 4, menu_128_1_Ids_N);

menu_256_0_Ids_N = make_array(256);
<? i=0; loop(256, printf("menu_256_0_Ids_N[%d] = \"%d\";", i, i); i +=1;); ?>
menu_256_0_Ids = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "nums-256-0", 256, menu_256_0_Ids_N);

