/*
=== PARAMETERS DCL ===
*/
function
initAllParameters()
local(ix)
(
    // do some default init. We keep the name uninitialized.
    ix = 0;
    loop(paramCount,
        parDcl(ix, #pUndef, #pUndef, 0, "-", "-", 0, 1, 0, 0.1, 0);
        ix += 1;
    );
    paramBlock[pp_Name] = "(unused)"; // this "locks" entry 0.
    menu_Param_mSL = 0;
    menu_Param_UBS = 0;
    menu_Param_UBD = 0;
    parDclMode = 0xf;
);

function
dclAllParameters()
local (ix, p, pdx, pp, pb, ii, ix, iy, u, w,mi, ma)
(
    paramBlock[pp_Name] = "(unused)"; // this "locks" entry 0.
    p = 2; // potentiometer curve for amplitude


    parDcl(p_uix_jtheme, "UI Theme",  "UITheme",   0,      "%d",   "UI Theme: %d", 0, 16, 0, 1, 0);

    parDcl(p_playSpeed, "Play Speed", "PlaySpd", i_UB|i_SP, "%.3f",  "Play Speed: %.3f", -SPDMAX, SPDMAX, 1, 0.001, 0);

    parDcl(p_playVol, "Play Volume",  "PlayVol",  i_UB|i_SP, "%.1f dB", "Play Volume: %.1f dB",   -120,   40,    0,  0.1, -2);

    parDcl(p_lineSize, "Line size",  "LineSize",  i_UB|i_SP, "%.3f s", "Line Size: %.3f s",   1,   3600,    1,  0.001, 3);

    parDcl(p_playPos, "Play position",  "PlayPos",  i_UB|i_SP, "%.3f s", "Play position: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Low, "Loop Low Lim.",  "LoopLLim",  i_UB|i_SP, "%.3f s", "Loop Low Lim.: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_High, "Loop High Lim.",  "LoopHLim",  i_UB|i_SP, "%.3f s", "Loop High Lim.: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Pos, "Loop position",  "LoopRPos",  i_UB|i_SP, "%.3f s", "Loop position: %.3f s",   0,   3600,    0,  0.001, 0);
    parDcl(p_play_S_Len, "Loop Length",  "LoopRLen",  i_UB|i_SP, "%.5f s", "Loop Length: %.5f s",   0.00001,   3600,    0,  0.00001, 6);
    parDcl(p_play_XFade, "Cross Fade", "CrssFade", i_UB|i_SP, "%.2f ms", "Cross Fade : %.2f ms", 0.01, 20000, 10, 0.01, 6);
    parDcl(p_play_Zoom, "Zoom", "WaveZoom", i_UB|i_SP, "%.0f", "Zoom : %.0f", 1, 100, 1, 1, 0);
    // strong exponential curve (slope 8) and 10 µs step : very fine choice of the small offsets
    parDcl(p_rdOffset, "Delay Offset", "RdOffset", i_UB|i_SP, "%.5f s", "Delay Offset: %.5f s", 0, 3600, 1, 0.00001, 8);
    parDcl(p_wrGain, "Record Gain",  "WrGain",  i_UB|i_SP, "%.1f dB", "Record Gain: %.1f dB",   -120,   40,    0,  0.1, -2);
    parDcl(p_wrOvrdb, "Overdub",  "WrOvrdb",  i_UB|i_SP, "%.1f %%", "Overdub: %.1f %%",   -150,   150,    0,  0.1, 0);
    parDcl(p_glInGain, "Input Gain",  "GlInGain",  i_UB|i_SP, "%.1f dB", "Input Gain: %.1f dB",   -120,   40,    0,  0.1, -2);
    parDcl(p_glOutVol, "Output Volume",  "GlOutVol",  i_UB|i_SP, "%.1f dB", "Output Volume: %.1f dB",   -120,   40,    0,  0.1, -2);
    parDcl(p_fxGain1, "Gain 1",  "FxGain1",  i_UB|i_SP, "%.1f dB", "Gain 1: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+1, "Gain 2",  "FxGain2",  i_UB|i_SP, "%.1f dB", "Gain 2: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+2, "Gain 3",  "FxGain3",  i_UB|i_SP, "%.1f dB", "Gain 3: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+3, "Gain 4",  "FxGain4",  i_UB|i_SP, "%.1f dB", "Gain 4: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+4, "Gain 5",  "FxGain5",  i_UB|i_SP, "%.1f dB", "Gain 5: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+5, "Gain 6",  "FxGain6",  i_UB|i_SP, "%.1f dB", "Gain 6: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+6, "Gain 7",  "FxGain7",  i_UB|i_SP, "%.1f dB", "Gain 7: %.1f dB",   -120,   20,    0,  0.1, -3);
    parDcl(p_fxGain1+7, "Gain 8",  "FxGain8",  i_UB|i_SP, "%.1f dB", "Gain 8: %.1f dB",   -120,   20,    0,  0.1, -3);
    // very fine choice of the small depths (flanger, chorus : 50 % of the slider is about 5 ms) up to 5 s
