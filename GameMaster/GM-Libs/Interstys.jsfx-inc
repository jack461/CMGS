frstRdsize = srate * 6; // start with few samples
FP_GlobVol = 1; // smoothed global volume
FP_GlobSet = 1; // raw global volume
FP_GlobWidth = 1;
FP_GlobWSet = 1;
VolumeMod0_u = 1;
VolumeMod1_u = 1;
FP_GlobVAdj = 1; // all global volume adjustments
