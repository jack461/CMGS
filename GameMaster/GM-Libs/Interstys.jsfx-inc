            (ki === 20) ? ( its_Tb_v1 = its_Tb_Num(nm, 10, 10000); ) :
            ((ki === 22) || (ki === 24)) ? ( its_Tb_v1 = its_Tb_Int(nm, 0, 100); ) :
            (ki === 26) ? (
                (its_Tb_Peek() === its_TK_none) ? ( its_Tb_Next(); its_Tb_v1 = -1; ) : ( its_Tb_v1 = its_Crv_Id(its_Tb_Next(), 0); );
            ) :
            (ki === 27) ? ( its_Tb_v1 = its_Tb_Num(nm, -20, 20); ) :
            (ki === 30) ? ( its_Tb_v1 = its_Tb_Num(nm, -1, 1); ) :
            (ki === 31) ? ( its_Tb_v1 = its_Tb_Num(nm, 0.01, 100); ) :
            (ki === 32) ? ( its_Tb_v1 = its_Tb_Num(nm, 0, 1); ) :
