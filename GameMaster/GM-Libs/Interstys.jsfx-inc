// a generator of control signals (LFO, Random) : no auto-limiter ; in Bypass, nothing (a Random : not its trigger)
function its_Fx_Ctl(ty) ( (ty === its_Efx_TyLFO) || (ty === its_Efx_TyRandom); );

// a meter (the VU meter, the Limiter : the engines of GM-Meters, one source) : no auto-limiter, no modulation input
function its_Fx_Meter(ty) ( (ty === its_Efx_TyVU) || (ty === its_Efx_TyLimiter); );

// count of sources of an effect type (-1 : a type not executed) ; the Random : its trigger (optional)
function its_Fx_NSrc(ty)
(
    ((ty === its_Efx_TyMixer) || (ty === its_Efx_TyAutoMix)) ? 8 :
    ((ty === its_Efx_TyMath) || (ty === its_Efx_TyRing)) ? 2 : // A, B (optional : the Ring, its carrier)
