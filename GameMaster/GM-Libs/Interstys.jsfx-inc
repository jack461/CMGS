                );
            );
        );

        ((nbr === slReader) && (rdtim !== ctime)) ? (
            rdtim = ctime; // so every second...
            slRPosPrv = slRPos = max(0,min(100, floor(0.5 + 10000 * (reader[its_Rdr_Abspos] - reader[its_Rdr_Start])/max(1, reader[its_Rdr_Last] - reader[its_Rdr_Start]))/100)) ;
        );

    ) : (

        // An error occured OR the reader is muted
        ((reader > BASE_MEMORY) && (reader[-2] === KW_read)) ? (
            // fill the output with zeroes (ex. mute)
            s = 0; d = its_Lin_BF1ST + reader[its_Rdr_Bf1stChan];
