    its_FxOrdRdy ? ( memcpy(its_FxOrd, its_FxOrdNew, FX_CNT); its_FxOrdRdy = 0; );
);




// The module "Patch" (see its_Patch_Scan) : count of the writers and of the readers of each cell
its_PchW = make_array(SMPL_SIZE);
its_PchR = make_array(SMPL_SIZE);
its_PchCbl = make_array(RD_CNT + FX_CNT); // the own cables that exist (see its_Pch_Cables)

mm_limit_a = make_array(2);
mm_limit_a[0] = 'STRT'; mm_limit_a[1] = 'MEMR';


// size : all the memory left under __memtop() (options:maxmem), but a reserve for the static allocations
// made after this one (see the memory written in the log at start : "free after the static allocations")
C_memrReserve = 512 * 1024; // 2026-10-20 : 0.02 MW used after this allocation
C_memrSize = floor(__memtop() - mSL_StM_FreePt - C_memrReserve);
C_memrArea = make_array(C_memrSize); // THE DYNAMIC MEMORY !

mm_limit_b = make_array(2);
mm_limit_b[0] = 'END_'; mm_limit_b[1] = 'MEMR';


// Build the dynamic memory
mSL_errX = mSL_errC = mSL_errM = 0;
mSL_current_memory = mSL_new_memory = 0; // make sure it is clear
AAAAC_5 = mSL_make_memory(C_memrArea, C_memrSize);

memoryBox1[7] = memoryBox2[7] = AAAAC_5 - 2; // actual start

mm_lowmem = mSL_new_memory + mSL_new_memory[mSL_MM_LowAd];
mm_highmem = mSL_new_memory + mSL_new_memory[mSL_MM_HighAd];
// mm_sizmem = max(1, mm_highmem - mm_lowmem);
mm_show_ttf = mm_sizmem = mSL_new_memory[mSL_MM_MemSiz];


mm_limit_f = make_array(2);
mm_limit_f[0] = 'STRT'; mm_limit_f[1] = 'COMP';

void_pointer = make_array(2);
void_pointer[0] = 0;
void_pointer[1] = 0;

// Provide an independent main symbol table for the compiler - "var" declarations
aprime = 3313;
size = 4 * (aprime + 1);
i__mem = make_array(size + 4);
A_mSL_GCTab = mSL_buildGVTab(i__mem, size, aprime);


// Try to provide an independent local symbol table for the compiler - "loc" declarations
aprime = 191;
size = 4 * (aprime + 1);
i__mem = make_array(size + 4);
A_mSL_LCTab = mSL_buildLCTab(i__mem, size, aprime);


// Provide a common external symbol table for the compiler - "ext" declarations
A_mSL_EXTab = mSL_buildEXTab(47);
// Provide a common external symbol table for the compiler - "ptr" declarations
A_mSL_PTTab = mSL_buildPTTab(47);

// Build the compiler
AAAAC_6 = mSL_make_compiler(C_compArea, C_compSize);
// Then, the interpreter
AAAAC_7 = mSL_make_evaluator(C_progArea, C_progSize);
mSL_new_thread = 0;

mm_limit_g = make_array(2);
mm_limit_g[0] = 'END_'; mm_limit_g[1] = 'COMP';




handling_load = 0;
perform_loading = 0;
mcp_indic = 0;
flg_clear_input = 0;
str_mess = "New message";
// Messages : the strings 16 to 32 are used in turn (str_mess is reset to 0 once displayed, see @gfx)
str_mess_n = 15;
function str_mess_slot()
(
    str_mess_n = ((str_mess_n < 16) || (str_mess_n >= 32)) ? 16 : str_mess_n + 1;
);
str_mess_prv = "Previous message";
ctime = 0;
pgmode = 0; // plug-in mode : merge
vol_inp = 1; // global gain - entrée
vol_out = 1; // global volume - sortie

// Return a unique time stamp
function ts()
local (pxtime, pftime)
(
    /*
    (pftime != (ctime%10000)) ? (
        pftime = (ctime%10000);
        pxtime = 0;
    ) : (
        pxtime += 1/1024;
    );
    pftime + pxtime;
    */
    pftime += 1;
);




function parGetV(xp)
local (val, act)
(
    xp = 0|max(0,min(paramNMax,xp)); // minimalistic check
    val = paramValues[xp];
);

function parSet(xop, value)
local (f, pp, pq, pv, fspect)
(
    xop = 0|max(0,min(paramNMax,xop)); // minimalistic check
    pv = paramValues[xop]; // previous value
);

/*
    Implementation of the mSL "get"
*/
function mSL_get(argc, argv)
local (pfid, ref, addr, res, flg, kod, size, s, ip, k, k2, pt, kid, pid)
(
    pfid = argv[0]; ref = argv[1];
    res = addr = flg = 0;
    kod = size = -1;
    kid = (argc > 1) && (((ref > mSL_Sym_Low) && (ref < mSL_Sym_High)) || ((ref >= mSL_MKey_min) && (ref <= mSL_MKey_max)));

    // is this a keyword ?
    ((pfid > mSL_Sym_Low) && (pfid < mSL_Sym_High)) ? (
        (FlagsTbVals[Flgs_PrOps] & 1) ? (
            // just for trace
            strcpy(#sZ0, mSL_id2Str(pfid));
            (argc <= 1) ? (
                sprintf(#sfc, "mSL_get[%d]  \"%s\".", argc, #sZ0);
            ) :
            (
                sprintf(#sfc, "mSL_get[%d]  \"%s\"  \"%s\" / %d", argc, #sZ0, mSL_edit_value(#sZ1, ref), kid);
            );
            mSL_log(SysLogBox, #sfc);
        );
        pid = -1;
        ((pfid === mSL_KW_JSFX) || (pfid === mSL_KW_jsfx_) || (pfid === mSL_KW_GM) || (pfid === mSL_KW_GM_)) ? (
            // acces a JSFX variable
            res = mSL_vGet(ref);
