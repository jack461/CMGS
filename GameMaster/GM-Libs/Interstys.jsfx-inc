/* */


/*
    Displaying a parameter in a box
*/

function parShow(xpnum)
local (pp)
(
    ((xpnum > paramBase) && (xpnum <= paramNMax) && (xpnum == (0|xpnum))) ? (
        pp = paramBlock + xpnum * paramEntSize;
        (pp[pp_Name] != 0) ? (
            ui_show(pp[pp_Name], paramValues[xpnum], pp[pp_SFmt]);
        );
    ) : (
        ui_show(0);
    );
);



//==========================================================
//===== READERS Handling
//  Readers_set[RD_CNT]


// the free loop of the reader "r" crosses the end of its line : the option (its_Rdr_LoopCross), a mode on a line, not the
// type "once" of the modes Brage and Grains (the loop stops at the end of the line), a loop shorter than the line by two
// cross fades and two audio blocks (its frame, centered on it, holds its margins : its_Rd_FrLo)
function its_Rd_CrossOk(r)
local (md, n, X)
(
    md = r[its_Rdr_Mode]; n = r[its_Rdr_SmplCnt];
    X = max(3, floor(0.5 + r[its_Rdr_XFade_mSec] * srate / 1000));
    r[its_Rdr_LoopCross] && its_Rd_Lined(md) && (n > 0)
        && !(its_Rd_Rand(md) && (r[its_Rdr_LoopType] === its_RdrLoopTypeOnce))
        && ((r[its_Rdr_HighPosSec] - r[its_Rdr_LowPosSec]) * srate < n - 2 * X - 2 * samplesblock - 8);
);

// the loop of the reader "r" that crosses the end of its line, in its form : its end in (0, size of the line] (its start
// below 0 : it straddles the end and the start) ; 1 if its limits changed
function its_Rd_CrossForm(r)
local (cs, hi, d)
(
    cs = r[its_Rdr_SmplCnt] / srate; hi = r[its_Rdr_HighPosSec];
    ((cs > 0) && ((hi > cs) || (hi <= 0))) ? (
        d = cs * floor(hi / cs); // (the shift : a multiple of the size)
        (d === hi) ? (d -= cs); // (an end at 0 : at the end of the line)
        r[its_Rdr_LowPosSec] -= d; r[its_Rdr_HighPosSec] -= d;
        1;
    ) : 0;
);

// the loop of the reader "r" that straddles the end and the start of its line brought back in the line, at the end
// where most of it is (as a jump of the loop) ; 1 if its limits changed
function its_Rd_Uncross(r)
local (cs, lo, hi, ln, c)
(
    cs = r[its_Rdr_SmplCnt] / srate;
    c = its_Rd_CrossForm(r);
    lo = r[its_Rdr_LowPosSec]; hi = r[its_Rdr_HighPosSec]; ln = min(cs, hi - lo);
    ((cs > 0) && (lo < 0)) ? (
        (hi >= -lo) ? ( lo = 0; hi = ln; ) : ( hi = cs; lo = cs - ln; );
        r[its_Rdr_LowPosSec] = lo; r[its_Rdr_HighPosSec] = hi;
        c = 1;
    );
    c;
);

/*
    the move of the loop of the reader "r" during an audio block (@block) : in reader mode, while reading, its low and high
    limits move at its_Rdr_LoopSpd s/s (with the modulation input 3, added : the raw value of the cell), its length kept ;
    at an end of the line, the loop starts again from the other end, or it crosses the end (the option its_Rdr_LoopCross,
    see its_Rd_Cross) ; then Rd_Update computes again the position of the region and its crossfade limits (a crossfade
    in progress keeps its positions)
*/
function its_Rdr_LoopMove(r)
local (v, p, lo, hi, cs, ln, cx)
(
    ((r > BASE_MEMORY) && (r[-2] === KW_read) && its_Rd_Lined(r[its_Rdr_Mode])
        && (r[its_Rdr_Status] === its_RdrStat_Reading) && (r[its_Rdr_Lcbl] > BASE_MEMORY)) ? (
        v = r[its_Rdr_LoopSpd];
        p = r + its_Rdr_Mod1 + 3 * its_ModDist;
        v = its_Mod_Law(p, smpl_tab[p[its_Mod_Cell]], v, its_ModA_Add, 1);
        v = max(-1, min(1, v));
        lo = r[its_Rdr_LowPosSec]; hi = r[its_Rdr_HighPosSec];
        cs = r[its_Rdr_SmplCnt] / srate; // the length of the line (s)
        ln = hi - lo;
        ((v !== 0) && (ln > 0) && (ln < cs)) ? (
            cx = its_Rd_CrossOk(r);
            lo += v * samplesblock / srate;
            hi = lo + ln;
            (its_Rd_Rand(r[its_Rdr_Mode]) && (r[its_Rdr_LoopType] === its_RdrLoopTypeOnce)
                && ((hi > cs) || (lo < 0))) ? (
                // Brage and Grains, type "once" : the loop stops at the end of the line, the reader ends (a fade out, see
                // its_St_Next ; Grains : the last grains end, see exec_grains)
                lo = max(0, min(cs - ln, lo)); hi = lo + ln;
                r[its_Rdr_BrEnd] = 1;
            ) :
            cx ? 0 : // (it crosses the end : no jump, its form is kept by its_Rd_CrossForm)
            (hi > cs) ? ( lo = hi - cs; hi = lo + ln; ) : // (at most one jump : |v| <= 1, ln < cs)
            (lo < 0) ? ( hi = cs + lo; lo = hi - ln; );
            r[its_Rdr_LowPosSec] = cx ? lo : max(0, lo);
            r[its_Rdr_HighPosSec] = cx ? hi : min(cs, hi);
            cx ? its_Rd_CrossForm(r);
            r[its_Rdr_StFlgs] |= its_RdrFlg_Mod; // (Rd_Update)
        );
    );
);

// the speed of the loop of the reader "r" (samples of the line per sample) : 1 if it follows a writer that writes, else 0
function its_Rd_LfSpd(r)
(
    (r[its_Rdr_LfSt] & its_RdrLf_Move) ? 1 : 0;
);

// the start of the frame of the positions of the reader "r" (a size of the line) : the loop follows a writer, the frame
// of the writer, [head - size, head) ; else (a free loop that crosses the end of the line, its_Rd_Cross), the frame
// centered on the loop
function its_Rd_FrLo(r)
local (w, n)
(
    n = r[its_Rdr_SmplCnt];
    ((r[its_Rdr_LfSt] & its_RdrLf_On) && (r[its_Rdr_LoopWr] > 0) && ((w = Writers_set[r[its_Rdr_LoopWr] - 1]) > BASE_MEMORY)) ?
        w[its_Wrt_Abspos] - n :
        r[its_Rdr_Start] + floor((r[its_Rdr_LowPosSec] + r[its_Rdr_HighPosSec]) * srate / 2 - n / 2);
);

// the position "x" of the reader "r" in the frame of its positions (when they are in a frame : its_RdrLf_Frame, see
// its_Rd_FrLo), else "x" ; LOW_VALUE (silence) is kept
function its_Rd_LfIn(r, x)
local (n, lo)
(
    ((r[its_Rdr_LfSt] & its_RdrLf_Frame) && ((n = r[its_Rdr_SmplCnt]) > 0) && (x > MIN_VALUE)) ? (
        lo = its_Rd_FrLo(r);
        x - n * floor((x - lo) / n);
    ) : x;
);

// the positions of the reader "r" brought in [lo, lo + size of its line) by a multiple of this size (they are read modulo
// the size) : mode Reader, its read positions, one by one ; modes Stretch and Brage, while the blocks run, their positions,
// all by the shift of the nominal start of the next block (the correlation compares them) ; LOW_VALUE (silence) is kept
function its_Rd_LfShift(r, lo)
local (n, d, x)
(
    ((n = r[its_Rdr_SmplCnt]) > 0) ? (
        (its_Rd_Blocks(r[its_Rdr_Mode]) && (r[its_Rdr_StJ] >= 0)) ? (
            d = -n * floor((r[its_Rdr_StNNom] - lo) / n);
            (d !== 0) ? (
                r[its_Rdr_StNNom] += d; r[its_Rdr_StNom] += d; r[its_Rdr_StX0] += d;
                (r[its_Rdr_StCur] > MIN_VALUE) ? (r[its_Rdr_StCur] += d);
                (r[its_Rdr_StTail] > MIN_VALUE) ? (r[its_Rdr_StTail] += d);
            );
        ) : (
            ((x = r[its_Rdr_Abspos]) > MIN_VALUE) ? (r[its_Rdr_Abspos] = x - n * floor((x - lo) / n));
            ((x = r[its_Rdr_AbsAuxpos]) > MIN_VALUE) ? (r[its_Rdr_AbsAuxpos] = x - n * floor((x - lo) / n));
        );
    );
);

// the limits of the loop [A1, B1] (samples from the start of the line) of the reader "r" and their margins (X samples) :
// inside its end, before its start, as for a loop at the end of a line ; no bound (the loop follows a writer, or it
// crosses the end of the line : it may straddle the end and the start, its start below 0)
function its_Rd_RegLims(r, A1, B1, X)
local (W)
(
    W = r[its_Rdr_Start];
    r[its_Rdr_RegSOut] = W + A1 - X; r[its_Rdr_RegSIn] = W + A1;
    r[its_Rdr_RegEIn] = W + B1 - X; r[its_Rdr_RegEOut] = W + B1;
);

// the limits of the loop of the reader "r" that follows a writer, from its end (its_Rdr_HighPosSec : the head of the
// writer) and its length (the size of the region) ; the margins (X samples) inside its end, before its start, as for a
// loop at the end of a line ; no bound : the loop may straddle the end and the start of the line (its start below 0),
// except in the modes Brage and Grains, type "once" (the loop stays in the line)
function its_Rd_LfReg(r, X)
local (A1, B1)
(
    B1 = floor(0.5 + r[its_Rdr_HighPosSec] * srate);
    A1 = B1 - max(6, floor(0.5 + r[its_Rdr_RegSizeSec] * srate));
    (its_Rd_Rand(r[its_Rdr_Mode]) && (r[its_Rdr_LoopType] === its_RdrLoopTypeOnce)) ? (A1 = min(B1, max(0, A1)));
    r[its_Rdr_LowPosSec] = r[its_Rdr_LowPosSecPrv] = A1 / srate;
    its_Rd_RegLims(r, A1, B1, X);
);

/*
    the loop of the reader "r" that follows a writer (its_Rdr_LoopWr), during an audio block (@block) : its end, its
    margin included, is just before the head of the writer (its_RdrLfGuard), its length is the size of the region (at
    most the line, minus a margin and an audio block : its oldest samples are not written again while they are read) ;
    the writer must write forward in the line of the reader, not in mode W-Mix (else the loop is free, see
    its_Rdr_LoopMove).
    The line is circular : the loop can straddle its end and its start. In the types that use the loop (catch, loop,
    exit, stop) of the modes Reader and Stretch, the positions of the reader are kept in the frame of the writer,
    [head - size, head) (its_Rd_LfShift), read in the line (modulo its size), and the loop types act on the direction
    of the reading relative to the loop (its_Rd_LfSpd) ; the modes Brage and Grains read in the line already, their
    segments or grains are drawn in the loop ; types "once" and "repeat" read the line itself, they stop or loop at its
    ends. Modes Brage and Grains, type "once" : the loop stays at the end of the line when the writer goes back to its
    start, then the reader ends (its_Rdr_BrEnd).
    Returns 1 if the loop follows the writer.
*/
function its_Rdr_LoopFollow(r)
local (md, ty, wn, w, wp, st, n, s, X, L, B1, cs, ln)
(
    md = r[its_Rdr_Mode];
    wn = r[its_Rdr_LoopWr];
    w = ((wn > 0) && (wn <= WR_CNT)) ? Writers_set[wn - 1] : 0;
    st = r[its_Rdr_Start]; n = r[its_Rdr_SmplCnt];
    ((w > BASE_MEMORY) && (w[-2] === KW_writ) && its_Rd_Lined(md) && (r[its_Rdr_Lcbl] > BASE_MEMORY)
        && (w[its_Wrt_Lcbl] === r[its_Rdr_Lcbl]) && (w[its_Wrt_Mode] !== its_WrtMode_WMix)
        && (w[its_Wrt_Dir] === its_WrtDir_Fwd) && (n > 0)
        && ((wp = w[its_Wrt_Abspos]) >= st) && (wp < st + n)) ? (
        ty = r[its_Rdr_LoopType];
        s = its_RdrLf_On | ((w[its_Wrt_Status] === its_WrtStat_Writing) ? its_RdrLf_Move : 0);
        (!its_Rd_Rand(md) && (ty !== its_RdrLoopTypeOnce) && (ty !== its_RdrLoopTypeRepeat)) ? (
            s |= its_RdrLf_Frame;
            its_Rd_LfShift(r, wp - n);
        ) :
        (r[its_Rdr_LfSt] & its_RdrLf_Frame) ? (
            its_Rd_LfShift(r, st); // (back in the line)
        );
        r[its_Rdr_LfSt] = s;
        X = max(3, floor(0.5 + r[its_Rdr_XFade_mSec] * srate / 1000));
        L = floor(0.5 + r[its_Rdr_RegSizeSec] * srate);
        (L > n - X - its_RdrLfGuard - samplesblock - 4) ? (
            r[its_Rdr_RegSizeSec] = max(6, n - X - its_RdrLfGuard - samplesblock - 4) / srate;
            r[its_Rdr_StFlgs] |= its_RdrFlg_Mod; // (Rd_Update : the cross fade and the size)
        );
        B1 = wp - st - its_RdrLfGuard;
        (its_Rd_Rand(md) && (ty === its_RdrLoopTypeOnce) && (r[its_Rdr_Status] === its_RdrStat_Reading)
            && (B1 < floor(0.5 + r[its_Rdr_HighPosSec] * srate) - n / 2)) ? (
            r[its_Rdr_BrEnd] = 1; // the writer went back to the start of the line : the loop stays at its end, the end
        ) : (
            r[its_Rdr_HighPosSec] = r[its_Rdr_HighPosSecPrv] = B1 / srate;
            its_Rd_LfReg(r, X);
        );
        1;
    ) : (
        // the loop is free : the positions back in the line, and the loop (it may straddle the end and the start ; with
        // the option "cross the end of the line", it stays where it is, see its_Rd_Cross)
        (its_Rd_Lined(md) && (r[its_Rdr_LfSt] & its_RdrLf_Frame)) ? its_Rd_LfShift(r, st);
        (its_Rd_Lined(md) && (r[its_Rdr_LfSt] & its_RdrLf_On)) ? (
            ((r[its_Rdr_LowPosSec] < 0) && !r[its_Rdr_LoopCross]) ? (
                cs = n / srate; ln = r[its_Rdr_HighPosSec] - r[its_Rdr_LowPosSec];
                r[its_Rdr_HighPosSec] = cs; r[its_Rdr_LowPosSec] = max(0, cs - ln);
            );
            r[its_Rdr_LowPosSecPrv] = -1;
            r[its_Rdr_StFlgs] |= its_RdrFlg_Mod; // (Rd_Update : its limits computed again, in the line)
        );
        r[its_Rdr_LfSt] = 0;
        0;
    );
);

/*
    the free loop of the reader "r" (it does not follow a writer), during an audio block (@block), after its move
    (its_Rdr_LoopMove) : with the option "cross the end of the line" (its_Rdr_LoopCross, see its_Rd_CrossOk), the line
    is circular, the loop crosses its end (no jump) and it may straddle the end and the start (its form : its_Rd_CrossForm,
    its start below 0) ; as when the loop follows a writer, in the types that use the loop (catch, loop, exit, stop) of
    the modes Reader and Stretch, the positions of the reader are kept in a frame, centered on the loop (its_Rd_FrLo,
    its_Rd_LfShift), read in the line (modulo its size) ; the modes Brage and Grains read in the line already. Without
    the option (or a loop too long) : the positions back in the line, the loop too (its_Rd_Uncross)
*/
function its_Rd_Cross(r)
local (md, ty, st, f, s)
(
    md = r[its_Rdr_Mode]; ty = r[its_Rdr_LoopType];
    st = r[its_Rdr_Start];
    f = r[its_Rdr_LfSt]; s = 0;
    (its_Rd_Lined(md) && (r[its_Rdr_Lcbl] > BASE_MEMORY) && (r[its_Rdr_SmplCnt] > 0)) ? (
        its_Rd_CrossOk(r) ? (
            its_Rd_CrossForm(r) ? (r[its_Rdr_StFlgs] |= its_RdrFlg_Mod);
            s = its_RdrLf_Cross;
            (!its_Rd_Rand(md) && (ty !== its_RdrLoopTypeOnce) && (ty !== its_RdrLoopTypeRepeat)) ? (s |= its_RdrLf_Frame);
        ) : (
            its_Rd_Uncross(r) ? (r[its_Rdr_StFlgs] |= its_RdrFlg_Mod);
        );
        // the margins of the loop change of form (see Rd_Update) : its limits computed again
        ((s ~ f) & its_RdrLf_Cross) ? ( r[its_Rdr_LowPosSecPrv] = -1; r[its_Rdr_StFlgs] |= its_RdrFlg_Mod; );
    );
    r[its_Rdr_LfSt] = s;
    (s & its_RdrLf_Frame) ? its_Rd_LfShift(r, its_Rd_FrLo(r)) :
    (f & its_RdrLf_Frame) ? its_Rd_LfShift(r, st); // (back in the line)
);

// modes Brage and Grains, type "once" (see its_Rdr_LoopMove) : a moving loop stopped at an end of the line, in the
// direction of its move, starts again from the other end (a stopped reader that starts again, see Rd_Set_Status)
function its_Rd_OnceRestart(r)
local (v, p, lo, hi, cs, ln)
(
    (its_Rd_Rand(r[its_Rdr_Mode]) && (r[its_Rdr_LoopType] === its_RdrLoopTypeOnce) && !(r[its_Rdr_LfSt] & its_RdrLf_On)) ? (
        v = r[its_Rdr_LoopSpd];
        p = r + its_Rdr_Mod1 + 3 * its_ModDist;
        v = its_Mod_Law(p, smpl_tab[p[its_Mod_Cell]], v, its_ModA_Add, 1); // (as its_Rdr_LoopMove)
        lo = r[its_Rdr_LowPosSec]; hi = r[its_Rdr_HighPosSec];
        cs = r[its_Rdr_SmplCnt] / srate; ln = hi - lo;
        ((v > 0) && (hi >= cs - 0.001)) ? (
            r[its_Rdr_LowPosSec] = 0; r[its_Rdr_HighPosSec] = min(cs, ln);
            r[its_Rdr_StFlgs] |= its_RdrFlg_Mod; // (Rd_Update)
        ) :
        ((v < 0) && (lo <= 0.001)) ? (
            r[its_Rdr_HighPosSec] = cs; r[its_Rdr_LowPosSec] = max(0, cs - ln);
            r[its_Rdr_StFlgs] |= its_RdrFlg_Mod;
        );
    );
);

// the position from which the reader "r" starts (Ready -> Reading, see Rd_Set_Status), by the direction of its
// progression : type "exit", the end of its loop where it enters it (the direction relative to the loop when the loop
// follows a writer), else the end of its line
function its_Rd_Home(r)
local (d)
(
    (r[its_Rdr_LoopType] === its_RdrLoopTypeExit) ? (
        d = its_Rd_Dir(r) * r[its_Rdr_AdjInc] - its_Rd_LfSpd(r);
        r[its_Rdr_Start] + floor(((d >= 0) ? r[its_Rdr_LowPosSec] : r[its_Rdr_HighPosSec]) * srate);
    ) :
    (its_Rd_Dir(r) >= 0) ? r[its_Rdr_Start] : r[its_Rdr_Last];
);

// the default settings of the mode Grains of the reader block "r"
function its_RdGr_Defaults(r)
(
    r[its_Rdr_GrSize] = 100; r[its_Rdr_GrSizeR] = 1; r[its_Rdr_GrPlat] = 50; r[its_Rdr_GrPlatR] = 1;
    r[its_Rdr_GrFade] = 50; r[its_Rdr_GrFadeR] = 1; r[its_Rdr_GrCurve] = 0; r[its_Rdr_GrVol] = 0; r[its_Rdr_GrVolR] = 1;
    r[its_Rdr_GrSpdR] = 1; r[its_Rdr_GrDir] = 1; r[its_Rdr_GrDens] = 10; r[its_Rdr_GrRand] = 1;
);

function Rd_Clear(rnum)
local(rcb, w0, w1, w2)
(
    (((rcb = Readers_set[rnum]) > BASE_MEMORY) && (rcb[-2] === KW_read)) ? (
        w0 = rcb[its_Rdr_Work]; w1 = rcb[its_Rdr_WkNew]; w2 = rcb[its_Rdr_WkOld]; // (its work areas : freed by @gfx)
        memset(rcb, 0, its_Rdr_BlkSize);
        rcb[its_Rdr_Work] = w0; rcb[its_Rdr_WkNew] = w1; rcb[its_Rdr_WkOld] = w2;
        // mode Stretch : the default settings
        rcb[its_Rdr_StBlkMs] = 60; rcb[its_Rdr_StOvlPc] = 25; rcb[its_Rdr_StSrchMs] = 12; rcb[its_Rdr_StTransp] = 0;
        rcb[its_Rdr_Stretch] = 1;
        its_RdGr_Defaults(rcb); // (mode Grains)
        rcb[its_Rdr_StJ] = -1;
        (rcb[its_Rdr_Status] === its_RdrStat_Reading) ? (
                rcb[its_Rdr_Tmp4] = 200;
                rcb[its_Rdr_Tmp5] = rcb[its_Rdr_Status];
                rcb[its_Rdr_Tmp6] = ts();
        );
        rcb[its_Rdr_Status] = its_RdrStat_Created;
        rcb[its_Rdr_WrSrc] = rcb[its_Rdr_LineNb] = -1;
        rcb[its_Rdr_Speed] = 1;
        rcb[its_Rdr_AbsInc] = 1;
        rcb[its_Rdr_OutVol] = 1;
        rcb[its_Rdr_OutK] = ITS_KOut * ITS_KMul; // default output : Out, channel 0
        its_Mod_Init(rcb + its_Rdr_Mod1, its_Rdr_ModN); // modulation attenuverters
        rcb[its_Rdr_NxtPosSec] = -1;
        rcb[its_Rdr_Unuz1] = rcb[its_Rdr_Unuz2] = SECURE_BL;
        rcb[its_Rdr_Number] = rnum;
        rcb[its_Run_Kind] = its_RunK_Reader;
        its_Run_Check(rcb);
    );
);
function Rd_Make(rnum)
local(rcb)
(
    ((rcb = Readers_set[rnum]) === 0) ? (
        rcb = mSL_Dyn_Alloc(its_Rdr_BlkSize, KW_read, 0); // allocate memory
        Readers_set[rnum] = rcb;
        // sprintf(#A001, "Rd_Make(%d) => %d", rnum, rcb);
        Rd_Clear(rnum);
        0 ? (
            str_mess = str_mess_slot(); // a string in [16 .. 32]
            sprintf(str_mess, "Rd_Make %d - return %d", rnum, rcb);
        );
        // sprintf(#A003, "reader(%d)[%f  %f]", rnum, rcb[0], rcb[1]);
    );
    rcb;
);

// Delete a reader from Readers_set
function Rd_Delete(rnum)
local (rcb)
(
    ((rnum >= 0) && (rnum <= RD_CNT) && ((rcb = Readers_set[rnum]) > BASE_MEMORY) && (rcb[-2] === KW_read)) ? (
        Readers_set[rnum] = 0;
        its_Run_Free(rcb);
    );
    Readers_set[rnum] = 0;
);

// Pad for the readers (4 lines : the line 4 in mode Stretch only, see its_Rd_PadLines)
pad_Rdr_NL = 5; // (5 lines : mode Grains, see its_Rd_PadLines)
pad_Rdr_NC = 8;
pad_Rdr_Siz = pad_Rdr_NL * pad_Rdr_NC;
pad_Reader = make_jpad(
    ui_jpad_ty_act | ui_jpad_mk_labs | ui_jpad_mk_colors | ui_jpad_mk_values,
    pad_Rdr_NL, pad_Rdr_NC, pad_Rdr_Siz);
pad_Rdr_Labs = pad_Reader + pad_Reader[ui_jpad_labs]; // addresses of labels
pad_Rdr_Colrs = pad_Reader + pad_Reader[ui_jpad_clrs]; // addresses of colors
pad_Rdr_Cells = pad_Reader + pad_Reader[ui_jpad_cells]; // addresses of cells desc.
pad_Rdr_Vals = pad_Reader + pad_Reader[ui_jpad_values]; // addresses of cells desc.
//
i__ii = 0; loop(pad_Rdr_Siz,
            pad_Rdr_Colrs[i__ii] = Col_Inactive;
            pad_Rdr_Labs[i__ii] = "";
            i__ii+=1;
);
// Pad of the modulation inputs of a reader or a writer (see its_Mod_Row) : one line
pad_RdM_Siz = 8;
pad_RdMod = make_jpad(
    ui_jpad_ty_act | ui_jpad_mk_labs | ui_jpad_mk_colors | ui_jpad_mk_values,
    1, pad_RdM_Siz, pad_RdM_Siz);
pad_RdM_Labs = pad_RdMod + pad_RdMod[ui_jpad_labs]; // addresses of labels
pad_RdM_Colrs = pad_RdMod + pad_RdMod[ui_jpad_clrs]; // addresses of colors
i__ii = 0; loop(pad_RdM_Siz,
            pad_RdM_Colrs[i__ii] = Col_Inactive;
            pad_RdM_Labs[i__ii] = "";
            i__ii+=1;
);

