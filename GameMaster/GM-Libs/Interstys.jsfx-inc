its_LnFShow = -1; // the line whose full path is shown in its file pad (left clic), until its_LnFShowT
its_LnFShowT = 0;
its_LnFShowDur = 20; // (seconds)

// the name of the file "path" without its folder, in "str"
function its_Ln_BaseName(str, path)
local (i, c)
(
    i = strlen(path) - 1;
    while ((i >= 0) && ((c = str_getchar(path, i, 'cu')) !== '/') && (c !== '\\')) ( i -= 1; );
    strcpy_from(str, path, i + 1);
);

