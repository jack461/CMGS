// Noise : the rumble kept within +-1 (linear up to 0.8, then a soft knee, its_Mx_Sat : its rare peaks rounded)
function its_Nz_Knee(x) local(a)
(
    a = abs(x);
    (a <= 0.8) ? x : ( a = 0.8 + 0.2 * its_Mx_Sat((a - 0.8) / 0.2); (x < 0) ? -a : a; );
);

// Noise : the shape sign(x) |x|^e of the sample "x" (the table "t" of |x|^e for |x| < 1, interpolated ; above : the power)
function its_Nz_Shape(x, t, e) local(a, f, i)
(
    a = abs(x);
    (a < 1) ? ( f = a * its_NzTN; i = floor(f); a = t[i] + (f - i) * (t[i + 1] - t[i]); ) : ( a = a ^ e; );
    (x < 0) ? -a : a;
