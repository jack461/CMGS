/*
    Displaying a parameter in a box
*/

function parShow(xpnum)
local (pp)
(
    ((xpnum > 0) && (xpnum < paramCount) && (xpnum == (0|xpnum))) ? (
        pp = paramBlock + xpnum * paramEntSize;
        (pp[pp_Name] != 0) ? (
            ui_show(pp[pp_Name], paramValues[xpnum], pp[pp_SFmt]);
        );
    ) : (
        ui_show(0);
    );
);



//==========================================================
//===== READERS Handling
//  Readers_set[RD_CNT]


function Rd_Clear(rnum)
local(rcb)
(
    (((rcb = Readers_set[rnum]) > BASE_MEMORY) && (rcb[-2] === KW_read)) ? (
        memset(rcb, 0, its_Rdr_BlkSize);
    (rcb[its_Rdr_Status] === its_RdrStat_Reading) ? (
            rcb[its_Rdr_Tmp4] = 200;
            rcb[its_Rdr_Tmp5] = rcb[its_Rdr_Status];
            rcb[its_Rdr_Tmp6] = ts();
    );
        rcb[its_Rdr_Status] = its_RdrStat_Created;
        rcb[its_Rdr_WrSrc] = rcb[its_Rdr_LineNb] = -1;
        rcb[its_Rdr_Speed] = 1;
        rcb[its_Rdr_AbsInc] = 1;
        rcb[its_Rdr_OutVol] = 1;
        rcb[its_Rdr_NxtPosSec] = -1;
        rcb[its_Rdr_Unuz1] = rcb[its_Rdr_Unuz2] = SECURE_BL;
        rcb[its_Rdr_Number] = rnum;
    );
);
function Rd_Make(rnum)
local(rcb)
(
    ((rcb = Readers_set[rnum]) === 0) ? (
        rcb = mSL_Dyn_Alloc(its_Rdr_BlkSize, KW_read, 0); // allocate memory
        Readers_set[rnum] = rcb;
        // sprintf(#A001, "Rd_Make(%d) => %d", rnum, rcb);
        Rd_Clear(rnum);
        0 ? (
            str_mess = str_mess_slot(); // a string in [16 .. 32]
            sprintf(str_mess, "Rd_Make %d - return %d", rnum, rcb);
        );
        // sprintf(#A003, "reader(%d)[%f  %f]", rnum, rcb[0], rcb[1]);
    );
    rcb;
);

// Delete a reader from Readers_set
function Rd_Delete(rnum)
local (rcb)
(
    ((rnum >= 0) && (rnum <= RD_CNT) && ((rcb = Readers_set[rnum]) > BASE_MEMORY) && (rcb[-2] === KW_read)) ? (
        mSL_Dyn_Free(rcb);
    );
    Readers_set[rnum] = 0;
);

