function updateRdCellIdent(rcbl)
local (num)
(
/*
    num = rcbl[its_Rdr_RCell];
    (num > (v = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK + RD_CNT + WR_CNT)) ? (
        ty = 8;
    ) :
    (num > (v = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK + RD_CNT)) ? (
        ty = 7;
    ) :
    (num > (v = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK)) ? (
        ty = 6;
    ) :
    (num > (v = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX)) ? (
        ty = 5;
    ) :
    (num > (v = 1 + CH_NB + CH_NB + NB_AUX)) ? (
        ty = 4;
    ) :
    (num > (v = 1 + CH_NB + CH_NB)) ? (
        ty = 3;
    ) :
    (num > (v = 1 + CH_NB)) ? (
        ty = 2;
    ) :
    (num > (v = 1)) ? (
        ty = 1;
    ) : (
        ty = 0;
    );
    rcbl[its_Rdr_RCellT] = ty;
    rcbl[its_Rdr_RCellN] = num - v;
*/
    num = rcbl[its_Rdr_RCell] - 1;
    (num < 0) ? (
        rcbl[its_Rdr_RCellT] = rcbl[its_Rdr_RCellN] = 0;
    ) : (
        rcbl[its_Rdr_RCellT] = num >> 8;
        rcbl[its_Rdr_RCellN] = num & 0xFF;
    );
);


function setCellIdent(num, add1, add2)
local (v, a)
(
    (num >= (v = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK + RD_CNT + WR_CNT)) ? (
        strcpy(add1[0], "Effect"); a = 1;
    ) :
    (num >= (v = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK + RD_CNT)) ? (
        strcpy(add1[0], "Writer"); a = 1;
    ) :
    (num >= (v = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK)) ? (
        strcpy(add1[0], "Reader"); a = 1;
    ) :
    (num >= (v = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX)) ? (
        strcpy(add1[0], "Work"); a = 1;
    ) :
    (num >= (v = 1 + CH_NB + CH_NB + NB_AUX)) ? (
        strcpy(add1[0], "tmp"); a = 0;
    ) :
    (num >= (v = 1 + CH_NB + CH_NB)) ? (
        strcpy(add1[0], "aux"); a = 0;
    ) :
    (num >= (v = 1 + CH_NB)) ? (
        strcpy(add1[0], "spl_out()"); a = 0;
    ) :
    (num >= (v = 1)) ? (
        strcpy(add1[0], "spl_in()"); a = 0;
    ) : (
        strcpy(add1[0], "None"); a = 0;
    );
    sprintf(add2[0], "%d", max(0, num + a - v));
);

CellCount = make_array(10);
CellCount[0] = 0;
CellCount[1] = 1;
CellCount[2] = 1 + CH_NB;
CellCount[3] = 1 + CH_NB + CH_NB;
CellCount[4] = 1 + CH_NB + CH_NB + NB_AUX;
CellCount[5] = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX;
CellCount[6] = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK;
CellCount[7] = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK + RD_CNT;
CellCount[8] = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK + RD_CNT + WR_CNT;
CellCount[9] = 1 + CH_NB + CH_NB + NB_AUX + NB_AUX + NB_WRK + RD_CNT + WR_CNT + FX_CNT;
function getCellIdent(num1, num2)
(
    num1 = max(0, min(9, num1));
    CellCount[num1] + num2 % ((num1 <= 4) ? 128 : 256);
);


