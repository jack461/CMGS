        gk = hd[5];
        dl = max(0, its_Mod_Apply(mp, fx[its_Efx_Par1], its_ModA_Oct, 1)) * srate / 1000;
        sw = max(0, fx[its_Efx_MxX]) * srate / 1000;
        (hd[2] < 0) ? ( hd[2] = dl; hd[3] = sw; ) : ( hd[2] += gk * (dl - hd[2]); hd[3] += gk * (sw - hd[3]); );
        dl = hd[2]; sw = hd[3];
        rt = max(0, its_Mod_Apply(mp + its_ModDist, fx[its_Efx_MxX + 1], its_ModA_Oct, 1)) / srate; // (turns per sample)
        fb = max(-2, min(2, its_Mod_Apply(mp + 2 * its_ModDist, fx[its_Efx_Par1 + 6], its_ModA_Add, 1)));
        ls = its_Fl_Grows(fx, fb); // the loop saturates
        mix = max(-1, min(1, fx[its_Efx_Par1 + 3]));
