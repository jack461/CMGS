        (b[its_Wrt_Src] !== 0) ? its_Tb_Cat(ty, 1, b);
        i = 3; loop(5, its_Tb_Cat(ty, i, b); i += 1;);
        (b[its_Wrt_Mode] === its_WrtMode_WMix) ? ( i = 8; loop(5, its_Tb_Cat(ty, i, b); i += 1;); ) : // its settings
        (b[its_Wrt_Dir] !== its_WrtDir_Fwd) ? its_Tb_Cat(ty, 13, b); // X-fade, Sum : the direction, if not forward
        ok = its_Wrt_ModOk(b);
