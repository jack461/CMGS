                        GM_key_take('r') ? (
                            // toggle run/pause state
                            Rd_Set_Status(rdr, -1);
                        ) :
                        GM_key_take('t') ? (
                            RDBL[6] = (RDBL[6] + 1) % 3;
                        ); // (the other keys are left to the next levels)
                    );
                    /*
                    (zzmi) ? (
                        u_ch = do_GenericKeyRead();
                        (u_ch != 0) ? (
                            sprintf(#gfx_uc, "Keyed: '%c' [%d]", u_ch, kcnt); kcnt+= 1;
                            // mSL_log(SysLogBox, #gfx_uc);
                            rdupdt = 1;
                        );
                    );
                    */
                );

            ui_pop();

            // the modulation inputs (the pad may have deleted the reader)
            rcbl = Readers_set[rdr];
            rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
            (rok && (h4 > 0)) ? (
                ui_split_top(h4);
                    ui_pad(1,2,2,2);
                    its_Mod_Row(rcbl + its_Rdr_Mod1, 3, its_ModN_Rdr, its_Rdr_ModOk(rcbl), its_ModD_Rdr) ? (rcbl[its_Rdr_Check] = 0);
                ui_pop();
            );

            // Waveform of the channels read (see its_wave_reader and mSL_ui_audio.jsfx-inc)
            (rok && (h3 > 0)) ? (
                lcbl = rcbl[its_Rdr_Lcbl];
                w = min(h3, ui_height() - h2); // the sliders keep their place
                (((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) && (w >= its_RdrWaveMin)) ? (
                    ui_split_top(w);
                        ui_pad(1,2,1,2);
                        its_wave_reader(lcbl, rcbl, rdr, RDBL[9], its_Wave_Flags(RDBL + 10));
                    ui_pop();
                );
            );

            rok ? (
                // Displayed only when reader is defined

                // Sliders
                ui_split_top(h2);
                    zzmx = ui_hover();
                    ui_pad(1,3,1,0);


                    // Play volume
                    rp = rcbl[its_Rdr_RegPosSec]; // region position
                    clen =  smp2sec(rcbl[its_Rdr_SmplCnt]); // clip length in seconds
                    mvl =

                    paramValues[p_playVol] = zi = rcbl[its_Rdr_OutVoldB];
                    r = parCtl(p_playVol);
                    (r != 0) ? (
                        sprintf(#itm, "Vol -> %d %.3f", r, parV(p_playVol));
                        mSL_log(SysLogBox, #itm);
                        (r === 8) ? (
                            // right clic to reset
                            rcbl[its_Rdr_OutVoldB] = 0;
                            rcbl[its_Rdr_OutVol] = 1;
                        ) : (
                            (paramValues[p_playVol] !== zi) ? (
                                rcbl[its_Rdr_OutVoldB] = zi = paramValues[p_playVol];
                                rcbl[its_Rdr_OutVol] = (zi <= -120) ? 0 : 10^(zi/20);
                            );
                        );
                        rdupdt = 1;
                    );

                    (rcbl[its_Rdr_Mode] === its_RdrMode_Delay) ? (
                        // Delay mode : the reader follows its writer at the same speed, only its offset (seconds) can be changed
                        parSetPP(p_rdOffset, pp_Max, max(0.001, clen));
                        paramValues[p_rdOffset] = rcbl[its_Rdr_WOffset];
                        r = parCtl(p_rdOffset);
                        (r != 0) ? (
                            sprintf(#itm, "Offset -> %d %.3f", r, parV(p_rdOffset));
                            mSL_log(SysLogBox, #itm);
                            zi = (r === 8) ? 0 : parV(p_rdOffset); // right clic : minimal offset
                            Rd_Set_Offset(rcbl, zi * srate); // with a short cross fade if the reader plays
                            // keep the JSFX slider in sync when this reader is the current one
                            (rcbl === Currreader) ? (slRdOffsPrv = slRdOffs = rcbl[its_Rdr_WOffset];);
                            rdupdt = 1;
                        );
                    ) : (
                        // Reader mode
                        // Play speed
                        k = RDBL[4];
                        (k === 0) ? (
                            parSetPP(p_playSpeed, pp_Max, 4);
                            parSetPP(p_playSpeed, pp_Min, -4);
                            parSetPP(p_playSpeed, pp_Slope, 0);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_playSpeed, pp_Max, 4);
                            parSetPP(p_playSpeed, pp_Min, 0);
                            parSetPP(p_playSpeed, pp_Slope, 3);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_playSpeed, pp_Max, 1);
                            parSetPP(p_playSpeed, pp_Min, 0);
                            parSetPP(p_playSpeed, pp_Slope, 5);
                        ) :
                        (k === 3) ? (
                            parSetPP(p_playSpeed, pp_Max, 0);
                            parSetPP(p_playSpeed, pp_Min, -1);
                            parSetPP(p_playSpeed, pp_Slope, -5);
                        ) :
                        (k === 4) ? (
                            parSetPP(p_playSpeed, pp_Max, 0);
                            parSetPP(p_playSpeed, pp_Min, -4);
                            parSetPP(p_playSpeed, pp_Slope, -3);
                        ) :
                        (k === 5) ? (
                            parSetPP(p_playSpeed, pp_Max, 1);
                            parSetPP(p_playSpeed, pp_Min, -1);
                            parSetPP(p_playSpeed, pp_Slope, 0);
                        ) :
                        (k === 6) ? (
                            parSetPP(p_playSpeed, pp_Max, SPDMAX);
                            parSetPP(p_playSpeed, pp_Min, -SPDMAX);
                            parSetPP(p_playSpeed, pp_Slope, 0);
                        ) :
                        (k === 7) ? (
                            parSetPP(p_playSpeed, pp_Max, SPDMAX);
                            parSetPP(p_playSpeed, pp_Min, 0);
                            parSetPP(p_playSpeed, pp_Slope, 5);
                        );
                        paramValues[p_playSpeed] = zi = rcbl[its_Rdr_Speed];
                        r = parCtl(p_playSpeed);
                        (r != 0) ? (
                            sprintf(#itm, "Speed -> %d %.3f", r, parV(p_playSpeed));
                            mSL_log(SysLogBox, #itm);
                            (r === 8) ? (
                                // right clic to reset
                                Rd_Set_Speed(rdr, 1, 1);
                                RDBL[4] = 0;
                            ) : (
                                (paramValues[p_playSpeed] !== zi) ? (
                                    Rd_Set_Speed(rdr, paramValues[p_playSpeed], 0);
                                );
                            );
                            rdupdt = 1;
                        );


                        // Play position
                        paramValues[p_playPos] = smp2sec(max(rcbl[its_Rdr_Start], min(rcbl[its_Rdr_Last], rcbl[its_Rdr_Abspos])) - rcbl[its_Rdr_Start]);
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_playPos, pp_Min, 0);
                            parSetPP(p_playPos, pp_Max, clen);
                            parSetPP(p_playPos, pp_Step, 0.001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_playPos, pp_Min, max(0, rp - 10));
                            parSetPP(p_playPos, pp_Max, min(clen, rp + 10));
                            parSetPP(p_playPos, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_playPos, pp_Min, max(0, rp - 1));
                            parSetPP(p_playPos, pp_Max, min(clen, rp + 1));
                            parSetPP(p_playPos, pp_Step, 0.000001);
                        ) : (
                            parSetPP(p_playPos, pp_Min, 0);
                            parSetPP(p_playPos, pp_Max, clen);
                            parSetPP(p_playPos, pp_Step, 0.001);
                        );
                        r = parCtl(p_playPos);
                        (r != 0) ? (
                            sprintf(#itm, "Position -> %d %.3f", r, parV(p_playPos));
                            mSL_log(SysLogBox, #itm);
                            rcbl[its_Rdr_NxtPosSec] = parV(p_playPos); // Relative, in seconds
                            /*
                            (r === 8) ? (
                                // right clic to reset
                                Rd_Set_Speed(rdr, 1, 1);
                            ) : (
                                (paramValues[p_playPos] !== zi) ? (
                                    Rd_Set_Speed(rdr, paramValues[p_playPos], 0);
                                );
                            );
                            */
                            rdupdt = 1;
                        );

                        // Play low limit (seconds)
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_play_S_Low, pp_Min, 0);
                            parSetPP(p_play_S_Low, pp_Max, clen);
                            parSetPP(p_play_S_Low, pp_Step, 0.001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_play_S_Low, pp_Min, max(0, rp - 10));
                            parSetPP(p_play_S_Low, pp_Max, min(clen, rp + 10));
                            parSetPP(p_play_S_Low, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_play_S_Low, pp_Min, max(0, rp - 1));
                            parSetPP(p_play_S_Low, pp_Max, min(clen, rp + 1));
                            parSetPP(p_play_S_Low, pp_Step, 0.000001);
                        );
                        paramValues[p_play_S_Low] = rcbl[its_Rdr_LowPosSec] ;
                        parSetPP(p_play_S_Low, pp_Max, clen);
                        r = parCtl(p_play_S_Low);
                        (r != 0) ? (
                            zi = parV(p_play_S_Low);
                            (zi > rcbl[its_Rdr_HighPosSec]) ? (
                                rcbl[its_Rdr_LowPosSec] = rcbl[its_Rdr_HighPosSec];
                                rcbl[its_Rdr_HighPosSec] = zi;
                            ) : (
                                rcbl[its_Rdr_LowPosSec] = zi;
                            );
                            rdupdt = 1;
                        );

                        // Play high limit (seconds)
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_play_S_High, pp_Min, 0);
                            parSetPP(p_play_S_High, pp_Max, clen);
                            parSetPP(p_play_S_High, pp_Step, 0.001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_play_S_High, pp_Min, max(0, rp - 10));
                            parSetPP(p_play_S_High, pp_Max, min(clen, rp + 10));
                            parSetPP(p_play_S_High, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_play_S_High, pp_Min, max(0, rp - 1));
                            parSetPP(p_play_S_High, pp_Max, min(clen, rp + 1));
                            parSetPP(p_play_S_High, pp_Step, 0.000001);
                        );
                        paramValues[p_play_S_High] = rcbl[its_Rdr_HighPosSec];
                        parSetPP(p_play_S_High, pp_Max, clen);
                        r = parCtl(p_play_S_High);
                        (r != 0) ? (
                            zi = parV(p_play_S_High);
                            (zi < rcbl[its_Rdr_LowPosSec]) ? (
                                rcbl[its_Rdr_HighPosSec] = rcbl[its_Rdr_LowPosSec];
                                rcbl[its_Rdr_LowPosSec] = zi;
                            ) : (
                                rcbl[its_Rdr_HighPosSec] = zi;
                            );
                            rdupdt = 1;
                        );

                        // Region position (seconds)
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_play_S_Pos, pp_Min, 0);
                            parSetPP(p_play_S_Pos, pp_Max, clen);
                            parSetPP(p_play_S_Pos, pp_Step, 0.001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_play_S_Pos, pp_Min, max(0, rp - 10));
                            parSetPP(p_play_S_Pos, pp_Max, min(clen, rp + 10));
                            parSetPP(p_play_S_Pos, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_play_S_Pos, pp_Min, max(0, rp - 1));
                            parSetPP(p_play_S_Pos, pp_Max, min(clen, rp + 1));
                            parSetPP(p_play_S_Pos, pp_Step, 0.000001);
                        );
                        paramValues[p_play_S_Pos] = rcbl[its_Rdr_RegPosSec];
                        parSetPP(p_play_S_Pos, pp_Max, clen);
                        r = parCtl(p_play_S_Pos);
                        (r != 0) ? (
                            rcbl[its_Rdr_RegPosSec] = parV(p_play_S_Pos);
                            rdupdt = 1;
                        );

                        // region size (seconds)
                        // Play speed
                        k = RDBL[6];
                        (k === 0) ? (
                            parSetPP(p_play_S_Len, pp_Max, clen);
                            parSetPP(p_play_S_Len, pp_Step, 0.00001);
                        ) :
                        (k === 1) ? (
                            parSetPP(p_play_S_Len, pp_Max, 10);
                            parSetPP(p_play_S_Len, pp_Step, 0.00001);
                        ) :
                        (k === 2) ? (
                            parSetPP(p_play_S_Len, pp_Max, 1);
                            parSetPP(p_play_S_Len, pp_Step, 0.000001);
                        );
                        paramValues[p_play_S_Len] = rcbl[its_Rdr_RegSizeSec];
                        r = parCtl(p_play_S_Len);
                        (r != 0) ? (
                            rcbl[its_Rdr_RegSizeSec] = parV(p_play_S_Len);
                            rdupdt = 1;
                        );

                        // cross fade time (ms)
                        paramValues[p_play_XFade] = rcbl[its_Rdr_XFade_mSec];
                        r = parCtl(p_play_XFade);
                        (r != 0) ? (
                            rcbl[its_Rdr_XFade_mSec] = parV(p_play_XFade);
                            rdupdt = 1;
                        );
                    );

                    // zoom of the waveform (a display property : RDBL[9]), not in delay mode
                    ((rcbl[its_Rdr_Mode] !== its_RdrMode_Delay) && (h3 > 0)) ? (
                        paramValues[p_play_Zoom] = RDBL[9];
                        r = parCtl(p_play_Zoom);
                        (r != 0) ? (
                            RDBL[9] = (r === 8) ? 1 : max(1, min(100, parV(p_play_Zoom))); // right clic : zoom 1
                        );
                    );

                    // the depths of the modulation inputs used, their attenuverters if shown
                    its_Mod_Sliders(rcbl + its_Rdr_Mod1, 3, its_Rdr_ModOk(rcbl), p_rdModDepth1, p_rdModAtt1);

                ui_pop();

            ); // rok

            (rdupdt) ? (
                rcbl[its_Rdr_StFlgs] |= its_RdrFlg_Mod;
            );

        ui_pop();
    );
);


/*
   LDBL[0] = Line to display
   LDBL[1] = size in seconds
   LDBL[2] = channel count
   LDBL[5] = waveform height (0 : its_LinWaveH)
   LDBL[6] = waveform flags (its_WaveHide, its_WaveOver ; keys 'w', '+', '-', 'v' : see its_Wave_Keys)
*/
function show_Line_Pad(LDBL, blockId)
local (h1, h2, h3, h4, uix_jneed, uix_jmini, i, r, x, xx, zz, zzmi, jmc, lnr, lcbl, dfCol, zzch, zzent, zzmcl,
        zzmmd, p1, p2, nlnr, lgh, fsh)
(
    h1 = uix_jpadHeight(pad_Lin_NL); // height
    h4 = uix_jpadHeight(1); // the file of the line
    h2 = ui_jd_slidh * 1 + 4;
    // waveform, if the line exists (see mSL_ui_audio.jsfx-inc)
    lcbl = Lines_Set[LDBL[0]];
    h3 = ((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? its_Wave_H(LDBL + 5, LDBL + 6, its_LinWaveH) : 0;
    uix_jneed = h1+h4+h2+h3+ui_jd_ctgr;
    uix_jmini = h1+h4+h2+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(uix_jneed);
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            lnr = LDBL[0]; // number of line to be displayed
            lcbl = Lines_Set[lnr];
            lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            // 'd' : dump of the line in the log (taken before the pad)
            (zzmi && GM_key_take('d')) ? GM_Dump(lcbl, its_Lin_BlkSize, sprintf(#, "Line %d", lnr+1));
            (zzmi) ? its_Wave_Keys(LDBL + 5, LDBL + 6, its_LinWaveH);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Lin_Labs, pad_Lin_Siz);
                jmc = ui_jmouse_cap;

                CL1 = Color_Medium_Spring_Green;
                (lcbl === 0) ? (
                    // Line undefined
                    dfCol = Col_Inactive;
                    i = 0; loop(pad_Lin_Siz,
                        pad_Lin_Colrs[i] = dfCol;
                        strcpy(pad_Lin_Labs[i],"");
                        i += 1;
                    );
                    strcpy(pad_Lin_Labs[1],menu_Lin_Status_N[0]);
                    sprintf(pad_Lin_Labs[2], "Length %.3f s", LDBL[1]);
                    sprintf(pad_Lin_Labs[3], "%d spls.", floor(LDBL[1]*srate));
                    sprintf(pad_Lin_Labs[4], "%d chan.", LDBL[2]);
                    (Ln_MemErr[lnr]) ? (
                        strcpy(pad_Lin_Labs[6], "Err 2610 : memory");
                        pad_Lin_Colrs[6] = Col_Error;
                    );
                ) : (
                    // Line existing
                    dfCol = Color_Limegreen;
                    i = 0; loop(pad_Lin_Siz,
                        pad_Lin_Colrs[i] = dfCol;
                        strcpy(pad_Lin_Labs[i],"");
                        i += 1;
                    );
                    strcpy(pad_Lin_Labs[1],menu_Lin_Status_N[lcbl[its_Lin_Status]]);
                    sprintf(pad_Lin_Labs[2], "%.3f s", lcbl[its_Lin_SmplCntSec]);
                    sprintf(pad_Lin_Labs[3], "%d spls", lcbl[its_Lin_SmplCnt]);
                    sprintf(pad_Lin_Labs[4], "%d chan.", lcbl[its_Lin_ChCnt]);
                    sprintf(pad_Lin_Labs[5], "F. %d Hz", lcbl[its_Lin_RecFreq]);
                );
                (lok && (lcbl[its_Lin_Owner] > 0)) ? sprintf(pad_Lin_Labs[0],"Line %d (%s)", lnr+1, its_Al_OwnName(#its_OwnN, lcbl[its_Lin_Owner])) :
                    sprintf(pad_Lin_Labs[0],"Line %d", lnr+1);
                strcpy(pad_Lin_Labs[7],"Action");

                zz = control_jpad(pad_Line);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzch = pad_Line[ui_jpad_lkey];
                    zzent = pad_Line[ui_jpad_entkey]-1;
                    zzmcl = pad_Line[ui_jpad_last]-1;
                    zzmmd = pad_Line[ui_jpad_lmods];

                    (zz & ui_jpad_ev_rmc) ? (  // right mouse clic
                        (zzmcl === 0) ? (
                            k = lnr+1;
                            ui_menu_tick(menu_Lin_Ids, k, 1);
                            // also tick the header of the sub-menu that holds the current line (reset below by the tick -1)
                            lgh = menu_Lin_Ids[ui_jmenu_items + (0|(lnr / menu_Lin_Grp)) * (menu_Lin_Grp + 1)];
                            str_setchar(lgh, 1, '!');
                            xx = control_jmenu(menu_Lin_Ids);
                            (xx != 0) ? (
                                LDBL[0] = xx - 1; // select a new line to display
                            );
                            ui_menu_tick(menu_Lin_Ids, -1, 0);
                        ) :
                        (zzmcl === 1) ? (
                            (lcbl === 0) ? (
                                ui_menu_tick(menu_Lin_Status, 1, 1);
                                xx = control_jmenu(menu_Lin_Status);
                                (xx != 0) ? (
                                    (xx === 2) ? (
                                        // create the line
                                        Ln_Make(lnr, srate, LDBL[1], LDBL[2]);
                                    );
                                );
                                ui_menu_tick(menu_Lin_Status, -1, 0);
                            );
                        ) :
                        (zzmcl === 4) ? (
                            (lcbl === 0) ? (
                                k = max(1,LDBL[2]);
                                ui_menu_tick(menu_128_1_Ids, k, 1);
                                // also tick the header of the sub-menu that holds the current count (reset below by the tick -1)
                                (k >= 1) ? (
                                    lgh = menu_128_1_Ids[ui_jmenu_items + (0|((k - 1) / menu_128_Grp)) * (menu_128_Grp + 1)];
                                    str_setchar(lgh, 1, '!');
                                );
                                xx = control_jmenu(menu_128_1_Ids);
                                (xx != 0) ? (
                                    LDBL[2] = xx ; // actual channel count
                                    Ln_MemErr[lnr] = 0; // new request : no error yet
                                );
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 7) ? (
                            xx = control_jmenu(menu_Lin_Action);
                            (xx != 0) ? (
                                Ln_Action(lnr, xx - 1, LDBL);
                            );
                        );
                    );

                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        (zzmcl === 0) ? (
                            // the next line (shift : the previous one)
                            LDBL[0] = (jmc & shfCap) ? (lnr + LN_CNT - 1) % LN_CNT : (lnr + 1) % LN_CNT;
                        );
                    );
                    wrupdt = 1;
                );

            ui_pop();

            // The file of the line : a sound file dropped here is read into this line (Ln_Load_File) ; left clic : the full
            // path for its_LnFShowDur s (a second clic : the name again) ; right clic : menu (Reload, Forget the name, Path in the log)
            ui_split_top(h4);
                ui_pad(1,0,2,2);
                ((g__dpa != 0) && (g__msx >= ui_left()) && (g__msx < ui_left() + ui_width())
                    && (g__msy >= ui_top()) && (g__msy < ui_top() + ui_height())) ? (
                    g__dpa = 0;
                    sprintf(#s, "Line %d : file \"%s\"", lnr+1, g__efs);
                    mSL_log(SysLogBox, #s);
                    Ln_Load_File(lnr, g__efs); // (an error is logged)
                    lcbl = Lines_Set[lnr];
                    lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
                );
                mSL_setStrArray(pad_LnF_Labs, 1);
                fsh = (its_LnFShow === lnr) && (time_precise() < its_LnFShowT);
                (strlen(its_LnFile[lnr]) > 0) ? (
                    fsh ? strcpy(pad_LnF_Labs[0], its_LnFile[lnr]) : its_Ln_BaseName(pad_LnF_Labs[0], its_LnFile[lnr]);
                    pad_LnF_Colrs[0] = fsh ? Color_Goldenrod : Col_P3;
                ) : (
                    strcpy(pad_LnF_Labs[0], "No file");
                    pad_LnF_Colrs[0] = Col_P1;
                );
                fsh ? (ui_GFXdoNow |= 4); // (the name comes back after its_LnFShowDur s)
                zz = control_jpad(pad_LnF);
                ((zz > 0) && (strlen(its_LnFile[lnr]) > 0)) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    (zz & ui_jpad_ev_lmc) ? (
                        fsh ? (its_LnFShowT = 0) : (its_LnFShow = lnr; its_LnFShowT = time_precise() + its_LnFShowDur;);
                    ) :
                    (zz & ui_jpad_ev_rmc) ? (
                        xx = control_jmenu(menu_LnF_Action);
                        (xx === 1) ? (
                            strcpy(#its_LnFTmp, its_LnFile[lnr]); // (Ln_Load_File writes its_LnFile)
                            Ln_Load_File(lnr, #its_LnFTmp);
                            lcbl = Lines_Set[lnr];
                            lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
                        ) :
                        (xx === 2) ? (
                            strcpy(its_LnFile[lnr], "");
                        ) :
                        (xx === 3) ? (
                            sprintf(#s, "Line %d : file \"%s\"", lnr+1, its_LnFile[lnr]);
                            mSL_log(SysLogBox, #s);
                        );
                    );
                );
            ui_pop();

            // an audio file dropped elsewhere in the module : read into this line if it fits, into a new line otherwise
            (zzmi && (g__dpa != 0)) ? (
                sprintf(#s, "Line::drop file : \"%s\" - %d, %d, %d", g__efs, g__msx, g__msy, g__msc);
                mSL_log(SysLogBox, #s);
                g__dpa = 0;
                (!lok) ? (
                    p1 = p2 = -1;
                ) : (
                    p1 = lnr; p2 = lcbl;
                );
                nlnr = File_Handle(g__efs, p1, p2);
                (nlnr >= 0) ? (
                    lnr = LDBL[0] = nlnr;
                    lcbl = Lines_Set[lnr];
                    lok = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
                );
            );

            // Sliders
            ui_split_top(h2);
                zzmx = ui_hover();
                ui_pad(1,3,1,0);
                paramValues[p_lineSize] = zi = (lcbl === 0) ? LDBL[1] : lcbl[its_Lin_SmplCntSec];
                r = parCtl(p_lineSize);
                (r != 0) ? (
                    (r === 8) ? (
                        // right clic to reset
                        paramValues[p_lineSize] = 1;
                    );
                    (paramValues[p_lineSize] !== zi) ? (
                        (lcbl === 0) ? (
                            x = paramValues[p_lineSize];
                            LDBL[1] = (jmc & shfCap) ? floor(0.5 + x) : x; // on peut modifier
                            Ln_MemErr[lnr] = 0; // new request : no error yet
                        );
                    );
                    wrupdt = 1;
                );
            ui_pop();

            // Waveform of the line (all the channels buffers, the loudest ones)
            (lok && (h3 > 0) && (ui_height() > 8)) ? (
                ui_push();
                    ui_pad(1,2,1,2);
                    // heads of the writers and of all the readers of this line (numbered)
                    its_wave_marks(lcbl, -1);
                    // the samples are in [its_Lin_Start, its_Lin_Last) of each buffer (BF_LIM guard samples around)
                    ui_audio_wave(h3, lcbl[its_Lin_ChCnt], lcbl + its_Lin_BF1ST, lcbl[its_Lin_ActBSize],
                        lcbl[its_Lin_Start], lcbl[its_Lin_Last], its_Wave_Flags(LDBL + 6), its_LinWaveMax);
                ui_pop();
            );

        ui_pop();
    );
);


/*
    The part of the pad specific to a type : one function per type, "what" tells what to do
        FXP_Dims : set RDBL[3] (lines of the pad, the common line included) and RDBL[5] (count of sliders)
        FXP_Fill : labels and colors of the cells of the lines 1 ... RDBL[3]-1 (cells 8 ...)
        FXP_Click : event "ev" (ui_jpad_ev_...) on the cell "cell" (8 ...)
        FXP_Sliders : draw and handle the sliders
        FXP_Graph : draw and handle the graphic area (its height in RDBL[6], set by FXP_Dims ; 0 : none)
    After a modification, the function resets fx[its_Efx_Check] (the effect is checked again by exec_fx)
*/
FXP_Dims = 0;
FXP_Fill = 1;
FXP_Click = 2;
FXP_Sliders = 3;
FXP_Graph = 4;

/*
    the editor of the weights "hw" of the mode Cheb. sum, in the current rect : a bar per harmonic, in [-1, 1]
    left clic / drag : the weight at the height of the mouse (near 0 : 0) ; right clic / drag : 0 ; the bar under the mouse : its value
*/
function its_Harm_Edit(hw)
local (x0, y0, w, h, bw, hh, ym, k, v, b, act)
(
    ui_push();
        ui_pad(4, 2, 4, 2);
        x0 = ui_left(); y0 = ui_top(); w = ui_width(); h = ui_height();
        bw = w / its_SatHarm; hh = max(1, floor(h / 2) - 1); ym = y0 + floor(h / 2);
        // the mouse
        act = ((mouse_cap & 1) && uix_clickwasinside(1)) ? 1 : ((mouse_cap & 2) && uix_clickwasinside(2)) ? 2 : 0;
        (act) ? (
            k = max(0, min(its_SatHarm - 1, floor((uix_mouse_x - x0) / bw)));
            v = max(-1, min(1, (ym - uix_mouse_y) / hh));
            hw[k] = ((act === 2) || (abs(v) < 0.03)) ? 0 : v;
            ui_GFXdoNow |= 4; ui_GFXReason = 37;
        );
        // the bars
        ui_pcolor(0x808080, 0.15);
        gfx_rect(x0, y0, w, h);
        ui_pcolor(0x808080, 0.6);
        gfx_line(x0, ym, x0 + w - 1, ym);
        ui_pcolor(uix_theme_accent(), 0.85);
        k = 0; loop(its_SatHarm,
            b = floor(abs(hw[k]) * hh + 0.5);
            (b > 0) ? gfx_rect(x0 + floor(k * bw) + 1, (hw[k] > 0) ? ym - b : ym + 1, max(1, floor(bw) - 2), b);
            k += 1;
        );
        // the rank and the weight of the bar under the mouse
        ui_hover() ? (
            k = max(0, min(its_SatHarm - 1, floor((uix_mouse_x - x0) / bw)));
            ui_pcolor(0x909090, 1);
            gfx_x = x0 + 3; gfx_y = y0 + 2;
            gfx_drawstr(sprintf(#its_HarmTxt, "H%d : %.3f", k + 1, hw[k]));
        );
    ui_pop();
);

// Mixer and Auto Mixer : line 1 = the 8 sources (right clic : the source ; left clic : its first channel) ; the gains of the Mixer as sliders
function FX_Mixer_Pad(RDBL, fx, fxn, what, cell, ev)
local (i, k, p, r, zi, mix)
(
    mix = (fx[its_Efx_Type] === its_Efx_TyMixer); // the Auto Mixer computes its gains
    (what === FXP_Dims) ? (
        RDBL[3] = 3; // line 2 : the auto-limiter only (cell 23, see show_Effect_Pad)
        k = 0; p = fx + its_Efx_Src1;
        loop(8, (p[0] > 0) ? (k += 1); p += its_EfxDist;);
        RDBL[5] = mix ? k : 0;
    ) :
    (what === FXP_Fill) ? (
        i = 0; p = fx + its_Efx_Src1;
        loop(8,
            k = p[0];
            (k > 0) ? (
                its_Src_Label(pad_Efx_Labs[8 + i], k, p[its_Efx_Off1 - its_Efx_Src1]);
                pad_Efx_Colrs[8 + i] = Col_P3;
            ) : (
                sprintf(pad_Efx_Labs[8 + i], "Src %d", i + 1);
                pad_Efx_Colrs[8 + i] = Col_P1;
            );
            i += 1; p += its_EfxDist;
        );
    ) :
    (what === FXP_Click) ? (
        ((cell >= 8) && (cell < 16)) ? (
            p = fx + its_Efx_Src1 + (cell - 8) * its_EfxDist;
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(p[0], p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
                    p[0] = k;
                    p[its_Efx_Off1 - its_Efx_Src1] = its_Src_ChOff;
                    mix ? (fx[its_Efx_Check] = 0) : FX_Auto_Gains(fx);
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(p[its_Efx_Off1 - its_Efx_Src1])) >= 0) ? (
                    p[its_Efx_Off1 - its_Efx_Src1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        );
    ) :
    (what === FXP_Sliders) ? (
        mix ? (
            i = 0; p = fx + its_Efx_Src1;
            loop(8,
                (p[0] > 0) ? (
                    paramValues[p_fxGain1 + i] = p[its_Efx_VoldB1 - its_Efx_Src1];
                    r = parCtl(p_fxGain1 + i);
                    (r != 0) ? (
                        zi = (r === 8) ? 0 : parV(p_fxGain1 + i); // right clic : 0 dB
                        p[its_Efx_VoldB1 - its_Efx_Src1] = zi;
                        fx[its_Efx_Check] = 0; // exec_fx computes the linear gain
                    );
                );
                i += 1; p += its_EfxDist;
            );
        );
    );
);

// LFO : line 1, cell 8 = the shape (left clic : the next one ; right clic : menu) ; sliders : frequency, amplitude, offset,
// phase spread between the channels (Par1, Par3, Par4, Par5 : read at each sample, no check needed)
function FX_LFO_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx, pw)
(
    (what === FXP_Dims) ? (
        RDBL[3] = 2;
        RDBL[5] = 4;
    ) :
    (what === FXP_Fill) ? (
        strcpy(pad_Efx_Labs[8], menu_Efx_LfoShape_N[max(0, min(4, fx[its_Efx_Par1 + 1]))]);
        pad_Efx_Colrs[8] = Col_P3;
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_LfoShape, -1, 0);
                ui_menu_tick(menu_Efx_LfoShape, fx[its_Efx_Par1 + 1] + 1, 1);
                xx = control_jmenu(menu_Efx_LfoShape);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_LfoShape, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (fx[its_Efx_Par1 + 1] + 1) % 5;
            );
        );
    ) :
    (what === FXP_Sliders) ? (
        k = 0; loop(4,
            pw = its_Efx_Par1 + ((k === 0) ? 0 : k + 1); // Par1, Par3, Par4, Par5
            paramValues[p_fxLfoFreq + k] = fx[pw];
            r = parCtl(p_fxLfoFreq + k);
            (r != 0) ? (
                // right clic : 1 Hz, amplitude 1, no offset, no spread
                fx[pw] = (r === 8) ? ((k === 0) ? 1 : (k === 1) ? 1 : 0) : parV(p_fxLfoFreq + k);
            );
            k += 1;
        );
    );
);

// Filter : line 1, cell 8 = the source (right clic : menu ; left clic : its first channel), cell 9 = the mode (left clic :
// the next one ; right clic : menu), cell 10 = the slope (left clic : the next one ; right clic : the previous one) ;
// line 2 : the modulation inputs (cutoff, resonance) ; sliders : cutoff, resonance, input gain, and the modulations used
function FX_Filter_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx, zi, ns, md)
(
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 3 + its_Mod_SlCount(fx + its_Efx_Mod1, 2, 3);
    ) :
    (what === FXP_Fill) ? (
        (fx[its_Efx_Src1] !== 0) ? (
            its_Src_Label(pad_Efx_Labs[8], fx[its_Efx_Src1], fx[its_Efx_Off1]);
            pad_Efx_Colrs[8] = Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[8], "Source");
            pad_Efx_Colrs[8] = Col_P1;
        );
        strcpy(pad_Efx_Labs[9], menu_Efx_FltMode_N[max(0, min(5, fx[its_Efx_Par1 + 2]))]);
        pad_Efx_Colrs[9] = Col_P3;
        ns = its_Flt_Stages(fx);
        md = fx[its_Efx_Par1 + 2];
        (md === its_FltNotch) ? sprintf(pad_Efx_Labs[10], "%d stage%s", ns, (ns > 1) ? "s" : "") :
            sprintf(pad_Efx_Labs[10], "%d dB/oct", ((md === its_FltLP) || (md === its_FltHP)) ? 12 * ns : 6 * ns);
        pad_Efx_Colrs[10] = Col_P3;
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 2, its_ModN_Flt, 3);
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(fx[its_Efx_Src1], fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Src1] = k;
                    fx[its_Efx_Off1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Off1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 9) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_FltMode, -1, 0);
                ui_menu_tick(menu_Efx_FltMode, fx[its_Efx_Par1 + 2] + 1, 1);
                xx = control_jmenu(menu_Efx_FltMode);
                (xx != 0) ? (fx[its_Efx_Par1 + 2] = xx - 1);
                ui_menu_tick(menu_Efx_FltMode, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 2] = (fx[its_Efx_Par1 + 2] + 1) % 6;
            );
        ) :
        (cell === 10) ? (
            k = max(0, min(its_FltSlopes - 1, floor(fx[its_Efx_Par1 + 3])));
            (ev & ui_jpad_ev_rmc) ? (fx[its_Efx_Par1 + 3] = (k + its_FltSlopes - 1) % its_FltSlopes) :
            (ev & ui_jpad_ev_lmc) ? (fx[its_Efx_Par1 + 3] = (k + 1) % its_FltSlopes);
        ) :
        ((cell === 17) || (cell === 18)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Flt) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // cutoff, resonance : read at each sample
        paramValues[p_fxFltFreq] = fx[its_Efx_Par1];
        r = parCtl(p_fxFltFreq);
        (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? 1000 : parV(p_fxFltFreq));
        paramValues[p_fxFltQ] = fx[its_Efx_Par1 + 1];
        r = parCtl(p_fxFltQ);
        (r != 0) ? (fx[its_Efx_Par1 + 1] = (r === 8) ? 0.707 : parV(p_fxFltQ));
        // input gain : its linear value is computed by the check
        paramValues[p_fxGain1] = fx[its_Efx_VoldB1];
        r = parCtl(p_fxGain1);
        (r != 0) ? (
            fx[its_Efx_VoldB1] = (r === 8) ? 0 : parV(p_fxGain1);
            fx[its_Efx_Check] = 0;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 2, 3, p_fxFltModD1, p_fxFltModA1);
    );
);

// Saturation : line 1, cell 8 = the source (right clic : menu ; left clic : its first channel), cell 9 = the mode (left clic :
// the next one ; right clic : menu), cell 10 = the oversampling (left clic : the next one ; right clic : the previous one) ;
// cell 11 (mode Cheb. sum) = the presets of the weights (menu) ; line 2 : the modulation inputs (drive, bias, order or stretch) ;
// sliders : drive, bias, mix, output, order (modes x - A sin, Chebyshev) and A (x - A sin) or stretch (Cheb. sum), input gain, and the modulations
// used ; the graphic area (Cheb. sum) : the editor of the weights of the harmonics
function FX_Sat_Pad(RDBL, fx, fxn, what, cell, ev)
local (k, r, xx)
(
    (what === FXP_Dims) ? (
        RDBL[3] = 3;
        RDBL[5] = 5 + (fx[its_Efx_Par1 + 1] >= its_SatXSin) + (fx[its_Efx_Par1 + 1] === its_SatXSin) + its_Mod_SlCount(fx + its_Efx_Mod1, 3, its_Sat_ModOk(fx));
        RDBL[6] = (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? its_HarmH : 0;
    ) :
    (what === FXP_Fill) ? (
        (fx[its_Efx_Src1] !== 0) ? (
            its_Src_Label(pad_Efx_Labs[8], fx[its_Efx_Src1], fx[its_Efx_Off1]);
            pad_Efx_Colrs[8] = Col_P3;
        ) : (
            strcpy(pad_Efx_Labs[8], "Source");
            pad_Efx_Colrs[8] = Col_P1;
        );
        strcpy(pad_Efx_Labs[9], menu_Efx_SatMode_N[max(0, min(its_SatModeCnt - 1, fx[its_Efx_Par1 + 1]))]);
        pad_Efx_Colrs[9] = Col_P3;
        sprintf(pad_Efx_Labs[10], "Oversampling %dx", 2^max(0, min(its_SatOSCnt - 1, floor(fx[its_Efx_Par1 + 4]))));
        pad_Efx_Colrs[10] = Col_P3;
        (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? (
            strcpy(pad_Efx_Labs[11], "Harmonics");
            pad_Efx_Colrs[11] = Col_P3;
        );
        strcpy(pad_Efx_Labs[16], "Modulation");
        its_ModN_Sat[2] = (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? "Stretch" : "Order";
        its_Mod_Fill(pad_Efx_Labs, pad_Efx_Colrs, 17, fx + its_Efx_Mod1, 3, its_ModN_Sat, its_Sat_ModOk(fx));
    ) :
    (what === FXP_Click) ? (
        (cell === 8) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ((k = its_Src_Choose(fx[its_Efx_Src1], fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Src1] = k;
                    fx[its_Efx_Off1] = its_Src_ChOff;
                    fx[its_Efx_Check] = 0;
                );
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                ((k = its_Off_Choose(fx[its_Efx_Off1])) >= 0) ? (
                    fx[its_Efx_Off1] = k;
                    fx[its_Efx_Check] = 0;
                );
            );
        ) :
        (cell === 9) ? (
            (ev & ui_jpad_ev_rmc) ? (
                ui_menu_tick(menu_Efx_SatMode, -1, 0);
                ui_menu_tick(menu_Efx_SatMode, fx[its_Efx_Par1 + 1] + 1, 1);
                xx = control_jmenu(menu_Efx_SatMode);
                (xx != 0) ? (fx[its_Efx_Par1 + 1] = xx - 1);
                ui_menu_tick(menu_Efx_SatMode, -1, 0);
            ) :
            (ev & ui_jpad_ev_lmc) ? (
                fx[its_Efx_Par1 + 1] = (fx[its_Efx_Par1 + 1] + 1) % its_SatModeCnt;
            );
        ) :
        (cell === 10) ? (
            k = max(0, min(its_SatOSCnt - 1, floor(fx[its_Efx_Par1 + 4])));
            (ev & ui_jpad_ev_rmc) ? (fx[its_Efx_Par1 + 4] = (k + its_SatOSCnt - 1) % its_SatOSCnt) :
            (ev & ui_jpad_ev_lmc) ? (fx[its_Efx_Par1 + 4] = (k + 1) % its_SatOSCnt);
        ) :
        ((cell === 11) && (fx[its_Efx_Par1 + 1] === its_SatChebSum)) ? (
            xx = control_jmenu(menu_Efx_Harm);
            (xx != 0) ? its_Harm_Preset(fx + its_Efx_Harm1, xx - 1);
        ) :
        ((cell >= 17) && (cell <= 19)) ? (
            its_Mod_Click(fx + its_Efx_Mod1, cell - 17, ev, its_PadJmc, its_ModD_Sat) ? (fx[its_Efx_Check] = 0);
        );
    ) :
    (what === FXP_Sliders) ? (
        // drive, bias, mix, output : read at each sample
        paramValues[p_fxSatDrive] = fx[its_Efx_Par1];
        r = parCtl(p_fxSatDrive);
        (r != 0) ? (fx[its_Efx_Par1] = (r === 8) ? 12 : parV(p_fxSatDrive));
        paramValues[p_fxSatBias] = fx[its_Efx_Par1 + 2];
        r = parCtl(p_fxSatBias);
        (r != 0) ? (fx[its_Efx_Par1 + 2] = (r === 8) ? 0 : parV(p_fxSatBias));
        paramValues[p_fxSatMix] = 100 * fx[its_Efx_Par1 + 3];
        r = parCtl(p_fxSatMix);
        (r != 0) ? (fx[its_Efx_Par1 + 3] = (r === 8) ? 1 : parV(p_fxSatMix) / 100);
        paramValues[p_fxSatOut] = fx[its_Efx_Par1 + 5];
        r = parCtl(p_fxSatOut);
        (r != 0) ? (fx[its_Efx_Par1 + 5] = (r === 8) ? 0 : parV(p_fxSatOut));
        (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? (
            paramValues[p_fxSatStretch] = fx[its_Efx_Par1 + 7];
            r = parCtl(p_fxSatStretch);
            (r != 0) ? (fx[its_Efx_Par1 + 7] = (r === 8) ? 1 : parV(p_fxSatStretch));
        ) :
        (fx[its_Efx_Par1 + 1] >= its_SatXSin) ? (
            paramValues[p_fxSatOrder] = fx[its_Efx_Par1 + 6];
            r = parCtl(p_fxSatOrder);
            (r != 0) ? (fx[its_Efx_Par1 + 6] = (r === 8) ? 3 : parV(p_fxSatOrder));
            (fx[its_Efx_Par1 + 1] === its_SatXSin) ? (
                paramValues[p_fxSatAmp] = fx[its_Efx_Par1 + 8];
                r = parCtl(p_fxSatAmp);
                (r != 0) ? (fx[its_Efx_Par1 + 8] = (r === 8) ? 1 : parV(p_fxSatAmp));
            );
        );
        // input gain : its linear value is computed by the check
        paramValues[p_fxGain1] = fx[its_Efx_VoldB1];
        r = parCtl(p_fxGain1);
        (r != 0) ? (
            fx[its_Efx_VoldB1] = (r === 8) ? 0 : parV(p_fxGain1);
            fx[its_Efx_Check] = 0;
        );
        its_Mod_Sliders(fx + its_Efx_Mod1, 3, its_Sat_ModOk(fx), p_fxSatModD1, p_fxSatModA1);
    ) :
    (what === FXP_Graph) ? (
        (fx[its_Efx_Par1 + 1] === its_SatChebSum) ? its_Harm_Edit(fx + its_Efx_Harm1);
    );
);

// the dispatcher : calls the function of the type of the effect (a type without function : the common line only)
function FX_Type_Pad(RDBL, fx, fxn, what, cell, ev)
local (ty)
(
    ty = fx[its_Efx_Type];
    ((ty === its_Efx_TyMixer) || (ty === its_Efx_TyAutoMix)) ? (
        FX_Mixer_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyLFO) ? (
        FX_LFO_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TyFilter) ? (
        FX_Filter_Pad(RDBL, fx, fxn, what, cell, ev);
    ) :
    (ty === its_Efx_TySat) ? (
        FX_Sat_Pad(RDBL, fx, fxn, what, cell, ev);
    ) : (
        (what === FXP_Dims) ? (RDBL[3] = 1; RDBL[5] = 0;);
    );
);

/*
    RDBL[0] : number of the effect to display
    RDBL[3] : lines of the pad (set by the function of the type)
    RDBL[5] : count of sliders (set by the function of the type)
    Line 0, common to all types :
        0 effect number (left clic : next one, shift : previous one ; right clic : menu)
        1 type (right clic : menu ; creates the effect if needed)
        2 phase (left clic : next one ; right clic : menu)
        3 On / Off / Bypass (left clic : On / Off ; right clic : Bypass / On)
        4 channel count (right clic : menu)
        5 output : own cable, Out or a bus (right clic : menu ; left clic : first channel in the bus)
        6 error (last error of exec_fx)
        7 actions (right clic : menu)
    Lines 1 ... 3 and the sliders : the function of the type (FX_Type_Pad) ; cell 23 (not the LFO) : the auto-limiter
        (clic : On / Off ; On : the gain reduction in dB)
    Key 'd' : dump of the effect in the log
*/
function show_Effect_Pad(RDBL, blockId)
local (h1, h2, h3, uix_jneed, zzmi, jmc, fxn, fx, fok, dfCol, CL1, i, k, r, xx, wgh, zz, zzmcl, act)
(
    fxn = RDBL[0]; // number of the effect to be displayed
    fx = Effects_set[fxn];
    fok = (fx > BASE_MEMORY) && (fx[-2] === KW_effx);
    RDBL[6] = 0; // graphic area : set by the type
    fok ? FX_Type_Pad(RDBL, fx, fxn, FXP_Dims, 0, 0) : (RDBL[3] = 1; RDBL[5] = 0;);
    h1 = uix_jpadHeight(RDBL[3]);
    h2 = (RDBL[5] > 0) ? ui_jd_slidh * RDBL[5] + 6 : 0;
    h3 = RDBL[6];
    uix_jneed = h1+h2+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            // 'd' : dump of the effect in the log (taken before the pad)
            (zzmi && fok && GM_key_take('d')) ? GM_Dump(fx, its_Efx_BlkSize, sprintf(#, "Effect %d", fxn+1));
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
                (g__dpa != 0) ? (
                    // audio file droped here : ignored (but consumed)
                    sprintf(#s, "Effect::drop file : \"%s\" - %d, %d, %d", g__efs, g__msx, g__msy, g__msc);
                    mSL_log(SysLogBox, #s);
                    g__dpa = 0;
                );
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Efx_Labs, pad_Efx_Siz);
                CL1 = Color_Cornflower_Blue;
                dfCol = fok ? Col_InfoA : Col_Inactive;
                i = 0; loop(pad_Efx_Siz,
                    pad_Efx_Colrs[i] = dfCol;
                    strcpy(pad_Efx_Labs[i],"");
                    i += 1;);
                (fok && (fx[its_Efx_Owner] > 0)) ? sprintf(pad_Efx_Labs[0],"Effect %d (%s)", fxn+1, its_Al_OwnName(#its_OwnN, fx[its_Efx_Owner])) :
                    sprintf(pad_Efx_Labs[0],"Effect %d", fxn+1);
                (fok) ? (
                    strcpy(pad_Efx_Labs[1], menu_Efx_Type_N[max(0, min(its_Efx_TyCnt - 1, fx[its_Efx_Type]))]);
                    pad_Efx_Colrs[1] = Col_P3;
                    strcpy(pad_Efx_Labs[2], menu_Efx_PhShort_N[max(0, min(2, fx[its_Efx_Phase]))]);
                    pad_Efx_Colrs[2] = CL1;
                    (fx[its_Efx_Status] === its_EfxStat_Bypass) ? (
                        strcpy(pad_Efx_Labs[3], "Bypass");
                        pad_Efx_Colrs[3] = Color_Goldenrod;
                    ) :
                    (fx[its_Efx_Status] !== its_EfxStat_Off) ? (
                        strcpy(pad_Efx_Labs[3], "On");
                        pad_Efx_Colrs[3] = Color_Limegreen;
                    ) : (
                        strcpy(pad_Efx_Labs[3], "Off");
                        pad_Efx_Colrs[3] = Color_Dark_Orange;
                    );
                    sprintf(pad_Efx_Labs[4], "Channels %d", fx[its_Efx_CCnt]);
                    pad_Efx_Colrs[4] = Color_Heliotrope;
                    its_Out_Label(pad_Efx_Labs[5], fx[its_Efx_OutK], fx[its_Efx_OutOff]);
                    pad_Efx_Colrs[5] = Col_P3;
                    (fx[its_Efx_Status] === its_EfxStat_Off) ? (
                        strcpy(pad_Efx_Labs[6], "---");
                    ) :
                    ((k = fx[its_Efx_Error]) !== 0) ? (
                        sprintf(pad_Efx_Labs[6], "Err: %04d", k);
                        pad_Efx_Colrs[6] = Col_P6;
                    ) :
                    (fx[its_Efx_Check] === BLOCK_CHECK) ? (
                        strcpy(pad_Efx_Labs[6], "OK");
                        pad_Efx_Colrs[6] = Color_Limegreen;
                    ) : (
                        strcpy(pad_Efx_Labs[6], "...");
                    );
                    FX_Type_Pad(RDBL, fx, fxn, FXP_Fill, 0, 0);
                    (fx[its_Efx_Type] !== its_Efx_TyLFO) ? (
                        (fx[its_Efx_Lim]) ? (
                            sprintf(pad_Efx_Labs[23], "Limiter %.1f dB", -20 * log10(max(1, fx[its_Efx_LimEnv])));
                            pad_Efx_Colrs[23] = (fx[its_Efx_LimEnv] > 1.012) ? Color_Goldenrod : Color_Limegreen; // > 0.1 dB
                        ) : (
                            strcpy(pad_Efx_Labs[23], "Limiter Off");
                            pad_Efx_Colrs[23] = Col_P1;
                        );
                    );
                ) : (
                    strcpy(pad_Efx_Labs[1], menu_Efx_Type_N[0]);
                    pad_Efx_Colrs[1] = Col_P1;
                );
                strcpy(pad_Efx_Labs[7],"Action");
                pad_Efx_Colrs[7] = Col_P1;

                its_PadJmc = jmc; // mouse modifiers, for the functions of the types (see its_Mod_Click)
                zz = control_jpad(pad_Effect, RDBL[3], -1, 1);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzmcl = pad_Effect[ui_jpad_last]-1;

                    (zz & ui_jpad_ev_rmc) ? (  // right mouse clic
                        ((zzmcl === 3) && fok) ? (
                            fx[its_Efx_Status] = (fx[its_Efx_Status] !== its_EfxStat_Bypass) ? its_EfxStat_Bypass : its_EfxStat_On;
                        ) :
                        (zzmcl === 0) ? (
                            // the effect to display
                            ui_menu_tick(menu_Efx_Ids, fxn+1, 1);
                            // also tick the header of the sub-menu that holds the current effect (reset below by the tick -1)
                            wgh = menu_Efx_Ids[ui_jmenu_items + (0|(fxn / menu_Efx_Grp)) * (menu_Efx_Grp + 1)];
                            str_setchar(wgh, 1, '!');
                            xx = control_jmenu(menu_Efx_Ids);
                            (xx != 0) ? (
                                RDBL[0] = xx - 1; // select a new effect to display
                            );
                            ui_menu_tick(menu_Efx_Ids, -1, 0);
                        ) :
                        (zzmcl === 1) ? (
                            // the type (the effect is created if needed)
                            ui_menu_tick(menu_Efx_Type, -1, 0);
                            ui_menu_tick(menu_Efx_Type, (fok ? fx[its_Efx_Type] : 0) + 1, 1);
                            xx = control_jmenu(menu_Efx_Type);
                            (xx != 0) ? (
                                (!fok) ? (fx = FX_make(fxn); fok = 1;);
                                FX_Set_Type(fx, xx - 1);
                            );
                            ui_menu_tick(menu_Efx_Type, -1, 0);
                        ) :
                        ((zzmcl === 2) && fok) ? (
                            ui_menu_tick(menu_Efx_Phase, -1, 0);
                            ui_menu_tick(menu_Efx_Phase, fx[its_Efx_Phase] + 1, 1);
                            xx = control_jmenu(menu_Efx_Phase);
                            (xx != 0) ? (
                                fx[its_Efx_Phase] = xx - 1;
                            );
                            ui_menu_tick(menu_Efx_Phase, -1, 0);
                        ) :
                        ((zzmcl === 4) && fok) ? (
                            k = fx[its_Efx_CCnt];
                            ui_menu_tick(menu_128_1_Ids, -1, 0);
                            ui_menu_tick(menu_128_1_Ids, k, 1);
                            // also tick the header of the sub-menu that holds the current count (reset below by the tick -1)
                            (k >= 1) ? (
                                wgh = menu_128_1_Ids[ui_jmenu_items + (0|((k - 1) / menu_128_Grp)) * (menu_128_Grp + 1)];
                                str_setchar(wgh, 1, '!');
                            );
                            xx = control_jmenu(menu_128_1_Ids); // select a count
                            (xx != 0) ? (
                                fx[its_Efx_CCnt] = xx;
                                fx[its_Efx_Check] = 0;
                            );
                            ui_menu_tick(menu_128_1_Ids, -1, 0);
                        ) :
                        ((zzmcl === 5) && fok) ? (
                            ((k = its_Dst_Choose(fx[its_Efx_OutK], fx[its_Efx_OutOff])) >= 0) ? (
                                fx[its_Efx_OutK] = k;
                                fx[its_Efx_OutOff] = its_Src_ChOff;
                                fx[its_Efx_Check] = 0;
                            );
                        ) :
                        (zzmcl === 7) ? (
                            xx = control_jmenu(menu_Efx_Action);
                            act = xx - 1;
                            (act === its_EfxAct_Create) ? (
                                (!fok) ? FX_make(fxn);
                            ) :
                            (!fok) ? (
                                0; // the other actions need an effect
                            ) :
                            (act === its_EfxAct_Copy) ? (
                                (Effects_set[FX_CNT] === 0) ? FX_make(FX_CNT); // the reserve
                                FX_Copy(Effects_set[FX_CNT], fx);
                            ) :
                            (act === its_EfxAct_Paste) ? (
                                (Effects_set[FX_CNT] !== 0) ? (
                                    FX_Copy(fx, Effects_set[FX_CNT]);
                                    fx[its_Efx_Numb] = fxn;
                                    fx[its_Efx_Check] = 0;
                                );
                            ) :
                            (act === its_EfxAct_Clear) ? (
                                FX_Clear(fxn);
                            ) :
                            (act === its_EfxAct_AutoGains) ? (
                                FX_Auto_Gains(fx);
                            ) :
                            (act === its_EfxAct_Show) ? (
                                GM_Dump(fx, its_Efx_BlkSize, sprintf(#, "Effect %d", fxn+1));
                            ) :
                            (act === its_EfxAct_Delete) ? (
                                FX_Delete(fxn);
                                fok = 0;
                            );
                        ) :
                        ((zzmcl === 23) && fok && (fx[its_Efx_Type] !== its_Efx_TyLFO)) ? (
                            // the auto-limiter : On / Off
                            fx[its_Efx_Lim] = !fx[its_Efx_Lim];
                            fx[its_Efx_LimEnv] = 0;
                        ) :
                        ((zzmcl >= 8) && fok) ? (
                            FX_Type_Pad(RDBL, fx, fxn, FXP_Click, zzmcl, zz);
                        );
                    );

                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        (zzmcl === 0) ? (
                            // the next effect (shift : the previous one)
                            RDBL[0] = (jmc & shfCap) ? (fxn + FX_CNT - 1) % FX_CNT : (fxn + 1) % FX_CNT;
                        ) :
                        ((zzmcl === 2) && fok) ? (
                            fx[its_Efx_Phase] = (fx[its_Efx_Phase] + 1) % 3;
                        ) :
                        ((zzmcl === 3) && fok) ? (
                            fx[its_Efx_Status] = (fx[its_Efx_Status] === its_EfxStat_On) ? its_EfxStat_Off : its_EfxStat_On;
                        ) :
                        ((zzmcl === 5) && fok) ? (
                            ((k = its_Off_Choose(fx[its_Efx_OutOff])) >= 0) ? (
                                fx[its_Efx_OutOff] = k;
                                fx[its_Efx_Check] = 0;
                            );
                        ) :
                        ((zzmcl === 23) && fok && (fx[its_Efx_Type] !== its_Efx_TyLFO)) ? (
                            // the auto-limiter : On / Off
                            fx[its_Efx_Lim] = !fx[its_Efx_Lim];
                            fx[its_Efx_LimEnv] = 0;
                        ) :
                        ((zzmcl >= 8) && fok) ? (
                            FX_Type_Pad(RDBL, fx, fxn, FXP_Click, zzmcl, zz);
                        );
                    );
                );
            ui_pop();

            // Graphic area of the type (the pad may have changed the effect)
            fx = Effects_set[RDBL[0]];
            ((h3 > 0) && (RDBL[0] === fxn) && (fx > BASE_MEMORY) && (fx[-2] === KW_effx)) ? (
                ui_split_top(h3);
                    FX_Type_Pad(RDBL, fx, fxn, FXP_Graph, 0, 0);
                ui_pop();
            );

            // Sliders of the type (the pad may have changed the effect)
            fx = Effects_set[RDBL[0]];
            ((h2 > 0) && (RDBL[0] === fxn) && (fx > BASE_MEMORY) && (fx[-2] === KW_effx)) ? (
                ui_split_top(h2);
                    ui_pad(1,3,1,0);
                    FX_Type_Pad(RDBL, fx, fxn, FXP_Sliders, 0, 0);
                ui_pop();
            );

        ui_pop();
    );
);

/*
    WDBL[0] : number of writer to display
    WDBL[5] : waveform height (0 : its_LinWaveH) ; WDBL[6] : waveform flags (its_WaveHide, its_WaveOver)
    The pad (2 lines of 8 cells), the waveform of the line of the writer (if any), the sliders (record gain, overdub)
    Key 'd' : dump of the writer in the log ; keys 'w', '+', '-', 'v' : the waveform (see its_Wave_Keys)
    Cells : 0 writer number (left clic : next one, shift : previous one), 1 status, 3 line, 4 size, 5 channels, 6 first channel written, 7 channels used,
            10 source (right clic : menu ; left clic : first channel taken), 11 write position (s), 12 overdub mode (left clic : X-fade / Sum),
            15 actions (right clic : menus)
*/
function show_Writer_Pad(WDBL, blockId)
local (h1, h2, h3, h4, uix_jneed, uix_jmini, zzmi, jmc, wrt, wcbl, wok, lcbl, lok, CL1, dfCol, i, k, r, w, x, xx, zi, zz, zzch,
        zzent, zzmcl, zzmmd, wgh, f, n)
(
    h1 = uix_jpadHeight(pad_Wrt_NL); // height
    wrt = WDBL[0]; // number of writer to be displayed
    wcbl = Writers_set[wrt];
    wok = (wcbl > BASE_MEMORY) && (wcbl[-2] === KW_writ);
    lcbl = wok ? wcbl[its_Wrt_Lcbl] : 0;
    lok = wok && (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
    // sliders : record gain, overdub, and the modulations used
    h2 = wok ? ui_jd_slidh * (2 + its_Mod_SlCount(wcbl + its_Wrt_Mod1, 2, 3)) + 6 : 0;
    h3 = lok ? its_Wave_H(WDBL + 5, WDBL + 6, its_LinWaveH) : 0; // waveform of the line, between the pad and the sliders
    h4 = wok ? uix_jpadHeight(1) : 0; // the modulation inputs
    uix_jneed = h1+h2+h3+h4+ui_jd_ctgr;
    uix_jmini = h1+h2+h4+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(min(uix_jneed, ui_height()));
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            // 'd' : dump of the writer in the log (taken before the pad)
            (zzmi && GM_key_take('d')) ? GM_Dump(wcbl, its_Wrt_BlkSize, sprintf(#, "Writer %d", wrt+1));
            (zzmi) ? its_Wave_Keys(WDBL + 5, WDBL + 6, its_LinWaveH);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Wrt_Labs, pad_Wrt_Siz);
                CL1 = Color_Cornflower_Blue;
                dfCol = wok ? Col_InfoA : Col_Inactive;
                i = 0; loop(pad_Wrt_Siz,
                    pad_Wrt_Colrs[i] = dfCol;
                    strcpy(pad_Wrt_Labs[i],"");
                    i += 1;);
                (wok && (wcbl[its_Wrt_Owner] > 0)) ? sprintf(pad_Wrt_Labs[0],"Writer %d (%s)", wrt+1, its_Al_OwnName(#its_OwnN, wcbl[its_Wrt_Owner])) :
                    sprintf(pad_Wrt_Labs[0],"Writer %d", wrt+1);
                (wok) ? (
                    strcpy(pad_Wrt_Labs[1],menu_Wrt_Status_N[wcbl[its_Wrt_Status]]);
                    // status : Ready (blue), Paused (orange), Writing (green), else the default color (as for the readers)
                    k = wcbl[its_Wrt_Status];
                    pad_Wrt_Colrs[1] = (k === its_WrtStat_Ready) ? Color_Light_Steel_Blue :
                        (k === its_WrtStat_Paused) ? Color_Dark_Orange :
                        (k === its_WrtStat_Writing) ? Color_Limegreen : dfCol;
                    (lok) ? (
                        // the channels written, as in exec_writer
                        f = max(0, min(wcbl[its_Wrt_ChNbr] - 1, wcbl[its_Wrt_Bf1stChan]));
                        n = wcbl[its_Wrt_ChNbr] - f;
                        (wcbl[its_Wrt_BfChanUsed] > 0) ? (n = min(n, wcbl[its_Wrt_BfChanUsed]));
                        sprintf(pad_Wrt_Labs[3], "Line %d", wcbl[its_Wrt_LineNb]+1);
                        sprintf(pad_Wrt_Labs[4], "Size %.3f s", floor(1000*wcbl[its_Wrt_SmplCnt]/srate)/1000);
                        sprintf(pad_Wrt_Labs[5], "Channels %d", wcbl[its_Wrt_ChNbr]);
                        sprintf(pad_Wrt_Labs[6], "First %d", f);
                        sprintf(pad_Wrt_Labs[7], "Used %d", n);
                        sprintf(pad_Wrt_Labs[11], "Pos %.3f s", (wcbl[its_Wrt_Abspos] - wcbl[its_Wrt_Start]) / srate);
                        pad_Wrt_Colrs[3] = pad_Wrt_Colrs[4] = pad_Wrt_Colrs[5] =
                        pad_Wrt_Colrs[6] = pad_Wrt_Colrs[7] = Color_Heliotrope;
                        pad_Wrt_Colrs[11] = CL1;
                    ) : (
                        strcpy(pad_Wrt_Labs[3],"Line: None");
                    );
                    its_Src_Label(pad_Wrt_Labs[10], wcbl[its_Wrt_Src], wcbl[its_Wrt_SrcOff]);
                    pad_Wrt_Colrs[10] = Col_P3;
                    strcpy(pad_Wrt_Labs[12], (wcbl[its_Wrt_Mode] === its_WrtMode_Sum) ? "Overdub Sum" : "Overdub X-fade");
                    pad_Wrt_Colrs[12] = CL1;
                ) : (
                    strcpy(pad_Wrt_Labs[1],menu_Wrt_Status_N[0]);
                    strcpy(pad_Wrt_Labs[3],"Line: None");
                );
                strcpy(pad_Wrt_Labs[15],"Action");
                pad_Wrt_Colrs[15] = Col_P1;

                zz = control_jpad(pad_Writer);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzch = pad_Writer[ui_jpad_lkey];
                    zzent = pad_Writer[ui_jpad_entkey]-1;
                    zzmcl = pad_Writer[ui_jpad_last]-1;
                    zzmmd = pad_Writer[ui_jpad_lmods];

                    (zz & ui_jpad_ev_rmc) ? (  // right mouse clic
                        (zzmcl === 0) ? (
                            // the writer to display
                            k = wrt+1;
                            ui_menu_tick(menu_Wrt_Ids, k, 1);
                            // also tick the header of the sub-menu that holds the current writer (reset below by the tick -1)
                            wgh = menu_Wrt_Ids[ui_jmenu_items + (0|(wrt / menu_Wrt_Grp)) * (menu_Wrt_Grp + 1)];
                            str_setchar(wgh, 1, '!');
                            xx = control_jmenu(menu_Wrt_Ids);
                            (xx != 0) ? (
                                WDBL[0] = xx - 1; // select a new writer to display
                            );
                            ui_menu_tick(menu_Wrt_Ids, -1, 0);
                        ) :
                        (zzmcl === 1) ? (
                            (wok) ? (
                                k = wcbl[its_Wrt_Status]+1;
                                ui_menu_tick(menu_Wrt_Status, -1, 0);
                                ui_menu_tick(menu_Wrt_Status, k, 1);
                                xx = control_jmenu(menu_Wrt_Status);
                                (xx != 0) ? (
                                    r = Wr_Set_Status(wrt, xx - 1);
                                );
                                ui_menu_tick(menu_Wrt_Status, -1, 0);
                            );
                        ) :
                        (zzmcl === 3) ? (
                            // the line written (the writer is created if needed)
                            k = (wok) ? wcbl[its_Wrt_LineNb]+2 : 1;
                            ui_menu_tick(menu_Lin_SIds, -1, 0);
                            ui_menu_tick(menu_Lin_SIds, k, 1);
                            // also tick the header of the sub-menu that holds the current line (reset below by the tick -1)
                            (k > 1) ? (
                                wgh = menu_Lin_SIds[ui_jmenu_items + 2 + (0|((k - 2) / menu_Lin_Grp)) * (menu_Lin_Grp + 1)];
                                str_setchar(wgh, 1, '!');
                            );
                            xx = control_jmenu(menu_Lin_SIds); // select a line
                            (xx != 0) ? (
                                (xx === 1) ? (
                                    r = (wok) ? Wr_Set_Line(wrt, -1) : 0; // "None"
                                ) : (
                                    (!wok) ? (wcbl = Wr_Action(its_WrtAct_Create, wrt, 0));
                                    r = Wr_Set_Line(wrt, xx - 2);
                                );
                            );
                            ui_menu_tick(menu_Lin_SIds, -1, 0);
                        ) :
                        (zzmcl === 6) ? (
                            (lok) ? (
                                k = f + 1;
                                ui_menu_tick(menu_128_0_Ids, -1, 0);
                                ui_menu_tick(menu_128_0_Ids, k, 1);
                                xx = control_jmenu(menu_128_0_Ids); // select a number
                                (xx != 0) ? (
                                    wcbl[its_Wrt_Bf1stChan] = xx - 1;
                                    wcbl[its_Wrt_Check] = 0; // (source width)
                                );
                                ui_menu_tick(menu_128_0_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 7) ? (
                            (lok) ? (
                                k = n;
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                                ui_menu_tick(menu_128_1_Ids, k, 1);
                                // also tick the header of the sub-menu that holds the current count (reset below by the tick -1)
                                (k >= 1) ? (
                                    wgh = menu_128_1_Ids[ui_jmenu_items + (0|((k - 1) / menu_128_Grp)) * (menu_128_Grp + 1)];
                                    str_setchar(wgh, 1, '!');
                                );
                                xx = control_jmenu(menu_128_1_Ids); // select a count
                                (xx != 0) ? (
                                    wcbl[its_Wrt_BfChanUsed] = xx;
                                    wcbl[its_Wrt_Check] = 0; // (source width)
                                );
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 10) ? (
                            // the source (left clic : the first channel taken in the source)
                            ((wok) && ((x = its_Src_Choose(wcbl[its_Wrt_Src], wcbl[its_Wrt_SrcOff])) >= 0)) ? (
                                wcbl[its_Wrt_Src] = x;
                                wcbl[its_Wrt_SrcOff] = its_Src_ChOff;
                                wcbl[its_Wrt_Check] = 0;
                                Wr_Set_Status(wrt, wcbl[its_Wrt_Status]); // no source : "Created"
                            );
                        ) :
                        (zzmcl === 15) ? (
                            xx = control_jmenu(menu_Wrt_Action);
                            (xx > 1) ? (
                                wcbl = Wr_Action(xx - 1, wrt, 0);
                            );
                        );
                        // keep the JSFX sliders in sync when this writer is the current one
                        (wrt === slWriter) ? (
                            Currwriter = Writers_set[slWriter];
                            display_Writer();
                        );
                    );

                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        (zzmcl === 0) ? (
                            // the next writer (shift : the previous one)
                            WDBL[0] = (jmc & shfCap) ? (wrt + WR_CNT - 1) % WR_CNT : (wrt + 1) % WR_CNT;
                        );
                        ((zzmcl === 1) && wok) ? (
                            // status : Paused -> Writing ; Ready or Writing -> Paused
                            w = wcbl[its_Wrt_Status];
                            ((w === its_WrtStat_Ready) || (w === its_WrtStat_Paused) || (w === its_WrtStat_Writing)) ? (
                                r = Wr_Set_Status(wrt, (w === its_WrtStat_Paused) ? its_WrtStat_Writing : its_WrtStat_Paused);
                                (wrt === slWriter) ? (slWrStatusPrv = slWrStatus = wcbl[its_Wrt_Status]);
                            );
                        );
                        ((zzmcl === 10) && wok) ? (
                            ((x = its_Off_Choose(wcbl[its_Wrt_SrcOff])) >= 0) ? (
                                wcbl[its_Wrt_SrcOff] = x;
                                wcbl[its_Wrt_Check] = 0;
                            );
                        );
                        ((zzmcl === 12) && wok) ? (
                            // overdub mode : X-fade <-> Sum
                            wcbl[its_Wrt_Mode] = (wcbl[its_Wrt_Mode] === its_WrtMode_Sum) ? its_WrtMode_XFade : its_WrtMode_Sum;
                        );
                    );
                );
            ui_pop();

            // the pad may have changed the writer
            wcbl = Writers_set[wrt];
            wok = (wcbl > BASE_MEMORY) && (wcbl[-2] === KW_writ);
            lcbl = wok ? wcbl[its_Wrt_Lcbl] : 0;
            lok = wok && (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);

            // the modulation inputs : record gain, overdub
            (wok && (h4 > 0)) ? (
                ui_split_top(h4);
                    ui_pad(1,2,2,2);
                    its_Mod_Row(wcbl + its_Wrt_Mod1, 2, its_ModN_Wrt, 3, its_ModD_Wrt) ? (wcbl[its_Wrt_Check] = 0);
                ui_pop();
            );

            // Waveform of the line (all its channels), with the heads of the writers and readers of the line
            (lok && (h3 > 0)) ? (
                w = min(h3, ui_height() - h2); // the sliders keep their place
                (w >= its_RdrWaveMin) ? (
                    ui_split_top(w);
                        ui_pad(1,2,1,2);
                        its_wave_marks(lcbl, -1);
                        ui_audio_wave(w, lcbl[its_Lin_ChCnt], lcbl + its_Lin_BF1ST, lcbl[its_Lin_ActBSize],
                            lcbl[its_Lin_Start], lcbl[its_Lin_Last], its_Wave_Flags(WDBL + 6), its_LinWaveMax);
                    ui_pop();
                );
            );

            // Sliders
            (wok && (h2 > 0)) ? (
                ui_split_top(h2);
                    ui_pad(1,3,1,0);

                    // Record gain
                    paramValues[p_wrGain] = zi = wcbl[its_Wrt_InGaindB];
                    r = parCtl(p_wrGain);
                    (r != 0) ? (
                        zi = (r === 8) ? 0 : parV(p_wrGain); // right clic : 0 dB
                        wcbl[its_Wrt_InGaindB] = zi;
                        wcbl[its_Wrt_InGain] = (zi <= -120) ? 0 : 10^(zi/20);
                        (wcbl === Currwriter) ? (slWrInGainPrv = slWrInGain = zi);
                    );

                    // Overdub
                    paramValues[p_wrOvrdb] = wcbl[its_Wrt_Ovrdb];
                    r = parCtl(p_wrOvrdb);
                    (r != 0) ? (
                        zi = (r === 8) ? 0 : max(-150, min(150, parV(p_wrOvrdb))); // right clic : no overdub
                        wcbl[its_Wrt_Ovrdb] = zi;
                        (wcbl === Currwriter) ? (slWrOvrdbPrv = slWrOvrdb = zi);
                    );

                    // the depths of the modulation inputs used, their attenuverters if shown
                    its_Mod_Sliders(wcbl + its_Wrt_Mod1, 2, 3, p_wrModDepth1, p_wrModAtt1);
                ui_pop();
            );

        ui_pop();
    );
);



flagpr = 1;

/*
    The generic sliders (automatable by REAPER, -1 ... 1) : they write the control cells Ctl 1 ... NB_GSL (see @block),
    that the modules take as sources (menu of the sources : "Controls").
    The module : one line of 8 cells (0 "Controls", 1 ... the pages of 8 sliders : left clic), then the 8 sliders of the page
    (right clic on a slider : 0)
*/
// set the generic slider "k" [0 ... NB_GSL-1] to "v", for REAPER too (automation)
function its_Ctl_Set(k, v)
(
    <? i = 0; loop(NB_GSL, printf("(k === %d) ? (slCtl%d = v; slider_automate(slCtl%d);) :\n    ", i, i+1, i+1); i += 1;); ?>0;
);

function show_Controls_Pad(blockId)
local (h1, h2, uix_jneed, zzmi, i, n, r, zz, zzmcl, pg, npg)
(
    npg = min(7, ceil(NB_GSL / 8)); // pages of 8 sliders
    pg = ControlsStruct[0] = max(0, min(npg - 1, 0|ControlsStruct[0]));
    h1 = uix_jpadHeight(1);
    h2 = 8 * ui_jd_slidh + 6;
    uix_jneed = h1+h2+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Ctl_Labs, pad_Ctl_Siz);
                i = 0; loop(pad_Ctl_Siz,
                    pad_Ctl_Colrs[i] = Col_InfoA;
                    strcpy(pad_Ctl_Labs[i],"");
                    i += 1;);
                strcpy(pad_Ctl_Labs[0],"Controls");
                i = 0; loop(npg,
                    sprintf(pad_Ctl_Labs[1 + i], "Ctl %d-%d", 8 * i + 1, min(NB_GSL, 8 * i + 8));
                    pad_Ctl_Colrs[1 + i] = (i === pg) ? Color_Limegreen : Col_P1;
                    i += 1;
                );
                zz = control_jpad(pad_Controls);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 35;
                    zzmcl = pad_Controls[ui_jpad_last]-1;
                    ((zz & ui_jpad_ev_lmc) && (zzmcl >= 1) && (zzmcl <= npg)) ? (
                        ControlsStruct[0] = pg = zzmcl - 1; // the page shown
                    );
                );
            ui_pop();

            // the 8 sliders of the page
            ui_split_top(h2);
                ui_pad(1,3,1,0);
                i = 0; loop(8,
                    n = 8 * pg + i;
                    (n < NB_GSL) ? (
                        sprintf(#ctllab, "Ctl %d: %%.3f", n + 1);
                        r = slider_ctl(#ctllab, slider(GSL_FIRST + n), -1, 1, 0, 0, 0.001);
                        (r & 8) ? its_Ctl_Set(n, 0) : (r != 0) ? its_Ctl_Set(n, uix_jsl_val);
                    );
                    i += 1;
                );
            ui_pop();

        ui_pop();
    );
);

// the own cables that exist (readers 0 ... RD_CNT-1, then effects RD_CNT ...) : its_PchCbl[0 ... its_PchCblN-1]
function its_Pch_Cables()
local (i)
(
    its_PchCblN = 0;
    i = 0; loop(RD_CNT + FX_CNT,
        (((i < RD_CNT) ? CblRdStart[i] : CblFxStart[i - RD_CNT]) > 0) ? (
            its_PchCbl[its_PchCblN] = i;
            its_PchCblN += 1;
        );
        i += 1;
    );
);

// the cell shown in the entry "e" of the grid of the view "v" (page "pg") ; 0 : none (a cable : its first cell)
function its_Pch_GridCell(v, pg, e)
local (k, m)
(
    k = pg * pad_PchG_Siz + e;
    (v === its_PchV_In) ? ((k < CH_NB) ? IN_P + k : 0) :
    (v === its_PchV_Out) ? ((k < CH_NB) ? OUT_P + k : 0) :
    (v === its_PchV_Bus) ? ((k < BusActN) ? BusStart[BusAct[k]] : 0) :
    (v === its_PchV_Ctl) ? ((k < NB_CTL) ? CTL_P + k : 0) :
    (k < its_PchCblN) ? (
        m = its_PchCbl[k];
        (m < RD_CNT) ? CblRdStart[m] : CblFxStart[m - RD_CNT];
    ) : 0;
);

// the count of the readers of the cable "m" (its_PchCbl), and its width in its_PchCblW
function its_Pch_CblReads(m)
local (c, kr)
(
    c = (m < RD_CNT) ? CblRdStart[m] : CblFxStart[m - RD_CNT];
    its_PchCblW = (m < RD_CNT) ? CblRdWidth[m] : CblFxWidth[m - RD_CNT];
    kr = 0; loop(its_PchCblW, kr += its_PchR[c]; c += 1;);
    kr;
);

/*
    The pad of the module "Patch"
    line 1 : 0 "Patch", 1 ... 5 the views (In, Out, Buses, Controls, Cables ; the buses and the cables that exist), 6 the page (left clic : the next one ;
    right clic : the previous one), 7 the count of problems (connections not valid, buses read but not written,
    cables not read)
    the grid : one cell of the patch per entry (the cables : one cable per entry) ; colors : green written and read,
    orange written but not read, red read but not written (buses), grey unused
    the text : the cell under the mouse, its value, who writes it, who reads it
*/
function show_Patch_Pad(blockId)
local (h1, h2, h3, uix_jneed, zzmi, i, k, c, w, v, pg, npg, ncel, nl, zz, zzmcl, nbad, hc, hx, hy, kw, kr, ch)
(
    v = PatchStruct[0] = max(0, min(its_PchV_Cnt - 1, 0|PatchStruct[0]));
    its_Pch_Cables();
    ncel = ((v === its_PchV_In) || (v === its_PchV_Out)) ? min(CH_NB, max(8, chcnt)) :
        (v === its_PchV_Bus) ? BusActN : (v === its_PchV_Ctl) ? NB_CTL : its_PchCblN;
    npg = max(1, ceil(ncel / pad_PchG_Siz));
    pg = PatchStruct[1] = max(0, min(npg - 1, 0|PatchStruct[1]));
    nl = max(1, min(pad_PchG_NL, ceil((ncel - pg * pad_PchG_Siz) / 8)));
    h1 = uix_jpadHeight(1);
    h2 = uix_jpadHeight(nl);
    h3 = uix_jBoxHeight(3);
    uix_jneed = h1+h2+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            its_Patch_Scan(-1);
            // the problems : connections not valid, buses read but not written, cables not read
            nbad = its_PchBad;
            i = 0; loop(BusActN,
                k = BusStart[BusAct[i]]; kw = kr = 0;
                loop(BusWidth[BusAct[i]], kw += its_PchW[k]; kr += its_PchR[k]; k += 1;);
                ((kr > 0) && (kw === 0)) ? (nbad += 1);
                i += 1;
            );
            i = 0; loop(its_PchCblN,
                (its_Pch_CblReads(its_PchCbl[i]) === 0) ? (nbad += 1);
                i += 1;
            );

            // the views
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Pch_Labs, pad_Pch_Siz);
                i = 0; loop(pad_Pch_Siz, pad_Pch_Colrs[i] = Col_InfoA; i += 1;);
                strcpy(pad_Pch_Labs[0], "Patch");
                strcpy(pad_Pch_Labs[1], "In");
                strcpy(pad_Pch_Labs[2], "Out");
                strcpy(pad_Pch_Labs[3], "Buses");
                strcpy(pad_Pch_Labs[4], "Controls");
                strcpy(pad_Pch_Labs[5], "Cables");
                i = 0; loop(its_PchV_Cnt, pad_Pch_Colrs[1 + i] = (i === v) ? Color_Limegreen : Col_P1; i += 1;);
                sprintf(pad_Pch_Labs[6], "Page %d / %d", pg + 1, npg);
                pad_Pch_Colrs[6] = (npg > 1) ? Col_P3 : Col_Inactive;
                (nbad > 0) ? (
                    sprintf(pad_Pch_Labs[7], "Problems %d", nbad);
                    pad_Pch_Colrs[7] = Col_P6;
                ) : (
                    strcpy(pad_Pch_Labs[7], "No problem");
                    pad_Pch_Colrs[7] = Color_Limegreen;
                );
                zz = control_jpad(pad_Patch);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    zzmcl = pad_Patch[ui_jpad_last]-1;
                    ((zz & ui_jpad_ev_lmc) && (zzmcl >= 1) && (zzmcl <= its_PchV_Cnt)) ? (
                        PatchStruct[0] = zzmcl - 1; // another view : its first page
                        PatchStruct[1] = 0;
                    ) :
                    (zzmcl === 6) ? (
                        (zz & ui_jpad_ev_lmc) ? (PatchStruct[1] = (pg + 1) % npg) :
                        (zz & ui_jpad_ev_rmc) ? (PatchStruct[1] = (pg + npg - 1) % npg);
                    );
                );
            ui_pop();

            // the grid of the cells
            ui_split_top(h2);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_PchG_Labs, 8 * nl);
                hc = 0;
                i = 0; loop(8 * nl,
                    c = its_Pch_GridCell(v, pg, i);
                    k = pg * pad_PchG_Siz + i;
                    pad_PchG_Colrs[i] = Col_Inactive;
                    (c > 0) ? (
                        (v === its_PchV_Cbl) ? (
                            // a cable : read if one of its cells is read
                            ch = its_PchCbl[k];
                            kr = its_Pch_CblReads(ch);
                            (ch < RD_CNT) ? sprintf(pad_PchG_Labs[i], "R%d [%d]", ch + 1, its_PchCblW) :
                                sprintf(pad_PchG_Labs[i], "E%d [%d]", ch - RD_CNT + 1, its_PchCblW);
                            pad_PchG_Colrs[i] = (kr > 0) ? Color_Limegreen : Color_Dark_Orange;
                        ) :
                        (v === its_PchV_Bus) ? (
                            // a bus : all its channels
                            ch = BusAct[k];
                            kw = kr = 0; w = c; loop(BusWidth[ch], kw += its_PchW[w]; kr += its_PchR[w]; w += 1;);
                            sprintf(pad_PchG_Labs[i], "Bus %d [%d]", ch + 1, BusWidth[ch]);
                            pad_PchG_Colrs[i] = ((kw > 0) && (kr > 0)) ? Color_Limegreen :
                                (kw > 0) ? Color_Dark_Orange : (kr > 0) ? Col_P6 : Col_Inactive;
                        ) : (
                            kw = its_PchW[c]; kr = its_PchR[c];
                            (v === its_PchV_In) ? sprintf(pad_PchG_Labs[i], "In:%d", k) :
                            (v === its_PchV_Out) ? sprintf(pad_PchG_Labs[i], "Out:%d", k) :
                            sprintf(pad_PchG_Labs[i], "Ctl %d", k + 1);
                            // In and the controls are written by REAPER (the track, the sliders), Out is read by REAPER
                            ((v === its_PchV_In) || (v === its_PchV_Ctl)) ? (kw = 1) : (v === its_PchV_Out) ? (kr += (kw > 0));
                            pad_PchG_Colrs[i] = ((kw > 0) && (kr > 0)) ? Color_Limegreen :
                                (kw > 0) ? Color_Dark_Orange : (kr > 0) ? Col_P6 : Col_Inactive;
                            (((v === its_PchV_In) || (v === its_PchV_Ctl)) && (kr === 0)) ? (pad_PchG_Colrs[i] = Col_Inactive);
                        );
                    );
                    i += 1;
                );
                zz = control_jpad(pad_PatchG, nl, -1, 1);
                // the entry under the mouse (geometry of the pad just drawn, see ui_jpad_cell_pos)
                (ui_hover() && (ui_jpad_lst_wi > 0) && (ui_jpad_lst_he > 0)) ? (
                    hx = floor((uix_mouse_x - ui_jpad_lst_left) / ui_jpad_lst_wi);
                    hy = floor((uix_mouse_y - ui_jpad_lst_top) / ui_jpad_lst_he);
                    ((hx >= 0) && (hx < 8) && (hy >= 0) && (hy < nl)) ? (hc = its_Pch_GridCell(v, pg, k = hy * 8 + hx));
                );
            ui_pop();

            // the text : the cell under the mouse
            ui_split_top(h3);
                ui_pad(4,2,4,2);
                ui_pcolor(ui_jcolor_text);
                ui_align(0, 0);
                (hc > 0) ? (
                    // a cable, a bus : all its cells
                    k += pg * pad_PchG_Siz;
                    its_PchCellW = (v === its_PchV_Cbl) ? ((its_PchCbl[k] < RD_CNT) ? CblRdWidth[its_PchCbl[k]] : CblFxWidth[its_PchCbl[k] - RD_CNT]) :
                        (v === its_PchV_Bus) ? BusWidth[BusAct[k]] : 1;
                    its_Patch_Scan(hc);
                    its_PchCellW = 1;
                    (v === its_PchV_Cbl) ? (
                        ch = its_PchCbl[k];
                        (ch < RD_CNT) ? sprintf(#its_PchName, "Cable of Reader %d", ch + 1) :
                            sprintf(#its_PchName, "Cable of Effect %d", ch - RD_CNT + 1);
                    ) :
                    strcpy(#its_PchName, pad_PchG_Labs[hy * 8 + hx]);
                    sprintf(#its_PchTxt, "%s = %.4f", #its_PchName, smpl_tab[hc]);
                    ui_split_top(ui_texth()); ui_text(#its_PchTxt); ui_pop();
                    sprintf(#its_PchTxt, "Written by: %s", (strlen(#its_PchWs) > 0) ? #its_PchWs :
                        ((v === its_PchV_In) ? "the track" : (v === its_PchV_Ctl) ? "the slider" : "nobody"));
                    ui_split_top(ui_texth()); ui_text(#its_PchTxt); ui_pop();
                    sprintf(#its_PchTxt, "Read by: %s", (strlen(#its_PchRs) > 0) ? #its_PchRs :
                        ((v === its_PchV_Out) ? "the track" : "nobody"));
                    ui_split_top(ui_texth()); ui_text(#its_PchTxt); ui_pop();
                ) : (
                    sprintf(#its_PchTxt, "%d connections not valid", its_PchBad);
                    ui_split_top(ui_texth()); ui_text("Mouse over a cell : who writes it, who reads it."); ui_pop();
                    ui_split_top(ui_texth()); ui_text(#its_PchTxt); ui_pop();
                );
            ui_pop();

        ui_pop();
    );
);

/*
    The module "Instances" : the instances of algorithms (see "Algorithms", table(data(...)))
    line 1 : 0 "Instances", 1 their count, 2 the count of templates, 7 actions (right clic : Dump all, Templates in the log,
    Free all instances)
    the grid : one cell per instance (its number : 1 ... its_InsMx), "name : Template" ; left clic : selects it ; right clic :
    menu (Dump, Free)
    the text : the instance under the mouse (or the selected one) : its call, the count of its modules
*/
function show_Instances_Pad(blockId)
local (h1, h2, h3, uix_jneed, zzmi, i, k, n, nt, mx, nl, zz, zzmcl, xx, hk, hx, hy, b, nln, nwr, nrd, nfx)
(
    n = nt = mx = 0;
    k = 1; loop(its_InsMx, (its_InsSym[k] !== 0) ? ( n += 1; mx = k; ); k += 1;);
    i = 0; loop(its_AlgMx, (its_AlgSym[i] !== 0) ? (nt += 1); i += 1;);
    (its_InsSym[its_InsUiSel] === 0) ? (its_InsUiSel = 0);
    nl = max(1, ceil(mx / 8));
    h1 = uix_jpadHeight(1);
    h2 = uix_jpadHeight(nl);
    h3 = uix_jBoxHeight(2);
    uix_jneed = h1+h2+h3+ui_jd_ctgr;
    (ui_height() >= uix_jneed) ? (
        ui_split_top(uix_jneed);
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            // line 1
            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Ins_Labs, pad_Ins_Siz);
                i = 0; loop(pad_Ins_Siz, pad_Ins_Colrs[i] = Col_InfoA; strcpy(pad_Ins_Labs[i], ""); i += 1;);
                strcpy(pad_Ins_Labs[0], "Instances");
                sprintf(pad_Ins_Labs[1], "%d instance%s", n, (n > 1) ? "s" : "");
                sprintf(pad_Ins_Labs[2], "%d template%s", nt, (nt > 1) ? "s" : "");
                pad_Ins_Colrs[1] = pad_Ins_Colrs[2] = Color_Heliotrope;
                strcpy(pad_Ins_Labs[7], "Action");
                pad_Ins_Colrs[7] = Col_P1;
                zz = control_jpad(pad_Ins);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    zzmcl = pad_Ins[ui_jpad_last]-1;
                    ((zz & ui_jpad_ev_rmc) && (zzmcl === 7)) ? (
                        xx = control_jmenu(menu_InsAll_Action);
                        (xx === 1) ? (
                            k = 1; loop(its_InsMx, (its_InsSym[k] !== 0) ? its_Al_DumpIns(k); k += 1;);
                            (n === 0) ? mSL_log(SysLogBox, "No instance");
                        ) :
                        (xx === 2) ? (
                            its_Al_DumpTpls();
                        ) :
                        (xx === 4) ? (
                            k = 1; loop(its_InsMx, (its_InsSym[k] !== 0) ? its_Al_Delete(k); k += 1;);
                            its_InsUiSel = 0;
                        );
                    );
                );
            ui_pop();

            // the grid : the instances
            ui_split_top(h2);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_InsG_Labs, 8 * nl);
                hk = 0;
                i = 0; loop(8 * nl,
                    k = i + 1;
                    (its_InsSym[k] !== 0) ? (
                        sprintf(pad_InsG_Labs[i], "%s : %s", mSL_edit_value(#its_TbV, its_InsSym[k]), mSL_edit_value(#its_TbV1, its_InsAName[k]));
                        pad_InsG_Colrs[i] = (k === its_InsUiSel) ? Color_Goldenrod : Color_Limegreen;
                    ) : (
                        strcpy(pad_InsG_Labs[i], "");
                        pad_InsG_Colrs[i] = Col_Inactive;
                    );
                    i += 1;
                );
                zz = control_jpad(pad_InsG, nl, -1, 1);
                // the instance under the mouse (geometry of the pad just drawn, see ui_jpad_cell_pos)
                (ui_hover() && (ui_jpad_lst_wi > 0) && (ui_jpad_lst_he > 0)) ? (
                    hx = floor((uix_mouse_x - ui_jpad_lst_left) / ui_jpad_lst_wi);
                    hy = floor((uix_mouse_y - ui_jpad_lst_top) / ui_jpad_lst_he);
                    ((hx >= 0) && (hx < 8) && (hy >= 0) && (hy < nl) && (its_InsSym[hy * 8 + hx + 1] !== 0)) ? (hk = hy * 8 + hx + 1);
                );
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 36;
                    k = pad_InsG[ui_jpad_last];
                    ((k >= 1) && (k <= its_InsMx) && (its_InsSym[k] !== 0)) ? (
                        (zz & ui_jpad_ev_lmc) ? (
                            its_InsUiSel = (its_InsUiSel === k) ? 0 : k;
                        ) :
                        (zz & ui_jpad_ev_rmc) ? (
                            xx = control_jmenu(menu_Ins_Action);
                            (xx === 1) ? its_Al_DumpIns(k) :
                            (xx === 2) ? ( its_Al_Delete(k); (its_InsUiSel === k) ? (its_InsUiSel = 0); );
                        );
                    );
                );
            ui_pop();

            // the text : the instance under the mouse, or the selected one
            ui_split_top(h3);
                ui_pad(4,2,4,2);
                ui_pcolor(ui_jcolor_text);
                ui_align(0, 0);
                k = (hk > 0) ? hk : its_InsUiSel;
                (k > 0) ? (
                    ui_split_top(ui_texth()); ui_text(its_Al_CallText(#its_InsTxt, k)); ui_pop();
                    nln = nwr = nrd = nfx = 0;
                    i = 0; loop(LN_CNT, (((b = Lines_Set[i]) > BASE_MEMORY) && (b[its_Lin_Owner] === k)) ? (nln += 1); i += 1;);
                    i = 0; loop(WR_CNT, (((b = Writers_set[i]) > BASE_MEMORY) && (b[its_Wrt_Owner] === k)) ? (nwr += 1); i += 1;);
                    i = 0; loop(RD_CNT, (((b = Readers_set[i]) > BASE_MEMORY) && (b[its_Rdr_Owner] === k)) ? (nrd += 1); i += 1;);
                    i = 0; loop(FX_CNT, (((b = Effects_set[i]) > BASE_MEMORY) && (b[its_Efx_Owner] === k)) ? (nfx += 1); i += 1;);
                    sprintf(#its_InsTxt, "Modules : %d lines, %d writers, %d readers, %d effects", nln, nwr, nrd, nfx);
                    ui_split_top(ui_texth()); ui_text(#its_InsTxt); ui_pop();
                ) : (
                    ui_split_top(ui_texth()); ui_text("Mouse over an instance : its call and its modules."); ui_pop();
                );
            ui_pop();

        ui_pop();
    );
);

/*
    The globals of Interstys (they replace the last native sliders) : one line of 8 cells
    0 : "Globals"  1 : channels  2 : track samples (menu)  3..6 : count of lines, readers, writers, effects
    7 : global action (menu)
    then the sliders "Input Gain" (in "Merge" mode) and "Output Volume" (in "Merge" and "Ignore" modes).
    The values stay in the native sliders (slSmpl, slInGain, slOutVol, slGlAct), that update_sliders() handles.
*/
function show_Global_Pad(blockId)
local (h1, h2, uix_jneed, zzmi, jmc, i, k, r, xx, zi, zz, zzmcl, nLn, nRd, nWr, nFx, cbl, shIn, shOut)
(
    shIn = (slSmpl === 0);
    shOut = (slSmpl === 0) || (slSmpl === 1);
    h1 = uix_jpadHeight(pad_Glb_NL); // height
    h2 = (shIn + shOut) * (ui_jd_slidh + 3) + 3; // sliders : input gain, output volume
    uix_jneed = h1+h2+ui_jd_ctgr;
    (ui_height() >= h1+ui_jd_ctgr) ? (
        ui_split_top(min(uix_jneed, ui_height()));
        ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            // the structures in use
            nLn = nRd = nWr = nFx = 0;
            i = 0; loop(LN_CNT, cbl = Lines_Set[i]; ((cbl > BASE_MEMORY) && (cbl[-2] === KW_lcbl)) ? nLn += 1; i += 1;);
            i = 0; loop(RD_CNT, cbl = Readers_set[i]; ((cbl > BASE_MEMORY) && (cbl[-2] === KW_read)) ? nRd += 1; i += 1;);
            i = 0; loop(WR_CNT, cbl = Writers_set[i]; ((cbl > BASE_MEMORY) && (cbl[-2] === KW_writ)) ? nWr += 1; i += 1;);
            i = 0; loop(FX_CNT, cbl = Effects_set[i]; ((cbl > BASE_MEMORY) && (cbl[-2] === KW_effx)) ? nFx += 1; i += 1;);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Glb_Labs, pad_Glb_Siz);
                i = 0; loop(pad_Glb_Siz,
                    pad_Glb_Colrs[i] = Col_InfoA;
                    strcpy(pad_Glb_Labs[i],"");
                    i += 1;);
                strcpy(pad_Glb_Labs[0],"Globals");
                sprintf(pad_Glb_Labs[1],"Channels %d", chcnt);
                k = max(0, min(2, slSmpl));
                strcpy(pad_Glb_Labs[2],menu_Glb_Smpl_N[k]);
                // track samples : Merge (green), Ignore (orange), Pass (blue)
                pad_Glb_Colrs[2] = (k === 0) ? Color_Limegreen : (k === 1) ? Color_Dark_Orange : Color_Light_Steel_Blue;
                sprintf(pad_Glb_Labs[3],"Lines %d", nLn);
                sprintf(pad_Glb_Labs[4],"Readers %d", nRd);
                sprintf(pad_Glb_Labs[5],"Writers %d", nWr);
                sprintf(pad_Glb_Labs[6],"Effects %d", nFx);
                pad_Glb_Colrs[3] = pad_Glb_Colrs[4] = pad_Glb_Colrs[5] = pad_Glb_Colrs[6] = Color_Heliotrope;
                strcpy(pad_Glb_Labs[7],"Action");
                pad_Glb_Colrs[7] = Col_P1;

                zz = control_jpad(pad_Global);
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 35;
                    zzmcl = pad_Global[ui_jpad_last]-1;
                    (zz & ui_jpad_ev_rmc) ? (  // right mouse clic
                        (zzmcl === 2) ? (
                            ui_menu_tick(menu_Glb_Smpl, -1, 0);
                            ui_menu_tick(menu_Glb_Smpl, k+1, 1);
                            xx = control_jmenu(menu_Glb_Smpl);
                            (xx != 0) ? (
                                slSmpl = xx - 1; sliderchange(slSmpl);
                                slupdt = 1; // see update_sliders
                            );
                            ui_menu_tick(menu_Glb_Smpl, -1, 0);
                        ) :
                        (zzmcl === 7) ? (
                            xx = control_jmenu(menu_Glb_Action);
                            (xx > 1) ? (
                                slGlAct = xx - 1; // performed by update_sliders (its_actions)
                                slupdt = 1;
                            );
                        );
                    );
                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        (zzmcl === 2) ? (
                            // track samples : the next mode (shift : the previous one)
                            slSmpl = (jmc & shfCap) ? (k + 2) % 3 : (k + 1) % 3; sliderchange(slSmpl);
                            slupdt = 1; // see update_sliders
                        );
                    );
                );
            ui_pop();

            // Sliders
            (h2 > 3) ? (
                ui_split_top(min(h2, ui_height()));
                    ui_pad(1,3,1,0);
                    (shIn) ? (
                        // Global input gain
                        paramValues[p_glInGain] = slInGain;
                        r = parCtl(p_glInGain);
                        (r != 0) ? (
                            zi = (r === 8) ? 0 : parV(p_glInGain); // right clic : 0 dB
                            slInGain = zi; sliderchange(slInGain);
                            slupdt = 1; // see update_sliders
                        );
                    );
                    (shOut) ? (
                        // Global output volume
                        paramValues[p_glOutVol] = slOutVol;
                        r = parCtl(p_glOutVol);
                        (r != 0) ? (
                            zi = (r === 8) ? 0 : parV(p_glOutVol); // right clic : 0 dB
                            slOutVol = zi; sliderchange(slOutVol);
                            slupdt = 1;
                        );
                    );
                ui_pop();
            );

        ui_pop();
    );
);

function show_UserModule(module)
local(w, umid, chk, i, statn, recomp, modInst, modSrc, ucod, uent, err, ut, user_top, ul, user_left, uw, user_width, uh, user_height, rptb, ptbl, prvstk, ptstk, anc, typanc, cbxrpt, cbxref, typtb, crptb, addb, rcnt, adds, flgm, reh, w3)
(
    // module is a module number
    // Lets check the existence of the object
    modInst = err = recomp = 0;
    umid = module - blockUsrFirst; // user module. number, in 0 .. 31
    statn = blockUsrNum[umid]; // inverse reference number : from umid (dyn. computed) to statn (static number)
    modSrc = blockUsrRefs[statn]; // Memory address of the module prototype
    (chk = (mSL_bl_check(modSrc, 'umod') && mSL_bl_check(modSrc[ubx_mref], 'umod'))) ? (
        ucod = 0x10000 | (PanIdt << 8) | umid; // internal code for the module in this position
        uent = -1; // entry number of the module if it exists
        i = 0;
        while ((uent === -1) && (i < dcbUXRefsSiz)) (
            (blockUsrCode[i] === ucod) ? (uent = i; modInst = blockUsrDesc[i]);
            i += 1;
        );
        (uent === -1) ? (
            i = 0;
            while ((blockUsrCode[i] != 0) && (i < dcbUXRefsSiz)) ( i+= 1; );
            (i < dcbUXRefsSiz) ? (
                uent = i;
                modInst = blockUsrDesc[i] = mSL_bl_Dup(modSrc);
                blockUsrCode[i] = ucod;
                // (FlagsTbVals[Flgs_Umods] & 1) ? (
                    sprintf(#u, "Creating umod %x at %d from %d", ucod, modInst, modSrc);
                    mSL_log(SysLogBox, #u);
                // );
            );
        );
        // Now, modInst is the instance in this position of the module prototype
        chk = mSL_bl_check(modInst, 'umod');
    );

    (chk) ? (
        thrd = modInst[ubx_thread];
        chk = ((thrd[-2] === mSL_THR_KeyStrt) && (thrd[mSL_THR_UTId] === modInst[ubx_thrdid]));
    );

    (chk) ? (
        ut = user_top = ui_top();
        ul = user_left = ui_left();
        uw = user_width = ui_width();
        uh = user_height = ui_height(); // total available height
        // Are our computations still valid ?
        (ui_Resized || (modInst[ubx_flgs] & 1) || (user_top !== modInst[ubx_t]) || (user_left !== modInst[ubx_l]) ||
            (user_width !== modInst[ubx_w])) ? (    //  || (user_height < modInst[ubx_h])
            // Recompute positions off all fields
            recomp = 1;
            modInst[ubx_flgs] &= 0x7ffffffe;
            rptb = ubx_isiz; ptbl = modInst[-1];
            modInst[ubx_t] = user_top;
            modInst[ubx_l] = user_left;
            modInst[ubx_w] = user_width;
            modInst[ubx_h] = ui_jd_ctgr;
            // Compute internal needed height
            //sprintf(#u, "Recomputing umod %x positions", ucod);
            // mSL_log(SysLogBox, #u);
            state = 1; // start in state 1
            prvstk = ptstk = 0; stack = wa256;
            // AWA! Almost Working Algorithm
            uh = 0;
            while (state != 0) (
                (state === 1) ? (
                    // Push the umod infos
                    stack[0] = -1;
                    ptstk += stk_isiz;
                    stack[ptstk+stk_btyp] = 'umod';
                    stack[ptstk+stk_cbx] = 0;
                    stack[ptstk+stk_rtsk] = 0; // return stack
                    stack[ptstk+stk_rtst] = 0; // return state
                    stack[ptstk+stk_mode] = 0; // work mode = vertical
                    stack[ptstk+stk_h] = 0;
                    stack[ptstk+stk_i] = 0;
                    stack[ptstk+stk_b] = ubx_isiz; // first box in the sequence of siblings
                    state = 2; // goto state 2
                ) :
                (state === 2) ? (
                    anc = stack[ptstk+stk_cbx]; // position ancestor
                    typanc = stack[ptstk+stk_btyp]; // type of ancestor
                    k = anc + ubx_isiz * stack[ptstk+stk_i];
                    cbxrpt = stack[ptstk + stk_b] + k; // relative pointer to current box instance
                    cbxref = modInst[cbxrpt + ubx_mref]; // reference to current box prototype
                    typtb = cbxref[ubx_ty];
                    mode = stack[ptstk+stk_mode];
                    (typtb === 'sbox') ? (
                        // Add the height of the sbox
                        modInst[cbxrpt + ubx_h] = h = cbxref[ubx_h];
                        /*
                        sprintf(#u, "   ++ sbox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]);
                        mSL_log(SysLogBox, #u);
                        */
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'ibox') ? (
                        // Add the height of the sbox
                        modInst[cbxrpt + ubx_h] = h = cbxref[ubx_h];
                        /*
                        sprintf(#u, "   ++ ibox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]);
                        mSL_log(SysLogBox, #u);
                        */
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'tbox') ? (
                        // Get the size with the text wrap function
                        // cbxref is the ref to the text box
                        txt = cbxref[ubx_isiz]; // the text string
                        // evaluate the height
                        modInst[cbxrpt + ubx_h] = (h = ui_wraptext_height(txt));
                        // sprintf(#u, "   ++ tbox %d add:%d/%d to %d", k, mode, h, stack[ptstk+stk_h]); mSL_log(SysLogBox, #u);
                        mode ? (
                            stack[ptstk+stk_h] = max(stack[ptstk+stk_h],h);
                        ) : (
                            stack[ptstk+stk_h] += h;
                        );
                    ) :
                    (typtb === 'vbox') ? (
                        // A vertical box
                        // Push this box
                        prvstk = ptstk;
                        ptstk += stk_isiz;
                        stack[ptstk+stk_btyp] = typtb;
                        stack[ptstk+stk_cbx] = k;
                        stack[ptstk+stk_rtsk] = prvstk; // return stack
                        stack[ptstk+stk_rtst] = 2; // return state
                        stack[ptstk+stk_mode] = 0; // work mode = vertical
                        stack[ptstk+stk_h] = 0; // height so far
                        stack[ptstk+stk_i] = 0; // index in descendants
                        stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first box in the sequence of siblings
                        state = 2; // goto state 2
                    ) :
                    (typtb === 'hbox') ? (
                        // An horizontal box
                        // Push this box
                        prvstk = ptstk;
                        ptstk += stk_isiz;
                        stack[ptstk+stk_btyp] = typtb;
                        stack[ptstk+stk_cbx] = k;
                        stack[ptstk+stk_rtsk] = prvstk; // return stack
                        stack[ptstk+stk_rtst] = 2; // return state
                        stack[ptstk+stk_mode] = 1; // work mode = horizontal
                        stack[ptstk+stk_h] = 0; // height so far
                        stack[ptstk+stk_i] = 0; // index in descendants
                        stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first box in the sequence of siblings
                        state = 2; // goto state 2
                    ) :
                    (
                        err = 0871;
                        state = 0;
                    );
                    //== Skip to next sibling
                    i = (stack[ptstk+stk_i] += 1); // number of next sibling
                    (i >= modInst[anc + ubx_lcnt]) ? (
                        // return to previous state
                        state = stack[ptstk+stk_rtst]; // return state
                        ptstk = stack[ptstk+stk_rtsk]; // return stack
                    );
                ) :
                (
                    err = 0870;
                    state = 0;
                );
            );
            modInst[ubx_h] = stack[stk_isiz+stk_h] + ui_jd_ctgr; // computed height
        );

        uix_jneed = uix_jmini = modInst[ubx_h];
        (chk && (ui_height() >= uix_jmini)) ? (
            ui_split_top(uix_jneed);
                ui_set_rect(ui_left(), ui_top(), max(ui_MinSize1Pane, min(ui_BestSize1Pane, ui_width())), ui_height());
                zzmi = ui_hover();  // true if we are "in"
                // Keep block position
                keepBlockInfos(module);
                (zzmi) ? (
                    ui_push();
                        // stack is now 2 levels deep
                        ui_color(Col_Frame);
                        ui_border(); // draws in orange
                    ui_pop();
                );
                control_group(blockDispNames[blockDispInverts[module]]);

                ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
                // Inside of the module dimensions
                ut = ui_top();
                ul = ui_left();
                uw = ui_width();
                uh = ui_height();

                // Should we recomp item sizes ?
                (recomp) ? (
                    state = 1; prvstk = ptstk = 0; stack = wa256;
                    rptb = ubx_isiz; ptbl = modInst[-1];
                    while (state != 0) (
                        (state === 1) ? (
                            // Push the umod infos
                            stack[0] = -1;
                            ptstk += stk_isiz;
                            stack[ptstk+stk_btyp] = 'umod';
                            stack[ptstk+stk_cbx] = 0; // position of the box in the umod
                            stack[ptstk+stk_rtsk] = 0; // return stack
                            stack[ptstk+stk_rtst] = 0; // return state
                            stack[ptstk+stk_h] = uh;
                            stack[ptstk+stk_w] = uw;
                            stack[ptstk+stk_l] = ul;
                            stack[ptstk+stk_t] = ut;
                            stack[ptstk+stk_i] = 0;
                            stack[ptstk+stk_b] = ubx_isiz; // first box in the sequence of siblings
                            state = 2; // goto state 2
                        ) :
                        (state === 2) ? (
                            anc = stack[ptstk+stk_cbx]; // position ancestor
                            typanc = stack[ptstk+stk_btyp]; // type of ancestor
                            k = anc + ubx_isiz * stack[ptstk+stk_i];
                            cbxrpt = stack[ptstk + stk_b] + k; // relative pointer to current box instance
                            cbxref = modInst[cbxrpt + ubx_mref]; // reference to current box prototype
                            typtb = cbxref[ubx_ty];
                            (typtb === 'sbox') ? (
                                // Set the size of the rectangle for the 'sbox'
                                h = cbxref[ubx_h]; // height - already computed
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ sbox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'ibox') ? (
                                h = cbxref[ubx_h]; // height - already computed
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                w = min(stack[ptstk+stk_w], cbxref[ubx_maxw]);
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ ibox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'tbox') ? (
                                // recheck the size of the text
                                txt = cbxref[ubx_isiz]; // the text string
                                // re-evaluate the height
                                modInst[cbxrpt + ubx_h] = (h = ui_wraptext_height(txt));
                                modInst[cbxrpt + ubx_t] = stack[ptstk+stk_t]; // top
                                stack[ptstk+stk_t] += h; // update parent top
                                modInst[cbxrpt + ubx_l] = stack[ptstk+stk_l]; // same left as parent
                                modInst[cbxrpt + ubx_w] = stack[ptstk+stk_w]; // same width as parent
                                /*
                                sprintf(#u, "   ++ tbox %d [%d %d %d %d]", k, modInst[cbxrpt + ubx_l],
                                modInst[cbxrpt + ubx_t], modInst[cbxrpt + ubx_w], modInst[cbxrpt + ubx_h]);
                                mSL_log(SysLogBox, #u);
                                */
                            ) :
                            (typtb === 'vbox') ? (
                                // A vertical box
                                prvstk = ptstk;
                                // Push this box
                                prvstk = ptstk;
                                ptstk += stk_isiz;
                                stack[ptstk+stk_btyp] = typtb;
                                stack[ptstk+stk_cbx] = k;
                                stack[ptstk+stk_rtsk] = prvstk; // return stack
                                stack[ptstk+stk_rtst] = 2; // return state
                                stack[ptstk+stk_l] = stack[ptstk+stk_l]; // left from ancestor
                                stack[ptstk+stk_t] = stack[ptstk+stk_t]; // top from ancestor
                                stack[ptstk+stk_w] = stack[ptstk+stk_w]; // width from ancestor
                                stack[ptstk+stk_h] = h = cbxref[ubx_h]; // height - already computed;
                                stack[ptstk+stk_i] = 0; // index in descendants
                                stack[ptstk+stk_b] = modInst[cbxrpt + ubx_1st]; // first sibling
                                state = 2; // goto state 2
                            ) :
                            (
                                err = 0881;
                                state = 0;
                            );
                            //== Skip to next sibling
                            i = (stack[ptstk+stk_i] += 1); // number of next sibling
                            (i >= modInst[anc + ubx_lcnt]) ? (
                                // return to previous state
                                state = stack[ptstk+stk_rtst]; // return state
                                ptstk = stack[ptstk+stk_rtsk]; // return stack
                            );
                        ) :
                        (
                            err = 0880;
                            state = 0;
                        );
                    );


                    (FlagsTbVals[Flgs_Umods] & 2) ? (
                sprintf(#u, "User Block %x : %d / %d / %d / %d / %d => %d [t:%d  l:%d  w:%d  h:%d]  =>  [%d  %d  %d  %d]",
                ucod, module, umid, statn, blockUsrChecks[statn], blockUsrRefs[statn], modInst, user_top, user_left, user_width,
                user_height, ut, ul, uw, uh); mSL_log(SysLogBox, #u);
                    );

                );
                // ui_text(#u);


                // (Finally !) Let's put out items...
                rptb = ubx_isiz; ptbl = modInst[-1];
                while (rptb < ptbl) (
                    crptb = rptb;
                    (modInst[rptb + ubx_flgs] & ubx_final) ? (
                        ty = modInst[rptb + ubx_ty];
                        (ty === 'sbox') ? (
                            // position the rectangle for all sliders
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            //ui_pad(0,2,1,0);
                            ui_pcolor(ui_jcolor_text);
                            // Put the various sliders
                            addb = modInst[rptb + ubx_mref] + modInst[rptb + ubx_lcnt];
                            rcnt = addb[ubx_icnt]; // number of references
                            (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                sprintf(#u, "Slider box: %d -- %d refs.", addb, rcnt); mSL_log(SysLogBox, #u);
                            );
                            i = 0;
                            while (rcnt > 0) (
                                adds = addb[ubx_isiz+i]; // final "slider" address
                                pnum = adds[1]; // its parameter number
                                (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                    sprintf(#u, "Slider %d in [%d %d %d %d]  %d / %d / %d", pnum,
                                        ui_top(), ui_left(), ui_width(), ui_height(), i, rcnt, adds);
                                        mSL_log(SysLogBox, #u);
                                );
                                flgm = parCtl(pnum);
                                i += 1; rcnt -= 1;
                            );
                        ) :
                        (ty === 'ibox') ? (
                            // position the rectangle for the info block
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            blk = modInst[crptb + ubx_mref]; // ref to the info box
                            cnt = blk[ubx_isiz]; // parameter count
                            thrd = modInst[ubx_thread];
                            (recomp) ? (
                                sprintf(#u, "Info box: %d thrd: %d -- %d pars.", blk, thrd, cnt);
                                mSL_log(SysLogBox, #u);
                            );
                            wa = wa128; memset(wa, 0, 32);
                            i = 0; loop(cnt,
                                k = blk[ubx_isiz+i+1]; // next parameter
                                ((k >= mSL_Sym_Low) && (k <= mSL_Sym_High)) ? (k = mSL_idt_addr(thrd, k));
                                wa[i+16] = k; // keep address
                                (!mSL_isString(k)) ? ((k >= 0) ? (k = k[0]) : (k = gmem[-k]));
                                wa[i] = k; i += 1;
                            );
                            (recomp) ? (
                                sprintf(#u, "Info [%d/%d  %d/%d  %d/%d  %d/%d  %d/%d  %d/%d]",
                                            wa[16+0], wa[0], wa[16+1], wa[1], wa[16+2], wa[2],
                                            wa[16+3], wa[3], wa[16+4], wa[4], wa[16+5], wa[5]);
                                mSL_log(SysLogBox, #u);
                            );
                            (cnt === 0) ? (
                                ui_show();
                            ) :
                            (cnt === 1) ? (
                                ui_show(wa[0]);
                            ) :
                            (cnt === 2) ? (
                                ui_show(wa[0], wa[1]);
                            ) :
                            (cnt === 3) ? (
                                ui_show(wa[0], wa[1], wa[2]);
                            ) :
                            (cnt === 4) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3]);
                            ) :
                            (cnt === 5) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3], wa[4]);
                            ) :
                            (cnt === 6) ? (
                                ui_show(wa[0], wa[1], wa[2], wa[3], wa[4], wa[5]);
                            ) : (
                                ui_show("Error 8793");
                            );
                        ) :
                        (ty === 'tbox') ? (
                            // position the rectangle for the text
                            ui_set_rect(modInst[rptb + ubx_l], modInst[rptb + ubx_t], modInst[rptb + ubx_w], modInst[rptb + ubx_h]);
                            blk = modInst[crptb + ubx_mref]; // ref to the text box
                            txt = blk[ubx_isiz]; // the text string
                            ui_align(0.5, 0.5);
                            reh = w3 = ui_wraptext(txt);
                            (reh != modInst[crptb + ubx_h]) ? (
                                modInst[rptb + ubx_h] = reh;
                                // we have to adjust the height
                                modInst[ubx_flgs] |= 1;
                            );
                            (recomp && (FlagsTbVals[Flgs_Umods] & 2)) ? (
                                sprintf(#u, "Text box %d in [%d %d %d %d]   %d / %d / %d", txt,
                                ui_top(), ui_left(), ui_width(), ui_height(), w1, w2, w3);
                                mSL_log(SysLogBox, #u);
                            );
                        );
                    );
                    rptb += ubx_isiz;
                );

            ui_pop();
        );
    );

    (!chk) ? (
        h1 = uix_jpadHeight(1); // A 1 line to display info
        uix_jneed = uix_jmini = h1+ui_jd_ctgr;
        (ui_height() >= uix_jmini) ? (
            ui_split_top(uix_jneed);
                ui_set_rect(ui_left(), ui_top(), max(ui_MinSize1Pane, min(ui_BestSize1Pane, ui_width())), ui_height());
                zzmi = ui_hover();  // true if we are "in
                // Keep block position
                keepBlockInfos(module);
                (zzmi) ? (
                    ui_push();
                        // stack is now 2 levels deep
                        ui_color(Col_Frame);
                        ui_border(); // draws in purple
                    ui_pop();
                );
                control_group(blockDispNames[blockDispInverts[module]]);
                statn = blockUsrNum[umid];
                ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
                sprintf(#u, "Error: User Block %d / %d / %d / %d / %d [t:%d  l:%d  w:%d  h:%d]", module, umid, statn,
                    blockUsrChecks[statn], blockUsrRefs[statn], user_top, user_left, user_width, user_height);
                ui_text(#u);
            ui_pop();
        );
    );

    (!chk) ? (
        // module doesn't exist anymore
        blockDesc[Bigx] = 0; // remove reference
        blockUsrRefs[statn] = 0;
        blockUsrNames[statn] = 0;
        blockUsrChecks[statn] = 0;
        blockUsrIds[statn] = 0;
        blockUsrNum[umid] = 0;
    );
);



function genericItemsPos(bNumb)
local(x, xx, xy, igb, u, v, w, m, myp, i, j, k, p, s, wst, kit, blockRent, pn_in)
(
    blockMouseWasIn = 0;
    PanIdt = bNumb;
    // wst = #;
    ((bNumb >=0) && (bNumb < dcbMCount) && menu_Stud_Mod) ? (
        blockDesc = dcbBlocksAll + bNumb * dcbWSize;
        pn_in = ui_hover(); // (the rect of the pane : the modules below split it)
        (pn_in) ? (
            colMouseWasIn = studDispCol;
            // Update col. size
            blockMouseWasIn = blockDesc[dcbWSize - 1];
            // we may need to update the menu
            p = menu_Stud_Mod + ui_jmenu_items;
            i=0; while (i < blockMenuITC) (
                s = p[i]; // u = str_getchar(s, 2, 'cu');
                //((u === ui_jmenu_chSP) || (u === ui_jmenu_noSel))? (
                    str_setchar(s, 1, ui_jmenu_chSP);
                //);
                i += 1;
            );
            i=0; loop(dcbMSize,
                (k = blockDesc[i]) ? (
                    ((k > 0) && (k < blockDispITC)) ? (
                        j = blockDispInverts[k];
                        s = p[j]; str_setchar(s, 1, '!');
                    ) : (
                        blockDesc[i] = 0;
                    );
                );
                i += 1;
            );
            //is there a "current" block ?
            // update "clicked in"
            blockDesc[dcbWSize - 1] = 0;
            A99m = mouse_y;
            i = 0; while ((k = blockDesc[i]) != 0) (
                u = blockDesc[i+dcbMSize]; v = u/10000; u = u %10000; // the block
                ((A99m >= v) && (A99m < (u+v))) ? (
                    // clicked in the box
                    blockDesc[dcbWSize - 1] = k;
                );
                i += 1;
            );
            cModule = A99CBlock = k = blockDesc[dcbWSize - 1];
            strncpy(#Aws3, p[0], 6);
            (k != 0) ? (
                strcat(#Aws3, blockDispNames[blockDispInverts[k]]);
                str_setchar(#Aws3, 1, '!');
            ) : (
                strcat(#Aws3, "-");
            );
            strcpy(p[0], #Aws3);
            // Indicates the pane preferences
            s = p[block1Pane -1 + studDispPrf];
            str_setchar(s, 1, '!');
            (serialBlock[Pr7_StudLive + TabIdt]) ? str_setchar(p[blockTabLive], 1, '!');
            ui_jstyle ? str_setchar(p[blockStyleSoft], 1, '!');
            str_setchar(p[blockThemeDefault + uix_jtheme], 1, '!'); // current theme
            0 ? (
                sprintf(#dbg_trace1, "*ZZZ* [%d]  \"%s\"  (%d)  \"%s\" ", A99CBlock, blockDispNames[blockDispInverts[A99CBlock]], p[0],#Aws3);
            );


            // ADump(blockDesc);

            xx = control_jmenu(menu_Stud_Mod);
            xx ? (
                ui_GFXdoNow |= 1;
                blockRent = xx; // entry selected (trace only)
                kit = jmenu_res2item(menu_Stud_Mod, xx);
                0 ? (
                    sprintf(#dbg_trace0, "[%d/%d] XX  %d \"%s\" %d", TabIdt, bNumb, xx, ui_menu_item(menu_Stud_Mod, xx), kit);
                    mSL_log(SysLogBox, #dbg_trace0);
                );
                // ADump(blockDesc);
                //xx2 = ui_menu_ent(menu_Stud_Mod, xx);
                //p = menu_Stud_Mod + ui_jmenu_items + xx -1; wst = p[0]; k = blockDispIdts[xx-1];
                //    #dbg_desc = #sfc;
                (kit === 0) ? (
                    (cModule > 0) ? (
                        copiedMod = cModule;
                        i = j = 0;
                        while (i < dcbMax) (
                            (cModule === blockDesc[j]) ? (  j+= 1; );
                            blockDesc[i] = blockDesc[j];
                            i += 1 ; j += 1;
                        );
                    );
                ) :
                ((kit >= blockFirst) && (kit < blockDispITC) && (blockDispIdts[kit] > 0)) ? (
                    // we choose a module entry
                    p = menu_Stud_Mod + ui_jmenu_items + kit ; // correct here
                    wst = p[0]; k = blockDispIdts[kit]; // k is ok

                    (x = (str_getchar(wst, 1, 'cu') === '!')) ? (
                        // We must add the new module at the end of the list
                        i = 0; while (blockDesc[i] != 0) ( i+= 1;);
                        blockDesc[i] = e = k; d = i;
                    ) : (
                        // the module was selected. We suppress it from the list
                        i = j = 0;
                        while (j < dcbMax) (
                            (k === blockDesc[j]) ? ( d = j; e = k; j+= 1; );
                            blockDesc[i] = blockDesc[j];
                            i += 1 ; j += 1;
                        );
                    );
                    0 ? (
                        x ? (
                            sprintf(#dbg_trace1, "*ADD* [%d] %d \"%s\" p:%d  n:%d  xx:%d  B:%d", blockDesc, k, wst, d, e, xx, blockMouseWasIn);
                        ) : (
                            sprintf(#dbg_trace1, "*DEL* [%d] %d \"%s\" p:%d  x:%d  xx:%d  B:%d", blockDesc, k, wst, d, e, xx, blockMouseWasIn);
                        );
                        mSL_log(SysLogBox, #dbg_trace1);
                    );
                    // ADump(blockDesc);
                ) :
                (kit === blockTabLive) ? (
                    // switch this tab to the "live" display
                    serialBlock[Pr7_StudLive + TabIdt] = 1;
                ) :
                (kit === blockTabRename) ? (
                    sprintf(#tmp, "New name for tabulation %d...", TabIdt);
                    ui_screen_open("control.prompt");
                    ui_screen_arg(0, altTabsNames[TabIdt]);
                    ui_screen_arg(1, #tmp);
                ) :
                (kit === blockStyleSoft) ? (
                    serialBlock[Pr7_UiStyle] = ui_jstyle = !ui_jstyle;
                ) :
                (kit >= blockThemeDefault) ? (
                    uix_jtheme = kit - blockThemeDefault;
                ) :
                (
                    mSL_GUI_Generic(3, bNumb, cModule, kit);
                );


            );
        );


        // move bottom system log if present
        1 ? (
            i = 0; while (i < dcbMax) (
                u = blockDesc[i]; v = blockDesc[i+1];
                ((u === blockSysLog) && (v !== 0))  ? (
                    blockDesc[i] = v; blockDesc[i+1] = u;
                );
                i += 1;
            );
        );


        // Hors interaction : mise en place des blocs
        Bigx = 0; loop(dcbMSize, igb = blockDesc[Bigx];  // = DISPLAY BLOCKS =
            (igb > 0) ? (
                (igb === blockReaderA) ? (
                    show_Reader_Pad(ReadersStructA, blockReaderA);
                ) :
                (igb === blockReaderB) ? (
                    show_Reader_Pad(ReadersStructB, blockReaderB);
                ) :
                (igb === blockReaderC) ? (
                    show_Reader_Pad(ReadersStructC, blockReaderC);
                ) :
                (igb === blockReaderD) ? (
                    show_Reader_Pad(ReadersStructD, blockReaderD);
                ) :
                (igb === blockReaderE) ? (
                    show_Reader_Pad(ReadersStructE, blockReaderE);
                ) :
                (igb === blockReaderF) ? (
                    show_Reader_Pad(ReadersStructF, blockReaderF);
                ) :
                (igb === blockReaderG) ? (
                    show_Reader_Pad(ReadersStructG, blockReaderG);
                ) :
                (igb === blockReaderH) ? (
                    show_Reader_Pad(ReadersStructH, blockReaderH);
                ) :
                (igb === blockLineA) ? (
                    show_Line_Pad(LinesStructA, blockLineA);
                ) :
                (igb === blockLineB) ? (
                    show_Line_Pad(LinesStructB, blockLineB);
                ) :
                (igb === blockLineC) ? (
                    show_Line_Pad(LinesStructC, blockLineC);
                ) :
                (igb === blockLineD) ? (
                    show_Line_Pad(LinesStructD, blockLineD);
                ) :
                (igb === blockLineE) ? (
                    show_Line_Pad(LinesStructE, blockLineE);
                ) :
                (igb === blockLineF) ? (
                    show_Line_Pad(LinesStructF, blockLineF);
                ) :
                (igb === blockLineG) ? (
                    show_Line_Pad(LinesStructG, blockLineG);
                ) :
                (igb === blockLineH) ? (
                    show_Line_Pad(LinesStructH, blockLineH);
                ) :
                (igb === blockEffectA) ? (
                    show_Effect_Pad(EffectsStructA, blockEffectA);
                ) :
                (igb === blockEffectB) ? (
                    show_Effect_Pad(EffectsStructB, blockEffectB);
                ) :
                (igb === blockEffectC) ? (
                    show_Effect_Pad(EffectsStructC, blockEffectC);
                ) :
                (igb === blockEffectD) ? (
                    show_Effect_Pad(EffectsStructD, blockEffectD);
                ) :
                (igb === blockEffectE) ? (
                    show_Effect_Pad(EffectsStructE, blockEffectE);
                ) :
                (igb === blockEffectF) ? (
                    show_Effect_Pad(EffectsStructF, blockEffectF);
                ) :
                (igb === blockEffectG) ? (
                    show_Effect_Pad(EffectsStructG, blockEffectG);
                ) :
                (igb === blockEffectH) ? (
                    show_Effect_Pad(EffectsStructH, blockEffectH);
                ) :
                (igb === blockWriterA) ? (
                    show_Writer_Pad(WriterStructA, blockWriterA);
                ) :
                (igb === blockWriterB) ? (
                    show_Writer_Pad(WriterStructB, blockWriterB);
                ) :
                (igb === blockWriterC) ? (
                    show_Writer_Pad(WriterStructC, blockWriterC);
                ) :
                (igb === blockWriterD) ? (
                    show_Writer_Pad(WriterStructD, blockWriterD);
                ) :
                (igb === blockWriterE) ? (
                    show_Writer_Pad(WriterStructE, blockWriterE);
                ) :
                (igb === blockWriterF) ? (
                    show_Writer_Pad(WriterStructF, blockWriterF);
                ) :
                (igb === blockWriterG) ? (
                    show_Writer_Pad(WriterStructG, blockWriterG);
                ) :
                (igb === blockWriterH) ? (
                    show_Writer_Pad(WriterStructH, blockWriterH);
                ) :
                (igb === blockMemory1) ? (
                    show_Memory(memoryBox1);
                ) :
                (igb === blockMemory2) ? (
                    show_Memory(memoryBox2);
                ) :
                (igb === blockSysLog) ? (
                    show_SysLog(blockSysLog, SysLogBox);
                ) :
                (igb === blockScheduler) ? (
                    show_Scheduler_Pad(blockDispNames[blockDispInverts[blockScheduler]], blockScheduler);
                ) :
                (igb === blockProcessesMgr) ? (
                    show_ProcessesMgr(blockDispNames[blockDispInverts[blockProcessesMgr]], blockProcessesMgr);
                ) :
                (igb === blockGlobal) ? (
                    show_Global_Pad(blockGlobal);
                ) :
                (igb === blockControls) ? (
                    show_Controls_Pad(blockControls);
                ) :
                (igb === blockPatch) ? (
                    show_Patch_Pad(blockPatch);
                ) :
                (igb === blockInstances) ? (
                    show_Instances_Pad(blockInstances);
                ) :
                ((igb >= blockUsrFirst) && (igb <= blockUsrLast)) && (blockUsrChecks[blockUsrNum[igb - blockUsrFirst]]) ? (
                    show_UserModule(igb);
                );
            );
            Bigx += 1;
        );

        // the pane : Shift + arrows change the width of the columns (after its modules, that may use these keys)
        (pn_in && (GM_key_mods() === 8) && GM_key_take('rght')) ? (
            // try to increase colum size
            p = serialBlock + Pr7_StudRat + 4 * TabIdt;
            ((colMouseWasIn === 0) && (studDispPCnt >= 2)) ? (
                // increase first col. size
                k = min(20, max(0, p[1] - ui_MinSize1Pane));p[0] += k; p[1] -= k;
            ) :
            ((colMouseWasIn === 1) && (studDispPCnt === 2)) ? (
                // increase 2nd col. size
                k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[1] += k; p[0] -= k;
            ) :
            ((colMouseWasIn === 1) && (studDispPCnt >= 3)) ? (
                // increase 2nd col. size
                k = min(20, max(0, p[2] - ui_MinSize1Pane)); p[1] += k; p[2] -= k;
            ) :
            ((colMouseWasIn === 2) && (studDispPCnt === 3)) ? (
                // increase 3nd col. size
                k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[2] += k; p[0] -= k;
            ) :
            ((colMouseWasIn === 2) && (studDispPCnt === 4)) ? (
                // increase 3nd col. size
                k = min(20, max(0, p[3] - ui_MinSize1Pane)); p[2] += k; p[3] -= k;
            ) :
            ((colMouseWasIn === 3) && (studDispPCnt === 4)) ? (
                // increase 4nd col. size
                k = min(20, max(0, p[0] - ui_MinSize1Pane)); p[3] += k; p[0] -= k;
            ) ;
        ) :
        (pn_in && (GM_key_mods() === 8) && GM_key_take('left')) ? (
            // try to increase colum size
            p = serialBlock + Pr7_StudRat + 4 * TabIdt;
            ((colMouseWasIn === 0) && (studDispPCnt === 4)) ? (
                // increase first col. size
                k = min(20, max(0, p[3] - ui_MinSize1Pane));p[0] += k; p[3] -= k;
            ) :
            ((colMouseWasIn === 0) && (studDispPCnt === 3)) ? (
                // increase first col. size
                k = min(20, max(0, p[2] - ui_MinSize1Pane));p[0] += k; p[2] -= k;
            ) :
            ((colMouseWasIn === 0) && (studDispPCnt === 2)) ? (
                // increase first col. size
                k = min(20, max(0, p[1] - ui_MinSize1Pane));p[0] += k; p[1] -= k;
            ) :
            ((colMouseWasIn === 1) && (studDispPCnt >= 2)) ? (
                // increase first col. size
                k = min(20, max(0, p[0] - ui_MinSize1Pane));p[1] += k; p[0] -= k;
            ) :
            ((colMouseWasIn === 2) && (studDispPCnt >= 3)) ? (
                // increase 2nd col. size
                k = min(20, max(0, p[1] - ui_MinSize1Pane)); p[2] += k; p[1] -= k;
            ) :
            ((colMouseWasIn === 3) && (studDispPCnt === 4)) ? (
                // increase 2nd col. size
                k = min(20, max(0, p[2] - ui_MinSize1Pane)); p[3] += k; p[2] -= k;
            ) ;
        );


    );
    blockDesc = 0;
    studDispCol += 1;
);


// Studio menu while a tab uses the "live" display (shift right click anywhere in the tab)
function genericLiveMenu(bNumb)
local (p, i, xx, kit)
(
    PanIdt = bNumb;
    blockDesc = dcbBlocksAll + bNumb * dcbWSize;
    p = menu_Stud_Mod + ui_jmenu_items;
    i = 0; while (i < blockMenuITC) ( str_setchar(p[i], 1, ui_jmenu_chSP); i += 1; );
    str_setchar(p[block1Pane -1 + studDispPrf], 1, '!');
    str_setchar(p[blockTabLive], 1, '!');
    ui_jstyle ? str_setchar(p[blockStyleSoft], 1, '!');
    str_setchar(p[blockThemeDefault + uix_jtheme], 1, '!'); // current theme
    xx = control_jmenu(menu_Stud_Mod);
    xx ? (
        ui_GFXdoNow |= 1;
        kit = jmenu_res2item(menu_Stud_Mod, xx);
        (kit === blockTabLive) ? (
            // back to the panes display
            serialBlock[Pr7_StudLive + TabIdt] = 0;
        ) :
        (kit === blockTabRename) ? (
            sprintf(#tmp, "New name for tabulation %d...", TabIdt);
            ui_screen_open("control.prompt");
            ui_screen_arg(0, altTabsNames[TabIdt]);
            ui_screen_arg(1, #tmp);
        ) :
        (kit === blockStyleSoft) ? (
            serialBlock[Pr7_UiStyle] = ui_jstyle = !ui_jstyle;
        ) :
        (kit >= blockThemeDefault) ? (
            uix_jtheme = kit - blockThemeDefault;
        ) :
        ((kit >= blockFirst) && (kit < blockDispITC)) ? (
            0; // modules are not shown in the "live" display
        ) :
        (kit > 0) ? (
            mSL_GUI_Generic(3, bNumb, 0, kit); // panes, tabs...
        );
    );
);

// "Live" display of a tab : animated background and display boxes (see mSL_Live_Screen)
function genericLiveTab()
(
    live_tab_active = 1;
    live_screen_tick();
    live_screen();
    uix_gfx_clear = gfx_clear; // keep the live background (used by update_theme / control_start)
    genericLiveMenu(TabIdt * dcbPannelsMax);
);


function genericTabSet(tbNum)
local (p, ww, t, BankLink)
(
    do_GenericTabStart();
    //colMouseWasIn = -1;
    BankLink = 1;
    TabIdt = max(0, min(7, 0|tbNum));
    studDispPrf = studDispPCnt = max(1, min(4, 0|(serialBlock[Pr7_StudConf+TabIdt])));

    (serialBlock[Pr7_StudLive + TabIdt]) ? (
        genericLiveTab();
    ) : (
    ww = gfx_w / ui_retina();


    (studDispPCnt === 4) ? (
        (ww < ui_MinSize4Panes) ? studDispPCnt = 3;
    );
    (studDispPCnt === 3) ? (
        (ww < ui_MinSize3Panes) ? studDispPCnt = 2;
    );
    (studDispPCnt === 2) ? (
        (ww < ui_MinSize2Panes) ? studDispPCnt = 1;
    );
    /*
    (studDispPCnt === 1) ? (
        (ww > ui_MaxSize1Pane) ? studDispPCnt = 2;
    );
    */

    studDispCol = 0;
    p = serialBlock + Pr7_StudRat + 4 * TabIdt;
    (studDispPCnt === 4)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1] + p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
        ui_split_leftratio(max(1, p[1])/max(1, p[1] + p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
        ui_pop();
        ui_split_leftratio(max(1, p[2])/max(1, p[2] + p[3]));
            genericItemsPos(TabIdt * dcbPannelsMax + 2);
        ui_pop();
            genericItemsPos(TabIdt * dcbPannelsMax + 3);
    ) :
    (studDispPCnt === 3)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1] + p[2]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
        ui_split_leftratio(max(1, p[1])/max(1, p[1] + p[2]));
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
        ui_pop();
        //ui_split_leftratio(1);
            genericItemsPos(TabIdt * dcbPannelsMax + 2);
        //ui_pop();
    ) :
    (studDispPCnt === 2)  ? (
        ui_split_leftratio(max(1, p[0])/max(1, p[0] + p[1]));
            genericItemsPos(TabIdt * dcbPannelsMax);
        ui_pop();
            genericItemsPos(TabIdt * dcbPannelsMax + 1);
    ) : (
        genericItemsPos(TabIdt * dcbPannelsMax);
    );
    ); // live / panes
    do_GenericTabEnd();
);



//====== GRAPHIC EXECUTION START ======

(gui_show_UI) ? (
    must_do_gfx() ? (

        gfx_executed += 1; // just a trace
        // do here the graphic stuff...

        do_gfx_init ? (
            do_gfx_init = 0; // perform only once
            uix_default_fontsize = ui_jdefault_fontsize;
            // uix_default_fontface = "Verdana";
            // uix_default_fontface = "Times";
            // uix_default_fontface = "Futura";
            uix_default_fontface = ui_jdefault_fontface;
        );

        (live_tab_active == 0) ? uix_gfx_clear = -1; // live background only for "live" tabs
        live_tab_active = 0;
        serialBlock[Pr7_UiTheme] = uix_jtheme; // saved with the preset ('stud' block)
        update_theme();
        GM_key_frame(); // the key of the frame (see mSL_ui_LibJJ, Keyboard)

        currScreen = ui_screen();
        ui_Xtime_period = 1; // refresh screen every second


        ui_font();

        my_menu_bar(uix_jG_menuscr);



        //SCREENS

        ui_screen() === "Main" ? (
            /*
            show_local_Infos();

            gui_show_syslog ? show_SysLog(0, SysLogBox);
            gui_show_memory ? (
                (gfx_w > gfx_colM_width) ? (
                    ui_split_leftratio(0.5);
                    show_Memory(memoryBox1);
                    ui_pop();
                );
                show_Memory(memoryBox2);
            );
            */
            genericTabSet(0);
        ) :

        ui_screen() === "Logs" ? (
            /*
            SysLogBox[4] = 80;
            show_SysLog(0, SysLogBox);
            (gfx_w > gfx_colM_width) ? (
                ui_split_leftratio(0.5);
                show_Memory(memoryBox1);
                ui_pop();
            );
            show_Memory(memoryBox2);
            */
            genericTabSet(1);
        ) :

        ui_screen() === "Dump" ? (
            /*
            memoryBox1[17] = memoryBox2[17] = 96;
            (gfx_w > gfx_colM_width) ? (
                ui_split_leftratio(0.5);
                show_Memory(memoryBox1);
                ui_pop();
            );
            show_Memory(memoryBox2);
            */
            genericTabSet(2);
        ) :

        ui_screen() === "Settings" ? (
            genericTabSet(3);
        ) :

        ui_screen() === "Live 1" ? (
            genericTabSet(4);
        ) :

        ui_screen() === "Live 2" ? (
            genericTabSet(5);
        ) :

        ui_screen() === "Live 3" ? (
            genericTabSet(6);
        ) :

        ui_screen() === "Live 4" ? (
            genericTabSet(7);
        ) :

        //SCREEN--DEFAULT
        (
            ui_GFXdoNow |= 3;
            do_GenericTabStart();
            control_system();
            do_GenericTabEnd();
        );
        my_menu_bar_overlay(uix_jG_menuscr); // "soft" look : the tabs bar over the panes (see ui-lib-JJ-GUI)

    );
) : (
    // Clear screen

    // Minimalist work
    gfx_clear = 0xeeeeee; // light grey background color identical to sliders background
    gfx_x = gfx_y = 0;
    gfx_setpixel(0xee,0xee,0xee);
);

// The keys left by the modules and the tabs : the commands of Interstys, then the system commands
(!gui_show_UI) ? GM_key_frame(); // (no UI : the key is read here, for 'U')
do_Plugin_Keys();
do_System_Keys();
GM_key_end(); // the key not used is dropped

ui_end_do_gfx();

