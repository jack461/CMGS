function nowTime()
(
    sprintf(#nowis, "Now: %02d/%02d/%02d ", gmem[timeDay], gmem[timeMonth], gmem[timeYear]);
    edTimeL(gmem[timeSecOfDay]);
    strcat(#nowis, #edt);
);

// Convert sample to seconds; rounded to ms.
function smp2sec(v)
(
    floor(0.5 + 1000 * v/srate) / 1000;
);

// Convert seconds to samples
