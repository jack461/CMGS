                    (w !== ((wk > BASE_MEMORY) ? wk[its_FxW_Size] : 0)) ? (
                        (w === 0) ? (
                            b[its_Efx_WkNew] = -1; // no more area
                        ) : (
                            wk = mSL_Dyn_Alloc(w, KW_fxwk, mSL_StM_FlClear);
                            (wk > BASE_MEMORY) ? (
                                wk[its_FxW_Size] = w;
