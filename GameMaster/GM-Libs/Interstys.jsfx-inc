            Currwriter[its_Wrt_Status] = slWrStatusPrv = slWrStatus;
sprintf(#A012,"Wr.set-line %d {%d  %d} st=%d", slWriter, Currwriter[its_Wrt_LineNb], Currwriter[its_Wrt_Lcbl], slWrStatus);
        );
        wrupdt = 1;
    );

    (slWrStatus != slWrStatusPrv) ? (
        str_mess = "Writer status changed 1";
        (Currwriter !== 0) ? (
            str_mess = "Writer status changed 2";
            ((Currwriter[its_Wrt_Lcbl] < BASE_MEMORY) || (Currwriter[its_Wrt_Cell] === 0)) ? (
                slWrStatus = its_WrtStat_Created;
                str_mess = "Writer status changed 3";
            ) : (
                slWrStatus = max(its_WrtStat_Ready, slWrStatus);
                str_mess = "Writer status changed 4";
            );
            (slWrStatus === its_WrtStat_Writing) ? (
                str_mess = "Writer status changed 5";
