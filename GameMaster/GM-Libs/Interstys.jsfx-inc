                ns = its_RdrStat_Created;
            ) :
            (nstat === its_RdrStat_Paused) ? (
                ns = its_RdrStat_Paused;
            ) :
            (nstat === its_RdrStat_Reading) ? (
                ns = its_RdrStat_Reading;
            ) : (
                ns = its_RdrStat_Ready;
            );
        ) :
        (
            ns = its_RdrStat_Created;
        );
