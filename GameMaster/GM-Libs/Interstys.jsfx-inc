        writer[its_Wrt_Abspos] = k;
        /*
        Trace_X_its_Wrt_1_First = writer[its_Wrt_Start];
        Trace_X_its_Wrt_2_Abspos = k;
        Trace_X_its_Wrt_3_Last = writer[its_Wrt_Last];
        */
        ((nbr === slWriter) && (wrtim !== ctime)) ? (
            wrtim = ctime;
            slWrPosPrv = slWrPos = max(0,min(100, floor(0.5 + 10000 * (writer[its_Wrt_Abspos] - writer[its_Wrt_Start])/max(1, writer[its_Wrt_Last] - writer[its_Wrt_Start]))/100)) ;
        );
    ) : (
        // An error occured
        ((writer > BASE_MEMORY) && (writer[-2] === KW_writ)) ? (
            ((writer[its_Wrt_Lcbl] > BASE_MEMORY) && (writer[its_Wrt_Cell] != 0)) ? (
