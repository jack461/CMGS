// execute a reader in mode Grains (@sample) : the grains running, each one to the cell "oc" + its output channel, and a
// new grain at its time ; the type "stop", or a loop "once" at the end of the line (its_Rdr_BrEnd) : no new grain, the
// reader ends with its last grain ; silent until @block has put in place a work area of the mode (its_Rd_WorkSwitch)
function exec_grains(reader, nbr, lcbl, vol, oc, playing)
local (wk, g, n, j, fi, pl, t, u, x, e, b, d, ow, stop)
(
    wk = reader[its_Rdr_Work];
    ((wk > BASE_MEMORY) && (wk[its_RdW_Size] === its_RdGr_WkSz)) ? (
        (reader[its_Rdr_StJ] < 0) ? (
