            ((b[its_Wrt_Mod1 + i * its_ModDist + its_Mod_Src] !== 0) && (ok & (1 << i))) ? its_Tb_Cat(ty, its_TbWMod + i, b);
            i += 1;
        );
    ) : (
        md = b[its_Rdr_Mode];
        its_Tb_Cat(ty, 4, b);
        its_Rd_Lined(md) ? (
            (b[its_Rdr_LineNb] >= 0) ? its_Tb_Cat(ty, 0, b);
            (md !== its_RdrMode_Read) ? its_Tb_Cat(ty, 14, b); // Stretch, Brage, Grains
        ) : (
            (b[its_Rdr_WrSrc] >= 0) ? its_Tb_Cat(ty, 1, b);
            its_Tb_Cat(ty, 2, b);
        );
        its_Tb_Cat(ty, 3, b);
        i = 5; loop(5, its_Tb_Cat(ty, i, b); i += 1;);
        (its_Rd_Lined(b[its_Rdr_Mode]) && (b[its_Rdr_LoopSpd] !== 0)) ? its_Tb_Cat(ty, 10, b); // a moving loop
        (its_Rd_Lined(b[its_Rdr_Mode]) && (b[its_Rdr_LoopCross] !== 0)) ? its_Tb_Cat(ty, 13, b); // it crosses the end of the line
        (its_Rd_Lined(b[its_Rdr_Mode]) && (b[its_Rdr_Desync] !== 0)) ? its_Tb_Cat(ty, 11, b); // channels desynchronized
        (b[its_Rdr_OutCnt] > 0) ? its_Tb_Cat(ty, 12, b); // a count of output channels chosen
        // the settings of the mode : Stretch and Brage (block, overlap, search, transp ; stretch : Stretch), Grains
        its_Rd_Blocks(md) ? ( i = 15; loop((md === its_RdrMode_Stretch) ? 5 : 4, its_Tb_Cat(ty, i, b); i += 1;); );
        (md === its_RdrMode_Grains) ? ( i = 20; loop(13, its_Tb_Cat(ty, i, b); i += 1;); );
        (its_Rd_Lined(md) && (b[its_Rdr_LoopWr] > 0)) ? its_Tb_Cat(ty, 33, b); // the loop follows a writer
        its_Rd_Lined(md) ? (
            // the loop : its limits, if it is not the whole line ; its length, if it follows a writer (an export : it changes with the writer)
            (b[its_Rdr_LoopWr] > 0) ? (
                its_Xp_On ? its_Tb_Cat(ty, 37, b);
            ) :
