// MENUS : A few channels /count / menu
menu_Chn_Ids_N = make_array(CH_NB);
<? i=0; loop(CH_NB, printf("menu_Chn_Ids_N[%d] = \"%d\";", i, i+1); i +=1;); ?>
menu_Chn_Ids = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "channels-num", CH_NB, menu_Chn_Ids_N);

// channels 0 ... 127 (first channel : in a line, in a bus or in Out), in 4 sub-menus of 32 (as menu_128_1_Ids : the ">" headers are not counted)
menu_128_0_Ids_N = make_array(128 + 4);
<? i=0; j=0; loop(128, (i % 32) == 0 ? (printf("menu_128_0_Ids_N[%d] = \">%d-%d\";", j, i, i+31); j += 1;); printf("menu_128_0_Ids_N[%d] = \"%s%d\";", j, ((i % 32) == 31) ? "<" : "", i); i += 1; j += 1;); ?>
menu_128_0_Ids = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "nums-128-0", 128 + 4, menu_128_0_Ids_N);

// counts 1 ... 128 (channels of a line, channels used), in 4 sub-menus of 32 (the ">" headers are not counted in the results)
