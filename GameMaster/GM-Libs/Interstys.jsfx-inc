//==========================================================
//===== WRITERS Handling
// Writers_set[WR_CNT]

// the default settings of W-Mix (fade, plateau, wait : s ; direction ; desync : %), in the order of its_Wrt_WFade ...
its_WMix_Def = make_array(5);
its_WMix_Def[0] = 0.05; its_WMix_Def[1] = 1; its_WMix_Def[2] = 1; its_WMix_Def[3] = 1; its_WMix_Def[4] = 0;
function its_Wrt_WMixInit(wcb)
(
    memcpy(wcb + its_Wrt_WFade, its_WMix_Def, 5);
    wcb[its_Wrt_WPhase] = its_WMix_Cycle;
);

function Wr_Clear(wnum)
local (wcb)
(
    ((wnum >= 0) && (wnum <= WR_CNT) && ((wcb = Writers_set[wnum]) > BASE_MEMORY) && (wcb[-2] === KW_writ)) ? (
        memset(wcb, 0, its_Wrt_BlkSize);
        wcb[its_Wrt_LineNb] = -1;
        wcb[its_Wrt_BLType] = 2000;
        wcb[its_Wrt_InGain] = 1;
        wcb[its_Wrt_Status] = its_WrtStat_Created;
        wcb[its_Wrt_Unuz1] = wcb[its_Wrt_Unuz2] = SECURE_BL;
        wcb[its_Wrt_Number] = wnum;
        wcb[its_Run_Kind] = its_RunK_Writer;
        its_Mod_Init(wcb + its_Wrt_Mod1, its_Wrt_ModN); // modulation attenuverters
        its_Wrt_WMixInit(wcb);
        its_Run_Check(wcb);
    );
);
// Create a writer in slot "wnum" or return the existing writer
function Wr_Make(wnum)
local(wcb)
(
    ((wcb = Writers_set[wnum]) === 0) ? (
        wcb = mSL_Dyn_Alloc(its_Wrt_BlkSize, KW_writ, 0); // allocate memory
        Writers_set[wnum] = wcb;
        Wr_Clear(wnum);
    );
    wcb;
);

// Delete a writer from Writers_set
function Wr_Delete(wnum)
local (wcb)
(
    ((wnum >= 0) && (wnum <= WR_CNT) && ((wcb = Writers_set[wnum]) > BASE_MEMORY) && (wcb[-2] === KW_writ)) ? (
        Writers_set[wnum] = 0;
        its_Run_Free(wcb);
    );
    Writers_set[wnum] = 0;
);


// Menu 1 for Writer : their names, in sub-menus of 32 writers (the ">" headers are not counted in the results)
<? wr_grp = 32; wr_mnc = WR_CNT + (0|((WR_CNT + wr_grp - 1) / wr_grp)); ?>menu_Wrt_Ids_N = make_array(<? printf("%d", wr_mnc); ?>);
