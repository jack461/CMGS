// Shared display modules : scheduler pad (mSL_show_Utilities.jsfx-inc)
<? shw_part = 1; include("GM-Libs/mSL_show_Utilities.jsfx-inc"); ?>
shw_Sched_Init();
shw_Proc_Init();
shw_AppName = "Interstys"; // in the names of the log files (sysout)
// Audio waveforms (mSL_ui_audio.jsfx-inc) : work tables and colors ; waveform of a line in show_Line_Pad
ui_audio_init();
its_LinWaveH = 120; // height of the waveform of a line
its_LinWaveMax = 4; // max channels shown (the loudest ones)
// Colors of the markers and of the region in the waveforms
// (set by its_wave_colors before each waveform : darker hues with the light themes, see uix_theme_thickline)
its_WaveColWrt = 0x20FF20; // writing head : green
its_WaveColRdr = 0xFFE020; // reading head : yellow
its_WaveColAux = 0xFF8C20; // auxiliary reading head (during a cross fade) : orange
its_WaveColReg = 0x4080FF; // loop region (shaded)
its_WaveColRegLim = 0x909090; // limits of the cross fades around the region
function its_wave_colors()
(
    uix_theme_thickline() ? (
        // light background
        its_WaveColWrt = 0x008C00; // dark green
        its_WaveColRdr = 0xA87800; // ochre
        its_WaveColAux = 0xD04800; // dark orange
        its_WaveColRegLim = 0x505050;
    ) : (
        its_WaveColWrt = 0x20FF20;
        its_WaveColRdr = 0xFFE020;
        its_WaveColAux = 0xFF8C20;
        its_WaveColRegLim = 0x909090;
    );
);

// Some global variables

// Update the default menu screen
uix_jG_menuscr[ii=0] = "Main";
uix_jG_menuscr[ii+=1] = "Logs";
uix_jG_menuscr[ii+=1] = "Dump";
uix_jG_menuscr[ii+=1] = "Settings";
uix_jG_menuscr[ii+=1] = "Live 1";
uix_jG_menuscr[ii+=1] = "Live 2";
uix_jG_menuscr[ii+=1] = "Live 3";
uix_jG_menuscr[ii+=1] = "Live 4";
uix_jG_menuscr[ii+=1] = -1;
dcbTabsCount = ii; // menu bar max -- number of tabs
uix_jG_menuscrSz = dcbTabsCount + 2; // add some size to display sound indicator


dcbPannelsMax = 4; // up to 4 pannels in each tabulation
dcbMSize = 32; // max number of different displayable modules in each pane
dcbMax = dcbMSize - 1;
dcbMCount = dcbTabsCount * dcbPannelsMax; // number of different modules sets - used for main, studios A, B , etc.
// we currently use 64 * 2 words, so 128 for each menu
dcbWSize = dcbMSize * 2;
dcbBSize = dcbWSize * dcbMCount;

scbTempCopy = make_array(dcbWSize); // temporary copy of a pane (copy/paste/swap panes) - as in GamePlayer
Simple_temp = make_array(10); // work area for Simple_Action(code, seq)


FlagsTbSiz = 32;
FlagsTbVals = make_array(FlagsTbSiz);
idx = 0;
Flgs_PrOps = (idx += 1);
Flgs_Thrds = (idx += 1);
Flgs_Evnts = (idx += 1);
Flgs_Acts = (idx += 1);
Flgs_Traces = (idx += 1);
Flgs_Umods = (idx += 1);
Flgs_GC = (idx += 1); // GC traces (see mSL_Garbage_Collector)


KRun_mSL_Thread = 10;


// The "theme" menu
uix_jtheme_menu = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_usesel |
    //
    ui_jmenu_opt_rclick |
    //  ui_jmenu_opt_alclick |
