sprintf(#A016,"Wrt. %d  st=%d/%d (%d : %d)", slWriter, slWrStatus, Currwriter[its_Wrt_Status], Currwriter[its_Wrt_LineNb], slWDlLine - 1);
                (Currwriter[its_Wrt_LineNb] != slWDlLine - 1) ? (
                    zzz_wr_b_err = Wr_Set_Line(slWriter, slWDlLine - 1); // sets flags, etc.
                    bfr = Currwriter[its_Wrt_Lcbl];
                    // slWDlSizePrv = slWDlSize = floor(1000 * bfr[its_Lin_SmplCnt]/srate) / 1000;
