// Create the scheduler structure
SchedSetup();
//0 ?
(sprintf(#uuu, "SchedSetup :   %d tasks", SchedListSize(SchedFreePts));mSL_log(SysLogBox, #uuu););



// Sizes of Allocated arrays for the Compiler and the Evaluator
C_compSize = 64 * 1024; // size : 64 kW [kilo words, not kilo watts]
C_progSize = 64 * 1024; // size  for the evaluator
ui_jmake_arraymax = 0x7FFFFFF; // "no" limit in the size of an array...

// Then, initialize all structures of the compiler.
C_compArea = make_array(C_compSize);
C_progArea = make_array(C_progSize);

// Création des tableaux
// certains ont un élément de plus pour les copy/paste
PtrsInWA = RD_CNT+1 + WR_CNT+1 + FX_CNT+1 + LN_CNT + 1;
StaticWASize = PtrsInWA + SMPL_SIZE + 1;
StaticWA = make_array(StaticWASize); // ensemble des pointeurs mémoire et cellules
DuplWA = make_array(StaticWASize); // pour load/save des pointeurs mémoire
// protect lines, readers, writers, effects (dynamic blocks) from the garbage collector
mm_usr_prot[mm_usr_prot_ptr] = StaticWA; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = DuplWA; mm_usr_prot_ptr += 1;
AltWAdec = DuplWA - StaticWA; // décalage pour accès aux objets similaires des deux ensembles

sinc_table = make_array(SINC_TABLE_SIZE+2); // // valeurs d'une fonction "sinc"
sinus_table = make_array(SINUS_TABLE_SIZE+2); // Fonction sinus in [0 .. pi/2]

// Remplissage de la table SInc
i__i = 0;
loop(SINC_TABLE_SIZE,
  // On mappe l'index de la table sur la plage [-SINC_RADIUS, SINC_RADIUS]
  i__x = (i__i / SINC_TABLE_SIZE) * 2 * SINC_RADIUS - SINC_RADIUS;
  // Calcul de la fonction SInc
  i__z = 1;
  i__x != 0 ? (i__w = $pi * i__x; i__z = sin(i__w) / (i__w););
  sinc_table[i__i] = i__z;
  i__i += 1;
);

// Remplissage de la table SInus in [0 .. pi/2]
i__i = i__w = 0; i__x = $pi / 2 / SINUS_TABLE_SIZE;
loop(SINUS_TABLE_SIZE + 1,
    sinus_table[i__i] = sin(i__w);
    i__i += 1; i__w += i__x;
);
sinus_table[i__i] = 1;


// Load/Save Area
idx = 0;
SVASIZ = max(idx, 32);
savarea = make_array(SVASIZ); // Load/Save description area
lodarea = make_array(SVASIZ); // Load/Save description area
TMPSIZ = 4;
savtmp = make_array(2 * TMPSIZ); // Work area for load/save of a memory block (two headers : 'ains')
savcode = '1tr6'; // a save code
// Saving doubles in @serialize as two singles : save_mem, load_mem, savwrk (shared, mSL_Serialize.jsfx-inc)
<? include("GM-Libs/mSL_Serialize.jsfx-inc"); ?>
ser_Init();


// Créations des tables d'objets et de cellules
function updt_tables(wa)
(
    Lines_Set = wa;
    Readers_set = Lines_Set + LN_CNT+1;
    Writers_set = Readers_set + RD_CNT+1;
    Effects_set = Writers_set + WR_CNT+1;
    smpl_tab = Effects_set + FX_CNT +1;
);
updt_tables(StaticWA);


//===== CABLES
/*
    Each output of a module (reader, effect) owns a cable : CBL_W cells of the Pool, its only source.
    An output can instead add into a bus (Out, Bus k) : the buses are cleared at each sample.
    An input names its source (kind * ITS_KMul + number, see the ITS_K... kinds) and the first channel taken.
    The cables are allocated by its_Patch_Update (in @gfx) ; the modules compute the cells of their inputs
    and outputs when they are checked (exec_reader, exec_writer, exec_fx), after each change of the patch.
*/
CblRdStart = make_array(RD_CNT + 1); // first cell of the cable of each reader (0 : none)
CblRdWidth = make_array(RD_CNT + 1); // its width (channels)
CblFxStart = make_array(FX_CNT + 1); // first cell of the cable of each effect (0 : none)
CblFxWidth = make_array(FX_CNT + 1); // its width (channels)
CblPool = make_array(CBL_CELLS); // 1 : cell of the Pool used by a cable
// The buses are virtual : a bus used (as an input or an output) gets cells of the Pool, as wide as its users need
BusStart = make_array(NB_BUS); // first cell of each bus (0 : none)
BusWidth = make_array(NB_BUS); // its width (channels)
BusNeed = make_array(NB_BUS); // the width asked by its users (see its_Patch_Scan(-2))
BusAct = make_array(NB_BUS); // the buses that have cells : BusAct[0 ... BusActN-1] (cleared at each sample)
BusActN = 0;
its_PatchV = 0; // version of the patch : changes when a cable is allocated or freed
its_PatchForce = 1; // 1 : check again all the modules (start, preset loaded)

// allocate "w" cells in the Pool (first fit) ; returns the first cell, 0 if no room
function Cbl_Alloc(w)
local (i, n, res)
(
    res = n = i = 0;
    while ((res === 0) && (i < CBL_CELLS)) (
        (CblPool[i] === 0) ? (
            n += 1;
            (n >= w) ? (res = CBL_P + i - w + 1);
        ) : (
            n = 0;
        );
        i += 1;
    );
    (res > 0) ? (
        memset(CblPool + res - CBL_P, 1, w);
        memset(smpl_tab + res, 0, w);
    ) : (
        sprintf(#cblmsg, "Cables : no room for %d channels in the Pool (%d cells)", w, CBL_CELLS);
        mSL_log(SysLogBox, #cblmsg);
    );
    res;
);

// free the "w" cells from "start"
function Cbl_Free(start, w)
(
    (start >= CBL_P) ? (
        memset(CblPool + start - CBL_P, 0, w);
        memset(smpl_tab + start, 0, w);
    );
);

/*
    first cell of the "w" channels taken from the channel "off" of the source "src" (kind * ITS_KMul + number)
    returns 0 for no source, -1 if the source is not valid (unknown, without cable, too narrow)
*/
function its_Src_Cell(src, off, w)
local (k, n, base, bw)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    base = bw = 0;
    (k === ITS_KIn) ? (base = IN_P; bw = CH_NB;) :
    (k === ITS_KOut) ? (base = OUT_P; bw = CH_NB;) :
    ((k === ITS_KBus) && (n < NB_BUS)) ? (base = BusStart[n]; bw = BusWidth[n];) :
    ((k === ITS_KCtl) && (n < NB_CTL)) ? (base = CTL_P + n; bw = NB_CTL - n;) :
    ((k === ITS_KRdr) && (n < RD_CNT)) ? (base = CblRdStart[n]; bw = CblRdWidth[n];) :
    ((k === ITS_KFx) && (n < FX_CNT)) ? (base = CblFxStart[n]; bw = CblFxWidth[n];);
    (src === 0) ? 0 :
    ((base > 0) && (off >= 0) && (w >= 1) && (off + w <= bw)) ? base + off : -1;
);

/*
    first cell of the "w" channels of an output : "dst" 0 is the own cable of the module ("own", "ownw" channels),
    else Out or a bus (with the first channel "off") ; returns -1 if not valid
*/
function its_Out_Cell(dst, off, w, own, ownw)
local (k)
(
    k = floor(dst / ITS_KMul);
    (dst === 0) ? (((own > 0) && (w <= ownw)) ? own : -1) :
    ((k === ITS_KOut) || (k === ITS_KBus)) ? its_Src_Cell(dst, off, w) : -1;
);

// the output width of the reader "r" : its count of output channels, or else its count of channels used
function its_Rdr_OutWidth(r)
(
    max(1, min(128, (r[its_Rdr_OutCnt] > 0) ? r[its_Rdr_OutCnt] : r[its_Rdr_BfChanUsed]));
);

/*
    the transfer function of the curve "k" (its table, see its_CrvTab) : bipolar (uni 0), u in [-1, 1] covers the part edited
    (as the mode Curve of the Saturation) : Env, HEnv, Wave : F((u + 1) / 2), u held in [-1, 1], Env and HEnv : 2 F - 1 ;
    QWave : F(u / 4), HWave : F(u / 2), the curve edited for u in [0, 1], odd (-u gives -y) ; beyond, the cycle of the form
    (QWave : folds back at 1, as the mode Fold ; HWave : goes on below 0) ; unipolar (uni not 0), u in [0, 1] : Env, HEnv,
    Wave : F(u) (an envelope stays in [0, 1]) ; QWave, HWave : as bipolar ; cubic interpolation (Catmull-Rom), linear in the
    first and the last intervals of Env, HEnv, Wave (not a cycle) ; a curve that does not exist : 0
*/
function its_Crv_Xfer(u, k, uni) local(ty, t, x, j, p)
(
    its_CrvTbE[k] ? (
        ty = its_CrvTbC[k * its_Crv_BlkSize + its_Crv_Type]; // (the type of the table)
        t = its_CrvTab + k * its_CrvTbSz + its_CrvTbG;
        ((ty === its_CrvQWave) || (ty === its_CrvHWave)) ? (
            x = u * ((ty === its_CrvQWave) ? 0.25 : 0.5);
            x = (x - floor(x)) * its_CrvTbN;
            j = floor(x); x -= j; p = t + j;
            p[0] + 0.5 * x * (p[1] - p[-1] + x * (2 * p[-1] - 5 * p[0] + 4 * p[1] - p[2] + x * (3 * (p[0] - p[1]) + p[2] - p[-1])));
        ) : (
            x = (uni ? max(0, min(1, u)) : 0.5 * (max(-1, min(1, u)) + 1)) * (its_CrvTbN - 1);
            j = min(its_CrvTbN - 2, floor(x)); x -= j; p = t + j;
            x = ((j === 0) || (j === its_CrvTbN - 2)) ? p[0] + x * (p[1] - p[0]) :
                p[0] + 0.5 * x * (p[1] - p[-1] + x * (2 * p[-1] - 5 * p[0] + 4 * p[1] - p[2] + x * (3 * (p[0] - p[1]) + p[2] - p[-1])));
            ((ty === its_CrvWave) || uni) ? x : 2 * x - 1;
        );
    ) : 0;
);

/*
    the law of a modulation input "p" (its block in a module, see its_Mod_...) : x the value of its cell, b the value of the
    setting it modulates, da the action of the input when its law is the default one (its_ModA_...), k the unit of its depth
    in the unit of b (action Add) ; u = x * attenuverter ; unipolar : (u + 1) / 2 ; the shape (its_ModS_...) : Lin u, Exp
    u |u|, Log sign(u) sqrt(|u|), Curve its_Crv_Xfer ; then the action with the depth d : Add b + k d u, Scale b (1 + d u),
    Oct b 2^(d u), dB b 10^(d u / 20) ; no source, or bypass : b
*/
function its_Mod_Law(p, x, b, da, k)
local (f, a, s)
(
    f = p[its_Mod_Flags];
    ((p[its_Mod_Src] === 0) || (f & its_ModF_Byp)) ? b : (
        x *= p[its_Mod_Att];
        (f & its_ModF_Uni) ? (x = 0.5 * (x + 1));
        s = (f >> 5) & 3;
        (s === its_ModS_Exp) ? (x *= abs(x)) :
        (s === its_ModS_Log) ? (x = (x < 0) ? -sqrt(-x) : sqrt(x)) :
        (s === its_ModS_Crv) ? (x = its_Crv_Xfer(x, (f >> 8) & 63, f & its_ModF_Uni));
        x *= p[its_Mod_Depth];
        ((a = (f >> 2) & 7) === 0) ? (a = da);
        (a === its_ModA_Add) ? b + k * x :
        (a === its_ModA_Scale) ? b * (1 + x) :
        (a === its_ModA_Oct) ? b * (2 ^ max(-30, min(30, x))) :
        b * (10 ^ (max(-600, min(600, x)) / 20));
    );
);

/*
    the modulation input "p" applied to the value "b" (see its_Mod_Law) : its cell ; a control cell (slider) is smoothed (time
    constant about 10 ms) : the cables of the modules are not
*/
its_ModSmK = 1 - exp(-1 / (0.010 * srate));
function its_Mod_Apply(p, b, da, k)
local (x)
(
    (p[its_Mod_Src] === 0) ? b : (
        x = smpl_tab[p[its_Mod_Cell]];
        (p[its_Mod_Ctl]) ? (x = (p[its_Mod_Smooth] += its_ModSmK * (x - p[its_Mod_Smooth])));
        its_Mod_Law(p, x, b, da, k);
    );
);

// the "n" modulation inputs from "mp" : attenuverters 1 (a new module)
function its_Mod_Init(mp, n)
(
    loop(n, mp[its_Mod_Att] = 1; mp += its_ModDist;);
);

// the "n" modulation inputs from "mp" : the cells read (an invalid source : no modulation) ; returns 1 if a source is not valid
// (called when the module is checked, in @sample)
function its_Mod_Resolve(mp, n)
local (c, bad)
(
    bad = 0;
    loop(n,
        c = its_Src_Cell(mp[its_Mod_Src], mp[its_Mod_Off], 1);
        mp[its_Mod_Cell] = (c > 0) ? c : ZERO_P;
        mp[its_Mod_Ctl] = (floor(mp[its_Mod_Src] / ITS_KMul) === ITS_KCtl);
        (c < 0) ? (bad = 1);
        mp += its_ModDist;
    );
    bad;
);

// the input "j" of "mp" is used : connected, and meaningful ("okm" : mask of the inputs meaningful in the mode of the module)
function its_Mod_Used(mp, j, okm)
(
    (mp[j * its_ModDist + its_Mod_Src] !== 0) && ((okm & (1 << j)) !== 0);
);

// the modulation inputs meaningful in the mode of the writer : gain and overdub ; W-Mix : gain and its 5 settings
function its_Wrt_ModOk(wcb)
(
    (wcb[its_Wrt_Mode] === its_WrtMode_WMix) ? 0x7D : 3;
);

// the modulation inputs shown : 2, or 7 in W-Mix
function its_Wrt_ModShown(wcb)
(
    (wcb[its_Wrt_Mode] === its_WrtMode_WMix) ? its_Wrt_ModN : 2;
);

// Saturation : the modulation inputs meaningful (drive, bias ; the order or the stretch in the modes x - sin, Chebyshev, Cheb. sum)
function its_Sat_ModOk(fx)
(
    3 | (((fx[its_Efx_Par1 + 1] >= its_SatXSin) && (fx[its_Efx_Par1 + 1] <= its_SatChebSum)) ? 4 : 0);
);

// Matrix : the modulation inputs meaningful (decay, damping ; the diffusion : not Hadamard)
function its_Mx_ModOk(fx)
(
    3 | ((fx[its_Efx_Par1 + 1] !== its_MxHadam) ? 4 : 0);
);

// Matrix, Shimmer : the type "ty" is one of them (the same engine, see exec_matrix)
function its_Mx_Is(ty) ( (ty === its_Efx_TyMatrix) || (ty === its_Efx_TyShimmer); );

// Matrix : its count of lines : its channels, or the minimum count of lines (MxX + 8) ; Hadamard : the power of 2 above ; the
// extra lines inside, without input nor output
function its_Mx_Lines(fx)
local (n, k)
(
    n = max(1, min(its_MxMaxL, max(floor(fx[its_Efx_CCnt]), floor(fx[its_Efx_MxX + 8]))));
    (fx[its_Efx_Par1 + 1] === its_MxHadam) ? ( k = 1; while (k < n) (k *= 2); min(its_MxMaxL, k); ) : n;
);

// Matrix, Shimmer : the default values that differ (FX_Set_Type, the resets of the pad : Shift + clic) : 0 decay (s),
// 1 damping (Hz), 2 mix, 3 dmin (ms), 4 dmax (ms), 5 high pass (Hz), 6 wow, 7 rate (Hz), 8 lines
function its_Mx_Def(ty, j)
(
    (ty === its_Efx_TyShimmer) ?
        ((j === 0) ? 8 : (j === 1) ? 7000 : (j === 2) ? 0.5 : (j === 3) ? 30 : (j === 4) ? 120 : (j === 5) ? 100 : (j === 6) ? 0.3 :
            (j === 7) ? 0.3 : 8) :
        ((j === 0) ? 2 : (j === 1) ? 6000 : (j === 2) ? 1 : (j === 3) ? 20 : (j === 4) ? 80 : (j === 5) ? 0 : (j === 6) ? 0 :
            (j === 7) ? 0.2 : 1);
);

// Matrix : the room of a line beyond its delay (the delays all different ; Shimmer : the window of the pitch shifter)
function its_Mx_Room(fx)
(
    2 * its_MxMaxL + 4 + ((fx[its_Efx_Type] === its_Efx_TyShimmer) ? max(10, min(1000, fx[its_Efx_MxX + 7])) * srate / 1000 + 2 : 0);
);

// Matrix : the size of a line, a power of 2 above the longest delay (and the room to make the delays all different), at
// most its_MxMaxB, and its_MxMaxW for all the lines (the delays are then shorter)
function its_Mx_BufSize(fx)
local (d, b, n)
(
    d = (max(fx[its_Efx_Par1 + 4], fx[its_Efx_Par1 + 5]) + max(0, fx[its_Efx_MxX])) * srate / 1000 + its_Mx_Room(fx);
    b = 64; while ((b < d) && (b < its_MxMaxB)) (b *= 2);
    n = its_Mx_Lines(fx);
    while ((b > 64) && (b * n > its_MxMaxW)) (b /= 2);
    b;
);

// Matrix : the longest delay possible (s), see its_Mx_BufSize
function its_Mx_MaxDelay(fx) ( (its_Mx_BufSize(fx) - its_Mx_Room(fx)) / srate; );

// Matrix : the loop can grow (Grow, or a Householder diffusion out of [0, 1]) : it saturates (its_Mx_Sat)
function its_Mx_Grows(fx, df)
(
    (fx[its_Efx_Par1 + 7] === its_MxLpGrow) || ((fx[its_Efx_Par1 + 1] === its_MxHouse) && ((df < 0) || (df > 1)));
);

// Flanger, Chorus : the type "ty" is one of them (the same engine, see exec_flanger)
function its_Fl_Is(ty) ( (ty === its_Efx_TyFlanger) || (ty === its_Efx_TyChorus); );

// Flanger, Chorus : the default value "j" of the type "ty" (0 the delay, 1 the sweep, 2 the rate, 3 the feedback, 4 the
// voices, 5 the jitter)
function its_Fl_Def(ty, j)
(
    (ty === its_Efx_TyChorus) ? ((j === 0) ? 15 : (j === 1) ? 4 : (j === 2) ? 0.6 : (j === 3) ? 0 : (j === 4) ? 3 : 0.3) :
        ((j === 0) ? 2 : (j === 1) ? 1.8 : (j === 2) ? 0.2 : (j === 3) ? 0.7 : (j === 4) ? 1 : 0);
);

// Flanger, Chorus : the barber modes (the delays of the voices ramp, each one in a window)
function its_Fl_Barber(fx) ( (fx[its_Efx_Par1 + 1] === its_FlBarbUp) || (fx[its_Efx_Par1 + 1] === its_FlBarbDown); );

// Flanger, Chorus : the size of a line, a power of 2 above the longest delay (the delay with its jitter and some room, plus
// the sweep), at most its_FlMaxB, and its_FlMaxW for all the lines (the delays are then shorter)
function its_Fl_BufSize(fx)
local (d, b, n)
(
    d = (1.5 * max(0, fx[its_Efx_Par1]) + max(0, fx[its_Efx_MxX])) * srate / 1000 + 4;
    b = 64; while ((b < d) && (b < its_FlMaxB)) (b *= 2);
    n = max(1, min(128, floor(fx[its_Efx_CCnt])));
    while ((b > 64) && (b * n > its_FlMaxW)) (b /= 2);
    b;
);

// Flanger, Chorus : the longest delay possible (s), see its_Fl_BufSize
function its_Fl_MaxDelay(fx) ( (its_Fl_BufSize(fx) - 2) / srate; );

// Phaser : the barber modes (two chains, each one in a window)
function its_Ph_Barber(fx) ( (fx[its_Efx_Par1 + 1] === its_PhBarbUp) || (fx[its_Efx_Par1 + 1] === its_PhBarbDown); );

/*
    Phaser : the label "str" of its notches : their count, then "+ LP", "+ HP" or "+ BP" when the chain also cuts the highs,
    the lows or both ; a one pole stage turns the phase from 0 (low) to -180 degrees (Nyquist), a two pole stage (Resonant)
    from 0 to -360 : with mix >= 0 a notch at each odd multiple of 180, with mix < 0 at each multiple of 360 (0 : the lows) ;
    the phase at Nyquist (n x 180, or n x 360) tells if the highs pass or are cut
*/
function its_Ph_Label(str, fx) local(n, k, t)
(
    n = max(1, min(its_PhMaxS, floor(fx[its_Efx_Par1 + 9])));
    (fx[its_Efx_Par1 + 1] === its_PhReson) ? (
        (fx[its_Efx_Par1 + 3] >= 0) ? ( k = n; t = 0; ) : ( k = n - 1; t = 3; );
    ) : (
        (fx[its_Efx_Par1 + 3] >= 0) ? ( k = floor(n / 2); t = (n & 1) ? 1 : 0; ) : ( k = floor((n - 1) / 2); t = (n & 1) ? 2 : 3; );
    );
    (k === 0) ? strcpy(str, (t === 0) ? "No notch" : "") : (k === 1) ? strcpy(str, "1 notch") : sprintf(str, "%d notches", k);
    (t > 0) ? strcat(str, (k === 0) ? ((t === 1) ? "Low pass" : (t === 2) ? "High pass" : "Band pass") :
                                     ((t === 1) ? " + LP" : (t === 2) ? " + HP" : " + BP"));
    str;
);

// Noise : the colors that use the density (Velvet, Dust, Logistic), the chaos (Crackle, Logistic)
function its_Nz_Dens(cl) ( (cl === its_NzVelvet) || (cl === its_NzDust) || (cl === its_NzLogistic); );
function its_Nz_Chaos(cl) ( (cl === its_NzCrackle) || (cl === its_NzLogistic); );
function its_Nz_Shaped(cl) ( cl !== its_NzVelvet; ); // (the impulses of Velvet are +-1 : the shape does not change them)
function its_Nz_Color(fx) ( max(0, min(its_NzCnt - 1, floor(fx[its_Efx_Par1 + 1]))); );

// Noise : the modulation inputs meaningful in its color (a mask : level, density, correlation)
function its_Nz_ModOk(fx) ( its_Nz_Dens(its_Nz_Color(fx)) ? 7 : 5; );

/*
    Noise : the label "str" of its color : its spectrum (White ... Violet), the two colors of the mode Mix and the share of
    the second one, its kind (Velvet, Dust), the parameter of the chaotic maps (Crackle : p = 1 + chaos ; Logistic : r = 3
    + chaos, and its regime : the periods 2, 4, 8, 16 ... up to 3.5699 (P2 ... : the pitch is the density divided by the
    period), then chaos, but the period 3 from 1 + sqrt(8))
*/
function its_Nz_Label(str, fx) local(cl, r, n, t)
(
    cl = its_Nz_Color(fx);
    (cl === its_NzWhite) ? strcpy(str, "Flat") :
    (cl === its_NzPink) ? strcpy(str, "-3 dB/oct") :
    (cl === its_NzBrown) ? strcpy(str, "-6 dB/oct") :
    (cl === its_NzViolet) ? strcpy(str, "+6 dB/oct") :
    (cl === its_NzMix) ? (
        t = max(-6, min(6, fx[its_Efx_Par1 + 7]));
        (t < -3) ? sprintf(str, "Brown>Pink %d%%", floor(0.5 + 100 * (t + 6) / 3)) :
        (t < 0) ? sprintf(str, "Pink>White %d%%", floor(0.5 + 100 * (t + 3) / 3)) :
            sprintf(str, "White>Violet %d%%", floor(0.5 + 100 * t / 6));
    ) :
    (cl === its_NzVelvet) ? strcpy(str, "Impulses +-1") :
    (cl === its_NzDust) ? strcpy(str, "Random impulses") :
    (cl === its_NzCrackle) ? sprintf(str, "p %.3f", 1 + max(0, min(1, fx[its_Efx_Par1 + 6]))) : (
        r = 3 + max(0, min(1, fx[its_Efx_Par1 + 6]));
        n = (r < 3.44949) ? 2 : (r < 3.54409) ? 4 : (r < 3.56441) ? 8 : (r < 3.56995) ? 16 : ((r >= 3.82843) && (r < 3.8415)) ? 3 : 0;
        (n > 0) ? sprintf(str, "r %.3f P%d %.0f Hz", r, n, max(0.01, min(srate, fx[its_Efx_Par1 + 4])) / n) :
            sprintf(str, "r %.3f chaos", r);
    );
    str;
);

// Flanger, Chorus : the loop can grow (a feedback of 1 or more ; the barber modes with jitter : the windows of the voices no
// longer sum to 1) : it saturates (its_Mx_Sat)
function its_Fl_Grows(fx, fb)
(
    (abs(fb) >= 1) || (its_Fl_Barber(fx) && (fx[its_Efx_MxX + 4] > 0) && (fb !== 0));
);

// Filter : count of stages (biquads, or one pole filters)
function its_Flt_Stages(fx)
(
    2^max(0, min(its_FltSlopes - 1, floor(fx[its_Efx_Par1 + 3])));
);

// Filter : the modulation inputs meaningful (the cutoff ; the resonance : biquads, or 4 and 8 one pole stages)
function its_Flt_ModOk(fx)
(
    1 | (((fx[its_Efx_Par1 + 2] >= its_FltLP) || (its_Flt_Stages(fx) >= 4)) ? 2 : 0);
);

// size of the work area of the effect "fx" (0 : none)
function its_Fx_WorkSize(fx)
local (ns)
(
    (fx[its_Efx_Type] === its_Efx_TyFilter) ? (
        ns = its_Flt_Stages(fx);
        its_FxW_Hdr + 5 * ns + 2 * ns * max(1, min(128, floor(fx[its_Efx_CCnt])));
    ) :
    (fx[its_Efx_Type] === its_Efx_TySat) ? (
        its_FxW_Hdr + 5 * 4 + its_SatChW * max(1, min(128, floor(fx[its_Efx_CCnt])));
    ) :
    its_Mx_Is(fx[its_Efx_Type]) ? (
        ns = its_Mx_Lines(fx);
        its_FxW_Hdr + its_MxH + (its_MxLW + 2) * ns + ns * its_Mx_BufSize(fx);
    ) :
    its_Fl_Is(fx[its_Efx_Type]) ? (
        ns = max(1, min(128, floor(fx[its_Efx_CCnt])));
        its_FxW_Hdr + its_FlH + (its_FlCW + its_FlVW * its_FlMaxV) * ns + ns * its_Fl_BufSize(fx);
    ) :
    (fx[its_Efx_Type] === its_Efx_TyPhaser) ? (
        ns = max(1, min(128, floor(fx[its_Efx_CCnt])));
        its_FxW_Hdr + its_PhH + its_PhMaxS + (its_PhCW + 4 * its_PhMaxS) * ns;
    ) :
    (fx[its_Efx_Type] === its_Efx_TyNoise) ? (
        its_FxW_Hdr + its_NzH + its_NzCW * (max(1, min(128, floor(fx[its_Efx_CCnt]))) + 1);
    ) :
    (fx[its_Efx_Type] === its_Efx_TyRandom) ? (
        its_FxW_Hdr + its_RnH + its_RnCW * (max(1, min(128, floor(fx[its_Efx_CCnt]))) + 1);
    ) :
    (fx[its_Efx_Type] === its_Efx_TyMath) ? (
        its_FxW_Hdr + its_MtH + its_MtCW * max(1, min(128, floor(fx[its_Efx_CCnt])));
    ) :
    (fx[its_Efx_Type] === its_Efx_TyRing) ? (
        its_FxW_Hdr + its_RgH + its_RgCW * max(1, min(128, floor(fx[its_Efx_CCnt])));
    ) :
    // the VU meter, the Limiter : the area of their engine (GM-Meters) after the header
