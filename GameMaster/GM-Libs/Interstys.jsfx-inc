            ((bp = lcbl[its_Lin_BF1ST + f + s]) !== 0) ? (
                val = smpl_tab[ic + s];
                (md === its_WrtMode_Sum) ? (
                    val = 0.01 * x * k[bp] + vol * val;
                ) : (
                    (x !== 0) ? (
                        val = 0.01 * (x * k[bp] + (100 - min(100, abs(x))) * val); // x < 0 : the previous content inverted
                    );
                    val = vol * val;
                );
                (lg > 1) ? (val = its_Sat_Shape(val, its_SatSoft, 0, 0));
                !(abs(val) < its_FinMax) ? (val = 0; its_NaNCnt += 1;);
                k[bp] = val;
                // when at start/end of buffer, duplicate samples in guard area
                (k < writer[its_Wrt_Start] + BF_LIM) ? (
                    k[bp + writer[its_Wrt_SmplCnt]] = val;
                ) :
                (k > writer[its_Wrt_Last] - BF_LIM) ? (
                    k[bp - writer[its_Wrt_SmplCnt]] = val;
                );
            );
            s += 1;
        );
        /*
        Trace_X_its_Wrt_5_Loop = s;
        Trace_X_its_Wrt_4_smpl = val;
        Trace_X_its_Wrt_5_A1 = smpl_tab[writer[its_Wrt_InCell] + 0];
        Trace_X_its_Wrt_5_A2 = smpl_tab[writer[its_Wrt_InCell] + 1];
        Trace_X_its_Wrt_5_C1 = k[lcbl[its_Lin_BF1ST]];
        Trace_X_its_Wrt_5_C2 = k[lcbl[its_Lin_BF1ST + 1]];
        */
        // the next position : forward, backward, or both (the direction changes at the ends of the line)
        d = writer[its_Wrt_Dir];
        d = (d === its_WrtDir_Bwd) ? -1 : ((d === its_WrtDir_Both) && (writer[its_Wrt_Step] < 0)) ? -1 : 1;
        k += d;
        (k >= writer[its_Wrt_Last]) ? (
            (writer[its_Wrt_Dir] === its_WrtDir_Both) ? (
                k = max(writer[its_Wrt_Start], writer[its_Wrt_Last] - 2); d = -1;
            ) : (
                k = writer[its_Wrt_Start];
            );
        ) :
        (k < writer[its_Wrt_Start]) ? (
            (writer[its_Wrt_Dir] === its_WrtDir_Both) ? (
                k = min(writer[its_Wrt_Last] - 1, writer[its_Wrt_Start] + 1); d = 1;
            ) : (
                k = writer[its_Wrt_Last] - 1;
            );
        );
        writer[its_Wrt_Step] = d;
        writer[its_Wrt_Abspos] = k;
        ); // (X-fade, Sum)
        /*
        Trace_X_its_Wrt_1_First = writer[its_Wrt_Start];
        Trace_X_its_Wrt_2_Abspos = k;
        Trace_X_its_Wrt_3_Last = writer[its_Wrt_Last];
        */
    ) : (
        // An error occured
        ((writer > BASE_MEMORY) && (writer[-2] === KW_writ)) ? (
            ((writer[its_Wrt_Lcbl] > BASE_MEMORY) && (writer[its_Wrt_Src] != 0)) ? (
                writer[its_Wrt_Status] = its_WrtStat_Ready;
                its_Run_Check(writer);
            ) : (
                writer[its_Wrt_Status] = its_WrtStat_Created;
                its_Run_Check(writer);
            );
            dbg_show_4(writer, 730);
            writer[its_Wrt_Error] = max(0, its_WrtErrXe);
        );
    );

);

/*
    Matrix : the delays of the "np" lines (samples, below bs) from dmin to dmax (Par5, Par6, ms), in a low-discrepancy order
    (the golden ratio : the neighbouring lines differ) shifted by the seed (Par9), according to the spread (Par10) :
    geometric, linear, harmonic (the multiples of dmin up to dmax), random (geometric, a hash of the line and the seed) :
    odd and all different (a line already there : 2 samples more) ; equal : all dmin, exactly (one comb) ;
    for each line, the log of its gain for a decay of 1 s (-60 dB after T60 s : the gain exp(L / T60), see exec_matrix)
*/
function its_Mx_Delays(fx, ln, np, bs)
local (d0, d1, c, u, d, q, dup, sp, k)
(
    d0 = max(1, min(fx[its_Efx_Par1 + 4], fx[its_Efx_Par1 + 5]) * srate / 1000);
    d1 = min(bs - its_Mx_Room(fx), max(d0, max(fx[its_Efx_Par1 + 4], fx[its_Efx_Par1 + 5]) * srate / 1000));
    d0 = min(d0, d1);
    sp = fx[its_Efx_Par1 + 9];
    c = 0;
    loop(np,
        u = (c + 0.5) * 0.6180339887 + 0.1 * fx[its_Efx_Par1 + 8];
        (sp === its_MxSpRand) ? (u = sin(12.9898 * (c + 1) + 78.233 * (fx[its_Efx_Par1 + 8] + 1)) * 43758.5453);
        u -= floor(u);
        (sp === its_MxSpEqual) ? (
            d = floor(d0 + 0.5);
        ) : (
            (sp === its_MxSpLin) ? ( d = d0 + (d1 - d0) * u; ) :
            (sp === its_MxSpHarm) ? ( k = max(1, floor(d1 / d0)); d = d0 * min(k, 1 + floor(u * k)); ) :
            ( d = d0 * (d1 / d0) ^ u; );
            d = floor(d) | 1;
            dup = 1;
            while (dup) (
                dup = 0; q = ln; loop(c, (q[0] === d) ? (dup = 1); q += its_MxLW;);
                dup ? (d += 2);
            );
        );
        q = ln + c * its_MxLW;
        q[0] = max(1, min(bs - 1, d));
        q[1] = -3 * log(10) * q[0] / srate;
        (q[5] <= 0) ? (q[5] = q[0]); // (the current delay : glides toward q[0], see exec_matrix)
        c += 1;
    );
);

// Matrix : the saturation of the loop when it can grow (a rational tanh, as the Saturation, see its_Sat_Shape)
function its_Mx_Sat(u)
local (a)
(
    (u >= 4.97) ? 1 : (u <= -4.97) ? -1 :
    ( a = u * u; u * (135135 + a * (17325 + a * (378 + a))) / (135135 + a * (62370 + a * (3150 + 28 * a))); );
);

/*
    Matrix (a feedback delay network) : "np" delay lines (its_Mx_Lines), the line c fed by the channel c of the source (c below
    the channels ; Hadamard : the extra lines have no input and no output ; input Spread : the channel 0 into all the lines,
    with alternated signs) ; at each sample : the outputs of the lines (their delay, then a one-pole low pass : the damping,
    and a one-pole high pass), the matrix (Householder : I - d (2 / np) 1 1^T, d the diffusion ; Hadamard : the fast
    transform, / sqrt(np) ; Ring : rotations of the angle d pi / 4 between the lines (0, 1) (2, 3) ..., then (1, 2) (3, 4)
    ... and (np - 1, 0) : lossless whatever d, at d = 2 the energy hops to the next line), times the gain of each line
    (Decay : -60 dB after T60 ; Grow : +60 dB per T60 ; Freeze : 1, no input and no filter), plus the input : written in the
    lines, through a saturation (its_Mx_Sat) when the loop can grow (Grow, a Householder diffusion out of [0, 1] :
    its_Mx_Grows) ; the output c : (1 - mix) x + mix (the output of the line c) ; each delay glides toward its value (glide),
    and is modulated by a sine of its line (wow : the depth, rate, spread : the phase from a line to the next ; the read is
    interpolated)
    its work area : the header (its_FxW_Hdr ; its_FxW_Md : 1 when it is in use), then its_MxH words (0 dmin, 1 dmax, 2 the
    lines, 3 the seed, 12 the spread : those of the delays computed ; 4 the T60 of the gains, 7 the loop of the gains (-1 :
    to compute) ; 5 the low pass (Hz) and 6 its coefficient, 10 the high pass (Hz) and 11 its coefficient ; 8 the write
    position ; 9 the samples written since the start, up to bs : an older sample is read as silence, the lines are never
    cleared ; 13 the rate and 15 its increment, 14 the spread of the phases, 16 the glide and 17 its coefficient, 20 the
    diffusion of 18 19 the cosine and the sine of the Ring), its_MxLW words per line (0 its delay (samples), 1 the log of its
    gain for T60 = 1 s, 2 its gain, 3 4 the states of its low pass and high pass, 5 its current delay (gliding), 6 7 its sine
    (cosine, sine), 8 the phase of its pitch shifter (Shimmer)), the outputs of the lines (np), the vector of the matrix (np),
    then the lines (np x bs samples, bs a power of 2 : its_Mx_BufSize) ; Shimmer : each line read again by a pitch shifter,
    its share : the shimmer (MxX + 4)
*/
function exec_matrix(fx, ccnt, out)
local (wk, hd, ln, tp, vv, bf, np, bs, msk, src, g, mp, md, lm, t60, fz, fc, a, hb, df, mix, w, c, p, v, s, x, h, i, j,
       a0, b0, e, sc, ls, sp, x0, wd, ew, gk, rd, q, cs, sn, sm, gw, r1, r2, i1, i2, u1, u2, up, ph, pb, wc, da, db, sa, sb, y)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
        np = its_Mx_Lines(fx); bs = its_Mx_BufSize(fx); msk = bs - 1;
        hd = wk + its_FxW_Hdr; ln = hd + its_MxH; tp = ln + its_MxLW * np; vv = tp + np; bf = vv + np;
        src = smpl_tab + fx[its_Efx_Cell1]; g = fx[its_Efx_Vol1];
        mp = fx + its_Efx_Mod1;
        md = fx[its_Efx_Par1 + 1];
        lm = fx[its_Efx_Par1 + 7];
        // a new area, after a bypass, after a value not finite : silence (the old samples of the lines are not read, hd[9])
        (wk[its_FxW_Md] !== 1) ? (
            memset(hd, 0, its_MxH + (its_MxLW + 2) * np);
            hd[0] = hd[7] = hd[14] = hd[16] = -1; hd[20] = -1000; // (the delays, the gains, the phases, the glide, the Ring to compute)
            wk[its_FxW_Md] = 1;
        );
        // the delays, when dmin, dmax, the lines, the seed or the spread change
        ((hd[0] !== fx[its_Efx_Par1 + 4]) || (hd[1] !== fx[its_Efx_Par1 + 5]) || (hd[2] !== np) || (hd[3] !== fx[its_Efx_Par1 + 8])
            || (hd[12] !== fx[its_Efx_Par1 + 9])) ? (
            its_Mx_Delays(fx, ln, np, bs);
            hd[0] = fx[its_Efx_Par1 + 4]; hd[1] = fx[its_Efx_Par1 + 5]; hd[2] = np; hd[3] = fx[its_Efx_Par1 + 8];
            hd[12] = fx[its_Efx_Par1 + 9];
            hd[7] = -1;
        );
        // the gains : the decay or the growth (T60 modulated, octaves), computed again when T60 moves by more than 0.5 % ;
        // Freeze : 1
        fz = (lm === its_MxLpFreeze);
        fz ? (
            (hd[7] !== lm) ? ( p = ln; loop(np, p[2] = 1; p += its_MxLW;); hd[7] = lm; );
        ) : (
            t60 = max(0.01, min(10000, its_Mod_Apply(mp, fx[its_Efx_Par1], its_ModA_Oct, 1)));
            ((hd[7] !== lm) || (abs(t60 - hd[4]) > 0.005 * hd[4])) ? (
                p = ln; loop(np, p[2] = exp(((lm === its_MxLpGrow) ? -p[1] : p[1]) / t60); p += its_MxLW;);
                hd[4] = t60; hd[7] = lm;
            );
        );
        // the filters of the loop (low pass : the damping, modulated in octaves ; high pass) : off at 0 Hz, from 0.45 srate,
        // and in freeze
        fc = fz ? 0 : its_Mod_Apply(mp + its_ModDist, fx[its_Efx_Par1 + 2], its_ModA_Oct, 1);
        (fc !== hd[5]) ? ( hd[5] = fc; hd[6] = ((fc <= 0) || (fc >= 0.45 * srate)) ? 0 : exp(-2 * $pi * fc / srate); );
        a = hd[6];
        fc = fz ? 0 : fx[its_Efx_Par1 + 10];
        (fc !== hd[10]) ? ( hd[10] = fc; hd[11] = ((fc <= 1) || (fc >= 0.45 * srate)) ? 0 : exp(-2 * $pi * fc / srate); );
        hb = hd[11];
        df = max(-2, min(2, its_Mod_Apply(mp + 2 * its_ModDist, fx[its_Efx_Par1 + 6], its_ModA_Add, 1))); // diffusion
        ls = its_Mx_Grows(fx, df); // the loop saturates
        mix = max(0, min(1, fx[its_Efx_Par1 + 3]));
        sp = (fx[its_Efx_Par1 + 11] === its_MxInSpread); x0 = g * src[0];
        w = hd[8];
        // the wow : a sine per line (the magic circle x -= e y, y += e x), its phases spread ; the glide of the delays
        wd = max(0, fx[its_Efx_MxX]) * srate / 1000;
        (fx[its_Efx_MxX + 2] !== hd[14]) ? (
            hd[14] = fx[its_Efx_MxX + 2];
            p = ln; c = 0; loop(np, x = 2 * $pi * c * hd[14]; p[6] = cos(x); p[7] = sin(x); p += its_MxLW; c += 1;);
        );
        (fx[its_Efx_MxX + 1] !== hd[13]) ? ( hd[13] = fx[its_Efx_MxX + 1]; hd[15] = 2 * $pi * hd[13] / srate; );
        ew = hd[15];
        (fx[its_Efx_MxX + 3] !== hd[16]) ? (
            hd[16] = fx[its_Efx_MxX + 3]; hd[17] = (hd[16] <= 0) ? 1 : 1 - exp(-1 / (hd[16] * srate));
        );
        gk = hd[17];
        // Shimmer : a pitch shifter in each line (two taps half a window apart, their delays ramp over the grain, each one in
        // a window 0.5 - 0.5 cos of its phase) ; the even lines shifted by "shift", the odd ones by "shift2" (semitones)
        sm = (fx[its_Efx_Type] === its_Efx_TyShimmer) ? max(0, min(1, fx[its_Efx_MxX + 4])) : 0;
        (sm > 0) ? (
            gw = max(10, min(1000, fx[its_Efx_MxX + 7])) * srate / 1000; // the grain (samples)
            r1 = 2 ^ (max(-36, min(36, fx[its_Efx_MxX + 5])) / 12); r2 = 2 ^ (max(-36, min(36, fx[its_Efx_MxX + 6])) / 12);
            i1 = abs(r1 - 1) / gw; i2 = abs(r2 - 1) / gw; // the increments of the phases
            u1 = (r1 > 1); u2 = (r2 > 1); // up : the delay of the taps goes down
        );
        // the outputs of the lines (interpolated), filtered : kept (tp), and the vector of the matrix (vv)
        e = 0; p = ln; c = 0;
        loop(np,
            p[5] += gk * (p[0] - p[5]); // the glide toward the delay of the line
            rd = p[5];
            (wd > 0) ? ( p[6] -= ew * p[7]; p[7] += ew * p[6]; rd += wd * p[7]; );
            rd = max(1, min(bs - 2, rd));
            (rd <= hd[9]) ? (
                x = w - rd; i = floor(x); x -= i; q = bf + c * bs;
                v = q[i & msk]; v += x * (q[(i + 1) & msk] - v);
            ) : (v = 0);
            (sm > 0) ? (
                // the shifted signal (p[8] : the phase of the shifter of the line)
                ph = p[8] + ((c & 1) ? i2 : i1); ph -= floor(ph); p[8] = ph;
                pb = ph + 0.5; pb -= floor(pb);
                up = (c & 1) ? u2 : u1;
                da = min(bs - 2, rd + gw * (up ? 1 - ph : ph));
                db = min(bs - 2, rd + gw * (up ? 1 - pb : pb));
                q = bf + c * bs;
                (da < hd[9]) ? ( x = w - da; i = floor(x); x -= i; y = q[i & msk]; sa = y + x * (q[(i + 1) & msk] - y); ) : (sa = 0);
                (db < hd[9]) ? ( x = w - db; i = floor(x); x -= i; y = q[i & msk]; sb = y + x * (q[(i + 1) & msk] - y); ) : (sb = 0);
                wc = cos(2 * $pi * ph);
                v += sm * ((0.5 - 0.5 * wc) * sa + (0.5 + 0.5 * wc) * sb - v);
            );
            (a > 0) ? ( v = p[3] = v + a * (p[3] - v); ); // low pass
            (hb > 0) ? ( p[4] = v + hb * (p[4] - v); v -= p[4]; ); // high pass : v minus its low pass
            tp[c] = vv[c] = v; e += abs(v);
            p += its_MxLW; c += 1;
        );
        (e < its_FinMax) ? (
            // the matrix
            (md === its_MxHadam) ? (
                h = 1;
                while (h < np) (
                    i = 0;
                    loop(np / (2 * h),
                        j = i; loop(h, a0 = vv[j]; b0 = vv[j + h]; vv[j] = a0 + b0; vv[j + h] = a0 - b0; j += 1;);
                        i += 2 * h;
                    );
                    h *= 2;
                );
                sc = 1 / sqrt(np);
            ) :
            (md === its_MxRing) ? (
                (df !== hd[20]) ? ( hd[20] = df; hd[18] = cos(0.25 * $pi * df); hd[19] = sin(0.25 * $pi * df); );
                cs = hd[18]; sn = hd[19];
                j = 0; loop(floor(np / 2), a0 = vv[j]; b0 = vv[j + 1]; vv[j] = cs * a0 - sn * b0; vv[j + 1] = sn * a0 + cs * b0; j += 2;);
                j = 1; loop(floor((np - 1) / 2), a0 = vv[j]; b0 = vv[j + 1]; vv[j] = cs * a0 - sn * b0; vv[j + 1] = sn * a0 + cs * b0; j += 2;);
                (np > 2) ? ( a0 = vv[np - 1]; b0 = vv[0]; vv[np - 1] = cs * a0 - sn * b0; vv[0] = sn * a0 + cs * b0; );
                sc = 1;
            ) : (
                s = 0; c = 0; loop(np, s += vv[c]; c += 1;);
                s *= 2 * df / np;
                c = 0; loop(np, vv[c] -= s; c += 1;);
                sc = 1;
            );
            // the lines written (the gain, the input, the saturation), the outputs
            p = ln; c = 0;
            loop(np,
                x = (c < ccnt) ? g * src[c] : 0;
                v = p[2] * sc * vv[c] + (fz ? 0 : sp ? ((c & 1) ? -x0 : x0) : x);
                bf[c * bs + w] = ls ? its_Mx_Sat(v) : v;
                (c < ccnt) ? (out[c] += (1 - mix) * x + mix * tp[c]);
                p += its_MxLW; c += 1;
            );
            hd[8] = (w + 1) & msk;
            (hd[9] < bs) ? (hd[9] += 1);
        ) : (
            wk[its_FxW_Md] = -1; // (silence from the next sample)
            its_NaNCnt += 1;
        );
    );
);

// the table of a curve "ct" (its first sample : its_CrvTab + k * its_CrvTbSz + its_CrvTbG) at x in [0, 1[ : cubic
// interpolation between p[0] and p[1] (Catmull-Rom : a vertical jump of the curve overshoots a little) ; LFO, Flanger
function its_Crv_Cyc(ct, x)
local (u, k, p)
(
    u = x * its_CrvTbN; k = floor(u); u -= k; p = ct + k;
    p[0] + 0.5 * u * (p[1] - p[-1] + u * (2 * p[-1] - 5 * p[0] + 4 * p[1] - p[2] + u * (3 * (p[0] - p[1]) + p[2] - p[-1])));
);

/*
    Flanger, Chorus (the same engine ; the Chorus : other default values, see its_Fl_Def) : a line per channel of its source,
    read by "nv" voices (Par10 ; the barber modes : 2 at least) ; the delay of a voice : the delay (Par1, modulated in
    octaves ; jitter : x [1 - j/2, 1 + j/2] per voice) plus the sweep (MxX) times the shape (Par8) of its phase ; the phases
    turn at the rate (MxX + 1, modulated in octaves ; jitter : x [1 - j, 1 + j] per voice), shifted by the spread (Par5,
    turns) from a channel to the next and by 1 / nv from a voice to the next ; the wet signal of a channel : the mean of its
    voices (barber modes : the delay of each voice ramps down (up) or up (down) in a window 0.5 - 0.5 cos of its phase, the
    windows summing to 1 : an endless sweep, and with long delays a pitch shifter) ; the line is written with the input plus
    the feedback (Par7, modulated) of the wet signal (cross, Par12 : the share of the next channel, < 0 : of the previous
    one), filtered (low pass : the damping Par3 ; high pass Par11), through a saturation (its_Mx_Sat) when the loop can grow
    (its_Fl_Grows) ; the output : (1 - |mix|) x + mix (the wet signal), mix (Par4) in [-1, 1] ; Through-zero : x is the line
    read at the delay, without the sweep (the sweep crosses it) ; the delay and the sweep glide (MxX + 3) ; the reads are
    interpolated (linear)
    its work area : the header (its_FxW_Hdr ; its_FxW_Md : 1 when it is in use), then its_FlH words (0 the write position,
    1 the samples written since the start, up to bs : an older sample is read as silence, the lines are never cleared ; 2
    the delay and 3 the sweep (samples, gliding ; -1 : to set), 4 the glide and 5 its coefficient, 6 the damping (Hz) and 7
    its coefficient, 8 the high pass and 9 its coefficient, 10 the seed and 11 the jitter of the factors computed, 12 the
    voices of the phases), its_FlCW words per channel (0 its wet signal, 1 2 the states of its low pass and high pass),
    its_FlVW words per voice (its_FlMaxV per channel : 0 its phase, 1 the factor of its rate, 2 the factor of its delay, 3 4
    its random values (Random : from 3 to 4 ; Hold : 4), 5 the value held (gliding), 6 its last phase with the offsets),
    then the lines (ccnt x bs samples, bs a power of 2 : its_Fl_BufSize)
*/
function exec_flanger(fx, ccnt, out)
local (wk, hd, cw, vw, bf, bs, msk, src, g, mp, md, sh, nv, bm, dl, sw, rt, fb, mix, spr, cr, jt, gk, a, hb, fc, wn, w, c,
       k, p, q, ln, v, x, y, u, i, e, ph, pe, ws, rd, ls, ct, dry)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
        bs = its_Fl_BufSize(fx); msk = bs - 1;
        hd = wk + its_FxW_Hdr; cw = hd + its_FlH; vw = cw + its_FlCW * ccnt; bf = vw + its_FlVW * its_FlMaxV * ccnt;
        src = smpl_tab + fx[its_Efx_Cell1]; g = fx[its_Efx_Vol1];
        mp = fx + its_Efx_Mod1;
        md = fx[its_Efx_Par1 + 1]; sh = fx[its_Efx_Par1 + 7];
        bm = (md === its_FlBarbUp) || (md === its_FlBarbDown);
        nv = max(bm ? 2 : 1, min(its_FlMaxV, floor(fx[its_Efx_Par1 + 9])));
        // a new area, after a bypass, after a value not finite : silence (the old samples of the lines are not read, hd[1])
        (wk[its_FxW_Md] !== 1) ? (
            memset(hd, 0, its_FlH + (its_FlCW + its_FlVW * its_FlMaxV) * ccnt);
            hd[2] = hd[4] = hd[6] = hd[8] = hd[10] = -1; // (the delay, the glide, the filters, the factors to compute)
            p = vw; loop(its_FlMaxV * ccnt, p[3] = rand(2) - 1; p[4] = p[5] = rand(2) - 1; p += its_FlVW;);
            wk[its_FxW_Md] = 1;
        );
        // the factors of the voices, from the seed (jitter : the rates x [1 - j, 1 + j], the delays x [1 - j/2, 1 + j/2])
        jt = max(0, min(1, fx[its_Efx_MxX + 4]));
        ((hd[10] !== fx[its_Efx_Par1 + 8]) || (hd[11] !== jt)) ? (
            hd[10] = fx[its_Efx_Par1 + 8]; hd[11] = jt;
            p = vw; k = 0;
            loop(its_FlMaxV * ccnt,
                u = sin(12.9898 * (k + 1) + 78.233 * (hd[10] + 1)) * 43758.5453; u -= floor(u);
