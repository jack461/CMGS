                ((ty === its_Efx_TyNoise) && (ki >= 22) && (ki < its_TbFMod)) ? ((ki - 22 < its_TbNzOrdN) ? its_TbNzOrd[ki - 22] : 23) :
                ((ty === its_Efx_TyRandom) && (ki >= 22) && (ki < its_TbFMod)) ? ((ki - 22 < its_TbRnOrdN) ? its_TbRnOrd[ki - 22] : 23) :
                ((ty === its_Efx_TyMath) && (ki >= 22) && (ki < its_TbFMod)) ? ((ki - 22 < its_TbMtOrdN) ? its_TbMtOrd[ki - 22] : 23) :
                ((ty === its_Efx_TyRing) && (ki >= 22) && (ki < its_TbFMod)) ? ((ki - 22 < its_TbRgOrdN) ? its_TbRgOrd[ki - 22] : 23) :
                ((ty === its_Efx_TyLimiter) && (ki >= 22) && (ki < its_TbFMod)) ? ((ki - 22 < its_TbLmOrdN) ? its_TbLmOrd[ki - 22] : 23) :
                ((ty === its_Efx_TyVU) && (ki >= 22) && (ki < its_TbFMod)) ? ((ki - 22 < its_TbVuOrdN) ? its_TbVuOrd[ki - 22] : 23) : ki;
            its_Tb_FxShown(fx, ty, p) ? (
                its_Tb_FxGet(p, fx);
                ((p < its_TbFMod) || (its_Tb_g1 !== 0)) ? (
                    strcat(#its_TbW, its_Xp_Sep());
                    strcat(#its_TbW, its_Tb_FxKName(ty, p));
                    (p === 37) ? (
                        j = 0; loop(its_Tb_g1, strcat(#its_TbW, sprintf(#its_TbV1, " %.10g", fx[its_Efx_Harm1 + j])); j += 1;);
                    ) : (
                        strcat(#its_TbW, " ");
                        strcat(#its_TbW, its_Tb_FxText(#its_TbV1, p, ty, its_Tb_g1, its_Tb_g2, its_Tb_g3, its_Tb_g4, its_Tb_g5));
                    );
                );
            );
            ki += 1;
        );
    );
    its_Tb_Out(#its_TbW);
);

// pass 2 : the keys of the effect "k" checked on the simulation
function its_Tb_SimFx(k) local(ty, j)
(
    ty = its_Tb_FxPrep(k);
    (its_Tb_error === 0) ? (
        (its_TbKS[1] && (its_TbK1[1] === 3)) ? (
            sprintf(#its_TbW, "Effect %d : status Undefined (Free Effect deletes an effect)", k + 1);
            its_Tb_Err(2754, #its_TbW);
        );
        j = 0; loop(8,
            (its_TbKS[6 + j] && (its_TbK1[6 + j] === ITS_KFx * ITS_KMul + k)) ? (
                sprintf(#its_TbW, "Effect %d : its own output is its source %d", k + 1, j + 1);
                its_Tb_Err(2768, #its_TbW);
            );
            j += 1;
        );
    );
    its_TbSimFE[k] = 1; its_TbSimFT[k] = ty;
    (its_Tb_own > 0) ? (its_TbSimFO[k] = its_Tb_own);
);

// pass 3 : the effect "k" is created if needed, then set (the type first : it gives default values ; the status last)
function its_Tb_SetFx(k) local(fx, ty, j, p, ki)
(
    ((fx = its_Tb_Blk(its_TK_Effect, k)) === 0) ? (fx = FX_make(k));
    (fx <= BASE_MEMORY) ? (
        Effects_set[k] = 0;
        sprintf(#its_TbW, "Effect %d : not enough memory", k + 1);
        its_Tb_Err(2766, #its_TbW);
    ) : (
        ty = its_Tb_FxPrep(k); // (checked by pass 2)
        (its_TbKS[0] && (fx[its_Efx_Type] !== ty)) ? FX_Set_Type(fx, ty);
        its_TbKS[2] ? ( fx[its_Efx_Phase] = its_TbK1[2]; );
        its_TbKS[3] ? ( fx[its_Efx_CCnt] = its_TbK1[3]; );
        its_TbKS[4] ? ( fx[its_Efx_OutK] = its_TbK1[4]; fx[its_Efx_OutOff] = its_TbK2[4]; );
        its_TbKS[5] ? ( fx[its_Efx_Lim] = its_TbK1[5]; fx[its_Efx_LimEnv] = 0; );
        j = 0; p = fx + its_Efx_Src1; loop(8,
            its_TbKS[6 + j] ? ( p[0] = its_TbK1[6 + j]; p[its_Efx_Off1 - its_Efx_Src1] = its_TbK2[6 + j]; );
            its_TbKS[14 + j] ? ( p[its_Efx_VoldB1 - its_Efx_Src1] = its_TbK1[14 + j]; );
            j += 1; p += its_EfxDist;
        );
        (ty === its_Efx_TyAutoMix) ? FX_Auto_Gains(fx);
        its_TbKS[22] ? ( fx[its_Efx_Par1] = its_TbK1[22]; );
        its_TbKS[23] ? ( fx[its_Efx_Par1 + 1] = its_TbK1[23]; );
        its_TbKS[24] ? ( fx[its_Efx_Par1 + ((ty === its_Efx_TyFilter) ? 2 : 1)] = its_TbK1[24]; );
        its_TbKS[25] ? ( fx[its_Efx_Par1 + 3] = floor(log(its_TbK1[25]) / log(2) + 0.5); ); // 1, 2, 4, 8, 16, 32 stages : 0 ... 5
        ki = 26; loop(3, its_TbKS[ki] ? ( fx[its_Efx_Par1 + ki - 24] = its_TbK1[ki]; ); ki += 1;);
        its_TbKS[29] ? ( fx[its_Efx_Par1] = its_TbK1[29]; );
        its_TbKS[30] ? ( fx[its_Efx_Par1 + 2] = its_TbK1[30]; );
        its_TbKS[31] ? ( fx[its_Efx_Par1 + 3] = its_TbK1[31] / 100; );
        its_TbKS[32] ? ( fx[its_Efx_Par1 + 4] = floor(log(its_TbK1[32]) / log(2) + 0.5); ); // 1, 2, 4, 8 times : 0 ... 3
        ki = 33; loop(4, its_TbKS[ki] ? ( fx[its_Efx_Par1 + ki - 28] = its_TbK1[ki]; ); ki += 1;);
        its_TbKS[37] ? ( j = 0; loop(its_SatHarm, fx[its_Efx_Harm1 + j] = (j < its_TbK1[37]) ? its_TbHarm[j] : 0; j += 1;); );
        its_TbKS[38] ? ( fx[its_Efx_Par1 + ((ty === its_Efx_TySat) ? 9 : 5)] = its_TbK1[38]; );
        its_TbKS[39] ? ( fx[its_Efx_Par1 + 10] = its_TbK1[39]; );
        its_TbKS[40] ? ( fx[its_Efx_Par1] = its_TbK1[40]; ); // Matrix : decay
        its_TbKS[41] ? ( fx[its_Efx_Par1 + 2] = its_TbK1[41]; ); // damp
        ki = 42; loop(8, its_TbKS[ki] ? ( fx[its_Efx_Par1 + ki - 38] = its_TbK1[ki]; ); ki += 1;); // dmin ... inject
        ki = 50; loop(4, its_TbKS[ki] ? ( fx[its_Efx_MxX + ki - 50] = its_TbK1[ki]; ); ki += 1;); // wow ... glide
        its_TbKS[54] ? ( fx[its_Efx_Par1] = its_TbK1[54]; ); // Flanger, Chorus : delay
        its_TbKS[55] ? ( fx[its_Efx_MxX] = its_TbK1[55]; ); // sweep
        its_TbKS[56] ? ( fx[its_Efx_Par1 + 6] = its_TbK1[56]; ); // feedback
        its_TbKS[57] ? ( fx[its_Efx_Par1 + 7] = its_TbK1[57]; ); // wave
        its_TbKS[58] ? ( fx[its_Efx_Par1 + 9] = its_TbK1[58]; ); // voices
        its_TbKS[59] ? ( fx[its_Efx_Par1 + 11] = its_TbK1[59]; ); // cross
        its_TbKS[60] ? ( fx[its_Efx_MxX + 4] = its_TbK1[60]; ); // jitter
        its_TbKS[61] ? ( fx[its_Efx_Par1 + 3] = its_TbK1[61] / 100; ); // mix
        its_TbKS[62] ? ( fx[its_Efx_Par1 + 2] = its_TbK1[62]; ); // Phaser : sweep
        its_TbKS[63] ? ( fx[its_Efx_Par1 + 9] = its_TbK1[63]; ); // stages
        its_TbKS[64] ? ( fx[its_Efx_Par1 + 10] = its_TbK1[64]; ); // q
        its_TbKS[65] ? ( fx[its_Efx_MxX] = its_TbK1[65]; ); // spacing
        its_TbKS[66] ? ( fx[its_Efx_MxX + 4] = its_TbK1[66] / 100; ); // Shimmer : shimmer
        ki = 67; loop(4, its_TbKS[ki] ? ( fx[its_Efx_MxX + ki - 62] = its_TbK1[ki]; ); ki += 1;); // shift, shift2, grain, lines
        its_TbKS[71] ? ( fx[its_Efx_Par1 + 1] = its_TbK1[71]; ); // Noise : color
        its_TbKS[72] ? ( fx[its_Efx_Par1 + 4] = its_TbK1[72]; ); // density
        its_TbKS[73] ? ( fx[its_Efx_Par1 + ((ty === its_Efx_TyRandom) ? 4 : 3)] = its_TbK1[73]; ); // corr (Random : Par5)
        its_TbKS[74] ? ( fx[its_Efx_Par1 + 6] = its_TbK1[74]; ); // chaos
        its_TbKS[75] ? ( fx[its_Efx_Par1 + 7] = its_TbK1[75]; ); // tilt
        its_TbKS[76] ? ( fx[its_Efx_Par1 + 8] = its_TbK1[76]; ); // power
        its_TbKS[77] ? ( fx[its_Efx_Par1] = its_TbK1[77] / 100; ); // rumble
        its_TbKS[78] ? ( fx[its_Efx_Par1 + 9] = its_TbK1[78]; ); // rfreq
        ki = 79; loop(6, its_TbKS[ki] ? ( fx[its_Efx_Par1 + ki - 73] = its_TbK1[ki]; ); ki += 1;); // Random : dist, clock, steps, walk, thresh, detect
        its_TbKS[85] ? ( fx[((ty === its_Efx_TyMath) || (ty === its_Efx_TyLimiter)) ? its_Efx_Par1 + 7 : its_Efx_MxX + 5] = its_TbK1[85]; ); // release (Math, Limiter : Par8)
        its_TbKS[86] ? ( fx[its_Efx_Par1 + 4] = its_TbK1[86]; ); // Math : value
        its_TbKS[87] ? ( fx[its_Fx_BcIdx(fx)] = its_TbK1[87]; ); // bchan (Math, Ring)
        its_TbKS[88] ? ( fx[its_Efx_Par1 + 6] = its_TbK1[88]; ); // attack
        its_TbKS[89] ? ( fx[its_Efx_Par1 + 6] = its_TbK1[89]; ); // Ring : detune
        ki = 90; loop(5, its_TbKS[ki] ? ( fx[its_Efx_Par1 + ki - 90] = its_TbK1[ki]; ); ki += 1;); // Limiter : limit, shown, zoom, distortion, pregain
        (ty === its_Efx_TyLimiter) ? (
            // output, attack, release : the ranges of the plugin (a Check tells the values changed)
            fx[its_Efx_Par1 + 5] = max(-12, min(24, fx[its_Efx_Par1 + 5]));
            fx[its_Efx_Par1 + 6] = max(0.1, min(lm_MaxAtt, fx[its_Efx_Par1 + 6]));
            fx[its_Efx_Par1 + 7] = max(1, min(1000, fx[its_Efx_Par1 + 7]));
        );
        its_TbKS[95] ? ( fx[its_Efx_Par1] = its_TbK1[95]; ); // VU meter : time
        its_TbKS[96] ? ( fx[its_Efx_Par1 + 2] = its_TbK1[96]; ); // highlight
        its_TbKS[97] ? ( fx[its_Efx_Par1 + 3] = max(0, its_Tb_VuThrIdx(its_TbK1[97])); ); // thresh (dB : its index)
        its_TbKS[98] ? ( fx[its_Efx_Par1 + 4] = its_TbK1[98]; ); // color
        its_TbKS[99] ? ( fx[its_Efx_Par1 + 5] = max(0, its_Tb_VuHoldIdx(its_TbK1[99])); ); // autoclear (minutes : its index)
        // the modulations : a new connection gets the attenuverter 1 and the default depth (as in the pad)
        ki = its_TbFMod; loop(its_TbFMINb,
            its_TbKS[ki] ? its_Tb_ModSet(fx + its_Efx_Mod1 + its_TbFMIj[ki - its_TbFMod] * its_ModDist, ki, its_TbFMId[ki - its_TbFMod]);
            ki += 1;
        );
        its_TbKS[1] ? ( fx[its_Efx_Status] = its_TbK1[1]; );
        its_Run_Check(fx);
        (its_Tb_own > 0) ? (fx[its_Efx_Owner] = its_Tb_own);
        fx[its_Efx_Check] = 0; // checked again by exec_fx
    );
);

function its_Tb_CheckFx(k) local(fx, ty, fty, ki, bad, same, j, v)
(
    its_Tb_fxk = k;
    its_Tb_Keys(its_TK_Effect);
    ((its_Tb_error === 0) && (its_Tb_mode === 3) && (k >= 0)) ? (
        fx = its_Tb_Blk(its_TK_Effect, k);
        ty = its_Tb_FxPrep(k);
        fty = (fx !== 0) ? fx[its_Efx_Type] : 0;
        bad = 0;
        ki = 0; loop(its_TbFNk,
            ((its_Tb_error === 0) && its_TbKS[ki] && (ki === 37)) ? (
                // harm : the weights given, the others null
                j = 0; loop(its_SatHarm,
                    v = (j < its_TbK1[37]) ? its_TbHarm[j] : 0;
                    ((fx === 0) || (abs(fx[its_Efx_Harm1 + j] - v) >= 0.0000001)) ? (
                        sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Effect %d : harm H%d %.10g (expected %.10g)", k + 1, j + 1,
                            (fx !== 0) ? fx[its_Efx_Harm1 + j] : 0, v);
                        mSL_log(SysLogBox, #its_TbMsg);
                        (its_Tb_res === 0) ? (its_Tb_res = 2759);
                        bad = 1;
                    );
                    j += 1;
                );
            ) :
            ((its_Tb_error === 0) && its_TbKS[ki]) ? (
                its_Tb_FxGet(ki, fx);
                same = (abs(its_Tb_g1 - its_TbK1[ki]) < 0.0000001) && (its_Tb_g2 === its_TbK2[ki])
                    && ((its_TbK3[ki] === Undef) || (abs(its_Tb_g3 - its_TbK3[ki]) < 0.0000001))
                    && ((its_TbK4[ki] === Undef) || (abs(its_Tb_g4 - its_TbK4[ki]) < 0.0000001))
                    && ((its_Tb_g5 & its_TbK6[ki]) === its_TbK5[ki]);
                (!same) ? (
                    sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Effect %d : %s %s (expected %s)", k + 1, its_TbFNam[ki],
                        its_Tb_FxText(#its_TbV1, ki, fty, its_Tb_g1, its_Tb_g2, its_Tb_g3, its_Tb_g4, its_Tb_g5),
                        its_Tb_FxText(#its_TbV2, ki, ty, its_TbK1[ki], its_TbK2[ki], its_TbK3[ki], its_TbK4[ki], its_TbK5[ki]));
                    mSL_log(SysLogBox, #its_TbMsg);
                    (its_Tb_res === 0) ? (its_Tb_res = 2759);
                    bad = 1;
                );
            );
            ki += 1;
        );
        ((bad === 0) && (its_Tb_error === 0)) ? (
            sprintf(#its_TbW, "Check Effect %d OK", k + 1);
            mSL_log(SysLogBox, #its_TbW);
        );
    );
);

function its_Tb_Module(ty) local(k)
(
    k = its_Tb_Id(ty, its_Tb_Next(), 1);
    its_Tb_own = its_Tb_idLocal ? its_Tb_scope : 0; // a module of an instance (its_Tb_SimMod ... its_Tb_SetFx)
    its_Tb_fxk = k;
    its_Tb_Keys(ty);
    ((its_Tb_error === 0) && (k >= 0)) ? (
        (its_Tb_mode === 0) ? ( its_TbResv[its_Tb_RBase(ty) + k] = 1; ) :
        (its_Tb_mode === 2) ? ( (ty === its_TK_Effect) ? its_Tb_SimFx(k) : its_Tb_SimMod(ty, k); ) :
        (its_Tb_mode === 3) ? ( (ty === its_TK_Effect) ? its_Tb_SetFx(k) : its_Tb_SetMod(ty, k); );
    );
);

function its_Tb_CheckMod(ty, k) local(b, ki, ok, nk, same)
(
    its_Tb_Keys(ty);
    ((its_Tb_error === 0) && (its_Tb_mode === 3) && (k >= 0)) ? (
        b = its_Tb_Blk(ty, k);
        ok = 1;
        nk = (ty === its_TK_Writer) ? its_TbWNk : its_TbRNk;
        ki = 0; loop(nk,
            its_TbKS[ki] ? (
                its_Tb_Get(ty, ki, b);
                // (mod : also the depth and the attenuverter if given, the flags of the law given ; see its_Tb_Keys)
                same = ((ty === its_TK_Reader) && (ki === 2)) ? (abs(its_Tb_g1 - its_TbK1[ki]) < 0.6 / srate) :
                    (abs(its_Tb_g1 - its_TbK1[ki]) < 0.0000001) && (its_Tb_g2 === its_TbK2[ki])
                    && ((its_TbK3[ki] === Undef) || (abs(its_Tb_g3 - its_TbK3[ki]) < 0.0000001))
                    && ((its_TbK4[ki] === Undef) || (abs(its_Tb_g4 - its_TbK4[ki]) < 0.0000001))
                    && ((its_Tb_g5 & its_TbK6[ki]) === its_TbK5[ki]);
                (!same) ? (
                    sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check %s %d : %s %s (expected %s)",
                        its_Tb_TyName(ty), k + 1, (ty === its_TK_Writer) ? its_TbWNam[ki] : its_TbRNam[ki],
                        its_Tb_ValText(#its_TbV1, ty, ki, its_Tb_g1, its_Tb_g2, its_Tb_g3, its_Tb_g4, its_Tb_g5),
                        its_Tb_ValText(#its_TbV2, ty, ki, its_TbK1[ki], its_TbK2[ki], its_TbK3[ki], its_TbK4[ki], its_TbK5[ki]));
                    mSL_log(SysLogBox, #its_TbMsg);
                    (its_Tb_res === 0) ? (its_Tb_res = 2759);
                    ok = 0;
                );
            );
            ki += 1;
        );
        ok ? (
            sprintf(#its_TbW, "Check %s %d OK", its_Tb_TyName(ty), k + 1);
            mSL_log(SysLogBox, #its_TbW);
        );
    );
);

//—— Global

// the keys of the block Global, until the next header : its_TbKS, its_TbK1
function its_Tb_GKeys() local(w, ki, i)
(
    memset(its_TbKS, 0, its_TbKSz);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        ki = -1; i = 0; while ((ki < 0) && (i < its_TbGNk)) ( (its_TbGKey[i] === w) ? (ki = i); i += 1; );
        (ki < 0) ? its_Tb_KeyErr(w, "Global") : (
            its_Tb_chg = 0;
            its_TbK1[ki] = (ki === 0) ? its_Tb_Enum("samples", its_TbGSm, 3) :
                ((ki === 1) || (ki === 2)) ? its_Tb_Num(its_TbGNam[ki], -120, 40) :
                (ki === 3) ? its_Tb_Enum("action", its_TbGAc, its_GlActTbN) :
                (ki === 5) ? its_Tb_Enum("display", its_TbGDs, 3) :
                its_Tb_Int("chan", 0, 128);
            its_TbKS[ki] = !its_Tb_setm || its_Tb_chg; // (Set : only the keys of a changed argument)
        );
    );
);

// the value of the key "ki" of the block Global
function its_Tb_GGet(ki)
(
    (ki === 0) ? its_GlSmpl : (ki === 1) ? its_GlInGain : (ki === 2) ? its_GlOutVol : (ki === 3) ? 0 : (ki === 5) ? its_XpShow : chcnt;
);

function its_Tb_GText(str, ki, v)
(
    (ki === 0) ? strcpy(str, its_TbGSmN[max(0, min(2, v))]) : (ki === 5) ? strcpy(str, its_TbGDsN[max(0, min(2, v))]) :
    (ki === 4) ? sprintf(str, "%d", v) : sprintf(str, "%.10g", v);
);

/*
    Global : the track samples, the input gain and the output volume are set as the module "Globals" does (its_Gl_Apply
    computes the gains) ; the action is performed last, at once (its_actions) ;
    "chan" (the channels of the track) can't be set : it is accepted, so that a Dump can be read again, and checked
*/
function its_Tb_Global()
(
    its_Tb_GKeys();
    ((its_Tb_error === 0) && (its_Tb_mode === 3)) ? (
        its_TbKS[0] ? ( its_GlSmpl = its_TbK1[0]; );
        its_TbKS[1] ? ( its_GlInGain = its_TbK1[1]; );
        its_TbKS[2] ? ( its_GlOutVol = its_TbK1[2]; );
        its_TbKS[5] ? ( its_XpShow = its_TbK1[5]; );
        its_Gl_Apply();
        (its_TbKS[3] && (its_TbK1[3] !== its_GlAct_None)) ? its_actions(its_TbK1[3]);
    );
);

function its_Tb_DumpGlobal() local(ki)
(
    strcpy(#its_TbW, "Global");
    ki = 0; loop(its_TbGNk,
        (ki !== 3) ? (
            strcat(#its_TbW, its_Xp_Sep()); strcat(#its_TbW, its_TbGNam[ki]); strcat(#its_TbW, " ");
            strcat(#its_TbW, its_Tb_GText(#its_TbV1, ki, its_Tb_GGet(ki)));
        );
        ki += 1;
    );
    its_Tb_Out(#its_TbW);
);

function its_Tb_CheckGlobal() local(ki, bad)
(
    its_Tb_GKeys();
    (its_TbKS[3] && (its_Tb_error === 0)) ? its_Tb_Err(2754, "Check Global : an action can't be checked");
    ((its_Tb_error === 0) && (its_Tb_mode === 3)) ? (
        bad = 0;
        ki = 0; loop(its_TbGNk,
            (its_TbKS[ki] && (abs(its_Tb_GGet(ki) - its_TbK1[ki]) >= 0.0000001)) ? (
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Global : %s %s (expected %s)", its_TbGNam[ki],
                    its_Tb_GText(#its_TbV1, ki, its_Tb_GGet(ki)), its_Tb_GText(#its_TbV2, ki, its_TbK1[ki]));
                mSL_log(SysLogBox, #its_TbMsg);
                (its_Tb_res === 0) ? (its_Tb_res = 2759);
                bad = 1;
            );
            ki += 1;
        );
        (bad === 0) ? mSL_log(SysLogBox, "Check Global OK");
    );
);

//—— Algorithms

/*
    Algorithm Name  input a  output b  param p def min max  <blocks>  End
        a template : the words between the name and End (the declarations first) ; nothing is created
    Instance i Name  a S  b D  p v
        the blocks of the template, with the arguments in place of their names (a parameter : its value, its default if it
        is omitted ; an input or an output : its words, read in the scope of the table) ; the names of the template are the
        names of this instance (its scope : its number k, 1 ... its_InsMx) ; each module named in the template belongs to the
        instance (Owner = k)
    Set i p v ... : the arguments given replace those of the instance ; only the keys whose value depends on a changed argument
        are applied again (its_TbM_Chg) : the other settings of its modules (pads...) are kept
    Free Instance i : deletes its modules ; Dump Instance i : the call, then its modules ; Free Algorithm Name
    The instances are expanded before the 4 passes (its_Al_Expand) : markers (its_TbM_...) tell the scopes ; an instance and
    a template are recorded in pass 3 (its_Al_Commit, its_Al_TplCommit). Errors 2780 ... 2790.
*/
its_AlgMx = 32; // the templates
its_AlgSym = make_array(its_AlgMx); its_AlgBlk = make_array(its_AlgMx); its_AlgLen = make_array(its_AlgMx);
its_InsMx = 64; // the instances 1 ... its_InsMx : name, template (name, copy of its words), arguments, names
its_InsSym = make_array(its_InsMx + 1); its_InsAName = make_array(its_InsMx + 1);
its_InsTpl = make_array(its_InsMx + 1); its_InsTLen = make_array(its_InsMx + 1);
its_InsArg = make_array(its_InsMx + 1); its_InsALen = make_array(its_InsMx + 1);
its_InsNam = make_array(its_InsMx + 1); its_InsNCnt = make_array(its_InsMx + 1);
// (their blocks are dynamic : protected from the garbage collector)
mm_usr_prot[mm_usr_prot_ptr] = its_AlgBlk; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = its_InsTpl; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = its_InsArg; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = its_InsNam; mm_usr_prot_ptr += 1;
// the templates and the instances of the current table, recorded in pass 3
its_APMx = 96; its_APCnt = 0; // (a session : its_AlgMx + its_InsMx at most)
its_APN = make_array(its_APMx); its_APP = make_array(its_APMx); its_APL = make_array(its_APMx);
its_IPMx = 64; its_IPCnt = 0; // (a session : its_InsMx)
its_IPN = make_array(its_IPMx); its_IPK = make_array(its_IPMx); its_IPAN = make_array(its_IPMx);
its_IPTP = make_array(its_IPMx); its_IPTL = make_array(its_IPMx);
its_IPAO = make_array(its_IPMx); its_IPAL = make_array(its_IPMx);
its_IPArgSz = 16384; its_IPArg = make_array(its_IPArgSz); // their arguments : for each declaration, n then n words
its_SPMx = 32; its_SPCnt = 0; // the Set of the table : the instance, its new arguments (in its_IPArg)
its_SPK = make_array(its_SPMx); its_SPAO = make_array(its_SPMx); its_SPAL = make_array(its_SPMx);
// the declarations of a template (its_Al_Decl) : name, kind (0 input, 1 output, 2 param), default, min, max ; the arguments
// of an instance : position in the table, count of words, value
its_AlDMx = 32;
its_AlDN = make_array(its_AlDMx); its_AlDK = make_array(its_AlDMx);
its_AlDDef = make_array(its_AlDMx); its_AlDMin = make_array(its_AlDMx); its_AlDMax = make_array(its_AlDMx);
its_AlAP = make_array(its_AlDMx); its_AlAL = make_array(its_AlDMx); its_AlAV = make_array(its_AlDMx);
its_Tb_cpend = its_Tb_spend = -1; its_Tb_scope = its_Tb_sscope = its_Tb_setm = its_Tb_chg = 0; its_Al_buf = 0;

// the word "i" of the table (its_TK_End after the last one) ; the next word that is not a comma
function its_Al_W(i) ( (i < its_Tb_itc) ? its_Tb_tbl[i] : its_TK_End; );
function its_Al_Skip(i) ( while ((i < its_Tb_itc) && (its_Tb_tbl[i] === mSL_cstComma)) ( i += 1; ); i; );

// the expanded table (its_Al_buf : 0 when its size is computed)
function its_Al_Emit(w) ( (its_Al_buf !== 0) ? (its_Al_buf[its_Al_cnt] = w); its_Al_cnt += 1; );

// the declaration of the name "w" : its index, or -1
function its_Al_DIdx(w) local(i, k)
(
    k = -1; i = 0; while ((k < 0) && (i < its_AlDCnt)) ( (its_AlDN[i] === w) ? (k = i); i += 1; );
    k;
);

// a number (a "-" word before it changes its sign) at "i" in the "n" words "tp" : its value (Undef if none), its_Al_rn the next
// index
function its_Al_RNum(tp, n, i) local(w, sg)
(
    sg = 1;
    w = (i < n) ? tp[i] : its_TK_End;
    (w === mSL_cstMinus) ? ( sg = -1; i += 1; w = (i < n) ? tp[i] : its_TK_End; );
    its_Al_rn = i + 1;
    (abs(w) < mSL_CharConst) ? sg * w : Undef;
);

// the declarations of the template "tp" ("n" words) : its_AlD..., its_AlDCnt ; its_AlBody : the index of its first block
function its_Al_Decl(tp, n) local(i, w, nm, c, v1, v2, v3)
(
    its_AlDCnt = 0; i = 0; its_AlBody = -1;
    while ((its_Tb_error === 0) && (its_AlBody < 0) && (i < n)) (
        w = tp[i];
        (w === mSL_cstComma) ? ( i += 1; ) :
        ((w === its_TK_input) || (w === its_TK_output) || (w === its_TK_param)) ? (
            nm = (i + 1 < n) ? tp[i + 1] : 0;
            c = its_AlDCnt;
            !its_Tb_IsName(nm) ? (
                sprintf(#its_TbW, "Algorithm %s : %s is not a name", mSL_edit_value(#its_TbV, its_Al_cur), mSL_edit_value(#its_TbV1, nm));
                its_Tb_Err(2782, #its_TbW);
            ) :
            (its_Al_DIdx(nm) >= 0) ? (
                sprintf(#its_TbW, "Algorithm %s : %s is declared twice", mSL_edit_value(#its_TbV, its_Al_cur), mSL_edit_value(#its_TbV1, nm));
                its_Tb_Err(2782, #its_TbW);
            ) :
            (c >= its_AlDMx) ? (
                sprintf(#its_TbW, "Algorithm %s : more than %d declarations", mSL_edit_value(#its_TbV, its_Al_cur), its_AlDMx);
                its_Tb_Err(2788, #its_TbW);
            ) : (
                its_AlDN[c] = nm; its_AlDK[c] = (w === its_TK_input) ? 0 : (w === its_TK_output) ? 1 : 2;
                i += 2;
                (w === its_TK_param) ? (
                    v1 = its_Al_RNum(tp, n, i); i = its_Al_rn;
                    v2 = its_Al_RNum(tp, n, i); i = its_Al_rn;
                    v3 = its_Al_RNum(tp, n, i); i = its_Al_rn;
                    ((v1 === Undef) || (v2 === Undef) || (v3 === Undef) || (v2 > v1) || (v1 > v3)) ? (
                        sprintf(#its_TbW, "Algorithm %s : param %s default min max (min <= default <= max) expected",
                            mSL_edit_value(#its_TbV, its_Al_cur), mSL_edit_value(#its_TbV1, nm));
                        its_Tb_Err(2782, #its_TbW);
                    );
                    its_AlDDef[c] = v1; its_AlDMin[c] = v2; its_AlDMax[c] = v3;
                );
                its_AlDCnt += 1;
            );
        ) : (
            its_AlBody = i; // the first block
        );
    );
    (its_AlBody < 0) ? (its_AlBody = n);
);

// the template "w" : 1 if it exists (its words in its_Al_tp, its_Al_tl), the templates of this table first
function its_Al_FindTpl(w) local(i, r)
(
    r = 0;
    i = its_APCnt - 1; while ((r === 0) && (i >= 0)) (
        (its_APN[i] === w) ? ( r = 1; its_Al_tp = its_APP[i]; its_Al_tl = its_APL[i]; );
        i -= 1;
    );
    i = 0; while ((r === 0) && (i < its_AlgMx)) (
        (its_AlgSym[i] === w) ? ( r = 1; its_Al_tp = its_AlgBlk[i]; its_Al_tl = its_AlgLen[i]; );
        i += 1;
    );
    r;
);

// the instance named "w" : its number (recorded, or of this table), or -1
function its_Al_InsFind(w) local(i, k)
(
    k = -1;
    i = 1; while ((k < 0) && (i <= its_InsMx)) ( (its_InsSym[i] === w) ? (k = i); i += 1; );
    i = 0; while ((k < 0) && (i < its_IPCnt)) ( (its_IPN[i] === w) ? (k = its_IPK[i]); i += 1; );
    k;
);

// a module (line, writer, reader, effect) belongs to the instance "k"
function its_Al_Owned(k) local(i, b, r)
(
    r = 0;
    i = 0; while (!r && (i < LN_CNT)) ( b = Lines_Set[i]; r = (b > BASE_MEMORY) && (b[-2] === KW_lcbl) && (b[its_Lin_Owner] === k); i += 1; );
    i = 0; while (!r && (i < WR_CNT)) ( b = Writers_set[i]; r = (b > BASE_MEMORY) && (b[-2] === KW_writ) && (b[its_Wrt_Owner] === k); i += 1; );
    i = 0; while (!r && (i < RD_CNT)) ( b = Readers_set[i]; r = (b > BASE_MEMORY) && (b[-2] === KW_read) && (b[its_Rdr_Owner] === k); i += 1; );
    i = 0; while (!r && (i < FX_CNT)) ( b = Effects_set[i]; r = (b > BASE_MEMORY) && (b[-2] === KW_effx) && (b[its_Efx_Owner] === k); i += 1; );
    r;
);

// a free number for a new instance (not recorded, not used by this table, no module) : 1 ... its_InsMx, or 0
function its_Al_NewId() local(k, i, j, u)
(
    k = 0; i = 1;
    while ((k === 0) && (i <= its_InsMx)) (
        u = (its_InsSym[i] !== 0) || its_Al_Owned(i);
        j = 0; while (!u && (j < its_IPCnt)) ( u = (its_IPK[j] === i); j += 1; );
        !u ? (k = i);
        i += 1;
    );
    k;
);

// the words of an input (dst = 0) or of an output (dst = 1) at "p" in the table : their count (0 : not a source, a destination)
function its_Al_SrcLen(p, dst) local(w, n)
(
    w = its_Al_W(p);
    n = ((dst && (w === its_TK_Own)) || (!dst && (w === its_TK_none))) ? 1 :
        ((!dst && (w === its_TK_In)) || (w === its_TK_Out)) ? 3 :
        ((w === its_TK_Bus) || (!dst && ((w === its_TK_Reader) || (w === its_TK_Effect) || (w === its_TK_Ctl)))) ? 2 : 0;
    ((n === 2) && (w !== its_TK_Ctl) && (its_Al_W(p + 2) === its_TK_Colon)) ? (n = 4);
    n;
);

// the arguments of the instance "nm" (template "an", declarations its_AlD...) from "p" up to the next block : its_AlAP (position
// of the value of each declaration, 0 : not given), its_AlAL (its count of words), its_AlAV (a parameter : its value) ; the index after
function its_Al_Args(p, nm, an) local(d, w, n, v)
(
    d = 0; loop(its_AlDMx, its_AlAP[d] = 0; d += 1;);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Al_W(p = its_Al_Skip(p)))) (
        its_Tb_ptr = p; // (the word of an error)
        ((d = its_Al_DIdx(w)) < 0) ? (
            sprintf(#its_TbW, "Instance %s : %s is not an argument of %s", mSL_edit_value(#its_TbV, nm),
                mSL_edit_value(#its_TbV1, w), mSL_edit_value(#its_TbV2, an));
            its_Tb_Err(2784, #its_TbW);
        ) : (
            p = its_Al_Skip(p + 1);
            its_AlAP[d] = p;
            (its_AlDK[d] === 2) ? (
                v = its_Al_RNum(its_Tb_tbl, its_Tb_itc, p);
                ((v === Undef) || (v < its_AlDMin[d]) || (v > its_AlDMax[d])) ? (
                    sprintf(#its_TbW, "Instance %s : %s : %s is not a value in [%g, %g]", mSL_edit_value(#its_TbV, nm),
                        mSL_edit_value(#its_TbV1, w), mSL_edit_value(#its_TbV2, its_Al_W(p)), its_AlDMin[d], its_AlDMax[d]);
                    its_Tb_Err(2785, #its_TbW);
                );
                its_AlAV[d] = v; p = its_Al_rn;
            ) : (
                ((n = its_Al_SrcLen(p, its_AlDK[d])) === 0) ? (
                    sprintf(#its_TbW, "Instance %s : %s : %s is not %s", mSL_edit_value(#its_TbV, nm),
                        mSL_edit_value(#its_TbV1, w), mSL_edit_value(#its_TbV2, its_Al_W(p)),
                        its_AlDK[d] ? "a destination" : "a source");
                    its_Tb_Err(2784, #its_TbW);
                );
                its_AlAL[d] = n; p += n;
            );
        );
    );
    p;
);

// the record of the arguments (for each declaration : n, then n words), in its_IPArg from its_IPAPt : the given ones, the
// others from "old" (a record, 0 : the defaults) ; its offset (its_Al_alen : its length)
function its_Al_Record(old) local(ao, d, n, j, q)
(
    ao = its_IPAPt; q = old;
    d = 0; while ((its_Tb_error === 0) && (d < its_AlDCnt)) (
        n = its_AlAP[d] ? ((its_AlDK[d] === 2) ? 1 : its_AlAL[d]) : (old !== 0) ? q[0] : 1;
        (ao + n + 1 > its_IPArgSz) ? (
            its_Tb_Err(2788, "Instance : too many arguments in this table");
        ) : (
            its_IPArg[ao] = n;
            its_AlAP[d] ? (
                (its_AlDK[d] === 2) ? (
                    its_IPArg[ao + 1] = its_AlAV[d];
                ) : (
                    j = 0; loop(n, its_IPArg[ao + 1 + j] = its_Tb_tbl[its_AlAP[d] + j]; j += 1;);
                );
            ) :
            (old !== 0) ? (
                j = 0; loop(n, its_IPArg[ao + 1 + j] = q[1 + j]; j += 1;);
            ) : (
                its_IPArg[ao + 1] = its_AlDDef[d]; // (a parameter : an input or an output is given)
            );
            ao += n + 1;
        );
        (old !== 0) ? (q += q[0] + 1);
        d += 1;
    );
    its_Al_alen = ao - its_IPAPt;
    ao = its_IPAPt; its_IPAPt += its_Al_alen;
    ao;
);

// the body of the template "tp" ("tl" words), the names of the declarations replaced by the arguments of the record "ao" ;
// chg : a changed argument is preceded by the marker its_TbM_Chg (Set)
function its_Al_Body(tp, tl, ao, chg) local(j, w, d, q, v, n)
(
    j = its_AlBody; while (j < tl) (
        w = tp[j];
        ((d = its_Al_DIdx(w)) < 0) ? (
            its_Al_Emit(w);
        ) : (
            q = ao; loop(d, q += its_IPArg[q] + 1;); // the argument d
            (chg && its_AlAP[d]) ? its_Al_Emit(its_TbM_Chg);
            (its_AlDK[d] === 2) ? (
                v = its_IPArg[q + 1];
                (v < 0) ? ( its_Al_Emit(mSL_cstMinus); its_Al_Emit(-v); ) : its_Al_Emit(v);
            ) : (
                its_Al_Emit(its_TbM_Out);
                n = its_IPArg[q]; q += 1; loop(n, its_Al_Emit(its_IPArg[q]); q += 1;);
                its_Al_Emit(its_TbM_In);
            );
        );
        j += 1;
    );
);

// Instance at "i" : checked, its body is emitted (with its markers) ; the index after it
function its_Al_Inst(i) local(nm, an, k, p, d, pi, tp)
(
    nm = its_Al_W(i + 1); an = its_Al_W(i + 2); p = i + 3;
    !its_Tb_IsName(nm) ? (
        sprintf(#its_TbW, "Instance : %s is not a name", mSL_edit_value(#its_TbV, nm));
        its_Tb_Err(2783, #its_TbW);
    ) :
    (its_Al_InsFind(nm) >= 0) ? (
        sprintf(#its_TbW, "Instance %s exists already (Free Instance first)", mSL_edit_value(#its_TbV, nm));
        its_Tb_Err(2783, #its_TbW);
    ) :
    !its_Al_FindTpl(an) ? (
        sprintf(#its_TbW, "Instance %s : unknown algorithm %s", mSL_edit_value(#its_TbV, nm), mSL_edit_value(#its_TbV1, an));
        its_Tb_Err(2781, #its_TbW);
    ) :
    ((its_IPCnt >= its_IPMx) || ((k = its_Al_NewId()) === 0)) ? (
        sprintf(#its_TbW, "Instance %s : too many instances", mSL_edit_value(#its_TbV, nm));
        its_Tb_Err(2788, #its_TbW);
    ) : (
        tp = its_Al_tp;
        its_Al_cur = an;
        its_Al_Decl(tp, its_Al_tl);
        p = its_Al_Args(p, nm, an);
        // an input or an output must be given
        d = 0; while ((its_Tb_error === 0) && (d < its_AlDCnt)) (
            ((its_AlDK[d] < 2) && (its_AlAP[d] === 0)) ? (
                sprintf(#its_TbW, "Instance %s : %s %s missing", mSL_edit_value(#its_TbV, nm), its_AlDK[d] ? "output" : "input",
                    mSL_edit_value(#its_TbV1, its_AlDN[d]));
                its_Tb_Err(2786, #its_TbW);
            );
            d += 1;
        );
        (its_Tb_error === 0) ? (
            pi = its_IPCnt; its_IPCnt += 1;
            its_IPN[pi] = nm; its_IPK[pi] = k; its_IPAN[pi] = an; its_IPTP[pi] = tp; its_IPTL[pi] = its_Al_tl;
            its_IPAO[pi] = its_Al_Record(0); its_IPAL[pi] = its_Al_alen;
            its_Al_Emit(its_TbM_Ins); its_Al_Emit(pi);
            its_Al_Body(tp, its_Al_tl, its_IPAO[pi], 0);
            its_Al_Emit(its_TbM_InsEnd);
        );
    );
    p;
);

// Set at "i" : the arguments given replace those of the instance ; its body is emitted in the mode Set (only the keys
// that depend on a changed argument are applied, its_TbM_Chg) ; the index after it
function its_Al_Set(i) local(nm, k, p, j, pi, si, tp, tl, old)
(
    nm = its_Al_W(i + 1); p = i + 2;
    ((k = its_Al_InsFind(nm)) < 0) ? (
        sprintf(#its_TbW, "Set : unknown instance %s", mSL_edit_value(#its_TbV, nm));
        its_Tb_Err(2787, #its_TbW);
    ) :
    (its_SPCnt >= its_SPMx) ? (
        its_Tb_Err(2788, "Set : too many Set in this table");
    ) : (
        // the template and the arguments : recorded, or of an instance of this table (the last record of its arguments)
        (its_InsSym[k] === nm) ? (
            tp = its_InsTpl[k]; tl = its_InsTLen[k]; old = its_InsArg[k]; its_Al_cur = its_InsAName[k];
        ) : (
            j = 0; while (j < its_IPCnt) ( (its_IPK[j] === k) ? (pi = j); j += 1; );
            tp = its_IPTP[pi]; tl = its_IPTL[pi]; old = its_IPArg + its_IPAO[pi]; its_Al_cur = its_IPAN[pi];
        );
        j = 0; while (j < its_SPCnt) ( (its_SPK[j] === k) ? (old = its_IPArg + its_SPAO[j]); j += 1; ); // (a previous Set)
        its_Al_Decl(tp, tl);
        p = its_Al_Args(p, nm, its_Al_cur);
        (its_Tb_error === 0) ? (
            si = its_SPCnt; its_SPCnt += 1;
            its_SPK[si] = k;
            its_SPAO[si] = its_Al_Record(old); its_SPAL[si] = its_Al_alen;
            its_Al_Emit(its_TbM_Set); its_Al_Emit(si);
            its_Al_Body(tp, tl, its_SPAO[si], 1);
            its_Al_Emit(its_TbM_SetEnd);
        );
    );
    p;
);

// the table, its templates taken and its instances expanded, in its_Al_buf (0 : only its size, its_Al_cnt)
// (Algorithm and Instance after Free, Dump, Display or Remove are kept : Free Algorithm, Free Instance, Dump Instance,
// Display Instance, Remove Instance)
function its_Al_Expand() local(i, j, w, nm, pw)
(
    its_Al_cnt = its_APCnt = its_IPCnt = its_SPCnt = its_IPAPt = 0;
    i = 0; pw = 0;
    while ((its_Tb_error === 0) && (i < its_Tb_itc)) (
        w = its_Tb_tbl[i];
        its_Tb_ptr = i; // (the word of an error)
        ((pw === its_TK_Free) || (pw === its_TK_Dump) || (pw === its_TK_Display) || (pw === its_TK_Remove)) ? (
            its_Al_Emit(w);
            i += 1;
        ) :
        (w === its_TK_Algorithm) ? (
            nm = its_Al_W(i + 1); j = i + 2;
            while ((j < its_Tb_itc) && ((w = its_Tb_tbl[j]) !== its_TK_End) && (w !== its_TK_Algorithm) && (w !== its_TK_Instance)
                && (w !== its_TK_EofMark)) ( j += 1; );
            !its_Tb_IsName(nm) ? (
                sprintf(#its_TbW, "Algorithm : %s is not a name", mSL_edit_value(#its_TbV, nm));
                its_Tb_Err(2782, #its_TbW);
            ) :
            ((j >= its_Tb_itc) || (its_Tb_tbl[j] !== its_TK_End)) ? (
                sprintf(#its_TbW, "Algorithm %s : %s", mSL_edit_value(#its_TbV, nm),
                    ((w === its_TK_Algorithm) || (w === its_TK_Instance)) ? "Algorithm or Instance inside" : "End missing");
                its_Tb_Err(((w === its_TK_Algorithm) || (w === its_TK_Instance)) ? 2789 : 2780, #its_TbW);
            ) :
            (its_APCnt >= its_APMx) ? (
                its_Tb_Err(2788, "Algorithm : too many templates in this table");
            ) : (
                its_Al_cur = nm;
                its_Al_Decl(its_Tb_tbl + i + 2, j - i - 2);
                its_APN[its_APCnt] = nm; its_APP[its_APCnt] = its_Tb_tbl + i + 2; its_APL[its_APCnt] = j - i - 2;
                its_APCnt += 1;
            );
            i = j + 1;
        ) :
        (w === its_TK_Instance) ? (
            i = its_Al_Inst(i);
        ) :
        (w === its_TK_Set) ? (
            i = its_Al_Set(i);
        ) : (
            its_Al_Emit(w);
            i += 1;
        );
        (w !== mSL_cstComma) ? (pw = w);
    );
    its_Tb_ptr = 0;
);

// a copy of the record of arguments "ao" ("n" words) in a dynamic block (0 : no memory) ; a name of the table after Reader or
// Effect becomes its number (the names of a table don't last)
function its_Al_ArgCopy(ao, n) local(b, i, j)
(
    ((b = mSL_Dyn_Alloc(n + 1, 'alga', 0)) > BASE_MEMORY) ? (
        memcpy(b, its_IPArg + ao, n);
        j = 1; while (j < n) (
            (((b[j - 1] === its_TK_Reader) || (b[j - 1] === its_TK_Effect)) && its_Tb_IsName(b[j])) ? (
                i = 0; while (i < its_TbNCnt) (
                    ((its_TbNSym[i] === b[j]) && (its_TbNScp[i] === 0) && (its_TbNTyp[i] === b[j - 1])) ? (
                        b[j] = its_TbNIdx[i] + 1; i = its_TbNCnt;
                    );
                    i += 1;
                );
            );
            j += 1;
        );
    );
    b;
);

// pass 3, at the end of a Set : the new arguments of the instance are recorded
function its_Al_SetCommit(si) local(k, b)
(
    k = its_SPK[si];
    ((b = its_Al_ArgCopy(its_SPAO[si], its_SPAL[si])) <= BASE_MEMORY) ? (
        its_Tb_Err(2790, "Set : not enough memory for the arguments");
    ) : (
        (its_InsArg[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_InsArg[k]);
        its_InsArg[k] = b; its_InsALen[k] = its_SPAL[si];
    );
);

// pass 3, at the end of an instance : it is recorded (its template copied, its arguments, its names)
function its_Al_Commit(pi) local(k, b, n, i, j, ok)
(
    k = its_IPK[pi]; ok = 1;
    its_InsSym[k] = its_IPN[pi]; its_InsAName[k] = its_IPAN[pi];
    ((b = mSL_Dyn_Alloc(its_IPTL[pi] + 1, 'algt', 0)) > BASE_MEMORY) ? memcpy(b, its_IPTP[pi], its_IPTL[pi]) : (ok = 0);
    its_InsTpl[k] = b; its_InsTLen[k] = its_IPTL[pi];
    ((b = its_Al_ArgCopy(its_IPAO[pi], its_IPAL[pi])) <= BASE_MEMORY) ? (ok = 0);
    its_InsArg[k] = b; its_InsALen[k] = its_IPAL[pi];
    n = 0; i = 0; loop(its_TbNCnt, (its_TbNScp[i] === k) ? (n += 1); i += 1;);
    ((b = mSL_Dyn_Alloc(3 * n + 1, 'algn', 0)) > BASE_MEMORY) ? (
        j = 0; i = 0; loop(its_TbNCnt,
            (its_TbNScp[i] === k) ? ( b[j] = its_TbNSym[i]; b[j + 1] = its_TbNTyp[i]; b[j + 2] = its_TbNIdx[i]; j += 3; );
            i += 1;
        );
    ) : (ok = 0);
    its_InsNam[k] = b; its_InsNCnt[k] = n;
    !ok ? (
        sprintf(#its_TbW, "Instance %s : not enough memory for its record", mSL_edit_value(#its_TbV, its_IPN[pi]));
        its_Tb_Err(2790, #its_TbW);
    );
);

function its_Al_Flush()
(
    (its_Tb_cpend >= 0) ? ( its_Al_Commit(its_Tb_cpend); its_Tb_cpend = -1; );
    (its_Tb_spend >= 0) ? ( its_Al_SetCommit(its_Tb_spend); its_Tb_spend = -1; );
);

// the names of the recorded instances changed by a Set of the table : in the table of the names (their scope : the instance)
function its_Al_SetNames() local(i, j, k, b, m)
(
    i = 0; loop(its_SPCnt,
        k = its_SPK[i]; m = 1;
        j = 0; while (j < i) ( (its_SPK[j] === k) ? (m = 0); j += 1; ); // (once per instance)
        (m && ((b = its_InsNam[k]) > BASE_MEMORY)) ? (
            j = 0; loop(its_InsNCnt[k],
                (its_TbNCnt < its_TbNSz) ? (
                    its_TbNSym[its_TbNCnt] = b[3 * j]; its_TbNTyp[its_TbNCnt] = b[3 * j + 1]; its_TbNIdx[its_TbNCnt] = b[3 * j + 2];
                    its_TbNScp[its_TbNCnt] = k;
                    its_TbNCnt += 1;
                );
                j += 1;
            );
        );
        i += 1;
    );
);

// end of a table without error : its templates are recorded (a template of the same name is replaced)
function its_Al_TplCommit() local(i, j, k, b)
(
    i = 0; loop(its_APCnt,
        (its_APN[i] !== 0) ? (
            k = -1; j = 0; while ((k < 0) && (j < its_AlgMx)) ( (its_AlgSym[j] === its_APN[i]) ? (k = j); j += 1; );
            j = 0; while ((k < 0) && (j < its_AlgMx)) ( (its_AlgSym[j] === 0) ? (k = j); j += 1; );
            (k < 0) ? (
                its_Tb_Err(2788, "Algorithm : too many templates");
            ) :
            ((b = mSL_Dyn_Alloc(its_APL[i] + 1, 'algt', 0)) <= BASE_MEMORY) ? (
                its_Tb_Err(2790, "Algorithm : not enough memory");
            ) : (
                (its_AlgBlk[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_AlgBlk[k]);
                memcpy(b, its_APP[i], its_APL[i]);
                its_AlgSym[k] = its_APN[i]; its_AlgBlk[k] = b; its_AlgLen[k] = its_APL[i];
            );
        );
        i += 1;
    );
);

// the text of the "n" words "p" of an argument (In:0, Bus 2:1, Reader 3...)
function its_Al_WText(str, p, n) local(i, w)
(
    strcpy(str, "");
    i = 0; loop(n,
        w = p[i];
        (w === its_TK_Colon) ? strcat(str, ":") : (
            ((i > 0) && (p[i - 1] !== its_TK_Colon)) ? strcat(str, " ");
            strcat(str, mSL_edit_value(#its_TbV3, w));
        );
        i += 1;
    );
    str;
);

// the call of the instance "k" in "str" : "Instance i Name arg value ..."
function its_Al_CallText(str, k) local(d, q, n)
(
    sprintf(str, "Instance %s %s", mSL_edit_value(#its_TbV, its_InsSym[k]), mSL_edit_value(#its_TbV1, its_InsAName[k]));
    its_Al_cur = its_InsAName[k];
    its_Al_Decl(its_InsTpl[k], its_InsTLen[k]);
    q = its_InsArg[k];
    d = 0; loop(its_AlDCnt,
        n = q[0];
        strcat(str, " "); strcat(str, mSL_edit_value(#its_TbV, its_AlDN[d])); strcat(str, " ");
        (its_AlDK[d] === 2) ? strcat(str, sprintf(#its_TbV1, "%.10g", q[1])) : strcat(str, its_Al_WText(#its_TbV1, q + 1, n));
        q += n + 1; d += 1;
    );
    str;
);

// the name of the instance "k" (the owner of a module) in "str"
function its_Al_OwnName(str, k)
(
    ((k >= 1) && (k <= its_InsMx) && (its_InsSym[k] !== 0)) ? mSL_edit_value(str, its_InsSym[k]) : sprintf(str, "#%d", k);
    str;
);

// the templates in the log : "Algorithm Name input a output b param p def min max"
function its_Al_DumpTpls() local(i, d, n)
(
    n = 0;
    i = 0; loop(its_AlgMx,
        (its_AlgSym[i] !== 0) ? (
            its_Al_cur = its_AlgSym[i];
            its_Al_Decl(its_AlgBlk[i], its_AlgLen[i]);
            sprintf(#its_TbW, "Algorithm %s", mSL_edit_value(#its_TbV, its_AlgSym[i]));
            d = 0; loop(its_AlDCnt,
                strcat(#its_TbW, (its_AlDK[d] === 0) ? " input " : (its_AlDK[d] === 1) ? " output " : " param ");
                strcat(#its_TbW, mSL_edit_value(#its_TbV, its_AlDN[d]));
                (its_AlDK[d] === 2) ? strcat(#its_TbW, sprintf(#its_TbV1, " %.10g %.10g %.10g", its_AlDDef[d], its_AlDMin[d], its_AlDMax[d]));
                d += 1;
            );
            mSL_log(SysLogBox, #its_TbW);
            n += 1;
        );
        i += 1;
    );
    (n === 0) ? mSL_log(SysLogBox, "No algorithm");
);

// Dump Instance i : "Instance i Name arg value ...", then its modules
function its_Al_DumpIns(k) local(i, b)
(
    mSL_log(SysLogBox, its_Al_CallText(#its_TbW, k));
    i = 0; loop(LN_CNT, (((b = Lines_Set[i]) > BASE_MEMORY) && (b[its_Lin_Owner] === k)) ? its_Tb_DumpLine(i); i += 1;);
    i = 0; loop(WR_CNT, (((b = Writers_set[i]) > BASE_MEMORY) && (b[its_Wrt_Owner] === k)) ? its_Tb_DumpMod(its_TK_Writer, i); i += 1;);
    i = 0; loop(RD_CNT, (((b = Readers_set[i]) > BASE_MEMORY) && (b[its_Rdr_Owner] === k)) ? its_Tb_DumpMod(its_TK_Reader, i); i += 1;);
    i = 0; loop(FX_CNT, (((b = Effects_set[i]) > BASE_MEMORY) && (b[its_Efx_Owner] === k)) ? its_Tb_DumpFx(i); i += 1;);
);

// the modules of the instance "k" are deleted, then it is forgotten (@gfx : Free Instance, the module "Instances")
function its_Al_Delete(k) local(i, b)
(
    i = 0; loop(RD_CNT, (((b = Readers_set[i]) > BASE_MEMORY) && (b[its_Rdr_Owner] === k)) ? Rd_Action(i, its_RdrAct_Delete, 0); i += 1;);
    i = 0; loop(WR_CNT, (((b = Writers_set[i]) > BASE_MEMORY) && (b[its_Wrt_Owner] === k)) ? Wr_Action(its_WrtAct_Delete, i, 0); i += 1;);
    i = 0; loop(FX_CNT, (((b = Effects_set[i]) > BASE_MEMORY) && (b[its_Efx_Owner] === k)) ? FX_Delete(i); i += 1;);
    i = 0; loop(LN_CNT, (((b = Lines_Set[i]) > BASE_MEMORY) && (b[its_Lin_Owner] === k)) ? Ln_Delete(i, 1); i += 1;);
    its_Al_InsDrop(k);
    its_PatchForce = 1;
);

// Free Instance i : its modules are deleted (pass 2 : in the simulation), then it is forgotten
function its_Al_FreeIns(k) local(i)
(
    (its_Tb_mode === 2) ? (
        i = 0; loop(LN_CNT, (its_TbSimLO[i] === k) ? ( its_TbSimSp[i] = its_TbSimCh[i] = its_TbSimLO[i] = 0; ); i += 1;);
        i = 0; loop(WR_CNT, (its_TbSimWO[i] === k) ? ( its_TbSimWE[i] = its_TbSimWO[i] = 0; its_TbSimWL[i] = -1; ); i += 1;);
        i = 0; loop(RD_CNT, (its_TbSimRO[i] === k) ? ( its_TbSimRE[i] = its_TbSimRO[i] = 0; ); i += 1;);
        i = 0; loop(FX_CNT, (its_TbSimFO[i] === k) ? ( its_TbSimFE[i] = its_TbSimFT[i] = its_TbSimFO[i] = 0; ); i += 1;);
    ) :
    (its_Tb_mode === 3) ? (
        its_Al_Delete(k);
        i = 0; loop(its_IPCnt, (its_IPK[i] === k) ? (its_IPN[i] = 0); i += 1;); // (an instance of this table)
    );
);

// the instance named by the next word (Free, Dump) : its number, or -1 and an error
function its_Al_InsWord(what) local(w, k)
(
    w = its_Tb_Next();
    ((k = its_Al_InsFind(w)) < 0) ? (
        sprintf(#its_TbW, "%s Instance : unknown instance %s", what, mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2787, #its_TbW);
    );
    k;
);

// Free Algorithm Name : the template is forgotten (the instances keep their copy)
function its_Al_FreeAlg() local(w, i, f)
(
    w = its_Tb_Next(); f = 0;
    i = 0; loop(its_APCnt, (its_APN[i] === w) ? ( f = 1; (its_Tb_mode === 3) ? (its_APN[i] = 0); ); i += 1;);
    i = 0; loop(its_AlgMx,
        (its_AlgSym[i] === w) ? (
            f = 1;
            (its_Tb_mode === 3) ? ( (its_AlgBlk[i] > BASE_MEMORY) ? mSL_Dyn_Free(its_AlgBlk[i]); its_AlgSym[i] = its_AlgBlk[i] = its_AlgLen[i] = 0; );
        );
        i += 1;
    );
    !f ? (
        sprintf(#its_TbW, "Free Algorithm : unknown algorithm %s", mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2781, #its_TbW);
    );
);

//—— Exports (2) : a patch, a session, in a script
/*
    Written by GMAuxiliary.eel in the folder Data of the project (mSL_Export.jsfx-inc) : a dropped script creates them again.

    A patch, "name-its-patch-YYYY-MM-DD-HH-MM-SS.mSL" : the graph of a module M designated by the user, in the form of the recipes
    of Scripts/Algorithms : a template (Algorithm), its modules with names (those they have in their instance, or mix12, flt3, rd1,
    wr1, ln1...), In:c and Out:c become its inputs and its outputs (in1, out1), then an instance (Instance) ; the curves and the
    values of the controls that it uses come before the template. Its current values : the changes made in the pads are kept.
    The graph : all that M feeds, directly or not, then all that feeds these modules, directly or not. So a module that only
    reads the same source (the test bus 64...), or writes the same output (Out:0), is not in the graph, and any module of a chain
    gives its whole chain, if it does not branch.
    The links : a source or a modulation input (Reader, Effect, Bus, Out), the output of a reader or of an effect (Bus, Out),
    the line of a writer or of a reader, the writer of a delay, the writer that a loop follows. In and Ctl are not links ; a bus
    or Out links the modules that read it to those that write it.

    A session, "name-its-session-YYYY-MM-DD-HH-MM-SS.mSL" : all that a table can describe, by its numbers. It starts with Clear All,
    then Global, the controls, the curves, the templates, the lines, the instances (their template if it is not the recorded one),
    the writers, the readers, the effects, and at last the current values of the modules of the instances (Effect i:name), a
    module deleted by the user is deleted again (Free Effect i:name).
    A session ends with the tabs and their panes (Tab), then what the views of these panes show (View) : they are made again as
    they were. A patch shows its modules as Global display says (its_XpShow : its essential modules are its Display blocks).
    Neither kind of script keeps the samples of the lines (their file is read again).

    Export Patch Line|Writer|Reader|Effect id ["name"], Export Session ["name"] : as the module "Scripts" (show_Scripts_Pad) ;
    Dump Patch Line|Writer|Reader|Effect id, Dump Session : the same blocks in the log (with the graph, for a patch).
    Errors 2720 ... 2728.
*/
its_XpPtMx = 32; // the ports of a patch (at most its_AlDMx : the declarations of a template)
its_XpPtK = make_array(its_XpPtMx); its_XpPtC = make_array(its_XpPtMx); // kind (0 In, 1 Out), channel
its_XpPtI = make_array(its_XpPtMx); its_XpPtS = make_array(its_XpPtMx); // rank in its kind, symbol of its name
its_XpPtN = 0;
its_XpMN = LN_CNT + WR_CNT + RD_CNT + FX_CNT; // the modules, numbered as its_TbResv (see its_Tb_RBase)
its_XpNN = its_XpMN + NB_BUS + 1; // the nodes of the graph : the modules, the buses, Out
its_XpNm = make_array(its_XpMN); // a patch : the symbol of each module
its_XpDn = make_array(its_XpNN); // what the module designated feeds
its_XpGr = make_array(its_XpNN); // the graph
its_XpCrU = make_array(its_CrvMx); its_XpCtU = make_array(NB_CTL); its_XpBuU = make_array(NB_BUS); // a patch : what it uses
its_XpTpMx = its_AlgMx + its_InsMx; // a session : the last text written for each template
its_XpTpS = make_array(its_XpTpMx); its_XpTpP = make_array(its_XpTpMx); its_XpTpL = make_array(its_XpTpMx);
its_XpTpN = 0;
its_XpPfx = make_array(its_Efx_TyCnt); // the start of the name of an effect in a patch, by type
i__ii = 0; loop(its_Efx_TyCnt, its_XpPfx[i__ii] = "fx"; i__ii += 1;);
its_XpPfx[2] = "mix"; its_XpPfx[3] = "amx"; its_XpPfx[7] = "lfo"; its_XpPfx[8] = "flt"; its_XpPfx[9] = "sat"; its_XpPfx[10] = "mtx";
its_XpPfx[11] = "fla"; its_XpPfx[12] = "cho"; its_XpPfx[13] = "pha"; its_XpPfx[14] = "shi"; its_XpPfx[15] = "noi"; its_XpPfx[16] = "rnd";
its_XpPfx[17] = "mth"; its_XpPfx[18] = "rng"; its_XpPfx[19] = "vu"; its_XpPfx[20] = "lim";
its_XpApp = "its"; // the short name of the application, in the names of the files
its_XpTy = its_TK_Effect; its_XpK = 0; // the module designated
#its_XpName = ""; // the name chosen by the user
strcpy(#its_XpFile, ""); // the last file
its_XpWr = 0; // its state : 0 none, 1 asked to GMAuxiliary.eel, 2 written, 3 failed
its_XpPOn = its_XpPend = 0; // the prompt of the name is open (see its_Xp_Frame), the export which waits for it
its_XpKPat = mSL_symbol("Patch"); its_XpKSes = mSL_symbol("Session"); its_XpKVal = mSL_symbol("value");
its_XpKTyp = mSL_symbol("type"); its_XpKCrv = mSL_symbol("curve");
// the blocks Tab and View : their keys, the modules of the panes read, the views to write in a session
its_XpKPanes = mSL_symbol("panes"); its_XpKWid = mSL_symbol("widths"); its_XpKLive = mSL_symbol("live"); its_XpKWords = mSL_symbol("words");
its_XpKPane = make_array(dcbPannelsMax);
i__ii = 0; loop(dcbPannelsMax, its_XpKPane[i__ii] = mSL_symbol(sprintf(#its_XpV1, "pane%d", i__ii + 1)); i__ii += 1;);
its_TbTabM = make_array(dcbPannelsMax * dcbMSize); its_TbTabN = make_array(dcbPannelsMax); its_TbTabW = make_array(4);
its_TbVW = make_array(16); // the words of a View
its_XpVU = make_array(dcbNamesCnt); // a session : the modules in a pane

// the kinds of the module designated : 0 ... 3, as the menu menu_Xp_Kind
function its_Xp_TyOf(i) ( (i === 1) ? its_TK_Reader : (i === 2) ? its_TK_Writer : (i === 3) ? its_TK_Line : its_TK_Effect; );
function its_Xp_TyIdx(ty) ( (ty === its_TK_Reader) ? 1 : (ty === its_TK_Writer) ? 2 : (ty === its_TK_Line) ? 3 : 0; );

/*
    The graph of the module "Patch" (show_PGraph_Pad) : the patch of the module designated (its_XpTy, its_XpK, as the module
    "Scripts"), or all the modules, from left to right. Its nodes : those of its_XpGr (the modules, the buses, Out), then In
    (its_PgIn) and the controls (its_PgCtl + c) ; its links : those of its_Xp_Edges (its_Xp_op 2 : its_Pg_Add), of the kind
    its_Xp_EK : 0 the sound (a source, an output, a line, the writer of a delay), 1 a modulation, 2 the writer that a loop
    follows ; a link of the graph has a module of the graph at one of its ends at least (the other one : a module of the graph,
    a bus, Out, In, a control). The columns (its_Pg_Compute) : the longest path from the sources (the links that close a loop are
    not counted ; a source as near as possible to what it feeds ; Out at the end) ; in a column, the order of the barycenters of
    the neighbours (a few passes from left to right, from right to left).
*/
its_PgIn = its_XpNN; // In (the inputs of the track)
its_PgCtl = its_XpNN + 1; // the controls : its_PgCtl + c
its_PgNN = its_PgCtl + NB_CTL; // all the nodes
its_PgEMx = 2048; // the links shown at most
its_PgEA = make_array(its_PgEMx); its_PgEB = make_array(its_PgEMx); its_PgEK = make_array(its_PgEMx); // from, to, kind
its_PgEBk = make_array(its_PgEMx); // 1 : the link closes a loop (the columns do not count it)
its_PgAdj = make_array(its_PgEMx); // the links from each node (its_PgOff, its_PgDeg)
its_PgEN = its_PgEOv = 0; // the count of links ; 1 : some are not shown (too many)
its_PgOn = make_array(its_PgNN); // the nodes shown
its_PgCol = make_array(its_PgNN); its_PgPos = make_array(its_PgNN); // the column of a node, its row (columns centered : x.5)
its_PgDeg = make_array(its_PgNN); its_PgOff = make_array(its_PgNN); its_PgInD = make_array(its_PgNN);
its_PgSt = make_array(its_PgNN); its_PgIt = make_array(its_PgNN); its_PgStk = make_array(its_PgNN); its_PgTopo = make_array(its_PgNN);
its_PgKey = make_array(its_PgNN); its_PgSum = make_array(its_PgNN); its_PgCnt = make_array(its_PgNN);
its_PgOrd = make_array(its_PgNN); // the nodes shown, column after column, from top to bottom
its_PgCMx = 64; its_PgCS = make_array(its_PgCMx); its_PgCN = make_array(its_PgCMx); // a column : its start in its_PgOrd, its count
its_PgN = its_PgNC = 0; its_PgRows = 1; // the nodes shown, the columns, the rows of the highest column
its_PgOk = 0; // the module designated exists (or : all the modules)
its_PgNbE = its_PgNbR = its_PgNbW = its_PgNbL = 0; // the modules of the graph
its_PgT = 0; its_PgForce = 1; // the time of the last computing (twice per second, at once after a change)
its_PgNv = its_PgCMx; its_PgSc = 0; // the columns shown (see its_Pg_Geo)
its_Xp_EK = 0;

// a link of the graph (its_Xp_op 2) : the same link twice (one module : a source and a modulation) : once, the kind sound first
function its_Pg_Add(a, b) local(ma, mb, d, i)
(
    ma = (a >= 0) && (a < its_XpMN); mb = (b >= 0) && (b < its_XpMN);
    ((a >= 0) && (b >= 0) && (a !== b) && (ma || mb) && (!ma || its_XpGr[a]) && (!mb || its_XpGr[b])) ? (
        // (the links of a module come together : a double is among the last ones)
        d = 0; i = its_PgEN - 1;
        while (!d && (i >= 0) && (i >= its_PgEN - 24)) (
            ((its_PgEA[i] === a) && (its_PgEB[i] === b)) ? ( d = 1; its_PgEK[i] = min(its_PgEK[i], its_Xp_EK); );
            i -= 1;
        );
        !d ? (
            (its_PgEN < its_PgEMx) ? (
                its_PgEA[its_PgEN] = a; its_PgEB[its_PgEN] = b; its_PgEK[its_PgEN] = its_Xp_EK; its_PgEN += 1;
            ) : (
                its_PgEOv = 1;
            );
        );
    );
);

// a link from the node "a" to the node "b" : first what "a" feeds (its_Xp_op 0), then what feeds "b" (1) ; 2 : the graph of the
// module "Patch" (its_Pg_Add)
function its_Xp_Edge(a, b)
(
    (its_Xp_op === 2) ? its_Pg_Add(a, b) :
    ((a >= 0) && (b >= 0)) ? (
        (its_Xp_op === 0) ? (
            (its_XpDn[a] && !its_XpDn[b]) ? ( its_XpDn[b] = 1; its_Xp_chg = 1; );
        ) : (
            (its_XpGr[b] && !its_XpGr[a]) ? ( its_XpGr[a] = 1; its_Xp_chg = 1; );
        );
    );
);

// the node of a source or of an output (kind * ITS_KMul + number) : a reader, an effect, a bus, Out ; -1 : none (In, Ctl ; the
// graph of the module "Patch" : In and the controls are nodes, unless PGraphStruct[1])
function its_Xp_Node(src) local(k, n)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    (src === 0) ? -1 :
    (k === ITS_KRdr) ? its_Tb_RBase(its_TK_Reader) + n :
    (k === ITS_KFx) ? its_Tb_RBase(its_TK_Effect) + n :
    (k === ITS_KBus) ? its_XpMN + n :
    (k === ITS_KOut) ? its_XpMN + NB_BUS :
    ((its_Xp_op === 2) && !PGraphStruct[1]) ? (
        (k === ITS_KIn) ? its_PgIn : ((k === ITS_KCtl) && (n >= 0) && (n < NB_CTL)) ? its_PgCtl + n : -1;
    ) : -1;
);

// all the links of the modules (only the keys that a Dump writes : its_Wrt_ModOk, its_Rdr_ModOk, its_Tb_FxShown) ; its_Xp_EK :
// their kind (see its_Pg_Add)
function its_Xp_Edges() local(i, b, m, mw, ok, j, ty)
(
    mw = its_Tb_RBase(its_TK_Writer);
    i = 0; loop(WR_CNT,
        ((b = its_Xp_Blk(its_TK_Writer, i)) !== 0) ? (
            its_Xp_EK = 0;
            (b[its_Wrt_LineNb] >= 0) ? its_Xp_Edge(mw + i, b[its_Wrt_LineNb]); // (a line : its number)
            its_Xp_Edge(its_Xp_Node(b[its_Wrt_Src]), mw + i);
            ok = its_Wrt_ModOk(b);
            its_Xp_EK = 1;
            j = 0; loop(its_TbWMINb,
                (ok & (1 << j)) ? its_Xp_Edge(its_Xp_Node(b[its_Wrt_Mod1 + j * its_ModDist + its_Mod_Src]), mw + i);
                j += 1;
            );
        );
        i += 1;
    );
    m = its_Tb_RBase(its_TK_Reader);
    i = 0; loop(RD_CNT,
        ((b = its_Xp_Blk(its_TK_Reader, i)) !== 0) ? (
            its_Xp_EK = 0;
            its_Rd_Lined(b[its_Rdr_Mode]) ? (
                (b[its_Rdr_LineNb] >= 0) ? its_Xp_Edge(b[its_Rdr_LineNb], m + i);
                its_Xp_EK = 2;
                (b[its_Rdr_LoopWr] > 0) ? its_Xp_Edge(mw + b[its_Rdr_LoopWr] - 1, m + i);
                its_Xp_EK = 0;
            ) : (
                (b[its_Rdr_WrSrc] >= 0) ? its_Xp_Edge(mw + b[its_Rdr_WrSrc], m + i);
            );
            its_Xp_Edge(m + i, its_Xp_Node(b[its_Rdr_OutK]));
            ok = its_Rdr_ModOk(b);
            its_Xp_EK = 1;
            j = 0; loop(its_TbRMINb,
                (ok & (1 << j)) ? its_Xp_Edge(its_Xp_Node(b[its_Rdr_Mod1 + j * its_ModDist + its_Mod_Src]), m + i);
                j += 1;
            );
        );
        i += 1;
    );
    m = its_Tb_RBase(its_TK_Effect);
    i = 0; loop(FX_CNT,
        ((b = its_Xp_Blk(its_TK_Effect, i)) !== 0) ? (
            ty = b[its_Efx_Type];
            its_Xp_EK = 0;
            j = 0; loop(8,
                its_Tb_FxShown(b, ty, 6 + j) ? its_Xp_Edge(its_Xp_Node(b[its_Efx_Src1 + j * its_EfxDist]), m + i);
                j += 1;
            );
            its_Tb_FxShown(b, ty, 4) ? its_Xp_Edge(m + i, its_Xp_Node(b[its_Efx_OutK]));
            its_Xp_EK = 1;
            j = its_TbFMod; loop(its_TbFMINb,
                its_Tb_FxShown(b, ty, j) ? ( its_Tb_FxGet(j, b); its_Xp_Edge(its_Xp_Node(its_Tb_g1), m + i); );
                j += 1;
            );
        );
        i += 1;
    );
    its_Xp_EK = 0;
);

// the graph of the module "k" of the type "ty" : its_XpGr ; (a bus or Out is not in the graph because a module writes it, only
// because a module of the graph reads it : then all the modules that write it are in the graph)
function its_Xp_Select(ty, k)
(
    memset(its_XpDn, 0, its_XpNN);
    its_XpDn[its_Tb_RBase(ty) + k] = 1;
    its_Xp_op = 0; its_Xp_chg = 1;
    while (its_Xp_chg) ( its_Xp_chg = 0; its_Xp_Edges(); );
    memset(its_XpGr, 0, its_XpNN);
    memcpy(its_XpGr, its_XpDn, its_XpMN);
    its_Xp_op = 1; its_Xp_chg = 1;
    while (its_Xp_chg) ( its_Xp_chg = 0; its_Xp_Edges(); );
);

// the count of modules of the type "ty" in the graph
function its_Xp_Cnt(ty) local(m, i, c)
(
    m = its_Tb_RBase(ty); c = 0;
    i = 0; loop(its_Tb_Count(ty), (its_XpGr[m + i] && (its_Xp_Blk(ty, i) !== 0)) ? (c += 1); i += 1;);
    c;
);

// the graph of the module "Patch" : the rows of the nodes of the column "c" (centered on the highest column)
function its_Pg_Place(c) local(s, n, i)
(
    s = its_PgCS[c]; n = its_PgCN[c];
    i = 0; loop(n, its_PgPos[its_PgOrd[s + i]] = (its_PgRows - n) / 2 + i; i += 1;);
);

// the nodes of the column "c" in the order of the barycenters of their neighbours in the other columns (none : their row)
function its_Pg_Sort(c) local(s, n, i, j, e, a, b, v, x)
(
    s = its_PgCS[c]; n = its_PgCN[c];
    (n > 1) ? (
        i = 0; loop(n, v = its_PgOrd[s + i]; its_PgSum[v] = its_PgCnt[v] = 0; i += 1;);
        e = 0; loop(its_PgEN,
            a = its_PgEA[e]; b = its_PgEB[e];
            ((its_PgCol[a] === c) && (its_PgCol[b] !== c)) ? ( its_PgSum[a] += its_PgPos[b]; its_PgCnt[a] += 1; );
            ((its_PgCol[b] === c) && (its_PgCol[a] !== c)) ? ( its_PgSum[b] += its_PgPos[a]; its_PgCnt[b] += 1; );
            e += 1;
        );
        i = 0; loop(n,
            v = its_PgOrd[s + i];
            its_PgKey[v] = (its_PgCnt[v] > 0) ? its_PgSum[v] / its_PgCnt[v] : its_PgPos[v];
            i += 1;
        );
        // (insertion : the same keys keep their order)
        i = 1; loop(n - 1,
            v = its_PgOrd[s + i]; x = its_PgKey[v];
            j = i - 1; while ((j >= 0) && (its_PgKey[its_PgOrd[s + j]] > x)) ( its_PgOrd[s + j + 1] = its_PgOrd[s + j]; j -= 1; );
            its_PgOrd[s + j + 1] = v;
            i += 1;
        );
        its_Pg_Place(c);
    );
);

// the graph of the module "Patch" (see its_Pg_Add) : its nodes, its links, their columns and their rows
function its_Pg_Compute() local(k, ty, m, i, v, e, a, b, s, sp, r, tp, c, mx, pass)
(
    (PGraphStruct[0] === 1) ? (
        // all the modules
        memset(its_XpGr, 0, its_XpNN);
        k = 0; loop(4,
            ty = (k === 0) ? its_TK_Line : (k === 1) ? its_TK_Writer : (k === 2) ? its_TK_Reader : its_TK_Effect;
            m = its_Tb_RBase(ty);
            i = 0; loop(its_Tb_Count(ty), its_XpGr[m + i] = (its_Xp_Blk(ty, i) !== 0); i += 1;);
            k += 1;
        );
        its_PgOk = 1;
    ) : (
        (its_PgOk = (its_Xp_Blk(its_XpTy, its_XpK) !== 0)) ? its_Xp_Select(its_XpTy, its_XpK) : memset(its_XpGr, 0, its_XpNN);
    );
    its_PgNbE = its_Xp_Cnt(its_TK_Effect); its_PgNbR = its_Xp_Cnt(its_TK_Reader);
    its_PgNbW = its_Xp_Cnt(its_TK_Writer); its_PgNbL = its_Xp_Cnt(its_TK_Line);
    its_PgEN = its_PgEOv = 0;
    its_Xp_op = 2; its_Xp_Edges(); its_Xp_op = 0;
    // the nodes : the modules of the graph, the ends of the links
    memset(its_PgOn, 0, its_PgNN);
    memcpy(its_PgOn, its_XpGr, its_XpMN);
    e = 0; loop(its_PgEN, its_PgOn[its_PgEA[e]] = its_PgOn[its_PgEB[e]] = 1; e += 1;);
    // the links that place the columns (sound, modulation) from each node ; the count of those that come to each node
    memset(its_PgDeg, 0, its_PgNN); memset(its_PgInD, 0, its_PgNN); memset(its_PgIt, 0, its_PgNN);
    e = 0; loop(its_PgEN,
        its_PgEBk[e] = 0;
        (its_PgEK[e] < 2) ? ( its_PgDeg[its_PgEA[e]] += 1; its_PgInD[its_PgEB[e]] += 1; );
        e += 1;
    );
    s = 0; i = 0; loop(its_PgNN, its_PgOff[i] = s; s += its_PgDeg[i]; i += 1;);
    e = 0; loop(its_PgEN,
        (its_PgEK[e] < 2) ? ( a = its_PgEA[e]; its_PgAdj[its_PgOff[a] + its_PgIt[a]] = e; its_PgIt[a] += 1; );
        e += 1;
    );
    // depth first, from the sources first (then the loops without a source) : a link to a node of the path closes a loop
    // (its_PgEBk) ; its_PgTopo [tp ... its_PgNN) : the reverse postorder (each link not in its_PgEBk goes forward in it)
    memset(its_PgSt, 0, its_PgNN); memset(its_PgIt, 0, its_PgNN);
    tp = its_PgNN;
    pass = 0; loop(2,
        r = 0; loop(its_PgNN,
            (its_PgOn[r] && (its_PgSt[r] === 0) && ((pass === 1) || (its_PgInD[r] === 0))) ? (
                its_PgStk[0] = r; sp = 1; its_PgSt[r] = 1;
                while (sp > 0) (
                    v = its_PgStk[sp - 1];
                    (its_PgIt[v] < its_PgDeg[v]) ? (
                        e = its_PgAdj[its_PgOff[v] + its_PgIt[v]]; its_PgIt[v] += 1;
                        b = its_PgEB[e];
                        (its_PgSt[b] === 1) ? (its_PgEBk[e] = 1) :
                        (its_PgSt[b] === 0) ? ( its_PgSt[b] = 1; its_PgStk[sp] = b; sp += 1; );
                    ) : (
                        its_PgSt[v] = 2; sp -= 1;
                        tp -= 1; its_PgTopo[tp] = v;
                    );
                );
            );
            r += 1;
        );
        pass += 1;
    );
    // the columns : the longest path from the sources
    memset(its_PgCol, 0, its_PgNN);
    i = tp; loop(its_PgNN - tp,
        v = its_PgTopo[i];
        e = 0; loop(its_PgDeg[v],
            a = its_PgAdj[its_PgOff[v] + e];
            !its_PgEBk[a] ? ( b = its_PgEB[a]; its_PgCol[b] = min(its_PgCMx - 1, max(its_PgCol[b], its_PgCol[v] + 1)); );
            e += 1;
        );
        i += 1;
    );
    // a source (not In) just before the first node that it feeds ; Out at the end (if it feeds nothing)
    i = tp; loop(its_PgNN - tp,
        v = its_PgTopo[i];
        ((its_PgInD[v] === 0) && (v !== its_PgIn) && (its_PgDeg[v] > 0)) ? (
            c = its_PgCMx;
            e = 0; loop(its_PgDeg[v], a = its_PgAdj[its_PgOff[v] + e]; c = min(c, its_PgCol[its_PgEB[a]]); e += 1;);
            its_PgCol[v] = max(its_PgCol[v], c - 1);
        );
        i += 1;
    );
    mx = 0; i = 0; loop(its_PgNN, its_PgOn[i] ? (mx = max(mx, its_PgCol[i])); i += 1;);
    v = its_XpMN + NB_BUS; // (Out)
    (its_PgOn[v] && (its_PgDeg[v] === 0)) ? (its_PgCol[v] = mx);
    // the columns : In first, then the controls, then the modules, the buses, Out ; then the barycenters
    its_PgNC = mx + 1;
    memset(its_PgCN, 0, its_PgCMx);
    i = 0; loop(its_PgNN, its_PgOn[i] ? (its_PgCN[its_PgCol[i]] += 1); i += 1;);
    s = 0; its_PgRows = 1;
    c = 0; loop(its_PgNC, its_PgCS[c] = s; s += its_PgCN[c]; its_PgRows = max(its_PgRows, its_PgCN[c]); its_PgCN[c] = 0; c += 1;);
    its_PgN = s;
    i = 0; loop(its_PgNN,
        v = (i === 0) ? its_PgIn : (i <= NB_CTL) ? its_PgCtl + i - 1 : i - 1 - NB_CTL;
        its_PgOn[v] ? ( c = its_PgCol[v]; its_PgOrd[its_PgCS[c] + its_PgCN[c]] = v; its_PgCN[c] += 1; );
        i += 1;
    );
    c = 0; loop(its_PgNC, its_Pg_Place(c); c += 1;);
    pass = 0; loop(4,
        i = 0; loop(its_PgNC, its_Pg_Sort((pass & 1) ? its_PgNC - 1 - i : i); i += 1;);
        pass += 1;
    );
);

// the numbers of the modules of the type "ty" of the graph, after "str" : "Effects 1 2 3"
function its_Xp_List(str, nm, ty) local(m, i, f)
(
    m = its_Tb_RBase(ty); f = 0;
    i = 0; loop(its_Tb_Count(ty),
        (its_XpGr[m + i] && (its_Xp_Blk(ty, i) !== 0) && (strlen(str) < 500)) ? (
            !f ? ( (strlen(str) > 0) ? strcat(str, " ; "); strcat(str, nm); f = 1; );
            strcat(str, sprintf(#its_XpV1, " %d", i + 1));
        );
        i += 1;
    );
);

function its_Xp_ListAll(str)
(
    strcpy(str, "");
    its_Xp_List(str, "Effects", its_TK_Effect); its_Xp_List(str, "Readers", its_TK_Reader);
    its_Xp_List(str, "Writers", its_TK_Writer); its_Xp_List(str, "Lines", its_TK_Line);
    str;
);

// the blocks of the modules of the graph, in the order of a table (a writer needs its line, a reader its writer)
function its_Xp_GMods() local(m, i)
(
    m = its_Tb_RBase(its_TK_Line);
    i = 0; loop(LN_CNT, (its_XpGr[m + i] && (its_Xp_Blk(its_TK_Line, i) !== 0)) ? its_Tb_DumpLine(i); i += 1;);
    m = its_Tb_RBase(its_TK_Writer);
    i = 0; loop(WR_CNT, (its_XpGr[m + i] && (its_Xp_Blk(its_TK_Writer, i) !== 0)) ? its_Tb_DumpMod(its_TK_Writer, i); i += 1;);
    m = its_Tb_RBase(its_TK_Reader);
    i = 0; loop(RD_CNT, (its_XpGr[m + i] && (its_Xp_Blk(its_TK_Reader, i) !== 0)) ? its_Tb_DumpMod(its_TK_Reader, i); i += 1;);
    m = its_Tb_RBase(its_TK_Effect);
    i = 0; loop(FX_CNT, (its_XpGr[m + i] && (its_Xp_Blk(its_TK_Effect, i) !== 0)) ? its_Tb_DumpFx(i); i += 1;);
);

// a patch : the symbol "s" can name a module (not a reserved word, not a port, not the name of an other module)
function its_Xp_NmFree(s) local(i, r)
(
    r = its_Tb_IsName(s);
    i = 0; while (r && (i < its_XpPtN)) ( (its_XpPtS[i] === s) ? (r = 0); i += 1; );
    i = 0; while (r && (i < its_XpMN)) ( (its_XpNm[i] === s) ? (r = 0); i += 1; );
    r;
);

// a patch : the name of the module "k" : the one it has in its instance if it is free, else "pfx" and its number
function its_Xp_Name1(ty, k, pfx) local(b, o, s, c)
(
    b = its_Xp_Blk(ty, k);
    s = ((o = its_Xp_Owner(ty, b)) > 0) ? its_Xp_InsName(o, ty, k) : 0;
    ((s !== 0) && !its_Xp_NmFree(s)) ? (s = 0);
    c = 0; while ((s === 0) && (c < 9)) (
        s = mSL_symbol(sprintf(#its_XpV1, "%s%d", pfx, k + 1 + 1000 * c));
        !its_Xp_NmFree(s) ? (s = 0);
        c += 1;
    );
    its_XpNm[its_Tb_RBase(ty) + k] = s;
);

function its_Xp_SetNames() local(i, m, b)
(
    memset(its_XpNm, 0, its_XpMN);
    m = its_Tb_RBase(its_TK_Line);
    i = 0; loop(LN_CNT, (its_XpGr[m + i] && (its_Xp_Blk(its_TK_Line, i) !== 0)) ? its_Xp_Name1(its_TK_Line, i, "ln"); i += 1;);
    m = its_Tb_RBase(its_TK_Writer);
    i = 0; loop(WR_CNT, (its_XpGr[m + i] && (its_Xp_Blk(its_TK_Writer, i) !== 0)) ? its_Xp_Name1(its_TK_Writer, i, "wr"); i += 1;);
    m = its_Tb_RBase(its_TK_Reader);
    i = 0; loop(RD_CNT, (its_XpGr[m + i] && (its_Xp_Blk(its_TK_Reader, i) !== 0)) ? its_Xp_Name1(its_TK_Reader, i, "rd"); i += 1;);
    m = its_Tb_RBase(its_TK_Effect);
    i = 0; loop(FX_CNT,
        (its_XpGr[m + i] && ((b = its_Xp_Blk(its_TK_Effect, i)) !== 0)) ?
            its_Xp_Name1(its_TK_Effect, i, its_XpPfx[max(0, min(its_Efx_TyCnt - 1, b[its_Efx_Type]))]);
        i += 1;
    );
);

// a block : see its_Tb_Out
function its_Xp_E(ind, str) ( its_Xp_Ind = ind; its_Tb_Out(str); );

// the number of the module named "str" (as in the menu of the modules, see Display "name") ; -1 : none
function its_Xp_ModNum(str) local(k, i)
(
    k = -1; i = blockFirst; while ((k < 0) && (i <= blockUsrLast)) ( (stricmp(blockModNames[i], str) === 0) ? (k = i); i += 1; );
    k;
);

// the display block of the module "k" (a view, Controls, Patch, the summary modules) : its_XpVSt (0 : none), its size its_XpVSz,
// the kind of the object it shows its_XpVTy (Reader, Writer, Line, Effect, Curve ; 0 : none) ; its_XpVSt
function its_Xp_ViewOf(k)
(
    its_XpVSt = its_XpVSz = its_XpVTy = 0;
    ((k >= blockReaderA) && (k <= blockReaderH)) ? (
        its_XpVSt = ReadersStructA + (k - blockReaderA) * ReadersBlockSize; its_XpVSz = ReadersBlockSize; its_XpVTy = its_TK_Reader;
    ) :
    ((k >= blockWriterA) && (k <= blockWriterH)) ? (
        its_XpVSt = WriterStructA + (k - blockWriterA) * WriterBlockSize; its_XpVSz = WriterBlockSize; its_XpVTy = its_TK_Writer;
    ) :
    ((k >= blockLineA) && (k <= blockLineH)) ? (
        its_XpVSt = LinesStructA + (k - blockLineA) * LinesBlockSize; its_XpVSz = LinesBlockSize; its_XpVTy = its_TK_Line;
    ) :
    ((k >= blockEffectA) && (k <= blockEffectP)) ? (
        its_XpVSt = EffectsStructA + (k - blockEffectA) * LinesBlockSize; its_XpVSz = LinesBlockSize; its_XpVTy = its_TK_Effect;
    ) :
    ((k >= blockCurvesA) && (k <= blockCurvesH)) ? (
        // (the curve, the grid ; the other words : the mouse)
        its_XpVSt = its_CrvEd + (k - blockCurvesA) * its_CrvEdSz; its_XpVSz = 2; its_XpVTy = its_TK_Curve;
    ) :
    (k === blockControls) ? ( its_XpVSt = ControlsStruct; its_XpVSz = 8; ) :
    (k === blockPatch) ? ( its_XpVSt = PatchStruct; its_XpVSz = 8; ) :
    (k === blockPGraph) ? ( its_XpVSt = PGraphStruct; its_XpVSz = 3; ) :
    ((k >= blockReaders) && (k <= blockEffects)) ? ( its_XpVSt = SummaryStruct + k - blockReaders; its_XpVSz = 1; ) :
    (k === blockLines) ? ( its_XpVSt = SummaryStruct + 3; its_XpVSz = 1; ) :
    (k === blockCurves) ? ( its_XpVSt = SummaryStruct + 4; its_XpVSz = 1; ) :
    (k === blockAllMods) ? ( its_XpVSt = SummaryStruct + 5; its_XpVSz = 2; ); // (the page, the kind shown)
    its_XpVSt;
);

// Tab t + 1 (0 ... dcbTabsCount - 1) : its block (an empty tab : "pane1" without a module, its panes are emptied when it is read) ;
// its_XpVU : the modules of its panes
function its_Xp_DumpTab(t) local(p, d, i, n, nt)
(
    sprintf(#its_XpT, "Tab %d", t + 1);
    (strlen(altTabsNames[t]) > 0) ? strcat(#its_XpT, sprintf(#its_XpV1, "%sname \"%s\"", its_Xp_Sep(), altTabsNames[t]));
    strcat(#its_XpT, sprintf(#its_XpV1, "%spanes %d", its_Xp_Sep(), max(1, min(dcbPannelsMax, 0|serialBlock[Pr7_StudConf + t]))));
    d = serialBlock + Pr7_StudRat + 4 * t;
    strcat(#its_XpT, sprintf(#its_XpV1, "%swidths %.10g %.10g %.10g %.10g", its_Xp_Sep(), d[0], d[1], d[2], d[3]));
    strcat(#its_XpT, sprintf(#its_XpV1, "%slive %s", its_Xp_Sep(), serialBlock[Pr7_StudLive + t] ? "On" : "Off"));
    nt = 0;
    p = 0; loop(dcbPannelsMax,
        d = dcbBlocksAll + (t * dcbPannelsMax + p) * dcbWSize;
        n = 0; i = 0; loop(dcbMax, ((d[i] >= blockFirst) && (d[i] <= blockUsrLast)) ? (n += 1); i += 1;);
        nt += n;
        (n > 0) ? (
            strcat(#its_XpT, sprintf(#its_XpV1, "%spane%d", its_Xp_Sep(), p + 1));
            i = 0; loop(dcbMax,
                ((d[i] >= blockFirst) && (d[i] <= blockUsrLast)) ? (
                    strcat(#its_XpT, sprintf(#its_XpV1, " \"%s\"", blockModNames[d[i]]));
                    its_XpVU[d[i]] = 1;
                );
                i += 1;
            );
        );
        p += 1;
    );
    (nt === 0) ? strcat(#its_XpT, sprintf(#its_XpV1, "%spane1", its_Xp_Sep()));
    its_Tb_Out(#its_XpT);
);

// View "module" : what it shows, the other words of its display block
function its_Xp_DumpView(k) local(st, j, o)
(
    ((st = its_Xp_ViewOf(k)) > 0) ? (
        sprintf(#its_XpT, "View \"%s\"", blockModNames[k]);
        (its_XpVTy === its_TK_Curve) ? (
            o = max(0, min(its_CrvMx - 1, 0|st[0]));
            strcat(#its_XpT, sprintf(#its_XpV1, "%sCurve %s", its_Xp_Sep(), its_Crv_TbName(#its_TbV, o)));
        ) :
        (its_XpVTy !== 0) ? (
            o = max(0, min(its_Tb_Count(its_XpVTy) - 1, 0|st[0]));
            strcat(#its_XpT, sprintf(#its_XpV1, "%s%s %s", its_Xp_Sep(), its_Tb_TyName(its_XpVTy), its_Xp_Ref(#its_XpH, its_XpVTy, o)));
        );
        strcat(#its_XpT, its_Xp_Sep()); strcat(#its_XpT, "words");
        j = (its_XpVTy !== 0) ? 1 : 0;
        loop(its_XpVSz - j, strcat(#its_XpT, sprintf(#its_XpV1, " %.10g", st[j])); j += 1;);
        its_Tb_Out(#its_XpT);
    );
);

// a session : the tabs, then the views that their panes show
function its_Xp_Layout() local(t, k)
(
    memset(its_XpVU, 0, dcbNamesCnt);
    its_Xp_Ind = 4;
    t = 0; loop(dcbTabsCount, its_Xp_DumpTab(t); t += 1;);
    k = blockFirst; loop(blockUsrLast - blockFirst + 1, its_XpVU[k] ? its_Xp_DumpView(k); k += 1;);
);

function its_Xp_DumpCtl(i)
(
    sprintf(#its_TbW, "Control %d value %.10g", i + 1, its_Ctl_Get(i));
    its_Tb_Out(#its_TbW);
);

// the curve "k" : in a file, its points on several lines ; a session : its number, then its name
function its_Xp_Curve(k) local(b, n, p, q)
(
    (its_Xp_Sink === 2) ? (
        b = its_CrvBlk[k];
        (its_Xp_On === 2) ? (
            sprintf(#its_XpT, "Curve %d", k + 1);
            (strlen(its_CrvNm[k]) > 0) ? strcat(#its_XpT, sprintf(#its_TbV1, "  name %s", its_Crv_TbName(#its_TbV, k)));
        ) : (
            sprintf(#its_XpT, "Curve %s", its_Crv_TbName(#its_TbV, k));
        );
        strcat(#its_XpT, sprintf(#its_TbV1, "  type %s", its_CrvTyN[b[its_Crv_Type]]));
        (b[its_Crv_Flags] & its_CrvFl_Periodic) ? strcat(#its_XpT, "  periodic On");
        (b[its_Crv_Sus] >= 0) ? strcat(#its_XpT, sprintf(#its_TbV1, "  sustain %d", b[its_Crv_Sus] + 1));
        strcat(#its_XpT, "  points");
        xpt_Block(#its_XpT, 4);
        n = b[its_Crv_N]; p = b + its_Crv_Pts;
        while (n > 0) (
            strcpy(#its_XpT, "");
            q = 0; loop(min(6, n), strcat(#its_XpT, sprintf(#its_TbV1, "%s%.10g %.10g %.10g", (q > 0) ? "  " : "", p[0], p[1], p[2])); p += 3; q += 1;);
            n -= q;
            xpt_Block(#its_XpT, 8);
        );
    ) : (
        its_Crv_Dump(k);
    );
);

// the name of the user : #its_XpFN for the files, #its_XpCB for the curves without a name, #its_XpAN and #its_XpIN for the
// template and the instance : letters, digits, _ ; 8 characters at most ; a letter first ; not a reserved word
function its_Xp_SetName() local(i, c)
(
    strcpy_substr(#its_XpFN, #its_XpName, 0, 64);
    xpt_Clean(#its_XpFN);
    (strlen(#its_XpFN) === 0) ? strcpy(#its_XpFN, "Patch"); // (Dump Patch)
    strcpy_substr(#its_XpCB, #its_XpFN, 0, its_CrvNmMx - 4);
    strcpy(#its_XpIN, "");
    i = 0; while ((i < strlen(#its_XpFN)) && (strlen(#its_XpIN) < 8)) (
        c = str_getchar(#its_XpFN, i, 'cu');
        (c !== '-') ? strcat(#its_XpIN, sprintf(#its_XpV1, "%c", c));
        i += 1;
    );
    c = str_getchar(#its_XpIN, 0, 'cu');
    !(((c >= 'A') && (c <= 'Z')) || ((c >= 'a') && (c <= 'z'))) ? (
        strcpy_substr(#its_XpIN, sprintf(#its_XpV1, "p%s", #its_XpIN), 0, 8);
        c = 'p';
    );
    strcpy(#its_XpAN, #its_XpIN);
    ((c >= 'a') && (c <= 'z')) ? str_setchar(#its_XpAN, 0, c - 32, 'cu');
    ((c >= 'A') && (c <= 'Z')) ? str_setchar(#its_XpIN, 0, c + 32, 'cu');
    !its_Tb_IsName(mSL_symbol(#its_XpAN)) ? strcpy_substr(#its_XpAN, sprintf(#its_XpV1, "P%s", #its_XpAN), 0, 8);
    !its_Tb_IsName(mSL_symbol(#its_XpIN)) ? strcpy_substr(#its_XpIN, sprintf(#its_XpV1, "p%s", #its_XpIN), 0, 8);
);

// the ports of the kind "kd" after "str", for the comment of a patch
function its_Xp_PtText(str, kd) local(i, f)
(
    f = 0;
    i = 0; loop(its_XpPtN,
        (its_XpPtK[i] === kd) ? (
            strcat(str, f ? ", " : " ");
            strcat(str, sprintf(#its_XpV1, kd ? "out%d = Out:%d" : "in%d = In:%d", its_XpPtI[i], its_XpPtC[i]));
            f = 1;
        );
        i += 1;
    );
    !f ? strcat(str, " aucune");
);

// the first pass of a patch : its graph, what it uses (its_Xp_Port, its_Crv_TbName, its_Tb_SrcText), the names of its modules
function its_Xp_Prep(ty, k)
(
    its_Xp_Select(ty, k);
    its_XpPtN = 0;
    memset(its_XpNm, 0, its_XpMN);
    memset(its_XpCrU, 0, its_CrvMx); memset(its_XpCtU, 0, NB_CTL); memset(its_XpBuU, 0, NB_BUS);
    its_Xp_On = 1; its_Xp_Sink = 1;
    its_Xp_GMods();
    its_Xp_SetNames();
);

// a patch (see its_Xp_Prep), in the sink chosen
function its_Xp_PatchBody(ty, k) local(i, f)
(
    (its_Xp_Sink === 2) ? (
        sprintf(#its_XpT, "print(\"%s. Patch Interstys, exporte le %s.\");", #its_XpFN, #its_XpDt); xpt_Line(#its_XpT);
        xpt_Line("");
        xpt_Line(sprintf(#its_XpT, "%c*", '/'));
        sprintf(#its_XpT, "  Patch \"%s\", exporte d'Interstys le %s, a partir de %s %d.", #its_XpFN, #its_XpDt, its_Tb_TyName(ty), k + 1); xpt_Line(#its_XpT);
        sprintf(#its_XpT, "  Le graphe de ce module : tout ce qu'il alimente, et tout ce qui alimente ces modules, soit %d effet(s), %d reader(s), %d writer(s), %d ligne(s).",
            its_Xp_Cnt(its_TK_Effect), its_Xp_Cnt(its_TK_Reader), its_Xp_Cnt(its_TK_Writer), its_Xp_Cnt(its_TK_Line)); xpt_Line(#its_XpT);
        strcpy(#its_XpT, "  Entrees :"); its_Xp_PtText(#its_XpT, 0); xpt_Line(#its_XpT);
        strcpy(#its_XpT, "  Sorties :"); its_Xp_PtText(#its_XpT, 1); xpt_Line(#its_XpT);
        strcpy(#its_XpT, "  Bus utilises :"); f = 0;
        i = 0; loop(NB_BUS, its_XpBuU[i] ? ( strcat(#its_XpT, sprintf(#its_XpV1, " %d", i + 1)); f = 1; ); i += 1;);
        !f ? strcat(#its_XpT, " aucun");
        xpt_Line(#its_XpT);
        xpt_Line("");
        xpt_Line("  Utilisation : deposer ce fichier dans Interstys. L'instance est refaite (la premiere fois, le journal note une erreur");
        xpt_Line("  2787 : l'instance a retirer n'existe pas encore, sans consequence). La ligne \"Instance\", en bas, branche l'algorithme");
        xpt_Line("  sur d'autres entrees et d'autres sorties. Les lignes sont recreees vides : seul leur fichier, s'il y en a un, est relu.");
        xpt_Line(sprintf(#its_XpT, "*%c", '/'));
        xpt_Line("");
        sprintf(#its_XpT, "table(data( Free Instance %s )); // (l'instance precedente)", #its_XpIN); xpt_Line(#its_XpT);
        xpt_Line("var r = table(data(");
        xpt_Line("    Interstys");
    );
    its_Xp_Ind = 4;
    i = 0; loop(NB_GSL, its_XpCtU[i] ? its_Xp_DumpCtl(i); i += 1;);
    i = 0; loop(its_CrvMx, (its_XpCrU[i] && (its_CrvBlk[i] > BASE_MEMORY)) ? its_Xp_Curve(i); i += 1;);
    sprintf(#its_XpT, "Algorithm %s", #its_XpAN); its_Xp_E(4, #its_XpT);
    i = 0; loop(its_XpPtN, (its_XpPtK[i] === 0) ? its_Xp_E(8, sprintf(#its_XpT, "input in%d", its_XpPtI[i])); i += 1;);
    i = 0; loop(its_XpPtN, (its_XpPtK[i] === 1) ? its_Xp_E(8, sprintf(#its_XpT, "output out%d", its_XpPtI[i])); i += 1;);
    its_Xp_Ind = 8;
    its_Xp_GMods();
    its_Xp_E(8, sprintf(#its_XpT, "Display %s %s", its_Tb_TyName(ty), its_Xp_Ref(#its_XpH, ty, k)));
    its_Xp_E(4, "End");
    sprintf(#its_XpT, "Instance %s %s", #its_XpIN, #its_XpAN);
    i = 0; loop(its_XpPtN,
        strcat(#its_XpT, sprintf(#its_XpV1, (its_XpPtK[i] === 0) ? "  in%d In:%d" : "  out%d Out:%d", its_XpPtI[i], its_XpPtC[i]));
        i += 1;
    );
    its_Xp_E(4, #its_XpT);
    (its_Xp_Sink === 2) ? (
        xpt_Line("));");
        sprintf(#its_XpT, "print(sprintf(0, \"%s. instance %s : %%d (0 : OK)\", r));", #its_XpFN, #its_XpIN); xpt_Line(#its_XpT);
    );
);

// the word "w" of a template (the previous one "p") after #its_XpT
function its_Xp_TWord(w, p)
(
    (w === mSL_cstComma) ? 0 :
    (w === its_TK_Colon) ? strcat(#its_XpT, ":") : (
        ((strlen(#its_XpT) > 0) && (p !== its_TK_Colon) && (p !== mSL_cstMinus)) ? strcat(#its_XpT, " ");
        (w === mSL_cstMinus) ? strcat(#its_XpT, "-") :
        // (a string : only after these words ; a number could be taken for the number of a string)
        (((p === its_TK_file) || (p === its_TK_Display) || (p === its_TK_Remove) || (p === its_TK_name) || (p === its_TK_Curve)
            || (p === its_XpKCrv)) && mSL_isString(w)) ? strcat(#its_XpT, sprintf(#its_XpV1, "\"%s\"", w)) :
        (abs(w) < mSL_CharConst) ? strcat(#its_XpT, sprintf(#its_XpV1, "%.10g", w)) :
        strcat(#its_XpT, mSL_edit_value(#its_XpV1, w));
    );
);

// the word "i" of a template starts a new line of its text (only the look of the script : a source "Effect x" stays on its line)
function its_Xp_TBreak(tp, i, n) local(w, p, q)
(
    w = tp[i]; p = (i > 0) ? tp[i - 1] : 0;
    ((p === its_TK_Display) || (p === its_TK_Remove) || (p === its_TK_Free) || (p === its_TK_Dump) || (p === its_TK_Check)) ? 0 :
    ((w === its_TK_input) || (w === its_TK_output) || (w === its_TK_param) || (w === its_TK_Line) || (w === its_TK_Display)
        || (w === its_TK_Remove) || (w === its_TK_Free) || (w === its_TK_Dump) || (w === its_TK_Check) || (w === its_TK_Global)
        || (w === its_TK_Control)) ? 1 :
    ((w === its_TK_Effect) || (w === its_TK_Reader) || (w === its_TK_Writer)) ? (
        q = (i + 2 < n) ? tp[i + 2] : 0;
        (q === its_XpKTyp) || (q === its_TK_status) || (q === its_TK_chan) || (q === its_TbRKey[0]) || (q === its_TbRKey[1]) || (q === its_TbWKey[1]);
    ) : 0;
);

// a session : the template "nm" ("n" words "tp"), unless this text is the last one written for this name
function its_Xp_Tpl(nm, tp, n) local(i, f, same)
(
    f = -1; i = 0; while ((f < 0) && (i < its_XpTpN)) ( (its_XpTpS[i] === nm) ? (f = i); i += 1; );
    same = (f >= 0) && (its_XpTpL[f] === n);
    i = 0; while (same && (i < n)) ( (its_XpTpP[f][i] !== tp[i]) ? (same = 0); i += 1; );
    !same ? (
        ((f < 0) && (its_XpTpN < its_XpTpMx)) ? ( f = its_XpTpN; its_XpTpN += 1; );
        (f >= 0) ? ( its_XpTpS[f] = nm; its_XpTpP[f] = tp; its_XpTpL[f] = n; );
        its_Xp_E(4, sprintf(#its_XpT, "Algorithm %s", mSL_edit_value(#its_XpV2, nm)));
        strcpy(#its_XpT, "");
        i = 0; loop(n,
            (its_Xp_TBreak(tp, i, n) && (strlen(#its_XpT) > 0)) ? ( its_Xp_E(8, #its_XpT); strcpy(#its_XpT, ""); );
            its_Xp_TWord(tp[i], (i > 0) ? tp[i - 1] : 0);
            i += 1;
        );
        (strlen(#its_XpT) > 0) ? its_Xp_E(8, #its_XpT);
        its_Xp_E(4, "End");
    );
);

// a session : the modules of the type "ty" which belong to an instance (own) or not
function its_Xp_SMods(ty, own) local(i, b)
(
    its_Xp_Ind = 4;
    i = 0; loop(its_Tb_Count(ty),
        (((b = its_Xp_Blk(ty, i)) !== 0) && ((its_Xp_Owner(ty, b) > 0) === own)) ? (
            (ty === its_TK_Line) ? its_Tb_DumpLine(i) : (ty === its_TK_Effect) ? its_Tb_DumpFx(i) : its_Tb_DumpMod(ty, i);
        );
        i += 1;
    );
);

// a session, in the sink chosen
function its_Xp_SessBody() local(i, k, b, t, m)
(
    (its_Xp_Sink === 2) ? (
        sprintf(#its_XpT, "print(\"%s. Session Interstys, exportee le %s.\");", #its_XpFN, #its_XpDt); xpt_Line(#its_XpT);
        xpt_Line("");
        xpt_Line(sprintf(#its_XpT, "%c*", '/'));
        sprintf(#its_XpT, "  Session \"%s\", exportee d'Interstys le %s.", #its_XpFN, #its_XpDt); xpt_Line(#its_XpT);
        xpt_Line("");
        xpt_Line("  Deposer ce fichier dans Interstys : TOUT est remplace (les modules, les instances, les algorithmes, les courbes, les");
        xpt_Line("  valeurs des curseurs, les onglets). Les lignes sont recreees vides : seul leur fichier, s'il y en a un, est relu. Les onglets et les");
        xpt_Line("  modules affiches sont refaits a l'identique, par les blocs Tab et View, en bas du fichier.");
        xpt_Line("  Une instance (Instance) est refaite, puis les valeurs courantes de ses modules, en bas du fichier (Effect i:nom),");
        xpt_Line("  remplacent celles de son modele : pour changer un reglage, c'est la qu'il faut le modifier.");
        xpt_Line(sprintf(#its_XpT, "*%c", '/'));
        xpt_Line("");
        xpt_Line("table(data( Interstys Clear All ));");
        xpt_Line("var r = table(data(");
        xpt_Line("    Interstys");
    );
    its_Xp_Ind = 4;
    its_Tb_DumpGlobal();
    i = 0; loop(NB_GSL, (its_Ctl_Get(i) !== 0) ? its_Xp_DumpCtl(i); i += 1;);
    i = 0; loop(its_CrvMx, (its_CrvBlk[i] > BASE_MEMORY) ? its_Xp_Curve(i); i += 1;);
    its_XpTpN = 0;
    i = 0; loop(its_AlgMx, ((its_AlgSym[i] !== 0) && (its_AlgBlk[i] > BASE_MEMORY)) ? its_Xp_Tpl(its_AlgSym[i], its_AlgBlk[i], its_AlgLen[i]); i += 1;);
    its_Xp_SMods(its_TK_Line, 0);
    k = 1; loop(its_InsMx,
        ((its_InsSym[k] !== 0) && (its_InsTpl[k] > BASE_MEMORY)) ? (
            its_Xp_Tpl(its_InsAName[k], its_InsTpl[k], its_InsTLen[k]); // (a template forgotten or replaced since the instance)
            its_Xp_E(4, its_Al_CallText(#its_XpT, k));
        );
        k += 1;
    );
    // (the recorded templates stay the last ones)
    i = 0; loop(its_AlgMx, ((its_AlgSym[i] !== 0) && (its_AlgBlk[i] > BASE_MEMORY)) ? its_Xp_Tpl(its_AlgSym[i], its_AlgBlk[i], its_AlgLen[i]); i += 1;);
    its_Xp_SMods(its_TK_Writer, 0);
    its_Xp_SMods(its_TK_Reader, 0);
    its_Xp_SMods(its_TK_Effect, 0);
    // the current values of the modules of the instances, then those that the user deleted
    its_Xp_SMods(its_TK_Line, 1);
    its_Xp_SMods(its_TK_Writer, 1);
    its_Xp_SMods(its_TK_Reader, 1);
    its_Xp_SMods(its_TK_Effect, 1);
    k = 1; loop(its_InsMx,
        ((its_InsSym[k] !== 0) && ((m = its_InsNam[k]) > BASE_MEMORY)) ? (
            i = 0; loop(its_InsNCnt[k],
                t = m[3 * i + 1];
                ((t === its_TK_Line) || (t === its_TK_Writer) || (t === its_TK_Reader) || (t === its_TK_Effect)) ? (
                    (((b = its_Xp_Blk(t, m[3 * i + 2])) === 0) || (its_Xp_Owner(t, b) !== k)) ? (
                        sprintf(#its_XpT, "Free %s %s:%s", its_Tb_TyName(t), mSL_edit_value(#its_XpV1, its_InsSym[k]), mSL_edit_value(#its_XpV2, m[3 * i]));
                        its_Xp_E(4, #its_XpT);
                    );
                );
                i += 1;
            );
        );
        k += 1;
    );
    its_Xp_Layout(); // (last : the views show the modules created above)
    (its_Xp_Sink === 2) ? (
        xpt_Line("));");
        sprintf(#its_XpT, "print(sprintf(0, \"%s. session : %%d (0 : OK)\", r));", #its_XpFN); xpt_Line(#its_XpT);
    );
);

// the text of a patch (kd 1 : of the module "k" of the type "ty") or of a session (kd 2) : sink 0 the log, 2 the file
function its_Xp_Text(kd, ty, k, sink)
(
    its_Tb_error = 0; // (the error of the last table : its_Al_Decl, in its_Al_CallText, would do nothing)
    its_Xp_SetName();
    xpt_Date(#its_XpDt, 1);
    (kd === 1) ? (
        its_Xp_Prep(ty, k);
        its_Xp_Sink = sink;
        (sink === 0) ? (
            sprintf(#its_XpT, "Patch of %s %d : %d effects, %d readers, %d writers, %d lines", its_Tb_TyName(ty), k + 1,
                its_Xp_Cnt(its_TK_Effect), its_Xp_Cnt(its_TK_Reader), its_Xp_Cnt(its_TK_Writer), its_Xp_Cnt(its_TK_Line));
            mSL_log(SysLogBox, #its_XpT);
            mSL_log(SysLogBox, sprintf(#its_XpT, "Graph : %s", its_Xp_ListAll(#its_XpS)));
        );
        its_Xp_PatchBody(ty, k);
    ) : (
        its_Xp_On = 2; its_Xp_Sink = sink;
        its_Xp_SessBody();
    );
    its_Xp_On = its_Xp_Sink = 0;
);

// an error of an export : logged ; its code
function its_Xp_Err(code, msg)
(
    sprintf(#its_XpM, "ERR: %04d    Interstys export : %s", code, msg);
    mSL_log(SysLogBox, #its_XpM);
    code;
);

// an export (kd 1 : a patch of the module designated ; kd 2 : the session) : 0, or the code of its error
function its_Xp_Export(kd) local(c)
(
    (strlen(#its_XpName) === 0) ? (
        its_Xp_Err(2721, "no name");
    ) :
    ((c = xpt_Ready()) !== 0) ? (
        its_Xp_Err(2722, (c === 1) ? "no auxiliary script (GMAuxiliary.eel)" : (c === 2) ? "the auxiliary script GMAuxiliary.eel must be started again (an old version)" :
            "the auxiliary script is busy : try again");
    ) :
    ((kd === 1) && (its_Xp_Blk(its_XpTy, its_XpK) === 0)) ? (
        its_Xp_Err(2723, sprintf(#its_XpT, "%s %d does not exist", its_Tb_TyName(its_XpTy), its_XpK + 1));
    ) : (
        xpt_Begin();
        its_Xp_Text(kd, its_XpTy, its_XpK, 2);
        xpt_Ov ? (
            its_Xp_Err(2720, "the text is too long (xpt_Sz), nothing is written");
        ) : (
            xpt_FileName(#its_XpFile, #its_XpFN, its_XpApp, (kd === 1) ? "patch" : "session");
            xpt_Send(#its_XpFile);
            its_XpWr = 1;
            sprintf(#its_XpM, "Export : %s : %d words", #its_XpFile, xpt_J);
            mSL_log(SysLogBox, #its_XpM);
            0;
        );
    );
);

// asks for the name in the prompt ; kd > 0 : the export that follows
function its_Xp_Prompt(kd)
(
    its_XpPend = kd; its_XpPOn = 1;
    strcpy(#its_XpPrm, #its_XpName);
    ui_screen_open("control.prompt");
    ui_screen_arg(0, #its_XpPrm);
    ui_screen_arg(1, "The name of the exported files");
);

// an export asked by the user (kd 1 : a patch of the module "k" of the type "ty") : without a name, the prompt first
function its_Xp_Ask(kd, ty, k)
(
    (kd === 1) ? ( its_XpTy = ty; its_XpK = k; );
    (strlen(#its_XpName) === 0) ? its_Xp_Prompt(kd) : its_Xp_Export(kd);
);

// each frame of @gfx : the prompt closed (Cancel : the name does not change, an export without a name is not done), the file written
function its_Xp_Frame() local(r)
(
    (its_XpPOn && !(ui_screen() == "control.prompt")) ? (
        its_XpPOn = 0;
        strcpy(#its_XpName, #its_XpPrm);
        ((its_XpPend > 0) && (strlen(#its_XpName) > 0)) ? its_Xp_Export(its_XpPend);
        its_XpPend = 0;
    );
    ((r = xpt_Poll()) !== 0) ? (
        (r > 0) ? (
            its_XpWr = 2;
            sprintf(#its_XpM, "Export : %s written in the folder of the project", #its_XpFile);
            mSL_log(SysLogBox, #its_XpM);
        ) : (
            its_XpWr = 3;
            its_Xp_Err(2724, sprintf(#its_XpT, "the file %s can't be written", #its_XpFile));
        );
    );
);

//—— Dump, Check, Free
function its_Tb_Dump() local(w, ty, k, b)
(
    w = its_Tb_Next();
    (w === its_TK_Global) ? (
        (its_Tb_mode === 3) ? its_Tb_DumpGlobal();
    ) :
    (w === its_TK_Curve) ? (
        k = its_Crv_Id(its_Tb_Next(), 0);
        ((its_Tb_error === 0) && (k >= 0) && !its_Crv_Exists(k)) ? (
            sprintf(#its_TbW, "Dump Curve %d : no curve", k + 1);
            its_Tb_Err(2792, #its_TbW);
        );
        ((its_Tb_mode === 3) && (its_Tb_error === 0)) ? its_Crv_Dump(k);
    ) :
    (w === its_TK_Instance) ? (
        k = its_Al_InsWord("Dump");
        ((its_Tb_mode === 3) && (k > 0)) ? its_Al_DumpIns(k);
    ) :
    (w === its_XpKPat) ? (
        ((ty = its_Tb_Type(its_Tb_Next(), "Dump Patch")) !== 0) ? (
            k = its_Tb_Id(ty, its_Tb_Next(), 0);
            ((its_Tb_mode === 3) && (its_Tb_error === 0) && (k >= 0)) ? (
                (its_Xp_Blk(ty, k) !== 0) ? its_Xp_Text(1, ty, k, 0) : (
                    sprintf(#its_TbW, "Dump Patch : %s %d does not exist", its_Tb_TyName(ty), k + 1);
                    its_Tb_Err(2723, #its_TbW);
                );
            );
        );
    ) :
    (w === its_XpKSes) ? (
        (its_Tb_mode === 3) ? its_Xp_Text(2, 0, 0, 0);
    ) :
    (w === its_TK_Control) ? (
        k = its_Tb_Int("Dump Control", 1, NB_GSL);
        ((its_Tb_mode === 3) && (its_Tb_error === 0)) ? its_Xp_DumpCtl(k - 1);
    ) :
    (w === its_TK_Tab) ? (
        k = its_Tb_Int("Dump Tab", 1, dcbTabsCount);
        ((its_Tb_mode === 3) && (its_Tb_error === 0)) ? its_Xp_DumpTab(k - 1);
    ) :
    (w === its_TK_View) ? (
        w = its_Tb_Next();
        ((k = mSL_isString(w) ? its_Xp_ModNum(w) : -1) < 0) ? (
            sprintf(#its_TbW, "Dump View : %s is not the \"name\" of a module", mSL_edit_value(#its_TbV, w));
            its_Tb_Err(2727, #its_TbW);
        ) :
        (its_Xp_ViewOf(k) === 0) ? (
            sprintf(#its_TbW, "Dump View \"%s\" : this module has no view", blockModNames[k]);
            its_Tb_Err(2728, #its_TbW);
        ) :
        (its_Tb_mode === 3) ? its_Xp_DumpView(k);
    ) :
    (w === its_TK_Order) ? (
        // the execution order of the effects that exist (computed now, unless the previous one is not yet taken by @block)
        (its_Tb_mode === 3) ? (
            its_FxSig = -1; its_Fx_Order();
            strcpy(#its_TbW, "Order :");
            k = 0; loop(FX_CNT,
                b = Effects_set[its_FxOrd[k]];
                ((b > BASE_MEMORY) && (b[-2] === KW_effx)) ? strcat(#its_TbW, sprintf(#its_TbV1, " %d", its_FxOrd[k] + 1));
                k += 1;
            );
            strcat(#its_TbW, sprintf(#its_TbV1, " ; loops %d", its_FxCycN));
            mSL_log(SysLogBox, #its_TbW);
        );
    ) :
    (w === its_TK_All) ? (
        (its_Tb_mode === 3) ? (
            its_Tb_DumpGlobal();
            k = 0; loop(LN_CNT, (Lines_Set[k] !== 0) ? its_Tb_DumpLine(k); k += 1;);
            k = 0; loop(WR_CNT, (Writers_set[k] !== 0) ? its_Tb_DumpMod(its_TK_Writer, k); k += 1;);
            k = 0; loop(RD_CNT, (Readers_set[k] !== 0) ? its_Tb_DumpMod(its_TK_Reader, k); k += 1;);
            k = 0; loop(FX_CNT, (Effects_set[k] !== 0) ? its_Tb_DumpFx(k); k += 1;);
            k = 0; loop(its_CrvMx, (its_CrvBlk[k] > BASE_MEMORY) ? its_Crv_Dump(k); k += 1;);
        );
    ) :
    ((ty = its_Tb_Type(w, "Dump")) !== 0) ? (
        k = its_Tb_Id(ty, its_Tb_Next(), 0);
        ((its_Tb_mode === 3) && (k >= 0)) ? (
            (ty === its_TK_Line) ? its_Tb_DumpLine(k) : (ty === its_TK_Effect) ? its_Tb_DumpFx(k) : its_Tb_DumpMod(ty, k);
        );
    );
);

function its_Tb_Check() local(w, ty, k)
(
    ((w = its_Tb_Next()) === its_TK_Global) ? (
        its_Tb_CheckGlobal();
    ) :
    (w === its_TK_Curve) ? (
        its_Crv_Check();
    ) :
    ((ty = its_Tb_Type(w, "Check")) !== 0) ? (
        k = its_Tb_Id(ty, its_Tb_Next(), 0);
        (ty === its_TK_Line) ? its_Tb_CheckLine(k) : (ty === its_TK_Effect) ? its_Tb_CheckFx(k) : its_Tb_CheckMod(ty, k);
    );
);

function its_Tb_Free() local(w, ty, k)
(
    ((w = its_Tb_Next()) === its_TK_Instance) ? (
        ((k = its_Al_InsWord("Free")) > 0) ? its_Al_FreeIns(k);
    ) :
    (w === its_TK_Algorithm) ? (
        its_Al_FreeAlg();
    ) :
    (w === its_TK_Curve) ? (
        its_Crv_Free();
    ) :
    ((ty = its_Tb_Type(w, "Free")) !== 0) ? (
        k = its_Tb_Id(ty, its_Tb_Next(), 0);
        (k >= 0) ? (
            (its_Tb_mode === 2) ? (
                (ty === its_TK_Line) ? ( its_TbSimSp[k] = its_TbSimCh[k] = 0; ) :
                (ty === its_TK_Writer) ? ( its_TbSimWE[k] = 0; its_TbSimWL[k] = -1; ) :
                (ty === its_TK_Reader) ? ( its_TbSimRE[k] = 0; ) :
                ( its_TbSimFE[k] = its_TbSimFT[k] = 0; );
            ) :
            (its_Tb_mode === 3) ? (
                (ty === its_TK_Line) ? Ln_Delete(k, 1) :
                (ty === its_TK_Writer) ? Wr_Action(its_WrtAct_Delete, k, 0) :
                (ty === its_TK_Reader) ? Rd_Action(k, its_RdrAct_Delete, 0) :
                FX_Delete(k);
            );
        );
    );
);

/*
    the module "n" of the kind "t" shown in the current tab (the block Display of a table ; as its_Mod_Open, without a module
    of reference) : 'E' an effect, 'R' a reader, 'W' a writer, 'L' a line, 'C' a curve : a view of the tab that shows it
    (nothing to do), else a view of the tab that shows a module that does not exist (it shows this one), else a new view
    (the first one of the kind unused in the tab) ; 'M' the module "n" itself (blockGlobal, blockSysLog, ...) : nothing to do
    if it is in the tab ; a new view, a module : at the end of the displayed pane that has the fewest modules ; returns 1, or
    0 : no free view of the kind, or no room in the panes
*/
function its_Mod_ShowIn(t, n, tb, np)
local (b0, st, sz, nv, set, p, d, i, m, c, fs, fe, used, ua, bp, bc)
(
    nv = 8; st = set = sz = 0; // (the views of the kind : 8, the effects its_EfxViews)
    (t === 'R') ? ( b0 = blockReaderA; st = ReadersStructA; sz = ReadersBlockSize; set = Readers_set; ) :
    (t === 'W') ? ( b0 = blockWriterA; st = WriterStructA; sz = WriterBlockSize; set = Writers_set; ) :
    (t === 'L') ? ( b0 = blockLineA; st = LinesStructA; sz = LinesBlockSize; set = Lines_Set; ) :
    (t === 'C') ? ( b0 = blockCurvesA; st = its_CrvEd; sz = its_CrvEdSz; set = its_CrvBlk; nv = its_CrvEdN; ) :
    (t === 'E') ? ( b0 = blockEffectA; st = EffectsStructA; sz = LinesBlockSize; nv = its_EfxViews; set = Effects_set; ) :
    ( b0 = n; nv = 1; ); // a module
    np = max(1, min(dcbPannelsMax, np)); // the panes displayed
    fs = fe = bp = -1; used = ua = 0; bc = dcbMax;
    // the views used in all the tabs
    (st !== 0) ? (
        p = 0; loop(dcbMCount,
            d = dcbBlocksAll + p * dcbWSize;
            i = 0; loop(dcbMax, m = d[i] - b0; ((d[i] > 0) && (m >= 0) && (m < nv)) ? (ua |= 2 ^ m); i += 1;);
            p += 1;
        );
    );
    p = 0; loop(dcbPannelsMax,
        d = dcbBlocksAll + (tb * dcbPannelsMax + p) * dcbWSize;
        c = 0;
        i = 0; loop(dcbMax,
            (d[i] > 0) ? (c = i + 1);
            m = d[i] - b0;
            ((d[i] > 0) && (m >= 0) && (m < nv)) ? (
                used |= 2 ^ m;
                (st === 0) ? (fs = m) : // (a module in the tab)
                (p < np) ? (
                    (st[m * sz] === n) ? (fs = m) : ((fe < 0) && (set[max(0, 0|st[m * sz])] <= BASE_MEMORY)) ? (fe = m);
                );
            );
            i += 1;
        );
        ((p < np) && (c < bc)) ? ( bp = p; bc = c; );
        p += 1;
    );
    (fs >= 0) ? 1 :
    (fe >= 0) ? ( st[fe * sz] = n; 1; ) :
    ((bp < 0) || (bc >= its_ShowMax)) ? 0 : (
        // a view that no tab shows, else (the current tab only) a view that this tab does not show
        m = 0; while ((m < nv) && (ua & (2 ^ m))) ( m += 1; );
        ((m >= nv) && (tb === TabIdt)) ? ( m = 0; while ((m < nv) && (used & (2 ^ m))) ( m += 1; ); );
        (m < nv) ? (
            d = dcbBlocksAll + (tb * dcbPannelsMax + bp) * dcbWSize;
            d[bc] = b0 + m; // (after the last module of the pane)
            (st !== 0) ? (st[m * sz] = n);
            1;
        ) : 0;
    );
);

// the name of the tab "tb"
function its_Tab_Name(tb) ( (strlen(altTabsNames[tb]) > 0) ? altTabsNames[tb] : uix_jG_menuscr[tb]; );

/*
    the module "n" of the kind "t" shown (the block Display of a table ; as its_Mod_Open, without a module of reference) : 'E'
    an effect, 'R' a reader, 'W' a writer, 'L' a line, 'C' a curve : a view of the tab that shows it (nothing to do), else a view
    of the tab that shows a module that does not exist (it shows this one), else a new view (the first one of the kind that no
    tab shows ; in the current tab : else the first one that it does not show) ; 'M' the module "n" itself (blockGlobal,
    blockSysLog, ...) : nothing to do if it is in the tab ; a new view, a module : at the end of the displayed pane that has
    the fewest modules, if it has less than its_ShowMax modules ; in the current tab, else in the next ones (not "live") ;
    returns 1, or 0 : no free view of the kind, or no room in the panes
*/
function its_Mod_Show(t, n) local(r, i, tb)
(
    r = its_Mod_ShowIn(t, n, TabIdt, studDispPCnt);
    i = 1; while (!r && (i < dcbTabsCount)) (
        tb = (TabIdt + i) % dcbTabsCount;
        (serialBlock[Pr7_StudLive + tb] == 0) ? (
            (r = its_Mod_ShowIn(t, n, tb, serialBlock[Pr7_StudConf + tb])) ? (
                sprintf(#its_ModShM, "Display : shown in the tab \"%s\" (no room in the current tab)", its_Tab_Name(tb));
                mSL_log(SysLogBox, #its_ModShM);
            );
        );
        i += 1;
    );
    r;
);

/*
    the module "n" of the kind "t" (as its_Mod_Show) taken out of the current tab (the block Remove of a table) : the views
    of the tab that show it ('M' : the module "n" itself), in all its panes ; the modules after them move up ; returns the
    count of modules taken out (the modules themselves are not deleted)
*/
function its_Mod_Hide(t, n)
local (b0, st, sz, nv, p, d, i, j, m, r)
(
    nv = 8; st = sz = 0;
    (t === 'R') ? ( b0 = blockReaderA; st = ReadersStructA; sz = ReadersBlockSize; ) :
    (t === 'W') ? ( b0 = blockWriterA; st = WriterStructA; sz = WriterBlockSize; ) :
    (t === 'L') ? ( b0 = blockLineA; st = LinesStructA; sz = LinesBlockSize; ) :
    (t === 'C') ? ( b0 = blockCurvesA; st = its_CrvEd; sz = its_CrvEdSz; nv = its_CrvEdN; ) :
    (t === 'E') ? ( b0 = blockEffectA; st = EffectsStructA; sz = LinesBlockSize; nv = its_EfxViews; ) :
    ( b0 = n; nv = 1; ); // a module
    r = 0;
    p = 0; loop(dcbPannelsMax,
        d = dcbBlocksAll + (TabIdt * dcbPannelsMax + p) * dcbWSize;
        i = 0;
        while (i < dcbMax) (
            m = d[i] - b0;
            ((d[i] > 0) && (m >= 0) && (m < nv) && ((st === 0) || (st[m * sz] === n))) ? (
                j = i; while (j < dcbMax - 1) ( d[j] = d[j + 1]; j += 1; );
                d[dcbMax - 1] = 0;
                r += 1;
            ) : (
                i += 1;
            );
        );
        p += 1;
    );
    r;
);

/*
    Display Effect|Reader|Writer|Line id, Display Curve id, Display "name" (a module by its name, see blockModNames :
    "Globals", "System Log", "Connections", "Patch", "Effect C"...) : the module shown in the current tab (pass 3 ; see its_Mod_Show), a new
    view or a new module if needed ; no free view or no room : a message in the log, the table goes on ; rm : Remove, the
    module taken out of the current tab (its_Mod_Hide ; none : a message) ; Display Instance i, Remove Instance i : all the
    modules of the instance ; a module of an instance from outside : Effect i:name (see its_Tb_Id)
*/
function its_Tb_Display(rm) local(w, k, i, t, wh, b, n, f, ty, t2, sk)
(
    wh = rm ? "Remove" : "Display";
    // the Display of an instance : its essential modules (its_XpShow None, or a table with tabs : nothing is shown)
    sk = !rm && (its_Tb_scope > 0) && ((its_XpShow === 0) || its_Tb_hasTab);
    w = its_Tb_Next();
    (w === its_TK_Instance) ? (
        // all the modules of an instance (kept with it : its_InsNam)
        k = its_Al_InsWord(wh);
        t = 'I';
    ) :
    mSL_isString(w) ? (
        // (blockModNames : the names in the order of the module numbers ; blockDispNames : in the order of the menu)
        k = -1; i = blockFirst; while ((k < 0) && (i <= blockUsrLast)) ( (stricmp(blockModNames[i], w) === 0) ? (k = i); i += 1; );
        (k < 0) ? (
            sprintf(#its_TbW, "%s : no module named \"%s\"", wh, w);
            its_Tb_Err(2777, #its_TbW);
        ) : (
            t = 'M';
        );
    ) :
    ((w === its_TK_Effect) || (w === its_TK_Reader) || (w === its_TK_Writer) || (w === its_TK_Line)) ? (
        k = its_Tb_Id(w, its_Tb_Next(), 0);
        t = (w === its_TK_Effect) ? 'E' : (w === its_TK_Reader) ? 'R' : (w === its_TK_Writer) ? 'W' : 'L';
    ) :
    (w === its_TK_Curve) ? (
        k = its_Crv_Id(its_Tb_Next(), 0);
        ((its_Tb_error === 0) && (its_Tb_mode >= 2) && (k >= 0) && !its_Crv_Exists(k)) ? (
            sprintf(#its_TbW, "%s Curve %d : no curve", wh, k + 1);
            its_Tb_Err(2792, #its_TbW);
        );
        t = 'C';
    ) : (
        sprintf(#its_TbW, "%s : %s is not Effect, Reader, Writer, Line, Curve, Instance or the \"name\" of a module", wh, mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2776, #its_TbW);
    );
    ((its_Tb_mode === 3) && (its_Tb_error === 0) && (k > 0) && (t === 'I') && !sk) ? (
        // an instance : each one of its modules shown (Display), or the views that show them taken out (Remove)
        n = f = 0;
        ((b = its_InsNam[k]) > BASE_MEMORY) ? (
            i = 0; loop(its_InsNCnt[k],
                ty = b[3 * i + 1];
                t2 = (ty === its_TK_Effect) ? 'E' : (ty === its_TK_Reader) ? 'R' : (ty === its_TK_Writer) ? 'W' :
                    (ty === its_TK_Line) ? 'L' : (ty === its_TK_Curve) ? 'C' : 0;
                (t2 !== 0) ? (
                    rm ? (n += its_Mod_Hide(t2, b[3 * i + 2])) : ( its_Mod_Show(t2, b[3 * i + 2]) ? (n += 1) : (f += 1); );
                );
                i += 1;
            );
        );
        ((n === 0) || (f > 0)) ? (
            rm ? sprintf(#its_TbW, "Interstys table : Remove Instance %s : no view of the tab shows its modules", mSL_edit_value(#its_TbV, its_InsSym[k])) :
                sprintf(#its_TbW, "Interstys table : Display Instance %s : %d module(s) not shown (no free view, or no room)",
                    mSL_edit_value(#its_TbV, its_InsSym[k]), f);
            ((n === 0) || !rm) ? mSL_log(SysLogBox, #its_TbW);
        );
    ) :
    ((its_Tb_mode === 3) && (its_Tb_error === 0) && (k >= 0) && rm) ? (
        // Remove : the views that show the module (or the module) taken out of the tab ; none : a message
        (its_Mod_Hide(t, k) === 0) ? (
            (t === 'M') ? sprintf(#its_TbW, "Interstys table : Remove \"%s\" : not in the tab", blockModNames[k]) :
                sprintf(#its_TbW, "Interstys table : Remove %s %d : no view of the tab shows it", (t === 'C') ? "Curve" : its_Tb_TyName(w), k + 1);
            mSL_log(SysLogBox, #its_TbW);
        );
    ) :
    ((its_Tb_mode === 3) && (its_Tb_error === 0) && (k >= 0) && (t !== 'I') && !sk) ? (
        !its_Mod_Show(t, k) ? (
            (t === 'M') ? sprintf(#its_TbW, "Interstys table : Display \"%s\" : no room in the panes of the tab", blockModNames[k]) :
                sprintf(#its_TbW, "Interstys table : Display %s %d : no free view of this kind in the tab, or no room in its panes",
                    (t === 'C') ? "Curve" : its_Tb_TyName(w), k + 1);
            mSL_log(SysLogBox, #its_TbW);
        );
    );
);

// Control n value v : the generic slider
function its_Tb_Control() local(n, v)
(
    n = its_Tb_Int("Control", 1, NB_GSL);
    (its_Tb_error === 0) ? (
        (its_Tb_Next() !== its_XpKVal) ? (
            its_Tb_Err(2725, "Control n value v : the key value is expected");
        ) : (
            v = its_Tb_Num("Control", -1, 1);
            ((its_Tb_mode === 3) && (its_Tb_error === 0)) ? its_Ctl_Set(n - 1, v);
        );
    );
);

// Export Patch Line|Writer|Reader|Effect id ["name"], Export Session ["name"] : pass 3 ; an error of the export does not stop the table
function its_Tb_Export() local(w, ty, k, r)
(
    k = -1; ty = 0;
    w = its_Tb_Next();
    (w === its_XpKPat) ? (
        ((ty = its_Tb_Type(its_Tb_Next(), "Export Patch")) !== 0) ? (k = its_Tb_Id(ty, its_Tb_Next(), 0));
    ) :
    (w !== its_XpKSes) ? (
        sprintf(#its_TbW, "Export : %s is not Patch or Session", mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2726, #its_TbW);
    );
    (its_Tb_error === 0) ? (
        mSL_isString(its_Tb_Peek()) ? (
            r = its_Tb_Next();
            (its_Tb_mode === 3) ? strcpy(#its_XpName, r);
        );
        ((its_Tb_mode === 3) && ((w === its_XpKSes) || (k >= 0))) ? (
            (w === its_XpKPat) ? ( its_XpTy = ty; its_XpK = k; );
            r = its_Xp_Export((w === its_XpKPat) ? 1 : 2);
            ((r !== 0) && (its_Tb_res === 0)) ? (its_Tb_res = r);
        );
    );
);

// the pane of a key pane1 ... pane4 : 0 ... 3, or -1
function its_Xp_PaneKey(w) local(i, r)
(
    r = -1; i = 0; while ((r < 0) && (i < dcbPannelsMax)) ( (its_XpKPane[i] === w) ? (r = i); i += 1; );
    r;
);

// Tab n keys... (pass 3 ; a pane key : all the panes of the tab replaced, an unknown module : a message)
function its_Tb_Tab() local(t, w, j, k, np, lv, nm, mn, pn, any, wdn, p, d)
(
    t = its_Tb_Int("Tab", 1, dcbTabsCount) - 1;
    (its_Tb_mode === 0) ? (its_Tb_hasTab = 1);
    np = lv = -1; nm = any = wdn = 0;
    memset(its_TbTabN, 0, dcbPannelsMax);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        (w === its_TK_name) ? (
            nm = its_Tb_Next();
            !mSL_isString(nm) ? its_Tb_Err(2727, "Tab : name \"text\" expected");
        ) :
        (w === its_XpKPanes) ? ( np = its_Tb_Int("panes", 1, dcbPannelsMax); ) :
        (w === its_XpKLive) ? ( lv = its_Tb_Enum("live", its_TbFSt, 2); ) :
        (w === its_XpKWid) ? (
            wdn = 0; while ((its_Tb_error === 0) && (wdn < 4) && its_Tb_IsNum()) ( its_TbTabW[wdn] = its_Tb_Num("widths", 0, 100000); wdn += 1; );
        ) :
        ((pn = its_Xp_PaneKey(w)) >= 0) ? (
            any = 1;
            while (mSL_isString(mn = its_Tb_Peek())) (
                its_Tb_Next();
                ((k = its_Xp_ModNum(mn)) < 0) ? (
                    (its_Tb_mode === 3) ? (
                        sprintf(#its_TbW, "Interstys table : Tab %d : no module named \"%s\" (ignored)", t + 1, mn);
                        mSL_log(SysLogBox, #its_TbW);
                    );
                ) :
                (its_TbTabN[pn] < dcbMax) ? ( its_TbTabM[pn * dcbMSize + its_TbTabN[pn]] = k; its_TbTabN[pn] += 1; );
            );
        ) :
