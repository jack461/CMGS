// ============ Memory Debug ============
/*
    Types:   0x100  : the address to display is computed in the memory displayer by "mSL_Dbg_Memory_Updt"
             0x001  : show absolute : relative address
             0x002  : data is in gmem
             0x004  : show @ in hexadecimal
             0x008  : show data in hexadecimal
*/
// The debug menu ActionTbSiz
idx = 0;
DebugTbTyps[idx] = 0; DebugTbAdds[idx] = 0; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Memory"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 4; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Mem. mSL"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 5; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Main Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 6; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Aux. Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 7; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Readers Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 8; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Lines Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 9; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Writers Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 10; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Effects Set"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 11; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "spl()"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 12; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "alt()"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 21; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Reader 1"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 22; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Line 1"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 23; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Writer 1"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 24; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Effect 1"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 25; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Reader 2"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 26; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Line 2"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 27; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Writer 2"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 28; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Effect 2"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 29; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Reader 3"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 30; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Line 3"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 31; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Writer 3"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 32; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Effect 3"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 33; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Reader 4"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 34; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Line 4"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 35; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Writer 4"; idx += 1;
DebugTbTyps[idx] = 0x101; DebugTbAdds[idx] = 36; DebugTbDecs[idx] = 0; DebugTbNames[idx] = "Effect 4"; idx += 1;

DebugCount = idx;

mSL_Sort_Strings(DebugCount, 0, DebugTbNames, DebugTbTyps, DebugTbAdds, DebugTbDecs);

menu_Debug = make_jmenu(
            ui_jmenu_typ_action | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "debug", DebugCount, DebugTbNames);

debugDSize = 128;
memoryBox1[12] = make_array(debugDSize);
memoryBox2[12] = make_array(debugDSize);
// Preselect "Memory"
// Look for the "Memory" entry.
dbg_curr_sel = -1;
i__ii = 0; while ((dbg_curr_sel < 0) && (i__ii < DebugCount)) (
    (DebugTbNames[i__ii] == "Memory") ? dbg_curr_sel = i__ii;
    i__ii += 1;
);
memoryBox1[6] = memoryBox2[6] = dbg_curr_sel;
memoryBox1[8] = memoryBox2[8] = 0;
memoryBox1[9] = memoryBox2[9] = 0;
memoryBox1[10] = memoryBox2[10] = 0;
memoryBox1[11] = memoryBox2[11] = 0;
memoryBox1[13] = memoryBox2[13] = 0;
memoryBox1[14] = memoryBox2[14] = 0;


/* Add a file name to the compiler list */
function doMslCompile(fname)
(
    // Do not accept empty strings
    (strlen(fname) != 0) ? (
        (uuuMslTabs[uuuMslTPt] !== 0) ? (
            // the list is full : refuse the file, rather than replacing a file still waiting
            sprintf(#gfxu, "ERR: 2407    too many files to compile, \"%s\" ignored.", fname);
            mSL_log(SysLogBox, #gfxu);
        ) : (
            0 ? (sprintf(#s, "::About to doMslCompile: \"%s\"", fname); mSL_log(SysLogBox, #s););
            atomic_set(mSL_Lock, max(1,atomic_get(mSL_Lock)));
            uuuMslTabs[uuuMslTPt] = fname; uuuMslTPt = (uuuMslTPt + 1) % uuuMslTSiz;
            atomic_add(mSL_loc_tim,mSL_loc_tadd);
            uuuMslFn = 1; // set flag
        );
    )
);

/* After a compilation attempt (successful or not) : free the compiler's structures,
   keep the lock if other files are waiting (several files dropped : they are compiled next),
   otherwise empty the list and release the lock taken by doMslCompile */
function doMslCompileDone()
local (i)
(
    mSL_bl_clear(mSL_GC_Protected); // free compiler's structures
    i = 0; while ((i < uuuMslTSiz) && (uuuMslTabs[i] === 0)) (i += 1;);
    (i >= uuuMslTSiz) ? (
        uuuMslTPt = uuuMslFn = 0; // the list is empty
        atomic_set(mSL_Lock,  max(0, atomic_get(mSL_Lock) - 1));
    );
);



// The event operations
<? include("GM-Libs/mSL_Events.jsfx-inc"); ?>

// The threads operations
<? include("GM-Libs/mSL_Threads.jsfx-inc"); ?>

// The Garbage Collector
<? include("GM-Libs/mSL_Garbage_Collector.jsfx-inc"); ?>



/*
    Try to understand the why(s) of an error in mSL
*/
function mSL_error_analysis(thrd)
(
    sprintf(#uuu, " _ Thread: %d", thrd);
    mSL_log(SysLogBox, #uuu);
    sprintf(#uuu, " _ Mem avail: %d", mSL_available_memory());
    mSL_log(SysLogBox, #uuu);
);



// The formats array
fFormats = make_array(16);
setFileFormats(fFormats);





mSL_GC_Protected = make_array(1123, mSL_KODE_protect); // Used by the compiler


// Create the scheduler structure
SchedSetup();
//0 ?
(sprintf(#uuu, "SchedSetup :   %d tasks", SchedListSize(SchedFreePts));mSL_log(SysLogBox, #uuu););



// Sizes of Allocated arrays for the Compiler and the Evaluator
C_compSize = 64 * 1024; // size : 64 kW [kilo words, not kilo watts]
C_progSize = 64 * 1024; // size  for the evaluator
ui_jmake_arraymax = 0x7FFFFFF; // "no" limit in the size of an array...

// Then, initialize all structures of the compiler.
C_compArea = make_array(C_compSize);
C_progArea = make_array(C_progSize);

// Création des tableaux
// certains ont un élément de plus pour les copy/paste
PtrsInWA = RD_CNT+1 + WR_CNT+1 + FX_CNT+1 + LN_CNT + 1;
StaticWASize = PtrsInWA + SMPL_SIZE + 1;
StaticWA = make_array(StaticWASize); // ensemble des pointeurs mémoire et cellules
DuplWA = make_array(StaticWASize); // pour load/save des pointeurs mémoire
// protect lines, readers, writers, effects (dynamic blocks) from the garbage collector
mm_usr_prot[mm_usr_prot_ptr] = StaticWA; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = DuplWA; mm_usr_prot_ptr += 1;
AltWAdec = DuplWA - StaticWA; // décalage pour accès aux objets similaires des deux ensembles

sinc_table = make_array(SINC_TABLE_SIZE+2); // // valeurs d'une fonction "sinc"
sinus_table = make_array(SINUS_TABLE_SIZE+2); // Fonction sinus in [0 .. pi/2]

// Remplissage de la table SInc
i__i = 0;
loop(SINC_TABLE_SIZE,
  // On mappe l'index de la table sur la plage [-SINC_RADIUS, SINC_RADIUS]
  i__x = (i__i / SINC_TABLE_SIZE) * 2 * SINC_RADIUS - SINC_RADIUS;
  // Calcul de la fonction SInc
  i__z = 1;
  i__x != 0 ? (i__w = $pi * i__x; i__z = sin(i__w) / (i__w););
  sinc_table[i__i] = i__z;
  i__i += 1;
);

// Remplissage de la table SInus in [0 .. pi/2]
i__i = i__w = 0; i__x = $pi / 2 / SINUS_TABLE_SIZE;
loop(SINUS_TABLE_SIZE + 1,
    sinus_table[i__i] = sin(i__w);
    i__i += 1; i__w += i__x;
);
sinus_table[i__i] = 1;


// Load/Save Area
idx = 0;
SVASIZ = max(idx, 32);
savarea = make_array(SVASIZ); // Load/Save description area
lodarea = make_array(SVASIZ); // Load/Save description area
TMPSIZ = 4;
savtmp = make_array(2 * TMPSIZ); // Work area for load/save of a memory block (two headers : 'ains')
savcode = '1tr6'; // a save code
// Saving doubles in @serialize as two singles : save_mem, load_mem, savwrk (shared, mSL_Serialize.jsfx-inc)
<? include("GM-Libs/mSL_Serialize.jsfx-inc"); ?>
ser_Init();


// Créations des tables d'objets et de cellules
function updt_tables(wa)
(
    Lines_Set = wa;
    Readers_set = Lines_Set + LN_CNT+1;
    Writers_set = Readers_set + RD_CNT+1;
    Effects_set = Writers_set + WR_CNT+1;
    smpl_tab = Effects_set + FX_CNT +1;
);
updt_tables(StaticWA);


//===== CABLES
/*
    Each output of a module (reader, effect) owns a cable : CBL_W cells of the Pool, its only source.
    An output can instead add into a bus (Out, Bus k) : the buses are cleared at each sample.
    An input names its source (kind * ITS_KMul + number, see the ITS_K... kinds) and the first channel taken.
    The cables are allocated by its_Patch_Update (in @gfx) ; the modules compute the cells of their inputs
    and outputs when they are checked (exec_reader, exec_writer, exec_fx), after each change of the patch.
*/
CblRdStart = make_array(RD_CNT + 1); // first cell of the cable of each reader (0 : none)
CblRdWidth = make_array(RD_CNT + 1); // its width (channels)
CblFxStart = make_array(FX_CNT + 1); // first cell of the cable of each effect (0 : none)
CblFxWidth = make_array(FX_CNT + 1); // its width (channels)
CblPool = make_array(CBL_CELLS); // 1 : cell of the Pool used by a cable
// The buses are virtual : a bus used (as an input or an output) gets cells of the Pool, as wide as its users need
BusStart = make_array(NB_BUS); // first cell of each bus (0 : none)
BusWidth = make_array(NB_BUS); // its width (channels)
BusNeed = make_array(NB_BUS); // the width asked by its users (see its_Patch_Scan(-2))
BusAct = make_array(NB_BUS); // the buses that have cells : BusAct[0 ... BusActN-1] (cleared at each sample)
BusActN = 0;
its_PatchV = 0; // version of the patch : changes when a cable is allocated or freed
its_PatchForce = 1; // 1 : check again all the modules (start, preset loaded)

// allocate "w" cells in the Pool (first fit) ; returns the first cell, 0 if no room
function Cbl_Alloc(w)
local (i, n, res)
(
    res = n = i = 0;
    while ((res === 0) && (i < CBL_CELLS)) (
        (CblPool[i] === 0) ? (
            n += 1;
            (n >= w) ? (res = CBL_P + i - w + 1);
        ) : (
            n = 0;
        );
        i += 1;
    );
    (res > 0) ? (
        memset(CblPool + res - CBL_P, 1, w);
        memset(smpl_tab + res, 0, w);
    ) : (
        sprintf(#cblmsg, "Cables : no room for %d channels in the Pool (%d cells)", w, CBL_CELLS);
        mSL_log(SysLogBox, #cblmsg);
    );
    res;
);

// free the "w" cells from "start"
function Cbl_Free(start, w)
(
    (start >= CBL_P) ? (
        memset(CblPool + start - CBL_P, 0, w);
        memset(smpl_tab + start, 0, w);
    );
);

/*
    first cell of the "w" channels taken from the channel "off" of the source "src" (kind * ITS_KMul + number)
    returns 0 for no source, -1 if the source is not valid (unknown, without cable, too narrow)
*/
function its_Src_Cell(src, off, w)
local (k, n, base, bw)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    base = bw = 0;
    (k === ITS_KIn) ? (base = IN_P; bw = CH_NB;) :
    (k === ITS_KOut) ? (base = OUT_P; bw = CH_NB;) :
    ((k === ITS_KBus) && (n < NB_BUS)) ? (base = BusStart[n]; bw = BusWidth[n];) :
    ((k === ITS_KCtl) && (n < NB_CTL)) ? (base = CTL_P + n; bw = NB_CTL - n;) :
    ((k === ITS_KRdr) && (n < RD_CNT)) ? (base = CblRdStart[n]; bw = CblRdWidth[n];) :
    ((k === ITS_KFx) && (n < FX_CNT)) ? (base = CblFxStart[n]; bw = CblFxWidth[n];);
    (src === 0) ? 0 :
    ((base > 0) && (off >= 0) && (w >= 1) && (off + w <= bw)) ? base + off : -1;
);

/*
    first cell of the "w" channels of an output : "dst" 0 is the own cable of the module ("own", "ownw" channels),
    else Out or a bus (with the first channel "off") ; returns -1 if not valid
*/
function its_Out_Cell(dst, off, w, own, ownw)
local (k)
(
    k = floor(dst / ITS_KMul);
    (dst === 0) ? (((own > 0) && (w <= ownw)) ? own : -1) :
    ((k === ITS_KOut) || (k === ITS_KBus)) ? its_Src_Cell(dst, off, w) : -1;
);

/*
    value of a modulation input "p" (its block in a module, see its_Mod_...) multiplied by its depth and its attenuverter ;
    a control cell (slider) is smoothed (time constant about 10 ms) : the cables of the modules are not
*/
its_ModSmK = 1 - exp(-1 / (0.010 * srate));
function its_Mod_Val(p)
local (x)
(
    x = smpl_tab[p[its_Mod_Cell]];
    (p[its_Mod_Ctl]) ? (x = (p[its_Mod_Smooth] += its_ModSmK * (x - p[its_Mod_Smooth])));
    x * p[its_Mod_Depth] * p[its_Mod_Att];
);

// the "n" modulation inputs from "mp" : attenuverters 1 (a new module)
function its_Mod_Init(mp, n)
(
    loop(n, mp[its_Mod_Att] = 1; mp += its_ModDist;);
);

// the "n" modulation inputs from "mp" : the cells read (an invalid source : no modulation) ; returns 1 if a source is not valid
// (called when the module is checked, in @sample)
function its_Mod_Resolve(mp, n)
local (c, bad)
(
    bad = 0;
    loop(n,
        c = its_Src_Cell(mp[its_Mod_Src], mp[its_Mod_Off], 1);
        mp[its_Mod_Cell] = (c > 0) ? c : ZERO_P;
        mp[its_Mod_Ctl] = (floor(mp[its_Mod_Src] / ITS_KMul) === ITS_KCtl);
        (c < 0) ? (bad = 1);
        mp += its_ModDist;
    );
    bad;
);

// the input "j" of "mp" is used : connected, and meaningful ("okm" : mask of the inputs meaningful in the mode of the module)
function its_Mod_Used(mp, j, okm)
(
    (mp[j * its_ModDist + its_Mod_Src] !== 0) && ((okm & (1 << j)) !== 0);
);

// Saturation : the modulation inputs meaningful (drive, bias ; the order or the stretch in the modes x - sin, Chebyshev, Cheb. sum)
function its_Sat_ModOk(fx)
(
    3 | ((fx[its_Efx_Par1 + 1] >= its_SatXSin) ? 4 : 0);
);

// Filter : count of stages (biquads, or one pole filters)
function its_Flt_Stages(fx)
(
    2^max(0, min(its_FltSlopes - 1, floor(fx[its_Efx_Par1 + 3])));
);

// size of the work area of the effect "fx" (0 : none)
function its_Fx_WorkSize(fx)
local (ns)
(
    (fx[its_Efx_Type] === its_Efx_TyFilter) ? (
        ns = its_Flt_Stages(fx);
        its_FxW_Hdr + 5 * ns + 2 * ns * max(1, min(128, floor(fx[its_Efx_CCnt])));
    ) :
    (fx[its_Efx_Type] === its_Efx_TySat) ? (
        its_FxW_Hdr + 5 * 4 + its_SatChW * max(1, min(128, floor(fx[its_Efx_CCnt])));
    ) : 0;
);

// count of sources of an effect type (-1 : a type not executed)
function its_Fx_NSrc(ty)
(
    ((ty === its_Efx_TyMixer) || (ty === its_Efx_TyAutoMix)) ? 8 :
    ((ty === its_Efx_TyFilter) || (ty === its_Efx_TySat)) ? 1 :
    (ty === its_Efx_TyLFO) ? 0 : -1;
);

/*
    Saturation, mode Cheb. sum : sum of hw[k-1] * cos(k * s * acos(fold(u))), k in [1 ... its_SatHarm] ; s = 1 : the sum of
    the Chebyshev polynomials T_k(fold(u)) weighted by hw ; the cosines by the recurrence cos((k+1)p) = 2 cos(p) cos(kp) - cos((k-1)p)
*/
function its_Cheb_Sum(u, s, hw)
local (c1, c0, ck, y, w)
(
    u = 0.25 * (u + 1);
    c1 = max(-1, min(1, 1 - 4 * abs(u - floor(u) - 0.5))); // fold(u)
    (s !== 1) ? (c1 = cos(s * acos(c1)));
    c0 = 1; ck = c1; y = 0;
    loop(its_SatHarm,
        y += hw[0] * ck;
        w = 2 * c1 * ck - c0; c0 = ck; ck = w;
        hw += 1;
    );
    y;
);

// Saturation : the curve of the mode "md" (in [-1, 1], except x - A sin : about 0.5 * u, Cheb. sum : the sum of the |weights|) ;
// n : the order (x - A sin, Chebyshev) or the stretch (Cheb. sum) ; fx : the effect (A, the weights of Cheb. sum)
function its_Sat_Shape(u, md, n, fx)
(
    (md === its_SatSoft) ? (u = max(-20, min(20, u)); 1 - 2 / (exp(2 * u) + 1)) : // tanh
    (md === its_SatHard) ? max(-1, min(1, u)) :
    (md === its_SatFold) ? (u = 0.25 * (u + 1); 1 - 4 * abs(u - floor(u) - 0.5)) : // folds back at -1 and 1
    (md === its_SatXSin) ? 0.5 * (u - fx[its_Efx_Par1 + 8] * sin(0.5 * $pi * n * u)) :
    (md === its_SatCheb) ? (u = 0.25 * (u + 1); cos(n * acos(max(-1, min(1, 1 - 4 * abs(u - floor(u) - 0.5)))))) : // T_n(fold(u))
    (md === its_SatChebSum) ? its_Cheb_Sum(u, n, fx + its_Efx_Harm1) :
    sin(0.5 * $pi * u);
);

// free the work areas of the effect "fx" (deleted)
function its_Fx_WorkFree(fx)
(
    (fx[its_Efx_Work] > BASE_MEMORY) ? mSL_Dyn_Free(fx[its_Efx_Work]);
    (fx[its_Efx_WkNew] > BASE_MEMORY) ? mSL_Dyn_Free(fx[its_Efx_WkNew]);
    (fx[its_Efx_WkOld] > BASE_MEMORY) ? mSL_Dyn_Free(fx[its_Efx_WkOld]);
    fx[its_Efx_Work] = fx[its_Efx_WkNew] = fx[its_Efx_WkOld] = 0;
);

/*
    the work areas of the effects, put in place by @block between two audio blocks : all the @sample of an audio block
    see the same area (prepared by its_Patch_Update in @gfx, which frees the old one at its next frame)
*/
function its_Fx_WorkSwitch()
local (i, b, wn)
(
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        ((b > BASE_MEMORY) && ((wn = b[its_Efx_WkNew]) !== 0)) ? (
            b[its_Efx_WkOld] = b[its_Efx_Work];
            b[its_Efx_Work] = max(0, wn);
            b[its_Efx_WkNew] = 0;
        );
        i += 1;
    );
);

// the inputs of a reader meaningful in its mode : offset (delay mode), speed (reader mode), volume (both)
function its_Rdr_ModOk(rcbl)
(
    4 | ((rcbl[its_Rdr_Mode] === its_RdrMode_Delay) ? 1 : 2);
);

/*
    The module "Patch" : the use of the cells (the cables of the modular)
    its_Patch_Scan(-1) counts the writers (its_PchW) and the readers (its_PchR) of each cell, from the settings of the
    modules (On or Off), and the connections that are not valid (its_PchBad) ; its_Patch_Scan(cell) writes in #its_PchWs
    and #its_PchRs who writes and who reads the cells [cell, cell + its_PchCellW) (the text shown under the pad, for the
    cell under the mouse) ; its_Patch_Scan(-2) computes the width asked for each bus (BusNeed, see its_Patch_Update)
    its_Pch_Use : the connection "code" (source or destination, kind * ITS_KMul + number), first channel "off", resolved
    in the cell "c" (0 : none, -1 : not valid), "w" channels, written (wr = 1) or read
*/
its_PchCellW = 1;
function its_Pch_Use(code, off, c, w, wr, kind, n, role)
local (k)
(
    (its_PchCell === -2) ? (
        k = floor(code / ITS_KMul);
        ((k === ITS_KBus) && ((k = code - k * ITS_KMul) < NB_BUS)) ? (BusNeed[k] = max(BusNeed[k], off + w));
    ) :
    (c < 0) ? (
        (its_PchCell === -1) ? (its_PchBad += 1);
    ) :
    (c > 0) ? (
        (its_PchCell === -1) ? (
            k = c; loop(w, wr ? (its_PchW[k] += 1) : (its_PchR[k] += 1); k += 1;);
        ) :
        ((its_PchCell < c + w) && (its_PchCell + its_PchCellW > c)) ? (
            sprintf(#its_PchTmp, "%s %d %s", kind, n + 1, role);
            wr ? (
                (strlen(#its_PchWs) > 0) ? strcat(#its_PchWs, ", ");
                strcat(#its_PchWs, #its_PchTmp);
            ) : (
                (strlen(#its_PchRs) > 0) ? strcat(#its_PchRs, ", ");
                strcat(#its_PchRs, #its_PchTmp);
            );
        );
    );
);

// the modulation inputs "mp" (n inputs, names "names", meaningful "okm") of the module "kind" n° "num"
function its_Pch_Mods(mp, n, names, okm, kind, num)
local (j, p)
(
    j = 0; loop(n,
        p = mp + j * its_ModDist;
        its_Mod_Used(mp, j, okm) ? its_Pch_Use(p[its_Mod_Src], p[its_Mod_Off], its_Src_Cell(p[its_Mod_Src], p[its_Mod_Off], 1), 1, 0,
            kind, num, names[j]);
        j += 1;
    );
);

function its_Patch_Scan(cell)
local (i, b, w, f, n, ty, p)
(
    its_PchCell = cell;
    (cell === -2) ? (
        memset(BusNeed, 0, NB_BUS);
    ) :
    (cell === -1) ? (
        memset(its_PchW, 0, SMPL_SIZE);
        memset(its_PchR, 0, SMPL_SIZE);
        its_PchBad = 0;
    ) : (
        strcpy(#its_PchWs, "");
        strcpy(#its_PchRs, "");
    );
    i = 0; loop(RD_CNT,
        b = Readers_set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_read)) ? (
            w = max(1, min(128, b[its_Rdr_BfChanUsed]));
            its_Pch_Use(b[its_Rdr_OutK], b[its_Rdr_OutOff],
                its_Out_Cell(b[its_Rdr_OutK], b[its_Rdr_OutOff], w, CblRdStart[i], CblRdWidth[i]), w, 1, "Reader", i, "output");
            its_Pch_Mods(b + its_Rdr_Mod1, 3, its_ModN_Rdr, its_Rdr_ModOk(b), "Reader", i);
        );
        i += 1;
    );
    i = 0; loop(WR_CNT,
        b = Writers_set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_writ)) ? (
            f = max(0, min(b[its_Wrt_ChNbr] - 1, b[its_Wrt_Bf1stChan]));
            n = b[its_Wrt_ChNbr] - f;
            (b[its_Wrt_BfChanUsed] > 0) ? (n = min(n, b[its_Wrt_BfChanUsed]));
            (n > 0) ? its_Pch_Use(b[its_Wrt_Src], b[its_Wrt_SrcOff], its_Src_Cell(b[its_Wrt_Src], b[its_Wrt_SrcOff], n), n, 0,
                "Writer", i, "input");
            its_Pch_Mods(b + its_Wrt_Mod1, 2, its_ModN_Wrt, 3, "Writer", i);
        );
