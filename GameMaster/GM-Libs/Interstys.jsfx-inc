function exec_math(fx, ccnt, out)
local (wk, hd, cw, op, sa, sb, bs, ga, gb, va, am, off, ka, kr, c, a, b, x, y, p, mp)
(
    wk = fx[its_Efx_Work];
    ((wk > BASE_MEMORY) && (wk[its_FxW_Size] === its_Fx_WorkSize(fx))) ? (
        hd = wk + its_FxW_Hdr; cw = hd + its_MtH;
        (wk[its_FxW_Md] !== 1) ? (
            memset(cw, 0, its_MtCW * ccnt);
