            its_Tb_ptr += 1; its_Tb_si = its_Tb_tbl[its_Tb_ptr];
            its_Tb_scope = its_SPK[its_Tb_si]; its_Tb_setm = 1;
        ) :
        (w === its_TbM_SetEnd) ? (
            (its_Tb_mode === 3) ? (its_Tb_spend = its_Tb_si); // the arguments are recorded (its_Al_Flush)
            its_Tb_scope = 0; its_Tb_setm = 0;
        ) :
        (w === its_TbM_Chg) ? ( its_Tb_chg = 1; );
        its_Tb_ptr += 1; w = its_TK_End;
    );
    w;
);

function its_Tb_Next() local(w)
(
    w = its_Tb_Peek();
    (its_Tb_ptr < its_Tb_itc) ? (its_Tb_ptr += 1);
    w;
);

// the first error stops the analysis
function its_Tb_Err(code, msg)
(
    (its_Tb_error === 0) ? (
        its_Tb_error = code;
        sprintf(#its_TbMsg, "ERR: %04d    Interstys table (word %d) : %s", code, its_Tb_ptr, msg);
        mSL_log(SysLogBox, #its_TbMsg);
    );
);

function its_Tb_IsName(w) local(i, r)
(
    r = (w > mSL_Sym_Low) && (w < mSL_Sym_High);
    i = 0; while (r && (i < its_TK_Cnt)) ( (its_TK_List[i] === w) ? (r = 0); i += 1; );
    r;
);

// a header ends the current block
function its_Tb_IsHead(w)
(
    (w === its_TK_Clear) || (w === its_TK_Line) || (w === its_TK_Writer) || (w === its_TK_Reader)
        || (w === its_TK_Effect) || (w === its_TK_Global) || (w === its_TK_Dump) || (w === its_TK_Check)
        || (w === its_TK_Free) || (w === its_TK_End) || (w === its_TK_EofMark) || (w === its_TK_Algorithm)
        || (w === its_TK_Instance) || (w === its_TK_Set) || (w === its_TK_Curve) || (w === its_TK_Display) || (w === its_TK_Remove)
        || (w === its_TK_Control) || (w === its_TK_Export) || (w === its_TK_Tab) || (w === its_TK_View);
);

// a number in [vmin, vmax] (a "-" word before it changes its sign) ; Undef and an error otherwise
function its_Tb_Num(key, vmin, vmax) local(w, s)
(
    s = 1;
    ((w = its_Tb_Next()) === mSL_cstMinus) ? ( s = -1; w = its_Tb_Next(); );
    (abs(w) < mSL_CharConst) ? (w *= s);
    ((abs(w) < mSL_CharConst) && (w >= vmin) && (w <= vmax)) ? w : (
        sprintf(#its_TbW, "%s : %s is not a value in [%g, %g]", key, mSL_edit_value(#its_TbV, w), vmin, vmax);
        its_Tb_Err(2754, #its_TbW);
        Undef;
    );
);

function its_Tb_Int(key, vmin, vmax) local(v)
(
    v = its_Tb_Num(key, vmin, vmax);
    ((its_Tb_error === 0) && (v !== floor(v))) ? (
        sprintf(#its_TbW, "%s : %g is not an integer", key, v);
        its_Tb_Err(2754, #its_TbW);
    );
    v;
);

// one of the "n" symbols of "syms" : its index
function its_Tb_Enum(key, syms, n) local(w, i, k)
(
    w = its_Tb_Next();
    k = -1; i = 0; while ((k < 0) && (i < n)) ( (syms[i] === w) ? (k = i); i += 1; );
    (k < 0) ? (
        sprintf(#its_TbW, "%s : %s is not a possible value", key, mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2754, #its_TbW);
    );
    k;
);

function its_Tb_KeyErr(w, blk)
(
    sprintf(#its_TbW, "%s : unknown key %s", blk, mSL_edit_value(#its_TbV, w));
    its_Tb_Err(2753, #its_TbW);
);

function its_Tb_TyName(ty)
(
    (ty === its_TK_Line) ? "Line" : (ty === its_TK_Writer) ? "Writer" : (ty === its_TK_Reader) ? "Reader" : "Effect";
);

function its_Tb_Count(ty)
(
    (ty === its_TK_Line) ? LN_CNT : (ty === its_TK_Writer) ? WR_CNT : (ty === its_TK_Reader) ? RD_CNT : FX_CNT;
);

// the first entry of the type "ty" in its_TbResv
function its_Tb_RBase(ty)
(
    (ty === its_TK_Line) ? 0 : (ty === its_TK_Writer) ? LN_CNT : (ty === its_TK_Reader) ? LN_CNT + WR_CNT : LN_CNT + WR_CNT + RD_CNT;
);

// the module "i" of the type "ty" exists in the simulation
function its_Tb_SimEx(ty, i)
(
    (ty === its_TK_Line) ? (its_TbSimSp[i] > 0) : (ty === its_TK_Writer) ? its_TbSimWE[i] : (ty === its_TK_Reader) ? its_TbSimRE[i] :
        its_TbSimFE[i];
);

// the name "w" in the current scope (its_Tb_scope) : its entry, or -1
function its_Tb_Find(w) local(i, k)
(
    k = -1; i = 0;
    while ((k < 0) && (i < its_TbNCnt)) ( ((its_TbNSym[i] === w) && (its_TbNScp[i] === its_Tb_scope)) ? (k = i); i += 1; );
    k;
);

/*
    the module of type "ty" designated by the word "w" : 0 ... count-1 ; -1 after an error ;
    -2 for a name which has no module yet (passes 0 and 1) ; "head" : 1 in the header of a block ;
    "instance:name" (a name after the colon ; a number : the first channel of a source) : the module "name" of the
    instance (recorded, or created by this table : the names of the table in its scope, else those kept with it)
*/
function its_Tb_Id(ty, w, head) local(k, i, n, rb, nm, ki, b)
(
    k = -1;
    its_Tb_idLocal = 0; // 1 : a name of an instance (its module belongs to the instance : its_Tb_own)
    n = its_Tb_Count(ty);
    ((w === floor(w)) && (w >= 1) && (w <= n)) ? (
        k = w - 1;
    ) :
    // (the word itself, not its_Tb_Peek : after the last word of an instance or of an argument, its_Tb_Peek would pass the
    // marker that ends it and change the scope before the name is looked up)
    (its_Tb_IsName(w) && (its_Tb_ptr + 1 < its_Tb_itc) && (its_Tb_tbl[its_Tb_ptr] === its_TK_Colon)
        && its_Tb_IsName(its_Tb_tbl[its_Tb_ptr + 1])) ? (
        its_Tb_Next(); nm = its_Tb_Next();
        ki = -1; i = 1; while ((ki < 0) && (i <= its_InsMx)) ( (its_InsSym[i] === w) ? (ki = i); i += 1; );
        i = 0; while ((ki < 0) && (i < its_IPCnt)) ( (its_IPN[i] === w) ? (ki = its_IPK[i]); i += 1; );
        i = 0; while ((k < 0) && (ki > 0) && (i < its_TbNCnt)) (
            ((its_TbNSym[i] === nm) && (its_TbNScp[i] === ki) && (its_TbNTyp[i] === ty)) ? (k = its_TbNIdx[i]);
            i += 1;
        );
        ((k < 0) && (ki > 0) && ((b = its_InsNam[ki]) > BASE_MEMORY)) ? (
            i = 0; while ((k < 0) && (i < its_InsNCnt[ki])) ( ((b[3 * i] === nm) && (b[3 * i + 1] === ty)) ? (k = b[3 * i + 2]); i += 1; );
        );
        (k < 0) ? (
            (its_Tb_mode <= 1) ? ( k = -2; ) : ( // (an instance of this table : its modules are named in pass 1)
                sprintf(#its_TbW, (ki < 0) ? "unknown instance %s (in %s:%s)" : "the instance %s has no %s named %s",
                    mSL_edit_value(#its_TbV, w), (ki < 0) ? mSL_edit_value(#its_TbV1, w) : its_Tb_TyName(ty), mSL_edit_value(#its_TbV2, nm));
                its_Tb_Err(2757, #its_TbW);
            );
        );
    ) :
    its_Tb_IsName(w) ? (
        ((i = its_Tb_Find(w)) >= 0) ? (
            (its_TbNTyp[i] === ty) ? (
                k = its_TbNIdx[i];
                its_Tb_idLocal = (its_Tb_scope > 0);
            ) : (
                sprintf(#its_TbW, "%s is not a %s", mSL_edit_value(#its_TbV, w), its_Tb_TyName(ty));
                its_Tb_Err(2756, #its_TbW);
            );
        ) :
        ((its_Tb_mode === 0) || ((its_Tb_mode === 1) && !head)) ? (
            k = -2;
        ) :
        (its_Tb_mode === 1) ? (
            // a free module, that no number of the table designates
            rb = its_Tb_RBase(ty);
            i = 0; while ((k < 0) && (i < n)) ( ((its_Tb_SimEx(ty, i) == 0) && (its_TbResv[rb + i] === 0)) ? (k = i); i += 1; );
            (k < 0) ? (
                sprintf(#its_TbW, "no free %s for %s", its_Tb_TyName(ty), mSL_edit_value(#its_TbV, w));
                its_Tb_Err(2755, #its_TbW);
            ) :
            (its_TbNCnt >= its_TbNSz) ? (
                k = -1;
                its_Tb_Err(2762, "too many names");
            ) : (
                its_TbNSym[its_TbNCnt] = w; its_TbNTyp[its_TbNCnt] = ty; its_TbNIdx[its_TbNCnt] = k;
                its_TbNScp[its_TbNCnt] = its_Tb_scope;
                its_TbNCnt += 1;
                its_TbResv[rb + k] = 1;
                its_Tb_idLocal = (its_Tb_scope > 0);
                (its_Tb_scope > 0) ? (
                    sprintf(#its_TbW, "Interstys table : %s = %s %d (instance %d)", mSL_edit_value(#its_TbV, w), its_Tb_TyName(ty), k + 1,
                        its_Tb_scope);
                ) : (
                    sprintf(#its_TbW, "Interstys table : %s = %s %d", mSL_edit_value(#its_TbV, w), its_Tb_TyName(ty), k + 1);
                );
                mSL_log(SysLogBox, #its_TbW);
            );
        ) : (
            sprintf(#its_TbW, "unknown name %s", mSL_edit_value(#its_TbV, w));
            its_Tb_Err(2757, #its_TbW);
        );
    ) : (
        sprintf(#its_TbW, "%s : bad identifier %s (1 ... %d, or a name)", its_Tb_TyName(ty), mSL_edit_value(#its_TbV, w), n);
        its_Tb_Err(2752, #its_TbW);
    );
    k;
);

// the type of module named by the word "w" (Line, Writer, Reader, Effect), or 0 and an error
function its_Tb_Type(w, what)
(
    ((w === its_TK_Line) || (w === its_TK_Writer) || (w === its_TK_Reader) || (w === its_TK_Effect)) ? w : (
        sprintf(#its_TbW, "%s : %s is not Line, Writer, Reader or Effect", what, mSL_edit_value(#its_TbV, w));
        its_Tb_Err(2751, #its_TbW);
        0;
    );
);

// the modules as they are now, for the simulation
function its_Tb_SimInit() local(i, b)
(
    i = 0; loop(LN_CNT,
        b = Lines_Set[i];
        ((b > BASE_MEMORY) && (b[-2] === KW_lcbl)) ? (
            its_TbSimSp[i] = b[its_Lin_SmplCnt]; its_TbSimCh[i] = b[its_Lin_ChCnt]; its_TbSimLO[i] = b[its_Lin_Owner];
        ) : (
            its_TbSimSp[i] = its_TbSimCh[i] = its_TbSimLO[i] = 0;
        );
        i += 1;
    );
    i = 0; loop(WR_CNT,
        b = Writers_set[i];
        (its_TbSimWE[i] = ((b > BASE_MEMORY) && (b[-2] === KW_writ))) ? (
            its_TbSimWL[i] = b[its_Wrt_LineNb]; its_TbSimWO[i] = b[its_Wrt_Owner];
        ) : (
            its_TbSimWL[i] = -1; its_TbSimWO[i] = 0;
        );
        i += 1;
    );
    i = 0; loop(RD_CNT,
        b = Readers_set[i];
        its_TbSimRO[i] = (its_TbSimRE[i] = (b > BASE_MEMORY) && (b[-2] === KW_read)) ? b[its_Rdr_Owner] : 0;
        i += 1;
    );
    i = 0; loop(FX_CNT,
        b = Effects_set[i];
        its_TbSimFT[i] = (its_TbSimFE[i] = ((b > BASE_MEMORY) && (b[-2] === KW_effx))) ? b[its_Efx_Type] : 0;
        its_TbSimFO[i] = its_TbSimFE[i] ? b[its_Efx_Owner] : 0;
        i += 1;
    );
);

// a reader of line "k" which uses channels beyond "nch" : its number + 1, or 0
function its_Tb_ChUser(k, nch) local(i, r, u)
(
    u = 0; i = 0;
    while ((u === 0) && (i < RD_CNT)) (
        (((r = Readers_set[i]) > BASE_MEMORY) && (r[-2] === KW_read) && (r[its_Rdr_LineNb] === k)
            && (r[its_Rdr_Bf1stChan] + r[its_Rdr_BfChanUsed] > nch)) ? (u = i + 1);
        i += 1;
    );
    u;
);

// the line "lnum" was replaced by Ln_Make : its writers and readers take the new line and keep their settings
function Ln_Rebind(lnum)
local (lcbl, i, j, r, w, d)
(
    lcbl = Lines_Set[lnum];
    i = 0; loop(WR_CNT,
        (((w = Writers_set[i]) > BASE_MEMORY) && (w[-2] === KW_writ) && (w[its_Wrt_LineNb] === lnum)) ? (
            Wr_Set_Line(i, lnum); // (the delay readers follow : Wr_Followers)
        );
        i += 1;
    );
    i = 0; loop(RD_CNT,
        (((r = Readers_set[i]) > BASE_MEMORY) && (r[-2] === KW_read) && (r[its_Rdr_LineNb] === lnum)
            && its_Rd_Lined(r[its_Rdr_Mode])) ? (
            r[its_Rdr_Check] = 0; // first : @sample checks the reader again (exec_reader)
            r[its_Rdr_Lcbl] = lcbl;
            r[its_Rdr_SmplCnt] = lcbl[its_Lin_SmplCnt];
            r[its_Rdr_SmplCntSec] = d = lcbl[its_Lin_SmplCntSec];
            r[its_Rdr_ChNbr] = lcbl[its_Lin_ChCnt];
            r[its_Rdr_Start] = lcbl[its_Lin_Start];
            r[its_Rdr_Low] = r[its_Rdr_Start] - B_FADESIZ;
            r[its_Rdr_Last] = lcbl[its_Lin_Last];
            r[its_Rdr_High] = r[its_Rdr_Last] + B_FADESIZ;
            r[its_Rdr_LinSfreq] = lcbl[its_Lin_RecFreq];
            r[its_Rdr_AdjInc] = lcbl[its_Lin_RecFreq] / srate;
            j = 0; loop(its_RdrMaxMulti,
                r[its_Rdr_Abspos + j] = min(max(r[its_Rdr_Abspos + j], r[its_Rdr_Start]), r[its_Rdr_Last] - 1);
                j += 1;
            );
            // the region in the new length, recomputed by Rd_Update
            r[its_Rdr_RegSizeSec] = min(r[its_Rdr_RegSizeSec], d);
            r[its_Rdr_RegPosSec] = min(r[its_Rdr_RegPosSec], d);
            r[its_Rdr_RegSizeSecPrv] = r[its_Rdr_RegPosSecPrv] = -1;
            r[its_Rdr_StJ] = -1; // (mode Stretch : starts again from its position, its blocks were in the old line)
            Rd_Update(i);
            r[its_Rdr_Check] = 0;
        );
        i += 1;
    );
    rdupdt = lnupdt = 1;
);

/*
    Read the sound file "fname" into the line "lnb" : the line is created, or replaced if its size or its channels differ
    (its writers and readers follow, Ln_Rebind) ; it keeps the name of the file (its_LnFile) ; runs in @gfx
    Result : 0, or an error (logged) : 2771 the file can't be opened, 2772 not a sound file for a line (channels not in
    [1, 128], frequency not in [2400, 384000], too short, more than 67108864 samples), 2773 read error (the line is then
    not the file : its name is cleared), 2610 not enough memory (logged by Ln_Make) ; except for 2773, the line is unchanged
*/
function Ln_Load_File(lnb, fname)
local (fh, cc, fr, fsz, nfr, lcbl, err, wasold, bread, ptbuf, bcnt, rdcnt, i, c, pb, addbuffs)
(
    err = cc = fr = nfr = 0;
    ((fh = file_open(fname)) < 0) ? (
        err = 2771;
    ) : (
        file_riff(fh, cc, fr);
        ((cc < 1) || (cc > 128) || (fr < 2400) || (fr > 384000)) ? (err = 2772) : (
            fsz = file_avail(fh);
            nfr = floor(fsz / cc);
            ((fsz <= 480) || (nfr > 67108864)) ? (err = 2772);
        );
    );
    (err === 0) ? (
        lcbl = Lines_Set[lnb];
        wasold = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
        // the same size and channels : the line is kept ; otherwise, a new one ((nfr - 0.5) / srate gives nfr samples)
        (!wasold || (lcbl[its_Lin_SmplCnt] !== nfr) || (lcbl[its_Lin_ChCnt] !== cc)) ? (
            ((lcbl = Ln_Make(lnb, srate, (nfr - 0.5) / srate, cc)) <= BASE_MEMORY) ? (err = 2610); // (logged by Ln_Make)
        );
    );
    (err === 0) ? (
        // read by blocks of BFFSIZ samples, dispatched in the channels buffers
        bread = 0; ptbuf = BF_LIM; bcnt = cc * floor(BFFSIZ / cc);
        addbuffs = lcbl + its_Lin_BF1ST;
        fsz = nfr * cc;
        while (bread < fsz) (
            rdcnt = min(bcnt, fsz - bread);
            (file_mem(fh, savwrk, rdcnt) != rdcnt) ? (
                err = 2773;
                bread = fsz;
            ) : (
                i = 0; while (i < rdcnt) (
                    c = 0; loop(cc, pb = addbuffs[c]; pb[ptbuf] = savwrk[i + c]; c += 1;);
                    i += cc; ptbuf += 1;
                );
                bread += rdcnt;
            );
        );
    );
    (err === 0) ? (
        lcbl[its_Lin_RecFreq] = lcbl[its_Lin_Tmp2] = fr;
        lcbl[its_Lin_Used] = nfr + BF_LIM;
        // duplicate the start and the end samples around the buffers (as File_Handle)
        c = 0; loop(cc,
            pb = addbuffs[c];
            memcpy(pb, pb + nfr, BF_LIM);
            memcpy(pb + nfr + BF_LIM, pb + BF_LIM, BF_LIM);
            c += 1;
        );
        strcpy(its_LnFile[lnb], fname);
        wasold ? Ln_Rebind(lnb); // (the frequency of the file, a new block)
        lnupdt = 1;
    ) :
    (err !== 2610) ? (
        (err === 2773) ? strcpy(its_LnFile[lnb], ""); // (the line is not the file)
        sprintf(#its_LnFMsg, "ERR: %04d    Line %d : %s \"%s\"", err, lnb + 1,
            (err === 2771) ? "can't open" : (err === 2772) ? "not a sound file for a line :" : "read error in", fname);
        mSL_log(SysLogBox, #its_LnFMsg);
    );
    (fh >= 0) ? file_close(fh);
    err;
);

/*
    The folder of the project (#its_PrjDir, its_PrjSt = 2 when it is known) : asked to GMAuxiliary.eel (command 21), the answer
    is in the exploded gmem string (getexpldstr) ; its_PrjDir_Poll runs at each frame of @gfx ; its_PrjSt : 0 to ask, 1 asked
    (at its_PrjRq), 2 known, 3 GMAuxiliary.eel absent or busy (asked again 2 s later)
*/
its_PrjSt = 0; its_PrjRq = 0; #its_PrjDir = "";
function its_PrjDir_Poll()
local (t)
(
    t = time_precise() + timeD;
    (its_PrjSt === 0) ? (
        ((gmem[versionGMScript] != 0) && (gmem[dateDone] >= gmem[dateCfrm])) ? (
            gmem[cmndKode] = 21;
            gmem[dateRqst] = gmem[dateCfrm] = its_PrjRq = t; // (the dates last : the script starts on them)
            its_PrjSt = 1;
        ) : (
            its_PrjSt = 3; its_PrjRq = t;
        );
    ) :
    (its_PrjSt === 1) ? (
        (gmem[dateDone] > its_PrjRq) ? (
            getexpldstr(#its_PrjDir, 0);
            (strlen(#its_PrjDir) > 0) ? (
                its_PrjSt = 2;
                sprintf(#its_LnFMsg, "Project folder : %s", #its_PrjDir);
                mSL_log(SysLogBox, #its_LnFMsg);
            ) : (
                its_PrjSt = 3; its_PrjRq = t;
            );
        ) :
        (t - its_PrjRq > 5) ? (
            its_PrjSt = 3; its_PrjRq = t;
        );
    ) :
    ((its_PrjSt === 3) && (t - its_PrjRq > 2)) ? (
        its_PrjSt = 0;
    );
);

/*
    After a load (its_Load_Install : the lines are saved without their samples), the lines which had a file read it again :
    one line per frame of @gfx ; an error is logged (Ln_Load_File) and the line keeps the name of its file ("Reload")
*/
its_LnRldPend = its_LnRldIdx = its_LnRldOk = its_LnRldErr = 0;
function its_Ln_AutoReload()
local (k)
(
    (its_LnRldPend) ? (
        k = its_LnRldIdx;
        while ((k < LN_CNT) && (strlen(its_LnFile[k]) === 0)) ( k += 1; );
        (k < LN_CNT) ? (
            strcpy(#its_LnFTmp, its_LnFile[k]); // (Ln_Load_File writes its_LnFile)
            (Ln_Load_File(k, #its_LnFTmp) === 0) ? (its_LnRldOk += 1) : (its_LnRldErr += 1);
            its_LnRldIdx = k + 1;
        ) : (
            its_LnRldPend = 0;
            ((its_LnRldOk + its_LnRldErr) > 0) ? (
                sprintf(#its_LnFMsg, "Lines : %d file(s) read again, %d error(s)", its_LnRldOk, its_LnRldErr);
                mSL_log(SysLogBox, #its_LnFMsg);
            );
        );
    );
);

// the file "name" in "str" : as is if it is absolute, otherwise in the folder of the project ; 0 if this folder is unknown
function its_Path(str, name)
local (c0)
(
    c0 = str_getchar(name, 0, 'cu');
    ((c0 === '/') || (c0 === '\\') || (str_getchar(name, 1, 'cu') === ':')) ? (
        strcpy(str, name);
    ) :
    (its_PrjSt === 2) ? (
        strcpy(str, #its_PrjDir);
        strcat(str, (str_getchar(#its_PrjDir, 1, 'cu') === ':') ? "\\" : "/");
        strcat(str, name);
    ) : 0;
);

// the instance "k" of an algorithm is forgotten (its modules are not deleted)
function its_Al_InsDrop(k)
(
    (its_InsTpl[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_InsTpl[k]);
    (its_InsArg[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_InsArg[k]);
    (its_InsNam[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_InsNam[k]);
    its_InsSym[k] = its_InsAName[k] = its_InsTpl[k] = its_InsArg[k] = its_InsNam[k] = 0;
    its_InsTLen[k] = its_InsALen[k] = its_InsNCnt[k] = 0;
);

//—— Exports (1) : the names in the text of a module, where its text goes (the exports themselves : "Exports (2)", below)
/*
    The Dumps (its_Tb_DumpLine, its_Tb_DumpMod, its_Tb_DumpFx, its_Crv_Dump, its_Tb_DumpGlobal) also write the exported scripts.
    its_Xp_On : the modules in their text : 0 by their numbers ; 1 a patch, by the names of its_XpNm (the ports In:c and Out:c : in1,
    out1..., the curves without a name get one) ; 2 a session, by their numbers, "instance:name" for a module of an instance
    its_Xp_Sink : the lines : 0 in the log ; 1 nowhere (the first pass of a patch : the ports, the curves, the controls, the buses
    it uses) ; 2 in the text of the file (xpt_Block, its_Xp_Ind spaces before)
*/
its_Xp_On = its_Xp_Sink = 0;
its_Xp_Ind = 4;
/*
    its_XpShow : what a patch shows when it is read (Global display, the module "Scripts" ; saved with the project) : the blocks
    Display of an instance are its "essential" modules ; 0 None : nothing (only the structures are created) ; 1 Essential :
    they are shown ; 2 All : they are shown, then all the modules of the instances of the table (its_Tb_ShowAll). A table that
    describes the tabs (a session, Tab blocks : its_Tb_hasTab) shows nothing, its blocks Tab and View place the modules.
    A module is shown in the current tab, else in the next tabs (its_Mod_Show : its_ShowMax modules at most in a pane).
*/
its_XpShow = 1;
its_ShowMax = 8;
its_Tb_hasTab = 0;

// the block of the module "k" of the type "ty" : 0 if it does not exist
function its_Xp_Blk(ty, k) local(b)
(
    ((k < 0) || (k >= its_Tb_Count(ty))) ? 0 : (
        b = (ty === its_TK_Line) ? Lines_Set[k] : (ty === its_TK_Writer) ? Writers_set[k] : (ty === its_TK_Reader) ? Readers_set[k] : Effects_set[k];
        ((b > BASE_MEMORY) && (b[-2] === ((ty === its_TK_Line) ? KW_lcbl : (ty === its_TK_Writer) ? KW_writ : (ty === its_TK_Reader) ? KW_read : KW_effx))) ? b : 0;
    );
);

// the instance that owns the module "b" ; 0 : none (or an instance that does not exist any more)
function its_Xp_Owner(ty, b) local(o)
(
    o = (ty === its_TK_Line) ? b[its_Lin_Owner] : (ty === its_TK_Writer) ? b[its_Wrt_Owner] : (ty === its_TK_Reader) ? b[its_Rdr_Owner] : b[its_Efx_Owner];
    ((o > 0) && (o <= its_InsMx) && (its_InsSym[o] !== 0)) ? o : 0;
);

// the name that the module "k" of the instance "o" has in it : its symbol, or 0
function its_Xp_InsName(o, ty, k) local(n, i, s)
(
    s = 0;
    ((n = its_InsNam[o]) > BASE_MEMORY) ? (
        i = 0; while ((s === 0) && (i < its_InsNCnt[o])) (
            ((n[3 * i + 1] === ty) && (n[3 * i + 2] === k)) ? (s = n[3 * i]);
            i += 1;
        );
    );
    s;
);

// the module "k" of the type "ty" in the text of a block (see its_Xp_On) ; "str"
function its_Xp_Ref(str, ty, k) local(b, o, n)
(
    n = 0;
    (its_Xp_On === 1) ? (
        ((n = its_XpNm[its_Tb_RBase(ty) + k]) !== 0) ? mSL_edit_value(str, n);
    ) :
    (its_Xp_On === 2) ? (
        (((b = its_Xp_Blk(ty, k)) !== 0) && ((o = its_Xp_Owner(ty, b)) > 0) && ((n = its_Xp_InsName(o, ty, k)) !== 0)) ?
            sprintf(str, "%s:%s", mSL_edit_value(#its_XpV1, its_InsSym[o]), mSL_edit_value(#its_XpV2, n));
    );
    (n === 0) ? sprintf(str, "%d", k + 1);
    str;
);

// the path of a file in a script : relative if it is in the folder of the project
function its_Xp_RelP(path) local(l, c)
(
    l = strlen(#its_PrjDir);
    ((its_PrjSt === 2) && (l > 0) && (strncmp(path, #its_PrjDir, l) === 0)
        && (((c = str_getchar(path, l, 'cu')) === '/') || (c === '\\'))) ? strcpy_from(#its_XpP, path, l + 1) : strcpy(#its_XpP, path);
    #its_XpP;
);

// a patch : the name of the port In:c (kd 0) or Out:c (kd 1) in "str" : 1 ; 0 : it has no name (too many ports : it stays as it is) ;
// the first pass gives the names
function its_Xp_Port(str, kd, c) local(i, f, n)
(
    f = -1; i = 0;
    while ((f < 0) && (i < its_XpPtN)) ( ((its_XpPtK[i] === kd) && (its_XpPtC[i] === c)) ? (f = i); i += 1; );
    ((f < 0) && (its_Xp_Sink === 1) && (its_XpPtN < its_XpPtMx)) ? (
        n = 1; i = 0; loop(its_XpPtN, (its_XpPtK[i] === kd) ? (n += 1); i += 1;);
        f = its_XpPtN;
        its_XpPtK[f] = kd; its_XpPtC[f] = c; its_XpPtI[f] = n;
        its_XpPtS[f] = mSL_symbol(sprintf(#its_XpV1, kd ? "out%d" : "in%d", n));
        its_XpPtN += 1;
    );
    (f >= 0) ? ( sprintf(str, kd ? "out%d" : "in%d", its_XpPtI[f]); 1; ) : 0;
);

// a source "nm" (Reader, Effect) : the module "n", its channel "off" ; a patch : "none" if the module does not exist
function its_Xp_SrcMod(str, nm, ty, n, off)
(
    ((its_Xp_On === 1) && (its_Xp_Blk(ty, n) === 0)) ? strcpy(str, "none") : (
        its_Xp_Ref(#its_XpR, ty, n);
        (off > 0) ? sprintf(str, "%s %s:%d", nm, #its_XpR, off) : sprintf(str, "%s %s", nm, #its_XpR);
    );
);

// the space before a pair "key value" of a block : two in a file (as the recipes : the lines are cut between two pairs)
function its_Xp_Sep() ( (its_Xp_Sink === 2) ? "  " : " "; );

// the text of a block : see its_Xp_Sink
function its_Tb_Out(str)
(
    (its_Xp_Sink === 0) ? mSL_log(SysLogBox, str) :
    (its_Xp_Sink === 2) ? xpt_Block(str, its_Xp_Ind);
);

function its_Tb_Clear() local(k, all, p)
(
    all = (its_Tb_Peek() === its_TK_All);
    all ? its_Tb_Next();
    (its_Tb_mode === 3) ? (
        its_actions(its_GlAct_DelAll);
        k = 1; loop(its_InsMx, (its_InsSym[k] !== 0) ? its_Al_InsDrop(k); k += 1;); // (their modules are deleted)
        all ? (
            // Clear All : also the templates, the curves (no module uses them any more), the values of the controls
            k = 0; loop(its_AlgMx,
                (its_AlgBlk[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_AlgBlk[k]);
                its_AlgSym[k] = its_AlgBlk[k] = its_AlgLen[k] = 0;
                k += 1;
            );
            k = 0; loop(its_CrvMx,
                (its_CrvBlk[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_CrvBlk[k]);
                its_CrvBlk[k] = 0; strcpy(its_CrvNm[k], "");
                k += 1;
            );
            its_CrvSelK = its_CrvUndoK = its_CrvPreK = -1; its_CrvDrag = 0;
            k = 0; loop(its_CrvEdN, p = its_CrvEd + k * its_CrvEdSz; p[11] = -1; p[3] = 0; k += 1;);
            k = 0; loop(NB_GSL, (its_Ctl_Get(k) !== 0) ? its_Ctl_Set(k, 0); k += 1;);
        );
    ) : (
        memset(its_TbSimSp, 0, LN_CNT); memset(its_TbSimCh, 0, LN_CNT);
        memset(its_TbSimWE, 0, WR_CNT); memset(its_TbSimRE, 0, RD_CNT);
        memset(its_TbSimFE, 0, FX_CNT); memset(its_TbSimFT, 0, FX_CNT);
        its_Tb_clr = 1; // no more readers
        all ? ( k = 0; loop(its_CrvMx, its_CrvSimU[k] = 0; strcpy(its_CrvSimN[k], ""); k += 1;); );
    );
);

//—— Lines
// "file" : the path of the file in #its_TbFile (its_Path), its channels and its samples in its_Tb_fcc, its_Tb_fnfr ;
// 0 and an error if it can't be read
function its_Tb_File(name) local(fh, cc, fr, ok)
(
    ok = 0;
    !mSL_isString(name) ? (
        sprintf(#its_TbW, "file : %s is not a string", mSL_edit_value(#its_TbV, name));
        its_Tb_Err(2754, #its_TbW);
    ) :
    (its_Path(#its_TbFile, name) === 0) ? (
        (its_PrjSt === 3) ? (its_PrjSt = 0); // (asked again)
        sprintf(#its_TbW, "file \"%s\" : the folder of the project is unknown (GMAuxiliary.eel)", name);
        its_Tb_Err(2769, #its_TbW);
    ) :
    ((fh = file_open(#its_TbFile)) < 0) ? (
        sprintf(#its_TbW, "file \"%s\" : can't be opened", #its_TbFile);
        its_Tb_Err(2770, #its_TbW);
    ) : (
        cc = fr = 0;
        file_riff(fh, cc, fr);
        its_Tb_fcc = cc; its_Tb_fnfr = floor(file_avail(fh) / max(1, cc));
        file_close(fh);
        ((cc < 1) || (cc > 128) || (fr < 2400) || (fr > 384000) || (its_Tb_fnfr * cc <= 480) || (its_Tb_fnfr > 67108864)) ? (
            sprintf(#its_TbW, "file \"%s\" : %d channels, %d Hz, %d samples : not a sound file for a line", #its_TbFile, cc, fr, its_Tb_fnfr);
            its_Tb_Err(2770, #its_TbW);
        ) : (
            ok = 1;
        );
    );
    ok;
);

function its_Tb_Line() local(w, k, len, ch, spl, sp, cc, nsp, nch, lcbl, u, r, fil, err, own)
(
    k = its_Tb_Id(its_TK_Line, its_Tb_Next(), 1);
    own = its_Tb_idLocal ? its_Tb_scope : 0; // a line of an instance
    len = ch = spl = -1; fil = 0;
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        its_Tb_chg = 0;
        (w === its_TK_length) ? ( len = its_Tb_Num("length", 0.001, 67108864 / srate); (its_Tb_setm && !its_Tb_chg) ? (len = -1); ) :
        (w === its_TK_chan) ? ( ch = its_Tb_Int("chan", 1, 128); (its_Tb_setm && !its_Tb_chg) ? (ch = -1); ) :
        (w === its_TK_spls) ? ( spl = its_Tb_Int("spls", 48, 67108864); (its_Tb_setm && !its_Tb_chg) ? (spl = -1); ) :
        (w === its_TK_freq) ? ( its_Tb_Num("freq", 2400, 384000); ) :
        (w === its_TK_status) ? ( its_Tb_Next(); ) :
        (w === its_TK_file) ? ( fil = its_Tb_Next(); (its_Tb_setm && !its_Tb_chg) ? (fil = 0); ) :
        its_Tb_KeyErr(w, "Line");
    );
    // a file : its size and its channels (length, chan, spls are then ignored : a Dump can be read again)
    ((its_Tb_error === 0) && (k >= 0) && (fil !== 0) && (its_Tb_mode >= 2) && its_Tb_File(fil)) ? (
        spl = its_Tb_fnfr; ch = its_Tb_fcc;
    );
    ((its_Tb_error === 0) && (k >= 0)) ? (
        (its_Tb_mode === 0) ? (
            its_TbResv[k] = 1;
        ) :
        (its_Tb_mode >= 2) ? (
            (its_Tb_mode === 2) ? (
                sp = its_TbSimSp[k]; cc = its_TbSimCh[k];
            ) : (
                lcbl = Lines_Set[k];
                ((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
                    sp = lcbl[its_Lin_SmplCnt]; cc = lcbl[its_Lin_ChCnt];
                ) : (
                    sp = cc = 0;
                );
            );
            // the new size, as Ln_Make computes it
            nsp = (spl > 0) ? spl : (len > 0) ? max(48, min(67108864, ceil(len * srate))) : (sp > 0) ? sp : srate;
            nch = (ch > 0) ? ch : (cc > 0) ? cc : 2;
            (its_Tb_mode === 2) ? (
                ((sp > 0) && (its_Tb_clr === 0) && ((nsp !== sp) || (nch !== cc)) && ((u = its_Tb_ChUser(k, nch)) > 0)) ? (
                    r = Readers_set[u - 1];
                    sprintf(#its_TbW, "Line %d chan %d : Reader %d uses its channels %d-%d", k + 1, nch, u,
                        r[its_Rdr_Bf1stChan], r[its_Rdr_Bf1stChan] + r[its_Rdr_BfChanUsed] - 1);
                    its_Tb_Err(2758, #its_TbW);
                );
                its_TbSimSp[k] = nsp; its_TbSimCh[k] = nch;
                (own > 0) ? (its_TbSimLO[k] = own);
            ) :
            (fil !== 0) ? (
                // read the file into the line (created, or replaced if it differs)
                ((err = Ln_Load_File(k, #its_TbFile)) === 2610) ? (
                    its_Tb_error = 2610; // (logged by Ln_Make)
                ) :
                (err !== 0) ? (
                    sprintf(#its_TbW, "file \"%s\" : error %04d", #its_TbFile, err);
                    its_Tb_Err(err, #its_TbW);
                );
            ) :
            ((nsp !== sp) || (nch !== cc)) ? (
                // create, or replace by a different line ; (nsp - 0.5) / srate gives nsp samples in Ln_Make
                (Ln_Make(k, srate, (nsp - 0.5) / srate, nch) > BASE_MEMORY) ? (
                    (sp > 0) ? Ln_Rebind(k);
                    strcpy(its_LnFile[k], ""); // (no file any more)
                    lnupdt = 1;
                ) : (
                    its_Tb_error = 2610; // (logged by Ln_Make)
                );
            );
            ((its_Tb_mode === 3) && (own > 0) && ((lcbl = Lines_Set[k]) > BASE_MEMORY)) ? (lcbl[its_Lin_Owner] = own);
        );
    );
);

function its_Tb_DumpLine(k) local(lcbl)
(
    lcbl = Lines_Set[k];
    ((lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        its_Xp_On ? (
            // an export : its file, or its length and its channels (at any sample rate)
            sprintf(#its_TbW, "Line %s", its_Xp_Ref(#its_XpH, its_TK_Line, k));
            (strlen(its_LnFile[k]) > 0) ? strcat(#its_TbW, sprintf(#its_TbV1, "%sfile \"%s\"", its_Xp_Sep(), its_Xp_RelP(its_LnFile[k]))) :
                strcat(#its_TbW, sprintf(#its_TbV1, "%slength %.10g%schan %d", its_Xp_Sep(), lcbl[its_Lin_SmplCntSec], its_Xp_Sep(), lcbl[its_Lin_ChCnt]));
        ) : (
            sprintf(#its_TbW, "Line %d status Ready length %.3f chan %d spls %d freq %d", k + 1,
                lcbl[its_Lin_SmplCntSec], lcbl[its_Lin_ChCnt], lcbl[its_Lin_SmplCnt], lcbl[its_Lin_RecFreq]);
            (strlen(its_LnFile[k]) > 0) ? strcat(#its_TbW, sprintf(#its_TbV1, " file \"%s\"", its_LnFile[k]));
        );
    ) : (
        sprintf(#its_TbW, "Line %d status Undefined", k + 1);
    );
    its_Tb_Out(#its_TbW);
);

// a difference found by Check : logged as an error, the analysis goes on
function its_Tb_Diff(k, key, v, x)
(
    sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Line %d : %s %.10g (expected %.10g)", k + 1, key, v, x);
    mSL_log(SysLogBox, #its_TbMsg);
    (its_Tb_res === 0) ? (its_Tb_res = 2759);
);

function its_Tb_CheckLine(k) local(w, lcbl, ex, ok, v)
(
    lcbl = (k >= 0) ? Lines_Set[k] : 0;
    ex = (lcbl > BASE_MEMORY) && (lcbl[-2] === KW_lcbl);
    ok = (its_Tb_mode === 3) && (k >= 0);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        (w === its_TK_status) ? (
            v = its_Tb_Next();
            ((v !== its_TK_Ready) && (v !== its_TK_Undefined)) ? (
                sprintf(#its_TbW, "Check : status %s is not Ready or Undefined", mSL_edit_value(#its_TbV, v));
                its_Tb_Err(2754, #its_TbW);
            ) :
            (ok && (ex !== (v === its_TK_Ready))) ? (
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Line %d : status %s (expected %s)",
                    k + 1, ex ? "Ready" : "Undefined", ex ? "Undefined" : "Ready");
                mSL_log(SysLogBox, #its_TbMsg);
                (its_Tb_res === 0) ? (its_Tb_res = 2759);
                ok = -1;
            );
        ) :
        (w === its_TK_length) ? (
            v = its_Tb_Num("length", 0, 67108864 / srate);
            (ok && (its_Tb_error === 0) && (!ex || (abs(lcbl[its_Lin_SmplCntSec] - v) >= 0.0005))) ? (
                its_Tb_Diff(k, "length", ex ? lcbl[its_Lin_SmplCntSec] : 0, v); ok = -1;
            );
        ) :
        (w === its_TK_chan) ? (
            v = its_Tb_Int("chan", 0, 128);
            (ok && (its_Tb_error === 0) && ((ex ? lcbl[its_Lin_ChCnt] : 0) !== v)) ? (
                its_Tb_Diff(k, "chan", ex ? lcbl[its_Lin_ChCnt] : 0, v); ok = -1;
            );
        ) :
        (w === its_TK_spls) ? (
            v = its_Tb_Int("spls", 0, 67108864);
            (ok && (its_Tb_error === 0) && ((ex ? lcbl[its_Lin_SmplCnt] : 0) !== v)) ? (
                its_Tb_Diff(k, "spls", ex ? lcbl[its_Lin_SmplCnt] : 0, v); ok = -1;
            );
        ) :
        (w === its_TK_freq) ? (
            v = its_Tb_Num("freq", 0, 384000);
            (ok && (its_Tb_error === 0) && ((ex ? lcbl[its_Lin_RecFreq] : 0) !== v)) ? (
                its_Tb_Diff(k, "freq", ex ? lcbl[its_Lin_RecFreq] : 0, v); ok = -1;
            );
        ) :
        (w === its_TK_file) ? (
            // the file (its path, as the key "file" of a line)
            v = its_Tb_Next();
            (!mSL_isString(v)) ? (
                sprintf(#its_TbW, "Check : file %s is not a string", mSL_edit_value(#its_TbV, v));
                its_Tb_Err(2754, #its_TbW);
            ) :
            (ok && (its_Path(#its_TbFile, v) !== 0) && (strcmp(#its_TbFile, its_LnFile[k]) !== 0)) ? (
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Line %d : file \"%s\" (expected \"%s\")", k + 1,
                    its_LnFile[k], #its_TbFile);
                mSL_log(SysLogBox, #its_TbMsg);
                (its_Tb_res === 0) ? (its_Tb_res = 2759);
                ok = -1;
            );
        ) :
        its_Tb_KeyErr(w, "Check Line");
    );
    ((ok === 1) && (its_Tb_error === 0)) ? (
        sprintf(#its_TbW, "Check Line %d OK", k + 1);
        mSL_log(SysLogBox, #its_TbW);
    );
);

//—— Writers and readers

// the first channel after an optional ":" (0 without it)
function its_Tb_ChOpt(key)
(
    (its_Tb_Peek() === its_TK_Colon) ? ( its_Tb_Next(); its_Tb_Int(key, 0, 127); ) : 0;
);

// a source (dst = 0 ; "none" : no source) or the destination of an output (dst = 1) : its_Tb_v1 (kind * ITS_KMul + number,
// 0 : none or own cable), its_Tb_v2 (first channel)
function its_Tb_Src(key, dst) local(w, n)
(
    its_Tb_v1 = its_Tb_v2 = 0;
    w = its_Tb_Next();
    ((dst && (w === its_TK_Own)) || (!dst && (w === its_TK_none))) ? (
        0;
    ) :
    ((!dst && (w === its_TK_In)) || (w === its_TK_Out)) ? (
        (its_Tb_Next() !== its_TK_Colon) ? (
            sprintf(#its_TbW, "%s : %s:channel expected", key, (w === its_TK_In) ? "In" : "Out");
            its_Tb_Err(2754, #its_TbW);
        ) : (
            its_Tb_v2 = its_Tb_Int(key, 0, CH_NB - 1);
            its_Tb_v1 = ((w === its_TK_In) ? ITS_KIn : ITS_KOut) * ITS_KMul;
        );
    ) :
    (w === its_TK_Bus) ? (
        n = its_Tb_Int(key, 1, NB_BUS);
        its_Tb_v1 = ITS_KBus * ITS_KMul + n - 1;
        its_Tb_v2 = its_Tb_ChOpt(key);
    ) :
    (!dst && (w === its_TK_Ctl)) ? (
        n = its_Tb_Int(key, 1, NB_CTL);
        its_Tb_v1 = ITS_KCtl * ITS_KMul + n - 1;
    ) :
    (!dst && (w === its_TK_Reader)) ? (
        n = its_Tb_Id(its_TK_Reader, its_Tb_Next(), 0);
        its_Tb_v1 = ITS_KRdr * ITS_KMul + max(0, n);
        its_Tb_v2 = its_Tb_ChOpt(key);
    ) :
    (!dst && (w === its_TK_Effect)) ? (
        n = its_Tb_Id(its_TK_Effect, its_Tb_Next(), 0);
        its_Tb_v1 = ITS_KFx * ITS_KMul + max(0, n);
        its_Tb_v2 = its_Tb_ChOpt(key);
    ) : (
        sprintf(#its_TbW, "%s : %s is not a %s", key, mSL_edit_value(#its_TbV, w), dst ? "destination" : "source");
        its_Tb_Err(2754, #its_TbW);
    );
);

// the text of a source or a destination (as read by its_Tb_Src)
function its_Tb_SrcText(str, src, off)
local (k, n)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    (src === 0) ? strcpy(str, "none") :
    (k === ITS_KIn) ? ( ((its_Xp_On === 1) && its_Xp_Port(str, 0, off)) ? 0 : sprintf(str, "In:%d", off); ) :
    (k === ITS_KOut) ? ( ((its_Xp_On === 1) && its_Xp_Port(str, 1, off)) ? 0 : sprintf(str, "Out:%d", off); ) :
    (k === ITS_KBus) ? ( (its_Xp_On === 1) ? (its_XpBuU[n] = 1); sprintf(str, "Bus %d:%d", n + 1, off); ) :
    (k === ITS_KCtl) ? ( (its_Xp_On === 1) ? (its_XpCtU[n + off] = 1); sprintf(str, "Ctl %d", n + 1 + off); ) :
    (k === ITS_KRdr) ? its_Xp_SrcMod(str, "Reader", its_TK_Reader, n, off) :
    (k === ITS_KFx) ? its_Xp_SrcMod(str, "Effect", its_TK_Effect, n, off) :
    strcpy(str, "???");
    str;
);

// (the keys of the writers and of the readers : its_Tb_Key, after the curves and the options of the modulations)

//—— Curves : envelopes and waveforms (the module "Curves")
/*
    its_CrvMx curves, in dynamic blocks (KW_crvb) : its_CrvBlk[k] (0 : no curve), its_CrvNm[k] their name (a text, "" : none ; case sensitive) ;
    a block : the type (its_CrvEnv ... its_CrvHWave, below), the flags (1 : periodic), the count of points, then the
    points (x, y, c) : x from 0 to 1 (not decreasing), c the curvature of the segment that starts at the point
    the types : the editor shows the part kept (V, x in [0, 1]) ; the complete form F (u in [0, 1]) is deduced by symmetry
    when it is needed (not built yet) :
        0 Env   : an envelope, y in [0, 1] ; F = V
        1 Wave  : a waveform, y in [-1, 1] ; F = V
        2 HEnv  : a half envelope, the rise (y in [0, 1]) ; the fall is its mirror, (x, y) -> (2 - x, y), then x / 2 :
                  F(u) = V(2 u) for u <= 0.5, V(2 - 2 u) after
        3 QWave : a quarter of a waveform (y in [-1, 1], the first point at (0, 0)) ; the mirror (as HEnv) gives the half
                  waveform H(u) = V(2 u) for u <= 0.5, V(2 - 2 u) after, then the complete form as HWave
        4 HWave : a half waveform (y in [-1, 1], the first and the last y : 0) ; translated by (-1, 0) into [-1, 0], plus its
                  symmetric about (0, 0), (x, y) -> (-x, -y), it gives the waveform in [-1, 1], then (x + 1) / 2 :
                  F(u) = V(2 u) for u <= 0.5, -V(2 - 2 u) after
    the periodic flag : Env and Wave only (the forms deduced are complete)
    the sustain point of an envelope (its_Crv_Sus : its index, -1 : none ; a waveform has none) divides it in two parts :
    the "rise" (from x = 0 to the point) and the "fall" (from the point to x = 1) ; applied to a sound with a fade-in, a
    plateau and a fade-out, the rise is stretched over the fade-in, the y of the sustain point is the level of the plateau,
    and the fall is stretched over the fade-out (the grains of a reader, see exec_grains)
*/
KW_crvb = 'crvb';
its_CrvMx = 64; // count of curves
its_CrvPMx = 128; // points of a curve
its_Crv_Type = 0; its_Crv_Flags = 1; its_Crv_N = 2; its_Crv_Sel = 3; its_Crv_Sus = 4; its_Crv_Pts = 5;
its_Crv_BlkSize = its_Crv_Pts + 3 * its_CrvPMx;
its_CrvEnv = 0; its_CrvWave = 1; its_CrvHEnv = 2; its_CrvQWave = 3; its_CrvHWave = 4; its_CrvTyCnt = 5;
its_CrvFl_Periodic = 1;
its_CrvBlk = make_array(its_CrvMx);
mm_usr_prot[mm_usr_prot_ptr] = its_CrvBlk; mm_usr_prot_ptr += 1; // (the garbage collector keeps them)
// the names (texts, "" : none ; case sensitive ; in a table : a word, or a text between double quotes) ; in the simulation
// of pass 2 : its_CrvSimN
its_CrvNmMx = 31; // characters of a name at most
its_CrvNm = make_array(its_CrvMx); its_CrvSimN = make_array(its_CrvMx);
<? i = 0; loop(64, printf("its_CrvNm[%d] = #its_CrvNm%d; its_CrvSimN[%d] = #its_CrvSN%d; ", i, i, i, i); ((i % 4) == 3) ? printf("\n"); i += 1;); ?>
its_CrvRenK = -1; // the curve renamed by the prompt of the module (see its_Crv_Rename)
its_FxEdN = -1; // the effect whose value is edited by the prompt (-1 : none, see its_FxEd_Open)
// the types : their names in a table, in the pad ; the order of the cell "type" of the pad (envelopes, then waveforms)
its_CrvTyN = make_array(its_CrvTyCnt); its_CrvTy = make_array(its_CrvTyCnt); its_CrvTyL = make_array(its_CrvTyCnt);
its_CrvTyN[0] = "Env"; its_CrvTyN[1] = "Wave"; its_CrvTyN[2] = "HEnv"; its_CrvTyN[3] = "QWave"; its_CrvTyN[4] = "HWave";
its_CrvTyL[0] = "Envelope"; its_CrvTyL[1] = "Waveform"; its_CrvTyL[2] = "H-Envelope"; its_CrvTyL[3] = "Q-Waveform";
its_CrvTyL[4] = "H-Waveform";
i__ii = 0; loop(its_CrvTyCnt, its_CrvTy[i__ii] = its_TK(its_CrvTyN[i__ii]); i__ii += 1;);
its_CrvTyO = make_array(its_CrvTyCnt);
its_CrvTyO[0] = its_CrvEnv; its_CrvTyO[1] = its_CrvHEnv; its_CrvTyO[2] = its_CrvWave; its_CrvTyO[3] = its_CrvQWave;
its_CrvTyO[4] = its_CrvHWave;
// the analysis of a block Curve : its keys (type, periodic, name, points, sustain), its points, the simulation of pass 2
its_CrvKS = make_array(5); its_CrvK = make_array(5);
its_CrvTP = make_array(3 * its_CrvPMx); its_CrvTN = 0;
its_CrvSimU = make_array(its_CrvMx);
// one level of Undo : the curve before the last change (its_CrvUndoK : its number, -1 none ; its_CrvUndoE : 0 if there was no curve)
its_CrvUndoB = make_array(its_Crv_BlkSize); its_CrvUndoK = -1; its_CrvUndoE = 0; // (its name : #its_CrvUndoN)
its_CrvPreB = make_array(its_Crv_BlkSize); its_CrvPreK = -1; its_CrvPreE = 0; // the curve when a gesture starts (#its_CrvPreN)
its_CrvTmpB = make_array(its_Crv_BlkSize);
/*
    the editors "Curves A ... H" (its_CrvEdN modules) : the state of each one in its_CrvEd (its_CrvEdSz words : 0 the curve
    shown, 1 the grid, 2 ... 10 the mouse, 11 the curve of the selection), its selected points in its_CrvEdSel ;
    show_Curves_Pad puts the state of the editor drawn in the globals its_CrvUiK ... its_CrvSelF (its_Crv_EdGet), then
    keeps it (its_Crv_EdPut) ; by default, the editor e shows the curve e + 1
*/
its_CrvEdN = 8; its_CrvEdSz = 12;
its_CrvEd = make_array(its_CrvEdN * its_CrvEdSz);
its_CrvEdSel = make_array(its_CrvEdN * its_CrvPMx);
i__ii = 0; loop(its_CrvEdN,
    i__p = its_CrvEd + i__ii * its_CrvEdSz; i__p[0] = i__ii; i__p[4] = i__p[11] = -1;
    i__ii += 1;
);
its_CrvSelF = its_CrvEdSel; its_CrvSelK = -1; // the selected points (1) of the curve its_CrvSelK (the editor drawn)
its_CrvOrig = make_array(3 * its_CrvPMx); // the points when a move starts (its_Crv_Move)
/*
    the sampled tables of the curves (the shape "Curve" of an LFO reads them, see exec_fx) : for each curve, its_CrvTbN
    samples of its complete form F(u), u = j / its_CrvTbN (see the types above), framed by its_CrvTbG guard samples on each
    side, the samples of the other end (a cycle : the cubic interpolation reads t[-1] ... t[its_CrvTbN + 1]) ;
    its_CrvTab + k * its_CrvTbSz + its_CrvTbG : the sample 0 of the curve k ; a curve that does not exist : zeros ;
    built by @gfx when the curve changes (its_Crv_TabsUpdate : the curve compared with its copy in its_CrvTbC)
*/
its_CrvTbN = 4096; its_CrvTbG = 2; its_CrvTbSz = its_CrvTbN + 2 * its_CrvTbG;
its_CrvTab = make_array(its_CrvMx * its_CrvTbSz);
its_CrvTbC = make_array(its_CrvMx * its_Crv_BlkSize); // the curve when its table was built (type, count, points)
its_CrvTbE = make_array(its_CrvMx); // 1 : the table comes from a curve (0 : zeros)
// the plateau of an envelope in its table (the mode Grains of the readers, see its_Crv_Build) : its x, -1 if the curve is
// not an envelope (a waveform, no curve), and its level
its_CrvTbXs = make_array(its_CrvMx); its_CrvTbS = make_array(its_CrvMx);
its_CrvTbMx = 4; its_CrvTbK = 0; // tables built per frame at most ; the first curve looked at (its_Crv_TabsUpdate)

/*
    the shape of a segment, t in [0, 1] : t / (t + a (1 - t)), a = its_CrvK^-c (c > 0 : fast start) ; monotonic, in [0, 1] ;
    an arc of hyperbola, symmetric about its middle (the line x + y = 1) ; c and -c give mirror shapes : f(-c, t) = 1 - f(c, 1 - t) ;
    the slopes at the ends are 1 / a and a (finite)
*/
its_CrvK = 1000; // (c = 1 : the slope at the start is 1000)
function its_Crv_Shape(t, c)
(
    (c === 0) ? t : t / (t + (its_CrvK ^ (-c)) * (1 - t));
);

// the value of the curve "b" at x in [0, 1]
function its_Crv_Val(b, x) local(n, p, i, x0, x1)
(
    n = b[its_Crv_N]; p = b + its_Crv_Pts;
    x = max(0, min(1, x));
    i = 0; while ((i < n - 2) && (p[3 * (i + 1)] <= x)) ( i += 1; );
    p += 3 * i; x0 = p[0]; x1 = p[3];
    (x1 <= x0) ? p[4] : p[1] + (p[4] - p[1]) * its_Crv_Shape((x - x0) / (x1 - x0), p[2]);
);

// the lowest y of the type "ty" : 0 for the envelopes (Env, HEnv), -1 for the waveforms
function its_Crv_Lo(ty) ( ((ty === its_CrvEnv) || (ty === its_CrvHEnv)) ? 0 : -1; );

/*
    the default points of a new curve of type "ty" : Env, HEnv, QWave from (0, 0) to (1, 1) ; Wave at 0 ; HWave (0, 0),
    (0.5, 1), (1, 0)
*/
function its_Crv_Default(b, ty)
(
    memset(b, 0, its_Crv_BlkSize);
    b[its_Crv_Type] = ty; b[its_Crv_N] = 2; b[its_Crv_Sel] = -1; b[its_Crv_Sus] = -1;
    b[its_Crv_Pts + 3] = 1; b[its_Crv_Pts + 4] = (ty === its_CrvWave) ? 0 : 1;
    (ty === its_CrvHWave) ? (
        b[its_Crv_N] = 3;
        b[its_Crv_Pts + 3] = 0.5; b[its_Crv_Pts + 6] = 1; b[its_Crv_Pts + 7] = 0;
    );
);

/*
    the points kept in the bounds of the type, the last y of a periodic curve is the first one (Env, Wave ; the other types
    are not periodic) ; QWave : the first y is 0 ; HWave : the first and the last y are 0 ; the sustain : a point of an Env
*/
function its_Crv_Clamp(b) local(lo, ty, p)
(
    ty = b[its_Crv_Type] = max(0, min(its_CrvTyCnt - 1, 0|b[its_Crv_Type]));
    lo = its_Crv_Lo(ty);
    p = b + its_Crv_Pts; loop(b[its_Crv_N], p[1] = max(lo, min(1, p[1])); p += 3;);
    ((ty !== its_CrvEnv) && (ty !== its_CrvWave)) ? (b[its_Crv_Flags] = b[its_Crv_Flags] & (-1 ~ its_CrvFl_Periodic));
    (b[its_Crv_Flags] & its_CrvFl_Periodic) ? (b[its_Crv_Pts + 3 * (b[its_Crv_N] - 1) + 1] = b[its_Crv_Pts + 1]);
    ((ty === its_CrvQWave) || (ty === its_CrvHWave)) ? (b[its_Crv_Pts + 1] = 0);
    (ty === its_CrvHWave) ? (b[its_Crv_Pts + 3 * (b[its_Crv_N] - 1) + 1] = 0);
    ((ty !== its_CrvEnv) || (b[its_Crv_Sus] < 0) || (b[its_Crv_Sus] >= b[its_Crv_N])) ? (b[its_Crv_Sus] = -1) : (b[its_Crv_Sus] = floor(b[its_Crv_Sus]));
);

// the values V(j / m) of the curve "b" in t[0 ... m] (as its_Crv_Val, the segments followed in order)
function its_Crv_Fill(b, t, m) local(n, p, q, i, j, x, x0, x1)
(
    n = b[its_Crv_N]; p = b + its_Crv_Pts; i = 0; j = 0;
    loop(m + 1,
        x = j / m;
        while ((i < n - 2) && (p[3 * (i + 1)] <= x)) ( i += 1; );
        q = p + 3 * i; x0 = q[0]; x1 = q[3];
        t[j] = (x1 <= x0) ? q[4] : q[1] + (q[4] - q[1]) * its_Crv_Shape((x - x0) / (x1 - x0), q[2]);
        j += 1;
    );
);

/*
    the table of the curve "k" (see its_CrvTab) : the complete form F (the types HEnv, QWave, HWave : by symmetry), then
    the guards (a cycle) ; zeros if the curve does not exist ; the curve is copied in its_CrvTbC
*/
function its_Crv_Build(k) local(b, t, n, ty, j, i, p)
(
    b = its_CrvBlk[k]; t = its_CrvTab + k * its_CrvTbSz + its_CrvTbG; n = its_CrvTbN;
    (b > BASE_MEMORY) ? (
        ty = b[its_Crv_Type];
        (ty === its_CrvHEnv) ? (
            // F(u) = V(2 u) for u <= 0.5, F(1 - u) = F(u)
            its_Crv_Fill(b, t, n / 2);
            j = 1; loop(n / 2 - 1, t[n - j] = t[j]; j += 1;);
        ) :
        (ty === its_CrvHWave) ? (
            // F(u) = V(2 u) for u <= 0.5, F(1 - u) = -F(u)
            its_Crv_Fill(b, t, n / 2);
            j = 1; loop(n / 2 - 1, t[n - j] = -t[j]; j += 1;);
        ) :
        (ty === its_CrvQWave) ? (
            // the half waveform : H(u) = V(2 u) for u <= 0.5, H(1 - u) = H(u) ; then as HWave
            its_Crv_Fill(b, t, n / 4);
            j = 0; loop(n / 4, t[n / 2 - j] = t[j]; j += 1;);
            j = 1; loop(n / 2 - 1, t[n - j] = -t[j]; j += 1;);
        ) : (
            // Env, Wave : F = V
            its_Crv_Fill(b, t, n);
        );
        t[-2] = t[n - 2]; t[-1] = t[n - 1]; t[n] = t[0]; t[n + 1] = t[1];
        memcpy(its_CrvTbC + k * its_Crv_BlkSize, b, its_Crv_Pts + 3 * b[its_Crv_N]);
        its_CrvTbE[k] = 1;
        // the plateau (the grains of a reader) : an envelope, its sustain point, else its highest point ; a half envelope,
        // its top (u = 0.5) ; a waveform : none
        p = b + its_Crv_Pts;
        (ty === its_CrvEnv) ? (
            i = b[its_Crv_Sus];
            (i < 0) ? ( i = 0; j = 1; loop(b[its_Crv_N] - 1, (p[3 * j + 1] > p[3 * i + 1]) ? (i = j); j += 1;); );
            its_CrvTbXs[k] = p[3 * i]; its_CrvTbS[k] = p[3 * i + 1];
        ) :
        (ty === its_CrvHEnv) ? (
            its_CrvTbXs[k] = 0.5; its_CrvTbS[k] = t[n / 2];
        ) : (
            its_CrvTbXs[k] = -1; its_CrvTbS[k] = 1;
        );
    ) : (
        memset(t - its_CrvTbG, 0, its_CrvTbSz);
        its_CrvTbE[k] = 0;
        its_CrvTbXs[k] = -1; its_CrvTbS[k] = 1;
    );
);

// the table of the curve "k" is not the one of the curve (its type, its points), or the curve no longer exists
function its_Crv_TbDiff(k) local(b, c, n, i, d)
(
    b = its_CrvBlk[k]; c = its_CrvTbC + k * its_Crv_BlkSize;
    (b <= BASE_MEMORY) ? (d = its_CrvTbE[k]) :
    !its_CrvTbE[k] ? (d = 1) : (
        n = b[its_Crv_N];
        d = (b[its_Crv_Type] !== c[its_Crv_Type]) || (n !== c[its_Crv_N]) || (b[its_Crv_Sus] !== c[its_Crv_Sus]); // (Sus : Grains)
        i = its_Crv_Pts; loop(d ? 0 : 3 * n, (b[i] !== c[i]) ? (d = 1); i += 1;);
    );
    d;
);

// @gfx, each frame : the tables of the curves that changed (its_CrvTbMx at most ; the next frame starts after the last one built)
function its_Crv_TabsUpdate() local(k, m, i)
(
    m = 0; i = 0;
    while ((i < its_CrvMx) && (m < its_CrvTbMx)) (
        k = (its_CrvTbK + i) % its_CrvMx;
        its_Crv_TbDiff(k) ? ( its_Crv_Build(k); m += 1; (m === its_CrvTbMx) ? (its_CrvTbK = (k + 1) % its_CrvMx); );
        i += 1;
    );
);

// the curve named "txt" (or -1) ; "sim" : in the simulation of pass 2
function its_Crv_Find(txt, sim) local(i, k, nm)
(
    k = -1; i = 0;
    while ((k < 0) && (i < its_CrvMx)) (
        nm = sim ? its_CrvSimN[i] : its_CrvNm[i];
        ((strlen(nm) > 0) && (strcmp(nm, txt) === 0)) ? (k = i);
        i += 1;
    );
    k;
);

// the text of the name "w" (a string, or a symbol that is not a reserved word) in "dst" : 1, or 0 (not a name)
function its_Crv_WTxt(dst, w)
(
    mSL_isString(w) ? ( strcpy(dst, w); 1; ) :
    its_Tb_IsName(w) ? ( mSL_edit_value(dst, w); 1; ) : 0;
);

// a valid name : 1 ... its_CrvNmMx characters, without double quote nor control character
function its_Crv_NmOk(txt) local(i, l, c, ok)
(
    l = strlen(txt);
    ok = (l >= 1) && (l <= its_CrvNmMx);
    i = 0; while (ok && (i < l)) ( c = str_getchar(txt, i, 'cu'); ((c === '"') || (c < 0x20)) ? (ok = 0); i += 1; );
    ok;
);

function its_Crv_Exists(k) ( (its_Tb_mode === 2) ? its_CrvSimU[k] : (its_CrvBlk[k] > BASE_MEMORY); );

/*
    the curve designated by the word "w" : a number 1 ... its_CrvMx, or a name (a word, or a string) ; "create" : a new name gets the first free
    curve (pass 2 : in the simulation ; pass 3 : the curve is allocated by its_Tb_Curve) ; passes 0 and 1 : -2 for a name
    not yet known ; -1 and an error otherwise
*/
function its_Crv_Id(w, create) local(k, i)
(
    k = -1;
    ((abs(w) < mSL_CharConst) && (w === floor(w)) && (w >= 1) && (w <= its_CrvMx)) ? (
        k = w - 1;
    ) :
    (its_Crv_WTxt(#its_CrvW, w) && its_Crv_NmOk(#its_CrvW)) ? (
        k = its_Crv_Find(#its_CrvW, its_Tb_mode === 2);
        ((k < 0) && create && (its_Tb_mode >= 2)) ? (
            i = 0; while ((k < 0) && (i < its_CrvMx)) ( !its_Crv_Exists(i) ? (k = i); i += 1; );
            (k < 0) ? (
                sprintf(#its_TbW, "Curve %s : too many curves (%d)", mSL_edit_value(#its_TbV, w), its_CrvMx);
                its_Tb_Err(2793, #its_TbW);
            ) :
            (its_Tb_mode === 2) ? ( its_CrvSimU[k] = 1; strcpy(its_CrvSimN[k], #its_CrvW); ) : ( strcpy(its_CrvNm[k], #its_CrvW); );
        );
        ((k < 0) && (its_Tb_mode < 2)) ? (k = -2); // (a curve named in this table : known from pass 2)
    );
    ((k === -1) && (its_Tb_error === 0)) ? (
        sprintf(#its_TbW, "Curve : %s is not a curve (1 ... %d, or a name)", mSL_edit_value(#its_TbV, w), its_CrvMx);
        its_Tb_Err(2792, #its_TbW);
    );
    k;
);

// pass 2 starts with the curves as they are
function its_Crv_SimInit() local(i)
(
    i = 0; loop(its_CrvMx, its_CrvSimU[i] = (its_CrvBlk[i] > BASE_MEMORY); strcpy(its_CrvSimN[i], its_CrvNm[i]); i += 1;);
);

// the keys of a block Curve (k : the curve, -2 : a name not yet given a curve)
function its_Crv_Keys(k) local(w, v, i, n, lo, ty, pr, ok)
(
    memset(its_CrvKS, 0, 5);
    while ((its_Tb_error === 0) && !its_Tb_IsHead(w = its_Tb_Peek())) (
        its_Tb_Next();
        its_Tb_chg = 0;
        (w === mSL_symbol("type")) ? ( its_CrvK[0] = its_Tb_Enum("type", its_CrvTy, its_CrvTyCnt); its_CrvKS[0] = 1; ) :
        (w === its_TK_periodic) ? ( its_CrvK[1] = its_Tb_Enum("periodic", its_TbFSt, 2); its_CrvKS[1] = 1; ) :
        (w === its_TK_name) ? (
            // (a word not reserved, or a string : the text in #its_CrvKN)
            v = its_Tb_Next();
            (!its_Crv_WTxt(#its_CrvKN, v) || !its_Crv_NmOk(#its_CrvKN)) ? (
                sprintf(#its_TbW, "Curve : %s can't be a name (a word not reserved, or a string of 1 ... %d characters without \")",
                    mSL_edit_value(#its_TbV, v), its_CrvNmMx);
                its_Tb_Err(2796, #its_TbW);
            ) :
            (((i = its_Crv_Find(#its_CrvKN, its_Tb_mode === 2)) >= 0) && (i !== k)) ? (
                sprintf(#its_TbW, "Curve : the name \"%s\" is the one of the curve %d", #its_CrvKN, i + 1);
                its_Tb_Err(2796, #its_TbW);
            );
            its_CrvKS[2] = 1;
        ) :
        (w === its_TK_points) ? (
            n = 0;
            while ((its_Tb_error === 0) && (((v = its_Tb_Peek()) === mSL_cstMinus) || (abs(v) < mSL_CharConst))) (
                (n < 3 * its_CrvPMx) ? (
                    its_CrvTP[n] = ((n % 3) === 2) ? its_Tb_Num("points (c)", -1, 1) : its_Tb_Num("points", -1, 1);
                ) : (
                    its_Tb_Next();
                );
                n += 1;
            );
            ((its_Tb_error === 0) && (((n % 3) !== 0) || (n < 6) || (n > 3 * its_CrvPMx))) ? (
                sprintf(#its_TbW, "Curve : points : %d numbers, not 2 ... %d points (x y c)", n, its_CrvPMx);
                its_Tb_Err(2794, #its_TbW);
            );
            its_CrvTN = n / 3; its_CrvKS[3] = 1;
            ok = (its_CrvTP[0] === 0) && (its_CrvTP[3 * (its_CrvTN - 1)] === 1);
            i = 1; while (ok && (i < its_CrvTN)) ( (its_CrvTP[3 * i] < its_CrvTP[3 * (i - 1)]) ? (ok = 0); i += 1; );
            ((its_Tb_error === 0) && !ok) ? its_Tb_Err(2794, "Curve : points : x must go from 0 to 1, without decreasing");
        ) :
        (w === its_TK_sustain) ? (
            (its_Tb_Peek() === its_TbFSt[0]) ? ( its_Tb_Next(); its_CrvK[4] = 0; ) : ( its_CrvK[4] = its_Tb_Int("sustain", 0, its_CrvPMx); );
            its_CrvKS[4] = 1;
        ) : (
            its_Tb_KeyErr(w, "Curve");
        );
    );
    // the type given, or the one of the curve, or Env
    ty = its_CrvKS[0] ? its_CrvK[0] : ((k >= 0) && (its_CrvBlk[k] > BASE_MEMORY)) ? its_CrvBlk[k][its_Crv_Type] : its_CrvEnv;
    // the sustain : a point of an envelope (the points given, or the ones of the curve, or the 2 of a new curve ; without
    // points in the block, the count is known in pass 3 only : the table may change the points before ; the same for the type)
    ((its_Tb_error === 0) && its_CrvKS[4] && (its_CrvK[4] > 0)) ? (
        n = its_CrvKS[3] ? its_CrvTN : (its_Tb_mode < 3) ? its_CrvPMx :
            ((k >= 0) && (its_CrvBlk[k] > BASE_MEMORY)) ? its_CrvBlk[k][its_Crv_N] : 2;
        ((its_CrvKS[0] || (its_Tb_mode === 3)) && (ty !== its_CrvEnv)) ? (
            its_Tb_Err(2799, "Curve : sustain : only an envelope (Env) has a sustain point");
        ) :
        (its_CrvK[4] > n) ? (
            sprintf(#its_TbW, "Curve : sustain : %d is not a point (1 ... %d)", its_CrvK[4], n);
            its_Tb_Err(2799, #its_TbW);
        );
    );
    // the y of the points in the bounds of the type
    ((its_Tb_error === 0) && its_CrvKS[3]) ? (
        lo = its_Crv_Lo(ty);
        i = 0; while ((its_Tb_error === 0) && (i < its_CrvTN)) (
            ((its_CrvTP[3 * i + 1] < lo) || (its_CrvTP[3 * i + 1] > 1)) ? (
                sprintf(#its_TbW, "Curve : points : y = %g is not in [%d, 1] (%s)", its_CrvTP[3 * i + 1], lo, its_CrvTyN[ty]);
                its_Tb_Err(2795, #its_TbW);
            );
            i += 1;
        );
    );
);

// Curve id keys... : pass 3 creates the curve if needed, then sets it
function its_Tb_Curve() local(k, b, w)
(
    w = its_Tb_Next();
    k = its_Crv_Id(w, 1);
    its_Crv_Keys(k);
    ((its_Tb_error === 0) && (its_Tb_mode === 2) && (k >= 0)) ? (
        its_CrvSimU[k] = 1;
        its_CrvKS[2] ? strcpy(its_CrvSimN[k], #its_CrvKN);
    );
    ((its_Tb_error === 0) && (its_Tb_mode === 3) && (k >= 0)) ? (
        ((b = its_CrvBlk[k]) <= BASE_MEMORY) ? (
            ((b = mSL_Dyn_Alloc(its_Crv_BlkSize, KW_crvb, 0)) <= BASE_MEMORY) ? (
                sprintf(#its_TbW, "Curve %d : not enough memory", k + 1);
                its_Tb_Err(2797, #its_TbW);
                b = 0;
            ) : (
                its_Crv_Default(b, its_CrvKS[0] ? its_CrvK[0] : its_CrvEnv);
                its_CrvBlk[k] = b;
            );
        );
        (b > BASE_MEMORY) ? (
            its_CrvKS[0] ? (b[its_Crv_Type] = its_CrvK[0]);
            its_CrvKS[1] ? (b[its_Crv_Flags] = (b[its_Crv_Flags] & (-1 ~ its_CrvFl_Periodic)) | (its_CrvK[1] ? its_CrvFl_Periodic : 0));
            its_CrvKS[2] ? strcpy(its_CrvNm[k], #its_CrvKN);
            its_CrvKS[3] ? (
                b[its_Crv_N] = its_CrvTN;
                memcpy(b + its_Crv_Pts, its_CrvTP, 3 * its_CrvTN);
                b[its_Crv_Pts + 3 * its_CrvTN - 1] = 0; // (the last point starts no segment)
                b[its_Crv_Sel] = -1; b[its_Crv_Sus] = -1;
            );
            its_CrvKS[4] ? (b[its_Crv_Sus] = its_CrvK[4] - 1);
            its_Crv_Clamp(b);
        );
    );
);

// the name of the curve "k" (or its number) in "str"
function its_Crv_Name(str, k)
(
    (strlen(its_CrvNm[k]) > 0) ? strcpy(str, its_CrvNm[k]) : sprintf(str, "%d", k + 1);
    str;
);

/*
    the name of the curve "k" in "str", in the syntax of table : as is if it is the text of a symbol (1 ... 8 letters, digits,
    _, not a digit first ; not a reserved word), else between double quotes ; its number if it has no name
*/
function its_Crv_TbName(str, k) local(nm, l, i, c, ok)
(
    (its_Xp_On === 1) ? (its_XpCrU[k] = 1); // (a patch : the curves it uses ; without a name, one for the patch)
    nm = its_CrvNm[k]; l = strlen(nm);
    (l === 0) ? (
        ((its_Xp_On === 1) && (its_CrvBlk[k] > BASE_MEMORY)) ? sprintf(str, "\"%s-%d\"", #its_XpCB, k + 1) : sprintf(str, "%d", k + 1);
    ) : (
        ok = (l <= 8); i = 0;
        while (ok && (i < l)) (
            c = str_getchar(nm, i, 'cu');
            ok = ((c >= 'A') && (c <= 'Z')) || ((c >= 'a') && (c <= 'z')) || (c === '_') || ((i > 0) && (c >= '0') && (c <= '9'));
            i += 1;
        );
        (ok && its_Tb_IsName(mSL_symbol(nm))) ? strcpy(str, nm) : sprintf(str, "\"%s\"", nm);
    );
    str;
);

// Dump Curve id : "Curve id type T [periodic On] [sustain n] points x y c ..."
function its_Crv_Dump(k) local(b, p)
(
    b = its_CrvBlk[k];
    sprintf(#its_TbW, "Curve %s type %s", its_Crv_TbName(#its_TbV, k), its_CrvTyN[b[its_Crv_Type]]);
    (b[its_Crv_Flags] & its_CrvFl_Periodic) ? strcat(#its_TbW, " periodic On");
    (b[its_Crv_Sus] >= 0) ? strcat(#its_TbW, sprintf(#its_TbV1, " sustain %d", b[its_Crv_Sus] + 1));
    strcat(#its_TbW, " points");
    p = b + its_Crv_Pts;
    loop(b[its_Crv_N], strcat(#its_TbW, sprintf(#its_TbV1, " %.6g %.6g %.6g", p[0], p[1], p[2])); p += 3;);
    its_Tb_Out(#its_TbW);
);

/*
    Export : the curve "k" (all the curves if k < 0) in a file of the folder of the project, written by GMAuxiliary.eel
    (command 30, as the export of the log) : Curve-name-date.mSL, or Curves-date.mSL ; it is an mSL script (table) :
    dropped on Interstys, it creates the curves again (the same names ; a curve without a name : the same number)
*/
function its_Crv_EFn(dst, i, str) local(l, j)
(
    l = strlen(str); j = 0;
    loop(l, gmem[dst + i] = str_getchar(str, j, 'cu'); i += 1; j += 1;);
    i;
);
function its_Crv_ELine(j)
(
    j = mSL_g6packStr(infoBStarts, #its_CrvEL, j, infoBSize, 1);
    (j >= infoBSize - 8) ? (its_CrvEOv = 1);
    j;
);
function its_Crv_Export(k) local(i, j, n, b, p, q, c, cnt, ss, dst)
(
    (gmem[versionGMScript] == 0) ? (
        mSL_log(SysLogBox, "Curves : export : no auxiliary script (GMAuxiliary.eel)");
    ) : (
        // the name of the file : one character per word (see sysout)
        ss = nowIs(); // dd/mm/yyyy hhhmm'ss" (see edTimeL)
        strcpy(#its_CrvEN, (k >= 0) ? "Curve-" : "Curves-");
        (k >= 0) ? (
            // (the name : not a letter, a digit, - or _ -> '_')
            its_Crv_Name(#its_TbV, k);
            i = 0; loop(strlen(#its_TbV),
                c = str_getchar(#its_TbV, i, 'cu');
                !(((c >= 'A') && (c <= 'Z')) || ((c >= 'a') && (c <= 'z')) || ((c >= '0') && (c <= '9')) || (c === '-') || (c === '_')) ?
                    str_setchar(#its_TbV, i, '_', 'cu');
                i += 1;
            );
            strcat(#its_CrvEN, #its_TbV); strcat(#its_CrvEN, "-");
        );
        sprintf(#its_CrvED, "%s-%s-%s-%s", strcpy_substr(#its_TbV1, ss, 6, 4), strcpy_substr(#its_TbV2, ss, 3, 2),
            strcpy_substr(#its_TbV3, ss, 0, 2), strcpy_substr(#its_TbV4, ss, 11, 8));
        // (the time of nowIs : 18h40'12) : not a digit -> '-'
        i = 0; loop(strlen(#its_CrvED),
            ((str_getchar(#its_CrvED, i, 'cu') < '0') || (str_getchar(#its_CrvED, i, 'cu') > '9')) ? str_setchar(#its_CrvED, i, '-', 'cu');
            i += 1;
        );
        strcat(#its_CrvEN, #its_CrvED); strcat(#its_CrvEN, ".mSL");
        dst = xplStr2;
        i = its_Crv_EFn(dst, 0, #its_CrvEN);
        gmem[dst + i] = 0;
        // the text : the script
        its_CrvEOv = 0; j = 0; cnt = 0;
        sprintf(#its_CrvEL, "// Interstys : %s, exported the %s ; dropped on Interstys, this script creates %s again",
            (k >= 0) ? "a curve" : "the curves", ss, (k >= 0) ? "it" : "them");
        j = its_Crv_ELine(j);
        strcpy(#its_CrvEL, "var r = table(data( Interstys"); j = its_Crv_ELine(j);
        i = (k >= 0) ? k : 0;
        loop((k >= 0) ? 1 : its_CrvMx,
            ((b = its_CrvBlk[i]) > BASE_MEMORY) ? (
                (b[its_Crv_Sus] >= 0) ? sprintf(#its_TbV1, "  sustain %d", b[its_Crv_Sus] + 1) : strcpy(#its_TbV1, "");
                sprintf(#its_CrvEL, "    Curve %s  type %s%s%s  points", its_Crv_TbName(#its_TbV, i),
                    its_CrvTyN[b[its_Crv_Type]], (b[its_Crv_Flags] & its_CrvFl_Periodic) ? "  periodic On" : "",
                    #its_TbV1);
                j = its_Crv_ELine(j);
                n = b[its_Crv_N]; p = b + its_Crv_Pts;
                while (n > 0) (
                    // 6 points per line
                    strcpy(#its_CrvEL, "       ");
                    q = 0; loop(min(6, n), strcat(#its_CrvEL, sprintf(#its_TbV1, "  %.6g %.6g %.6g", p[0], p[1], p[2])); p += 3; q += 1;);
                    n -= q;
                    j = its_Crv_ELine(j);
                );
                cnt += 1;
            );
            i += 1;
        );
        strcpy(#its_CrvEL, "));"); j = its_Crv_ELine(j);
        sprintf(#its_CrvEL, "print(sprintf(0, \"Interstys : %d curve%s read (table : %%d)\", r));", cnt, (cnt > 1) ? "s" : "");
        j = its_Crv_ELine(j);
        its_CrvEOv ? (
            mSL_log(SysLogBox, "Error 2798 : Curves : export : the text is too long (infoBSize), nothing is written");
        ) :
        (cnt === 0) ? (
            mSL_log(SysLogBox, "Curves : export : no curve");
        ) : (
            gmem[scptPar2] = xplStr2;
            gmem[scptPar3] = infoBStarts;
            // the command first, the dates last : the script (another thread) starts on the dates
            gmem[cmndKode] = 30;
            gmem[dateRqst] = gmem[dateCfrm] = time_precise() + timeD;
            sprintf(#its_CrvEL, "Curves : %d curve%s exported in %s (folder of the project)", cnt, (cnt > 1) ? "s" : "", #its_CrvEN);
            mSL_log(SysLogBox, #its_CrvEL);
        );
    );
);

// Check Curve id keys... : "Check Curve id OK", or an error 2759 for each difference
function its_Crv_Check() local(k, b, ok, i, n)
(
    k = its_Crv_Id(its_Tb_Next(), 0);
    its_Crv_Keys(k);
    ((its_Tb_error === 0) && (its_Tb_mode === 3) && (k >= 0)) ? (
        ok = 1;
        ((b = its_CrvBlk[k]) <= BASE_MEMORY) ? (
            ok = 0;
            sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Curve %d : no curve", k + 1);
            mSL_log(SysLogBox, #its_TbMsg);
        ) : (
            (its_CrvKS[0] && (b[its_Crv_Type] !== its_CrvK[0])) ? (
                ok = 0;
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Curve %d : type %s (expected %s)", k + 1,
                    its_CrvTyN[b[its_Crv_Type]], its_CrvTyN[its_CrvK[0]]);
                mSL_log(SysLogBox, #its_TbMsg);
            );
            (its_CrvKS[1] && (((b[its_Crv_Flags] & its_CrvFl_Periodic) !== 0) !== (its_CrvK[1] !== 0))) ? (
                ok = 0;
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Curve %d : periodic (expected %s)", k + 1, its_TbFStN[its_CrvK[1]]);
                mSL_log(SysLogBox, #its_TbMsg);
            );
            (its_CrvKS[2] && (strcmp(its_CrvNm[k], #its_CrvKN) !== 0)) ? (
                ok = 0;
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Curve %d : name \"%s\" (expected \"%s\")", k + 1,
                    its_CrvNm[k], #its_CrvKN);
                mSL_log(SysLogBox, #its_TbMsg);
            );
            (its_CrvKS[4] && ((b[its_Crv_Sus] + 1) !== its_CrvK[4])) ? (
                ok = 0;
                sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Curve %d : sustain %d (expected %d)", k + 1,
                    b[its_Crv_Sus] + 1, its_CrvK[4]);
                mSL_log(SysLogBox, #its_TbMsg);
            );
            its_CrvKS[3] ? (
                n = (b[its_Crv_N] === its_CrvTN);
                i = 0; while (n && (i < 3 * its_CrvTN - 1)) ( (abs(b[its_Crv_Pts + i] - its_CrvTP[i]) >= 0.000001) ? (n = 0); i += 1; );
                !n ? (
                    ok = 0;
                    sprintf(#its_TbMsg, "ERR: 2759    Interstys table : Check Curve %d : points differ (%d points)", k + 1, b[its_Crv_N]);
                    mSL_log(SysLogBox, #its_TbMsg);
                );
            );
        );
        ok ? (
            sprintf(#its_TbW, "Check Curve %d OK", k + 1);
            mSL_log(SysLogBox, #its_TbW);
        ) : (
            (its_Tb_res === 0) ? (its_Tb_res = 2759);
        );
    );
);

// Free Curve id
function its_Crv_Free() local(k)
(
    k = its_Crv_Id(its_Tb_Next(), 0);
    ((its_Tb_error === 0) && (k >= 0)) ? (
        (its_Tb_mode === 2) ? ( its_CrvSimU[k] = 0; strcpy(its_CrvSimN[k], ""); ) :
        (its_Tb_mode === 3) ? (
            (its_CrvBlk[k] > BASE_MEMORY) ? mSL_Dyn_Free(its_CrvBlk[k]);
            its_CrvBlk[k] = 0; strcpy(its_CrvNm[k], "");
        );
    );
);


//—— Effects

/*
    the options of a modulation input after its source, in any order : depth d, att a, law Add|Scale|Oct|dB, shape Lin|Exp|Log
    and Curve id, polarity Bi|Uni, bypass Off|On, doppler Off|On (the offset of a reader : modes Delay and Read) ; its_Tb_v3
    the depth, its_Tb_v4 the attenuverter (Undef : not given), its_Tb_v5 the flags given (its_Mod_Flags), its_Tb_v6 their
    mask ; "kd" the law of the input (its_ModK_...), "nm" its name : an action it does not have is an error, its default
    action gives 0 (see its_Mod_Law)
*/
function its_Tb_ModOpts(kd, nm) local(w, r, k)
(
    its_Tb_v5 = its_Tb_v6 = 0;
    r = 1;
    while (r && (its_Tb_error === 0)) (
        w = its_Tb_Peek();
        (w === its_TK_depth) ? ( its_Tb_Next(); its_Tb_v3 = its_Tb_Num("depth", 0, 100); ) :
        (w === its_TK_att) ? ( its_Tb_Next(); its_Tb_v4 = its_Tb_Num("att", -10, 10); ) :
        (w === its_TK_law) ? (
            its_Tb_Next();
            ((k = its_Tb_Enum("law", its_TbMLaw + 1, 4) + 1) > 0) ? (
                (((kd >> 3) & (1 << k)) === 0) ? (
                    sprintf(#its_TbW, "mod %s : the law %s is not possible", nm, its_TbMLawN[k]);
                    its_Tb_Err(2754, #its_TbW);
                );
                its_Tb_v5 = its_Tb_v5 - (its_Tb_v5 & 0x1C) + 4 * ((k === (kd & 7)) ? 0 : k);
                its_Tb_v6 |= 0x1C;
            );
        ) :
        (w === its_TK_shape) ? (
            its_Tb_Next();
            ((k = its_Tb_Enum("shape", its_TbMShp, 4)) >= 0) ? (
                its_Tb_v5 = its_Tb_v5 - (its_Tb_v5 & 0x3F60) + 32 * k;
                its_Tb_v6 |= 0x3F60;
                // Curve : its number or its name (-2 : a name known from pass 2, see its_Crv_Id)
                (k === its_ModS_Crv) ? (
                    k = its_Crv_Id(its_Tb_Next(), 0);
                    its_Tb_v5 += 256 * max(0, k);
                );
            );
        ) :
        (w === its_TK_polarity) ? (
            its_Tb_Next();
            ((k = its_Tb_Enum("polarity", its_TbMPol, 2)) >= 0) ? (
                its_Tb_v5 = its_Tb_v5 - (its_Tb_v5 & its_ModF_Uni) + k * its_ModF_Uni;
                its_Tb_v6 |= its_ModF_Uni;
            );
        ) :
        (w === its_TK_bypass) ? (
            its_Tb_Next();
            ((k = its_Tb_Enum("bypass", its_TbFSt, 2)) >= 0) ? (
                its_Tb_v5 = its_Tb_v5 - (its_Tb_v5 & its_ModF_Byp) + k * its_ModF_Byp;
                its_Tb_v6 |= its_ModF_Byp;
            );
        ) :
        (w === its_TK_doppler) ? (
            its_Tb_Next();
            ((k = its_Tb_Enum("doppler", its_TbFSt, 2)) >= 0) ? (
                ((kd & its_ModK_Dop) === 0) ? (
                    sprintf(#its_TbW, "mod %s : doppler is only for the offset of a reader", nm);
                    its_Tb_Err(2754, #its_TbW);
                );
                its_Tb_v5 = its_Tb_v5 - (its_Tb_v5 & its_ModF_Dop) + k * its_ModF_Dop;
                its_Tb_v6 |= its_ModF_Dop;
            );
        ) :
        (r = 0);
    );
);

// the text of a modulation in a table : the input "nm", the source "v1" (its channel "v2"), then if it is connected the
// depth "v3", the attenuverter "v4" (Undef : not given), the law "v5" (the flags of its_Mod_Flags) when it is not the default one
function its_Tb_ModText(str, nm, v1, v2, v3, v4, v5)
local (a, c)
(
    sprintf(str, "%s ", nm);
    strcat(str, its_Tb_SrcText(#its_TbV3, v1, v2));
    (v1 !== 0) ? (
        (v3 !== Undef) ? strcat(str, sprintf(#its_TbV3, " depth %.10g", v3));
        (v4 !== Undef) ? strcat(str, sprintf(#its_TbV3, " att %.10g", v4));
        ((a = (v5 >> 2) & 7) > 0) ? strcat(str, sprintf(#its_TbV3, " law %s", its_TbMLawN[a]));
        ((a = (v5 >> 5) & 3) > 0) ? (
            strcat(str, sprintf(#its_TbV3, " shape %s", its_TbMShpN[a]));
            (a === its_ModS_Crv) ? ( c = (v5 >> 8) & 63; strcat(str, " "); strcat(str, its_Crv_TbName(#its_TbV5, c)); );
        );
        (v5 & its_ModF_Uni) ? strcat(str, " polarity Uni");
        (v5 & its_ModF_Byp) ? strcat(str, " bypass On");
        (v5 & its_ModF_Dop) ? strcat(str, " doppler On");
    );
    str;
);

// the modulation input "p" (its_Mod_...) : its_Tb_g1 its source, its_Tb_g2 its channel, its_Tb_g3 the depth, its_Tb_g4 the
// attenuverter, its_Tb_g5 the flags of its law (as given in a table : its_Tb_ModOpts)
function its_Tb_ModGet(p)
(
    its_Tb_g2 = p[its_Mod_Off]; its_Tb_g3 = p[its_Mod_Depth]; its_Tb_g4 = p[its_Mod_Att];
    its_Tb_g5 = p[its_Mod_Flags] & (its_ModF_Law | its_ModF_Byp | its_ModF_Dop);
    its_Tb_g1 = p[its_Mod_Src];
);

// pass 3 : the modulation input "p" set from the key "ki" (its_TbK1 ... its_TbK6) ; a new connection gets the attenuverter
// 1 and the default depth "d0" (as in the pad)
function its_Tb_ModSet(p, ki, d0)
(
    (its_TbK1[ki] === 0) ? (
        p[its_Mod_Src] = p[its_Mod_Off] = 0;
    ) : (
        (p[its_Mod_Src] === 0) ? (
            p[its_Mod_Att] = 1;
            (p[its_Mod_Depth] === 0) ? (p[its_Mod_Depth] = d0);
        );
        p[its_Mod_Src] = its_TbK1[ki]; p[its_Mod_Off] = its_TbK2[ki];
    );
    (its_TbK3[ki] !== Undef) ? (p[its_Mod_Depth] = its_TbK3[ki]);
    (its_TbK4[ki] !== Undef) ? (p[its_Mod_Att] = its_TbK4[ki]);
    (its_TbK6[ki] !== 0) ? (p[its_Mod_Flags] = p[its_Mod_Flags] - (p[its_Mod_Flags] & its_TbK6[ki]) + its_TbK5[ki]);
);

// VU meter : the index of a saturation threshold (dB : -20, -6, -2, -1, 0, 1, 2, 6, 20), of an auto clear (minutes : 0, 1,
// 3, 5) ; -1 : not one of them
function its_Tb_VuThrIdx(v) local(k, r)
(
    r = -1; k = 0; loop(9, (vu_ThrDb(k) == v) ? (r = k); k += 1;);
    r;
);
function its_Tb_VuHoldIdx(v) local(k, r)
(
    r = -1; k = 0; loop(4, (vu_HoldS(k) == v * 60) ? (r = k); k += 1;);
    r;
);

