                    (k === 2) ? 1 / (i + 1) :
                    (k === 3) ? ((i & 1) === 0) / sqr(i + 1) :
                    (k === 4) ? ((i === 0) ? 1 : ((i & 1) === 1) / (i + 1)) :
                    (k === 5) ? rand(2) - 1 : 0;
