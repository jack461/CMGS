                (ty === its_RdrLoopTypeCatch) ? (
                    // Normal read, is catched by a loop
                    ((k >= reader[its_Rdr_RegEIn]) && (k < reader[its_Rdr_RegEOut]) && (v >= 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegSOut]; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    ((k < reader[its_Rdr_RegSIn]) && (k >= reader[its_Rdr_RegSout]) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegEOut]; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeLoop) ? (
                    // immediately catched by the loop
                    (((k >= reader[its_Rdr_RegEIn]) || (k < reader[its_Rdr_RegSOut])) && (v >= 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegSOut]; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    (((k < reader[its_Rdr_RegSIn]) || (k > reader[its_Rdr_RegEOut])) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = reader[its_Rdr_RegEOut]; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeExit) ? (
                    // immediately catched by the loop
                    ((k >= reader[its_Rdr_RegEIn]) && (v >= 0)) ? (
                        // Time to start the end cross fade
                        reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    ) :
                    ((k < reader[its_Rdr_RegSIn]) && (v < 0)) ? (
                        // Time to start a cross fade
                        reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                        F = reader[its_Rdr_XFadeCntNxt];
                        s = 1;
                    );
                ) :

                (ty === its_RdrLoopTypeStop) ? (
                    reader[its_Rdr_Abspos] = LOW_VALUE; // will X-fade with this
                    F = reader[its_Rdr_XFadeCntNxt];
                    s = 1;
                );

                (s === 0) ? (
                    // we may be at some end and need to loop
                    (ty !== its_RdrLoopTypeOnce) ? (
                        // loop at the end
                        ((k >= reader[its_Rdr_Last] - B_FADESIZ) && (v >= 0)) ? (
                            F = reader[its_Rdr_BFadeCntNxt];
                            // start cross fading
                            reader[its_Rdr_Abspos] = k - reader[its_Rdr_SmplCnt];
                            s = 1;
                        ) :
                        ((k < reader[its_Rdr_Start] + B_FADESIZ) && (v < 0)) ? (
                            F = reader[its_Rdr_BFadeCntNxt];
                            // start cross fading
                            reader[its_Rdr_Abspos] = k + reader[its_Rdr_SmplCnt];
                            s = 1;
                        );
                    ) :
                    (
                        // Stop at the end
                        ((k >= reader[its_Rdr_Last] - B_FADESIZ) && (v >= 0)) ? (
                            F = reader[its_Rdr_BFadeCntNxt];
                            // start fading, stop at the end
                            reader[its_Rdr_Abspos] = LOW_VALUE;
                            reader[its_Rdr_Tmp3] += 1;
                            s = 1;
                        ) :
                        ((k < reader[its_Rdr_Start] + B_FADESIZ) && (v < 0)) ? (
                            F = reader[its_Rdr_BFadeCntNxt];
                            // start fading, stop at the end
                            reader[its_Rdr_Abspos] = LOW_VALUE;
                            reader[its_Rdr_Tmp3] += 1;
                            s = 1;
                        );
                    );
                );

                (s) ? (
                    reader[its_Rdr_Tmp4] += 1;
                    reader[its_Rdr_AbsAuxpos] = k; // previous read position becomes the new aux
                    reader[its_Rdr_XFadeCnt] = F; // start counting
                    reader[its_Rdr_XFadeIncr] = SINUS_TABLE_SIZE / reader[its_Rdr_XFadeCnt];
