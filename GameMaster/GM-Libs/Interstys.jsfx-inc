            );
            (kd > 0) ? ( p[12] += kd * (u - p[12]); u = p[12]; );
            (kh > 0) ? ( p[13] += kh * (u - p[13]); u -= p[13]; );
            (rm > 0) ? (
                x = a * r0 + ((b > 0) ? b * (rand(2) - 1) : 0);
                p[16] += rk * (x - p[16]); p[17] += rk * (p[16] - p[17]);
                // the swell : from p[18] to p[19] (smoothstep), p[20] its phase
                ((p[20] += sw) >= 1) ? ( p[20] -= 1; p[18] = p[19]; p[19] = rand(1); );
                s = p[20]; s = s * s * (3 - 2 * s);
                u = (1 - rm) * u + rm * its_Nz_Knee(rg * (p[18] + (p[19] - p[18]) * s) * p[17]);
            );
            !(abs(u) < its_FinMax) ? ( memset(p + 7, 0, its_NzCW - 7); u = 0; its_NaNCnt += 1; );
            out[c] += lv * u;
            c += 1; p += its_NzCW;
        );
    );
);

// a tangent for the coefficients of the Phaser (Padé 3/2 : x (15 - x²) / (15 - 6 x²), x in [0, 0.45 pi] : 3 % low at the top
// (the frequency a little lower), the stages stay stable)
