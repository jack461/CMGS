menu_Lin_Status_N[1] = "Ready";
menu_Lin_Status = make_jmenu(
    ui_jmenu_typ_sel | ui_jmenu_opt_rndrect | ui_jmenu_opt_rclick | ui_jmenu_opt_notitle,
            "line-status", 2, menu_Lin_Status_N);

