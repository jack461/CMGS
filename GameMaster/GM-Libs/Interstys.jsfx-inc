                            // low pass, high pass : Q of the stage k of a Butterworth filter of order 2 * ns, the last one
                            // (the highest Q) multiplied by the resonance ; band pass, notch : the same stages
                            qk = ((md === its_FltLP) || (md === its_FltHP)) ?
