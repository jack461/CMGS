//====== Scheduler management ======
while (g__ent = Scheduler()) (
    AAAA_Sch_code = code = SchedCode[g__ent];
    AAAA_Sch_par1 = par1 = SchedPar1[g__ent];
    AAAA_Sch_par2 = par2 = SchedPar2[g__ent];
