function show_local_Infos()
local (uix_jneed, uix_jmini, h1, k, w, siz, u_ch, ent)
(
    (gui_show_syslog && gui_show_memory) ? (
        SysLogBox[4] = 20;
        memoryBox1[17] = memoryBox2[17] = 52;
    ) :
    (gui_show_syslog) ? (
        SysLogBox[4] = 80;
    ) :
    (gui_show_memory) ? (
        memoryBox1[17] = memoryBox2[17] = 96;
    );
);



/*
   Display a log/trace
*/
function show_SysLog(blnb, box)
local (h1, h3, disps, mini, avail, uix_jneed, uix_jmini, ptr, nc, as, fl, flg, zzmi, xx, ii, u_ch, siz, dep, had, thgh)
(
    disps = box[4]; mini = 2;
    h1 = uix_jBoxHeight(mini);
    h3 = uix_jBoxHeight(disps);
    // (box[6] <= 0) ? box[6] = ui_jd_tboxs;
    uix_jneed = h3 + ui_jd_delta2 + ui_jd_ctgr;
    uix_jmini = max(h1 + ui_jd_ctgr, ui_jd_min_block);
    (ui_height() >= uix_jmini) ? (
        ui_split_top(uix_jneed);
            //ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            zzmi = ui_hover();
            keepBlockInfos(blnb);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
            );
            control_group("Script Syslog");
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);
            ui_align(0,0);
            as = box[2]; // array size
            fl = box[1]; // first line
            xx = control_jmenu(menu_uix_jlog);
            (xx > 0) ? (
                (xx === 1) ? (
                    box[5] = 1;
                ) :
                (xx === 2) ? (
                    box[5] = 2;
                ) :
                (xx === 3) ? (
                    box[5] = 3;
                ) :
                (xx === 4) ? (
                    box[5] = 4;
                ) :
                (xx === 5) ? (
                    box[5] = 5;
                ) :
                (xx === 6) ? (
                    box[5] = 6;
                ) :
                (xx === 7) ? (
                    box[5] = 7;
                ) :
                (xx === 8) ? (
                    box[5] = 8;
                ) :
                (xx === 9) ? (
                    box[6] = min(20, box[6]+1);
                ) :
                (xx === 10) ? (
                    box[6] = max(0, box[6]-1);
                ) :
                (xx === 11) ? (
                    mSL_log(box, "");
                ) :
                (xx === 12) ? (
                    ii = 0; loop(as,
                        strcpy(fl + ii, ""); ii += 1;
                    );
                );
            );

            (zzmi) ? (
                u_ch = GM_key_peek(); // the keys of the log (taken below if used)
                (u_ch != 0) ? (
                    sprintf(#gfx_uc, "Keyed: '%c' [%d]", u_ch, kcnt); kcnt+= 1;
                    // mSL_log(SysLogBox, #gfx_uc);
                    (FlagsTbVals[Flgs_Traces] & 1) ? (
                        sprintf(#sq, "***Key  @  %d  %d  %d [%02x+%02x -> '%c']", mouse_x, mouse_y, mouse_cap, mouse_cap, u_ch, u_ch);
                        mSL_log(SysLogBox, #sq);
                    );
                    ((u_ch === ' ') || (u_ch ===  0x0d)) ? (mSL_log(box, " ");) :
                    (u_ch === 'm') ? (box[6] = min(20, box[6]+1);) :
                    (u_ch === 'l') ? (box[6] = max(0, box[6]-1);) :
                    (u_ch === 'z') ? (box[7] = 0;) :
                    (u_ch === 'k') ? (box[7] = max(0, box[7]-1);) :
                    (u_ch === 'j') ? (box[7] = (box[7]+1) % box[2];) :
                    (u_ch === 't') ? (nowTime(); mSL_log(SysLogBox, #nowis);) :
                    //(u_ch === 'v') ? (ShowConfig();) :
                    (u_ch === 'up') ? (box[7] = max(0, box[7]-10);) :
                    (u_ch === 'down') ? (box[7] = (box[7]+10) % box[2];) :
                    ((GM_key_mods() === 0) && (u_ch === 'left')) ? (box[7] = 0;) :
                    ((GM_key_mods() === 0) && (u_ch === 'rght')) ? (box[7] = (box[7]+100) % box[2];) :
                    (u_ch === '1') ? (box[5] = 1;) :
                    (u_ch === '2') ? (box[5] = 2;) :
                    (u_ch === '3') ? (box[5] = 3;) :
                    (u_ch === '4') ? (box[5] = 4;) :
                    (u_ch === '5') ? (box[5] = 5;) :
                    (u_ch === '6') ? (box[5] = 6;) :
                    (u_ch === '7') ? (box[5] = 7;) :
                    (u_ch === '8') ? (box[5] = 8;) :
                    (u_ch === 'p') ? (sysout(box);) : // log in a text file (see mSL_show_Utilities)
                    (u_ch === 'P') ? (sysout(box, 31);) : // the log in the console of GMAuxiliary.eel, to copy it
                    (u_ch = 0); // not a key of the log
                    GM_key_take(u_ch); // the key has been used
                );
            );
            nc = max(1, min(8, 0|box[5])); // number of columns to show
            nc = max(1, min(nc, floor(gfx_w/gfx_colL_width))); // narrow window: fewer columns

            ui_jshow_color = ui_jcolor_text;
            siz = box[2];
            dep = siz - 1; had = box[6];
            ptr = (box[3] + dep + 16*siz - box[7]) % siz; // last inserted line
            loop (nc,
                (nc != 0) ? ui_new_column(1/nc) : ui_new_column();
                nc = 0;
                ui_pad(3,0);ui_align(0, 0.5);
                ui_pcolor(ui_jshow_color);
                flg = 1;
                while (flg) (
                    /*
                    ui_jd_tboxh = had + ui_wraptext_height(#txt);
                    #txt = fl + ptr; // line to print
                    twdt = ui_text_width(#txt);
                    (twdt < wdth) ? (
                        (ui_height() >= ui_jd_tboxh) ? (
                            // put the string
                            uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                ui_pcolor(ui_jshow_color);
                                ui_wraptext(#txt);
                            ui_pop();
                            ptr = (ptr + dep) % siz;
                        ) : (
                            flg = 0;
                        );
                    ) : (
                    */
                    // Mono or Multi-line text
                    #txt = fl + ptr; // line to print
                    (strlen(#txt) === 0) ? #txt = " ";
                    thgh = ui_wraptext_height(#txt) + had;
                    (ui_height() >= thgh) ? (
                        // put the string
                        ui_split_top(thgh);
                            // ui_pcolor(ui_jshow_color);
                            ui_wraptext(#txt);
                        ui_pop();
                        ptr = (ptr + dep) % siz;
                    ) : (
                        flg = 0;
                    );
                    /*
                    lg = strlen(#txt);
                    k = max(1,ceil(lg / maxl));
                    (flg = (av = av - k) >= 0) ? (
                        (k === 1) ? (
                            // put the string
                            uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                ui_pcolor(ui_jshow_color);
                                ui_wraptext(#txt);
                            ui_pop();
                        ) : (
                            off = 0; sz = maxl;
                            while (k > 0) (
                                // cut the string in a few parts
                                strcpy_substr(#txt1,#txt, off, sz);
                                // put the string
                                uix_javail_Bheight -= ui_split_top(ui_jd_tboxh);
                                    // ui_pad(0,1,0,0);
                                    ui_pcolor(ui_jshow_color);
                                    ui_wraptext(#txt1);
                                ui_pop();
                                k -=1; off += maxl; sz = min(maxl, lg); lg -= sz;
                            );
                        );
                        ptr = (ptr + dep) % siz;
                    );
                    */
                );
            );
            ui_pop();


        ui_pop();
    );
);

// Markers of the heads on line "lcbl", for the next ui_audio_wave :
// green for the writers ; yellow for the readers (orange for the auxiliary head during a cross fade)
// rdrsel : number of the reader to show, or -1 for all the readers (each marker then shows the reader number)
function its_wave_marks(lcbl, rdrsel)
local (i, x, m, p, lab)
(
    its_wave_colors();
    i = 0; loop(WR_CNT,
        (((x = Writers_set[i]) != 0) && (x[its_Wrt_Lcbl] == lcbl) && (x[its_Wrt_Status] == its_WrtStat_Writing)) ? (
            ui_audio_mark(x[its_Wrt_Abspos], its_WaveColWrt, -(i + 1)); // numbered at the bottom (several writers may write the line)
        );
        i += 1;
    );
    i = 0; loop(RD_CNT,
        (((rdrsel < 0) || (rdrsel == i)) && ((x = Readers_set[i]) != 0) && (x[its_Rdr_Lcbl] == lcbl)
            && ((x[its_Rdr_Status] == its_RdrStat_Reading) || (x[its_Rdr_Status] == its_RdrStat_Paused))) ? ( // paused : its position too
            lab = (rdrsel < 0) ? i + 1 : 0;
            // delay mode : a single read position (its multi and x-fade positions are not used)
            m = 0; loop((x[its_Rdr_Mode] === its_RdrMode_Delay) ? 1 : max(1, min(its_RdrMaxMulti, x[its_Rdr_MultiCnt])),
                // (very) negative positions are used for fade in / fade out : no marker
                ((p = x[its_Rdr_Abspos + m]) >= 0) ? ui_audio_mark(p, its_WaveColRdr, lab);
                ((x[its_Rdr_XFadeCnt + m] > 0) && (x[its_Rdr_Mode] !== its_RdrMode_Delay) && (x[its_Rdr_Status] == its_RdrStat_Reading)) ? (
                    ((p = x[its_Rdr_AbsAuxpos + m]) >= 0) ? ui_audio_mark(p, its_WaveColAux, lab);
                );
                m += 1;
            );
        );
        i += 1;
    );
);

// Waveform of the channels read by reader "rcbl" (number "rdr") in line "lcbl", zoom in [1, 100]
// The region (if it does not cover the whole line) and the zoom work in all the reading modes, so that the
// limits can be set before switching to a loop mode : the zoom goes from the whole line to [its_Rdr_RegSOut, its_Rdr_RegEOut)
function its_wave_reader(lcbl, rcbl, rdr, zoom, flags)
local (fa, fb, ra, rb, nch, ch0)
(
    its_wave_colors();
    fa = lcbl[its_Lin_Start]; fb = lcbl[its_Lin_Last];
    ra = rcbl[its_Rdr_RegSOut]; rb = rcbl[its_Rdr_RegEOut];
    // only when the region is smaller than the line (for the whole line, RegSOut = Start and RegEOut = Last)
    ((ra > fa + 1) || (rb < fb - 1)) ? (
        ui_audio_band(rcbl[its_Rdr_RegSIn], rcbl[its_Rdr_RegEIn], its_WaveColReg, 0.25);
        ui_audio_mark(ra, its_WaveColRegLim);
        ui_audio_mark(rb, its_WaveColRegLim);
    );
    ui_audio_zoom(fa, fb, ra, rb, zoom); // the whole line if the region covers it (or is not defined)
    its_wave_marks(lcbl, rdr);
    ch0 = max(0, min(lcbl[its_Lin_ChCnt] - 1, rcbl[its_Rdr_Bf1stChan]));
    nch = max(0, min(rcbl[its_Rdr_BfChanUsed], lcbl[its_Lin_ChCnt] - ch0)); // only the channels read
    ui_aud_chan0 = ch0; // each channel keeps the color of its number in the line
    ui_audio_wave(0, nch, lcbl + its_Lin_BF1ST + ch0, lcbl[its_Lin_ActBSize],
        ui_aud_za, ui_aud_zb, flags, its_LinWaveMax);
);


/*
    Pads helpers : the sources and destinations (see its_Src_Cell, its_Out_Cell)
*/
// label of the source "src" (kind * ITS_KMul + number), first channel "off", in the string "str"
function its_Src_Label(str, src, off)
local (k, n)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    (src === 0) ? strcpy(str, "none") :
    (k === ITS_KIn) ? sprintf(str, "In:%d", off) :
    (k === ITS_KOut) ? sprintf(str, "Out:%d", off) :
    (k === ITS_KBus) ? sprintf(str, "Bus %d:%d", n + 1, off) :
    (k === ITS_KCtl) ? sprintf(str, "Ctl %d", n + 1 + off) :
    (k === ITS_KRdr) ? ((off > 0) ? sprintf(str, "R%d:%d", n + 1, off) : sprintf(str, "Reader %d", n + 1)) :
    (k === ITS_KFx) ? ((off > 0) ? sprintf(str, "E%d:%d", n + 1, off) : sprintf(str, "Effect %d", n + 1)) :
    strcpy(str, "???");
);

// label of the destination "dst" of an output (0 : own cable)
function its_Out_Label(str, dst, off)
(
    (dst === 0) ? strcpy(str, "Own cable") : its_Src_Label(str, dst, off);
);

// item of menu_Src_Ids for the source "src", first channel "off" (0 : not in the menu) ; the source of the item "r"
// items : 1 None, 2 ... In:0 ..., then Out:0 ..., the buses, the controls, the readers, the effects
function its_Src_MenuIdx(src, off)
local (k, n)
(
    k = floor(src / ITS_KMul);
    n = src - k * ITS_KMul;
    (src === 0) ? 1 :
    (k === ITS_KIn) ? ((off < ITS_MNCH) ? 2 + off : 0) :
    (k === ITS_KOut) ? ((off < ITS_MNCH) ? 2 + ITS_MNCH + off : 0) :
    (k === ITS_KBus) ? 2 + 2 * ITS_MNCH + n :
    (k === ITS_KCtl) ? ((n + off < NB_GSL) ? 2 + 2 * ITS_MNCH + NB_BUS + n + off : 0) :
    (k === ITS_KRdr) ? 2 + 2 * ITS_MNCH + NB_BUS + NB_GSL + n :
    (k === ITS_KFx) ? 2 + 2 * ITS_MNCH + NB_BUS + NB_GSL + RD_CNT + n : 0;
);
// the source of the item "r" ; its first channel in its_Src_ChOff (0 for a bus, a control, a reader, an effect)
function its_Src_FromIdx(r)
(
    its_Src_ChOff = 0;
    (r <= 1) ? 0 :
    (r < 2 + ITS_MNCH) ? (its_Src_ChOff = r - 2; ITS_KIn * ITS_KMul) :
    (r < 2 + 2 * ITS_MNCH) ? (its_Src_ChOff = r - 2 - ITS_MNCH; ITS_KOut * ITS_KMul) :
    (r < 2 + 2 * ITS_MNCH + NB_BUS) ? ITS_KBus * ITS_KMul + r - 2 - 2 * ITS_MNCH :
    (r < 2 + 2 * ITS_MNCH + NB_BUS + NB_GSL) ? ITS_KCtl * ITS_KMul + r - 2 - 2 * ITS_MNCH - NB_BUS :
    (r < 2 + 2 * ITS_MNCH + NB_BUS + NB_GSL + RD_CNT) ? ITS_KRdr * ITS_KMul + r - 2 - 2 * ITS_MNCH - NB_BUS - NB_GSL :
    ITS_KFx * ITS_KMul + r - 2 - 2 * ITS_MNCH - NB_BUS - NB_GSL - RD_CNT;
);

// menu of the sources, "src" (first channel "off") ticked ; returns the source chosen (0 : none), -1 if no choice ;
// the first channel chosen is in its_Src_ChOff
function its_Src_Choose(src, off)
local (k, xx, res)
(
    res = -1;
    ui_menu_tick(menu_Src_Ids, -1, 0);
    ((k = its_Src_MenuIdx(src, off)) > 0) ? ui_menu_tick(menu_Src_Ids, k, 1);
    xx = control_jmenu(menu_Src_Ids);
    (xx != 0) ? (res = its_Src_FromIdx(xx));
    ui_menu_tick(menu_Src_Ids, -1, 0);
    res;
);

// menu of the destinations of an output, "dst" (first channel "off") ticked ; returns the destination chosen
// (0 : own cable), -1 if no choice ; the first channel chosen is in its_Src_ChOff (0 for the own cable, a bus)
// items : 1 own cable, 2 ... Out:0 ..., then the buses
function its_Dst_Choose(dst, off)
local (k, n, xx, res)
(
    res = -1;
    k = floor(dst / ITS_KMul);
    n = dst - k * ITS_KMul;
    ui_menu_tick(menu_Dst_Ids, -1, 0);
    k = (dst === 0) ? 1 : (k === ITS_KOut) ? ((off < ITS_MNCH) ? 2 + off : 0) : 2 + ITS_MNCH + n;
    (k > 0) ? ui_menu_tick(menu_Dst_Ids, k, 1);
    xx = control_jmenu(menu_Dst_Ids);
    (xx != 0) ? (
        its_Src_ChOff = 0;
        res = (xx === 1) ? 0 :
            (xx < 2 + ITS_MNCH) ? (its_Src_ChOff = xx - 2; ITS_KOut * ITS_KMul) :
            ITS_KBus * ITS_KMul + xx - 2 - ITS_MNCH;
    );
    ui_menu_tick(menu_Dst_Ids, -1, 0);
    res;
);

// menu of the first channel [0 ... 127], "off" ticked ; returns the channel chosen, -1 if no choice
function its_Off_Choose(off)
local (xx, res)
(
    res = -1;
    ui_menu_tick(menu_128_0_Ids, -1, 0);
    ui_menu_tick(menu_128_0_Ids, off + 1, 1);
    xx = control_jmenu(menu_128_0_Ids);
    (xx != 0) ? (res = xx - 1);
    ui_menu_tick(menu_128_0_Ids, -1, 0);
    res;
);

/*
    The modulation inputs, in the pads (reader, writer : a line of their own ; effects : cells of the line of their type)
    right clic : the source ; left clic : shows / hides the slider of the attenuverter ; shift + left clic : the channel
    the depths and the attenuverters are sliders of the module
*/
// the cells [c0 ... c0+n-1] of a pad ("labs", "colrs") show the "n" inputs "mp", named "names" ("okm" : see its_Mod_Used)
function its_Mod_Fill(labs, colrs, c0, mp, n, names, okm)
local (j, p)
(
    j = 0; loop(n,
        p = mp + j * its_ModDist;
        its_Src_Label(#modsrc, p[its_Mod_Src], p[its_Mod_Off]);
        ((p[its_Mod_Src] !== 0) && (p[its_Mod_Att] !== 1)) ? (
            sprintf(labs[c0 + j], "%s: %s x%.2f", names[j], #modsrc, p[its_Mod_Att]);
        ) : (
            sprintf(labs[c0 + j], "%s: %s", names[j], #modsrc);
        );
        colrs[c0 + j] = ((okm & (1 << j)) === 0) ? Col_Inactive : (p[its_Mod_Src] !== 0) ? Col_P3 : Col_P1;
        j += 1;
    );
);

// a clic "ev" (mouse modifiers "jmc") on the input "j" of "mp" ; "defs" : the first depths ; returns 1 if the source changed
function its_Mod_Click(mp, j, ev, jmc, defs)
local (p, k, chg)
(
    chg = 0;
    p = mp + j * its_ModDist;
    (ev & ui_jpad_ev_rmc) ? (
        ((k = its_Src_Choose(p[its_Mod_Src], p[its_Mod_Off])) >= 0) ? (
            (p[its_Mod_Src] === 0) ? (p[its_Mod_Att] = 1); // a new connection : attenuverter 1
            p[its_Mod_Src] = k;
            p[its_Mod_Off] = its_Src_ChOff;
            (p[its_Mod_Depth] === 0) ? (p[its_Mod_Depth] = defs[j]);
            chg = 1;
        );
    ) :
    ((ev & ui_jpad_ev_lmc) && (jmc & shfCap)) ? (
        ((k = its_Off_Choose(p[its_Mod_Off])) >= 0) ? (
            p[its_Mod_Off] = k;
            chg = 1;
        );
    ) :
    (ev & ui_jpad_ev_lmc) ? (
        p[its_Mod_ShowAtt] = !p[its_Mod_ShowAtt];
    );
    chg;
);

// a line of its own for the "n" inputs "mp" (reader, writer) : 0 "Modulation", 1 ... n the inputs ; returns 1 if a source changed
function its_Mod_Row(mp, n, names, okm, defs)
local (j, zz, zzmcl, jmc, chg)
(
    chg = 0;
    mSL_setStrArray(pad_RdM_Labs, pad_RdM_Siz);
    j = 0; loop(pad_RdM_Siz,
        pad_RdM_Colrs[j] = Col_InfoA;
        strcpy(pad_RdM_Labs[j], "");
        j += 1;
    );
    strcpy(pad_RdM_Labs[0], "Modulation");
    its_Mod_Fill(pad_RdM_Labs, pad_RdM_Colrs, 1, mp, n, names, okm);
    jmc = ui_jmouse_cap;
    zz = control_jpad(pad_RdMod);
    (zz > 0) ? (
        ui_GFXdoNow |= 4; ui_GFXReason = 34;
        zzmcl = pad_RdMod[ui_jpad_last] - 1;
        ((zzmcl >= 1) && (zzmcl <= n)) ? (chg = its_Mod_Click(mp, zzmcl - 1, zz, jmc, defs));
    );
    chg;
);

// count of the sliders of the inputs used : the depth, and the attenuverter if shown
function its_Mod_SlCount(mp, n, okm)
local (j, c)
(
    c = j = 0; loop(n,
        its_Mod_Used(mp, j, okm) ? (c += 1 + (mp[j * its_ModDist + its_Mod_ShowAtt] != 0));
        j += 1;
    );
    c;
);

// the sliders of the inputs used : depth (parameter "pd" + j ; right clic : no modulation), attenuverter if shown ("pa" + j ; right clic : 1)
function its_Mod_Sliders(mp, n, okm, pd, pa)
local (j, p, r)
(
    j = 0; loop(n,
        its_Mod_Used(mp, j, okm) ? (
            p = mp + j * its_ModDist;
            paramValues[pd + j] = p[its_Mod_Depth];
            r = parCtl(pd + j);
            (r != 0) ? (
                p[its_Mod_Depth] = (r === 8) ? 0 : parV(pd + j);
            );
            (p[its_Mod_ShowAtt]) ? (
                paramValues[pa + j] = p[its_Mod_Att];
                r = parCtl(pa + j);
                (r != 0) ? (
                    p[its_Mod_Att] = (r === 8) ? 1 : max(-10, min(10, parV(pa + j)));
                );
            );
        );
        j += 1;
    );
);

/*
   RDBL[0] = reader to display
   RDBL[1] = reader type
   RDBL[2] = UI Error
   RDBL[3] = Exec error
   RDBL[4] = Speed display option
   RDBL[5] = Neded sliders count
   RDBL[6] = region length size option
   RDBL[7] = region length option
   RDBL[8] = waveform height (0 : its_RdrWaveH)
   RDBL[9] = waveform zoom [1 .. 100] (slider "Zoom")
   RDBL[10] = waveform flags (its_WaveHide, its_WaveOver ; keys 'w', '+', '-', 'v' : see its_Wave_Keys)
*/
function show_Reader_Pad(RDBL, blockId)
local (x, h1, h2, h3, h4, uix_jneed, uix_jmini, rdr, rcbl, rok, lnb, lcbl, dfCol, zzmi, i, xx, w, k, r, jmc,
        rp, zi, zz, zzch, zzent, zzmcl, zzmmd, p1, p2, newlnb, rerr, spd, d1, clen, mvl, rgh, rsc, p)
(
    h2 = (RDBL[5] > 0) ? ui_jd_slidh * RDBL[5] + 6 : 0;
    // waveform, between the pad and the sliders, if the reader has a line
    rcbl = Readers_set[RDBL[0]];
    // delay mode : only the first 2 lines of the pad (no transport line)
    // (no reader yet : the mode chosen in cell 2, RDBL[1])
    h1 = uix_jpadHeight(((((rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read)) ? rcbl[its_Rdr_Mode] : RDBL[1]) === its_RdrMode_Delay) ? 2 : pad_Rdr_NL); // height
    h3 = ((rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read) && ((lcbl = rcbl[its_Rdr_Lcbl]) > BASE_MEMORY)
        && (lcbl[-2] === KW_lcbl)) ? its_Wave_H(RDBL + 8, RDBL + 10, its_RdrWaveH) : 0;
    h4 = ((rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read)) ? uix_jpadHeight(1) : 0; // the modulation inputs
    uix_jneed = h1+h2+h3+h4+ui_jd_ctgr;
    uix_jmini = h1+h2+h4+ui_jd_ctgr;
    (ui_height() >= uix_jmini) ? (
        ui_split_top(min(uix_jneed, ui_height()));
            ui_set_rect(ui_left(), ui_top(),max(ui_MinSize1Pane,min(ui_BestSize1Pane, ui_width())), ui_height());
            rdr = RDBL[0]; // number of reader to be displayed
            rcbl = Readers_set[rdr];
            rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
            zzmi = ui_hover();
            jmc = ui_jmouse_cap;
            keepBlockInfos(blockId);
            // 'd' : dump of the reader in the log (taken before the pad)
            (zzmi && GM_key_take('d')) ? GM_Dump(rcbl, its_Rdr_BlkSize, sprintf(#, "Reader %d", rdr+1));
            (zzmi) ? its_Wave_Keys(RDBL + 8, RDBL + 10, its_RdrWaveH);
            (zzmi) ? (
                ui_push();
                    // stack is now 2 levels deep
                    ui_color(Col_Frame);
                    ui_border(); // draws in purple
                ui_pop();
                (g__dpa != 0) ? (
                    // audio file droped here
                    sprintf(#s, "Reader::drop file : \"%s\" - %d, %d, %d", g__efs, g__msx, g__msy, g__msc);
                    mSL_log(SysLogBox, #s);
                    g__dpa = 0;
                    // should we create the reader ?
                    (!rok) ? (
                        // Create the reader
                        rcbl = Rd_Create(rdr);
                        rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
                    );
                    (rok) ? (
                        // Does this reader has a line ?
                        p1 = p2 = -1;
                        (((lnb = rcbl[its_Rdr_LineNb]) >= 0) && ((lcbl = rcbl[its_Rdr_Lcbl]) > BASE_MEMORY)
                            && (lcbl[-2] === KW_lcbl)) ? (
                            p1 = lnb; p2 = lcbl;
                        );
                        newlnb = File_Handle(g__efs, p1, p2);
                        ((newlnb >= 0)) ? (
                            // Update reader
                            Rd_Set_Line(rdr, newlnb+1);
                        );
                    );
                );
            );
            control_group(blockDispNames[blockDispInverts[blockId]]);
            ui_pad(0,ui_cg_pad_top,0,ui_cg_pad_bottom);

            ui_split_top(h1);
                ui_pad(1,2,2,2);
                mSL_setStrArray(pad_Rdr_Labs, pad_Rdr_Siz);

                CL1 = Color_Cornflower_Blue;
                (rok) ? (
                    dfCol = Col_InfoA ;
                    RDBL[5] = (rcbl[its_Rdr_Mode] === its_RdrMode_Delay) ? 2 : // delay mode : volume and offset only
                        (h3 > 0) ? 9 : 8; // + "Zoom" slider when the waveform is shown
                    // + the depths of the modulations used, and their attenuverters if shown
                    RDBL[5] += its_Mod_SlCount(rcbl + its_Rdr_Mod1, 3, its_Rdr_ModOk(rcbl));
                    i = 0; loop(pad_Rdr_Siz,
                        pad_Rdr_Colrs[i] = dfCol;
                        strcpy(pad_Rdr_Labs[i],"");
                        i += 1;);
                    strcpy(pad_Rdr_Labs[2],menu_Rdr_Type_N[rcbl[its_Rdr_Mode]]);
                    pad_Rdr_Colrs[2] = dfCol;
                    strcpy(pad_Rdr_Labs[1],menu_Rdr_Status_N[rcbl[its_Rdr_Status]]);
                    // status : Ready (blue), Paused (orange), Reading (green), else the default color
                    k = rcbl[its_Rdr_Status];
                    pad_Rdr_Colrs[1] = (k === its_RdrStat_Ready) ? Color_Light_Steel_Blue :
                        (k === its_RdrStat_Paused) ? Color_Dark_Orange :
                        (k === its_RdrStat_Reading) ? Color_Limegreen : dfCol;
                    (rcbl[its_Rdr_LineNb] >= 0) ? (
                        sprintf(pad_Rdr_Labs[3], "Line %d", rcbl[its_Rdr_LineNb]+1);
                        sprintf(pad_Rdr_Labs[4], "Size %.3f s", floor(1000*rcbl[its_Rdr_SmplCnt]/srate)/1000);
                        sprintf(pad_Rdr_Labs[5], "Channels %d", rcbl[its_Rdr_ChNbr]);
                        sprintf(pad_Rdr_Labs[6], "First %d", rcbl[its_Rdr_Bf1stChan]);
                        sprintf(pad_Rdr_Labs[7], "Used %d", rcbl[its_Rdr_BfChanUsed]);
                        sprintf(pad_Rdr_Labs[11], "Pos %.3f s", max(0, min(rcbl[its_Rdr_Last], rcbl[its_Rdr_Abspos]) - rcbl[its_Rdr_Start]) / srate); // (as in the writer pad)
                        sprintf(pad_Rdr_Labs[12], "Speed %.3f", rcbl[its_Rdr_Speed]);
                        pad_Rdr_Colrs[3] = pad_Rdr_Colrs[4] = pad_Rdr_Colrs[5] =
                        pad_Rdr_Colrs[6] = pad_Rdr_Colrs[7] = Color_Heliotrope;
                        its_Out_Label(pad_Rdr_Labs[10], rcbl[its_Rdr_OutK], rcbl[its_Rdr_OutOff]);
                    );
                    // Mute
                    (rcbl[its_Rdr_StFlgs] & its_RdrFlg_mute) ? (
                        strcpy(pad_Rdr_Labs[8],"** Mute **");
                        pad_Rdr_Colrs[8] = Col_P6;
                    ) : (
                        strcpy(pad_Rdr_Labs[8],"Mute");
                        pad_Rdr_Colrs[8] = Col_P1;
                    );
                    // Solo
                    (rcbl[its_Rdr_StFlgs] & its_RdrFlg_solo) ? (
                        strcpy(pad_Rdr_Labs[9],"** Solo **");
                        pad_Rdr_Colrs[9] = Col_P7;
                    ) : (
                        strcpy(pad_Rdr_Labs[9],"Solo");
                        pad_Rdr_Colrs[9] = Col_P1;
                    );
                    pad_Rdr_Colrs[10] = Col_P3;
                    pad_Rdr_Colrs[11] = pad_Rdr_Colrs[12] = CL1;
                    pad_Rdr_Colrs[13] = pad_Rdr_Colrs[14] = pad_Rdr_Colrs[15] = Col_P1;
                    // Delay mode : the writer to follow (right clic : menu)
                    (rcbl[its_Rdr_Mode] === its_RdrMode_Delay) ? (
                        (rcbl[its_Rdr_WrSrc] >= 0) ? (
                            sprintf(pad_Rdr_Labs[13], "Writer %d", rcbl[its_Rdr_WrSrc]+1);
                            pad_Rdr_Colrs[13] = Color_Heliotrope;
                        ) : (
                            strcpy(pad_Rdr_Labs[13], "Writer: None");
                        );
                    );

                    k = RDBL[6];
                    (k === 0) ? (
                        pad_Rdr_Colrs[19] = pad_Rdr_Colrs[20] = dfCol;
                    ) :
                    (k === 1) ? (
                        pad_Rdr_Colrs[19] = pad_Rdr_Colrs[20] = Color_Heliotrope;
                    ) : (
                        pad_Rdr_Colrs[19] = pad_Rdr_Colrs[20] = Color_Light_Steel_Blue;
                    );
                    (rcbl[its_Rdr_Status] === its_RdrStat_Reading) ? (
                        ((k = rcbl[its_Rdr_Speed]) >= 0) ? (
                            pad_Rdr_Colrs[k > 1.3 ? (k > 2.8 ? 23 : 22) : 21] = CL1;
                        ) : (
                            pad_Rdr_Colrs[k < -1.3 ? (k < -2.8 ? 16 : 17) : 18] = CL1;
                        );
                    ) :
                    (rcbl[its_Rdr_Status] === its_RdrStat_Paused) ? (
                        pad_Rdr_Colrs[20] = CL1;
                    ) :
                    (rcbl[its_Rdr_Status] === its_RdrStat_Ready) ? (
                        pad_Rdr_Colrs[19] = CL1;
                    );
                    rerr = rcbl[its_Rdr_Error];
                ) : (
                    dfCol = Col_Inactive ;
                    RDBL[5] = 0;
                    i = 0; loop(pad_Rdr_Siz,
                        pad_Rdr_Colrs[i] = dfCol;
                        strcpy(pad_Rdr_Labs[i],"");
                        i += 1;);
                    strcpy(pad_Rdr_Labs[1],menu_Rdr_Status_N[0]);
                    strcpy(pad_Rdr_Labs[2],menu_Rdr_Type_N[RDBL[1]]);
                    strcpy(pad_Rdr_Labs[3],"Line: None");
                    // delay mode : the writer to follow can be chosen at once (right clic : menu ; this creates the reader)
                    (RDBL[1] === its_RdrMode_Delay) ? (
                        strcpy(pad_Rdr_Labs[13], "Writer: None");
                        pad_Rdr_Colrs[13] = Col_P1;
                    );
                    rerr = RDBL[2];
                );
                (rok && (rcbl[its_Rdr_Owner] > 0)) ? sprintf(pad_Rdr_Labs[0],"Reader %d (%s)", rdr+1, its_Al_OwnName(#its_OwnN, rcbl[its_Rdr_Owner])) :
                    sprintf(pad_Rdr_Labs[0],"Reader %d", rdr+1);
                (rok) ? (
                    (rerr) ? (
                        sprintf(pad_Rdr_Labs[14],"Err: %d", rerr);
                        pad_Rdr_Colrs[14] = Col_P6;
                    );
                );
                strcpy(pad_Rdr_Labs[15],"Action");
                strcpy(pad_Rdr_Labs[16],"<<<");
                strcpy(pad_Rdr_Labs[17],"<<");
                strcpy(pad_Rdr_Labs[18],"<");
                (rok) ? (
                    strcpy(pad_Rdr_Labs[19], menu_Rdr_Loop_N[rcbl[its_Rdr_LoopType]]);
                ) : (
                    strcpy(pad_Rdr_Labs[19],"[.]");
                );
                strcpy(pad_Rdr_Labs[20],"[=]");
                strcpy(pad_Rdr_Labs[21],">");
                strcpy(pad_Rdr_Labs[22],">>");
                strcpy(pad_Rdr_Labs[23],">>>");


                zz = control_jpad(pad_Reader, (((rok) ? rcbl[its_Rdr_Mode] : RDBL[1]) === its_RdrMode_Delay) ? 2 : -1, -1, 0); // delay mode : 2 lines
                // muted by another reader in solo : a small red circle in the "Mute" cell
                (rok && (its_RdrSolos !== 0) && !(rcbl[its_Rdr_StFlgs] & its_RdrFlg_solo)) ? (
                    ui_jpad_cell_pos(8);
                    rsc = uix_drawconfig_current[9]; // retina scaling
                    gfx_set(0.9, 0.1, 0.1, 1);
                    gfx_circle(rsc * (ui_jpad_cx + ui_jpad_lst_wi - 11), rsc * (ui_jpad_cy + 9), rsc * 4, 1);
                );
                (zz > 0) ? (
                    ui_GFXdoNow |= 4; ui_GFXReason = 34;
                    zzch = pad_Reader[ui_jpad_lkey];
                    zzent = pad_Reader[ui_jpad_entkey]-1;
                    zzmcl = pad_Reader[ui_jpad_last]-1;
                    zzmmd = pad_Reader[ui_jpad_lmods];
                    /*
                            sprintf(#itm, "PAD -> %d %d %d %d %d", zz, zzch, zzent, zzmcl, zzmmd);
                            mSL_log(SysLogBox, #itm);
                    */
                    //==============================================
                    (zz & ui_jpad_ev_rmc) ? (  // right mouse clic
                        (zzmcl === 0) ? (
                            k = rdr+1;
                            ui_menu_tick(menu_Rdr_Ids, k, 1);
                            // also tick the header of the sub-menu that holds the current reader
                            rgh = menu_Rdr_Ids[ui_jmenu_items + (0|(rdr / menu_Rdr_Grp)) * (menu_Rdr_Grp + 1)];
                            str_setchar(rgh, 1, '!');
                            xx = control_jmenu(menu_Rdr_Ids);
                            (xx != 0) ? (
                                RDBL[0] = xx - 1; // select a new reader
                            );
                            ui_menu_tick(menu_Rdr_Ids, k, 0);
                            str_setchar(rgh, 1, ui_jmenu_chSP);
                        ) :
                        (zzmcl === 2) ? (
                            // the mode
                            k = 1 + (rok ? ( rcbl[its_Rdr_Mode] ) : ( RDBL[1] ));
                            ui_menu_tick(menu_Rdr_Type, k, 1);
                            xx = control_jmenu(menu_Rdr_Type);
                            (xx != 0) ? (
                                (rok) ? (
                                    r = Rd_Set_Mode(rdr, xx - 1); // change mode, and prepare the reader for it
                                    sprintf(#itm, "Menu 2 : %d -> %d -> %d", rdr, xx, r);
                                    mSL_log(SysLogBox, #itm);
                                    // keep the JSFX sliders in sync when this reader is the current one
                                    (rdr === slReader) ? (
                                        slRdModePrv = slRdMode = rcbl[its_Rdr_Mode];
                                        slRStatusPrv = slRStatus = rcbl[its_Rdr_Status];
                                        slRdWrefPrv = slRdWref = 1 + rcbl[its_Rdr_WrSrc];
                                    );
                                ) : (
                                    RDBL[1] = xx - 1; // "pre mode"
                                );
                            );
                            ui_menu_tick(menu_Rdr_Type, -1, 0);
                        ) :
                        (zzmcl === 1) ? (
                            // the status
                            (rok) ? (
                                k = rcbl[its_Rdr_Status]+1;
                                ui_menu_tick(menu_Rdr_Status, k, 1);
                                xx = control_jmenu(menu_Rdr_Status);
                                (xx != 0) ? (
                                    x = Rd_Set_Status(rdr, xx - 1);
                                    sprintf(#itm, "Menu 1 : %d -> %d -> %d", rdr, xx, x);
                                    mSL_log(SysLogBox, #itm);
                                );
                                ui_menu_tick(menu_Rdr_Status, -1, 0);
                            );
                        ) :
                        (zzmcl === 3) ? (
                            k = (rok) ? rcbl[its_Rdr_LineNb]+2 : 1;
                            ui_menu_tick(menu_Lin_SIds, -1, 0);
                            ui_menu_tick(menu_Lin_SIds, k, 1);
                            // also tick the header of the sub-menu that holds the current line (reset below by the tick -1)
                            (k > 1) ? (
                                rgh = menu_Lin_SIds[ui_jmenu_items + 2 + (0|((k - 2) / menu_Lin_Grp)) * (menu_Lin_Grp + 1)];
                                str_setchar(rgh, 1, '!');
                            );
                            xx = control_jmenu(menu_Lin_SIds); // select a line
                            (xx != 0) ? (
                                x = Rd_Set_Line(rdr, xx - 1); // 0 for "none"
                                sprintf(#itm, "Menu 3 : %d -> %d -> %d", rdr, xx, x);
                                mSL_log(SysLogBox, #itm);
                            );
                            ui_menu_tick(menu_Lin_SIds, -1, 0);
                        ) :
                        (zzmcl === 6) ? (
                            (rok) ? (
                                k = rcbl[its_Rdr_Bf1stChan] + 1;
                                ui_menu_tick(menu_128_0_Ids, -1, 0);
                                ui_menu_tick(menu_128_0_Ids, k, 1);
                                xx = control_jmenu(menu_128_0_Ids); // select a number
                                (xx != 0) ? (
                                    rcbl[its_Rdr_Bf1stChan] = xx - 1;
                                );
                                ui_menu_tick(menu_128_0_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 7) ? (
                            (rok) ? (
                                k = rcbl[its_Rdr_BfChanUsed];
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                                ui_menu_tick(menu_128_1_Ids, k, 1);
                                // also tick the header of the sub-menu that holds the current count (reset below by the tick -1)
                                (k >= 1) ? (
                                    rgh = menu_128_1_Ids[ui_jmenu_items + (0|((k - 1) / menu_128_Grp)) * (menu_128_Grp + 1)];
                                    str_setchar(rgh, 1, '!');
                                );
                                xx = control_jmenu(menu_128_1_Ids); // select a count
                                (xx != 0) ? (
                                    rcbl[its_Rdr_BfChanUsed] = xx;
                                    rcbl[its_Rdr_Check] = 0; // (output width)
                                );
                                ui_menu_tick(menu_128_1_Ids, -1, 0);
                            );
                        ) :
                        (zzmcl === 10) ? (
                            // the output : own cable, Out or a bus (left clic : the first channel in the bus)
                            ((rok) && ((k = its_Dst_Choose(rcbl[its_Rdr_OutK], rcbl[its_Rdr_OutOff])) >= 0)) ? (
                                rcbl[its_Rdr_OutK] = k;
                                rcbl[its_Rdr_OutOff] = its_Src_ChOff;
                                rcbl[its_Rdr_Check] = 0;
                            );
                        ) :
                        (zzmcl === 12) ? (
                            (rok) ? (
                                k = RDBL[4];
                                ui_menu_tick(menu_Rdr_Speed, -1, 0);
                                ui_menu_tick(menu_Rdr_Speed, k+1, 1);
                                xx = control_jmenu(menu_Rdr_Speed);
                                (xx != 0) ? (
                                    RDBL[4] = xx - 1;
                                );
                                ui_menu_tick(menu_Rdr_Speed, -1, 0);
                            );
                        ) :
                        (zzmcl === 13) ? (
                            // Delay mode : choose the writer to follow (no reader yet : RDBL[1] is the mode chosen in cell 2)
                            (((rok) ? rcbl[its_Rdr_Mode] : RDBL[1]) === its_RdrMode_Delay) ? (
                                k = (rok) ? rcbl[its_Rdr_WrSrc] + 2 : 1; // 1 for "None"
                                ui_menu_tick(menu_Wrt_SIds, -1, 0);
                                ui_menu_tick(menu_Wrt_SIds, k, 1);
                                // also tick the header of the sub-menu that holds the current writer (reset below by the tick -1)
                                (k > 1) ? (
                                    rgh = menu_Wrt_SIds[ui_jmenu_items + 2 + (0|((k - 2) / menu_Wrt_Grp)) * (menu_Wrt_Grp + 1)];
                                    str_setchar(rgh, 1, '!');
                                );
                                xx = control_jmenu(menu_Wrt_SIds); // select a writer
                                ((!rok) && (xx > 1)) ? (
                                    // a writer is chosen : create the reader, in delay mode
                                    rcbl = Rd_Create(rdr);
                                    rok = (rcbl > BASE_MEMORY) && (rcbl[-2] === KW_read);
                                    (rok) ? (rcbl[its_Rdr_Mode] = its_RdrMode_Delay);
                                );
                                ((xx != 0) && (rok)) ? (
                                    r = Rd_Set_Writer(rdr, xx - 1); // 0 for "none"
                                    sprintf(#itm, "Menu 13 : %d -> %d -> %d", rdr, xx, r);
                                    mSL_log(SysLogBox, #itm);
                                    // keep the JSFX sliders in sync when this reader is the current one (it may have just been created)
                                    (rdr === slReader) ? (
                                        Currreader = rcbl;
                                        slRdModePrv = slRdMode = rcbl[its_Rdr_Mode];
                                        slRdWrefPrv = slRdWref = 1 + rcbl[its_Rdr_WrSrc];
                                        slRStatusPrv = slRStatus = rcbl[its_Rdr_Status];
                                    );
                                    rdupdt = 1;
                                );
                                ui_menu_tick(menu_Wrt_SIds, -1, 0);
                            );
                        ) :
                        (zzmcl === 14) ? (
                            (rcbl != 0) ? (
                                rcbl[its_Rdr_Error] = 0;
                                //known corrections
                                rcbl[its_Rdr_Unuz1] = SECURE_BL;
                            );
                            RDBL[2] = 0;
                        ) :
                        (zzmcl === 15) ? (
                            xx = control_jmenu(menu_Rdr_Action);
                            (xx != 0) ? (
                                wrk1[0] = (rcbl === 0) ? ( RDBL[1] ) : ( rcbl[its_Rdr_Mode] );
                                Rd_Action(rdr, xx - 1, wrk1);
                            );
                        );
                        spd = (rcbl === 0) ? 1 : rcbl[its_Rdr_Speed];
                        d1 = 1/1024;
                        (zzmcl === 16) ? (
                            Rd_Set_Speed(rdr, spd - 256*d1, 1);
                        ) :
                        (zzmcl === 17) ? (
                            Rd_Set_Speed(rdr, spd - 16*d1, 1);
                        ) :
                        (zzmcl === 18) ? (
                            Rd_Set_Speed(rdr, spd - d1, 1);
                        ) :
                        (zzmcl === 19) ? (
                            (rok) ? (
                                k = rcbl[its_Rdr_LoopType];
                                ui_menu_tick(menu_Rdr_Loop, -1, 0);
                                ui_menu_tick(menu_Rdr_Loop, k+1, 1);
                                xx = control_jmenu(menu_Rdr_Loop);
                                (xx != 0) ? (
                                    rcbl[its_Rdr_LoopType] = xx - 1;
                                );
                                ui_menu_tick(menu_Rdr_Loop, -1, 0);
                            );
                        ) :
                        (zzmcl === 20) ? (
                            (rok) ? (
                                k = RDBL[6];
                                ui_menu_tick(menu_Rdr_RegLen, -1, 0);
                                ui_menu_tick(menu_Rdr_RegLen, k+1, 1);
                                xx = control_jmenu(menu_Rdr_RegLen);
                                (xx != 0) ? (
                                    RDBL[6] = xx - 1;
                                );
                                ui_menu_tick(menu_Rdr_RegLen, -1, 0);
                            );
                        ) :
                        (zzmcl === 21) ? (
                            Rd_Set_Speed(rdr, spd + d1, 1);
                        ) :
                        (zzmcl === 22) ? (
                            Rd_Set_Speed(rdr, spd + 16*d1, 1);
                        ) :
                        (zzmcl === 23) ? (
                            Rd_Set_Speed(rdr, spd + 256*d1, 1);
                        );
                    );


                    //==============================================
                    (zz & ui_jpad_ev_lmc) ? (  // left mouse clic
                        k = (jmc & cmdCap) ? 4 : (jmc & altCap) ? 16 : 1;
                        (zzmcl === 0) ? (
                            // the next reader (shift : the previous one)
                            RDBL[0] = (jmc & shfCap) ? (rdr + RD_CNT - 1) % RD_CNT : (rdr + 1) % RD_CNT;
                        );
                        // (the reader must exist : rcbl is 0 otherwise)
                        ((zzmcl === 1) && rok) ? (
                            // status : Paused -> Reading ; Ready or Reading -> Paused
                            w = rcbl[its_Rdr_Status];
                            ((w === its_RdrStat_Ready) || (w === its_RdrStat_Paused) || (w === its_RdrStat_Reading)) ? (
                                Rd_Set_Status(rdr, (w === its_RdrStat_Paused) ? its_RdrStat_Reading : its_RdrStat_Paused);
                                (rdr === slReader) ? (slRStatusPrv = slRStatus = rcbl[its_Rdr_Status]);
                            );
                        );
                        ((zzmcl === 8) && rok) ? (
                            // mute on/off
                            (rcbl[its_Rdr_StFlgs] & its_RdrFlg_mute) ? (
