//==========================================================
//===== WRITERS Handling
// Writers_set[WR_CNT]

function Wr_Clear(wnum)
(
    ((wnum >= 0) && (wnum <= WR_CNT) && ((wcb = Writers_set[wnum]) > BASE_MEMORY) && (wcb[-2] === KW_writ)) ? (
        memset(wcb, 0, its_Wrt_BlkSize);
        wcb[its_Wrt_LineNb] = -1;
        wcb[its_Wrt_BLType] = 2000;
        wcb[its_Wrt_InGain] = 1;
        wcb[its_Wrt_Status] = its_WrtStat_Created;
        wcb[its_Wrt_Unuz1] = wcb[its_Wrt_Unuz2] = SECURE_BL;
        wcb[its_Wrt_Number] = wnum;
    );
);
// Create a writer in slot "wnum" or return the existing writer
function Wr_Make(wnum)
local(wcb)
(
    ((wcb = Writers_set[wnum]) === 0) ? (
        wcb = mSL_Dyn_Alloc(its_Wrt_BlkSize, KW_writ, 0); // allocate memory
        Writers_set[wnum] = wcb;
        Wr_Clear(wnum);
    );
    wcb;
);

// Delete a writer from Writers_set
function Wr_Delete(wnum)
local (wcb)
(
    ((wnum >= 0) && (wnum <= WR_CNT) && ((wcb = Writers_set[wnum]) > BASE_MEMORY) && (wcb[-2] === KW_writ)) ? (
        mSL_Dyn_Free(wcb);
    );
    Writers_set[wnum] = 0;
);


