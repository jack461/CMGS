function mSL_Dbg_Memory_Updt(membox)
local (n, w)
(
    (membox[14] & 0x100) ? (
        w = 0;
        n = membox[7];
        (n === 5) ? (
            w = StaticWA;
        ) :
        (n === 6) ? (
            w = DuplWA;
        ) :
        (n === 7) ? (
            w = Readers_set;
        ) :
        (n === 8) ? (
            w = Lines_set;
        ) :
        (n === 9) ? (
            w = Writers_set;
        ) :
        (n === 10) ? (
            w = Effects_set;
        ) :
        (n === 11) ? (
            w = smpl_tab + IN_P;
        ) :
        (n === 12) ? (
            w = smpl_tab + OUT_P;
        ) :
        (n === 21) ? (
            w = Readers_set[0];
        ) :
        (n === 22) ? (
            w = Lines_set[0];
        ) :
        (n === 23) ? (
            w = Writers_set[0];
        ) :
        (n === 24) ? (
            w = Effects_set[0];
        ) :
        (n === 25) ? (
            w = Readers_set[1];
        ) :
        (n === 26) ? (
            w = Lines_set[1];
        ) :
        (n === 27) ? (
            w = Writers_set[1];
        ) :
        (n === 28) ? (
            w = Effects_set[1];
        ) :
        (n === 29) ? (
            w = Readers_set[2];
        ) :
        (n === 30) ? (
            w = Lines_set[2];
        ) :
        (n === 31) ? (
            w = Writers_set[2];
        ) :
        (n === 32) ? (
            w = Effects_set[2];
        ) :
        (n === 33) ? (
            w = Readers_set[3];
        ) :
        (n === 34) ? (
            w = Lines_set[3];
        ) :
        (n === 35) ? (
            w = Writers_set[3];
        ) :
        (n === 36) ? (
            w = Effects_set[3];
        ) :
        (
            w = 0;
        );
        membox[9] = membox[8] = membox[7] = w;
    );
);




