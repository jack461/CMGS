                            al = sw / (2 * qk); a0 = 1 + al;
                            (md === its_FltLP) ? (b0 = (1 - cw) / 2; b1 = 1 - cw; b2 = b0;) :
                            (md === its_FltHP) ? (b0 = (1 + cw) / 2; b1 = -(1 + cw); b2 = b0;) :
