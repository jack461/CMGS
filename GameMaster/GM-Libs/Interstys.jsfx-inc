// Parameters declaration
idx = 1;
p_playVol = idx; idx += 1; // player volume
p_playSpeed = idx; idx += 1; // player speed
p_lineSize = idx; idx += 1; // line size [0 .. 3600 s.]
p_playPos = idx; idx += 1; // play position [0 .. p_lineSize]
p_play_S_Low = idx; idx += 1; // region low limit
p_play_S_High = idx; idx += 1; // region high limit
p_play_S_Len = idx; idx += 1; // region length
p_play_S_Pos = idx; idx += 1; // region position
p_play_XFade = idx; idx += 1; // xfade time
p_play_Zoom = idx; idx += 1; // zoom of the waveform of a reader (a display property, kept in RDBL[9])
p_rdOffset = idx; idx += 1; // offset of a reader in delay mode [0 .. line size] (s.)
p_wrGain = idx; idx += 1; // record gain of a writer (dB)
p_wrOvrdb = idx; idx += 1; // overdub of a writer (%)
p_glInGain = idx; idx += 1; // global input gain (dB) : slider slInGain
p_glOutVol = idx; idx += 1; // global output volume (dB) : slider slOutVol
p_fxGain1 = idx; idx += 8; // gains of the 8 sources of a mixer (dB) : p_fxGain1 ... p_fxGain1 + 7
p_rdModDepth1 = idx; idx += 3; // depths of the 3 modulation inputs of a reader : offset (ms), speed, volume
p_rdModAtt1 = idx; idx += 3; // attenuverters of the 3 modulation inputs of a reader [-10 ... 10]
p_fxLfoFreq = idx; idx += 1; // LFO : frequency (Hz)
p_fxLfoAmp = idx; idx += 1; // LFO : amplitude
p_fxLfoDC = idx; idx += 1; // LFO : offset
p_fxLfoSpread = idx; idx += 1; // LFO : phase spread between the channels (turns)
p_wrModDepth1 = idx; idx += 2; // depths of the 2 modulation inputs of a writer : record gain (dB), overdub (%)
p_wrModAtt1 = idx; idx += 2; // their attenuverters [-10 ... 10]
p_fxFltFreq = idx; idx += 1; // Filter : cutoff frequency (Hz)
p_fxFltQ = idx; idx += 1; // Filter : resonance (Q)
p_fxFltModD1 = idx; idx += 2; // depths of the 2 modulation inputs of a filter : cutoff, resonance (octaves)
p_fxFltModA1 = idx; idx += 2; // their attenuverters [-10 ... 10]
p_fxSatDrive = idx; idx += 1; // Saturation : drive (dB)
p_fxSatBias = idx; idx += 1; // Saturation : bias
p_fxSatMix = idx; idx += 1; // Saturation : mix (%)
p_fxSatOut = idx; idx += 1; // Saturation : output gain (dB)
p_fxSatModD1 = idx; idx += 3; // depths of the 3 modulation inputs of a saturation : drive (dB), bias, order (or stretch)
p_fxSatModA1 = idx; idx += 3; // their attenuverters [-10 ... 10]
p_fxSatOrder = idx; idx += 1; // Saturation : order n (modes x - sin, Chebyshev)
p_fxSatStretch = idx; idx += 1; // Saturation : stretch (mode Cheb. sum)
p_fxSatAmp = idx; idx += 1; // Saturation : amount A of the sine (mode x - A sin)
