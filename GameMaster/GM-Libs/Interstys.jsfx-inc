// Sizes of Allocated arrays for the Compiler and the Evaluator
C_compSize = 64 * 1024; // size : 64 kW [kilo words, not kilo watts]
C_progSize = 64 * 1024; // size  for the evaluator
ui_jmake_arraymax = 0x7FFFFFF; // "no" limit in the size of an array...

// Then, initialize all structures of the compiler.
C_compArea = make_array(C_compSize);
C_progArea = make_array(C_progSize);

// Création des tableaux
// certains ont un élément de plus pour les copy/paste
PtrsInWA = RD_CNT+1 + WR_CNT+1 + FX_CNT+1 + LN_CNT + 1;
StaticWASize = PtrsInWA + SMPL_SIZE + 1;
StaticWA = make_array(StaticWASize); // ensemble des pointeurs mémoire et cellules
DuplWA = make_array(StaticWASize); // pour load/save des pointeurs mémoire
// protect lines, readers, writers, effects (dynamic blocks) from the garbage collector
mm_usr_prot[mm_usr_prot_ptr] = StaticWA; mm_usr_prot_ptr += 1;
mm_usr_prot[mm_usr_prot_ptr] = DuplWA; mm_usr_prot_ptr += 1;
AltWAdec = DuplWA - StaticWA; // décalage pour accès aux objets similaires des deux ensembles

sinc_table = make_array(SINC_TABLE_SIZE+2); // // valeurs d'une fonction "sinc"
sinus_table = make_array(SINUS_TABLE_SIZE+2); // Fonction sinus in [0 .. pi/2]

// Remplissage de la table SInc
i = 0;
loop(SINC_TABLE_SIZE,
  // On mappe l'index de la table sur la plage [-SINC_RADIUS, SINC_RADIUS]
  x = (i / SINC_TABLE_SIZE) * 2 * SINC_RADIUS - SINC_RADIUS;
  // Calcul de la fonction SInc
  z = 1;
  x != 0 ? (w = $pi * x; z = sin(w) / (w););
  sinc_table[i] = z;
  i += 1;
);

// Remplissage de la table SInus in [0 .. pi/2]
i = w = 0; x = $pi / 2 / SINUS_TABLE_SIZE;
loop(SINUS_TABLE_SIZE + 1,
    sinus_table[i] = sin(w);
    i += 1; w += x;
);
sinus_table[i] = 1;


// Load/Save Area
idx = 0;
SVASIZ = max(idx, 32);
savarea = make_array(SVASIZ); // Load/Save description area
lodarea = make_array(SVASIZ); // Load/Save description area
TMPSIZ = 4;
savtmp = make_array(TMPSIZ); // Work area for load/save of a memory block
savcode = '1tr6'; // a save code
// Saving doubles in @serialize as two singles : save_mem, load_mem, savwrk (shared, mSL_Serialize.jsfx-inc)
