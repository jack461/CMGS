its_Efx_BlkSize = idx; // actual size

// Some constants
its_EfxDist = its_Efx_Src2 - its_Efx_Src1;
// Effects types
its_Efx_Undefined = 0;
its_Efx_Unspecified = 1;
its_Efx_TyNone = 1;
its_Efx_TyMixer = 2;
its_Efx_TyAutoMix = 3;
its_Efx_TyMover = 4;
its_Efx_TyAction = 5;
its_Efx_TyScript = 6;
its_Efx_TyLFO = 7;
its_Efx_TyFilter = 8;
its_Efx_TySat = 9;
its_Efx_TyCnt = 10; // count of types
// Filter modes (its_Efx_Par3)
its_FltLP1 = 0; // low pass, 1 pole
its_FltHP1 = 1; // high pass, 1 pole
its_FltLP = 2; // low pass, biquad
its_FltHP = 3; // high pass, biquad
its_FltBP = 4; // band pass, biquad
its_FltNotch = 5; // notch, biquad
its_FltSlopes = 4; // slopes (its_Efx_Par4) : 1, 2, 4 or 8 stages
// Saturation modes (its_Efx_Par2)
its_SatSoft = 0; // tanh
its_SatHard = 1; // hard clip
its_SatFold = 2; // triangular wavefolder
its_SatSine = 3; // sine wavefolder
its_SatXSin = 4; // 0.5 * (x - A * sin(n * x * pi / 2)), n : the order (its_Efx_Par7), A : its_Efx_Par9
its_SatCheb = 5; // Chebyshev polynomial T_n (n real : cos(n * acos(x))), x folded back into [-1, 1]
its_SatChebSum = 6; // weighted sum of the T_k (k in [1 ... its_SatHarm], weights its_Efx_Harm1), stretched by its_Efx_Par8
its_SatModeCnt = 7; // count of modes
its_SatHarm = 16; // count of the weights of the mode Cheb. sum (its_Efx_Harm1)
its_HarmH = 90; // height of the editor of the weights (pixels)
its_SatOSCnt = 4; // oversampling (its_Efx_Par5) : 1, 2, 4 or 8 times
its_SatChW = 12; // words per channel in the work area : previous input, DC blocker (2), anti-aliasing biquads (4 x 2)
its_SatDcK = 1 - 2 * $pi * 10 / srate; // DC blocker : pole
its_LimAtt = 1 - exp(-1 / (0.005 * srate)); // auto-limiter of the effects : attack about 5 ms
its_LimRel = 1 - exp(-1 / (1.5 * srate)); // release about 1.5 s
its_FinMax = 10^30; // above (or NaN) : a value is not finite, the state that produced it is reset (see its_NaNCnt)
its_NaNCnt = 0; // non-finite values found and reset by @sample (filter, saturation, writer), logged by @gfx
its_NaNSeen = 0; // its_NaNCnt already logged
// Work area of an effect (KW_fxwk, see its_Fx_WorkSize) ; Filter : the header, then 5 coefficients
// [b0, b1, b2, a1, a2] per stage, then the states (2 per stage and per channel) ; Saturation : the header (its_FxW_Md :
// the oversampling of the coefficients), the coefficients of the 4 anti-aliasing biquads, then its_SatChW words per channel
its_FxW_Size = 0; // size of the area (words)
its_FxW_F = 1; // frequency, Q and mode of the coefficients
its_FxW_Q = 2;
its_FxW_Md = 3;
its_FxW_Hdr = 8; // first coefficient
// LFO shapes (its_Efx_Par2)
its_LfoSine = 0;
its_LfoTri = 1;
its_LfoSawUp = 2;
its_LfoSawDown = 3;
its_LfoSquare = 4;

its_EfxStat_Off = 0; // its_Efx_Status : the effect is not executed
its_EfxStat_On = 1; // (= its_Efx_Unspecified, set by FX_Clear)
its_EfxStat_Bypass = 2; // the first source goes unchanged to the output (an LFO is silent)

its_Efx_PhaseStd = 0;
its_Efx_PhasePre = 1;
its_Efx_PhasePost = 2;

its_EfxAct_Copy = 1;
its_EfxAct_Paste = 2;
its_EfxAct_Clear = 3;
its_EfxAct_AutoGains = 4;
its_EfxAct_Reset = 5;
its_EfxAct_Create = 6;
its_EfxAct_Show = 7;
its_EfxAct_Delete = 9;





