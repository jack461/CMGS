    err;
);


function Rd_Set_Speed(rdrn, nspeed, f1)
local (reader)
(
    err = 0;
    // The reader must be defined
    ((rdrn < 0) || (rdrn >= RD_CNT)) ? (
        err = 112; // erreur
    ) :
    ((nspeed < -SPDMAX) || (nspeed > SPDMAX)) ? (
        nspeed = max(-SPDMAX, min(SPDMAX, nspeed));
    ) :
    (((reader = Readers_set[rdrn]) <= BASE_MEMORY) || (reader[-2] !== KW_read)) ? (
        err = 103;
    );
    (err === 0) ? (
        reader[its_Rdr_Speed] = nspeed;
        reader[its_Rdr_AbsInc] = nspeed;
        (f1) ? (
            reader[its_Rdr_Abspos] = floor(0.5+reader[its_Rdr_Abspos]);
        );
    );
    err;
);

// Prepare to start a reader by setting its volume to slowly increase
function Rd_Do_Start(reader, nbr)
local (ty, sp, mdr)
(
    Rd_Update(nbr);
    mdr = reader[its_Rdr_Mode]; // reader mode
    (mdr === its_RdrMode_Read) ? (
        ty = reader[its_Rdr_LoopType];
        sp = reader[its_Rdr_Speed];
        (ty === its_RdrLoopTypeLoop) ? (
            reader[its_Rdr_Abspos] = (sp >= 0) ? reader[its_Rdr_RegSIn] : reader[its_Rdr_RegEIn];
        ) : (
            reader[its_Rdr_Abspos] = (sp >= 0) ? reader[its_Rdr_Start] : reader[its_Rdr_Last];
        );
        reader[its_Rdr_AbsAuxpos] = LOW_VALUE;
        reader[its_Rdr_Status] = its_RdrStat_Reading;
        reader[its_Rdr_XFadeCnt] = reader[its_Rdr_BFadeCntNxt]; // start counting
        reader[its_Rdr_XFadeIncr] = SINUS_TABLE_SIZE / reader[its_Rdr_XFadeCnt];
        reader[its_Rdr_XFadeIdxPos] = 0;
    ) :
    (mdr === its_RdrMode_Folwr) ? (
        reader[its_Rdr_Status] = its_RdrStat_Reading;
    );
);

function Rd_Do_Stop(reader, nbr)
(
    reader[its_Rdr_Status] = its_RdrStat_Ready;
    reader[its_Rdr_LoopType] = its_RdrLoopTypeOnce;
    reader[its_Rdr_Abspos] = (reader[its_Rdr_Speed] >= 0) ? reader[its_Rdr_Start] : reader[its_Rdr_Last];
);



function Rd_Action(rdrn, act, tmp)
local (reader, err)
(
    err = 0;
    ((rdrn < 0) || (rdrn >= RD_CNT)) ? (
        err = 122; // erreur
    ) :
    (((reader = Readers_set[rdrn]) <= BASE_MEMORY) || (reader[-2] !== KW_read)) ? (
        (reader === 0) ? (
            (act === its_RdrAct_Create) ? (
                reader = Rd_Create(rdrn);
