            wk[its_FxW_Md] = 1;
        );
        op = max(0, min(its_MtCnt - 1, floor(fx[its_Efx_Par1 + 1])));
        mp = fx + its_Efx_Mod1;
        am = its_Mod_Apply(mp, fx[its_Efx_Par1 + 2], its_ModA_Add, 1);
        va = its_Mod_Apply(mp + its_ModDist, fx[its_Efx_Par1 + 4], its_ModA_Add, 1);
        off = its_Mod_Apply(mp + 2 * its_ModDist, fx[its_Efx_Par1 + 3], its_ModA_Add, 1);
        (fx[its_Efx_Par1 + 6] !== hd[0]) ? (
            hd[0] = fx[its_Efx_Par1 + 6];
            hd[1] = (hd[0] <= 0) ? 1 : 1 - exp(-1000 / (hd[0] * srate));
            hd[4] = (hd[0] <= 0) ? 10^30 : 1000 / (hd[0] * srate);
        );
