//  Interstys modular fractional delay - V0.2.1



@init

ext_noinit = 1;
gfx_ext_retina = 1;
<? no_init = 1; ?>

version = 0x000103;

tStart = tUnix = start_time = time();
// Evaluate an approximation of time_precise vs time (as in GamePlayer and Diffusion-3)
tSUnix = time(); tPLoc = time_precise(); timeD = tSUnix - tPLoc;
tSUnix = time(); tPLoc = time_precise(); timeD += tSUnix - tPLoc;
tSUnix = time(); tPLoc = time_precise(); timeD += tSUnix - tPLoc;
tSUnix = time(); tPLoc = time_precise(); timeD += tSUnix - tPLoc;
timeD = timeD/4;

SL_COUNT= <? printf("%d", slnum); ?>; // nombre de sliders utilisés
CH_NB = <? printf("%d", CH_NB); ?>; // nombre de canaux gérés [typiquement 128]
RD_CNT = <? printf("%d", RD_CNT); ?>; // nombre de lecteurs
WR_CNT = <? printf("%d", WR_CNT); ?>; // nombre de writers
// Buffers audio
LN_CNT = <? printf("%d", LN_CNT); ?>; // nombre de buffers
FX_CNT = <? printf("%d", FX_CNT); ?>; // nombre d'effets
SMPL_SIZE = <? printf("%d", SMPL_SIZE); ?>; // nombre total de cellules (voir le plan dans Interstys.jsfx)
IN_P = <? printf("%d", IN_P); ?>; // In : les entrées de la piste
OUT_P = <? printf("%d", OUT_P); ?>; // Out : le bus de sortie
NB_BUS = <? printf("%d", NB_BUS); ?>; // nombre de bus (virtuels : alloués dans le Pool, voir its_Patch_Update)
CTL_P = <? printf("%d", CTL_P); ?>; // les cellules de contrôle
NB_CTL = <? printf("%d", NB_CTL); ?>; // nombre de cellules de contrôle
NB_GSL = <? printf("%d", NB_GSL); ?>; // sliders génériques : Ctl 1 ... NB_GSL
GSL_FIRST = <? printf("%d", GSL_FIRST); ?>; // numéro du premier slider générique
CBL_P = <? printf("%d", CBL_P); ?>; // le Pool des câbles
CBL_CELLS = <? printf("%d", CBL_CELLS); ?>; // taille du Pool
ZERO_P = <? printf("%d", ZERO_P); ?>; // 128 cellules toujours nulles
TRASH_P = <? printf("%d", TRASH_P); ?>; // 128 cellules "poubelle"
SPDMAX = <? printf("%d", SPDMAX); ?>; // max speed.
BF_BASE = srate; // 1 second

lastslider = <? printf("%d", slnum); ?>;

// Paramètres de la table SInc
SINC_RADIUS = 32; // Nombre d'échantillons utilisés à gauche et à droite (Qualité)
B_FADESIZ = 160; // samples for the borders fade
SINC_TABLE_SIZE = 8192; // Résolution de la table "sinc"
SINC_FACT = SINC_TABLE_SIZE / (2 * SINC_RADIUS);
BF_LIM = SINC_RADIUS + B_FADESIZ + 4; // taille bords buffer
// SECURE_BL = 192365423/128; // "the unused value"
SECURE_BL = '_OK_';
LOW_VALUE = -2147483648;
MIN_VALUE = -1073741824;

// Paramètres de la table SInus
SINUS_TABLE_SIZE = 8192;

// BLOCK_CHECK = 192562217/128; // block fast check oK
BLOCK_CHECK = '_BC_';
// Frequently used names

XDcount = 1; // 10;
cmdCap = 0x4 | 0x20; // On Mac: allow "cmd" or "ctrl" as "alternate" modifiers
altCap = 0x10 ; // on Mac : "alt"
shfCap = 0x08; // shift


/* Paramètres
p_playVol
p_playSpeed
p_lineSize (s.)
p_playPos  (s.) [0 .. p_lineSize]
p_play_S_Low (s.) [0 .. p_lineSize]
p_play_S_High (s.) [0 .. p_lineSize]
p_play_S_Len (s.) [0 .. p_lineSize]
p_play_S_Pos (s.) [0 .. p_lineSize]
p_play_XFade
*/


// STRUCTURES
//==========================================================
// LINE - KW_lcbl - Lines_Set[LN_CNT]
idx = 0;
//  0
its_Lin_Unuz1 = idx; idx += 1; // Sécurité : mot inutilisé
its_Lin_Owner = idx; idx += 1; // propriétaire : 0 le patch utilisateur, sinon une instance d'algorithme
its_Lin_Status = idx; idx += 1; //  Etat du buffer
its_Lin_Flgs = idx; idx += 1; //  Flags du buffer
its_Lin_Numb = idx; idx += 1; //  Buffer number (in line set)
its_Lin_ChCnt = idx; idx += 1; //  Nombre de canaux
its_Lin_SmplCnt = idx; idx += 1; //  Nombre de samples par canal
its_Lin_SmplCntSec = idx; idx += 1; // Duration in seconds
//  8
its_Lin_RecFreq = idx; idx += 1; //  Record frequency
its_Lin_Start = idx; idx += 1; // 1er sample dans chaque buffer
its_Lin_Last = idx; idx += 1; // après le dernier sample disponible
its_Lin_Used = idx; idx += 1; // après le dernier sample utilisé
its_Lin_TStmp = idx; idx += 1; // creation time stamp
its_Lin_ActBSize = idx; idx += 1; // actual size needed for buffers
its_Lin_RdOffset = idx; idx += 1; // line read offset
its_Lin_Tmp1 = idx; idx += 1; // work for load/save
// 16
its_Lin_Tmp2 = idx; idx += 1; // work for load/save
its_Lin_Check = idx; idx += 1; // quick check
its_Lin_BF1ST = idx; idx += 1; // Pointeur sur le premier buffer
// Il peut y avoir jusqu'à 128 buffers, 1 pour chaque canal
idx += 127;
idx |= 3; // for rounding to a multiple of 4 minus 1
its_Lin_Unuz2 = idx; idx += 1; // Sécurité : mot inutilisé
its_Lin_BlkSize = idx; // actual size
// Status
its_LinStat_Undef = 0;
its_LinStat_Ready = 1;
its_LinStat_Used = 2;
// Actions
its_LinAct_Clear = 1;
its_LinAct_Create = 2;
its_LinAct_Delete = 4;
its_LinAct_Patch = 6;


//==========================================================
// MODULES EXÉCUTÉS PAR @sample (voir its_Run_Schedule) : les premiers mots des blocs des readers, des writers, des effets,
// et des blocs spécialisés "Clear", "Input", "Output" ; le mot 0 est le mot de sécurité (SECURE_BL) des blocs
its_Run_Delay = 1; // délai (samples) : > 0 décompté à chaque sample sans exécuter, 0 exécuté, < 0 inactif (décompté) jusqu'au prochain ordonnancement
its_Run_Kind = 2; // nature du module (its_RunK_...)
its_Run_Num = 3; // numéro du module dans Readers_set, Writers_set, Effects_set
its_Run_First = 4; // premier mot propre à chaque nature
its_RunK_None = 0; // (bloc effacé ou libéré : jamais exécuté)
its_RunK_Reader = 1;
its_RunK_Writer = 2;
its_RunK_Effect = 3;
its_RunK_Input = 4; // les entrées de la piste dans In
its_RunK_Output = 5; // Out dans les sorties de la piste
its_RunK_Clear = 6; // effacement de Out et des bus

//==========================================================
// READER - KW_read - Readers_set[RD_CNT]
its_RdrMaxMulti = 8; // nombre max de lecteurs multi simultanés
idx = 0;
//  0
its_Rdr_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Rdr_Number = its_Run_Num; //  Numéro interne du reader
idx = its_Run_First;
its_Rdr_Status = idx; idx += 1; //  Etat affiché du reader
its_Rdr_Flgs = idx; idx += 1; //  Flags du reader
its_Rdr_Mode = idx; idx += 1; //  Mode du reader
its_Rdr_LoopType = idx; idx += 1; //  Type of looping
its_Rdr_InAction = idx; idx += 1; //  internal action
its_Rdr_Caught = idx; idx += 1; // type "catch" : 1 quand la lecture a été attrapée par la boucle (elle y reste)
//  8
its_Rdr_LineNb = idx; idx += 1; //  Source du reader : numéro du buffer   -1/ [0 ... N-1]
its_Rdr_Lcbl = idx; idx += 1; // pointeur sur le bloc de controle du (des) buffer(s)
its_Rdr_ChNbr = idx; idx += 1; // nombre de canaux dans le lcbl
its_Rdr_SmplCnt = idx; idx += 1; // taille du buffer
its_Rdr_LinSfreq = idx; idx += 1; // sample freq. of the reader
its_Rdr_SmplCntSec = idx; idx += 1; // taille du buffer en secondes
its_Rdr_Start = idx; idx += 1; //  pointeur vers le premier mot du tampon
its_Rdr_Low = idx; idx += 1; //  pointeur vers le premier mot du tampon
//  0x10 - 16
its_Rdr_Relpos = idx; idx += 1; //  Position [0 ... 100] de la tête de lecture
its_Rdr_Last = idx; idx += 1; //  pointeur vers le dernier mot du tampon
its_Rdr_High = idx; idx += 1; //  pointeur vers le dernier mot du tampon
its_Rdr_OutK = idx; idx += 1; // sortie : 0 son câble propre, sinon Out ou un bus (kind * ITS_KMul + number)
its_Rdr_OutOff = idx; idx += 1; // sortie : premier canal dans le bus
its_Rdr_OutCell = idx; idx += 1; // sortie : première cellule (calculée par exec_reader)
its_Rdr_OutCnt = idx; idx += 1; // sortie : nombre de canaux (taille du câble propre), 0 : le nombre de canaux utilisés
its_Rdr_OutW = idx; idx += 1; // sortie : nombre de canaux écrits, à partir de la première cellule (calculé par exec_reader)
its_Rdr_Speed = idx; idx += 1; //  Vitesse de lecture
its_Rdr_SpeedPrev = idx; idx += 1; //  Vitesse de lecture
//  0x18 - 24
its_Rdr_StFlgs = idx; idx += 1; //  Status flags
its_Rdr_MultiCnt = idx; idx += 1; //  nombre de lecteurs multi
its_Rdr_Bf1stChan = idx; idx += 1; // Premier canal utilisé dans le buffer
its_Rdr_BfChanUsed = idx; idx += 1; // nombre de canaux utilisés dans le buffer
its_Rdr_WrSrc = idx; idx += 1; // Writer source number
its_Rdr_WrBPtr = idx; idx += 1; // Writer source address
its_Rdr_WOffset = idx; idx += 1; // Read Offset in seconds
its_Rdr_WOffsetSmp = idx; idx += 1; // Read Offset in samples
// 0x20 - 32
its_Rdr_IntPt = idx; idx += 1; // pointeur interne
its_Rdr_OutVoldB = idx; idx += 1; // output volume (db)
its_Rdr_OutVol = idx; idx += 1; // output volume
its_Rdr_AuxVol = idx; idx += 1; // auxiliary volume
its_Rdr_RegSize = idx; idx += 1; // Taille région auxiliaire (samples)
its_Rdr_RegSizeSec = idx; idx += 1; // Taille région auxiliaire (secondes)
its_Rdr_RegSizeSecPrv = idx; idx += 1; // Ancienne taille région auxiliaire (secondes)
its_Rdr_RegPos = idx; idx += 1; // Position de la région auxiliaire (samples)
//  0x28 - 40
its_Rdr_RegPosSec = idx; idx += 1; // Position de la région auxiliaire (secondes)
its_Rdr_RegPosSecPrv = idx; idx += 1; // Ancienne Position de la région auxiliaire
its_Rdr_XFade_mSec = idx; idx += 1; // Cross Fade in mili seconds
its_Rdr_XFade_mSecSet = idx; idx += 1; // Cross Fade in mili seconds as explicitely set
its_Rdr_XFade_mSecPrv = idx; idx += 1; // Cross Fade in mili seconds, previous value
its_Rdr_LowPosSec = idx; idx += 1; // A1 pos in seconds
its_Rdr_LowPosSecPrv = idx; idx += 1; // A1 previous pos in seconds
its_Rdr_HighPosSec = idx; idx += 1; // A2 pos in seconds
//  0x30 - 48
its_Rdr_HighPosSecPrv = idx; idx += 1; // A2 previous pos in seconds
its_Rdr_RegSOut = idx; idx += 1; // Start extérieur reg. auxiliaire in Buffer
its_Rdr_RegSIn= idx; idx += 1; // Start intérieur reg. auxiliaire in Buffer
its_Rdr_RegEOut = idx; idx += 1; // End extérieur reg. auxiliaire in Buffer
its_Rdr_RegEIn = idx; idx += 1; // End intérieur reg. auxiliaire in Buffer
its_Rdr_Check = idx; idx += 1; // quick check
its_Rdr_AmpModPtr = idx; idx += 1; // pt. sur modulation amplitude
its_Rdr_FrqModPtr = idx; idx += 1; // pt. sur modulation frequence
//  0x38 - 56
its_Rdr_NxtPosSec = idx; idx += 1; // next play position
its_Rdr_BFadeCntNxt = idx; idx += 1; // next B Fade counter
its_Rdr_Error = idx; idx += 1; // last error encountered
its_Rdr_Tmp0 = idx; idx += 1; // temp 0
its_Rdr_Tmp1 = idx; idx += 1; // temp 1
its_Rdr_Tmp2 = idx; idx += 1; // temp 2
its_Rdr_Tmp3 = idx; idx += 1; // temp 3
its_Rdr_Tmp4 = idx; idx += 1; // temp 4
//  0x40 - 64
its_Rdr_Tmp5 = idx; idx += 1; // temp 5
its_Rdr_Tmp6 = idx; idx += 1; // temp 6
its_Rdr_DlyTap = idx; idx += 1; // mode delay, modulation by cross fades : the offset read (samples ; 0 : none yet)
its_Rdr_PosDisp = idx; idx += 1; // modes on a line : the displacement (samples, backward) applied by the input Offset
its_Rdr_FadeJmp = idx; idx += 1; // mode reader : the cross fade is a jump of the input Offset (sin², cos²)
its_Rdr_TmpA = idx; idx += 1; // temp A
its_Rdr_TmpB = idx; idx += 1; // temp B
its_Rdr_TmpC = idx; idx += 1; // temp C
its_Rdr_OutAdd = idx; idx += 1; // sortie : 1 pour un bus (addition), 0 pour le câble propre (affectation)
its_Rdr_OutDirty = idx; idx += 1; // le câble propre a été écrit (il est effacé quand le reader s'arrête)
its_Rdr_Owner = idx; idx += 1; // propriétaire : 0 le patch utilisateur, sinon une instance d'algorithme
// une entrée de modulation (1 canal) : ces champs, its_ModDist mots, dans le bloc d'un module (reader, writer, effet)
its_Mod_Src = 0; // source (kind * ITS_KMul + number, 0 : aucune)
its_Mod_Off = 1; // canal pris dans la source
its_Mod_Depth = 2; // profondeur : ms pour le décalage, vitesse, fraction du volume
its_Mod_Cell = 3; // cellule lue (calculée par exec_reader)
its_Mod_Ctl = 4; // 1 : une cellule de contrôle, lissée
its_Mod_Smooth = 5; // valeur lissée
its_Mod_Att = 6; // atténuverteur [-10 ... 10] (1 à la connexion)
its_Mod_Flags = 7; // drapeaux its_ModF_... : l'atténuverteur affiché, le bypass, la loi (0 : la loi par défaut de l'entrée)
its_ModDist = 8;
// les drapeaux (its_Mod_Flags) : 1 le slider de l'atténuverteur est affiché (menu de la loi), 2 bypass (la valeur de base
// seule : clic gauche sur la cellule) ; la loi (voir its_Mod_Law) : l'action (f >> 2) & 7 (its_ModA_... ; 0 : celle de
// l'entrée), la forme (f >> 5) & 3 (its_ModS_...), 128 unipolaire, la courbe de la forme Curve (f >> 8) & 63 ; 0x4000
// aucun slider (ni la profondeur, ni l'atténuverteur : menu de la loi) ; 0x8000 Doppler (le décalage d'un reader en mode
// delay suit la modulation en continu ; sinon, par fondus enchaînés, comme le slider : voir exec_reader)
its_ModF_Att = 1; its_ModF_Byp = 2; its_ModF_Uni = 128; its_ModF_NoSl = 0x4000; its_ModF_Dop = 0x8000;
its_ModF_Law = 0x3FFC; // l'action, la forme, la polarité, la courbe (bits 2 ... 13)
its_ModA_Add = 1; its_ModA_Scale = 2; its_ModA_Oct = 3; its_ModA_dB = 4; // b + d u, b (1 + d u), b 2^(d u), b 10^(d u / 20)
its_ModS_Lin = 0; its_ModS_Exp = 1; its_ModS_Log = 2; its_ModS_Crv = 3; // u, u |u|, signe(u) racine(|u|), une courbe
// 5 entrées de modulation : 0 le décalage (mode delay : le retard ; modes sur une ligne : le recul de la tête, des blocs, des
// segments, des grains, voir its_Rd_OffDisp), 1 la vitesse (mode reader), 2 le volume, 3 la vitesse de la loop (mode
// reader), 4 la désynchronisation des canaux (mode reader)
its_Rdr_ModN = 5;
its_Rdr_Mod1 = idx; idx += its_Rdr_ModN * its_ModDist;
//  0x40 - 72
its_Rdr_Abspos = idx; idx += its_RdrMaxMulti; //  Position [its_Rdr_Start ... its_Rdr_Last - 1] de lecture en samples
its_Rdr_AbsInc = idx; idx += its_RdrMaxMulti; //  Incrément de la position
its_Rdr_AdjInc = idx; idx += its_RdrMaxMulti; //  Ajustement de la position
its_Rdr_AbsAuxpos = idx; idx += its_RdrMaxMulti; //  Position de lecture auxiliaire
its_Rdr_XFadeCnt = idx; idx += its_RdrMaxMulti; // X Fade counter
its_Rdr_XFadeIdxPos = idx; idx += its_RdrMaxMulti; // X Fade position
its_Rdr_XFadeIncr = idx; idx += its_RdrMaxMulti; // X Fade increment
its_Rdr_XFadeCntNxt = idx; idx += its_RdrMaxMulti; // next X Fade counter
its_Rdr_LoopSpd = idx; idx += 1; // vitesse de déplacement de la loop (s/s) [-1 ... 1] (mode reader, voir its_Rdr_LoopMove)
its_Rdr_Desync = idx; idx += 1; // désynchronisation (s) [-1 ... 1] : le canal c lit c * Desync secondes avant le canal 0 (mode reader)
// mode Stretch (SOLA, voir exec_stretch) : les réglages (pad, ligne 4)
its_Rdr_StBlkMs = idx; idx += 1; // longueur d'un block (ms) [10 ... 5000]
its_Rdr_StOvlPc = idx; idx += 1; // recouvrement de deux blocks (% du block) [5 ... 50]
its_Rdr_StSrchMs = idx; idx += 1; // recherche du meilleur recouvrement, +- (ms) [0 ... 200] ; 0 : pas de corrélation
its_Rdr_StTransp = idx; idx += 1; // transposition (demi-tons) [-24 ... 24], multiplie la vitesse (modes Stretch et Brage)
// son état (@sample)
its_Rdr_StJ = idx; idx += 1; // index dans le block courant [0 ... StHs - 1] ; -1 : à démarrer
its_Rdr_StHs = idx; idx += 1; // pas du block courant (échantillons de sortie) : le block suivant commence StHs échantillons après
its_Rdr_StL = idx; idx += 1; // son recouvrement avec le block suivant (échantillons de sortie)
its_Rdr_StRho = idx; idx += 1; // sa vitesse de lecture (échantillons de la ligne par échantillon de sortie ; < 0 : à l'envers)
its_Rdr_StCur = idx; idx += 1; // son début dans la ligne (LOW_VALUE : silence, la fin)
its_Rdr_StNom = idx; idx += 1; // son début nominal (sans le décalage trouvé par la corrélation)
its_Rdr_StNNom = idx; idx += 1; // le début nominal du block suivant
its_Rdr_StLin = idx; idx += 1; // le recouvrement avec le block précédent (échantillons de sortie)
its_Rdr_StTail = idx; idx += 1; // le début de la queue du block précédent (LOW_VALUE : silence, le départ)
its_Rdr_StPRho = idx; idx += 1; // la vitesse de lecture du block précédent
its_Rdr_StEnd = idx; idx += 1; // 1 : le block suivant est la fin (silence), puis le reader s'arrête
its_Rdr_StLag = idx; idx += 1; // le décalage appliqué au block courant (échantillons de la ligne)
its_Rdr_StK = idx; idx += 1; // la recherche pour le block suivant, +- (échantillons de la ligne)
its_Rdr_StCPh = idx; idx += 1; // la corrélation : 0 aucune, 1 remplissage, 2 grossière, 3 fine, 4 faite
its_Rdr_StCI = idx; idx += 1; // sa progression (point rempli, décalage calculé)
its_Rdr_StCq = idx; idx += 1; // ses unités par échantillon (points, décalages)
its_Rdr_StBest = idx; idx += 1; // le meilleur décalage trouvé
its_Rdr_StBestV = idx; idx += 1; // son score
its_Rdr_StCn = idx; idx += 1; // le nombre de termes de la corrélation (sa fenêtre, au plus 20 ms du recouvrement)
its_Rdr_StX0 = idx; idx += 1; // la position dans la ligne de X[0] (les candidats, dans la zone de travail)
its_Rdr_StXn = idx; idx += 1; // le nombre de points de X
its_Rdr_StStep = idx; idx += 1; // le pas grossier (décalages et termes)
its_Rdr_StCHi = idx; idx += 1; // le dernier décalage de la recherche fine
its_Rdr_BrEnd = idx; idx += 1; // mode Brage, type "once" : la boucle a atteint le bout de la ligne (its_Rdr_LoopMove), la fin
// la zone de travail (KW_rdwk, non sauvée) : allouée par @gfx (its_Patch_Update), mise en place par @block (its_Rd_WorkSwitch)
its_Rdr_Work = idx; idx += 1; // la zone utilisée par exec_stretch (0 : aucune)
its_Rdr_WkNew = idx; idx += 1; // la zone préparée par @gfx (-1 : plus de zone), prise par @block
its_Rdr_WkOld = idx; idx += 1; // la zone remplacée par @block, libérée par @gfx à la frame suivante
// mode Stretch : la progression dans la ligne (le tempo, slider "Stretch") [-SPDMAX ... SPDMAX] ; les blocks sont lus à la
// vitesse du reader (son signe : leur sens, indépendant) ; (un mot libre avant l'arrondi : la taille du bloc ne change pas,
// un bloc sauvé avant ce champ revient avec 0)
its_Rdr_Stretch = idx; idx += 1;
// la boucle qui suit un writer (its_Rdr_LoopFollow ; les deux derniers mots libres avant l'arrondi : la taille du bloc ne
// change pas, un bloc sauvé avant ces champs revient avec une boucle libre)
its_Rdr_LoopWr = idx; idx += 1; // le writer suivi (numéro + 1) ; 0 : la boucle est libre (elle avance à its_Rdr_LoopSpd)
its_Rdr_LfSt = idx; idx += 1; // l'état du suivi (its_RdrLf_..., calculé en @block)
// mode Grains (exec_grains) : ses réglages (cellules 24 ... 36) ; un aléa a [1 ... 5] : un facteur tiré dans [1, a], ou
// son inverse (1 : pas d'aléa, see its_Gr_Rnd)
its_Rdr_GrSize = idx; idx += 1; // la durée des grains (ms) [10 ... 10000]
its_Rdr_GrSizeR = idx; idx += 1; // son aléa
its_Rdr_GrPlat = idx; idx += 1; // le plateau (% de la durée) [0 ... 100]
its_Rdr_GrPlatR = idx; idx += 1; // son aléa
its_Rdr_GrFade = idx; idx += 1; // le fade-in (% des fondus, le reste : le fade-out) [0 ... 100]
its_Rdr_GrFadeR = idx; idx += 1; // son aléa
its_Rdr_GrCurve = idx; idx += 1; // l'enveloppe : la courbe + 1 (0 : des rampes linéaires)
its_Rdr_GrVol = idx; idx += 1; // le volume (dB) [-20 ... 20]
its_Rdr_GrVolR = idx; idx += 1; // son aléa
its_Rdr_GrSpdR = idx; idx += 1; // l'aléa de la vitesse (celle du reader)
its_Rdr_GrDir = idx; idx += 1; // le sens [-1 ... 1] : en avant avec la probabilité (1 + d) / 2
its_Rdr_GrDens = idx; idx += 1; // la densité (grains par seconde, en moyenne) [0.01 ... 100]
its_Rdr_GrRand = idx; idx += 1; // les instants des grains [0 ... 1] : 0 périodiques (la densité est leur fréquence), 1 aléatoires
its_Rdr_LoopCross = idx; idx += 1; // la boucle libre au bout de la ligne : 0 elle saute à l'autre bout, 1 elle le traverse (its_Rd_Cross)
idx |= 3; // for rounding to a multiple of 4 minus 1
its_Rdr_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Rdr_BlkSize = idx; // actual size

its_RdrFlg_init = 0x0001; //  si lecteur initialisé
its_RdrFlg_actif = 0x0002; // si lecteur en cours de lecture
its_RdrFlg_hasline = 0x0002; // si lecteur a un buffer
its_RdrFlg_mute = 0x0010; // si lecteur mute
its_RdrFlg_solo = 0x0100; // si lecteur solo
its_RdrFlg_Mod = 0x1000; // si lecteur modifié interactivement
// Modes
its_RdrMode_Read = 0;
its_RdrMode_Delay = 1;
its_RdrMode_Stretch = 2; // SOLA : le tempo (its_Rdr_Stretch) indépendant de la hauteur (la vitesse, et la transposition)
its_RdrMode_Brage = 3; // "Brage" (le brassage, nom historique) : des segments tirés au hasard dans la boucle (qui se déplace),
                         // joints comme en mode Stretch
its_RdrMode_Grains = 4; // des grains tirés au hasard dans la boucle (qui se déplace), à la densité choisie (exec_grains)
its_RdrModeCnt = 5;
// Work area of a reader in mode Stretch or Brage (KW_rdwk, see its_Rd_WorkSize) : the header, then T (the tail of the
// current block), D (the index in X of the head of the next block, term by term) and X (the candidates for the coarse
// search : the sum of the first channels, at most 8, every "coarse step" samples of the line, see its_St_Step)
its_RdW_Size = 0; // size of the area (words)
its_RdW_Hdr = 4;
its_RdW_LcMax = 0.020; // the window of the correlation (s), at most
its_RdW_KMax = 0.200; // the search, +- (s), at most
its_RdW_RhoMax = 4; // the read rate, at most (+24 semitones)
// Work area of a reader in mode Grains (exec_grains) : the header (its_RdW_Hdr words : 1 the samples before the next grain,
// 2 the count of grains running), then its_RdGr_Max grains of its_RdGr_Sz words (its_Gr_N : 0, a free place)
its_RdGr_Max = 64; // grains running at once, at most (a grain without a place is not created)
its_RdGr_Sz = 12;
its_RdGr_WkSz = its_RdW_Hdr + its_RdGr_Max * its_RdGr_Sz;
its_RdGr_MkMx = 16; // the grains shown on the waveform, at most (its_Gr_Marks)
its_Gr_J = 0; // the sample of the grain that comes [0 ... N)
its_Gr_N = 1; // its length (samples) ; 0 : a free place
its_Gr_Pos = 2; // the read position (in the line, read modulo its size)
its_Gr_Rho = 3; // the read rate (samples of the line per sample ; < 0 : backward)
its_Gr_Fi = 4; // the fade-in (samples)
its_Gr_Pl = 5; // the plateau (samples) ; the fade-out : the rest
its_Gr_G = 6; // the gain (the volume, times its random factor)
its_Gr_Ch = 7; // the channel read (from the first channel used)
its_Gr_Out = 8; // the output channel (from the first output cell)
its_Gr_Tab = 9; // the envelope : the table of the curve (its sample 0, see its_CrvTab) ; 0 : linear ramps
its_Gr_Xs = 10; // the x of its plateau in the curve (the end of the rise)
its_Gr_S = 11; // the level of its plateau
// Etats
its_RdrStat_UnDef = 0;
its_RdrStat_Created = 1;
its_RdrStat_Ready = 2;
its_RdrStat_Paused = 3;
its_RdrStat_Reading = 4;
its_RdrStat_stopping = 12;
its_RdrStat_starting = 13;
// Actions
its_RdrAct_Copy = 1;
its_RdrAct_Paste = 2;
its_RdrAct_Clear = 3;
its_RdrAct_Rewind = 4;
its_RdrAct_Speed1 = 5;
its_RdrAct_Create = 6;
its_RdrAct_Activate = 7;
its_RdrAct_Show = 8;
its_RdrAct_Test = 9;
its_RdrAct_Delete = 10;
its_RdrAct_Patch = 12;

// Etats communs
its_RdrSolos = 0; // count of readers in solo mode
its_RdrErrCr = 0; // last create error
its_RdrErrXe = 0; // last exec error
its_RdrLoopTypeCnt = 6;
its_RdrLoopTypeOnce = 0;
its_RdrLoopTypeRepeat = 1;
its_RdrLoopTypeCatch = 2;
its_RdrLoopTypeLoop = 3;
its_RdrLoopTypeExit = 4;
its_RdrLoopTypeStop = 5;
// the loop that follows a writer (its_Rdr_LfSt, see its_Rdr_LoopFollow), or a free loop that crosses the end of the line
// (its_Rd_Cross)
its_RdrLf_On = 1; // the loop follows the writer : its end is the head of the writer (the same line, not in mode W-Mix)
its_RdrLf_Frame = 2; // the positions of the reader are in a frame (types catch, loop, exit, stop ; modes Reader, Stretch) :
                     // the frame of the writer, or a frame centered on a free loop that crosses the end of the line (its_Rd_FrLo)
its_RdrLf_Move = 4; // the writer writes : the loop moves at 1 (a sample of the line per sample)
its_RdrLf_Cross = 8; // the free loop crosses the end of the line (the option its_Rdr_LoopCross) : the line is circular
its_RdrLfGuard = 4; // the end of the loop, so many samples before the head of the writer (the 4 points of inter_cube are written)


//==========================================================
// WRITER - KW_writ - Writers_set[WR_CNT]
idx = 0;
// 0
its_Wrt_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Wrt_Number = its_Run_Num; //  Numéro du writer
idx = its_Run_First;
its_Wrt_BLType = idx; idx += 1; //  Type du bloc
its_Wrt_Status = idx; idx += 1; //  Etat du writer
its_Wrt_InAction = idx; idx += 1; //  internal action
its_Wrt_Flgs = idx; idx += 1; //  Flags du writer
its_Wrt_Mode = idx; idx += 1; //  Mode de fonctionnement du writer
its_Wrt_Bf1stChan = idx; idx += 1; // premier canal écrit dans la ligne [0 ... ChNbr-1] (mot "Intern", inutilisé, en 0 dans les anciens blocs)
its_Wrt_LineNb = idx; idx += 1; // numéro du buffer -1/ [0 ... N-1]
its_Wrt_Lcbl = idx; idx += 1; // pointeur sur le bloc de controle du (des) buffer(s)
// 10
its_Wrt_ChNbr = idx; idx += 1; // nombre de canaux dans le lcbl
its_Wrt_SmplCnt = idx; idx += 1; //  Taille de la zone utile
its_Wrt_Start = idx; idx += 1; //  pointeur vers le premier mot du tampon
its_Wrt_BfChanUsed = idx; idx += 1; // nombre de canaux écrits, 0 : tous, à partir du premier (mot "Relpos", inutilisé)
its_Wrt_Last = idx; idx += 1; //  pointeur vers le dernier mot du tampon
its_Wrt_Src = idx; idx += 1; // source de l'entrée (kind * ITS_KMul + number, 0 : aucune)
its_Wrt_Abspos = idx; idx += 1; //  Position [0 ... size - 1] de la tête d'écriture
its_Wrt_Buff_1 = idx; idx += 1; // pointeur sur le 1er buffer
its_Wrt_Ovrdb = idx; idx += 1; // recycling
its_Wrt_Check = idx; idx += 1; // quick check
// 20
its_Wrt_InGaindB = idx; idx += 1; // input gain (dB)
its_Wrt_InGain = idx; idx += 1; // input gain (dB)
its_Wrt_Error = idx; idx += 1; // last error
its_Wrt_Tmp0 = idx; idx += 1; // temp 0
its_Wrt_Tmp1 = idx; idx += 1; // temp 1
its_Wrt_Tmp2 = idx; idx += 1; // temp 2
its_Wrt_Tmp3 = idx; idx += 1; // temp 3
its_Wrt_Tmp4 = idx; idx += 1; // temp 4
its_Wrt_Tmp5 = idx; idx += 1; // temp 5
its_Wrt_Tmp6 = idx; idx += 1; // temp 6
its_Wrt_SrcOff = idx; idx += 1; // premier canal pris dans la source
its_Wrt_InCell = idx; idx += 1; // première cellule lue (calculée par exec_writer)
its_Wrt_Owner = idx; idx += 1; // propriétaire : 0 le patch utilisateur, sinon une instance d'algorithme
// 7 entrées de modulation : 0 le gain d'enregistrement (profondeur en dB), 1 l'overdub (profondeur en %),
// en mode W-Mix : 2 la durée des fondus, 3 le plateau, 4 l'attente (profondeurs en octaves), 5 la direction, 6 la désynchronisation (%)
its_Wrt_ModN = 7;
its_Wrt_Mod1 = idx; idx += its_Wrt_ModN * its_ModDist;
// mode W-Mix (voir its_Wrt_WMix) : les 5 réglages (contigus, dans l'ordre de its_WMix_Par)
its_Wrt_WFade = idx; idx += 1; // durée commune du fondu d'entrée et du fondu de sortie (s) [0.001 ... 10]
its_Wrt_WPlat = idx; idx += 1; // durée du plateau (s) [0 ... 100]
its_Wrt_WWait = idx; idx += 1; // durée de l'attente (s) [0 ... 100]
its_Wrt_WDir = idx; idx += 1; // direction [-1 ... 1] : probabilité (1 + d) / 2 d'écrire à la vitesse 1, sinon -1
its_Wrt_WDesync = idx; idx += 1; // désynchronisation des canaux (%) [0 ... 100]
// mode W-Mix : l'état du cycle
its_Wrt_WPhase = idx; idx += 1; // phase (its_WMix_...)
its_Wrt_WCnt = idx; idx += 1; // samples restant dans la phase
its_Wrt_WLen = idx; idx += 1; // durée des fondus du cycle (samples)
its_Wrt_WInc = idx; idx += 1; // direction du cycle : 1 ou -1
its_Wrt_WOffs = idx; idx += 128; // décalage de chaque canal par rapport à its_Wrt_Abspos [0 ... SmplCnt - 1]
// modes X-fade et Sum : le sens de l'écriture (deux des mots libres avant l'arrondi : la taille du bloc ne change pas, un
// bloc sauvé avant ces champs revient en avant)
its_Wrt_Dir = idx; idx += 1; // le sens choisi (its_WrtDir_..., cellule 8)
its_Wrt_Step = idx; idx += 1; // le sens courant, 1 ou -1 (aller et retour : il change aux bouts de la ligne)
idx |= 3; // for rounding to a multiple of 4 minus 1
its_Wrt_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Wrt_BlkSize = idx; // actual size

its_WrtFlg_init = 0x0001; //  si writer initialisé
// Modes (its_Wrt_Mode) : how the overdub (its_Wrt_Ovrdb, x %) mixes the previous content of the line with the input
its_WrtMode_XFade = 0; // x % of the previous content + (100 - x) % of the input, then the record gain
its_WrtMode_Sum = 1; // x % of the previous content (feedback) + the input with the record gain
its_WrtMode_WMix = 2; // cycles : random position, fade-in, plateau, fade-out, wait (see its_Wrt_WMix) ; no overdub
its_WrtModeCnt = 3;
// the direction of the writing (its_Wrt_Dir), modes X-fade and Sum (W-Mix has its own : its_Wrt_WDir)
its_WrtDir_Fwd = 0; // forward : from the end of the line, the writing goes on at its start
its_WrtDir_Bwd = 1; // backward : from the start, at the end
its_WrtDir_Both = 2; // forward and backward : the direction changes at the ends of the line
its_WrtDirCnt = 3;
// the phases of a W-Mix cycle (its_Wrt_WPhase)
its_WMix_Cycle = 0; // a new cycle starts at the next sample
its_WMix_FadeIn = 1;
its_WMix_Plateau = 2;
its_WMix_FadeOut = 3;
its_WMix_Wait = 4;
// x in [-150, 150] : x < 0 inverts the previous content ; a loop gain above 1 (|x| > 100, or the record gain in X-fade)
// is regenerative : the written value then goes through a tanh (see exec_writer)
// Etats
its_WrtStat_UnDef = 0;
its_WrtStat_Created = 1;
its_WrtStat_Ready = 2;
its_WrtStat_Paused = 3;
its_WrtStat_Writing = 4;
// Actions
its_WrtAct_Copy = 1;
its_WrtAct_Paste = 2;
its_WrtAct_Clear = 3;
its_WrtAct_Rewind = 4;
its_WrtAct_Reset = 5;
its_WrtAct_Create = 6;
its_WrtAct_Activate = 7;
its_WrtAct_Show = 8;
its_WrtAct_Delete = 10;
its_WrtAct_Patch = 12;

// Etats communs
its_WrtErrXe = 0; // last exec error


//==========================================================
// EFFECT - KW_effx - Effects_set[FX_CNT]
idx = 0;
//   0
its_Efx_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Efx_Numb = its_Run_Num; //  Numéro de l'effet
idx = its_Run_First;
its_Efx_Status = idx; idx += 1; //  Etat de l'effet
its_Efx_Flgs = idx; idx += 1; //  Flags de l'effet
its_Efx_Type = idx; idx += 1; //  Type de l'effet
its_Efx_Phase = idx; idx += 1; //  Phase de l'effet
its_Efx_CCnt = idx; idx += 1; //  Channel count
its_Efx_OutK = idx; idx += 1; //  sortie : 0 son câble propre, sinon Out ou un bus (kind * ITS_KMul + number)
its_Efx_OutOff = idx; idx += 1; //  sortie : premier canal dans le bus
its_Efx_OutCell = idx; idx += 1; //  sortie : première cellule (calculée par exec_fx)
its_Efx_OutAdd = idx; idx += 1; //  sortie : 1 pour un bus (addition), 0 pour le câble propre (affectation)
its_Efx_OutDirty = idx; idx += 1; //  le câble propre a été écrit (il est effacé quand l'effet s'arrête)
its_Efx_Owner = idx; idx += 1; //  propriétaire : 0 le patch utilisateur, sinon une instance d'algorithme
its_Efx_Rank = idx; idx += 1; //  rang d'exécution dans its_FxOrd (calculé par its_Fx_Order)
its_Efx_Lim = idx; idx += 1; //  1 : l'auto-limiteur de la sortie est en service (pas le LFO), avant le gain de sortie
its_Efx_LimEnv = idx; idx += 1; //  l'enveloppe crête de l'auto-limiteur (toutes les voies), son gain est 1 / max(1, env)
// zone de travail (KW_fxwk, non sauvée) : allouée par @gfx (its_Patch_Update), mise en place par @block (its_Fx_WorkSwitch)
its_Efx_Work = idx; idx += 1; //  la zone utilisée par exec_fx (0 : aucune)
its_Efx_WkNew = idx; idx += 1; //  la zone préparée par @gfx (-1 : plus de zone), prise par @block
its_Efx_WkOld = idx; idx += 1; //  la zone remplacée par @block, libérée par @gfx à la frame suivante
// paramètres et états propres à un type (LFO : Par1 fréquence (Hz), Par2 forme, Par3 amplitude, Par4 décalage,
// Par5 déphasage entre les canaux (en tours), Par6 la courbe de la forme "Curve" (0 ... its_CrvMx-1) ; St1 phase [0, 1[ ; Filter : Par1 fréquence de coupure (Hz), Par2 Q,
// Par3 mode, Par4 pente (2^Par4 étages) ; Saturation : Par1 drive (dB), Par2 mode, Par3 biais, Par4 mix [0, 1],
// Par5 suréchantillonnage (2^Par5 fois), Par6 gain de sortie (dB), Par7 ordre (x - A sin, Chebyshev), Par8 étirement (Cheb. sum),
// Par9 amplitude A du sinus (x - A sin), Par10 la courbe du mode Curve (0 ... its_CrvMx-1), Par11 ADAA (1 : en service,
// les modes qui ont une primitive, voir its_Sat_Adaa) ; Matrix : Par1 decay T60 (s), Par2 la matrice (its_Mx...), Par3
// l'amortissement passe-bas (Hz, 0 : aucun), Par4 mix [0, 1], Par5 Par6 les retards min et max (ms), Par7 diffusion
// [-2, 2] (hors de [0, 1] la boucle peut croître : elle sature), Par8 la boucle (its_MxLp...), Par9 graine des retards,
// Par10 leur répartition (its_MxSp...), Par11 passe-haut dans la boucle (Hz, 0 : aucun), Par12 l'entrée (its_MxIn...) ;
// Flanger, Chorus : Par1 le retard (ms), Par2 le mode (its_Fl...), Par3 l'amortissement de la réinjection (Hz, 0 : aucun),
// Par4 mix [-1, 1], Par5 le déphasage d'un canal au suivant (tours), Par6 la courbe de la forme Curve, Par7 la réinjection
// [-2, 2], Par8 la forme du balayage (its_LfoSine ... its_FlShHold), Par9 la graine, Par10 les voix, Par11 passe-haut de la
// réinjection (Hz, 0 : aucun), Par12 cross [-1, 1] (la part du canal voisin dans la réinjection) ; Phaser : Par1 la fréquence
// (Hz), Par2 le mode (its_Ph...), Par3 le balayage (octaves), Par4 mix [-1, 1], Par5 le déphasage d'un canal au suivant
// (tours), Par6 la courbe de la forme Curve, Par7 la réinjection [-2, 2], Par8 la forme du balayage, Par9 la graine, Par10
// les étages (1 ... its_PhMaxS), Par11 le Q (mode Resonant), Par12 cross [-1, 1] ; Noise : Par1 la part du grondement
// (rumble) [0, 1], Par2 la couleur (its_Nz...), Par3 l'amortissement passe-bas (Hz, 0 : aucun), Par4 la corrélation des
// canaux [0, 1], Par5 la densité (par seconde : Velvet, Dust, Logistic), Par6 le niveau (dB : celui des crêtes), Par7
// chaos [0, 1] (Crackle, Logistic), Par8 la teinte du mode Mix (dB/oct, [-6, 6]), Par9 l'exposant de la forme (sign(x)
// |x|^e, [0, 8]), Par10 la fréquence du grondement (Hz), Par11 passe-haut (Hz, 0 : aucun) ; Random : Par2 le mode
// (its_Rn...), Par3 l'amplitude, Par4 le décalage, Par5 la corrélation [0, 1] (la probabilité de prendre la valeur
// commune), Par6 la courbe de la loi Curve, Par7 la loi des tirages, Par8 l'horloge (0 commune, 1 propre à chaque canal),
// Par9 les paliers (0 : aucun), Par10 le pas du mode Walk, Par11 le seuil du déclenchement (sa source : le câble des
// déclenchements), Par12 sa détection (0 l'onde, 1 son enveloppe) ; et dans les mots its_Efx_MxX : 1 la vitesse (Hz, 0 :
// les déclenchements seuls), 3 le glissement (s), 4 l'irrégularité de l'horloge (jitter [0, 1]), 5 la retombée de
// l'enveloppe (ms)) ; Math : Par2 l'opération (its_Mt...), Par3 le facteur de la sortie (scale : la clé amp), Par4 son
// décalage (offset), Par5 la valeur de B sans source B, Par6 les canaux de B (0 : autant que l'effet si son câble les a,
// sinon le premier ; 1 : le premier), Par7 l'attaque (ms : Env, Slew), Par8 la retombée (ms : Env, Slew) ; Ring : Par1 la
// fréquence de l'oscillateur (Hz), Par2 le mode (its_Rg...), Par4 mix [0, 1], Par5 le déphasage d'un canal au suivant
// (tours), Par6 la courbe de la forme Curve, Par7 l'écart de fréquence d'un canal au suivant (detune, Hz), Par8 la forme
// (its_LfoSine ... its_FlShHold), Par9 amount (AM, [0, 2]), Par10 les canaux de B (comme Par6 du Math)
its_Efx_Par1 = idx; idx += 12;
its_Efx_St1 = idx; idx += 4;
its_Efx_Harm1 = idx; idx += 16; // Saturation, mode Cheb. sum : les poids des harmoniques 1 ... 16 (its_SatHarm), dans [-1, 1]
// Matrix : les mêmes mots, ses réglages en plus de Par1 ... Par12 : 0 wow (ms : la profondeur de la modulation des retards),
// 1 rate (Hz : sa vitesse), 2 spread (tours : le déphasage d'une ligne à la suivante), 3 glide (s : le glissement des retards),
// 8 lines (le nombre minimal de lignes : plus que de canaux, des lignes internes) ; Shimmer : ceux du Matrix, et 4 shimmer
// [0, 1] (la part transposée de chaque ligne), 5 shift et 6 shift2 (demi-tons : les intervalles des lignes paires et
// impaires), 7 grain (ms : la fenêtre du transpositeur)
// Flanger, Chorus : 0 sweep (ms : l'amplitude du balayage du retard), 1 rate (Hz : sa vitesse), 3 glide (s : le glissement
// du retard et du balayage), 4 jitter [0, 1] (les écarts des vitesses et des retards des voix) ; Phaser : 0 spacing (octaves
// d'un étage au suivant), 1 rate (Hz), 3 glide (s), 4 jitter [0, 1] (les écarts des vitesses des canaux)
its_Efx_MxX = its_Efx_Harm1;
// 3 entrées de modulation (Filter : 0 la fréquence de coupure (octaves), 1 la résonance (octaves) ; Saturation : 0 le drive (dB),
// 1 le biais, 2 l'ordre, ou l'étirement en mode Cheb. sum)
its_Efx_Mod1 = idx; idx += 3 * its_ModDist;
// 8 entrées : source (kind * ITS_KMul + number), premier canal, gain (dB), gain, première cellule (calculée par exec_fx)
its_Efx_Src1 = idx; idx += 1; //  Source n°1
its_Efx_Off1 = idx; idx += 1; //  Premier canal de la source n°1
its_Efx_VoldB1 = idx; idx += 1; //  Volume n°1 (dB)
its_Efx_Vol1 = idx; idx += 1; //  Volume n°1
its_Efx_Cell1 = idx; idx += 1; //  Cellule de la source n°1
its_Efx_Src2 = idx; idx += 1; //  Source n°2
its_Efx_Off2 = idx; idx += 1; //  Premier canal de la source n°2
its_Efx_VoldB2 = idx; idx += 1; //  Volume n°2 (dB)
its_Efx_Vol2 = idx; idx += 1; //  Volume n°2
its_Efx_Cell2 = idx; idx += 1; //  Cellule de la source n°2
its_Efx_Src3 = idx; idx += 1; //  Source n°3
its_Efx_Off3 = idx; idx += 1; //  Premier canal de la source n°3
its_Efx_VoldB3 = idx; idx += 1; //  Volume n°3 (dB)
its_Efx_Vol3 = idx; idx += 1; //  Volume n°3
its_Efx_Cell3 = idx; idx += 1; //  Cellule de la source n°3
its_Efx_Src4 = idx; idx += 1; //  Source n°4
its_Efx_Off4 = idx; idx += 1; //  Premier canal de la source n°4
its_Efx_VoldB4 = idx; idx += 1; //  Volume n°4 (dB)
its_Efx_Vol4 = idx; idx += 1; //  Volume n°4
its_Efx_Cell4 = idx; idx += 1; //  Cellule de la source n°4
its_Efx_Src5 = idx; idx += 1; //  Source n°5
its_Efx_Off5 = idx; idx += 1; //  Premier canal de la source n°5
its_Efx_VoldB5 = idx; idx += 1; //  Volume n°5 (dB)
its_Efx_Vol5 = idx; idx += 1; //  Volume n°5
its_Efx_Cell5 = idx; idx += 1; //  Cellule de la source n°5
its_Efx_Src6 = idx; idx += 1; //  Source n°6
its_Efx_Off6 = idx; idx += 1; //  Premier canal de la source n°6
its_Efx_VoldB6 = idx; idx += 1; //  Volume n°6 (dB)
its_Efx_Vol6 = idx; idx += 1; //  Volume n°6
its_Efx_Cell6 = idx; idx += 1; //  Cellule de la source n°6
its_Efx_Src7 = idx; idx += 1; //  Source n°7
its_Efx_Off7 = idx; idx += 1; //  Premier canal de la source n°7
its_Efx_VoldB7 = idx; idx += 1; //  Volume n°7 (dB)
its_Efx_Vol7 = idx; idx += 1; //  Volume n°7
its_Efx_Cell7 = idx; idx += 1; //  Cellule de la source n°7
its_Efx_Src8 = idx; idx += 1; //  Source n°8
its_Efx_Off8 = idx; idx += 1; //  Premier canal de la source n°8
its_Efx_VoldB8 = idx; idx += 1; //  Volume n°8 (dB)
its_Efx_Vol8 = idx; idx += 1; //  Volume n°8
its_Efx_Cell8 = idx; idx += 1; //  Cellule de la source n°8
its_Efx_Error = idx; idx += 1; // last error (exec_fx)
its_Efx_Check = idx; idx += 1; // quick check
idx |= 3; // for rounding to a multiple of 4 minus 1
its_Efx_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Efx_BlkSize = idx; // actual size

// Some constants
its_EfxDist = its_Efx_Src2 - its_Efx_Src1;
// Effects types
its_Efx_Undefined = 0;
its_Efx_Unspecified = 1;
its_Efx_TyNone = 1;
its_Efx_TyMixer = 2;
its_Efx_TyAutoMix = 3;
its_Efx_TyMover = 4;
its_Efx_TyAction = 5;
its_Efx_TyScript = 6;
its_Efx_TyLFO = 7;
its_Efx_TyFilter = 8;
its_Efx_TySat = 9;
its_Efx_TyMatrix = 10; // a feedback delay network (see exec_matrix)
its_Efx_TyFlanger = 11; // modulated delays (see exec_flanger)
its_Efx_TyChorus = 12; // the same engine, other default values (see its_Fl_Def)
its_Efx_TyPhaser = 13; // swept allpass filters (see exec_phaser)
its_Efx_TyShimmer = 14; // the Matrix with a pitch shifter in each line (see exec_matrix)
its_Efx_TyNoise = 15; // noises : colors, impulses, chaotic maps (see exec_noise)
its_Efx_TyRandom = 16; // random control signals (see exec_random)
its_Efx_TyMath = 17; // operations on cables (see exec_math)
its_Efx_TyRing = 18; // ring modulator, AM, frequency shifter (see exec_ring)
its_Efx_TyVU = 19; // the VU meter of the plugin Multichannel_VU_meter (see exec_vu, GM-Meters ; 2026-11-11)
its_Efx_TyLimiter = 20; // the Smooth Limiter of the plugin SmoothMultiLimiter (see exec_limiter, GM-Meters ; 2026-11-11)
its_Efx_TyCnt = 21; // count of types
// Filter modes (its_Efx_Par3)
its_FltLP1 = 0; // low pass, 1 pole
its_FltHP1 = 1; // high pass, 1 pole
its_FltLP = 2; // low pass, biquad
its_FltHP = 3; // high pass, biquad
its_FltBP = 4; // band pass, biquad
its_FltNotch = 5; // notch, biquad
its_FltSlopes = 6; // slopes (its_Efx_Par4) : 1, 2, 4, 8, 16 or 32 stages (LP, HP : 12 to 384 dB/oct ; the cost grows with them)
// Saturation modes (its_Efx_Par2)
its_SatSoft = 0; // tanh
its_SatHard = 1; // hard clip
its_SatFold = 2; // triangular wavefolder
its_SatSine = 3; // sine wavefolder
its_SatXSin = 4; // 0.5 * (x - A * sin(n * x * pi / 2)), n : the order (its_Efx_Par7), A : its_Efx_Par9
its_SatCheb = 5; // Chebyshev polynomial T_n (n real : cos(n * acos(x))), x folded back into [-1, 1]
its_SatChebSum = 6; // weighted sum of the T_k (k in [1 ... its_SatHarm], weights its_Efx_Harm1), stretched by its_Efx_Par8
its_SatCurve = 7; // the table of a curve (its number : Par10, its_Efx_Par1 + 9), see its_Sat_Curve
its_SatModeCnt = 8; // count of modes
// Matrix : its matrices (its_Efx_Par2), the work area (see exec_matrix)
its_MxHouse = 0; // Householder : I - d (2 / n) 1 1^T (d the diffusion ; 1 : lossless)
its_MxHadam = 1; // Hadamard : the fast transform / sqrt(n), on a power of 2 lines (the extra ones inside)
its_MxRing = 2; // Ring : rotations between the neighbouring lines (c, c + 1, the last one with the first), the angle d pi / 4
its_MxTypeCnt = 3;
// the loop (its_Efx_Par8) : Decay (-60 dB after T60), Freeze (no loss, no input), Grow (+60 dB per T60, the loop saturates)
its_MxLpDecay = 0; its_MxLpFreeze = 1; its_MxLpGrow = 2; its_MxLpCnt = 3;
// the spread of the delays (its_Efx_Par10) : geometric, linear, harmonic (multiples of the shortest one : pitched,
// metallic), equal (all the shortest one : one comb, the most metallic), random (geometric)
its_MxSpGeom = 0; its_MxSpLin = 1; its_MxSpHarm = 2; its_MxSpEqual = 3; its_MxSpRand = 4; its_MxSpCnt = 5;
// the input (its_Efx_Par12) : Direct (the channel c into the line c), Spread (the channel 0 into all the lines, signs alternated)
its_MxInDirect = 0; its_MxInSpread = 1;
its_MxMaxL = 128; // lines at most
its_MxMaxB = 1048576; // samples of a line at most (a power of 2)
its_MxMaxW = 16777216; // samples of all the lines at most (fewer lines : longer delays)
its_MxH = 24; // words of its header (after the one of the work area)
its_MxLW = 10; // words per line
its_SatHarm = 16; // count of the weights of the mode Cheb. sum (its_Efx_Harm1)
its_HarmH = 90; // height of the editor of the weights (pixels)
its_VuGraphH = 160; // VU meter, Limiter : the least height of their graphic area (they take all the height left)
its_SatOSCnt = 4; // oversampling (its_Efx_Par5) : 1, 2, 4 or 8 times
// words per channel in the work area : previous input, DC blocker (2), anti-aliasing biquads (4 x 2), ADAA : the previous
// input of the shape and its primitive (see its_Sat_Adaa)
its_SatChW = 13;
its_SatAdEps = 0.00001; // ADAA : below this difference of the inputs, the shape of their middle (see its_Sat_Adaa)
its_SatLn2 = log(2);
its_SatDcK = 1 - 2 * $pi * 10 / srate; // DC blocker : pole
// Noise : Brown, a leaky integrator (10 Hz) that keeps the power of the white noise
its_NzBrK = exp(-2 * $pi * 10 / srate); its_NzBrG = sqrt(1 - its_NzBrK * its_NzBrK);
its_LimAtt = 1 - exp(-1 / (0.005 * srate)); // auto-limiter of the effects : attack about 5 ms
its_LimRel = 1 - exp(-1 / (1.5 * srate)); // release about 1.5 s
its_FinMax = 10^30; // above (or NaN) : a value is not finite, the state that produced it is reset (see its_NaNCnt)
its_NaNCnt = 0; // non-finite values found and reset by @sample (filter, saturation, writer), logged by @gfx
its_NaNSeen = 0; // its_NaNCnt already logged
// Work area of an effect (KW_fxwk, see its_Fx_WorkSize) ; Filter : the header, then 5 coefficients
// [b0, b1, b2, a1, a2] per stage, then the states (2 per stage and per channel) ; Saturation : the header (its_FxW_Md :
// the oversampling of the coefficients), the coefficients of the 4 anti-aliasing biquads, then its_SatChW words per channel
its_FxW_Size = 0; // size of the area (words)
its_FxW_F = 1; // frequency, Q and mode of the coefficients
its_FxW_Q = 2;
its_FxW_Md = 3;
// Saturation : the biquads of the anti-aliasing filter (2 with ADAA, else 4) ; the shape of the primitives kept (its mode,
// -1 : none ; its order, its A), see its_Sat_Adaa
its_FxW_Nb = 4; its_FxW_AdK = 5; its_FxW_AdN = 6; its_FxW_AdA = 7;
its_FxW_Hdr = 8; // first coefficient
// LFO shapes (its_Efx_Par2)
its_LfoSine = 0;
its_LfoTri = 1;
its_LfoSawUp = 2;
its_LfoSawDown = 3;
its_LfoSquare = 4;
its_LfoCurve = 5; // the table of a curve (its_Efx_Par1 + 5 : its number 0 ... its_CrvMx-1, see its_CrvTab)
its_LfoCnt = 6; // count of shapes
// Flanger, Chorus : the modes (its_Efx_Par2) : Classic (the dry signal plus the swept delay), Through-zero (the dry signal is
// the line read at the delay : the sweep crosses it), Barber up / down (voices whose delay ramps down / up, each one in a
// window : an endless sweep ; long delays : a pitch shifter, up / down)
its_FlClassic = 0; its_FlThrough = 1; its_FlBarbUp = 2; its_FlBarbDown = 3; its_FlModeCnt = 4;
// the shapes of the sweep (its_Efx_Par8) : those of the LFO, then Random (smooth : a new value per period) and Hold (a new
// value per period, reached in the glide)
its_FlShRand = its_LfoCnt; its_FlShHold = its_LfoCnt + 1; its_FlShCnt = its_LfoCnt + 2;
its_FlMaxV = 16; // voices at most (per channel)
its_FlMaxB = 1048576; // samples of a line at most (a power of 2)
its_FlMaxW = 16777216; // samples of all the lines at most (more channels : shorter delays)
its_FlH = 16; // words of its header (after the one of the work area)
its_FlCW = 4; // words per channel
its_FlVW = 8; // words per voice
// Phaser : the modes (its_Efx_Par2) : Classic (one pole allpass stages), Resonant (two pole allpass stages, their Q : Par11),
// Barber up / down (two chains half a period apart, each one in a window, their frequency ramps up / down : an endless sweep)
its_PhClassic = 0; its_PhReson = 1; its_PhBarbUp = 2; its_PhBarbDown = 3; its_PhModeCnt = 4;
its_PhMaxS = 64; // stages at most
its_PhH = 16; // words of its header (after the one of the work area)
its_PhCW = 8; // words per channel
// Noise : the colors (its_Efx_Par2) : White, Pink (-3 dB/oct), Brown (-6 dB/oct), Violet (+6 dB/oct), Mix (the four
// above, linear between two neighbours, its_Efx_Par8 the tilt : -6 Brown, -3 Pink, 0 White, +6 Violet), Velvet (one
// impulse +-1 at a random place in each period of the density), Dust (impulses at random times, random amplitudes), Crackle
// (a chaotic map : |p y1 - y2 - 0.05|), Logistic (the logistic map r x (1 - x), "density" iterations per second, held)
its_NzWhite = 0; its_NzPink = 1; its_NzBrown = 2; its_NzViolet = 3; its_NzMix = 4; its_NzVelvet = 5; its_NzDust = 6;
its_NzCrackle = 7; its_NzLogistic = 8; its_NzCnt = 9;
// the gains that bring the peaks of each color (the maximum over 45 ms, as a peak meter) to those of the white noise
// (uniform in [-1, 1] : its peaks are its level)
its_NzPkG = 0.3392 * 0.5552; its_NzBrC = 0.8586; its_NzViG = sqrt(0.5) * 0.7205;
its_NzSwR = 0.25; // the swells of the rumble : a new target 0.25 times per second
its_NzT = 16; its_NzTN = 1024; // the table of the shape |x|^e (its_NzTN + 1 values) in its header, from the word its_NzT
its_NzH = its_NzT + its_NzTN + 4; // words of its header (after the one of the work area)
its_NzCW = 24; // words per channel, and for the common generator (after the channels)
// Random : the modes (its_Efx_Par2) : Step (a new value at each tick, held), Smooth (from a value to the next over the
// interval), Walk (at each tick a step of "walk" times a draw, reflected within [-1, 1]) ; the laws of the draws (Par7) :
// Uniform in [-1, 1], Gauss (sigma 1/3, within [-1, 1]), Binary (+-1), Curve (the curve Par6 read at a random place : its
// shape is the distribution of the values)
its_RnStep = 0; its_RnSmooth = 1; its_RnWalk = 2; its_RnModeCnt = 3;
its_RnUnif = 0; its_RnGauss = 1; its_RnBin = 2; its_RnCurve = 3; its_RnLawCnt = 4;
// the trigger (its source) : a rising edge above the threshold (Par11) gives a tick, and restarts the clock ; rate 0 : the
// triggers only ; clock Common : the first channel of the trigger, clock Own : a channel of the trigger per channel
its_RnH = 8; // words of its header (after the one of the work area)
its_RnCW = 14; // words per channel, and for the common clock (after the channels), see exec_random
its_RnHyst = 0.01; // the hysteresis of the trigger : an edge above the threshold + its_RnHyst, again armed at the threshold
// the detection of the trigger (Par12) : its wave, or its envelope (an instant attack, the release MxX + 5) : an attack,
// the envelope above the threshold and its_RnJump times its recent level (6 dB), again armed at its_RnReArm (2 dB), see
// its_Rn_Trig
its_RnDtWave = 0; its_RnDtEnv = 1;
its_RnJump = 2; its_RnReArm = 1.25;
// Math : the operations (its_Efx_Par2) on A (its source 1) and B (its source 2, else the value Par5) : Scale (A), Mul (A x B),
// Add, Sub, Min, Max, Abs (|A|), Env (the envelope of A : attack Par7, release Par8), Gate (1 if A > B, 0 when A <= B : the
// hysteresis its_RnHyst), Slew (A, its rise and fall limited : a unit in "attack" ms, in "release" ms), Log (20 log10 |A| :
// dB), Exp (10^(A/20) : dB to linear) ; then the output = offset + scale x the result
its_MtScale = 0; its_MtMul = 1; its_MtAdd = 2; its_MtSub = 3; its_MtMin = 4; its_MtMax = 5; its_MtAbs = 6; its_MtEnv = 7;
its_MtGate = 8; its_MtSlew = 9; its_MtLog = 10; its_MtExp = 11; its_MtCnt = 12;
its_MtH = 8; // words of its header (after the one of the work area)
its_MtCW = 2; // words per channel (the state of Env, Gate, Slew)
// Ring : the modes (its_Efx_Par2) : Ring (A x the carrier), AM (A x (1 - amount (1 - the carrier) / 2) : amount 1, a full
// tremolo ; 2, the ring), Up and Down (the frequency shifter : the spectrum of A moves up or down by the frequency of the
// carrier, A and the carrier made analytic by a 90 degree network, see its_Rg_Hilb ; the carrier B : its sum or its
// difference frequencies only) ; the carrier : B (its source 2), else the oscillator (Par1 the frequency, Par8 the shape)
its_RgRing = 0; its_RgAM = 1; its_RgUp = 2; its_RgDown = 3; its_RgModeCnt = 4;
its_RgH = 8; // words of its header (after the one of the work area)
its_RgSA = 8; its_RgSC = 42; // the 90 degree networks of a channel (34 words each) : A, the carrier
its_RgCW = 80; // words per channel : 0 the phase, 3 4 6 the random values of the shapes Random and Hold, the networks

its_EfxStat_Off = 0; // its_Efx_Status : the effect is not executed
its_EfxStat_On = 1; // (= its_Efx_Unspecified, set by FX_Clear)
its_EfxStat_Bypass = 2; // the first source goes unchanged to the output (an LFO is silent)

its_Efx_PhaseStd = 0;
its_Efx_PhasePre = 1;
its_Efx_PhasePost = 2;

its_EfxAct_Copy = 1;
its_EfxAct_Paste = 2;
its_EfxAct_Clear = 3;
its_EfxAct_AutoGains = 4;
its_EfxAct_Reset = 5;
its_EfxAct_Create = 6;
its_EfxAct_Show = 7;
its_EfxAct_Delete = 9;
its_EfxAct_Patch = 11;





