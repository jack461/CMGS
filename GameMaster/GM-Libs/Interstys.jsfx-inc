    (act === its_RdrAct_Activate) ? (
        reader[its_Rdr_Check] = 0;
    ) :
    (act === its_RdrAct_Show) ? (
        dbg_show_1(reader, 1010);
    ) :
    (act === its_RdrAct_Test) ? (
        dbg_show_1(reader, 1011);
    ) :
    (act === its_RdrAct_Delete) ? (
        Rd_Delete(rdrn);
    ) :
    (
        err = 127;
    );
    err;
);



/*
    associate line "bufn" [0 ... LN_CNT-1] to writer "wrtn"
    "bufn == -1" to remove the line from the writer
*/
function Wr_Set_Line(wrtn, bufn)
local(writer, lcbl)
(
    ((wrtn < 0) || (wrtn >= WR_CNT)) ? (
        0x112; // erreur
    ) :
    (((writer = Writers_set[wrtn]) <= BASE_MEMORY) || (writer[-2] !== KW_writ)) ? (
        0x114; // erreur
    ) :
    (bufn === -1) ? (
        // remove the line : the writer stops
        writer[its_Wrt_Flgs] &= -1 ~ (its_WrtFlg_init | 2);
        writer[its_Wrt_LineNb] = -1;
        writer[its_Wrt_Lcbl] = writer[its_Wrt_Buff_1] = 0;
        writer[its_Wrt_Status] = its_WrtStat_Created;
        its_Run_Check(writer);
        writer[its_Wrt_Check] = -1;
        Wr_Followers(writer, 0); // they will find that the writer has no line
        0;
    ) :
    ((bufn < 0) || (bufn >= LN_CNT)) ? (
        0x115; // erreur
    ) :
    (((lcbl = Lines_Set[bufn]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl)) ?(
        0x117; // erreur
    ) : (
        writer[its_Wrt_Lcbl] = lcbl;
        writer[its_Wrt_Buff_1] = lcbl + its_Lin_BF1ST;
        writer[its_Wrt_LineNb] = bufn; // in [0 ... N-1]
        writer[its_Wrt_SmplCnt] = lcbl[its_Lin_SmplCnt];
        writer[its_Wrt_ChNbr] = lcbl[its_Lin_ChCnt];
        writer[its_Wrt_Start] = lcbl[its_Lin_Start];
        writer[its_Wrt_Last] = lcbl[its_Lin_Last];
        writer[its_Wrt_Abspos] = lcbl[its_Lin_Start];
        writer[its_Wrt_Flgs] |= its_WrtFlg_init;
        writer[its_Wrt_Check] = -1;
        // default source : In, channel 0
        (writer[its_Wrt_Src] === 0) ? (writer[its_Wrt_Src] = ITS_KIn * ITS_KMul);
        writer[its_Wrt_Status] = max(writer[its_Wrt_Status], its_WrtStat_Ready);
        its_Run_Check(writer);
        Wr_Followers(writer, 0); // the delay readers take the new line
        0;
    );
);

/*
    set the status "st" of writer "wrtn" ; returns the actual status (-1 : no writer)
    without a line or a source cell, the writer stays "Created"
    used by the writer pad (and the table)
*/
function Wr_Set_Status(wrtn, st)
local(writer, lcbl)
(
    ((wrtn < 0) || (wrtn >= WR_CNT) || ((writer = Writers_set[wrtn]) <= BASE_MEMORY) || (writer[-2] !== KW_writ)) ? (
        -1;
    ) : (
        (((lcbl = writer[its_Wrt_Lcbl]) <= BASE_MEMORY) || (lcbl[-2] !== KW_lcbl) || (writer[its_Wrt_Src] === 0)) ? (
            st = its_WrtStat_Created;
        ) : (
            st = max(its_WrtStat_Ready, min(its_WrtStat_Writing, st));
        );
        (st === its_WrtStat_Writing) ? (
            writer[its_Wrt_Flgs] |= 2;
        ) : (
            writer[its_Wrt_Flgs] &= 0xFFFD;
        );
        writer[its_Wrt_Status] = st;
        its_Run_Check(writer);
        st;
    );
);

// the direction "d" of the writing of the writer block "w" (its_WrtDir_..., modes X-fade and Sum), and its current step
function Wr_Set_Dir(w, d)
(
    d = max(0, min(its_WrtDirCnt - 1, 0|d));
    w[its_Wrt_Dir] = d;
    w[its_Wrt_Step] = (d === its_WrtDir_Bwd) ? -1 : 1;
);

// the position in its line of the sample written "off" samples (>= 1, may be fractional) before the head of the writer
// "w" (the next sample written : its_Wrt_Abspos) : behind the head in its direction (its_Wrt_Step) ; forward and
// backward, the path folds at the ends of the line (a triangle of period 2 (size - 1)), see exec_writer
function its_Wr_Back(w, off)
local (st, n, r, p, u)
(
    st = w[its_Wrt_Start]; n = w[its_Wrt_SmplCnt]; r = w[its_Wrt_Abspos] - st;
    ((w[its_Wrt_Dir] === its_WrtDir_Both) && (n > 1)) ? (
        p = 2 * (n - 1);
        u = ((w[its_Wrt_Step] >= 0) ? r : p - r) - off; // on the unfolded path [0, p)
        u -= p * floor(u / p);
        st + ((u <= n - 1) ? u : p - u);
    ) : (
        u = (w[its_Wrt_Step] >= 0) ? r - off : r + off;
