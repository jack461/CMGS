its_Efx_VoldB6 = idx; idx += 1; //  Volume n°6 (dB)
//   30
its_Efx_Vol6 = idx; idx += 1; //  Volume n°6
its_Efx_Dst6 = idx; idx += 1; //  Destination n°6
its_Efx_Src7 = idx; idx += 1; //  Source n°7
its_Efx_VoldB7 = idx; idx += 1; //  Volume n°7 (dB)
its_Efx_Vol7 = idx; idx += 1; //  Volume n°7
its_Efx_Dst7 = idx; idx += 1; //  Destination n°7
its_Efx_Src8 = idx; idx += 1; //  Source n°8
its_Efx_VoldB8 = idx; idx += 1; //  Volume n°8 (dB)
its_Efx_Vol8 = idx; idx += 1; //  Volume n°8
its_Efx_Dst8 = idx; idx += 1; //  Destination n°8
//   40
idx += 1;
its_Efx_Check = idx; idx += 1; // quick check
its_Efx_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Efx_BlkSize = (idx | 3) + 1; // round to a multiple of 4  Taille du bloc

// Some constants
its_EfxDist = its_Efx_Src2 - its_Efx_Src1;
