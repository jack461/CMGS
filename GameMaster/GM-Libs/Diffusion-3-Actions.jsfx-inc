

@init


// Execute an internal action
// Number in [1 ... 127]
D3_actpcnt = 0;
D3_actvals = 0;
glvact0 = glvact1 = glvact2 = glvact3 = glvact4 = 0;
function perform_action(act, cnt, pars)
local(Err, box, val)
(

    Err=0;
    (act<32)?((act<15)?((act<7)?((act<3)?((act<1)?((act<0)?(

        //===-1===//
        Err=-1;
        //===-1===//

    ):(

        //===0===//
        // A nop
        Err=0;
        //===0===//

    );):((act<2)?(

        //===1===//
        // -1 = toggle graphic display ; 0 : hide 1; 1 : show it
        glvact0 = statgraph;
        (cnt > 0) ? togglegraphics(pars[0]);
        //===1===//

    ):(

        //===2===//
        // par == -1 : toggle sliders ; par == 0 : hide sliders ; par == 1 : show sliders
        glvact0 = statsldrs;
        (cnt > 0) ? togglesliders(pars[0]);
        //===2===//

    ););):((act<5)?((act<4)?(

        //===3===//
        // par == -1 : toggle clock/timer display ; par == 0 : hide clock ; par == 1 : show clock
        glvact0 = statclock;
        (cnt > 0) ? toggleclock(pars[0]);
        //===3===//

    ):(

        //===4===//
        // par == 1 : refresh graphics
        wrefresh = pars[0];
        //===4===//

    );):((act<6)?(

        //===5===//
        // par == -1 : toggle clock | timer ; par == 0 : display clock ; par == 1 : display timer
        glvact0 = stattimer;
        (cnt > 0) ? toggletimer(pars[0]);
        //===5===//

    ):(

        //===6===//
        // par == -1 : toggle current projector status display ; par == 0 : hide status ; par == 1 : show status
        glvact0 = statproj;
        (cnt > 0) ? toggleproj(pars[0]);
        //===6===//

    );););):((act<11)?((act<9)?((act<8)?(

        //===7===//
        // Show current background color
        sprintf(#color, "%06X",  (gxcred<<16)|(gxcgreen<<8)|gxcblue);
        box = mk_display_box(0, #color, "bg. color", 120, bx__2strings|bx__boxaround, 2, 1);
        box[bx_extraw] = 12; // add some width
        //===7===//

    ):(

        //===8===//
        // Show current window size
        sprintf(#uidsp, "%d/%d - %d:%d", gfx_w, gfx_h, win_cols, win_lines);
        mk_display_box(2|bx__boxaround, #uidsp, 2, -1, 60); // 2 => random
        //===8===//

    );):((act<10)?(

        //===9===//
        // -1 : exchange logs/live ; 0 : select logs; 1 : select live
        glvact0 = uix_jmbsel;
        (cnt > 0) ? (
            (pars[0] <= -1) ? (
                uix_jmbsel = (uix_jmbsel + 1) % dcbTabsCount;
            ) : (
                uix_jmbsel = pars[0] % dcbTabsCount;
            );
            ui_screen_switch(uix_jG_menuscr[uix_jmbsel]);
        );
        //===9===//

    ):(

        //===10===//
        // Set/Reset timer
        glvact0 = floor(timec - timet);
        (cnt > 0) ? (
            timet = timec - pars[0]; // reset the timer
            timedir = pars[0] >= 0;
            w = (pars[0] > 0) || (pars[0] == 0);
            // sprintf(#ct, "Act-10 [%d]: pars[0]: %f  timdedir: %d  w: %d", cnt, pars[0], timedir, w); mSL_log(SysLogBox, #ct);
            toggletimer(1);
        );
        //===10===//

    ););):((act<13)?((act<12)?(

        //===11===//
        // Clear non permanent boxes
        box = dispboxes;
        loop (dispboxcount,
            (box[bx_activ] & bx__used) ? (
                (box[bx_endshow] > 0) ? box[bx_endshow] = 1;
            );
            box += dispboxsize;
        );
        //===11===//

    ):(

        //===12===//
        // Run an mSL function
        ((pars[0] > mSL_Sym_Low) && (pars[0] < mSL_Sym_High)) ? (
            // look for the symbol in the external table
            ent = mSL_searchXId(pars[0]);
            // sprintf(#zz2,     "Action 12: %s => %d", mSL_id2Str(pars[0], #zz3), ent); mSL_log(SysLogBox, #zz2);
            (ent > 0) ? (
                val = A_mSL_EXTab[ent];
                // sprintf(#zz2, "       12 -> %s   %d / %d", mSL_edit_value(#zz3, val, 0), cnt-3, pars+1); mSL_log(SysLogBox, #zz2);
                mSL_run_fct(val, cnt-3, pars+1);
            );
        );
        // Err=12;
        //===12===//

