// Perform a list of actions. It is a sequence of :
//   [color, kmdAsize, kmdA, parA1, parA2, ..., parAN, kmdBsize, ... , parBN, ..., parXn, -1]
//        kmdI = a primitive command number
//        parI1, parI2, ... parIn : the parameters (up to 8)
//        kmdISize = 1 + number of parameters
//        color = a number in 0-16, used for display in the control surface
function perform_actionlist(lst)
local (l, err, op, k, cnt)
(
    // sprintf(#wxz, "Actions: %d", lst);  mSL_log(SysLogBox, #wxz);
    lst += 1; // skip the color
    l = lst[0];
    cnt = err = 0;
    // l includes "length" "kmd" "pars" ....
    // l === 2 when no par, 3 for 1 par, etc.
    while (k = ((err === 0) && (l === floor(l)) && (l > 0)))  (
        op = lst[1] ;cnt += 1;
        // (#wxz, "Actions do [%f] : %d", l, lst[1]);  mSL_log(SysLogBox, #wxz);
        err = perform_action(lst[1], l, lst+2);
        (l <= 10) ? (
            lst += l; l = lst[0];
        ) : (
            err = 4097;
        );
        // sprintf(#wxz, "Actions done [%f] : %d", l, lst[1]);  mSL_log(SysLogBox, #wxz);
    );
    // sprintf(#wxz, "Actions: k = %d/%d, err = %d, l = %d/%d, lastop = %d, lst = %d", k, cnt, err, l, (l === floor(l)), op, lst); mSL_log(SysLogBox, #wxz);
);




