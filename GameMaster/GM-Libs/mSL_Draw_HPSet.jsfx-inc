

/*
    Represent the HP Configuration in a graphic window of the live screen : a box of the grid (allocation, size),
    in which the view of Space 3D is drawn (mSL_ui_Space3D, Diffusion-3-Space3D : included before)
*/



<? no_init != 0 ? _suppress=1; ?>
@init
<? _suppress=0; ?>



/*
    Draw the window : the view of the module Space 3D (the same scene : the speakers of the configuration of Diffusion,
    their levels and the gains of the current configuration, see sx_Update), in its own offscreen image (SX_IMG2) ;
    then the marks of the box (frame, locked, permanent)
*/

function HP_Draw_conf(box)
local (tx, ty, tw, th, flact, r, oi, ow, oh, oo, on, os, od, ost)
(
    flact = box[bx_activ];
    tx = box[bx_xpos] + win_Xfr; // top x
    ty = box[bx_ypos] + win_Yfr; // top y
    tw = box[bx_needw]; // width of the box
    th = box[bx_needh];  // height of the box

    sx_Update();
    // the font of the numbers : half a square (12 at 100 %), not the font left by the last box
    gfx_setfont(14, "Arial", max(9, min(16, floor(sqr_h * 0.5))));
    uix_font_dirty = 1; // ui-lib will set its own font again
    oi = s3d_img; ow = s3d_iw; oh = s3d_ih;
    s3d_img = SX_IMG2; s3d_iw = sx_liw; s3d_ih = sx_lih;
    od = s3d_gdark; s3d_gdark = sx_lgdark; // the state of the hysteresis of the grid, for this background
    // only the speakers : no trajectory, no sources (nor their group center) ;
    // the background : black, or that of the live screen (key '/', sx_lbg) with its contrasting texts
    oo = s3d_opt; on = s3d_nsrc; os = s3d_sel; // (a selected source would be unselected by s3d_selection)
    s3d_opt &= 0x7FFFFFFF - s3d_oTraj - (sx_lbg ? s3d_oStars : 0);
    s3d_nsrc = 0; s3d_gon = 0;
    sx_lbg ? (
        s3d_bgr = gxcred / 255; s3d_bgg = gxcgreen / 255; s3d_bgb = gxcblue / 255;
        s3d_txr = gfxstdr; s3d_txg = gfxstdg; s3d_txb = gfxstdb;
    );
    ost = s3d_style; s3d_style = 1; // the gains of the configuration as crosses, the levels as halos
    s3d_draw(tx, ty, tw * sqr_w - 1, th * sqr_h - 1);
    s3d_style = ost; // (that of the module Space 3D : key 'h')
    s3d_bgr = s3d_bgg = s3d_bgb = 0; s3d_txr = s3d_txg = s3d_txb = 1;
    s3d_opt = oo; s3d_nsrc = on; s3d_gon = 1; s3d_sel = os;
    sx_liw = s3d_iw; sx_lih = s3d_ih;
    sx_lgdark = s3d_gdark; s3d_gdark = od;
    s3d_img = oi; s3d_iw = ow; s3d_ih = oh;
    gfx_a = 1;

    // Is there a full frame around the box ?
    (flact & bx__select) ? (
        draw_around_box(box[bx_xpos], box[bx_ypos], box[bx_sqw]*sqr_w, box[bx_sqh]*sqr_h, 0x2F);
    ) :
    // Is this the selected view ?
    (((flact & bx__boxaround) && (timez < box[bx_crdate] + uiBoxDuration)) || (flact & bx__drawhfrbox)) ? (
        flact &= 0x7FFFFFFF - bx__drawhfrbox;
        draw_around_box(box[bx_xpos], box[bx_ypos], box[bx_sqw]*sqr_w, box[bx_sqh]*sqr_h, 0x26);
    );

    gfx_r = gfxstdr; gfx_g = gfxstdg; gfx_b = gfxstdb; // Select contrasting colors.
    // Show box as locked ?
    (flact & bx__permlock) ? (
        r = ceil(sqr_w / 5);
        gfx_circle(win_Xfr + box[bx_xpos] + r, win_Yfr + box[bx_ypos] + r, r, 1, 1);
    );
    // Show box as permanent ?
    (flact & bx__keepVisible) ? (
        // show a triangle
        gfx_triangle(win_Xfr + box[bx_xpos], win_Yfr + box[bx_bottom],
            win_Xfr + box[bx_xpos] + 0.5 * sqr_w, win_Yfr + box[bx_bottom],
            win_Xfr + box[bx_xpos], win_Yfr + box[bx_bottom] - 0.5 * sqr_h);
    );

    (flact & bx__update) ? (
        box[bx_crdate] = timec; // create/reposit. date
        flact &= 0x7FFFFFFF - bx__update;
    );
    box[bx_activ] = flact;
);


function HP_Dr_updsize(box, newf)
local()
(
    (box[bx_sfact] != newf) ? (
        box[bx_sfact] = newf;
        box[bx_sqw] = ceil(HPDr_w * newf / sqr_bw);
        box[bx_sqh] = ceil(HPDr_h * newf / sqr_bh);
        box[bx_needw] = 0;
        box[bx_needh] = 0;
    );
);


/*
    Allocate a box for the drawing
*/
function HP_Draw_Init(flg)
local (ub, box, c, n,f)
(
    box = c = n = 0;
    while ((box === 0) && (c < dispboxcount)) (
        ub = dispboxes + n * dispboxsize;
        (ub[bx_activ] === 0) ? (
            box = ub;
            ub[bx_type] = bx_ty_hpset;
        );
        n = (n + 1) % dispboxcount; c+= 1;
    );
    (box != 0) ? (
        // Initialize the box for the drawing
        box[bx_activ] = bx__used | bx__boxaround | flg;
        box[bx_posflgs] = bx__rstall|bx__drawmains;
        ub[bx_name] = HP_Box_Id;
        box[bx_psfact] = box[bx_sfact] = f = HPDr_f;
        // Compute the needed size
        box[bx_sqw] = ceil(HPDr_w * f / sqr_bw);
        box[bx_sqh] = ceil(HPDr_h * f / sqr_bh);
        box[bx_posit] = -1;
        box[bx_needh] = box[bx_needw] = 0;
        box[bx_initw] = box[bx_inith] = 0; // (no initial size in squares : Reset size goes back to HPDr_f)
        box[bx_red1] = 32;
        box[bx_green1] = 240;
        box[bx_blue1] = 40;
        box[bx_font1] = "monaco";
        box[bx_red2] = 180;
        box[bx_green2] = 180;
        box[bx_blue2] = 40;
        box[bx_font2] = "monaco";
        box[bx_endshow] = -1;
        box[bx_zfact] = 1;
        box[bx_drmode] = bx__ShowPow;
        box[bx_xshift] = box[bx_yshift] = 0;
        box[bx_crdate] = timec; // create/reposit. date
        box[bx_check] = bx__bxcheck;
        AAAAAHPSTATUS_1 = box;
    );
    box;
);


function HP_Draw_Pic(box, bxn)
local (f, p, flact, bpx, bpy, bpw, bph, w, z)
(
    flact = box[bx_activ];
    (flact & bx__drawbox) ? (
        AAAAAHPSTATUS_7 = flact;
        AAAAAHPSTATUS_8 = box[bx_posit];
        // Check we have the room for drawing
        p = -1;
        bpw = box[bx_sqw]; bph = box[bx_sqh]; // needed size
        AAAAAHPSTATUS_11 = bpw; AAAAAHPSTATUS_12 = bph;
        AAAAAHPSTATUS_13 = ((flact & bx__posfound) && ((box[bx_posit]) >= 0));
        // Could we already have what we need ?
        ((flact & bx__posfound) && ((w = uim_utl(box[bx_posit])) >= 0)) ? (
            AAAAAHPSTATUS_9 = dispalloc_a[w];
            AAAAAHPSTATUS_10 = ((bxn << 24) | (bph << 12) | bpw);
            AAAAAHPSTATUS_14 = (box[bx_needw] === bpw) && (box[bx_needh] === bph);
            ((box[bx_needw] === bpw) && (box[bx_needh] === bph) && (dispalloc_a[w] === (z = (bxn << 24) | (bph << 12) | bpw))) ? (
                p = box[bx_posit]; // ok. we keep it
            ) : (
                uim_trc2 ? (
                    sprintf(#wxz, "  -o- Draw_Pic [%d ? %d, %d ? %d, %X ? %X]", box[bx_needw], bpw, box[bx_needh], bph, dispalloc_a[w], z);
                    mSL_log(SysLogBox, #wxz);
                );
                // free it first
                uim_free((box[bx_posit]), box);
                box[bx_posit] = p = -1;
            );
        );
        (p < 0) ? (
            p = uim_alloc(bpw, bph, box[bx_posflgs] & bx__allocmod, bxn);
            (p < 0) ? (
                // no space for displaying - retry with a small size
                f = box[bx_sfact];
                (f > box[bx_psfact]) ? (
                    // try to reuse it
                    box[bx_sfact] = f = box[bx_psfact];
                ) : (
                    // try to diminish it a little
                    box[bx_sfact] = box[bx_psfact] = f = max(8, floor(f * 0.97));
                );
                box[bx_sqw] = ceil(HPDr_w * f / sqr_bw);
                box[bx_sqh] = ceil(HPDr_h * f / sqr_bh);
            );
            AAAAAHPSTATUS_3 += 1; // reallocating
            uim_trc2 ? (
                sprintf(#wxz, "  -o- alloc [%d:%d < %07X]  => %06X / %08X", bxn, box, box[bx_activ], p,
                   dispalloc_a[uim_utl(box[bx_posit])]); mSL_log(SysLogBox, #wxz);
            );
            flact = box[bx_activ]; // (updated by uim_alloc)
        );
        (p >= 0) ? (
            // a position is found at "p"
            flact |= bx__posfound;
            box[bx_posit] = p;
            box[bx_needw] = bpw;
            box[bx_needh] = bph;
            box[bx_psfact] = box[bx_sfact]; // keep as a "working" value
            bpx = p & 0xFFF;
            bpy = p >> 12;
            // compute the rounding box
            box[bx_xpos] = bpx * sqr_w;
            box[bx_ypos] = bpy * sqr_h + win_menu_height;
            box[bx_right] = box[bx_xpos] + bpw * sqr_w;
            box[bx_bottom] = box[bx_ypos] + bph * sqr_h;
            box[bx_activ] = flact;
            HP_Draw_conf(box);
            flact = box[bx_activ];
            flact &= 0x7FFFFFFF - bx__update;
        );
        ((timez > box[bx_endshow]) && (box[bx_endshow] > 0)) ? (
            // prepare
            (box[bx_endcoef] > 1) ? (
                // we are at the end of displaying
                flact &= 0x7FFFFFFF - bx__drawbox;
            );
        );
    ) : (
        (flact & bx__posfound) ? (
            // free the position in screen
            uim_free((box[bx_posit]), box);
            flact &= 0x7FFFFFFF - bx__posfound;
        );
    );
    box[bx_activ] = flact;
);
