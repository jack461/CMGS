/*
    mSL_System_Keys.jsfx-inc
    The system commands typed on the keyboard, the same in FilePlayer, ScriptMaster, Diffusion-3 and Interstys
    (not in GamePlayer : its keys are the commands of the concert)
    (c)Jean-Jacques Girardot

    Include it in @gfx (it has no @init), after mSL_Garbage_Collector, mSL_Threads, mSL_Scheduler and mSL_ui_LibJJ.
    Call do_System_Keys() at the end of the frame, after the modules, the panes, the tabs and the commands
    of the plugin (do_Plugin_Keys) : it only gets the keys that they have left (see mSL_ui_LibJJ, Keyboard).

    Lower case for the commands (the capitals are for the displays, in the commands of each plugin :
    L and M, system log and memory dumps, in FilePlayer and ScriptMaster) :
        g   garbage collection                  k   kill all the threads
        m   memory walk                         n   memory walk (mode 8)
        c   recycling of the dynamic memory     l   memory display limit
        r   run the first suspended task
        t   mSL test run on / off               o   one test run                s   stop the test runs
*/

function do_System_Keys()
local (ent)
(
    GM_key_peek() ? ui_GFXdoNow |= 1; // a key : the display may change
    GM_key_take('g') ? (gc_run(2);) :
    GM_key_take('k') ? (mSL_kill_all_thread();) :
    GM_key_take('m') ? (mem_walk(0); mem_show();) :
    GM_key_take('n') ? (mem_walk(8); mem_show();) :
    GM_key_take('c') ? (mSL_Dyn_RecycleF = mSL_Dyn_RecycleF ? 0 : 1;) :
    GM_key_take('l') ? (mm_show_limit = ((mm_show_limit * 10 + 1) % 20) / 10;) :
    GM_key_take('r') ? (
        ((ent = SchedDetachHead(SchedSuspPts)) != SchedNone) ? (
            SchedInsertTail(SchedActivPts, ent, SchETypeThrd);
        );
    ) :
    GM_key_take('t') ? (mSL_run_test = mSL_run_test ? 0 : 1; mSL_run_max = 25;) :
    GM_key_take('o') ? (mSL_run_once = mSL_run_once ? 0 : (mSL_run_test = 1; mSL_run_max = 1);) :
    GM_key_take('s') ? (mSL_run_test = 0;);
);
