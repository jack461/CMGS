slider<? printf("%d", (slnum += 1)); ?>:slLnActn=0<0,4,1{Done,Clear,Create,---,Delete}>Action

<? slnum += 1; ?>


slider<? printf("%d", (slnum += 1)); ?>:slReader=0<0,<? printf("%d", RD_CNT-1); ?>,1{Reader 1<? i=2; loop(RD_CNT-1, printf(",Reader %d",i); i+= 1;); ?>}> ================> Selected Reader :
