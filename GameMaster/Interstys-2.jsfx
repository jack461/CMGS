desc:Interstys delay
desc:Interstys modular fractional delay - V0.1.1

// Some constants
<?
/*
    Définir ici les caractéristique désirées pour "Interstys"

*/
    RD_CNT = 40; // nombre de lecteurs
    WR_CNT = 32; // nombre de writers
    LN_CNT = 32; // nombre de buffers audio
    FX_CNT = 80; // Nombre d'effets
    CH_NB = 128; // nombre de canaux à gérer (spl & alt)
    NB_AUX = 128; // autres zones de travail (aux & tmp)
    NB_WRK = 32; // mots immédiats
    /*
        Les cellules sont, dans l'ordre
        1 : "None" - cellule toujours inutilisée
        NB_WRK : mots de travail, "Work i"
        RD_CNT : mots de travail, "Reader i"
        WR_CNT : mots de travail, "Writer i"
        CH_NB : les spl (128)
        CH_NB : les alt (128, copies des spl)
        NB_AUX : les aux
        NB_AUX : les tmp
    */
    SMPL_SIZE = 1 + NB_WRK + RD_CNT + WR_CNT + 2 * CH_NB + 2 * NB_AUX;
    SPL_P = 1 + NB_WRK + RD_CNT + WR_CNT;
    ALT_P = 1 + NB_WRK + RD_CNT + WR_CNT + CH_NB;
    // Génération des noms des cellules
    function gen_cells_names()
    (
        printf("None");
        i = 1; loop(NB_WRK, printf(",Work %d", i); i+=1;);
        i = 1; loop(RD_CNT, printf(",Reader %d", i); i+=1;);
        i = 1; loop(WR_CNT, printf(",Writer %d", i); i+=1;);
        i = 0; loop(CH_NB, printf(",spl(%d)", i); i+=1;);
        i = 0; loop(CH_NB, printf(",alt %d", i); i+=1;);
        i = 0; loop(NB_AUX, printf(",aux %d", i); i+=1;);
        i = 0; loop(NB_AUX, printf(",tmp %d", i); i+=1;);
    );
    slnum = 1;

    // Options
    no_mslog = 1;
?>

//°°°  SLIDERS
slider<? printf("%d", (slnum += 1)); ?>:slLine=0<0,<? printf("%d", LN_CNT-1); ?>,1{Line 1<? i=2; loop(LN_CNT-1, printf(",Line %d",i); i+= 1;); ?>}> ================> Selected Line :
slider<? printf("%d", (slnum += 1)); ?>:slLnStatus=0<0,3,1{Undefined,Ready,Used}>Line status
