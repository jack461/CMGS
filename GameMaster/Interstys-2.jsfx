function double_to_double_single(d, hi*, lo*)
local(signe, log2_approximatif, exposant, facteur_echelle, mantisse_complete, mantisse_entiere, bits_bas, bits_hauts)
(
  // Étape 1 : Gestion du cas zéro
  d === 0 ? (
    hi = 0;
    lo = 0;
  ) : (
    // Étape 2 : Gestion du signe
    signe = 1;
    d < 0 ? (
      signe = -1;
      d = -d; // Traiter la valeur absolue
    );

    // Étape 3 : Calcul de l'exposant avec le log10 natif de JSFX
    // The number 3.3219... is 1/log10(2)
    log2_approximatif = log10(d) * 3.3219280948873623478703194294893901758648;

    // Sécurité contre les approximations de floor sur les puissances de 2
    exposant = floor(log2_approximatif + 10^-12);
    facteur_echelle = 2 ^ exposant;

    // Ajustement de sécurité
    facteur_echelle > d ? (
      exposant -= 1;
      facteur_echelle = 2 ^ exposant;
    );

    // Étape 4 : Extraction de la mantisse entière (2^52)
    mantisse_complete = d / facteur_echelle;
    mantisse_entiere = floor(mantisse_complete * 4503599627370496);

    // Étape 5 : Découpage avec le Modulo natif (2^29 = 536870912)
    bits_bas = mantisse_entiere % 536870912;
    bits_hauts = floor(mantisse_entiere / 536870912);

    // Étape 6 : Reconstruction et application du pointeur de sortie (2^23 = 8388608)
    hi = (bits_hauts / 8388608) * facteur_echelle * signe;
    lo = (bits_bas / 4503599627370496) * facteur_echelle * signe;
  );
);


// Déclaration de la fonction de reconstruction
function double_single_to_double(hi, lo)
local(signe_hi, abs_hi, exp_hi, scale_hi, mant_hi)
(
  // 1. Sécuriser 'hi' pour s'assurer qu'il s'agit d'un float 32-bit valide.
  // Un float32 n'a que 24 bits de mantisse (1 implicite + 23 stockés).
  hi == 0 ? (
    mant_hi = 0;
  ) : (
    signe_hi = hi < 0 ? -1 : 1;
    abs_hi = abs(hi);

    // Extraire l'exposant de 'hi'
    exp_hi = floor(log10(abs_hi) * 3.3219280948873623478703194294893901758648 + 10^-12);
    scale_hi = 2 ^ exp_hi;
    scale_hi > abs_hi ? (
      exp_hi -= 1;
      scale_hi = 2 ^ exp_hi;
    );

    // Tronquer la mantisse de 'hi' à 24 bits pour éliminer les résidus 64-bit indésirables
    mant_hi = floor((abs_hi / scale_hi) * 8388608) / 8388608 * scale_hi * signe_hi;
  );

  // 2. Fusionner la partie haute nettoyée et la partie basse
  // Le résultat renvoyé par la fonction est un double 64-bit parfait.
  mant_hi + lo;
);

/*  Tests for dtds et dstd */
N1 = $pi;
N1L = N1H = 0;
double_to_double_single(N1, N1H, N1L);
N1R = double_single_to_double(N1H, N1L);
N1Z = N1 === N1R;

N2 = 'stwa';
N2L = N2H = 0;
double_to_double_single(N2, N2H, N2L);
N2R = double_single_to_double(N2H, N2L);
N2Z = N2 === N2R;

N3 = SECURE_BL;
N3L = N3H = 0;
double_to_double_single(N3, N3H, N3L);
N3R = double_single_to_double(N3H, N3L);
N3Z = N3 === N3R;

N4 = 225;
N4L = N4H = 0;
double_to_double_single(N4, N4H, N4L);
N4R = double_single_to_double(N4H, N4L);
N4Z = N4 === N4R;

N5 = $e;
N5L = N5H = 0;
double_to_double_single(N5, N5H, N5L);
N5R = double_single_to_double(N5H, N5L);
N5Z = N5 === N5R;

N6 = 0;
N6L = N6H = 0;
double_to_double_single(N6, N6H, N6L);
N6R = double_single_to_double(N6H, N6L);
N6Z = N6 === N6R;

N7A = 10^-12;
N7B = 0.000000000001;

N8A = 10^-16;
N8B = 0.0000000000000001;
N9 = 3.3219280948873623478703194294893901758648;
/* */

function make_stop_table(dur)
local (i, cnt, fct)
(
    cnt = min(STOP_TABLE_SIZE, max(1,min(100,floor(dur))) * srate/1000);
    fct = $pi * 0.5 /cnt;
    i = 0;
    loop (cnt, stop_table[i]=sin(i*fct); i += 1;);
    stop_table[i] = 1;
    stop_table_cnt = cnt;
);
make_stop_table(slStlatency);


//==========================================================
//===== READERS Handling
//  Readers_set[RD_CNT]
// Prepare to start a reader by setting its volume to slowly increase
function do_rd_start(reader)
(
    reader[its_Rdr_AuxVol] = 0;
    reader[its_Rdr_IntPt] = 0;
    reader[its_Rdr_Intern] = its_RdrStat_starting;
);

function do_rd_stop(reader)
(
    reader[its_Rdr_AuxVol] = 1;
    reader[its_Rdr_IntPt] = stop_table_cnt;
    reader[its_Rdr_Intern] = its_RdrStat_stopping;
);



function clear_reader(rnum)
local(rcb)
(
    (((rcb = Readers_set[rnum]) > BASE_MEMORY) && (rcb[-2] === KW_read)) ? (
        memset(rcb, 0, its_Rdr_BlkSize);
    (rcb[its_Rdr_Status] === its_RdrStat_Reading) ? (
            rcb[its_Rdr_Tmp4] = 200;
            rcb[its_Rdr_Tmp5] = rcb[its_Rdr_Status];
            rcb[its_Rdr_Tmp6] = ts();
    );
        rcb[its_Rdr_Status] = its_RdrStat_Created;
        rcb[its_Rdr_WrSrc] = rcb[its_Rdr_LineNb] = -1;
        rcb[its_Rdr_Speed] = 1;
        rcb[its_Rdr_AbsInc] = 1;
        rcb[its_Rdr_OutVol] = 1;
        rcb[its_Rdr_BLType] = 1000;
        rcb[its_Rdr_Unuz1] = rcb[its_Rdr_Unuz2] = SECURE_BL;
        rcb[its_Rdr_Number] = rnum;

        // sprintf(#A002, "clear_reader(%d) [%f  %f]", rnum, rcb[its_Rdr_BLType], rcb[its_Rdr_LineNb]);
    );
);
function make_reader(rnum)
local(rcb)
(
    ((rcb = Readers_set[rnum]) === 0) ? (
        rcb = mSL_Dyn_Alloc(its_Rdr_BlkSize, KW_read, 0); // allocate memory
        Readers_set[rnum] = rcb;
        // sprintf(#A001, "make_reader(%d) => %d", rnum, rcb);
        clear_reader(rnum);
        0 ? (
            str_mess += 1; str_mess > 32 ? str_mess = 16;
            sprintf(str_mess, "make_reader %d - return %d", rnum, rcb);
        );
        // sprintf(#A003, "reader(%d)[%f  %f]", rnum, rcb[0], rcb[1]);
    );
    rcb;
);

// Delete a reader from Readers_set
function delete_reader(rnum)
local (rcb)
(
    ((rnum >= 0) && (rnum <= RD_CNT) && ((rcb = Readers_set[rnum]) > BASE_MEMORY) && (rcb[-2] === KW_read)) ? (
        mSL_Dyn_Free(rcb);
    );
    Readers_set[rnum] = 0;
);


//==========================================================
//===== WRITERS Handling
// Writers_set[WR_CNT]

function clear_writer(wnum)
(
    ((wnum >= 0) && (wnum <= WR_CNT) && ((wcb = Writers_set[wnum]) > BASE_MEMORY) && (wcb[-2] === KW_writ)) ? (
        memset(wcb, 0, its_Wrt_BlkSize);
        wcb[its_Wrt_LineNb] = -1;
        wcb[its_Wrt_BLType] = 2000;
        wcb[its_Wrt_InGain] = 1;
        wcb[its_Wrt_Status] = its_WrtStat_Created;
        wcb[its_Wrt_Unuz1] = wcb[its_Wrt_Unuz2] = SECURE_BL;
        wcb[its_Wrt_Number] = wnum;
    );
);
// Create a wrinter in slot "wnum" or return the existing writer
function make_writer(wnum)
local(wcb)
(
    ((wcb = Writers_set[wnum]) === 0) ? (
        wcb = mSL_Dyn_Alloc(its_Wrt_BlkSize, KW_writ, 0); // allocate memory
        Writers_set[wnum] = wcb;
        clear_writer(wnum);
    );
    wcb;
);

// Delete a writer from Writers_set
function delete_writer(wnum)
local (wcb)
(
    ((wnum >= 0) && (wnum <= WR_CNT) && ((wcb = Writers_set[wnum]) > BASE_MEMORY) && (wcb[-2] === KW_writ)) ? (
        mSL_Dyn_Free(wcb);
    );
    Writers_set[wnum] = 0;
);


//==========================================================
//===== EFFECTS Handling
// Effects_set[FX_CNT]
// Réinitialiser un effet
function clear_effect(enum)
local (fxcb)
(
    ((enum >= 0) && (enum <= FX_CNT) && ((fxcb = Effects_set[enum]) > BASE_MEMORY) && (fxcb[-2] === KW_effx)) ? (
        memset(fxcb, 0, its_Efx_BlkSize);
        fxcb[its_Efx_Status] = its_Efx_Unspecified;
        fxcb[its_Efx_Phase] = its_Efx_PhaseStd;
        fxcb[its_Efx_Numb] = enum;
        fxcb[its_Efx_CCnt] = 1;
        fxcb[its_Efx_Unuz1] = fxcb[its_Efx_Unuz2] = SECURE_BL;
    );
);
// Obtenir l'espace pour représenter un effet
function make_effect(enum)
local (fxcb)
(
    fxcb = mSL_Dyn_Alloc(its_Efx_BlkSize, KW_effx, mSL_StM_FlClear); // allocate memory
    Effects_set[enum] = fxcb;
    clear_effect(enum);
    fxcb;
);

// Delete an effect from Effects_set
function delete_effect(enum)
local (fxcb)
(
    ((enum >= 0) && (enum <= FX_CNT) && ((fxcb = Effects_set[enum]) > BASE_MEMORY) && (fxcb[-2] === KW_effx)) ? (
        mSL_Dyn_Free(fxcb);
    );
    Effects_set[enum] = 0;
);


//==========================================================
//===== LINES Handling
// Lines_Set[LN_CNT]

function check_line(lnum)
local (lcbl)
(
    ((lnum >= 0) && (lnum <= LN_CNT) && ((lcbl = Lines_Set[lnum]) > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        (lcbl[its_Lin_Check] !== BLOCK_CHECK) ? (
            lcbl[its_Lin_Check] = BLOCK_CHECK;
        );
    );
);

function clear_line(lnum)
local (i, lcbl)
(

    ((lnum >= 0) && (lnum <= LN_CNT) && ((lcbl = Lines_Set[lnum]) > BASE_MEMORY) && (lcbl[-2] === KW_lcbl)) ? (
        i = its_Lin_BF1ST; loop(lcbl[its_Lin_ChCnt],
            memset(lcbl[i], 0, lcbl[its_Lin_ActBSize]);
            l_cleared += lcbl[its_Lin_ActBSize];
            i += 1;
        );
    );
);

function make_line(lnum, type, size, channels)
local (lcbl, buff, bsz, i)
(
    // Create the buffer control bloc
    channels = max(1, min(128, 0|channels));
    lcbl = mSL_Dyn_Alloc(its_Lin_BlkSize, KW_lcbl, mSL_StM_FlClear);
    lcbl[its_Lin_Unuz1] = SECURE_BL; // "Interstys buffer"
