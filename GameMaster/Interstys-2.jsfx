<? include("GM-Libs/mSL_Scheduler.jsfx-inc"); ?>
// clip-lib
<? include("GM-Libs/mSL_clip_map.jsfx-inc"); ?>
// clip-lib-2
<? include("GM-Libs/mSL_clip_lib.jsfx-inc"); ?>
// ui-lib-3
<? include("GM-Libs/ui-lib-JJ-GUI.jsfx-inc"); ?>
// The mSL compiler
<? include("GM-Libs/mSL_Comp_lib.jsfx-inc"); ?>


GMI('_Int', 'erst', 'ys__'); // init memory



mSL_StM_Init(BASE_MEMORY); // init static memory at word 32
current_Memory_Mode = mSL_MMd_Static; // starting now, allow use of "make_array"
mSL_Str_Init(#strFirst, #strLast); // allocate strings for strings allocator
mSL_Str_TInit(#wstrFirst, #wstrLast); // allocate strings for temporary strings
mSL_Str_PInit(#xstrFirst, #xstrLast); // allocate strings for permanent strings
mSL_Str_MkStructs(); // Build string management structures

// see mm_highblocks
//====== GLOBALS ======
init_idents();
mSL_Init_Keywords();
mSL_Init_long_Keywords();
init_log_boxes();

// REAL START OF BLOCKS ANALYZED BY THE GARBAGE COLLECTOR
mm_lowblocks = make_array(2); // creates a gap of 2 words.
mm_lowblocks[0] = 'Low_'; mm_lowblocks[1] = '_Mem';

ui_lib_start = mSL_StM_BlockStart('uilb'); // ui lib block
ui_lib_end = ui_setup(ui_lib_start);
mSL_StM_BlockEnd(ui_lib_end);


ui_lib_JJ_GUI_init(2);

#MainScreen = "Logs";
#LiveScreen = "Live";

// Fonts management
font_count = 17;
font_names = make_array(font_count);
font_sizes = make_array(font_count);
font_modes = make_array(font_count);

<? include("GM-Libs/mSL_Colors.jsfx-inc"); ?>



mSL_GC_Protected = make_array(1123, mSL_KODE_protect); // Used by the compiler


xPeriod = 1; // choose a specific tempo for updating
xCount = 0; // update counter

uuuMslFn = 0;
uuuMslFname = 0;
uuuMslFent = 0;
uuuMslTSiz = 64;
uuuMslTabs = make_array(uuuMslTSiz); // an array of names of files to compile
uuuMslTPt =  0; // index in this table
uuuMslCSiz = 128;
uuuMslCTab = make_array(uuuMslCSiz); // an array of names of compileds files to execute
uuuMslCPt = 0; // index in this table



// Création des tableaux
// certains ont un élément de plus pour les copy/paste
PtrsInWA = RD_CNT+1 + WR_CNT+1 + FX_CNT+1 + LN_CNT + 1;
StaticWASize = PtrsInWA + SMPL_SIZE + 1;
StaticWA = make_array(StaticWASize); // ensemble des pointeurs mémoire et cellules
DuplWA = make_array(StaticWASize); // pour load/save des pointeurs mémoire
AltWAdec = DuplWA - StaticWA; // décalage pour accès aux objets similaires des deux ensembles
sinc_table = make_array(SINC_TABLE_SIZE+2); // // valeurs d'une fonction "sinc"
stop_table = make_array(STOP_TABLE_SIZE+2); // Fonction sinus variable
stop_table_cnt = 0;

// Load/Save Area
idx = 0;
SVASIZ = max(idx, 32);
savarea = make_array(SVASIZ); // Load/Save description area
lodarea = make_array(SVASIZ); // Load/Save description area
TMPSIZ = 4;
savtmp = make_array(TMPSIZ); // Work area for load/save of a memory block
savcode = '1tr6'; // a save code
WRKSIZ = 4096; // can convert up to 4 k
savwrk = make_array(WRKSIZ*2); // Work area for load/save conversion


// Créations des tables d'objets et de cellules
function updt_tables(wa)
(
    Lines_Set = wa;
    Readers_set = Lines_Set + LN_CNT+1;
    Writers_set = Readers_set + RD_CNT+1;
    Effects_set = Writers_set + WR_CNT+1;
    smpl_tab = Effects_set + FX_CNT +1;
    spl_tab = smpl_tab + SPL_P; // sous-table des samples
    alt_tab = smpl_tab + ALT_P; // sous-table des "alt"
);
updt_tables(StaticWA);




mm_limit_a = make_array(2);
mm_limit_a[0] = 'STRT'; mm_limit_a[1] = 'MEMR';


C_memrSize = 100 * 1024 * 1024; // size : X x 1MW
C_memrArea = make_array(C_memrSize); // THE DYNAMIC MEMORY !

mm_limit_b = make_array(2);
mm_limit_b[0] = 'END_'; mm_limit_b[1] = 'MEMR';


// Build the dynamic memory
mSL_errX = mSL_errC = 0;
mSL_current_memory = mSL_new_memory = 0; // make sure it is clear
AAAAC_5 = mSL_make_memory(C_memrArea, C_memrSize);

mm_lowmem = mSL_new_memory + mSL_new_memory[mSL_MM_LowAd];
mm_highmem = mSL_new_memory + mSL_new_memory[mSL_MM_HighAd];
// mm_sizmem = max(1, mm_highmem - mm_lowmem);
mm_show_ttf = mm_sizmem = mSL_new_memory[mSL_MM_MemSiz];

handling_load = 0;
perform_loading = 0;
mcp_indic = 0;
flg_clear_input = 0;
str_mess = "New message";
str_mess_prv = "Previous message";
ctime = 0;
pgmode = 0; // plug-in mode : merge
vol_inp = 1; // global gain - entrée
vol_out = 1; // global volume - sortie

// Return a unique time stamp
function ts()
local (pxtime, pftime)
(
    /*
    (pftime != (ctime%10000)) ? (
        pftime = (ctime%10000);
        pxtime = 0;
    ) : (
        pxtime += 1/1024;
    );
    pftime + pxtime;
    */
    pftime += 1;
);



/*
   These values, sometimes, need some resetting
*/
function some_reset()
(
    slupdt = 1; // 1 si autres sliders modifiés
    wrupdt = 1; // set to 1 if writer modified
    rdupdt = 1; // set to 1 if reader modified
    fxupdt = 1; // set to 1 if effect modified
    lnupdt = 1; // set to 1 if line modified

    slLnStatusPrv = -1;
    slLnlSizePrv = -1;
    slLnChCntPrv = -1;
    slLnActnPrv = -1;
    slWriterPrv = -1;
    slDrLinePrv = -1;
    slRd1stChPrv = -1;
    slWDlSizePrv = -1;
    slRdChUsedCntPrv = -1;
    slWrPosPrv = -1;
    slWrtActPrv = -1;
    slReaderPrv = -1;
    slRSpeedPrv = -1;
    slRStatusPrv = -1;
    slTypePrv = -1;
    slEPhasePrv = -1;
    slRdModePrv = -1;
    slRdSrcLNbPrv = -1;
    slRDlSizePrv = -1;
    slRPosPrv = -1;
    slRdOutVolPrv = -1;
    slEffectPrv = -1;
    slEndOutPrv = -1;
    slWDlLinePrv = -1;
    slRdWrefPrv = -1;
    slRdOffsPrv = -1;
    slFxActMxPrv = -1;
    slFxChCntPrv = -1;
    slInGainPrv = -1;
    slSmplPrv = -1;
    slWritCellPrv = -1;
    slWrStatusPrv = -1;
    slOutVolPrv = -1;
    slRdrOutPrv = -1;
    slWrOvrdbPrv = -1;
    slTimerPrv = -1;
    slRdLnChCntPrv = -1;
    slWrLnChCntPrv = -1;
    slWrInGainPrv = -1;
);

some_reset();

its_GlAct_StopAll = 1;
its_GlAct_PauseAll = 2;
its_GlAct_RestartAll = 3;
its_GlAct_RewdAll = 4;
its_GlAct_ClearAll = 5;
its_GlAct_DelAll = 7;

its_GlAct_None = 0;

//==========================================================
// LINE - KW_lcbl - Lines_Set[LN_CNT]
idx = 0;
//  0
its_Lin_Unuz1 = idx; idx += 1; // Sécurité : mot inutilisé
its_Lin_Ltype= idx; idx += 1; // Line type
its_Lin_Status = idx; idx += 1; //  Etat du buffer
its_Lin_Flgs = idx; idx += 1; //  Flags du buffer
its_Lin_Numb = idx; idx += 1; //  Buffer number (in line set)
its_Lin_ChCnt = idx; idx += 1; //  Nombre de canaux
its_Lin_SmplCnt = idx; idx += 1; //  Nombre de samples par canal
its_Lin_Start = idx; idx += 1; // 1er sample dans chaque buffer
its_Lin_Last = idx; idx += 1; // après le dernier sample
its_Lin_TStmp = idx; idx += 1; // creation time stamp
//  10
its_Lin_Tmp1 = idx; idx += 1; // work for load/save
its_Lin_Tmp2 = idx; idx += 1; // work for load/save
its_Lin_ActBSize = idx; idx += 1; // actual size needed for buffers
its_Lin_Check = idx; idx += 1; // quick check
its_Lin_BF1ST = idx; idx += 1; // Pointeur sur le premier buffer
// Il peut y avoir jusqu'à 128 buffers, 1 pour chaque canal
idx += 127;
its_Lin_Unuz2 = idx; idx += 1; // Sécurité : mot inutilisé
its_Lin_BlkSize = idx;
// Status
its_LinStat_Undef = 0;
its_LinStat_Ready = 1;
its_LinStat_Used = 2;
// Actions
its_LinAct_Clear = 1;
its_LinAct_Create = 2;
its_LinAct_Delete = 4;

/*
ts0 = time();
ts1 = time_precise();
ts2 = time_precise();
ts3 = time_precise();
ts4 = time_precise();
ts5 = time_precise();
*/

//==========================================================
// READER - KW_read - Readers_set[RD_CNT]
idx = 0;
//  0
its_Rdr_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Rdr_Status = idx; idx += 1; //  Etat affiché du reader
its_Rdr_Flgs = idx; idx += 1; //  Flags du reader
its_Rdr_Mode = idx; idx += 1; //  Mode du reader
its_Rdr_Number = idx; idx += 1; //  Numéro interne du reader
its_Rdr_BLType = idx; idx += 1; //  Type du bloc
its_Rdr_InAction = idx; idx += 1; //  internal action
its_Rdr_Intern = idx; idx += 1; //  Etat interne du reader
its_Rdr_LineNb = idx; idx += 1; //  Source du reader : numéro du buffer   -1/ [0 ... N-1]
its_Rdr_Lcbl = idx; idx += 1; // pointeur sur le bloc de controle du (des) buffer(s)
//  10
its_Rdr_ChNbr = idx; idx += 1; // nombre de canaux dans le lcbl
its_Rdr_SmplCnt = idx; idx += 1; // taille du buffer
its_Rdr_Start = idx; idx += 1; //  pointeur vers le premier mot du tampon
its_Rdr_Relpos = idx; idx += 1; //  Position [0 ... 100] de la tête de lecture
its_Rdr_Last = idx; idx += 1; //  pointeur vers le dernier mot du tampon
its_Rdr_RCell = idx; idx += 1; // Cellule de sortie du lecteur
its_Rdr_Speed = idx; idx += 1; //  Vitesse de lecture
its_Rdr_Abspos = idx; idx += 1; //  Position [its_Rdr_Start ... its_Rdr_Last - 1] de la tête de lecture
its_Rdr_AbsInc = idx; idx += 1; //  Incrément de la position
its_Rdr_Bf1stChan = idx; idx += 1; // Premier canal utilisé dans le buffer
//  20
its_Rdr_BfChanUsed = idx; idx += 1; // nombre de canaux utilisés dans le buffer
its_Rdr_WrSrc = idx; idx += 1; // Writer source number
its_Rdr_WrBPtr = idx; idx += 1; // Writer source address
its_Rdr_WOffset = idx; idx += 1; // Read Offset in seconds
its_Rdr_WOffsetSmp = idx; idx += 1; // Read Offset in samples
its_Rdr_IntPt = idx; idx += 1; // pointeur interne
its_Rdr_OutVoldB = idx; idx += 1; // output volume (db)
its_Rdr_OutVol = idx; idx += 1; // output volume
its_Rdr_AuxVol = idx; idx += 1; // auxiliary volume
its_Rdr_Check = idx; idx += 1; // quick check
//  30
its_Rdr_AmpModPtr = idx; idx += 1; // pt. sur modulation amplitude
its_Rdr_FrqModPtr = idx; idx += 1; // pt. sur modulation frequence
its_Rdr_Tmp1 = idx; idx += 1; // temp 1
its_Rdr_Tmp2 = idx; idx += 1; // temp 2
its_Rdr_Tmp3 = idx; idx += 1; // temp 3
its_Rdr_Tmp4 = idx; idx += 1; // temp 4
its_Rdr_Tmp5 = idx; idx += 1; // temp 5
its_Rdr_Tmp6 = idx; idx += 1; // temp 6
its_Rdr_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Rdr_BlkSize = idx;

its_RdrFlg_init = 0x0001; //  si lecteur initialisé
its_RdrFlg_actif = 0x0002; // si lecteur en cours de lecture
// Modes
its_RdrMode_Read = 0;
its_RdrMode_Folwr = 1;
// Etats
its_RdrStat_UnDef = 0;
its_RdrStat_Created = 1;
its_RdrStat_Ready = 2;
its_RdrStat_Paused = 3;
its_RdrStat_Reading = 4;
its_RdrStat_stopping = 12;
its_RdrStat_starting = 13;
// Actions
its_RdrAct_Copy = 1;
its_RdrAct_Paste = 2;
its_RdrAct_Clear = 3;
its_RdrAct_Rewind = 4;
its_RdrAct_Speed1 = 5;
its_RdrAct_Create = 6;
its_RdrAct_Activate = 7;
its_RdrAct_Show = 8;
its_RdrAct_Test = 9;
its_RdrAct_Delete = 10;


//==========================================================
// WRITER - KW_writ - Writers_set[WR_CNT]
idx = 0;
// 0
its_Wrt_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Wrt_BLType = idx; idx += 1; //  Type du bloc
its_Wrt_Number = idx; idx += 1; //  Numéro du writer
its_Wrt_Status = idx; idx += 1; //  Etat du writer
its_Wrt_InAction = idx; idx += 1; //  internal action
its_Wrt_Flgs = idx; idx += 1; //  Flags du writer
its_Wrt_Mode = idx; idx += 1; //  Mode de fonctionnement du writer
its_Wrt_Intern = idx; idx += 1; //  Etat interne du writer
its_Wrt_LineNb = idx; idx += 1; // numéro du buffer -1/ [0 ... N-1]
its_Wrt_Lcbl = idx; idx += 1; // pointeur sur le bloc de controle du (des) buffer(s)
// 10
its_Wrt_ChNbr = idx; idx += 1; // nombre de canaux dans le lcbl
its_Wrt_SmplCnt = idx; idx += 1; //  Taille de la zone utile
its_Wrt_Start = idx; idx += 1; //  pointeur vers le premier mot du tampon
its_Wrt_Relpos = idx; idx += 1; //  Position [0 ... 100] de la tête d'écriture
its_Wrt_Last = idx; idx += 1; //  pointeur vers le dernier mot du tampon
its_Wrt_Cell = idx; idx += 1; // numéro du (premier) mot écrit par le writer
its_Wrt_Abspos = idx; idx += 1; //  Position [0 ... size - 1] de la tête d'écriture
its_Wrt_Buff_1 = idx; idx += 1; // pointeur sur le 1er buffer
its_Wrt_Ovrdb = idx; idx += 1; // recycling
its_Wrt_Check = idx; idx += 1; // quick check
// 20
its_Wrt_InGaindB = idx; idx += 1; // input gain (dB)
its_Wrt_InGain = idx; idx += 1; // input gain (dB)
its_Wrt_Tmp1 = idx; idx += 1; // temp1
its_Wrt_Tmp2 = idx; idx += 1; // temp2
its_Wrt_Tmp3 = idx; idx += 1; // temp 3
its_Wrt_Tmp4 = idx; idx += 1; // temp 4
its_Wrt_Tmp5 = idx; idx += 1; // temp 5
its_Wrt_Tmp6 = idx; idx += 1; // temp 6
its_Wrt_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Wrt_BlkSize = idx;

its_WrtFlg_init = 0x0001; //  si writer initialisé
// Etats
its_WrtStat_UnDef = 0;
its_WrtStat_Created = 1;
its_WrtStat_Ready = 2;
its_WrtStat_Paused = 3;
its_WrtStat_Writing = 4;
// Actions
its_WrtAct_Copy = 1;
its_WrtAct_Paste = 2;
its_WrtAct_Clear = 3;
its_WrtAct_Rewind = 4;
its_WrtAct_Reset = 5;
its_WrtAct_Create = 6;
its_WrtAct_Activate = 7;
its_WrtAct_Show = 8;
its_WrtAct_Delete = 10;



//==========================================================
// EFFECT - KW_effx - Effects_set[FX_CNT]
idx = 0;
//   0
its_Efx_Unuz1 = idx; idx += 1; //  Securité : mot inutilisé
its_Efx_Status = idx; idx += 1; //  Etat de l'effet
its_Efx_Flgs = idx; idx += 1; //  Flags de l'effet
its_Efx_Type = idx; idx += 1; //  Type de l'effet
its_Efx_Numb = idx; idx += 1; //  Numéro de l'effet
its_Efx_Phase = idx; idx += 1; //  Phase de l'effet
its_Efx_CCnt = idx; idx += 1; //  Channel count
its_Efx_Out = idx; idx += 1; //  Sortie de l'effet
its_Efx_Src1 = idx; idx += 1; //  Source n°1
its_Efx_VoldB1 = idx; idx += 1; //  Volume n°1 (dB)
//   10
its_Efx_Vol1 = idx; idx += 1; //  Volume n°1
its_Efx_Dst1 = idx; idx += 1; //  Destination n°1
its_Efx_Src2 = idx; idx += 1; //  Source n°2
