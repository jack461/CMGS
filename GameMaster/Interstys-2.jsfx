            );
            // reader lié à un writer ?
            (nrcbl[its_Rdr_WrBPtr] > BASE_MEMORY) ? (
                // Update with the new address
                nrcbl[its_Rdr_WrBPtr] = Writers_set[nrcbl[its_Rdr_WrSrc]+AltWAdec];
            );
        );
        ln += 1;
    );
    // On peut libérer les anciens lecteurs
