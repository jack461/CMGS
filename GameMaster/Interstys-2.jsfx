its_Efx_Vol2 = idx; idx += 1; //  Volume n°2
its_Efx_Dst2 = idx; idx += 1; //  Destination n°2
its_Efx_Src3 = idx; idx += 1; //  Source n°3
its_Efx_VoldB3 = idx; idx += 1; //  Volume n°3 (dB)
its_Efx_Vol3 = idx; idx += 1; //  Volume n°3
its_Efx_Dst3 = idx; idx += 1; //  Destination n°3
//   20
its_Efx_Src4 = idx; idx += 1; //  Source n°4
its_Efx_VoldB4 = idx; idx += 1; //  Volume n°4 (dB)
its_Efx_Vol4 = idx; idx += 1; //  Volume n°4
its_Efx_Dst4 = idx; idx += 1; //  Destination n°4
its_Efx_Src5 = idx; idx += 1; //  Source n°5
its_Efx_VoldB5 = idx; idx += 1; //  Volume n°5 (dB)
its_Efx_Vol5 = idx; idx += 1; //  Volume n°5
its_Efx_Dst5 = idx; idx += 1; //  Destination n°5
its_Efx_Src6 = idx; idx += 1; //  Source n°6
its_Efx_VoldB6 = idx; idx += 1; //  Volume n°6 (dB)
//   30
its_Efx_Vol6 = idx; idx += 1; //  Volume n°6
its_Efx_Dst6 = idx; idx += 1; //  Destination n°6
its_Efx_Src7 = idx; idx += 1; //  Source n°7
its_Efx_VoldB7 = idx; idx += 1; //  Volume n°7 (dB)
its_Efx_Vol7 = idx; idx += 1; //  Volume n°7
its_Efx_Dst7 = idx; idx += 1; //  Destination n°7
its_Efx_Src8 = idx; idx += 1; //  Source n°8
its_Efx_VoldB8 = idx; idx += 1; //  Volume n°8 (dB)
its_Efx_Vol8 = idx; idx += 1; //  Volume n°8
its_Efx_Dst8 = idx; idx += 1; //  Destination n°8
//   40
idx += 1;
its_Efx_Check = idx; idx += 1; // quick check
its_Efx_Unuz2 = idx; idx += 1; //  Securité : mot inutilisé
its_Efx_BlkSize = idx; // Taille du bloc

// Some constants
its_EfxDist = its_Efx_Src2 - its_Efx_Src1;
// Effects types
its_Efx_Undefined = 0;
its_Efx_Unspecified = 1;
its_Efx_TyNone = 1;
its_Efx_TyMixer = 2;
its_Efx_TyEQMixer = 3;
its_Efx_TyMover = 4;
its_Efx_TyAction = 5;
its_Efx_TyScript = 6;

its_Efx_PhaseStd = 0;
its_Efx_PhasePre = 1;
its_Efx_PhasePost = 2;

its_EfxAct_Copy = 1;
its_EfxAct_Paste = 2;
its_EfxAct_Clear = 3;
its_EfxAct_EQMix = 4;
its_EfxAct_Reset = 5;
its_EfxAct_Create = 6;
its_EfxAct_Show = 7;
its_EfxAct_Delete = 9;

function dbg_show_1(mem,msg)
local (i)
(
    mem_1 = mem;
    mem_1A = msg;
    mem_1B = ts();
    <? i=0; loop(48, printf("mem_1_%03d = mem[%d];\n", i, i); i += 1;); ?>
);


