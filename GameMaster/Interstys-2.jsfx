slider<? printf("%d", (slnum += 1)); ?>:slRdSrcLNb=0<0,<? printf("%d", LN_CNT); ?>,1{None<? i=1; loop(LN_CNT, printf(",Line %d",i); i+= 1;); ?>}>-Source line
slider<? printf("%d", (slnum += 1)); ?>:slRDlSize=0<1,1200,0.001>-Line size (s)
slider<? printf("%d", (slnum += 1)); ?>:slRdLnChCnt=0<0,<? printf("%d", CH_NB-1); ?>,1{1<? i=2; loop(CH_NB-1, printf(",%d",i); i+= 1;); ?>}>-Line channels count
slider<? printf("%d", (slnum += 1)); ?>:slRd1stCh=0<0,<? printf("%d", CH_NB-1); ?>,1{Ch. 1<? i=2; loop(CH_NB-1, printf(",Ch. %d",i); i+= 1;); ?>}>-First channel used
slider<? printf("%d", (slnum += 1)); ?>:slRdChUsedCnt=0<0,<? printf("%d", CH_NB-1); ?>,1{1<? i=2; loop(CH_NB-1, printf(",%d",i); i+= 1;); ?>}>-Number of channels used
