slider<? printf("%d", (slnum += 1)); ?>:slRdWref=0<0,<? printf("%d", WR_CNT); ?>,1{None<? i=1; loop(WR_CNT, printf(",Writer %d",i); i+= 1;); ?>}>-Writer reference
slider<? printf("%d", (slnum += 1)); ?>:slRdOffs=0<0,600,0.00001:sqr=5>-Offset (s)
