<? include("GM-Libs/mSL_string_list_2000X.jsfx-inc"); ?>
// The Static memory management
<? include("GM-Libs/mSL_StM_Memory.jsfx-inc"); ?>
// The strings management
<? include("GM-Libs/mSL_Strings.jsfx-inc"); ?>
// Utilities - 1
<? include("GM-Libs/mSL_Utilities.jsfx-inc"); ?>
// Dynamic memory management
<? include("GM-Libs/mSL_Dyn_Memory.jsfx-inc"); ?>
// Utilities - 2
<? include("GM-Libs/mSL_Utilities2.jsfx-inc"); ?>
// The original ui-lib
<? include("GM-Libs/ui-lib.jsfx-inc"); ?>
// The adaptation of ui-lib
<? include("GM-Libs/mSL_ui_LibJJ.jsfx-inc"); ?>
// The menus manager
