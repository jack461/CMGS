  (g__ccc>0) ? (
    // Handle the various short cuts
    (g__ccc==='n' || g__ccc===0x72676874) ? ( // "n" or right arrow
      cSl = (cSl+1)%TCM; (cSl >= pnum_ch) ? (cSl = 0;);
      LoadValues(cSl);
