      gfx_drawstr("last channel");
    ) :
    (g__ccc==='z') ? ( // mute all but
      MuteAllBut(cSl); xCnt=xDelay;
    ) :
    (g__ccc==='u') ? ( // unmute all
      UnCheckAll(ChStatus); xCnt=xDelay;
    ) :
    (g__ccc==='t') ? ( // toggle pass/filtered
      g__wx=VArray[ChTypes+PChan];
      (g__wx<ChTypeLFe1) ? (
        VArray[ChTypes+PChan]=g__wx=(g__wx!=0) ? 0 : 1;
        slChTyp=g__wx; isMod(cSl);
      );
    ) :
    (g__ccc==='c') ? ( // toggle pass/check
      g__wx=VArray[ChTypes+PChan];
