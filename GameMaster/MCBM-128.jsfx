      ) :
      (g__wx===0x02 || g__wx===0x21) ? ( // right [or ctrl left] : show channel model
        g__fx=VArray[ChSettings+(chan<<4)];
        (g__fx>=0) ? (
          LoadValues(g__fx+TCC);
          pSl = cSl;
          PChan = cSl << 4; // switch to selected channel
        ); g__wx=0;
      ) :
      (g__wx===0x0A) ? ( // shift right clic : set "target" to the corresponding model
        g__fx=VArray[ChSettings+(chan<<4)];
        (g__fx>=0) ? (
          slTargetCh = CPS = g__fx; sliderchange(slTargetCh);
        ); g__wx=0;
      ) :
      (g__wx===0x05) ? (
        g__fx=VArray[ChSelect+(chan<<4)];
        VArray[ChSelect+(chan<<4)] = (g__fx & 1) ? 0 : 1;
      ) :
      (g__wx===0x1A || g__wx===0x39) ? ( // right [or ctrl left], alt+shift : set channel to selected model
        pastPr(CPS+TCC,chan); g__wx=0;
      );
      (g__wx!=0) ? ( // typically left, no modifiers, but any unrecognised : select channel
        LoadValues(chan);
        pSl = cSl;
        PChan = cSl << 4; // switch to selected channel
      );
    );
  );


  (GAX != 0) ? (
    (Kgfx_w != gfx_w) ? (
      Kgfx_w=gfx_w;
      // How many channels can we display on a single line ?
      ChPL = max(4, min(MCPL, 4 * (0|((Kgfx_w + 24)/(dlX*5)))));
    );
    DrChRct_w = 4 + dlX*(5 * (ChPL/4) - 1);
    DrChRct_h = (0|((pnum_ch + ChPL - 1)/ChPL)) * dlY + 4;
    DrChRct_ndx=DrChRct_x+DrChRct_w;
    DrChRct_ndy=DrChRct_y+DrChRct_h;
    Kgfx_h=gfx_h; // keep the new size
    buildChDesc(); gfx_x = 240; gfx_drawstr("Rebuild");
  );

  // Display the "show channels" rectangle
  xBlack(); // Draw in black
  gfx_roundrect(DrChRct_x,DrChRct_y,DrChRct_w,DrChRct_h,5);
  gfx_y = pos_y = DrChRct_y+8;
  g__ix = 0; loop(MCPL, xChPos[g__ix] = DrChRct_x+8; yChPos[g__ix]=gfx_y; g__ix += 1; );
  g__ix=0; g__iy=0; g__iw=0; ChLY = 0;
  while(g__iw < pnum_ch) (
    // ix is the channel number
    // as we display, we keep various x and y positions in xChPos and yChPos
    g__wx = DrChRct_x+8; yChPos[g__iy]=pos_y; ChLY += 1;
    loop(ChPL/4, (
        loop(4, (
            xChPos[g__ix%ChPL] = gfx_x = g__wx; gfx_y = pos_y;
            (g__iw < pnum_ch) ? (
              g__ic=g__ix<<4;
              xDark(); (VArray[ChStatus+g__ic]==1) ? (xRed(););
              gfx_drawnumber(g__ix+1,0);
              xDark(); gfx_drawstr(((ShCh[g__ix] & 0x100) ? "#" : ":")); gfx_x=max(g__wx+24, gfx_x+2); // 3 digits : after the ":"
              (VArray[ChTypes+g__ic]>=ChTypeLFE1) ? ( //
                  xBlue();
              );
              (VArray[ChTypes+g__ic]===ChTypeFilt) ? (
                  xGreen();
              );
              (VArray[ChTypes+g__ic]===ChTypeCheck) ? (
                  xOrange();
              );
              gfx_drawchar(ShCh[g__ix] & 0xFF);
              (VArray[ChSelect+g__ic] & 1) ? (
                // Display a rectangle around the current channel
                xOrange();
                gfx_roundrect(g__wx-3,pos_y-3,dlX-5,dlY-6,3);
              );
            );
            g__ix+=1; g__iw+= 1; g__wx=g__wx+dlX;
        ));
        g__wx+=dlX;
    ));
    g__iy+=1;
    pos_y+=dlY;
  );
  // Display a rectangle around the current channel
  (cSl<TCC) ? (
    g__tix = g__ix = xChPos[cSl%ChPL]; g__tiy = g__iy = yChPos[0|(cSl/ChPL)];
    xDark(); gfx_roundrect(g__ix-4,g__iy-4,dlX-3,dlY-4,3);
  );
  xBlack();
  // Show the currently selected channel model
  gfx_x = 30; gfx_y = DrChRct_ndy+30; gfx_drawstr("set: "); gfx_drawchar(CPS+'A');
  // LFE channels beyond the channels of the track : one red line for each
  gfx_y = DrChRct_ndy+50; xRed();
  g__ix = 1; loop(4,
    g__wx = ((g__ix == 1) ? LFE1Ch : (g__ix == 2) ? LFE2Ch : (g__ix == 3) ? LFE3Ch : LFE4Ch);
    (g__wx > pnum_ch) ? (
      gfx_x = 30;
      gfx_drawstr("LFE "); gfx_drawnumber(g__ix, 0); gfx_drawstr(" is channel "); gfx_drawnumber(g__wx, 0);
      gfx_drawstr(", beyond the "); gfx_drawnumber(pnum_ch, 0); gfx_drawstr(" track channels : not output");
      gfx_y += 16;
    );
    g__ix += 1;
  );
  xBlack();
  (xDbg) ? (
    gfx_x = 120; gfx_y = DrChRct_ndy+30; gfx_drawstr("Mouse "); // on the "set:" line
    gfx_drawnumber(m_x,0); gfx_drawstr(" ");gfx_drawnumber(m_y,0); gfx_drawstr(" "); gfx_drawnumber(MSC,0);
  );
  GAX=(GAX>0) ? GAX-1 : 0;
);

