//****************************************************************************************
//****************************************************************************************
//****************************************************************************************


@serialize


// read or write in file the channels and models values, after a version mark
// (an older preset, without it or with another size, is ignored : default values are kept)
serVers = 'MCB3'; // MCBM-128 (MCBM-64 : 'MCB2')
file_var(0, serVers);
(serVers === 'MCB3') ? file_mem(0,SerialAddr,DataSize);
// we will always recomp the filters...
// (srz_i, not i : @block and @sample use i, and they may run concurrently with @serialize)
z__i=0; loop(TCC, (VArray[ChReComp+z__i]=1; z__i+=16;););
DoRecomp=1;
xCnt=xDelay;




//****************************************************************************************
//****************************************************************************************
//****************************************************************************************


@block


// Channel count modified ?
(min(TCC, num_ch) != pnum_ch) ? (
  pnum_ch = min(TCC, num_ch);
  GAX |= 2;
  DoRecomp=1;
);

(DoRecomp!=0) ? (
    // Here, we need to recreate the filters structure
    DoRecompAll(); // we systematically recompile all filters
    b__i=0; loop(TCC, (VArray[ChReComp+b__i]=0;  b__i+=16;););
    slEdit=0; sliderchange(slEdit);
    xCnt=xDelay;
);




//****************************************************************************************
//****************************************************************************************
//****************************************************************************************


@sample

LFE1Out=LFE2Out=LFE3Out=LFE4Out=0;  // clear all LFE outputs

s__i=0; loop(min(TCC, 8 * ceil(pnum_ch / 8)), (smplOut[s__i]=0;  s__i+=1;)); // clear all outputs written (groups of 8)

// Perform operations
<? g=0; loop(TCC/8,
    g ? printf("(pnum_ch > %d) ? (\n", g*8);
    printf("  "); i=0; loop(8, printf("xF%03d.exec(spl(%d)); ", g*8+i, g*8+i); i+=1;); printf("\n");
    g ? printf(");\n");
    g+=1;
); ?>

// Add LFEs to Output
(LFE1Ch>0) ? (smplOut[LFE1Ch-1]+=LFE1Out*LFE1Vol;);
(LFE2Ch>0) ? (smplOut[LFE2Ch-1]+=LFE2Out*LFE2Vol;);
(LFE3Ch>0) ? (smplOut[LFE3Ch-1]+=LFE3Out*LFE3Vol;);
(LFE4Ch>0) ? (smplOut[LFE4Ch-1]+=LFE4Out*LFE4Vol;);

GenVolCur += (GenVol - GenVolCur) * 0.002; // smoothed general volume (about 10 ms)
s__i=0; loop(pnum_ch, (spl(s__i)=smplOut[s__i]*GenVolCur; s__i+=1;)); // return values, with the general volume



//****************************************************************************************
//****************************************************************************************
//****************************************************************************************


@gfx 0 0

function xBlack() (gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 1.0;);
function xDark() (gfx_r = 0.40; gfx_g = 0.35; gfx_b = 0.35;);
function xBlue() (gfx_r = 0.1; gfx_g = 0.1; gfx_b = 1.0;);
function xGreen() (gfx_r = 0.0; gfx_g = 0.9; gfx_b = 0.0;);
function xRed() (gfx_r = 0.8; gfx_g = 0.0; gfx_b = 0.0;);
function xCyan() (gfx_r = 0.1; gfx_g = 0.8; gfx_b = 0.8;);
function xOrange() (gfx_r = 0.9; gfx_g = 0.6; gfx_b = 0.1;);

