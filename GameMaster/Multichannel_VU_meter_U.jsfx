Copyright (C) 2009, Jeff BEDAGUE aka Jeffos
All rights reserved.
License: GPL - http://www.gnu.org/licenses/gpl.html

S&M - Multichannel VU meter v0.8b
THIS IS A BETA VERSION

This is a multi-channel vu meter (up to 128 channels). It simply allows checking peaks, volumes and if there's some signal on which channel.
It automatically adapts itself to the room you give it in the GUI (streching) and to the related track channels.
- Left click anywhere: clear all the peaks (saturation indicators and max dB values)
- Right click: menu
  * GUI mode: horizontal / vertical meters, fixed size / auto. fit to size
  * Saturation threshold: -20 to +20 dB (0 dB by default)
  * Meter color: green, orange, blue, yellow, cyan, violet (to tell several meters apart)
  * Saturation auto clear: permanent, or cleared 1, 3 or 5 minutes after the last over
- Top slider & text field: with "auto. fit to size" modes, channel numbers can't always be displayed, use this to highlight the channel you
  want to monitor..

Important note about the code: 
No, sir, I don't code like a pig! I vonlutary didn't use arrays but 64 vars instead (!) not to eat all the CPU with many channels!
(2026: 128 channels. Unrolled variant of Multichannel_VU_meter.jsfx, to compare the CPU load: the named variables
bufCh0..bufCh127 are generated by the preprocessor; the loop version reads spl(i) into the array bufCh.)

*/

desc:Multichannel_VU_meter (unrolled)
slider3:45<25,1000,1>-sample time (ms)
slider4:0<0,128,1>Highlight channel (0 = disabled)
slider5:0<0,3,1{Horizontal meters - fixed height,Horizontal meters - fit to height,Vertical meters - fixed width,Vertical meters - fit to width}>-GUI mode
slider6:4<0,8,1{-20 dB,-6 dB,-2 dB,-1 dB,0 dB,+1 dB,+2 dB,+6 dB,+20 dB}>-Saturation threshold
slider7:0<0,5,1{Green,Orange,Blue,Yellow,Cyan,Violet}>-Meter color
slider8:0<0,3,1{Permanent,1 minute,3 minutes,5 minutes}>-Saturation auto clear

options:no_meter

@init
ext_noinit=1.0;
MAX_CH=128;
sc=6/log(2);
dbMin = 60; //JFB 305.885547;
dbRulerStep = 6;

bufCh=0;
bufPeak=MAX_CH; // i.e. after bufCh
bufValue=MAX_CH*2;
coordinatelist=MAX_CH*3;   //JFB
bufOverT=MAX_CH*4; // time (cpt) of the last over of each channel, -1 = none
thrTab=MAX_CH*5;   // saturation thresholds (dB) of slider6
holdTab=thrTab+16; // auto clear delays (s) of slider8

memset(bufCh, 0, MAX_CH); // peak of each channel during the sample time (copied from bufCh0..bufCh127)
memset(bufPeak, dbMin*-1, MAX_CH);
memset(bufValue, dbMin*-1, MAX_CH);
memset(bufOverT, -1, MAX_CH);
thrTab[0]=-20; thrTab[1]=-6; thrTab[2]=-2; thrTab[3]=-1; thrTab[4]=0;
thrTab[5]=1; thrTab[6]=2; thrTab[7]=6; thrTab[8]=20;
holdTab[0]=0; holdTab[1]=60; holdTab[2]=180; holdTab[3]=300;
satThr=thrTab[slider6|0];

// clear all the peaks (saturation indicators and max dB values)
function clear_peaks()
(
  memset(bufPeak, dbMin*-1, MAX_CH);
  memset(bufOverT, -1, MAX_CH);
);

// meter color of slider7, scaled by f (0.55 = bar, 1 = highlighted bar, 0.9 = text); gfx_a unchanged
function vu_rgb(f)
  local(c)
(
  c = slider7|0;
  c == 1 ? (gfx_r=1; gfx_g=0.65; gfx_b=0) :      // orange (yellowish, far from the red of the overs)
  c == 2 ? (gfx_r=0.3; gfx_g=0.55; gfx_b=1) :    // blue
  c == 3 ? (gfx_r=1; gfx_g=0.95; gfx_b=0.1) :    // yellow
  c == 4 ? (gfx_r=0; gfx_g=0.9; gfx_b=0.95) :    // cyan
  c == 5 ? (gfx_r=0.7; gfx_g=0.35; gfx_b=1) :    // violet
           (gfx_r=0.05; gfx_g=0.9; gfx_b=0.15);  // green
  gfx_r *= f; gfx_g *= f; gfx_b *= f;
);

// menu item: '<' ends the submenu, '!' checks the item
function menu_item(label, checked, last)
(
  strcat(#menu, last ? "<" : "");
  strcat(#menu, checked ? "!" : "");
  strcat(#menu, label);
  strcat(#menu, "|");
);


uiTop=1;
uiLeft=1;
uiCharWidth=10;
uiRightMargin=45;
uiWidthRatio=75;

@slider
sampletime=slider3*srate/1000;  //JFB hidden!!
slider4=min(MAX_CH, min(num_ch, slider4))|0;

@block
bscnt>sampletime ?
(
    // the peaks of the named variables copied in the array bufCh, then cleared (by groups of 8 channels)
<?
  g = 0;
  loop(16,
    g > 0 ? printf("    num_ch > %d ?\n    (\n", g*8);
    k = 0;
    loop(8, n = g*8 + k; printf("      bufCh[%d] = bufCh%d; bufCh%d = 0;\n", n, n, n); k += 1;);
    g += 1;
  );
  loop(15, printf("    );\n"););
?>
    satThr = thrTab[slider6|0];
    b__hold = holdTab[slider8|0] * srate;
    b__j=0;
    loop
    (
      min(num_ch, MAX_CH),
      bufValue[b__j] = log(bufCh[b__j])*sc;
      bufPeak[b__j] = max(bufPeak[b__j], bufValue[b__j]);
      // saturation indicator: time of the last over, cleared after the delay of slider8
      bufValue[b__j] == satThr || bufValue[b__j] > satThr ? bufOverT[b__j] = cpt
      : bufPeak[b__j] == satThr || bufPeak[b__j] > satThr ?
      (
        bufOverT[b__j] < 0 ? bufOverT[b__j] = cpt // indicator without date (threshold lowered)
        : b__hold > 0 && cpt - bufOverT[b__j] > b__hold ? (bufPeak[b__j] = dbMin*-1; bufOverT[b__j] = -1;);
      );
      b__j+=1;
    );
    bscnt=0;
);
bscnt += samplesblock;
cpt += samplesblock; // time of the overs

@sample
// unrolled: named variables bufCh0..bufCh127, by groups of 8 channels
<?
  g = 0;
  loop(16,
    g > 0 ? printf("num_ch > %d ?\n(\n", g*8);
    k = 0;
    loop(8, n = g*8 + k; printf("  bufCh%d = max(bufCh%d, abs(spl%d));\n", n, n, n); k += 1;);
    g += 1;
  );
  loop(15, printf(");\n"););
?>

@gfx

uiTop = vuHeight = (gfx_h/(num_ch+1)) | 0; // +1 for the lines
/*JFB uiLeft = */vuWidth = (gfx_w/(num_ch+1));
dBstep = floor(((6*gfx_w)/dbMin) + 0.5);//JFB ??

////////////////////
// horizontal meters
////////////////////
slider5 == 0 || slider5 == 1 ?
(
  uiTop = gfx_texth + 4;
  slider5 ? (vuHeight = (((gfx_h - uiTop)/(num_ch/*JFB +1 */)) | 0);) : (/*JFB uiTop = */vuHeight = gfx_texth+1);
  
    // default master peak
      gfx_r=1;gfx_g=1;gfx_b=1;gfx_a=0.8;
      gfx_x=gfx_w;
      gfx_y=1; //JFB!!!
      gfx_rectto(gfx_w - floor(gfx_w/uiWidthRatio + 0.5) , /*JFB gfx_y + */uiTop - 1);
      gfx_r=0;gfx_g=0;gfx_b=0;
      gfx_x=gfx_w-1;
      gfx_y=2; //JFB!!!
      gfx_rectto(gfx_w - floor(gfx_w/uiWidthRatio + 0.5) +1, /*JFB gfx_y + */uiTop - 2);

  g__i=0;
  loop
  (
    num_ch,
  
    // Full rectangle (color of slider7)
    vu_rgb((g__i == (slider4 - 1)) ? 1 : 0.55); gfx_a=0.8;
    gfx_x=0;gfx_y = uiTop + vuHeight*g__i;
    gfx_rectto(gfx_w,gfx_y + vuHeight-1);

    // Black rectangle according to peak
    gfx_r=0;gfx_g=0.0;gfx_b=0.0;gfx_a=1;
    gfx_x=gfx_w+1;
    gfx_y=uiTop + vuHeight*g__i;
    gfx_rectto(gfx_w - floor((-max(-dbMin, min(0, bufValue[g__i]))*gfx_w)/dbMin + 0.5) , gfx_y + vuHeight);
  
    // Channel number
    vuHeight >= gfx_texth ?
    (
      gfx_x=5; //JFB!!!
      gfx_y=uiTop + vuHeight* g__i + floor(abs(gfx_texth-vuHeight)/2 + 0.5);
      
      bufPeak[g__i] > (dbMin*-1) ? gfx_a = 0.8 : gfx_a = 0.3;
      (g__i == (slider4 - 1)) ?
      (
          gfx_a = 0.8; gfx_r=1;gfx_g=1;gfx_b=1;
      )
      :
      (
//          bufPeak[i] == (dbMin*-1) || bufPeak[i] > (dbMin*-1) ? (gfx_r=0.1;gfx_g=0.8;gfx_b=0.2;) : (gfx_r=0.5;gfx_g=0.5;gfx_b=0.5;);
//ok            bufValue[i] > (dbMin*-1) ? (gfx_r=0.1;gfx_g=0.8;gfx_b=0.2;) : (gfx_r=0.5;gfx_g=0.5;gfx_b=0.5;);
          vu_rgb(0.9);
      );
      gfx_drawnumber(g__i+1,0);
    );
  
    // max dB
    vuHeight >= gfx_texth ?
    (
      gfx_x = gfx_w - uiRightMargin;
      gfx_y=uiTop + vuHeight*g__i + floor(abs(gfx_texth-vuHeight)/2 + 0.5);
      gfx_r=1;gfx_g=1;gfx_b=1;
      bufPeak[g__i] > (dbMin*-1) ? gfx_a = 0.8 : gfx_a = 0.3;
      gfx_drawnumber(bufPeak[g__i],1);
    );
  
    // peaks
    bufPeak[g__i] == satThr || bufPeak[g__i] > satThr ? //JFB ">=" KO when "-0.0" !!
    (
      gfx_x=gfx_w;gfx_y=uiTop + vuHeight*g__i;
      gfx_r=1;gfx_g=0.0;gfx_b=0.0;gfx_a=1;
      gfx_rectto(gfx_w - floor(gfx_w/uiWidthRatio + 0.5) , gfx_y + vuHeight - 1);

      // master peak
      gfx_x=gfx_w-1;
      gfx_y=2; //JFB!!!
//JFB      gfx_y = floor(abs(gfx_texth-uiTop)/2 + 0.5);
      gfx_rectto(gfx_w - floor(gfx_w/uiWidthRatio + 0.5) +1, /*JFB gfx_y + */uiTop - 2);
    );

    // "dB"
    vuHeight > gfx_texth && dBstep > (uiCharWidth*4 + uiRightMargin) ? // e.g. 4 'cause "-6" & "dB"
    (
      gfx_x = gfx_w - uiRightMargin;
//JFB      gfx_y = floor(abs(gfx_texth-vuHeight)/2 + 0.5);
      gfx_y = floor(abs(gfx_texth-uiTop)/2 + 0.5);
      gfx_r=.5;gfx_g=.5;gfx_b=.5;gfx_a=0.8;
      gfx_drawchar($'d');
      gfx_drawchar($'B');
    );

    g__i+=1;
  );

  // dB lines
  gfx_r=.5;gfx_g=.5;gfx_b=.5;
  g__i=dbRulerStep;
  while
  (
    g__tmp = gfx_w - floor(((g__i*gfx_w)/dbMin) + 0.5);

    gfx_a=0.2;
    gfx_x = g__tmp; gfx_y=uiTop;
    gfx_lineto(gfx_x,gfx_h, 0.4);

    gfx_a=0.8;
/*JFB
    vuHeight > gfx_texth && dBstep > 10 * 3 ? // e.g. 3 'cause "-60" JFB!!! charWidth !
    (
*/
      gfx_x = g__tmp + 1;
      gfx_y = floor(abs(gfx_texth-uiTop)/2 + 0.5);
      gfx_drawnumber(g__i*-1,0);
//    );
    g__i+=dbRulerStep;
    g__i <= dbMin;
  );

  // top H line
/*JFB
  gfx_x = 0; gfx_y=vuHeight;
  gfx_lineto(gfx_w,vuHeight, 0.4);
*/
)
:

////////////////////
// vertical meters
////////////////////
(
  uiLeft = uiCharWidth * 3; // e.g. -60
  slider5 == 3 ? /*JFB uiLeft = */vuWidth = (((gfx_w - uiLeft)/num_ch) | 0) : (/*JFB uiLeft = */vuWidth = uiCharWidth);

  g__i=0;
  loop
  (
    num_ch,
  
    // Full rectangle (color of slider7)
    vu_rgb((g__i == (slider4 - 1)) ? 1 : 0.55); gfx_a=0.8;
    gfx_x=uiLeft + vuWidth*g__i; gfx_y=0;
    gfx_rectto(gfx_x+vuWidth-1,gfx_h);
  
    // Black rectangle according to peak
    gfx_r=0;gfx_g=0.0;gfx_b=0.0;gfx_a=1;
    gfx_x=uiLeft + vuWidth*g__i; 
    gfx_y=0;
    gfx_rectto(gfx_x + vuWidth, floor(((-max(-dbMin, min(0, bufValue[g__i]))*(gfx_h+1))/dbMin)+0.5) );
  
    // Channel number
    vuWidth >= uiCharWidth ?
    (
      gfx_x=uiLeft + vuWidth*g__i + floor(abs(uiCharWidth - vuWidth)/2 + 0.5);
      gfx_y=gfx_h - gfx_texth*2 - 5;
      bufPeak[g__i] > (dbMin*-1) ? gfx_a = 0.8 : gfx_a = 0.3;
      (g__i == (slider4 - 1)) ?
      (
          gfx_r=1;gfx_g=1;gfx_b=1;gfx_a=0.8;
      )
      :
      (
          vu_rgb(0.9);
      );

      // one digit per row (3 rows from 100)
      g__tmp = g__i+1;
      g__dv = g__tmp >= 100 ? 100 : g__tmp >= 10 ? 10 : 1;
      gfx_y = gfx_h - gfx_texth*(g__tmp >= 100 ? 3 : 2) - 5;
      loop
      (
        g__tmp >= 100 ? 3 : g__tmp >= 10 ? 2 : 1,
        gfx_x=uiLeft + vuWidth*g__i + floor(abs(uiCharWidth - vuWidth)/2 + 0.5);
        gfx_drawnumber(((g__tmp/g__dv)|0) % 10, 0);
        gfx_y += gfx_texth;
        g__dv /= 10;
      );
    );

    // max dB

    vuWidth >= uiCharWidth /*JFB&& floor(((dbRulerStep*gfx_h)/dbMin) + 0.5) >= gfx_texth*6 */ ? // e.g. 5 for "-60.0" + 1 for top margin
    (
      gfx_r=1;gfx_g=1;gfx_b=1;
      bufPeak[g__i] > (dbMin*-1) ? gfx_a = 0.8 : gfx_a = 0.3;

      nbChar = 1; // top margin!

      gfx_x=uiLeft + vuWidth*g__i + floor(abs(uiCharWidth-vuWidth)/2 + 0.5); gfx_y = gfx_texth * nbChar;
      g__tmp = bufPeak[g__i];
      g__tmp == 0 || g__tmp > 0 ? gfx_drawchar($' ') : (gfx_drawchar($'-'); ); nbChar+=1;

      g__tmp = abs(g__tmp);
      tmp10=(g__tmp/10)|0;

      gfx_x=uiLeft + vuWidth*g__i + floor(abs(uiCharWidth-vuWidth)/2 + 0.5); gfx_y = gfx_texth * nbChar;
      tmp10 != 0 ? (gfx_drawnumber(tmp10,0); nbChar+=1;);
      gfx_x=uiLeft + vuWidth*g__i + floor(abs(uiCharWidth-vuWidth)/2 + 0.5); gfx_y = gfx_texth * nbChar;
      gfx_drawnumber((g__tmp - tmp10*10)|0,0); /*JFB nbChar+=1*/;
//      (tmp-(tmp|0))*10 > 0 ?
//      (
        gfx_x=uiLeft + vuWidth*g__i + floor(abs(uiCharWidth-vuWidth)/2 + 0.5); gfx_y = gfx_texth * nbChar + 4;
        gfx_drawchar($'.'); nbChar+=1;
        gfx_x=uiLeft + vuWidth*g__i + floor(abs(uiCharWidth-vuWidth)/2 + 0.5); gfx_y = gfx_texth * nbChar + 4;
        gfx_drawnumber((g__tmp-(g__tmp|0))*10,0);
//      );
    );

    // peaks
    bufPeak[g__i] == satThr || bufPeak[g__i] > satThr ? //JFB ">=" KO when "-0.0" !!
    (
      gfx_x=uiLeft + vuWidth*g__i ; gfx_y=0;
      gfx_r=1;gfx_g=0.0;gfx_b=0.0;gfx_a=1;
      gfx_rectto(uiLeft+vuWidth*(g__i+1) - 1, gfx_texth); // -1 for black lines between peaks
      ZZ+=1;

      // master peak
      gfx_x=1;gfx_y=0;
      gfx_r=1;gfx_g=0.0;gfx_b=0.0;gfx_a=1;
      gfx_rectto(uiLeft-1, gfx_texth);  // -1 for black line between following peaks
    );

/*JFB!!!
    // "dB"
    vuHeight > gfx_texth && dBstep > (uiCharWidth*4 + uiRightMargin) ? // e.g. 4 'cause "-6" & "dB"
    (
      gfx_x = gfx_w - uiRightMargin;
      gfx_y = floor(abs(gfx_texth-vuHeight)/2 + 0.5);
      gfx_r=.5;gfx_g=.5;gfx_b=.5;gfx_a=0.8;
      gfx_drawchar($'d');
      gfx_drawchar($'B');
    );
*/
    g__i+=1;
  );
  
  // dB lines
  gfx_r=.5;gfx_g=.5;gfx_b=.5;
  g__i=dbRulerStep;
  while
  (
    gfx_a=0.2;
    g__tmp = floor(((g__i*gfx_h)/dbMin) + 0.5);
    gfx_y = g__tmp; gfx_x=uiLeft;
    gfx_lineto(gfx_w,gfx_y, 0.4);
/*JFB
    (tmp - gfx_y) > gfx_texth ? // e.g. 3 'cause "-60" JFB!!! charWidth !
    (
*/
    gfx_a=0.8;
      gfx_x = floor(abs(uiCharWidth*3-uiLeft)/2 + 0.5);
      gfx_y = g__tmp  - floor(gfx_texth/2 + 0.5);
      gfx_drawnumber(g__i*-1,0);
//    );

    g__i+=dbRulerStep;
    g__i < dbMin;
  );

  // left V line
/*JFB
  gfx_x = uiLeft; gfx_y=0;
  gfx_lineto(gfx_x,gfx_h, 0.4);
*/


);

////////////////////
// mouse: left click clears all the peaks, right click opens the menu
////////////////////
g__cap = mouse_cap & 3;
(g__cap & 1) && !(g__lastCap & 1) ? clear_peaks();
(g__cap & 2) && !(g__lastCap & 2) ?
(
  #menu = ">GUI mode|";
  menu_item("Horizontal meters - fixed height", slider5 == 0, 0);
  menu_item("Horizontal meters - fit to height", slider5 == 1, 0);
  menu_item("Vertical meters - fixed width", slider5 == 2, 0);
  menu_item("Vertical meters - fit to width", slider5 == 3, 1);
  strcat(#menu, ">Saturation threshold|");
  menu_item("-20 dB", slider6 == 0, 0);
  menu_item("-6 dB", slider6 == 1, 0);
  menu_item("-2 dB", slider6 == 2, 0);
  menu_item("-1 dB", slider6 == 3, 0);
  menu_item("0 dB", slider6 == 4, 0);
  menu_item("+1 dB", slider6 == 5, 0);
  menu_item("+2 dB", slider6 == 6, 0);
  menu_item("+6 dB", slider6 == 7, 0);
  menu_item("+20 dB", slider6 == 8, 1);
  strcat(#menu, ">Meter color|");
  menu_item("Green", slider7 == 0, 0);
  menu_item("Orange", slider7 == 1, 0);
  menu_item("Blue", slider7 == 2, 0);
  menu_item("Yellow", slider7 == 3, 0);
  menu_item("Cyan", slider7 == 4, 0);
  menu_item("Violet", slider7 == 5, 1);
  strcat(#menu, ">Saturation auto clear|");
  menu_item("Permanent", slider8 == 0, 0);
  menu_item("After 1 minute", slider8 == 1, 0);
  menu_item("After 3 minutes", slider8 == 2, 0);
  menu_item("After 5 minutes", slider8 == 3, 1);
  gfx_x = mouse_x; gfx_y = mouse_y;
  g__sel = gfx_showmenu(#menu);
  g__sel >= 1 && g__sel <= 4 ? (slider5 = g__sel - 1; sliderchange(slider5);)
  : g__sel >= 5 && g__sel <= 13 ? (slider6 = g__sel - 5; satThr = thrTab[slider6]; sliderchange(slider6);)
  : g__sel >= 14 && g__sel <= 19 ? (slider7 = g__sel - 14; sliderchange(slider7);)
  : g__sel >= 20 && g__sel <= 23 ? (slider8 = g__sel - 20; sliderchange(slider8););
);
g__lastCap = g__cap;
