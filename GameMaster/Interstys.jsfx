desc:Interstys delay
desc:Interstys modular fractional delay - V0.1.1

//      memory 134 217 728 = 128 Mo.
options:maxmem=134217728
options:no_meter
options:gfx_idle
options:gfx_hz = 30
options:want_all_kb
options:gmem=GM_SHM

// Some constants
<?
/*
    Définir ici les caractéristique désirées pour "Interstys"

*/
    RD_CNT = 256; // nombre de lecteurs
    WR_CNT = 256; // nombre de writers
    LN_CNT = 256; // nombre de buffers audio
    FX_CNT = 512; // Nombre d'effets
    CH_NB = 256; // nombre de canaux à gérer (spl_in & spl_out)
    NB_BUS = 64; // nombre de bus utilisateur (virtuels : alloués dans le Pool quand ils sont utilisés, voir its_Patch_Update)
    NB_CTL = 64; // cellules de contrôle (sliders génériques)
    NB_GSL = 64; // sliders génériques (automatisables) : Ctl 1 ... NB_GSL écrivent les cellules de contrôle 0 ... NB_GSL-1
    GSL_FIRST = 1; // numéro du premier slider générique (les seuls sliders d'Interstys : Ctl n = slider n)
    CBL_CELLS = 16384; // cellules des câbles (le "Pool")
    /*
        Les cellules (smpl_tab), dans l'ordre
        0 : "None", toujours 0
        IN_P : In, les CH_NB entrées de la piste (écrites au début de @sample)
        OUT_P : Out, le bus de sortie, CH_NB canaux
        ---- Out et les bus sont effacés à chaque échantillon : plusieurs sources s'y ajoutent
        CTL_P : NB_CTL cellules de contrôle, tenues (sliders génériques)
        CBL_P : le Pool, CBL_CELLS cellules : les câbles propres des sorties (une seule source chacun),
            et les bus utilisés (leur largeur : le plus grand premier canal + largeur demandé par leurs utilisateurs)
        ZERO_P : 128 cellules toujours nulles (entrée non branchée ou invalide)
        TRASH_P : 128 cellules "poubelle" (sortie invalide)
    */
    IN_P = 1;
    OUT_P = IN_P + CH_NB;
    CTL_P = OUT_P + CH_NB;
    CBL_P = CTL_P + NB_CTL;
    ZERO_P = CBL_P + CBL_CELLS;
    TRASH_P = ZERO_P + 128;
    SMPL_SIZE = TRASH_P + 128; // Taille totale de la zone
    SPDMAX = 32;
    // Options
    // no_mslog = 1;s
?>

//°°°  SLIDERS
// the generic sliders, automatable (hidden : see the module "Controls" ; key 'S' shows them in the panel of REAPER)
<? i = 0; loop(NB_GSL, printf("slider%d:slCtl%d=0<-1,1,0.001>-Ctl %d\n", GSL_FIRST + i, i+1, i+1); i += 1;); ?>


