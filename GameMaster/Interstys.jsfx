desc:Interstys delay
desc:Interstys modular fractional delay - V0.1.1

//      memory 134 217 728 = 128 Mo.
options:maxmem=134217728
options:no_meter
options:gfx_idle
options:gfx_hz = 20
options:want_all_kba
options:gmem=GM_SHM

// Some constants
<?
/*
    Définir ici les caractéristique désirées pour "Interstys"

*/
    RD_CNT = 256; // nombre de lecteurs
    WR_CNT = 256; // nombre de writers
    LN_CNT = 256; // nombre de buffers audio
    FX_CNT = 256; // Nombre d'effets
    CH_NB = 256; // nombre de canaux à gérer (spl_in & spl_out)
    NB_BUS = 16; // nombre de bus utilisateur
    BUS_W = 8; // canaux par bus
    NB_CTL = 64; // cellules de contrôle (sliders génériques)
    CBL_CELLS = 16384; // cellules des câbles (le "Pool")
    /*
        Les cellules (smpl_tab), dans l'ordre
        0 : "None", toujours 0
        IN_P : In, les CH_NB entrées de la piste (écrites au début de @sample)
        OUT_P : Out, le bus de sortie, CH_NB canaux
        BUS_P : NB_BUS bus de BUS_W canaux
        ---- Out et les bus (OUT_P ... CTL_P-1) sont effacés à chaque échantillon : plusieurs sources s'y ajoutent
        CTL_P : NB_CTL cellules de contrôle, tenues (sliders génériques)
        CBL_P : le Pool, CBL_CELLS cellules : les câbles propres des sorties (une seule source chacun)
        ZERO_P : 128 cellules toujours nulles (entrée non branchée ou invalide)
        TRASH_P : 128 cellules "poubelle" (sortie invalide)
    */
    IN_P = 1;
    OUT_P = IN_P + CH_NB;
    BUS_P = OUT_P + CH_NB;
    CTL_P = BUS_P + NB_BUS * BUS_W;
    CBL_P = CTL_P + NB_CTL;
    ZERO_P = CBL_P + CBL_CELLS;
    TRASH_P = ZERO_P + 128;
    SMPL_SIZE = TRASH_P + 128; // Taille totale de la zone
    slnum = 1;
    SPDMAX = 4;
    // Options
    // no_mslog = 1;s
?>

//°°°  SLIDERS
slider<? printf("%d", (slnum += 1)); ?>:slLine=0<0,<? printf("%d", LN_CNT-1); ?>,1{Line 1<? i=2; loop(LN_CNT-1, printf(",Line %d",i); i+= 1;); ?>}> ================> Selected Line :
slider<? printf("%d", (slnum += 1)); ?>:slLnStatus=0<0,3,1{Undefined,Ready,Used}>Line status
slider<? printf("%d", (slnum += 1)); ?>:slLnlSize=1<1,1800,0.01:sqr=4>Line size (s)
slider<? printf("%d", (slnum += 1)); ?>:slLnChCnt=0<0,128,1{0<? i=1; loop(128, printf(",%d", i); i+= 1;); ?>}>Channel Count :
slider<? printf("%d", (slnum += 1)); ?>:slLnActn=0<0,4,1{Done,Clear,Create,---,Delete}>Action

<? slnum += 1; ?>


slider<? printf("%d", (slnum += 1)); ?>:slReader=0<0,<? printf("%d", RD_CNT-1); ?>,1{Reader 1<? i=2; loop(RD_CNT-1, printf(",Reader %d",i); i+= 1;); ?>}> ================> Selected Reader :
slider<? printf("%d", (slnum += 1)); ?>:slRStatus=0<0,4,1{Undefined,Created,Ready,Paused,Reading}>Reader status
slider<? printf("%d", (slnum += 1)); ?>:slRdMode=0<0,1,1{Reader,Delay}>Reader mode
slider<? printf("%d", (slnum += 1)); ?>:slRdSrcLNb=0<0,<? printf("%d", LN_CNT); ?>,1{None<? i=1; loop(LN_CNT, printf(",Line %d",i); i+= 1;); ?>}>-Source line
slider<? printf("%d", (slnum += 1)); ?>:slRDlSize=0<1,1200,0.001>-Line size (s)
slider<? printf("%d", (slnum += 1)); ?>:slRdLnChCnt=0<0,<? printf("%d", CH_NB-1); ?>,1{1<? i=2; loop(CH_NB-1, printf(",%d",i); i+= 1;); ?>}>-Line channels count
slider<? printf("%d", (slnum += 1)); ?>:slRd1stCh=0<0,<? printf("%d", CH_NB-1); ?>,1{Ch. 1<? i=2; loop(CH_NB-1, printf(",Ch. %d",i); i+= 1;); ?>}>-First channel used
slider<? printf("%d", (slnum += 1)); ?>:slRdChUsedCnt=0<0,<? printf("%d", CH_NB-1); ?>,1{1<? i=2; loop(CH_NB-1, printf(",%d",i); i+= 1;); ?>}>-Number of channels used
slider<? printf("%d", (slnum += 1)); ?>:slRSpeed=0<-<? printf("%d", SPDMAX); ?>,<? printf("%d", SPDMAX); ?>,0.0001:sqr=2>-Speed
slider<? printf("%d", (slnum += 1)); ?>:slRPos=0<0,100,0.001>-Position
slider<? printf("%d", (slnum += 1)); ?>:slRdWref=0<0,<? printf("%d", WR_CNT); ?>,1{None<? i=1; loop(WR_CNT, printf(",Writer %d",i); i+= 1;); ?>}>-Writer reference
slider<? printf("%d", (slnum += 1)); ?>:slRdOffs=0<0,600,0.00001:sqr=5>-Offset (s)
slider<? printf("%d", (slnum += 1)); ?>:slRdOutVol=0<-120,20,0.1>-Play volume
slider<? printf("%d", (slnum += 1)); ?>:slRdActRd=0<0,10,1{Done,Copy,Paste,Clear,Rewind,Speed 1,Create,Activate,Show,---,Delete}>-Action


<? slnum += 1; ?>


slider<? printf("%d", (slnum += 1)); ?>:slWriter=0<0,<? printf("%d", WR_CNT-1); ?>,1{Writer 1<? i=2; loop(WR_CNT-1, printf(",Writer %d",i); i+= 1;); ?>}>================> Selected Writer :
slider<? printf("%d", (slnum += 1)); ?>:slWrStatus=0<0,4,1{Undefined,Created,Ready,Paused,Writing}>Writer status
slider<? printf("%d", (slnum += 1)); ?>:slWDlLine=0<0,<? printf("%d", LN_CNT); ?>,1{None<? i=1; loop(LN_CNT, printf(",Line %d",i); i+= 1;); ?>}>Selected Line
slider<? printf("%d", (slnum += 1)); ?>:slWrLnChCnt=0<0,<? printf("%d", CH_NB-1); ?>,1{1<? i=2; loop(CH_NB-1, printf(",%d",i); i+= 1;); ?>}>-Line channels count
slider<? printf("%d", (slnum += 1)); ?>:slWDlSize=0<1,1200,0.001>-Line size (s)
slider<? printf("%d", (slnum += 1)); ?>:slWrPos=0<0,100,0.0001>-Position (%)
slider<? printf("%d", (slnum += 1)); ?>:slWrInGain=0<-120,20,0.1>-Record gain
slider<? printf("%d", (slnum += 1)); ?>:slWrOvrdb=0<0,100,0.0001>-Overdub (%)
slider<? printf("%d", (slnum += 1)); ?>:slWrtAct=0<0,10,1{Done,Copy,Paste,Clear,Rewind,Reset,Create,Activate,Show,---,Delete}>-Action

<? slnum += 1; ?>


slider<? printf("%d", (slnum += 1)); ?>:slGlAct=0<0,7,0{Done,Stop all,Pause all,Restart all,Rewind all,Clear all,---,Delete all structures}>================> Global action
slider<? printf("%d", (slnum += 1)); ?>:slSmpl=0<0,2,1{Merge,Ignore,Pass}>Track Samples:
slider<? printf("%d", (slnum += 1)); ?>:slInGain=0<-120,20,0.1>-Global Input gain
slider<? printf("%d", (slnum += 1)); ?>:slOutVol=0<-120,20,0.1>-Global Output volume
slider<? printf("%d", (slnum += 1)); ?>:slStlatency=10<1,10000,1:sqr=3>Start/Stop Latency (ms)


