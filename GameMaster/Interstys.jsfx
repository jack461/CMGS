slider<? printf("%d", (slnum += 1)); ?>:slWrLnChCnt=0<0,<? printf("%d", CH_NB-1); ?>,1{1<? i=2; loop(CH_NB-1, printf(",%d",i); i+= 1;); ?>}>-Line channels count
