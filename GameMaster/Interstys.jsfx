desc:Interstys delay
desc:Interstys modular fractional delay - V0.1.1

//      memory 134 217 728 = 128 Mo.
options:maxmem=134217728
options:no_meter
options:gfx_idle
options:gfx_hz = 20
options:want_all_kba
options:gmem=GM_SHM

// Some constants
<?
/*
    Définir ici les caractéristique désirées pour "Interstys"

*/
    RD_CNT = 256; // nombre de lecteurs
    WR_CNT = 256; // nombre de writers
    LN_CNT = 256; // nombre de buffers audio
    FX_CNT = 256; // Nombre d'effets
    CH_NB = 256; // nombre de canaux à gérer (spl_in & spl_out)
    NB_AUX = 256; // autres zones de travail (aux & tmp)
    NB_WRK = 256; // mots immédiats
    /*
        Les cellules sont, dans l'ordre
        1 : "None" - cellule toujours inutilisée
        ---- temporaires
        CH_NB : les spl_in (128)
        CH_NB : les spl_out (128)
        NB_AUX : les aux
        NB_AUX : les tmp
        NB_AUX : les fmr
        NB_AUX : les loc
        ---- rémanentes
        NB_AUX : les var
        NB_AUX : les cst
        NB_WRK : mots de travail, "Work i"
        RD_CNT : mots de travail, "Reader i"
        WR_CNT : mots de travail, "Writer i"
        FX_CNT : mots de travail, "Effect i"
    */
    SMPL_SIZE = 1 + NB_WRK + RD_CNT + WR_CNT + FX_CNT + 2 * CH_NB + 6 * NB_AUX; // Taille totale de la zone
    TEMP_SIZE = 1 + 2 * CH_NB + 4 * NB_AUX; // taille des temporaires
    SPL_P = 1;
    OUT_P = 1 + CH_NB;
    // Génération des noms des cellules
    function gen_cells_names()
    (
        printf("None");
        i = 0; loop(CH_NB, printf(",spl_in(%d)", i); i+=1;);
        i = 0; loop(CH_NB, printf(",spl_out(%d)", i); i+=1;);
        i = 0; loop(NB_AUX, printf(",aux %d", i); i+=1;);
        i = 0; loop(NB_AUX, printf(",tmp %d", i); i+=1;);
        i = 1; loop(NB_WRK, printf(",Work %d", i); i+=1;);
        i = 1; loop(RD_CNT, printf(",Reader %d", i); i+=1;);
        i = 1; loop(WR_CNT, printf(",Writer %d", i); i+=1;);
        i = 1; loop(FX_CNT, printf(",Effect %d", i); i+=1;);
    );
    slnum = 1;
    SPDMAX = 4;
    // Options
    // no_mslog = 1;s
?>

//°°°  SLIDERS
slider<? printf("%d", (slnum += 1)); ?>:slLine=0<0,<? printf("%d", LN_CNT-1); ?>,1{Line 1<? i=2; loop(LN_CNT-1, printf(",Line %d",i); i+= 1;); ?>}> ================> Selected Line :
slider<? printf("%d", (slnum += 1)); ?>:slLnStatus=0<0,3,1{Undefined,Ready,Used}>Line status
slider<? printf("%d", (slnum += 1)); ?>:slLnlSize=1<1,1800,0.01:sqr=4>Line size (s)
slider<? printf("%d", (slnum += 1)); ?>:slLnChCnt=0<0,128,1{0<? i=1; loop(128, printf(",%d", i); i+= 1;); ?>}>Channel Count :
slider<? printf("%d", (slnum += 1)); ?>:slLnActn=0<0,4,1{Done,Clear,Create,---,Delete}>Action

<? slnum += 1; ?>


slider<? printf("%d", (slnum += 1)); ?>:slReader=0<0,<? printf("%d", RD_CNT-1); ?>,1{Reader 1<? i=2; loop(RD_CNT-1, printf(",Reader %d",i); i+= 1;); ?>}> ================> Selected Reader :
slider<? printf("%d", (slnum += 1)); ?>:slRStatus=0<0,4,1{Undefined,Created,Ready,Paused,Reading}>Reader status
slider<? printf("%d", (slnum += 1)); ?>:slRdMode=0<0,1,1{Reader,Delay}>Reader mode
slider<? printf("%d", (slnum += 1)); ?>:slRdSrcLNb=0<0,<? printf("%d", LN_CNT); ?>,1{None<? i=1; loop(LN_CNT, printf(",Line %d",i); i+= 1;); ?>}>-Source line
slider<? printf("%d", (slnum += 1)); ?>:slRDlSize=0<1,1200,0.001>-Line size (s)
slider<? printf("%d", (slnum += 1)); ?>:slRdLnChCnt=0<0,<? printf("%d", CH_NB-1); ?>,1{1<? i=2; loop(CH_NB-1, printf(",%d",i); i+= 1;); ?>}>-Line channels count
slider<? printf("%d", (slnum += 1)); ?>:slRd1stCh=0<0,<? printf("%d", CH_NB-1); ?>,1{Ch. 1<? i=2; loop(CH_NB-1, printf(",Ch. %d",i); i+= 1;); ?>}>-First channel used
slider<? printf("%d", (slnum += 1)); ?>:slRdChUsedCnt=0<0,<? printf("%d", CH_NB-1); ?>,1{1<? i=2; loop(CH_NB-1, printf(",%d",i); i+= 1;); ?>}>-Number of channels used
slider<? printf("%d", (slnum += 1)); ?>:slRSpeed=0<-<? printf("%d", SPDMAX); ?>,<? printf("%d", SPDMAX); ?>,0.0001:sqr=2>-Speed
slider<? printf("%d", (slnum += 1)); ?>:slRPos=0<0,100,0.001>-Position
slider<? printf("%d", (slnum += 1)); ?>:slRdWref=0<0,<? printf("%d", WR_CNT); ?>,1{None<? i=1; loop(WR_CNT, printf(",Writer %d",i); i+= 1;); ?>}>-Writer reference
slider<? printf("%d", (slnum += 1)); ?>:slRdOffs=0<0,600,0.00001:sqr=5>-Offset (s)
slider<? printf("%d", (slnum += 1)); ?>:slRdrOut=0<0,<? printf("%d", SMPL_SIZE-1); ?>,1{<? gen_cells_names(); ?>}>-Reader output
slider<? printf("%d", (slnum += 1)); ?>:slRdOutVol=0<-120,20,0.1>-Play volume
slider<? printf("%d", (slnum += 1)); ?>:slRdActRd=0<0,10,1{Done,Copy,Paste,Clear,Rewind,Speed 1,Create,Activate,Show,---,Delete}>-Action


<? slnum += 1; ?>


slider<? printf("%d", (slnum += 1)); ?>:slEffect=0<0,<? printf("%d", FX_CNT-1); ?>,1{Effect 1<? i=2; loop(FX_CNT-1, printf(",Effect %d",i); i+= 1;); ?>}>================> Selected Effect :
slider<? printf("%d", (slnum += 1)); ?>:slEPhase=0<0,2,1{Standard,Before readers,After writers}>Position
slider<? printf("%d", (slnum += 1)); ?>:slType=0<0,6,1{Undefined,unused,Mixer,EQ Mixer,Mover,Action,Script}>Type
slider<? printf("%d", (slnum += 1)); ?>:slFxChCnt=0<0,128,1{0<? i=1; loop(128, printf(",%d", i); i+= 1;); ?>}>-Channel Count :
slider<? printf("%d", (slnum += 1)); ?>:slEndOut=0<0,<? printf("%d", SMPL_SIZE-1); ?>,1{<? gen_cells_names(); ?>}>-Output
<? FXarray=slnum; ?>
slider<? printf("%d", (slnum += 1)); ?>:slRnSrc1=0<0,<? printf("%d", SMPL_SIZE-1); ?>,1{<? gen_cells_names(); ?>}>-Source 1
slider<? printf("%d", (slnum += 1)); ?>:slRnGain1=0<-120,20,0.1>-Gain 1 (dB)
