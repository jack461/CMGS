     <text:p text:style-name="P3"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc567_1699054703" office:name="Les décisions à prendre" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">7.5.2 Les décisions à prendre</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc567_1699054703" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">20</text:a></text:p>
     <text:p text:style-name="P1"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc912_1582195625" office:name="L’interface graphique" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">8 L’interface graphique</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc912_1582195625" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">21</text:a></text:p>
     <text:p text:style-name="P1"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc914_1582195625" office:name="Les utilitaires" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link"><text:soft-page-break/>9 Les utilitaires</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc914_1582195625" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">22</text:a></text:p>
