     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">oui</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interface (ui-lib et extensions)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">oui</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">oui</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">oui</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">oui</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">oui</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">oui</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Onglets et panneaux (<text:span text:style-name="Source_5f_Text">mSL_Panes</text:span>)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
