    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1632</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">settings</text:span> (ou <text:span text:style-name="Source_5f_Text">table</text:span>) appelé sans argument.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1633</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">settings</text:span> : plus de 1024 arguments (utiliser un bloc <text:span text:style-name="Source_5f_Text">data</text:span>).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1640</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">settings(data( GUI ... ))</text:span> : une clé est attendue (theme, shade, size, style, tabs, variant, fonts, palette, hue, chroma, light, danger, hover, disabled, adjust, ptext, bold, ftext, fbold, fwidth, gapx, gapy, corners, fade, extend, select, contrast, frame, radius, thick, color, opacity, defaults, default, restore) ; après default (le défaut de l’utilisateur), theme et size ne sont pas acceptés, ni restore.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1641</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">settings(data( GUI ... ))</text:span> : une valeur hors de sa plage.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1642</text:p>
