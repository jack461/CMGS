      <text:p text:style-name="Table_20_Contents">le code du symbole</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">constante</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">$pi</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
