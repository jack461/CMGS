    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2255</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Erreur dans les paramètres d’une fonction (un « ; » n’est permis que dans la forme variadique <text:span text:style-name="Source_5f_Text">(n; args)</text:span>).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2256</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lambda-expression (<text:span text:style-name="Source_5f_Text">function (x) (…)</text:span>) : son corps doit suivre ses paramètres (et ses groupes <text:span text:style-name="Source_5f_Text">local(…)</text:span>), entre parenthèses.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2257</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lambda-expression (<text:span text:style-name="Source_5f_Text">function (x) (…)</text:span>) : une parenthèse ouverte n’est pas fermée.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2258</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Trop de lambda-expressions dans un même texte (62 au plus).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2259</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lambda-expression : son code compilé n’est pas trouvé (erreur interne du compilateur).</text:p>
     </table:table-cell>
    </table:table-row>
