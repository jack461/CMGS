     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1725_3118163005" office:name="Les séries de tests" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">12.4 Les séries de tests</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1725_3118163005" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">37</text:a></text:p>
     <text:p text:style-name="P1"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1018_3791693507" office:name="Partie IV — Les erreurs" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">Partie IV — Les erreurs</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1018_3791693507" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">38</text:a></text:p>
     <text:p text:style-name="P1"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3423_3373287921" office:name="Liste des erreurs" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">13 Liste des erreurs</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3423_3373287921" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">39</text:a></text:p>
     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3425_3373287921" office:name="Lire un message d’erreur" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">13.1 Lire un message d’erreur</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3425_3373287921" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">39</text:a></text:p>
     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3427_3373287921" office:name="Les familles de codes" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">13.2 Les familles de codes</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3427_3373287921" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">39</text:a></text:p>
     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3429_3373287921" office:name="Codes 0100 à 0999" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">13.3 Codes 0100 à 0999</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3429_3373287921" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">40</text:a></text:p>
     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3431_3373287921" office:name="Codes 1000 à 1999" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">13.4 Codes 1000 à 1999</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3431_3373287921" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">45</text:a></text:p>
     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3433_3373287921" office:name="Codes 2000 à 2999" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">13.5 Codes 2000 à 2999</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3433_3373287921" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">47</text:a></text:p>
     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3435_3373287921" office:name="Codes 3000 à 4999" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">13.6 Codes 3000 à 4999</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3435_3373287921" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">55</text:a></text:p>
     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3437_3373287921" office:name="Codes 6000 à 9999" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">13.7 Codes 6000 à 9999</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc3437_3373287921" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">56</text:a></text:p>
    </text:index-body>
   </text:table-of-content>
   <text:p text:style-name="part"><text:bookmark-start text:name="__RefHeading___Toc1016_3791693507"/>Partie I — Présentation et installation<text:bookmark-end text:name="__RefHeading___Toc1016_3791693507"/></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="quest-ce-que-cmgs"/><text:bookmark-start text:name="__RefHeading___Toc954_3791693507"/>Qu’est-ce que CMGS<text:bookmark-end text:name="quest-ce-que-cmgs"/><text:bookmark-end text:name="__RefHeading___Toc954_3791693507"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="finalités"/><text:bookmark-start text:name="__RefHeading___Toc956_3791693507"/>Finalités<text:bookmark-end text:name="finalités"/><text:bookmark-end text:name="__RefHeading___Toc956_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le <text:span text:style-name="T1">Concrete Music Gran Studio</text:span>, ou <text:span text:style-name="T1">CMGS</text:span>, est un ensemble d’outils destinés aux compositeurs de musique concrète et électroacoustique. Il est né du <text:span text:style-name="T2">Game Master</text:span>, un générateur de séquences sonores multicanales, et s’est enrichi au fil des années d’outils de diffusion, de traitement et de mise au point. Il couvre aujourd’hui trois usages :</text:p>
   <text:list text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P3"><text:span text:style-name="T1">le studio</text:span> : composer à partir de sons fixés (les <text:span text:style-name="T2">clips</text:span>), les transformer, les placer dans l’espace, essayer rapidement de nombreuses variantes ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P3"><text:span text:style-name="T1">le concert</text:span> : diffuser une pièce sur un acousmonium, jouer en direct depuis des contrôleurs MIDI ou des capteurs ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P3"><text:span text:style-name="T1">l’installation</text:span> : laisser le logiciel générer, pendant des heures, des séquences toujours renouvelées, selon des règles fixées par le compositeur.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Tous les outils de CMGS sont pensés pour le <text:span text:style-name="T1">multicanal</text:span> : la plupart traitent jusqu’à 128 canaux, et une même session peut se préparer au casque, en stéréophonie, puis se jouer sur une installation de plusieurs dizaines de haut-parleurs.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="principe-de-fonctionnement"/><text:bookmark-start text:name="__RefHeading___Toc958_3791693507"/>Principe de fonctionnement<text:bookmark-end text:name="principe-de-fonctionnement"/><text:bookmark-end text:name="__RefHeading___Toc958_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">CMGS est écrit en <text:span text:style-name="T1">JSFX</text:span>, le langage de plug-ins de REAPER : il ne fonctionne donc que dans <text:span text:style-name="T1">REAPER</text:span> (version 7.25 ou plus récente), sur Mac comme sur Windows. Chaque outil est un plug-in, que l’on place sur une piste de REAPER comme n’importe quel effet.</text:p>
   <text:p text:style-name="Text_20_body">Les plug-ins <text:span text:style-name="T3">JSFX</text:span><text:span text:style-name="T4"> </text:span>de REAPER fonctionnent dans un « bac à sable » : ils ne peuvent ni écrire de fichiers, ni connaître le contenu des dossiers, ni piloter REAPER lui-même. CMGS contourne ces limites de trois façons :</text:p>
   <text:list text:style-name="L2">
    <text:list-item>
     <text:p text:style-name="P4">les plug-ins de CMGS <text:span text:style-name="T1">partagent une mémoire commune</text:span>, par laquelle ils échangent des commandes, des messages et des données (le Game Master pilote ainsi ses lecteurs, placés sur d’autres pistes) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P4">ils embarquent un <text:span text:style-name="T1">langage de script</text:span>, <text:span text:style-name="T1">mSL</text:span> (<text:span text:style-name="T2">micro Script Language</text:span>), qui permet de décrire des configurations, d’écrire des algorithmes de jeu, d’automatiser des réglages et de faire dialoguer les plug-ins ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P4">un <text:span text:style-name="T1">script auxiliaire</text:span>, <text:span text:style-name="Source_5f_Text">CMGS-auxiliary.eel</text:span>, lancé comme une action de REAPER, écrit les fichiers que lui demandent les plug-ins et transmet leurs commandes à REAPER (lecture, marqueurs, actions).</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Les plug-ins de CMGS partagent aussi une même <text:span text:style-name="T1">interface utilisateur</text:span> : onglets, panneaux, modules, pads et sliders s’y utilisent de la même façon, et les touches du clavier y ont les mêmes rôles. Cette interface est décrite dans la Partie II ; le langage mSL dans la Partie III ; la Partie IV rassemble tous les messages d’erreur.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="ce-document-et-les-autres-manuels"/><text:bookmark-start text:name="__RefHeading___Toc960_3791693507"/>Ce document et les autres manuels<text:bookmark-end text:name="ce-document-et-les-autres-manuels"/><text:bookmark-end text:name="__RefHeading___Toc960_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Ce manuel général présente l’ensemble de CMGS, son installation, et ce qui est commun à tous ses outils. Chaque outil important a en outre son propre manuel, dans le dossier <text:span text:style-name="Source_5f_Text">CMGS-docs</text:span> :</text:p>
   <table:table table:name="Table1" table:style-name="Table1">
    <table:table-column table:style-name="Table1.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Fichier</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">GameMaster-Manuel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le Game Master : clips, modes de jeu et d’espace, banques, jeu automatique, playlog</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Diffusion-3-Manuel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Diffusion-3 : projecteurs, scènes, <text:soft-page-break/>trajectoires, configurations, APCmini</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Interstys-Manuel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys : lignes, lecteurs, enregistreurs, effets, courbes, liens MIDI</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">MCBM-Manuel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les gestionnaires de basses MCBM-64 et MCBM-128</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">SmoothMultiLimiter-Manuel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le limiteur multicanal</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Multichannel_VU_meter-Manuel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le VU-mètre multicanal</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-Keys.md</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les touches du clavier de tous les plug-ins</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-Internals</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">la documentation interne, destinée à qui veut modifier le code</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Les fichiers <text:span text:style-name="Source_5f_Text">.fodt</text:span> sont les sources LibreOffice des manuels ; les fichiers <text:span text:style-name="Source_5f_Text">.pdf</text:span> en sont la version imprimable.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="les-outils"/><text:bookmark-start text:name="__RefHeading___Toc962_3791693507"/>Les outils<text:bookmark-end text:name="les-outils"/><text:bookmark-end text:name="__RefHeading___Toc962_3791693507"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="le-game-master"/><text:bookmark-start text:name="__RefHeading___Toc964_3791693507"/>Le Game Master<text:bookmark-end text:name="le-game-master"/><text:bookmark-end text:name="__RefHeading___Toc964_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le <text:span text:style-name="T1">Game Master</text:span> est l’outil d’origine de CMGS : un échantillonneur couplé à un générateur de musique électroacoustique. Il joue des <text:span text:style-name="T2">clips</text:span>, fichiers son de quelques secondes à quelques minutes (jusqu’à 10 000 par projet), selon deux algorithmes :</text:p>
   <text:list text:style-name="L3">
    <text:list-item>
     <text:p text:style-name="P5">le jeu <text:span text:style-name="T1">« Play »</text:span> lit un segment du clip, avec une vitesse, un sens, un volume et des enveloppes choisis ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P5">le jeu <text:span text:style-name="T1">« Loop »</text:span> en extrait des fragments, des boucles longues jusqu’aux grains de quelques millisecondes : on passe alors du <text:span text:style-name="T2">looper</text:span> à la synthèse granulaire.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Le compositeur ne règle pas chaque son : il décrit des <text:span text:style-name="T1">modes de jeu</text:span> (comment jouer un clip), des <text:span text:style-name="T1">modes d’espace</text:span> (sur quels haut-parleurs, et comment), et les regroupe en <text:span text:style-name="T1">partiels</text:span>, <text:span text:style-name="T1">banques</text:span> et <text:span text:style-name="T1">groupes</text:span>. L’<text:span text:style-name="T4">utilisateur du</text:span> Game Master choisit ensuite, à la main (pads, clavier, contrôleurs MIDI, capteurs) ou automatiquement (mode <text:span text:style-name="T2">auto-play</text:span>), les clips à jouer et la façon de les jouer. Chaque son joué est noté dans le <text:span text:style-name="T1">playlog</text:span>, qui permet de le rejouer à l’identique. Toute la configuration d’un projet tient dans un script mSL, le <text:span text:style-name="T1">Profile</text:span>.</text:p>
   <text:p text:style-name="Text_20_body">Le Game Master se compose de plusieurs plug-ins :</text:p>
   <table:table table:name="Table2" table:style-name="Table2">
    <table:table-column table:style-name="Table2.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table2.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Plug-in</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table2.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Rôle</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">GamePlayer</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le Game Master proprement dit : interface, algorithmes, ordonnanceur, scripts mSL ; un seul par session</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">FilePlayer</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">un lecteur, qui joue un clip à la fois ; on en place un par piste, et leur nombre fait la polyphonie (typiquement 8 à 20)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">MIDI_In</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">transmet au Game Master les messages d’un périphérique MIDI (contrôleurs, notes)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">MIDIduino</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">transmet au Game Master les notes envoyées par des capteurs (par exemple infrarouges, sur un Arduino), ou par tout clavier MIDI</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="diffusion-3"/><text:bookmark-start text:name="__RefHeading___Toc966_3791693507"/>Diffusion-3<text:bookmark-end text:name="diffusion-3"/><text:bookmark-end text:name="__RefHeading___Toc966_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="T1">Diffusion-3</text:span> diffuse, ou spatialise, des sources multicanales sur une installation multicanale (un acousmonium), jusqu’à 128 canaux en entrée et en sortie. Il a d’abord été conçu pour diffuser facilement des pièces stéréophoniques sur un grand nombre de haut-parleurs ; il permet aussi d’essayer la spatialisation d’une piste pendant la composition, ou de projeter en concert plusieurs sources (un instrument joué en direct, des pistes d’accompagnement).</text:p>
   <text:p text:style-name="Text_20_body">Il propose 16 <text:span text:style-name="T1">projecteurs</text:span> indépendants, des <text:span text:style-name="T1">scènes</text:span> et le passage progressif de l’une à l’autre (<text:span text:style-name="T2">morphing</text:span>), des <text:span text:style-name="T1">trajectoires</text:span> dans un espace en trois dimensions, avec une vue 3D, des <text:span text:style-name="T1">configurations</text:span> de haut-parleurs décrites en mSL, et la commande depuis un contrôleur <text:span text:style-name="T1">AKAI APCmini</text:span>.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="interstys"/><text:bookmark-start text:name="__RefHeading___Toc968_3791693507"/>Interstys<text:bookmark-end text:name="interstys"/><text:bookmark-end text:name="__RefHeading___Toc968_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="T1">Interstys</text:span> est un <text:span text:style-name="T1">délai fractionnaire modulaire</text:span> : il enregistre le son dans des mémoires (les <text:span text:style-name="T2">lignes</text:span>), le relit à des vitesses et des retards quelconques, le transforme par des <text:span text:style-name="T2">effets</text:span>, et relie tous ces éléments par des <text:span text:style-name="T2">câbles</text:span>, à la manière d’un synthétiseur modulaire. Ses lecteurs savent aussi étirer le temps (<text:span text:style-name="T2">Stretch</text:span>) et produire des grains (<text:span text:style-name="T2">Grains</text:span>) ; ses effets vont du filtre <text:soft-page-break/>et de la saturation aux matrices de réinjection, flanger, phaser, shimmer, bruits et générateurs aléatoires. Les réglages peuvent être modulés, liés à des contrôleurs MIDI, et décrits entièrement en mSL : un patch peut être sauvegardé, rechargé, ou construit par un script.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="scriptmaster"/><text:bookmark-start text:name="__RefHeading___Toc970_3791693507"/>ScriptMaster<text:bookmark-end text:name="scriptmaster"/><text:bookmark-end text:name="__RefHeading___Toc970_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="T1">ScriptMaster</text:span> est un atelier pour les scripts mSL. On y dépose un script, qui est compilé et exécuté ; on suit son travail dans le journal (<text:span text:style-name="T2">System Log</text:span>), l’ordonnanceur (<text:span text:style-name="T2">Scheduler</text:span>), les processus (<text:span text:style-name="T2">Processes Manager</text:span>) et la mémoire (<text:span text:style-name="T2">Memory</text:span>). Il sert à mettre au point des scripts, à faire tourner des tâches indépendantes des autres outils, et à passer les séries de tests du langage.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="les-plug-ins-auxiliaires"/><text:bookmark-start text:name="__RefHeading___Toc972_3791693507"/>Les plug-ins auxiliaires<text:bookmark-end text:name="les-plug-ins-auxiliaires"/><text:bookmark-end text:name="__RefHeading___Toc972_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">CMGS fournit aussi des plug-ins plus simples, utiles dans une session multicanale :</text:p>
   <table:table table:name="Table3" table:style-name="Table3">
    <table:table-column table:style-name="Table3.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table3.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Plug-in</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table3.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Rôle</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">MCBM-64</text:span>, <text:span text:style-name="Source_5f_Text">MCBM-128</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gestionnaires de basses multicanaux, jusqu’à 128 canaux : les graves de chaque canal sont envoyés vers un ou plusieurs caissons (<text:span text:style-name="Source_5f_Text">MCBM-128</text:span> : filtres de Linkwitz-Riley)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">SmoothMultiLimiter</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">limiteur multicanal, jusqu’à 128 canaux (d’après un plug-in de Geraint Luff)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Multichannel_VU_meter</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">VU-mètre jusqu’à 128 canaux (dérivé du <text:span text:style-name="T2">S&amp;M Multichannel VU meter</text:span> de Jeff Bédague) ; <text:span text:style-name="Source_5f_Text">Multichannel_VU_meter_U</text:span> en est une variante</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">channels-folder</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">replie les canaux d’une piste sur un nombre plus petit (par exemple sur 2, pour écouter au casque une session octophonique)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CheapChannelReducer</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">réduction stéréo sommaire : les canaux impairs à gauche, les pairs à droite</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">ChannelReducer16</text:span>, <text:span text:style-name="Source_5f_Text">24</text:span>, <text:span text:style-name="Source_5f_Text">48</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">envoie chaque canal d’entrée vers le canal de sortie de son choix</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">ChannelsMuter</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">coupe tous les canaux d’une piste</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">ChannelsSwitcher</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sélecteur de canaux pour 8 canaux, à quelques configurations fixes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">mid-side</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">réglage séparé des parties <text:span text:style-name="T2">mid</text:span> et <text:span text:style-name="T2">side</text:span> d’une stéréo</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Synchronizer</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">fournit aux autres plug-ins le numéro exact de l’échantillon courant, pour les synchroniser à l’échantillon près</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Trois plug-ins servent d’exemples : <text:span text:style-name="Source_5f_Text">AKAI-Ex-01</text:span> et <text:span text:style-name="Source_5f_Text">AKAI-Ex-02</text:span> (programmation d’un AKAI APCmini), et <text:span text:style-name="Source_5f_Text">Space3D-Demo</text:span> (la vue en trois dimensions de Diffusion-3).</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="le-script-auxiliaire"/><text:bookmark-start text:name="__RefHeading___Toc974_3791693507"/>Le script auxiliaire<text:bookmark-end text:name="le-script-auxiliaire"/><text:bookmark-end text:name="__RefHeading___Toc974_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="Source_5f_Text">CMGS-auxiliary.eel</text:span> n’est pas un plug-in mais un <text:span text:style-name="T2">ReaScript</text:span>, que l’on charge une fois dans <text:soft-page-break/>la liste des actions de REAPER (voir l’installation). Lancé, il reste en tâche de fond et répond aux demandes des plug-ins :</text:p>
   <text:list text:style-name="L4">
    <text:list-item>
     <text:p text:style-name="P6"><text:span text:style-name="T1">écrire des fichiers</text:span> : export du journal d’un plug-in (touche <text:span text:style-name="Source_5f_Text">p</text:span>), patchs et sessions d’Interstys, exports de Diffusion-3 ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P6"><text:span text:style-name="T1">afficher</text:span> un texte dans la console de REAPER (touche <text:span text:style-name="Source_5f_Text">P</text:span> du journal) ou une boîte de dialogue ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P6"><text:span text:style-name="T1">piloter REAPER</text:span> : lecture, arrêt, pause, déplacement vers un marqueur, position du curseur, exécution de n’importe quelle action de REAPER par son numéro ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P6"><text:span text:style-name="T1">fournir le dossier du projet</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Les plug-ins fonctionnent sans lui, mais ces services ne sont alors pas disponibles.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="tutoriels-et-scripts-fournis"/><text:bookmark-start text:name="__RefHeading___Toc976_3791693507"/>Tutoriels et scripts fournis<text:bookmark-end text:name="tutoriels-et-scripts-fournis"/><text:bookmark-end text:name="__RefHeading___Toc976_3791693507"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="le-tutoriel-gm-octo"/><text:bookmark-start text:name="__RefHeading___Toc978_3791693507"/>Le tutoriel « GM-Octo »<text:bookmark-end text:name="le-tutoriel-gm-octo"/><text:bookmark-end text:name="__RefHeading___Toc978_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le dépôt <text:span text:style-name="T1">CMGS-Tutorials</text:span> (<text:a xlink:type="simple" xlink:href="https://github.com/jack461/CMGS-Tutorials" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Definition">https://github.com/jack461/CMGS-Tutorials</text:span></text:a>) contient un projet complet, <text:span text:style-name="T2">GM-Octo-2024</text:span> (dossier <text:span text:style-name="Source_5f_Text">Tuto-01</text:span>), d’environ 1 Go. C’est à l’origine un programme de concert pour lequel plusieurs compositeurs ont fourni des sons ; seuls ont été gardés les fichiers placés par leurs auteurs sous licence <text:span text:style-name="T2">Creative Commons</text:span> (Gilles Roussi, Diego Losa, Francis Valery, Alain Girardot, Jean-Jacques Girardot).</text:p>
   <text:p text:style-name="Text_20_body">Le projet réunit un Game Master, douze lecteurs, les pistes de mixage et d’écoute au casque, et un Profile qui décrit les modes de jeu et d’espace, les banques et les capteurs. Une fois CMGS installé :</text:p>
   <text:list text:style-name="L5">
    <text:list-item>
     <text:p text:style-name="P7">téléchargez le dépôt (bouton vert <text:span text:style-name="T1">Code</text:span>, puis <text:span text:style-name="T1">Download ZIP</text:span>), décompressez-le, et placez le dossier <text:span text:style-name="Source_5f_Text">GM-Octo-2024</text:span> où vous voulez ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P7">double-cliquez sur <text:span text:style-name="Source_5f_Text">GM-Octo.RPP</text:span> : REAPER s’ouvre, mais le journal du GamePlayer (piste « GAME PLAYER ») signale des erreurs, car le plug-in utilise encore les chemins de l’ordinateur où le projet a été enregistré ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P7">faites glisser le fichier <text:span text:style-name="Source_5f_Text">GM-Octo.RPP</text:span> dans la fenêtre du GamePlayer : le plug-in apprend ainsi où se trouve le projet ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P7">enregistrez le projet, quittez REAPER et relancez-le : la dernière ligne du journal affiche <text:span text:style-name="Source_5f_Text">** GAME MASTER / SESSION OCTO READY **</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Cliquez alors sur <text:span text:style-name="T1">Auto-play</text:span> : le Game Master commence à jouer. La sortie est en stéréophonie ; pour écouter en octophonie, désactivez le plug-in <text:span text:style-name="Source_5f_Text">channels-folder</text:span> de la piste MASTER.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="les-scripts-de-cmgs-scripts"/><text:bookmark-start text:name="__RefHeading___Toc980_3791693507"/>Les scripts de <text:span text:style-name="Source_5f_Text">CMGS-scripts</text:span><text:bookmark-end text:name="les-scripts-de-cmgs-scripts"/><text:bookmark-end text:name="__RefHeading___Toc980_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le dossier <text:span text:style-name="Source_5f_Text">CMGS-scripts</text:span> contient des scripts mSL dont les plug-ins n’ont pas besoin pour fonctionner, mais qui servent d’exemples, de recettes ou d’outils de vérification. Pour lancer un script, il suffit de déposer le fichier <text:span text:style-name="Source_5f_Text">.mSL</text:span> dans la fenêtre d’un plug-in ; ses messages apparaissent dans le journal de celui-ci.</text:p>
   <table:table table:name="Table4" table:style-name="Table4">
    <table:table-column table:style-name="Table4.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table4.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Dossier</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table4.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Algorithms</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys : des recettes prêtes à l’emploi (Matrix, Flanger, Chorus, Phaser, Shimmer, Noise, Random, Math, Ring), chacune avec ses paramètres ; <text:span text:style-name="Source_5f_Text">Sources.mSL</text:span> fournit du matériau d’essai</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Presets</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys : cinq presets de génération, qui transforment un son d’entrée en une dizaine de minutes de musique</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Examples</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys : petits exemples (chaîne d’effets, courbes, liens MIDI d’un AKAI MIDI Mix)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Tests</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les séries de tests <text:span text:style-name="Source_5f_Text">Ex-NNNN.mSL</text:span> du langage et des plug-ins, et l’outil <text:span text:style-name="Source_5f_Text">check_scripts.py</text:span> qui en vérifie les résultats (voir la Partie III)</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="installation"/><text:bookmark-start text:name="__RefHeading___Toc982_3791693507"/>Installation<text:bookmark-end text:name="installation"/><text:bookmark-end text:name="__RefHeading___Toc982_3791693507"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="reaper"/><text:bookmark-start text:name="__RefHeading___Toc984_3791693507"/>REAPER<text:bookmark-end text:name="reaper"/><text:bookmark-end text:name="__RefHeading___Toc984_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Installez <text:span text:style-name="T1">REAPER 7.25 ou plus récent</text:span> (<text:a xlink:type="simple" xlink:href="https://www.reaper.fm/download.php" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Definition">https://www.reaper.fm/download.php</text:span></text:a>). CMGS n’a besoin d’aucune extension de REAPER. Au premier lancement, vérifiez que votre carte son est reconnue (<text:span text:style-name="T2">Options ▷ Preferences… ▷ Audio ▷ Device</text:span>) et choisissez la fréquence d’échantillonnage et la taille des blocs.</text:p>
   <text:p text:style-name="Text_20_body">Certains réglages de REAPER sont indispensables au bon fonctionnement de CMGS :</text:p>
   <table:table table:name="Table5" table:style-name="Table5">
    <table:table-column table:style-name="Table5.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table5.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Réglage (<text:span text:style-name="T2">Options ▷ Preferences…</text:span>)</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table5.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Valeur</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table5.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Raison</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T2">Audio</text:span> ▷ les deux options <text:span text:style-name="T2">Close audio device when stopped…</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">décochées</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sinon les plug-ins cessent de travailler quand REAPER est à l’arrêt ou en arrière-plan</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T2">Audio ▷ Playback</text:span> ▷ <text:span text:style-name="T2">Run FX when stopped</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">cochée</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les plug-ins doivent travailler même quand REAPER ne lit rien</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T2">General</text:span> ▷ <text:span text:style-name="T2">Maximum undo memory use</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">l’état du Game Master est volumineux : REAPER perdrait beaucoup de temps à le sauvegarder pour ses « undo »</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="P8">MIDI Devices</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T2">Enable input</text:span> et <text:span text:style-name="T2">Enable input for control messages</text:span> pour chaque contrôleur utilisé</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">pour piloter les plug-ins depuis des contrôleurs MIDI</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="récupérer-cmgs"/><text:bookmark-start text:name="__RefHeading___Toc986_3791693507"/>Récupérer CMGS<text:bookmark-end text:name="récupérer-cmgs"/><text:bookmark-end text:name="__RefHeading___Toc986_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">CMGS est distribué sur <text:a xlink:type="simple" xlink:href="https://github.com/jack461/CMGS" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Definition">https://github.com/jack461/CMGS</text:span></text:a>. Cliquez sur le bouton vert <text:span text:style-name="T1">Code</text:span>, puis sur <text:span text:style-name="T1">Download ZIP</text:span>, et décompressez <text:span text:style-name="Source_5f_Text">CMGS-main.zip</text:span> où vous voulez (on peut aussi faire un <text:span text:style-name="Source_5f_Text">git clone</text:span> du dépôt). Ne placez pas ce dossier lui-même dans le dossier des ressources de REAPER : on n’en copie que trois éléments.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="mettre-cmgs-en-place"/><text:bookmark-start text:name="__RefHeading___Toc988_3791693507"/>Mettre CMGS en place<text:bookmark-end text:name="mettre-cmgs-en-place"/><text:bookmark-end text:name="__RefHeading___Toc988_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Ouvrez le dossier des ressources de REAPER (<text:span text:style-name="T2">Options ▷ Show REAPER resource path in explorer/finder</text:span>) et copiez-y <text:span text:style-name="T4">(ou déplacer les répertoires) </text:span>:</text:p>
   <table:table table:name="Table6" table:style-name="Table6">
    <table:table-column table:style-name="Table6.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table6.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Depuis le dossier de CMGS</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table6.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Vers le dossier des ressources de REAPER</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table6.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-effects/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Effects/CMGS-effects/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les plug-ins, et leurs bibliothèques dans <text:span text:style-name="Source_5f_Text">CMGS-libs/</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-data/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Data/CMGS-data/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les données lues par les plug-ins : thèmes de l’interface, configurations de Diffusion-3</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-auxiliary.eel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Scripts/CMGS-auxiliary.eel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le script auxiliaire</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="T1">Gardez ces noms</text:span> : les plug-ins cherchent ces dossiers sous ces noms, et les projets de <text:soft-page-break/>REAPER désignent les plug-ins sous la forme <text:span text:style-name="Source_5f_Text">CMGS-effects/GamePlayer.jsfx</text:span>. Les plug-ins apparaissent alors dans le navigateur d’effets de REAPER, sous <text:span text:style-name="T2">JS</text:span>, dans le dossier <text:span text:style-name="Source_5f_Text">CMGS-effects</text:span>.</text:p>
   <text:p text:style-name="Text_20_body">Facultativement, copiez aussi <text:span text:style-name="Source_5f_Text">CMGS-scripts/</text:span> dans <text:span text:style-name="Source_5f_Text">Data/</text:span>, à côté de <text:span text:style-name="Source_5f_Text">CMGS-data</text:span> : les plug-ins pourront alors ouvrir un script par un nom tel que <text:span text:style-name="Source_5f_Text">CMGS-scripts/Algorithms/Matrix-Metal.mSL</text:span>.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="charger-le-script-auxiliaire"/><text:bookmark-start text:name="__RefHeading___Toc990_3791693507"/>Charger le script auxiliaire<text:bookmark-end text:name="charger-le-script-auxiliaire"/><text:bookmark-end text:name="__RefHeading___Toc990_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Une fois pour toutes :</text:p>
   <text:list text:style-name="L6">
    <text:list-item>
     <text:p text:style-name="P9">ouvrez la liste des actions (<text:span text:style-name="T2">Actions ▷ Show action list…</text:span>) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9">cliquez sur <text:span text:style-name="T2">New action…</text:span> ▷ <text:span text:style-name="T2">Load ReaScript…</text:span> et choisissez <text:span text:style-name="Source_5f_Text">Scripts/CMGS-auxiliary.eel</text:span> ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9">l’action « Script: CMGS-auxiliary.eel » apparaît dans la liste.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">À chaque session de REAPER, lancez cette action (sélectionnez-la, puis <text:span text:style-name="T2">Run</text:span>). Le script écrit dans la console de REAPER un premier message, « GMA … started », suivi de la date, et reste actif jusqu’à la fermeture de REAPER. Pour l’arrêter avant, choisissez <text:span text:style-name="T2">Actions ▷ Running script: CMGS-auxiliary.eel</text:span>, puis <text:span text:style-name="T2">Terminate instances</text:span>.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="mettre-à-jour-cmgs"/><text:bookmark-start text:name="__RefHeading___Toc992_3791693507"/>Mettre à jour CMGS<text:bookmark-end text:name="mettre-à-jour-cmgs"/><text:bookmark-end text:name="__RefHeading___Toc992_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Remplacez <text:span text:style-name="Source_5f_Text">Effects/CMGS-effects</text:span>, <text:span text:style-name="Source_5f_Text">Data/CMGS-data</text:span> et <text:span text:style-name="Source_5f_Text">Scripts/CMGS-auxiliary.eel</text:span> par les nouvelles versions. Vos projets continuent de fonctionner : ils désignent les plug-ins par leur nom. Les préréglages enregistrés dans REAPER (dossier <text:span text:style-name="Source_5f_Text">presets</text:span>, fichiers <text:span text:style-name="Source_5f_Text">js-CMGS-effects_…_jsfx.ini</text:span>) sont conservés.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="organisation-dun-projet"/><text:bookmark-start text:name="__RefHeading___Toc994_3791693507"/>Organisation d’un projet<text:bookmark-end text:name="organisation-dun-projet"/><text:bookmark-end text:name="__RefHeading___Toc994_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un projet de REAPER qui utilise le Game Master est un dossier qui contient, outre le fichier <text:span text:style-name="Source_5f_Text">.RPP</text:span> :</text:p>
   <table:table table:name="Table7" table:style-name="Table7">
    <table:table-column table:style-name="Table7.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table7.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Dossier du projet</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table7.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Data/Scripts/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les scripts mSL du projet, dont le <text:span text:style-name="T1">Profile</text:span> <text:span text:style-name="Source_5f_Text">GM_mSL_ini.mSL</text:span>, qui décrit toute la configuration du Game Master</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Data/WAVES/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les clips, nommés <text:span text:style-name="Source_5f_Text">clip1NNNN.ext</text:span> (<text:span text:style-name="Source_5f_Text">NNNN</text:span> de <text:span text:style-name="Source_5f_Text">0000</text:span> à <text:span text:style-name="Source_5f_Text">9999</text:span>, <text:span text:style-name="Source_5f_Text">ext</text:span> : <text:span text:style-name="Source_5f_Text">wav</text:span>, <text:span text:style-name="Source_5f_Text">aif</text:span>, <text:span text:style-name="Source_5f_Text">flac</text:span>, <text:span text:style-name="Source_5f_Text">mp3</text:span>…)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Data/Sounds/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">d’autres sons, de noms quelconques, que l’on associe à des numéros de clips par glisser-déposer</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Le Game Master doit connaître le dossier du projet : on le lui indique en faisant glisser le fichier <text:span text:style-name="Source_5f_Text">.RPP</text:span> dans sa fenêtre, puis en enregistrant le projet. Il faut refaire cette opération après avoir déplacé ou copié le projet, en particulier sur une autre machine. Les sons du dossier <text:span text:style-name="Source_5f_Text">Data</text:span> suivent le projet : un projet ainsi organisé se transporte d’une machine à l’autre, pourvu que CMGS y soit installé.</text:p>
   <text:p text:style-name="Text_20_body">Interstys et Diffusion-3 ont leurs propres fichiers (patchs, sessions, configurations), décrits dans leurs manuels.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="pour-les-développeurs"/><text:bookmark-start text:name="__RefHeading___Toc996_3791693507"/><text:soft-page-break/>Pour les développeurs<text:bookmark-end text:name="pour-les-développeurs"/><text:bookmark-end text:name="__RefHeading___Toc996_3791693507"/></text:h>
   <text:p text:style-name="First_20_paragraph">Au lieu de copier les dossiers <text:span text:style-name="T5">ou de les déplacer</text:span>, on peut créer, dans le dossier des ressources de REAPER, des liens symboliques vers un clone du dépôt (<text:span text:style-name="Source_5f_Text">ln -s</text:span> sous macOS et Linux, <text:span text:style-name="Source_5f_Text">mklink /D</text:span> sous Windows) : REAPER voit alors directement chaque modification des sources. Les alias du Finder de macOS ne fonctionnent pas. Le script <text:span text:style-name="Source_5f_Text">CMGS-auxiliary.eel</text:span> est généré : on modifie <text:span text:style-name="Source_5f_Text">CMGS-effects/CMGS-libs/CMGS-auxiliary-src.eel</text:span>, puis on lance <text:span text:style-name="Source_5f_Text">python3 -I CMGS-aux/tools/make_auxiliary.py</text:span>.</text:p>
   <text:p text:style-name="Text_20_body">Le dépôt est organisé ainsi :</text:p>
   <table:table table:name="Table8" table:style-name="Table8">
    <table:table-column table:style-name="Table8.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table8.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Chemin</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table8.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-effects/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les plug-ins (<text:span text:style-name="Source_5f_Text">.jsfx</text:span>) ; <text:span text:style-name="Source_5f_Text">CMGS-libs/</text:span> contient les bibliothèques communes et le code des gros plug-ins (<text:span text:style-name="Source_5f_Text">.jsfx-inc</text:span>)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-data/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les données lues à l’exécution : thèmes, configurations de Diffusion-3</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-auxiliary.eel</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le script auxiliaire (généré)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-scripts/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les scripts mSL : algorithmes, presets, exemples, tests</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-docs/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les manuels</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">CMGS-aux/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table8.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">outils de développement (Python) et archives</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="part"><text:bookmark-start text:name="__RefHeading___Toc1022_3791693507"/>Partie II — L’interface commune<text:bookmark-end text:name="__RefHeading___Toc1022_3791693507"/></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1105_2852353392"/><text:bookmark-start text:name="fenêtre-onglets-panneaux-et-modules"/>Fenêtre, onglets, panneaux et modules<text:bookmark-end text:name="__RefHeading___Toc1105_2852353392"/><text:bookmark-end text:name="fenêtre-onglets-panneaux-et-modules"/></text:h>
   <text:p text:style-name="First_20_paragraph">Les plug-ins de CMGS partagent une même organisation de leur fenêtre. Ce chapitre la décrit pour tous ; les modules propres à chaque plug-in sont décrits dans son manuel.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1107_2852353392"/><text:bookmark-start text:name="la-fenêtre-dun-plug-in"/>La fenêtre d’un plug-in<text:bookmark-end text:name="__RefHeading___Toc1107_2852353392"/><text:bookmark-end text:name="la-fenêtre-dun-plug-in"/></text:h>
   <text:p text:style-name="First_20_paragraph">En haut de la fenêtre, une première barre appartient à REAPER : nom du préréglage courant, flèches pour passer d’un préréglage à l’autre, bouton <text:span text:style-name="T1">+</text:span> (enregistrer ou charger un préréglage), boutons <text:span text:style-name="T1">Param</text:span>, <text:span text:style-name="T1">Edit…</text:span> et <text:span text:style-name="T1">MIDI</text:span>, dosage <text:span text:style-name="T2">dry/wet</text:span>, et case d’activation du plug-in. Le reste de la fenêtre appartient au plug-in : la <text:span text:style-name="T1">barre d’onglets</text:span>, puis un à quatre <text:span text:style-name="T1">panneaux</text:span>, côte à côte, qui contiennent les <text:span text:style-name="T1">modules</text:span>.</text:p>
   <text:p text:style-name="Text_20_body">La fenêtre se redimensionne librement. Si elle devient trop étroite pour le nombre de panneaux choisi, le plug-in en affiche provisoirement moins (de 4 à 3, puis à 2).</text:p>
   <text:p text:style-name="Text_20_body">Les plug-ins de CMGS continuent de travailler lorsque leur fenêtre est fermée : un script mSL lancé poursuit son exécution, un Game Master en <text:span text:style-name="T2">auto-play</text:span> continue de jouer.</text:p>
   <text:p text:style-name="P10">Dans tous les plug-ins, le « menu des modules » ou « menu studio », que l’on obtient par « Shift-Clic-Droit », permet de reconfigurer les onglets, panneaux, modules, ainsi que le « look &amp; feel » de l’interface utilisateur.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1109_2852353392"/><text:bookmark-start text:name="les-onglets"/>Les onglets<text:bookmark-end text:name="__RefHeading___Toc1109_2852353392"/><text:bookmark-end text:name="les-onglets"/></text:h>
   <text:p text:style-name="First_20_paragraph">La barre d’onglets, en haut de la fenêtre, permet de passer d’un écran à l’autre : on clique sur un onglet, ou l’on utilise les touches <text:span text:style-name="T1">Tab</text:span> (onglet suivant) et <text:span text:style-name="T1">Shift + Tab</text:span> (onglet précédent). Chaque onglet a sa propre disposition de panneaux et de modules. Le nombre d’onglets dépend du plug-in (de 5 à 16) ; ils s’appellent par défaut « Tab1 », « Tab2 », etc.</text:p>
   <text:p text:style-name="Text_20_body">On renomme l’onglet courant par le menu des modules (<text:span text:style-name="T2">Tabs Management ▷ Rename tab…</text:span>, voir plus bas). Dans FilePlayer, ScriptMaster et Diffusion-3, un clic droit dans la barre d’onglets propose aussi <text:span text:style-name="T2">Rename tab…</text:span> ; dans le Game Master et Interstys, il ouvre le choix du thème. Dans le Game Master, la droite de la barre d’onglets affiche en outre un ruban coloré, qui reflète l’activité des lecteurs.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1111_2852353392"/><text:bookmark-start text:name="les-panneaux"/>Les panneaux<text:bookmark-end text:name="__RefHeading___Toc1111_2852353392"/><text:bookmark-end text:name="les-panneaux"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un onglet est partagé en <text:span text:style-name="T1">un à quatre panneaux</text:span> verticaux. Avec la souris dans un panneau, <text:span text:style-name="T1">Shift + ◀</text:span> et <text:span text:style-name="T1">Shift + ▶</text:span> déplacent sa limite gauche ou droite, au détriment du panneau voisin. Le sous-menu <text:span text:style-name="T2">Panes Arrangement</text:span> du menu des modules permet :</text:p>
   <text:list text:style-name="L7">
    <text:list-item>
     <text:p text:style-name="P11">de choisir le nombre de panneaux (<text:span text:style-name="T2">1 pane</text:span> à <text:span text:style-name="T2">4 panes</text:span>) et de leur redonner des largeurs égales (<text:span text:style-name="T2">Reset Sizes</text:span>) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P11">de déplacer le panneau courant vers la gauche ou la droite (<text:span text:style-name="T2">Move pane left / right</text:span>), ou de décaler tous les panneaux (<text:span text:style-name="T2">Shift panes left / right</text:span>) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P11">de copier le contenu d’un panneau et de le coller dans un autre, éventuellement dans un autre onglet (<text:span text:style-name="T2">Copy pane</text:span>, <text:span text:style-name="T2">Paste pane</text:span>) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P11">de vider le panneau courant (<text:span text:style-name="T2">Clear Pane</text:span>), l’onglet courant (<text:span text:style-name="T2">Clear Tab</text:span>), ou tous les onglets (<text:span text:style-name="T2">Clear All Tabs</text:span>). <text:span text:style-name="T6">Ces commandes « Clear » ne détruisent aucune donnée, mais se contentent de supprimer l’affichage des modules. Rien n’est perdu, et ces moules peuvent être réaffichés à tout moment au moyen du menu « Studio ».</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1113_2852353392"/><text:bookmark-start text:name="les-modules"/>Les modules<text:bookmark-end text:name="__RefHeading___Toc1113_2852353392"/><text:bookmark-end text:name="les-modules"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un <text:span text:style-name="T1">module</text:span> est un cadre qui remplit une fonction : afficher le journal, régler des paramètres, <text:soft-page-break/>piloter un lecteur, éditer une courbe… Un panneau contient un ou plusieurs modules, empilés de haut en bas. Un même module peut être affiché dans plusieurs panneaux, ou dans plusieurs onglets ; ses réglages (par exemple la liste des paramètres affichés) lui restent attachés, même lorsqu’il n’est plus affiché nulle part.</text:p>
   <text:p text:style-name="Text_20_body">On choisit les modules par le <text:span text:style-name="T1">menu des modules</text:span>, qui s’ouvre :</text:p>
   <text:list text:style-name="L8">
    <text:list-item>
     <text:p text:style-name="P12">par <text:span text:style-name="T1">Shift + clic droit</text:span>, n’importe où dans un panneau ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P12">par un <text:span text:style-name="T1">simple clic droit</text:span> dans une zone du panneau où il n’y a pas de module.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Ce menu comporte :</text:p>
   <table:table table:name="Table1_1" table:style-name="Table1_5f_1">
    <table:table-column table:style-name="Table1_5f_1.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Rubrique</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">(nom du module)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">en tête, le module sous la souris : le choisir le retire du panneau</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="P8">Modules</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">la liste alphabétique des modules du plug-in ; ceux qui sont déjà dans le panneau sont cochés ; un module choisi s’ajoute en bas du panneau</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="P8">Modules Disposition</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">déplacer le module courant vers le haut, le bas, tout en haut, tout en bas, dans le panneau de gauche ou de droite ; le copier, puis le coller dans un autre panneau</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="P8">Panes Arrangement</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les panneaux : nombre, largeurs, déplacement, copie, effacement (voir plus haut)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="P8">Tabs Management</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">décaler tous les onglets (<text:span text:style-name="T2">Shift tabs left / right</text:span>), passer l’onglet en affichage « Live », renommer l’onglet</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="P8">Theme</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le thème des couleurs, la taille d’affichage (<text:span text:style-name="T2">Display size</text:span>) et le style « doux » (<text:span text:style-name="T2">Soft style</text:span>)</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1115_2852353392"/><text:bookmark-start text:name="apparence"/>Apparence<text:bookmark-end text:name="__RefHeading___Toc1115_2852353392"/><text:bookmark-end text:name="apparence"/></text:h>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="T1">Thèmes.</text:span> Douze thèmes de couleurs sont proposés : <text:span text:style-name="T2">Default</text:span>, <text:span text:style-name="T2">Black</text:span>, <text:span text:style-name="T2">Tron</text:span>, <text:span text:style-name="T2">Light Cyan</text:span>, <text:span text:style-name="T2">Orange</text:span>, <text:span text:style-name="T2">Blue</text:span>, <text:span text:style-name="T2">Dark Cyan</text:span>, <text:span text:style-name="T2">Dark Green</text:span>, <text:span text:style-name="T2">Dark Red</text:span>, <text:span text:style-name="T2">Light Amber</text:span>, <text:span text:style-name="T2">Neon Green</text:span> et <text:span text:style-name="T2">Light Magenta</text:span>. Les images des thèmes sont lues dans <text:span text:style-name="Source_5f_Text">Data/CMGS-data/themes</text:span>.</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T1">Taille d’affichage.</text:span> Chaque plug-in peut être affiché de <text:span text:style-name="T1">50 % à 200 %</text:span> (50, 60, 70, 80, 90, 100, 120, 150 et 200 %), par le sous-menu <text:span text:style-name="T2">Theme ▷ Display size</text:span> ou au clavier : <text:span text:style-name="T1">Cmd + </text:span><text:span text:style-name="Source_5f_Text">+</text:span> (ou <text:span text:style-name="T1">Cmd + </text:span><text:span text:style-name="Source_5f_Text">=</text:span>) agrandit, <text:span text:style-name="T1">Cmd + </text:span><text:span text:style-name="Source_5f_Text">-</text:span> réduit, <text:span text:style-name="T1">Cmd + </text:span><text:span text:style-name="Source_5f_Text">0</text:span> revient à 100 %. La taille est propre à chaque plug-in et enregistrée avec lui.</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T1">Style doux.</text:span> L’option <text:span text:style-name="T2">Theme ▷ Soft style</text:span> adoucit le dessin des cellules et escamote la barre d’onglets : celle-ci apparaît quand la souris s’approche du haut de la fenêtre, et disparaît une dizaine de secondes après que la souris l’a quittée.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1117_2852353392"/><text:bookmark-start text:name="laffichage-live"/>L’affichage « Live »<text:bookmark-end text:name="__RefHeading___Toc1117_2852353392"/><text:bookmark-end text:name="laffichage-live"/></text:h>
   <text:p text:style-name="First_20_paragraph">L’option <text:span text:style-name="T2">Tabs Management ▷ Live display</text:span> remplace les panneaux de l’onglet courant par l’écran « Live » du plug-in, destiné au concert : dans Diffusion-3, par exemple, un grand écran de boîtes d’affichage pilotées par l’APCmini (voir son manuel). Dans un onglet « Live », le menu des modules ne s’ouvre que par <text:span text:style-name="T1">Shift + clic droit</text:span> ; on y décoche <text:span text:style-name="T2">Live </text:span><text:soft-page-break/><text:span text:style-name="T2">display</text:span> pour revenir aux panneaux.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1119_2852353392"/><text:bookmark-start text:name="pads-sliders-afficheurs-et-menus"/>Pads, sliders, afficheurs et menus<text:bookmark-end text:name="__RefHeading___Toc1119_2852353392"/><text:bookmark-end text:name="pads-sliders-afficheurs-et-menus"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1121_2852353392"/><text:bookmark-start text:name="les-pads"/>Les pads<text:bookmark-end text:name="__RefHeading___Toc1121_2852353392"/><text:bookmark-end text:name="les-pads"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un <text:span text:style-name="T1">pad</text:span> est une grille de <text:span text:style-name="T1">cellules</text:span> colorées, en lignes et en colonnes. Une cellule peut afficher une information, porter une valeur réglable, déclencher une action, ou ouvrir un menu ; sa couleur indique souvent un état (actif, en erreur, sélectionné…).</text:p>
   <text:p text:style-name="Text_20_body">Les plug-ins récents (Diffusion-3, Interstys) suivent les conventions suivantes, que tous les plug-ins rejoignent progressivement :</text:p>
   <table:table table:name="Table2_1" table:style-name="Table2_5f_1">
    <table:table-column table:style-name="Table2_5f_1.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Geste</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">clic droit</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">ouvre le menu de la cellule</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">clic gauche</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">l’action simple et courante de la cellule (basculer, passer à l’élément suivant, démarrer ou arrêter), ou une remise à zéro</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">clic gauche sur une cellule « Action »</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">ouvre aussi le menu (une telle cellule n’a pas d’action immédiate)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">glisser avec le bouton gauche sur une cellule de valeur</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">règle la valeur, comme un potentiomètre (voir ci-dessous)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="T6">Shift</text:span> + clic gauche sur une cellule de valeur</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">rétablit la valeur par défaut</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="T1">Cellules de valeur.</text:span> Une cellule qui porte un nombre (un volume, un angle, une durée…) se règle en glissant <text:span text:style-name="T7">(clic-gauche + déplacement de la souris) </text:span>: un déplacement <text:span text:style-name="T1">horizontal</text:span> parcourt toute l’étendue des valeurs, un déplacement <text:span text:style-name="T1">vertical</text:span> fait un réglage fin (dix fois plus fin ; vers le haut, la valeur augmente). Dans la colonne de la cellule, seul le réglage fin agit ; dans sa ligne, hors de cette colonne, seul le réglage grossier ; ailleurs, les deux. Un clic gauche simple, sans glisser, ne change rien.</text:p>
   <text:p text:style-name="Text_20_body">Certains pads du Game Master, plus anciens, ont leurs propres conventions (par exemple clic gauche pour diminuer, clic droit pour augmenter) : elles sont décrites dans son manuel.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1123_2852353392"/><text:bookmark-start text:name="les-éditeurs-de-nombres"/>Les éditeurs de nombres<text:bookmark-end text:name="__RefHeading___Toc1123_2852353392"/><text:bookmark-end text:name="les-éditeurs-de-nombres"/></text:h>
   <text:p text:style-name="First_20_paragraph">Quand la souris est sur une cellule qui porte un numéro (un numéro de configuration, de diffusion, de clip, de mode…), le clavier permet de le modifier. Les touches et les pas varient un peu d’un plug-in à l’autre (le pas dépend de la grandeur éditée) ; voici les plus courantes :</text:p>
   <table:table table:name="Table3_1" table:style-name="Table3_5f_1">
    <table:table-column table:style-name="Table3_5f_1.A"/>
    <table:table-column table:style-name="Table3_5f_1.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Touches</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">0</text:span> à <text:span text:style-name="Source_5f_Text">9</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">ajoutent un chiffre à droite du nombre</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">%</text:span>, <text:span text:style-name="Source_5f_Text">z</text:span>, <text:span text:style-name="Source_5f_Text">Origine</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">remettent le nombre à 0</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">;</text:span> ou <text:span text:style-name="Source_5f_Text">.</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">ajoute 1</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">,</text:span> ou <text:span text:style-name="Source_5f_Text">?</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">retranche 1</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">+</text:span> ou <text:span text:style-name="Source_5f_Text">=</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">augmente d’un grand pas</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">:</text:span> ou <text:span text:style-name="Source_5f_Text">/</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">diminue d’un grand pas</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">n</text:span>, <text:span text:style-name="Source_5f_Text">▶</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">élément suivant</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">p</text:span>, <text:span text:style-name="Source_5f_Text">b</text:span>, <text:span text:style-name="Source_5f_Text">◀</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">élément précédent</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">▼</text:span> et <text:span text:style-name="Source_5f_Text">▲</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">avancent ou reculent d’un pas plus grand</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Page ▼</text:span> et <text:span text:style-name="Source_5f_Text">Page ▲</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">avancent ou reculent d’un pas encore plus grand</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph"><text:soft-page-break/>Lorsque le nombre désigne un objet (un clip, un mode, une configuration), le plug-in passe souvent directement à l’objet suivant ou précédent <text:span text:style-name="T1">qui existe</text:span>, en sautant les numéros inutilisés. La liste exacte des touches de chaque éditeur figure dans <text:span text:style-name="Source_5f_Text">CMGS-Keys.md</text:span> (section « Éditeurs de nombres »).</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1125_2852353392"/><text:bookmark-start text:name="les-sliders"/>Les sliders<text:bookmark-end text:name="__RefHeading___Toc1125_2852353392"/><text:bookmark-end text:name="les-sliders"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un <text:span text:style-name="T1">slider</text:span> règle un paramètre entre deux bornes. Il affiche, de gauche à droite, le nom du paramètre et sa valeur, puis une barre et sa poignée.</text:p>
   <table:table table:name="Table4_1" table:style-name="Table4_5f_1">
    <table:table-column table:style-name="Table4_5f_1.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Geste</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">appui sur la poignée</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">garde la valeur ; on peut ensuite glisser</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">appui ailleurs sur la barre</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">amène la valeur à cet endroit</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">glisser dans la barre</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">réglage grossier : la poignée suit la souris</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">glisser au-dessus ou au-dessous de la barre</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">réglage fin (dix fois plus fin ; vers le haut, la valeur augmente)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">double clic, ou Ctrl + Shift + clic</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">rétablit la valeur par défaut</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Le réglage est relatif : on peut sortir de la barre en cours de geste sans que la valeur saute.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1127_2852353392"/><text:bookmark-start text:name="les-afficheurs"/>Les afficheurs<text:bookmark-end text:name="__RefHeading___Toc1127_2852353392"/><text:bookmark-end text:name="les-afficheurs"/></text:h>
   <text:p text:style-name="First_20_paragraph">Les <text:span text:style-name="T1">afficheurs</text:span> présentent des valeurs et leurs étiquettes : version, compteurs, état d’un lecteur, statistiques de mémoire… Dans certains modules (par exemple les modules <text:span text:style-name="T2">Parameters</text:span> du Game Master), l’utilisateur choisit lui-même les sliders ou les afficheurs présentés : un clic droit sur l’un d’eux, ou sur la ligne « (unset entry) », ouvre un menu qui permet d’en ajouter, d’en remplacer, d’en déplacer ou d’en retirer.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1129_2852353392"/><text:bookmark-start text:name="les-menus"/>Les menus<text:bookmark-end text:name="__RefHeading___Toc1129_2852353392"/><text:bookmark-end text:name="les-menus"/></text:h>
   <text:p text:style-name="First_20_paragraph">Les menus de CMGS sont des menus contextuels : ils s’ouvrent <text:span text:style-name="T1">au relâchement</text:span> du bouton droit, et l’on choisit une entrée avec l’un ou l’autre bouton. Une coche marque les choix en cours (le thème, le nombre de panneaux, les modules présents…). Un clic hors du menu, ou la touche Échap, le referme sans rien choisir.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1131_2852353392"/><text:bookmark-start text:name="le-clavier"/>Le clavier<text:bookmark-end text:name="__RefHeading___Toc1131_2852353392"/><text:bookmark-end text:name="le-clavier"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1133_2852353392"/><text:bookmark-start text:name="principes"/>Principes<text:bookmark-end text:name="__RefHeading___Toc1133_2852353392"/><text:bookmark-end text:name="principes"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un plug-in reçoit les touches du clavier lorsque sa fenêtre est active (on a cliqué dedans) et que la souris s’y trouve. Chaque touche n’est utilisée qu’une fois : elle est proposée successivement, dans l’ordre suivant, aux éléments du plug-in, et le premier qui la reconnaît la prend.</text:p>
   <text:list text:style-name="L9">
    <text:list-item>
     <text:p text:style-name="P13">La <text:span text:style-name="T1">taille d’affichage</text:span> : Cmd + <text:span text:style-name="Source_5f_Text">+</text:span>, <text:span text:style-name="Source_5f_Text">=</text:span>, <text:span text:style-name="Source_5f_Text">-</text:span> ou <text:span text:style-name="Source_5f_Text">0</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">Le <text:span text:style-name="T1">module sous la souris</text:span>, puis ses pads (et leurs éditeurs de nombres).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">Le <text:span text:style-name="T1">panneau</text:span> : Shift + ◀ et Shift + ▶.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">L’<text:span text:style-name="T1">onglet</text:span> : Tab et Shift + Tab ; dans le Game Master, les commandes de concert (voir son manuel).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">Les <text:span text:style-name="T1">commandes du plug-in</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">Les <text:span text:style-name="T1">commandes système</text:span> (sauf dans le Game Master) ; dans le Game Master, les raccourcis définis par l’utilisateur (module <text:span text:style-name="T2">Links Manager</text:span>), puis le jeu au clavier du <text:span text:style-name="T2">Studio Play Pad</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Il en découle qu’un module peut, lorsque la souris est sur lui, utiliser pour lui-même une touche qui a ailleurs un autre sens. La liste complète des touches de chaque plug-in, module par module, avec ces recouvrements, est dans le fichier <text:span text:style-name="Source_5f_Text">CMGS-docs/CMGS-Keys.md</text:span>, produit à partir du code.</text:p>
   <text:p text:style-name="Text_20_body">Par convention, les <text:span text:style-name="T1">minuscules</text:span> commandent des actions, les <text:span text:style-name="T1">majuscules</text:span> des affichages.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1135_2852353392"/><text:bookmark-start text:name="les-touches-communes"/>Les touches communes<text:bookmark-end text:name="__RefHeading___Toc1135_2852353392"/><text:bookmark-end text:name="les-touches-communes"/></text:h>
   <table:table table:name="Table5_1" table:style-name="Table5_5f_1">
    <table:table-column table:style-name="Table5_5f_1.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Touche</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Plug-ins</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Tab, Shift + Tab</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">onglet suivant, précédent</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Cmd + <text:span text:style-name="Source_5f_Text">+</text:span> ou <text:span text:style-name="Source_5f_Text">=</text:span>, Cmd + <text:span text:style-name="Source_5f_Text">-</text:span>, Cmd + <text:span text:style-name="Source_5f_Text">0</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">taille d’affichage : agrandir, réduire, 100 %</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Shift + ◀, Shift + ▶</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">déplacer la limite du panneau</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">L</text:span>, <text:span text:style-name="Source_5f_Text">M</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">afficher le journal, la mémoire</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">FilePlayer, ScriptMaster</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">S</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">afficher ou masquer les sliders de REAPER</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Diffusion-3, Interstys</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">U</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">afficher ou masquer l’interface</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Les <text:span text:style-name="T1">commandes système</text:span> servent surtout à la mise au point ; elles sont les mêmes dans FilePlayer, ScriptMaster, Diffusion-3 et Interstys (le Game Master utilise ces touches pour ses commandes de concert) :</text:p>
   <table:table table:name="Table6_1" table:style-name="Table6_5f_1">
    <table:table-column table:style-name="Table6_5f_1.A"/>
    <table:table-column table:style-name="Table6_5f_1.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Touche</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">g</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">lance le ramasse-miettes (<text:span text:style-name="T2">garbage collector</text:span>) de la mémoire dynamique</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">k</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">arrête tous les scripts mSL en cours (<text:span text:style-name="T2">kill</text:span>)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">m</text:span>, <text:span text:style-name="Source_5f_Text">n</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">parcourt la mémoire dynamique et en affiche l’état (deux modes)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">c</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">active ou désactive le recyclage de la mémoire dynamique</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">l</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">change la limite d’affichage de la mémoire</text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">r</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">relance le premier processus suspendu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">t</text:span>, <text:span text:style-name="Source_5f_Text">o</text:span>, <text:span text:style-name="Source_5f_Text">s</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table6_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">séries de tests mSL : marche ou arrêt, un seul passage, arrêt</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1137_2852353392"/><text:bookmark-start text:name="les-modules-communs"/>Les modules communs<text:bookmark-end text:name="__RefHeading___Toc1137_2852353392"/><text:bookmark-end text:name="les-modules-communs"/></text:h>
   <text:p text:style-name="First_20_paragraph">Plusieurs modules se retrouvent, sous le même nom et avec le même fonctionnement, dans plusieurs plug-ins :</text:p>
