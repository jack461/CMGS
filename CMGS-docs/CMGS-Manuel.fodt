     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Diffusion-3</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Vue 3D : la bibliothèque des trajectoires est pleine (128) : la trajectoire n’est pas gardée.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
