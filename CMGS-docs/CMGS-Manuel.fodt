      </table:table-cell>
      <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Exemple</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Valeur</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
