     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Curve » : les « x » des points doivent aller de 0 à 1 sans décroître.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2795</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
