     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2492</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Numéro de source attendu, de 1 à 255 (source).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2493</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">« : » attendu après le numéro (source).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2494</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Numéro de point attendu, de 1 à 128, suivi de « &lt; » (source ; ou plus de 128 points).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2495</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Coordonnée attendue, entre −1 et 1 (source).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2496</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">« , » ou « ; » attendu (source).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2497</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Space (préset) : la source n’est pas déclarée.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2498</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Space (préset) : un numéro de source est attendu.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2501</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Conf Editor : la configuration n’est pas définie (chargement, Add, Subtract).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2502</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Conf Editor : un numéro de configuration entre 1 et 4094 est attendu (Save as, Rename).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2503</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Conf Editor : (plus utilisé depuis le 2026-11-21 : une matrice vide est enregistrée comme une configuration sans source).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2504</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Conf Editor : plus de mémoire pour la configuration.</text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2505</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Conf Editor : le ring est plein (64 configurations) : en retirer une d’abord.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2506</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Conf Editor : plus de numéro libre pour une nouvelle configuration.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2507</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Espaces</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Conf Editor : un facteur entre 0.1 et 10 (ou entre -20 dB et +20 dB) est attendu (cellule 3, Other value).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2601</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Numéro de lecteur (Reader) invalide.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2602</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Numéro d’enregistreur (Writer) invalide.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2603</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lecteur non défini, ou pas en mode délai.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2604</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Enregistreur non défini, ou sans ligne.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2605</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Numéro de lecteur invalide.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2606</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lecteur non défini, ou mode inconnu.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2607</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Numéro de ligne invalide.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2608</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">L’entrée de la ligne n’est pas une ligne valide.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2609</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Action inconnue sur une ligne (ou « Create » sur une ligne existante).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2610</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Ligne : mémoire insuffisante (affiché « No memory » dans le pad de la ligne).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2701</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Effet : nombre de canaux incorrect.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2702</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Effet : sortie incorrecte (câble propre, Out ou bus).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2703</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Effet : source incorrecte.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2704</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Effet : une source recouvre la sortie.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2705</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Effet : pas de source (le déclencheur d’un Random, les entrées A et B d’un Math ou d’un Ring sont facultatifs).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2706</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Effet : type sans traitement (None, ou inconnu).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2716</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Les paramètres d’Interstys dépassent sa plage de numéros.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2717</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Les clés des effets dépassent la taille des tableaux d’un bloc (erreur interne).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2718</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : trop de clés.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2720</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Export : texte trop long : rien n’est écrit.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2721</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Export : pas de nom.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2722</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Export : le script auxiliaire n’est pas lancé (ou il faut le relancer).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2723</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Export : cet élément n’existe pas.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2724</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Export : le fichier ne peut pas être écrit.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2725</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Control n value v » : la valeur est attendue.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2726</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Export » : « Patch » ou « Session » attendu.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2727</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Tab » : un nom est attendu.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2728</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Dump View » : ce module n’a pas de vue.</text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2730</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : cible attendue (Ctl, Reader, Writer, Effect ou LEDs).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2731</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : « min » ou « max » avant la cible.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2732</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : « cc m » ou « note m », ou la cible, attendu.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2733</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : « min » et « max » attendus (valeurs de la clé pour 0 et pour 127).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2734</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : cette clé ne peut pas être liée (ce n’est pas un nombre).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2735</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : l’élément visé n’existe pas.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2736</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : cette clé n’a pas de sens pour ce type d’effet.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2737</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : loi « Exp » : « min » et « max » doivent être de même signe et non nuls.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2738</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">« Dump Link » : pas de lien.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2739</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">« Inject » : « cc » ou « note » attendu.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2740</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : la cible est une action : pas de « min » ni de « max ».</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2741</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : options incompatibles (pickup, pas, courbe, vitesse) pour ce mode.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2742</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : « rate » n’est possible que pour un cc (bouton, fader), pas pour une note.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2743</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lien MIDI : une cible Bank (Prev, Next ou n) est dans toutes les banques : pas de « bank n ».</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2750</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : un nom de bloc est attendu (Line, Writer, Reader, Effect, Global, Control, Curve, Algorithm, Instance, Set, Dump, Check, Free, Display, Remove, Clear, Export, Tab…).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2751</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Line », « Writer », « Reader » ou « Effect » attendu.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2752</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : identificateur incorrect (un numéro ou un nom).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2753</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : clé inconnue.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2754</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Check Global » : une action ne peut pas être vérifiée.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2755</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : plus d’élément libre de ce type.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2756</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : ce nom ne désigne pas un élément de ce type.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2757</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : nom déjà utilisé par un autre élément.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2758</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Line » : canaux du lecteur incompatibles avec la ligne.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2759</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Table : « Check » : la valeur ou l’état vérifié ne correspond pas à l’attente.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
