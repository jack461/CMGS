      </office:binary-data>
     </draw:image>
    </draw:frame></text:p>
   <table:table table:name="Table4_1" table:style-name="Table4_5f_1">
    <table:table-column table:style-name="Table4_5f_1.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Geste</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">appui sur la poignée <text:span text:style-name="T14">(clic gauche)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">garde la valeur ; on peut ensuite glisser</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">appui ailleurs sur la barre</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">amène la valeur à cet endroit</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">glisser <text:span text:style-name="T14">horizontalement </text:span>dans la barre</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">réglage grossier : la poignée suit la souris</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">glisser <text:span text:style-name="T15">verticalement </text:span>au-dessus ou au-dessous de la barre</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">réglage fin (dix fois plus fin ; vers le haut, la valeur augmente)</text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">double clic, ou Ctrl + Shift + clic</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">rétablit la valeur par défaut</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4_5f_1.A7" office:value-type="string">
      <text:p text:style-name="P15">clic gauche sur le nom du slider</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4_5f_1.A7" office:value-type="string">
      <text:p text:style-name="P15">Ouvre une fenêtre d’édition de la valeur</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Le réglage est relatif : on peut sortir de la barre en cours de geste sans que la valeur saute.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="les-afficheurs"/><text:bookmark-start text:name="__RefHeading___Toc1127_2852353392"/>Les afficheurs<text:bookmark-end text:name="les-afficheurs"/><text:bookmark-end text:name="__RefHeading___Toc1127_2852353392"/></text:h>
