     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Diffusion-3</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Trajectoire : « , » ou « ; » attendu après un point.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
