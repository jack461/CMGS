     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">caractères</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">&apos;A&apos;</text:span>, <text:span text:style-name="Source_5f_Text">&apos;Game&apos;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le code de 1 à 4 caractères (comme en JSFX)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">symbole</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11_5f_1_5f_1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">`hello</text:span></text:p>
     </table:table-cell>
