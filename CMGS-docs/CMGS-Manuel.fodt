     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">de gauche à droite</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">« ou » logique</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">13</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">? :</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">de droite à gauche</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">condition</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">14</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">=</text:span> <text:span text:style-name="Source_5f_Text">+=</text:span> <text:span text:style-name="Source_5f_Text">-=</text:span> <text:span text:style-name="Source_5f_Text">*=</text:span> <text:span text:style-name="Source_5f_Text">/=</text:span> <text:span text:style-name="Source_5f_Text">%=</text:span> <text:span text:style-name="Source_5f_Text">&amp;=</text:span> |=</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">de droite à gauche</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">affectations</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">15</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">;</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">de gauche à droite</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">suite d’instructions</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">16</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">,</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">de gauche à droite</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">suite de valeurs</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Deux différences avec JSFX :</text:p>
   <text:list text:style-name="L13">
    <text:list-item>
     <text:p text:style-name="P18"><text:span text:style-name="Source_5f_Text">&amp;&amp;</text:span> et <text:span text:style-name="Source_5f_Text">||</text:span> ont la sémantique du langage C : <text:span text:style-name="Source_5f_Text">2 &amp;&amp; 3</text:span> vaut 3 (et non 1). Dans un test, le sens est le même ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P18">les affectations sont <text:span text:style-name="T1">moins prioritaires</text:span> que la condition <text:span text:style-name="Source_5f_Text">? :</text:span> : il faut parfois des parenthèses, comme dans <text:span text:style-name="Source_5f_Text">(x &gt; 0) ? (y = 1) : (y = 2);</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1703_3118163005"/><text:bookmark-start text:name="instructions-de-contrôle"/><text:soft-page-break/>Instructions de contrôle<text:bookmark-end text:name="__RefHeading___Toc1703_3118163005"/><text:bookmark-end text:name="instructions-de-contrôle"/></text:h>
   <text:list text:style-name="L14">
    <text:list-item>
     <text:p text:style-name="P19"><text:span text:style-name="Source_5f_Text">while (condition) (corps);</text:span> répète le corps tant que la condition est vraie. C’est la seule forme de <text:span text:style-name="Source_5f_Text">while</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P19"><text:span text:style-name="Source_5f_Text">loop(n, corps);</text:span> répète le corps <text:span text:style-name="Source_5f_Text">n</text:span> fois.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P19"><text:span text:style-name="Source_5f_Text">(condition) ? (si_vrai) : (si_faux);</text:span> exécute l’une des deux branches ; la branche <text:span text:style-name="Source_5f_Text">: (…)</text:span> est facultative.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P19"><text:span text:style-name="Source_5f_Text">return(v)</text:span> sort de la fonction courante avec le résultat <text:span text:style-name="Source_5f_Text">v</text:span> ; <text:span text:style-name="Source_5f_Text">exit(v)</text:span> termine le processus.</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1705_3118163005"/><text:bookmark-start text:name="fonctions-1"/>Fonctions<text:bookmark-end text:name="__RefHeading___Toc1705_3118163005"/><text:bookmark-end text:name="fonctions-1"/></text:h>
   <text:p text:style-name="Preformatted_20_Text">function nom(p1, p2, …)</text:p>
   <text:p text:style-name="Preformatted_20_Text">local (v1, v2, …)</text:p>
   <text:p text:style-name="Preformatted_20_Text">( instructions );</text:p>
   <text:p text:style-name="First_20_paragraph">Contrairement à JSFX, les virgules entre paramètres et entre variables locales sont obligatoires, et :</text:p>
   <text:list text:style-name="L15">
    <text:list-item>
     <text:p text:style-name="P20">les fonctions peuvent être <text:span text:style-name="T1">récursives</text:span>, y compris de façon croisée, et être appelées avant leur définition ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P20">les paramètres et les variables locales sont alloués dans la pile à chaque appel : ils ne gardent pas leur valeur d’un appel à l’autre, et les variables locales ne sont <text:span text:style-name="T1">pas initialisées</text:span> ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P20">le nombre de paramètres d’une fonction est fixe, et un nom ne désigne qu’une fonction. Une fonction <text:span text:style-name="T1">variadique</text:span>, qui accepte un nombre quelconque d’arguments, se déclare avec un point-virgule : dans <text:span text:style-name="Source_5f_Text">function f(n; args)</text:span>, <text:span text:style-name="Source_5f_Text">n</text:span> reçoit le nombre d’arguments et <text:span text:style-name="Source_5f_Text">args</text:span> un tableau qui les contient (valable seulement pendant l’appel) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P20">les fonctions sont des <text:span text:style-name="T1">valeurs</text:span> comme les autres : on peut les ranger dans une variable ou un tableau, les passer en paramètre, les rendre comme résultat. Les fonctions prédéfinies aussi (<text:span text:style-name="Source_5f_Text">var f = sin;</text:span>), et les opérateurs placés entre parenthèses (<text:span text:style-name="Source_5f_Text">var plus = (+); plus(2, 3);</text:span> vaut 5) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P20">l’interprète optimise la <text:span text:style-name="T1">récursivité terminale</text:span> : un appel placé en dernière position d’une fonction ne consomme pas de pile, si bien qu’une fonction peut s’appeler des millions de fois.</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1707_3118163005"/><text:bookmark-start text:name="tableaux-et-mémoire"/>Tableaux et mémoire<text:bookmark-end text:name="__RefHeading___Toc1707_3118163005"/><text:bookmark-end text:name="tableaux-et-mémoire"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un <text:span text:style-name="T1">bloc</text:span> est une zone de mémoire précédée d’un en-tête : si <text:span text:style-name="Source_5f_Text">t</text:span> est un bloc de <text:span text:style-name="Source_5f_Text">N</text:span> éléments, <text:span text:style-name="Source_5f_Text">t[-2]</text:span> est son <text:span text:style-name="T1">type</text:span> (une valeur de 4 caractères, <text:span text:style-name="Source_5f_Text">&apos;data&apos;</text:span> par défaut), <text:span text:style-name="Source_5f_Text">t[-1]</text:span> sa <text:span text:style-name="T1">taille</text:span> <text:span text:style-name="Source_5f_Text">N</text:span>, et <text:span text:style-name="Source_5f_Text">t[0]</text:span> à <text:span text:style-name="Source_5f_Text">t[N-1]</text:span> ses éléments. Les blocs se créent par :</text:p>
   <table:table table:name="Table14" table:style-name="Table14">
    <table:table-column table:style-name="Table14.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table14.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Opération</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table14.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">data(…)</text:span>, ou <text:span text:style-name="Source_5f_Text">`(…)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">bloc créé une fois pour toutes à la compilation, avec des valeurs constantes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">array(e1, …, eN)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nouveau bloc à chaque exécution, avec les valeurs des expressions</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">malloc(n)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nouveau bloc de <text:span text:style-name="Source_5f_Text">n</text:span> éléments ; rend 0 si la mémoire manque</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">mfree(t)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">libère un bloc créé par <text:span text:style-name="Source_5f_Text">array</text:span> ou <text:span text:style-name="Source_5f_Text">malloc</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">size(t)</text:span>, <text:span text:style-name="Source_5f_Text">isblock(t)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">taille d’un bloc (−1 si ce n’en est pas un), test</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Un bloc peut servir de <text:span text:style-name="T1">table associative</text:span> : les éléments de rang pair sont des clés, les suivants leurs valeurs, et <text:span text:style-name="Source_5f_Text">t[`clé]</text:span> rend la valeur associée à la clé (les clés doivent être des nombres <text:soft-page-break/>plus grands que la taille du bloc, ce qui est le cas des symboles).</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T1">Lecture et écriture.</text:span> On peut lire n’importe quel mot de la mémoire du plug-in (<text:span text:style-name="Source_5f_Text">a[i]</text:span>), et de la mémoire partagée entre plug-ins (<text:span text:style-name="Source_5f_Text">gmem[i]</text:span>). En revanche, l’écriture indexée <text:span text:style-name="Source_5f_Text">t[i] = v</text:span> (et <text:span text:style-name="Source_5f_Text">+=</text:span>, <text:span text:style-name="Source_5f_Text">*=</text:span>…) n’est permise que :</text:p>
   <text:list text:style-name="L16">
    <text:list-item>
     <text:p text:style-name="P21">dans un bloc, pour un indice compris entre 0 et sa taille moins 1 ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P21">dans le tableau des arguments d’une fonction variadique.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Toute autre écriture arrête le processus avec une erreur (1629 ou 1630). Pour écrire à une adresse quelconque, en connaissance de cause, on utilise <text:span text:style-name="Source_5f_Text">poke(adresse, valeur)</text:span> ou <text:span text:style-name="Source_5f_Text">poke(adresse, décalage, valeur)</text:span>. La fonction <text:span text:style-name="Source_5f_Text">memcpy(destination, source, n)</text:span> copie <text:span text:style-name="Source_5f_Text">n</text:span> mots en respectant la taille des blocs (une adresse négative désigne la mémoire partagée) et rend le nombre de mots copiés.</text:p>
   <text:p text:style-name="Text_20_body">La mémoire dynamique est gérée par un <text:span text:style-name="T1">ramasse-miettes</text:span> (<text:span text:style-name="T2">garbage collector</text:span>) conservatif, qui récupère les blocs devenus inaccessibles, en particulier ceux qui sont partagés entre plusieurs processus.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1709_3118163005"/><text:bookmark-start text:name="la-syntaxe-de-data"/>La syntaxe de <text:span text:style-name="Source_5f_Text">data</text:span><text:bookmark-end text:name="__RefHeading___Toc1709_3118163005"/><text:bookmark-end text:name="la-syntaxe-de-data"/></text:h>
   <text:p text:style-name="First_20_paragraph">La directive <text:span text:style-name="Source_5f_Text">data</text:span> est suivie d’une liste de <text:span text:style-name="T1">constantes</text:span> entre parenthèses, séparées par des espaces, des tabulations, des passages à la ligne ou des virgules ; on peut y placer des commentaires. Les éléments sont :</text:p>
   <text:list text:style-name="L17">
    <text:list-item>
     <text:p text:style-name="P22">des nombres, sous toutes les notations vues plus haut, et des chaînes entre guillemets ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">des <text:span text:style-name="T1">identificateurs</text:span>, qui y valent leur symbole : dans <text:span text:style-name="Source_5f_Text">data(Table PlModes PMd 3)</text:span>, <text:span text:style-name="Source_5f_Text">Table</text:span> et <text:span text:style-name="Source_5f_Text">PlModes</text:span> sont des symboles. Attention, la casse compte : <text:span text:style-name="Source_5f_Text">FdIn</text:span> et <text:span text:style-name="Source_5f_Text">FDin</text:span> sont deux mots différents ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P23">des éléments syntaxiques du langages, codifiés sous forme de « grandes » valeurs numériques.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">C’est avec <text:span text:style-name="Source_5f_Text">data</text:span> que s’écrivent les <text:span text:style-name="T1">tables</text:span> de configuration des plug-ins, passées à la fonction <text:span text:style-name="Source_5f_Text">table</text:span> :</text:p>
   <text:p text:style-name="Preformatted_20_Text">table(data(</text:p>
   <text:p text:style-name="Preformatted_20_Text"><text:s text:c="4"/>Table PlModes</text:p>
   <text:p text:style-name="Preformatted_20_Text"><text:s text:c="4"/>PMd 32</text:p>
   <text:p text:style-name="Preformatted_20_Text"><text:s text:c="8"/>Kmd KmdLoop</text:p>
   <text:p text:style-name="Preformatted_20_Text"><text:s text:c="8"/>Speed 0.4 0.7 0.8</text:p>
   <text:p text:style-name="Preformatted_20_Text"><text:s text:c="8"/>Gsize 0.2 0.45</text:p>
   <text:p text:style-name="Preformatted_20_Text"><text:s text:c="4"/>End</text:p>
   <text:p text:style-name="Preformatted_20_Text">));</text:p>
   <text:p text:style-name="First_20_paragraph">Le vocabulaire des tables (ici <text:span text:style-name="Source_5f_Text">Table</text:span>, <text:span text:style-name="Source_5f_Text">PMd</text:span>, <text:span text:style-name="Source_5f_Text">Kmd</text:span>, <text:span text:style-name="Source_5f_Text">Speed</text:span>…) est propre à chaque plug-in et décrit dans son manuel.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1711_3118163005"/><text:bookmark-start text:name="chaînes-de-caractères-1"/>Chaînes de caractères<text:bookmark-end text:name="__RefHeading___Toc1711_3118163005"/><text:bookmark-end text:name="chaînes-de-caractères-1"/></text:h>
   <text:p text:style-name="P24">Les chaînes sont prises dans une réserve gérée par le plug-in. Une chaîne constante (<text:span text:style-name="Source_5f_Text">&quot;texte&quot;</text:span>) est allouée par le compilateur ; <text:span text:style-name="Source_5f_Text">stralloc()</text:span> fournit une chaîne modifiable, à rendre par <text:span text:style-name="Source_5f_Text">strfree(s)</text:span> ; <text:span text:style-name="Source_5f_Text">strtmp()</text:span> fournit une chaîne temporaire, qui n’a pas besoin d’être libérée mais ne reste valable que pour les quelques <text:span text:style-name="T9">dizaines, centaines ou milliers d’</text:span>instructions qui suivent. Il y a <text:span text:style-name="T9">une</text:span> récupération automatique des chaînes <text:span text:style-name="T9">lorsque le </text:span><text:span text:style-name="T10">ramasse-miettes</text:span><text:span text:style-name="T9"> est activé, et découvre qu’il n’existe plus aucune référence à ces chaînes.</text:span></text:p>
   <table:table table:name="Table15" table:style-name="Table15">
    <table:table-column table:style-name="Table15.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table15.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Fonction</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table15.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">sprintf(d, format, v1, …)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">édite les valeurs dans la chaîne <text:span text:style-name="Source_5f_Text">d</text:span> (ou dans <text:soft-page-break/>une chaîne temporaire si <text:span text:style-name="Source_5f_Text">d</text:span> vaut 0), et rend cette chaîne</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">strlen(s)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">longueur</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">strcpy(d, s)</text:span>, <text:span text:style-name="Source_5f_Text">strcat(d, s)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">copie, concaténation</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">strcmp(a, b)</text:span>, <text:span text:style-name="Source_5f_Text">stricmp(a, b)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">comparaison, avec ou sans distinction des majuscules</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">strgetch(s, i)</text:span>, <text:span text:style-name="Source_5f_Text">strsetch(s, i, c)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">lit, écrit le caractère de rang <text:span text:style-name="Source_5f_Text">i</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">symbol(s)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le symbole correspondant au texte de la chaîne</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">edn(s, v)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écrit dans <text:span text:style-name="Source_5f_Text">s</text:span> la représentation la plus lisible de la valeur <text:span text:style-name="Source_5f_Text">v</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">isstring(x)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">teste si <text:span text:style-name="Source_5f_Text">x</text:span> est une chaîne</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1713_3118163005"/><text:bookmark-start text:name="les-fonctions-prédéfinies"/>Les fonctions prédéfinies<text:bookmark-end text:name="__RefHeading___Toc1713_3118163005"/><text:bookmark-end text:name="les-fonctions-prédéfinies"/></text:h>
   <table:table table:name="Table16" table:style-name="Table16">
    <table:table-column table:style-name="Table16.A"/>
    <table:table-column table:style-name="Table16.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table16.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Domaine</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table16.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Fonctions</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">mathématiques</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">sin</text:span> <text:span text:style-name="Source_5f_Text">cos</text:span> <text:span text:style-name="Source_5f_Text">tan</text:span> <text:span text:style-name="Source_5f_Text">asin</text:span> <text:span text:style-name="Source_5f_Text">acos</text:span> <text:span text:style-name="Source_5f_Text">atan</text:span> <text:span text:style-name="Source_5f_Text">atan2</text:span> <text:span text:style-name="Source_5f_Text">pow</text:span> <text:span text:style-name="Source_5f_Text">sqr</text:span> <text:span text:style-name="Source_5f_Text">sqrt</text:span> <text:span text:style-name="Source_5f_Text">invsqrt</text:span> <text:span text:style-name="Source_5f_Text">exp</text:span> <text:span text:style-name="Source_5f_Text">log</text:span> <text:span text:style-name="Source_5f_Text">log10</text:span> <text:span text:style-name="Source_5f_Text">abs</text:span> <text:span text:style-name="Source_5f_Text">sign</text:span> <text:span text:style-name="Source_5f_Text">floor</text:span> <text:span text:style-name="Source_5f_Text">ceil</text:span> <text:span text:style-name="Source_5f_Text">int</text:span> <text:span text:style-name="Source_5f_Text">min</text:span> <text:span text:style-name="Source_5f_Text">max</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sommes</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">sum(x1, …)</text:span>, <text:span text:style-name="Source_5f_Text">prod(x1, …)</text:span> : somme, produit de leurs arguments</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">hasard</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">rand(x)</text:span> : décimal dans [0, x[ ; <text:span text:style-name="Source_5f_Text">irand(n)</text:span> : entier dans [0, n-1]</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tests</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">isint</text:span> <text:span text:style-name="Source_5f_Text">isfun</text:span> <text:span text:style-name="Source_5f_Text">isstring</text:span> <text:span text:style-name="Source_5f_Text">isblock</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">temps et audio</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">time()</text:span> (secondes), <text:span text:style-name="Source_5f_Text">ptime()</text:span> (temps précis, <text:span text:style-name="Source_5f_Text">time_precise</text:span> de JSFX), <text:span text:style-name="Source_5f_Text">srate()</text:span>, <text:span text:style-name="Source_5f_Text">num_ch()</text:span>, <text:span text:style-name="Source_5f_Text">tempo()</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">mémoire</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">malloc</text:span> <text:span text:style-name="Source_5f_Text">mfree</text:span> <text:span text:style-name="Source_5f_Text">array</text:span> <text:span text:style-name="Source_5f_Text">size</text:span> <text:span text:style-name="Source_5f_Text">memcpy</text:span> <text:span text:style-name="Source_5f_Text">poke</text:span> <text:span text:style-name="Source_5f_Text">memtop()</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">chaînes</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">stralloc</text:span> <text:span text:style-name="Source_5f_Text">strfree</text:span> <text:span text:style-name="Source_5f_Text">strtmp</text:span> <text:span text:style-name="Source_5f_Text">sprintf</text:span> <text:span text:style-name="Source_5f_Text">strlen</text:span> <text:span text:style-name="Source_5f_Text">strcpy</text:span> <text:span text:style-name="Source_5f_Text">strcat</text:span> <text:span text:style-name="Source_5f_Text">strcmp</text:span> <text:span text:style-name="Source_5f_Text">stricmp</text:span> <text:span text:style-name="Source_5f_Text">strgetch</text:span> <text:span text:style-name="Source_5f_Text">strsetch</text:span> <text:span text:style-name="Source_5f_Text">symbol</text:span> <text:span text:style-name="Source_5f_Text">edn</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">contrôle</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">return(v)</text:span> <text:span text:style-name="Source_5f_Text">exit(v)</text:span> <text:span text:style-name="Source_5f_Text">error(code)</text:span> (signale une erreur et arrête le processus)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">compilation</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">compile(s)</text:span> : compile le texte <text:span text:style-name="Source_5f_Text">s</text:span> en une fonction sans paramètre, qui s’exécute plus tard : après <text:span text:style-name="Source_5f_Text">var c = compile(&quot;var a=3; 2*a+1;&quot;);</text:span>, <text:span text:style-name="Source_5f_Text">c()</text:span> vaut 7</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">processus</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">thread</text:span> <text:span text:style-name="Source_5f_Text">wait</text:span> <text:span text:style-name="Source_5f_Text">yield</text:span> <text:span text:style-name="Source_5f_Text">event</text:span> (voir le chapitre suivant)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">plug-ins</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">print</text:span> (ou <text:span text:style-name="Source_5f_Text">GM_Log</text:span>), <text:span text:style-name="Source_5f_Text">get</text:span>, <text:span text:style-name="Source_5f_Text">set</text:span>, <text:span text:style-name="Source_5f_Text">call</text:span>, <text:span text:style-name="Source_5f_Text">table</text:span>, <text:span text:style-name="Source_5f_Text">action</text:span>, <text:span text:style-name="Source_5f_Text">GM_Addr</text:span>… : leur effet dépend du plug-in</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">mSL n’a pas de fonctions graphiques.</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T1">Paramètres.</text:span> Les paramètres des plug-ins (ceux que l’on règle avec des sliders) portent des numéros de 0 à 1023, avec une plage par application : 0 à 255 pour le Game Master, 256 à 511 pour Interstys, 512 à 639 pour Diffusion-3, 640 à 703 pour ScriptMaster, 704 à 767 pour MIDI_In et MIDIduino. <text:span text:style-name="Source_5f_Text">get(`pval, n)</text:span> lit la valeur du paramètre <text:span text:style-name="Source_5f_Text">n</text:span>, quelle que soit l’application ; <text:span text:style-name="Source_5f_Text">set(`pval, n, v)</text:span> le modifie, s’il appartient au plug-in où s’exécute le script (sinon, une erreur), et rend la valeur précédente.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1715_3118163005"/><text:bookmark-start text:name="importer-un-fichier"/><text:soft-page-break/>Importer un fichier<text:bookmark-end text:name="__RefHeading___Toc1715_3118163005"/><text:bookmark-end text:name="importer-un-fichier"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un script peut inclure le texte d’un autre fichier, d’extension <text:span text:style-name="Source_5f_Text">.mSL</text:span> ou <text:span text:style-name="Source_5f_Text">.txt</text:span> : <text:span text:style-name="Source_5f_Text">import &quot;fichier.mSL&quot;;</text:span>. Les importations peuvent se mêler aux autres instructions.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1717_3118163005"/><text:bookmark-start text:name="exécution-des-scripts"/>Exécution des scripts<text:bookmark-end text:name="__RefHeading___Toc1717_3118163005"/><text:bookmark-end text:name="exécution-des-scripts"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1719_3118163005"/><text:bookmark-start text:name="processus-légers"/>Processus légers<text:bookmark-end text:name="__RefHeading___Toc1719_3118163005"/><text:bookmark-end text:name="processus-légers"/></text:h>
   <text:p text:style-name="First_20_paragraph">Chaque script s’exécute dans un <text:span text:style-name="T1">processus léger</text:span> (<text:span text:style-name="T2">thread</text:span>). Un plug-in peut faire tourner des centaines de processus en même temps ; ils partagent la mémoire du plug-in, mais chacun a sa pile et ses variables <text:span text:style-name="Source_5f_Text">loc</text:span>. Un seul processus travaille à un instant donné : l’<text:span text:style-name="T1">ordonnanceur</text:span> (module <text:span text:style-name="T2">Scheduler</text:span>) passe de l’un à l’autre, soit à leur demande, soit d’office au bout d’un certain temps (la commutation est <text:span text:style-name="T1">préemptive</text:span> : aucun processus ne peut bloquer le plug-in). Après une commutation, un processus est assuré de pouvoir exécuter un nombre minimal d’instructions (plus de 4000) sans être interrompu, ce qui permet de modifier sans risque, pendant ce temps, des données partagées.</text:p>
   <text:p text:style-name="Text_20_body">Les scripts s’exécutent dans la partie graphique des plug-ins (la section <text:span text:style-name="Source_5f_Text">@gfx</text:span> de JSFX), par petites tranches de temps, et non dans la partie audio : ils ne perturbent donc pas le son. Ils continuent de s’exécuter lorsque la fenêtre du plug-in est fermée. (Dans le Game Master, si la partie graphique s’arrête, la partie audio prend le relais.)</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1721_3118163005"/><text:bookmark-start text:name="créer-et-gérer-des-processus"/>Créer et gérer des processus<text:bookmark-end text:name="__RefHeading___Toc1721_3118163005"/><text:bookmark-end text:name="créer-et-gérer-des-processus"/></text:h>
   <table:table table:name="Table17" table:style-name="Table17">
    <table:table-column table:style-name="Table17.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table17.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Opération</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table17.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">thread(`new, f, p1, …)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="P25">crée un processus qui exécutera la fonction <text:span text:style-name="Source_5f_Text">f</text:span> avec les paramètres <text:span text:style-name="Source_5f_Text">p1…</text:span> ; rend son identifiant <text:span text:style-name="Source_5f_Text">t</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">thread(`run, t)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">lance le processus <text:span text:style-name="Source_5f_Text">t</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">thread(`idt)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">identifiant du processus courant</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">thread(`name, `nom)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">donne un nom au processus courant (pour lui adresser des messages)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">thread(`status, t)</text:span>, <text:span text:style-name="Source_5f_Text">thread(`find, …)</text:span>, <text:span text:style-name="Source_5f_Text">thread(`count)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">état d’un processus, recherche, nombre de processus</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">wait(s)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">met le processus en attente pendant <text:span text:style-name="Source_5f_Text">s</text:span> secondes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">yield()</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">cède la main aux autres processus</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">exit(v)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">termine le processus ; <text:span text:style-name="Source_5f_Text">v</text:span> est sa valeur de sortie</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Les processus créés par un même script partagent ses variables <text:span text:style-name="Source_5f_Text">var</text:span>, mais chacun a ses propres variables <text:span text:style-name="Source_5f_Text">loc</text:span>.</text:p>
   <text:p text:style-name="Preformatted_20_Text">var total = 0;</text:p>
   <text:p text:style-name="Preformatted_20_Text">function travail(n) ( wait(0.5); total += n; );</text:p>
   <text:p text:style-name="Preformatted_20_Text">thread(`run, thread(`new, travail, 10));</text:p>
   <text:p text:style-name="Preformatted_20_Text">thread(`run, thread(`new, travail, 20));</text:p>
   <text:p text:style-name="Preformatted_20_Text">wait(1);</text:p>
   <text:p text:style-name="Preformatted_20_Text">print(sprintf(0, &quot;total = %d&quot;, total)); <text:s text:c="2"/>// total = 30</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1723_3118163005"/><text:bookmark-start text:name="les-messages"/>Les messages<text:bookmark-end text:name="__RefHeading___Toc1723_3118163005"/><text:bookmark-end text:name="les-messages"/></text:h>
   <text:p text:style-name="First_20_paragraph">Les processus d’un même plug-in s’échangent des <text:span text:style-name="T1">messages</text:span> (ou <text:span text:style-name="T2">événements</text:span>) par la fonction <text:span text:style-name="Source_5f_Text">event</text:span>. Un message porte un nom (un symbole), un délai, une durée de vie et des paramètres ; il est adressé à un processus par son identifiant ou par son nom.</text:p>
   <table:table table:name="Table18" table:style-name="Table18">
    <table:table-column table:style-name="Table18.A" table:number-columns-repeated="2"/>
    <table:table-header-rows>
     <text:soft-page-break/>
     <table:table-row>
      <table:table-cell table:style-name="Table18.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Opération</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table18.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">event(`notify, 0, 0, 0, dest, nomDest, `evt, délai, durée, 0, 0, seq, p1, p2)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">envoie le message <text:span text:style-name="Source_5f_Text">evt</text:span> au processus <text:span text:style-name="Source_5f_Text">dest</text:span> (ou, si <text:span text:style-name="Source_5f_Text">dest</text:span> vaut 0, au processus nommé <text:span text:style-name="Source_5f_Text">nomDest</text:span>), après <text:span text:style-name="Source_5f_Text">délai</text:span> secondes ; il expire au bout de <text:span text:style-name="Source_5f_Text">durée</text:span> secondes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">event(`wait, s)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">attend un message, au plus <text:span text:style-name="Source_5f_Text">s</text:span> secondes ; rend le message, ou −1</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">event(`check)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">indique si un message attend</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">event(`count)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre de messages en attente</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">event(`recycle, m)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">rend le message <text:span text:style-name="Source_5f_Text">m</text:span> après usage</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">event(`clearall)</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table18.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">supprime les messages en attente</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Dans un message reçu <text:span text:style-name="Source_5f_Text">m</text:span>, <text:span text:style-name="Source_5f_Text">m[2]</text:span> est le nom de l’événement, <text:span text:style-name="Source_5f_Text">m[13]</text:span> le numéro <text:span text:style-name="Source_5f_Text">seq</text:span> et <text:span text:style-name="Source_5f_Text">m[14]</text:span> le premier paramètre.</text:p>
   <text:p text:style-name="Preformatted_20_Text">var moi = thread(`idt);</text:p>
   <text:p text:style-name="Preformatted_20_Text">function envoi() ( wait(0.5); event(`notify, 0, 0, 0, moi, 0, `hello, 0, 10, 0, 0, 1, 42, 0); );</text:p>
   <text:p text:style-name="Preformatted_20_Text">thread(`run, thread(`new, envoi));</text:p>
   <text:p text:style-name="Preformatted_20_Text">var m = event(`wait, 5);</text:p>
   <text:p text:style-name="Preformatted_20_Text">(m &gt; 0) ? ( print(sprintf(0, &quot;reçu %d&quot;, m[14])); event(`recycle, m); ); <text:s text:c="2"/>// reçu 42</text:p>
   <text:p text:style-name="First_20_paragraph">Les plug-ins entre eux communiquent par la <text:span text:style-name="T1">mémoire partagée</text:span> (<text:span text:style-name="Source_5f_Text">gmem</text:span>) et par les <text:span text:style-name="T1">paramètres</text:span> (voir plus haut) ; le Game Master pilote ainsi ses lecteurs, et un script peut lire les paramètres de tous les plug-ins du projet.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1725_3118163005"/><text:bookmark-start text:name="les-séries-de-tests"/>Les séries de tests<text:bookmark-end text:name="__RefHeading___Toc1725_3118163005"/><text:bookmark-end text:name="les-séries-de-tests"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le dossier <text:span text:style-name="Source_5f_Text">CMGS-scripts/Tests</text:span> contient des scripts de test, <text:span text:style-name="Source_5f_Text">Ex-NNNN.mSL</text:span>, qui vérifient le langage et les plug-ins. Leurs numéros indiquent leur domaine : <text:span text:style-name="Source_5f_Text">Ex-0NNN</text:span> le langage (ils doivent réussir dans tous les plug-ins), <text:span text:style-name="Source_5f_Text">Ex-1NNN</text:span> Interstys, <text:span text:style-name="Source_5f_Text">Ex-2NNN</text:span> le Game Master, <text:span text:style-name="Source_5f_Text">Ex-3NNN</text:span> Diffusion-3.</text:p>
   <text:p text:style-name="Text_20_body">Chaque script annonce ce qu’il doit écrire dans le journal, par des commentaires :</text:p>
   <text:p text:style-name="Preformatted_20_Text">// Expected &quot;Ex-0022. lu 1, inchange 1&quot;</text:p>
   <text:p text:style-name="Preformatted_20_Text">// Expected error 1629</text:p>
   <text:p text:style-name="Preformatted_20_Text">// Allowed error 0621</text:p>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="Source_5f_Text">Expected &quot;…&quot;</text:span> attend un message (les formats de <text:span text:style-name="Source_5f_Text">sprintf</text:span>, comme <text:span text:style-name="Source_5f_Text">%d</text:span>, y sont permis), <text:span text:style-name="Source_5f_Text">Expected error NNNN</text:span> une erreur, <text:span text:style-name="Source_5f_Text">Allowed error NNNN</text:span> une erreur qui peut apparaître ou non. Pour passer une série :</text:p>
   <text:list text:style-name="L18">
    <text:list-item>
     <text:p text:style-name="P26">déposez les scripts dans la fenêtre du plug-in ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P26">quand ils ont fini, enregistrez le journal avec la touche <text:span text:style-name="Source_5f_Text">p</text:span> (le script auxiliaire doit être lancé) : le fichier <text:span text:style-name="Source_5f_Text">syslog-&lt;plug-in&gt;-&lt;date&gt;.txt</text:span> est écrit dans le dossier du projet ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P26">vérifiez-le avec : <text:span text:style-name="Source_5f_Text">python3 -I CMGS-scripts/Tests/check_scripts.py [fichier ou dossier] [-a]</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="Source_5f_Text">check_scripts.py</text:span> lit par défaut le journal le plus récent des projets de <text:span text:style-name="Source_5f_Text">~/Music/REAPER-Projects</text:span>, et indique pour chaque script s’il est correct, en échec, ou s’il a produit une erreur inattendue. Le journal ne garde que ses derniers messages (environ 800 lignes) : une série trop bavarde doit être passée en plusieurs fois.</text:p>
   <text:p text:style-name="part"><text:bookmark-start text:name="__RefHeading___Toc1018_3791693507"/>Partie IV — Les erreurs<text:bookmark-end text:name="__RefHeading___Toc1018_3791693507"/></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc3423_3373287921"/><text:bookmark-start text:name="liste-des-erreurs"/>Liste des erreurs<text:bookmark-end text:name="__RefHeading___Toc3423_3373287921"/><text:bookmark-end text:name="liste-des-erreurs"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc3425_3373287921"/><text:bookmark-start text:name="lire-un-message-derreur"/>Lire un message d’erreur<text:bookmark-end text:name="__RefHeading___Toc3425_3373287921"/><text:bookmark-end text:name="lire-un-message-derreur"/></text:h>
   <text:p text:style-name="First_20_paragraph">Les plug-ins de CMGS vérifient autant que possible les données et les opérations qu’on leur confie. Lorsqu’un problème est détecté, ils le signalent par un <text:span text:style-name="T1">code d’erreur</text:span>, un nombre de quatre chiffres, accompagné le plus souvent d’un message, dans le journal (module <text:span text:style-name="T2">System Log</text:span>), sous la forme :</text:p>
   <text:p text:style-name="Preformatted_20_Text">ERR: 2474 <text:s text:c="3"/>Space : the library of trajectories is full (128) : &quot;Spirale&quot; not kept</text:p>
   <text:p text:style-name="First_20_paragraph">Certains modules affichent aussi le code de la dernière erreur dans une de leurs cellules (par exemple la cellule 13 du module <text:span text:style-name="T2">Play Control</text:span> du Game Master).</text:p>
   <text:p text:style-name="Text_20_body">Chaque code est <text:span text:style-name="T1">unique</text:span> dans l’ensemble des sources de CMGS : on peut le chercher tel quel dans ce chapitre, et le développeur peut le retrouver dans le code. Les codes sont classés ici par ordre numérique ; la colonne « Application » indique le plug-in qui le produit (« tous » : les bibliothèques communes, en particulier le langage mSL, présentes dans tous les plug-ins).</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T1">Erreurs de scripts.</text:span> Une erreur de <text:span text:style-name="T1">compilation</text:span> est signalée avec le numéro de la ligne et la position dans la ligne où le compilateur s’est arrêté. Une erreur d’<text:span text:style-name="T1">exécution</text:span> arrête le processus qui l’a commise (et, par défaut, les autres processus du plug-in : voir la Partie III). Un script peut signaler lui-même une erreur par la fonction <text:span text:style-name="Source_5f_Text">error(n)</text:span> : le code affiché est alors <text:span text:style-name="T1">10000 + n</text:span>.</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T1">Erreurs internes.</text:span> Les erreurs marquées « erreur interne » ou « erreur système » ne devraient pas se produire : elles révèlent un défaut du logiciel ou une mémoire endommagée. Si l’une d’elles apparaît, notez les circonstances, exportez le journal (touche <text:span text:style-name="Source_5f_Text">p</text:span>) et signalez-la à l’auteur ; il est en général prudent de recharger le projet.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc3427_3373287921"/><text:bookmark-start text:name="les-familles-de-codes"/>Les familles de codes<text:bookmark-end text:name="__RefHeading___Toc3427_3373287921"/><text:bookmark-end text:name="les-familles-de-codes"/></text:h>
   <table:table table:name="Table19" table:style-name="Table19">
    <table:table-column table:style-name="Table19.A"/>
    <table:table-column table:style-name="Table19.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table19.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Codes</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table19.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Domaine</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0100 à 0199</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">mémoire statique, configurations de haut-parleurs du Game Master</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0200 à 0299</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tables de Diffusion-3, listes d’actions du Game Master</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0300 à 0399</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">configurations de haut-parleurs et banques du Game Master</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0400 à 0499</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">fichiers son, écran « Live »</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0500 à 0599</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">lecture des clips (Game Master)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0600 à 0699</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">blocs de commande des lecteurs (FilePlayer), paramètres</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0700 à 0899</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tables du Game Master, matrices de Diffusion-3, modules définis par <text:span text:style-name="Source_5f_Text">gui</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1000 à 1999</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">compilateur, mémoire dynamique, exécution des scripts</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2000 à 2499</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">syntaxe de mSL, lancement des scripts, tables de Diffusion-3</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2600 à 2999</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Interstys</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">3000 à 4999</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table19.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">compilateur, ramasse-miettes, ordonnanceur, erreurs internes de Diffusion-3</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
