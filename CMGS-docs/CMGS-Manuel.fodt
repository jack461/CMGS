     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Affectation à l’adresse 0 (variable non initialisée).</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1629</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Écriture indexée hors d’un bloc (indice négatif ou trop grand), ou hors de la partie utilisée de la pile.</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1630</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3_5f_2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Écriture indexée dans quelque chose qui n’est pas un bloc (par exemple un tableau non défini, qui vaut 0).</text:p>
     </table:table-cell>
