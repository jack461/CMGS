GM_Log("Config Espaces started.");


var str = stralloc();
var start = data (


// Configuration for "Espaces"

clear  // clear the conf/scene/group area

conf  16 :  1 > 1 3, 2, 4 2 ;  2 > 2, 3 ;
conf  20 :  1>2; 2>2;
conf  18 :  2>1; 1>1;
conf  21 :  1>1; 2>2;

conf 10 : 1>1, 3; 2>2, 4;

// set 3 : 3 2 6 8 7 5 1 ;
set 35 : 1 9 2 10 5 13 6 14 ;

conf 31 : 1>1; 2>1;
conf 32 : 1>2; 2>2;
conf 33 : 1>3; 2>3;
conf 34:  1>4; 2>4;

conf 36 : 1>1; 2>3;
conf 37 : 1>2; 2>4;
conf 38 : 1>1; 2>4;
conf 39 : 1>2; 2>3;

conf 41 : 1> 1, 2, 3, 4; 2 > 1, 2, 3, 4;

conf 51 : 1>1;
conf 52 : 2>2;

conf 53 : 1>3;
conf 54 : 2>4;

conf 61 : 1>1,2; 2>3;
conf 62 : 1>2,3; 2>4;
conf 63 : 1>3,4; 2>1;
conf 64 : 1>4,1; 2>2;

conf 65 : 1>1,2,3; 2>4;
conf 66 : 1>2,3,4; 2>1;
conf 67 : 1>3,4,1; 2>2;
conf 68 : 1>4,1,2; 2>3;

conf 69 : 1>1; 2>2 -12;
conf 70 : 1>2; 2>3 -12;
conf 71 : 1>3; 2>4 -12;
conf 72 : 1>4; 2>1 -12;

conf 73 : 1>1; 2>3 -18;
conf 74 : 1>2; 2>4 -18;
conf 75 : 1>3; 2>1 -18;
conf 76 : 1>4; 2>2 -18;

end

defaultconf 41; // choose as default configuration
// remove conf 20;

prop 28 (rdelay 50) ;
prop 25 (default, Active, Manual, morpht 10, rdelay 40,
         pad 1 3 1);

prop 29 (rdelay 120) ;

scene 1

group 1
    16 20 18 21     31 32 33 34     36 37 38 39     41 34 33 32 

group 2
    36 37 38 39     30 40 30 40     30 40 30 40     51 52 53 54

group 3
    61 62 63 64     65 66 67 68     69 70 71 72     73 74 75 76

group 4
    61 62 63 64     30 40 30 40     36 37 38 39     51 52 53 54

scene 2

group 1
    31 32 33 34     36 37 38 39    51 52 53 54

end

group 9
    61 62 63 64     65 66 67 68     69 70 71 72     73 74 75 76

end

 set 1 : 1 2 3 4 ;
 set 2 : 5 6 7 8 ;


pload 3 28 ; 

pload 5 25; 

actions 2 : 2 -1, 3 -1, 5 -1;
actions 4 : 0, 0, 0, 0, 6 -1, 7, 8, 9;
actions 5 : 10, 11, 0, 4 1;

scene 1
group 1

end 


);

sprintf(str, "sizeof data is %d", size(start));
GM_Log(str);

var z=table(start);

