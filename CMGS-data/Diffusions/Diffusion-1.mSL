GM_Log("Config Espaces Saint-Etienne 8.1 started.");


var str = stralloc();
var start = data (


clear  // clear the conf/scene/group area


// bgcolor 0x006400 0xB15124 ; // 0x503D33 0xFFFFA0 ;


// Agencement spatial des voix
hppos   1 < -1    1    0,
        2 <  0    1    0,
        3 <  1    1    0,
        4 <  1    0    0,
        5 <  1   -1    0,
        6 <  0   -1    0,
        7 < -1   -1    0,
        8 < -1    0    0;



// Quelques configurations
conf 10 : 1 > 1; 2 > 3;

conf 20 : 1 > 3; 2 > 8;
conf 21 : 1 > 3; 2 > 7;
conf 26 : 1 > 1; 2 > 4;
conf 27 : 1 > 1; 2 > 5;

conf 32 : 1 > 1, 8, 7; 2 > 2, 4, 5;



// Configurations "mono"
conf 81 : 1 > 1; 2 > 1;
conf 82 : 1 > 2; 2 > 2;
conf 83 : 1 > 3; 2 > 3;
conf 84 : 1 > 4; 2 > 4;
conf 85 : 1 > 5; 2 > 5;
conf 86 : 1 > 6; 2 > 6;
conf 87 : 1 > 7; 2 > 7;
conf 88 : 1 > 8; 2 > 8;

// Configurations stéréo proches
conf 91 : 1 > 1; 2 > 2;
conf 92 : 1 > 2; 2 > 3;
conf 93 : 1 > 3; 2 > 4;
conf 94 : 1 > 4; 2 > 5;
conf 95 : 1 > 5; 2 > 6;
conf 96 : 1 > 6; 2 > 7;
conf 97 : 1 > 7; 2 > 8;
conf 98 : 1 > 8; 2 > 1;

// Configurations stéréo écartés
conf 101 : 1 > 1; 2 > 4;
conf 102 : 1 > 2; 2 > 5;
conf 103 : 1 > 3; 2 > 6;
conf 104 : 1 > 4; 2 > 7;
conf 105 : 1 > 5; 2 > 8;
conf 106 : 1 > 6; 2 > 1;
conf 107 : 1 > 7; 2 > 2;
conf 108 : 1 > 8; 2 > 3;

// Configurations stéréo
// Cercle écart 2                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
conf 121 : 1 > 1; 2 > 3;
conf 122 : 1 > 2; 2 > 4;
conf 123 : 1 > 3; 2 > 5;
conf 124 : 1 > 4; 2 > 6;
conf 125 : 1 > 5; 2 > 7;
conf 126 : 1 > 6; 2 > 8;
conf 127 : 1 > 7; 2 > 1;
conf 128 : 1 > 8; 2 > 2;


// Configurations stéréo opposée
conf 111 : 1 > 1; 2 > 5;
conf 112 : 1 > 2; 2 > 6;
conf 113 : 1 > 3; 2 > 7;
conf 114 : 1 > 4; 2 > 8;
conf 115 : 1 > 5; 2 > 1;
conf 116 : 1 > 6; 2 > 2;
conf 117 : 1 > 7; 2 > 3;
conf 118 : 1 > 8; 2 > 4;



// 3 + 3
conf 171 : 1 > 1, 8, 7; 2 > 3, 4, 5;


conf 191 : 1 > 1, 3; 2 > 5, 7;
conf 192 : 1 > 2, 4; 2 > 6, 8;
conf 193 : 1 > 1, 2; 2 > 5, 6;
conf 194 : 1 > 2, 3; 2 > 6, 7;
conf 195 : 1 > 1, 2, 3; 2 > 5, 6, 7;
conf 196 : 1 > 1, 8, 7; 2 > 3, 4, 5;
conf 197 : 1 > 1, 2, 3, 4; 2 > 5, 6, 7, 8;
conf 198 : 1 > 1, 2, 8; 2 > 4, 5, 6;


// Test des diffusions des entrees et des sorties (indiff, outdiff) : prop 3 et prop 4, plus bas
// 201 : en entree, echange la gauche et la droite
conf 201 : 1 > 2 ; 2 > 1 ;
// 202 : en sortie, tourne de deux haut-parleurs ; 203 : son inverse, tourne dans l autre sens
conf 202 : 1 > 3 ; 2 > 4 ; 3 > 5 ; 4 > 6 ; 5 > 7 ; 6 > 8 ; 7 > 1 ; 8 > 2 ;
conf 203 : invert 202 ;
// 205 : groupe les canaux 5 6 2 1 sur 1 2 3 4 ; 206 : les remet en place (1 > 5 ; 2 > 6 ; 3 > 2 ; 4 > 1)
conf 205 : 5 > 1 ; 6 > 2 ; 2 > 3 ; 1 > 4 ;
conf 206 : invert 205 ;
// 207 et 208 : des diffusions de 4 canaux (identite, rotation), pour les projecteurs qui utilisent 205 et 206
conf 207 : 1 > 1 ; 2 > 2 ; 3 > 3 ; 4 > 4 ;
conf 208 : 1 > 2 ; 2 > 3 ; 3 > 4 ; 4 > 1 ;

defaultconf 10; // configuration par défaut



// Description des scènes
scene 1

// Le test des diffusions des entrees et des sorties (avant le groupe 1, qui reste le groupe courant)
group 4
    207 208

group 1
    121 122 123 124    125 126 127 128    191 192 193 194    195 196 197 198

group 2
    81 82 83 84        85 86 87 88        91 92 93 94        95 96 97 98

group 3
    101 102 103 104    105 106 107 108    111 112 113 114    115 116 117 118



end ;




// quelques presets de projecteurs
prop 1 (rdelay 80, color 1, pad 1 1 1);
prop 2 (default, Active, Manual, morpht 10, rdelay 40, pad 1 2 1, color 3);

// Test des diffusions des entrees et des sorties
// Projecteur 3 : conf 121 (1 > 1 ; 2 > 3), indiff 201, outdiff 202 : la gauche sort sur 5, la droite sur 3
prop 3 (default, Active, Manual, pad 1 1 1, indiff 201, outdiff 202, color 4);
// Projecteur 4 : conf 207 (4 canaux), indiff 205, outdiff 206 : la gauche sort sur 1, la droite sur 2
prop 4 (default, Active, Manual, pad 1 4 1, indiff 205, outdiff 206, color 5);
pload 3 3 ;
pload 4 4 ;


);

var z=D3_config(start);


GM_Log("Config Espaces Jouangrand 27.2 done.");
strfree(str);
mfree(start);
