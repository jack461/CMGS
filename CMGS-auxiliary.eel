/*

    Description of common parameters

*/


// The parameters : 1024 numbers, shared by all the applications of a project (their values are published in
// gmem[paramGCopy + n], see mSL_clip_lib). Each application owns a range [paramBase ... paramNMax] : it declares
// (parDcl), publishes and saves only the parameters of its range, and reads the others in gmem (read only). The first
// number of a range is not used (a security, as 0 for the Game Master). The default range is the one of the Game Master
// (its historic numbers 0 ... 255) ; another application sets its own range after this file (none : paramCount = 0)
paramGCount = 1024; // all the numbers
parBase_GP = 0; parCnt_GP = 256; // GamePlayer
parBase_ITS = 256; parCnt_ITS = 256; // Interstys
parBase_DIF = 512; parCnt_DIF = 128; // Espaces
parBase_SM = 640; parCnt_SM = 64; // ScriptMaster
parBase_MIDI = 704; parCnt_MIDI = 64; // MIDI_In, MIDIduino
// 768 ... 1023 : free
paramBase = parBase_GP;
paramCount = parCnt_GP; // The count of master/looper/players adjustable parameters
paramNMax = paramBase + paramCount - 1; // the last number of the range
parOwnErr = 0; // set(`ParamV, ...) of a parameter of another application : the error 0621, said once
// Flags for the c. parameters
i_M_Siz = 0x020000;
i_M_Spd = 0x040000;
i_M_Vol = 0x080000;
i_M_HPc = 0x100000;
i_M_Rst = 0x200000; // restart player
i_M_Upd = 0x400000; // update player parameters
i_M_Rcd = 0x000100; // modify recorded version

i_UB = 0x01000; // Control accessed in the Unit Control Block Management
i_SP = 0x02000; // show this parameter in slider blocks
i_RG = 0x04000; // show this in random generators
i_Si = i_M_Siz | i_UB; // Control influences the size of the played parts
i_Vm = i_M_Spd | i_UB; // Control influences the speed of the played part
i_dB = i_M_Vol | i_UB; // Control influences the volume of the played part
i_HP = i_M_HPc | i_UB; // About the HP Count

i_Ma = i_M_Siz | i_M_Spd | i_M_Vol |i_M_HPc ;
i_eTyp = 0xF0000; // Mask for type


