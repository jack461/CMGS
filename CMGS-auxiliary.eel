// ---------- begin of mSL_gmem_Strings.jsfx-inc (copied from CMGS-libs) ----------
/*
    mSL_gmem_Strings.jsfx-inc
    Strings exchanged between the JSFX plugins and CMGS-auxiliary.eel through gmem (GM_SHM)
    (c)Jean-Jacques Girardot

    Included by mSL_Utilities2.jsfx-inc (plugins) and by CMGS-auxiliary.eel (ReaScript : "in_eel" suppresses @init).
    Needs mSL_gmem_map.jsfx-inc (expldwstr, explavail, flagSubS...).
*/

<? in_eel != 0 ? _suppress=1; ?>
@init
<? _suppress=0; ?>

// Exchange strings between JSFX effects
/*
   Convert an array of ASCII codes of characters (in gmem[expldwstr+i])
   to a string in #sct, also returned by the function
*/
function getexpldstr(str,src)
local (ux, vz, lm)
(
    (str == 0) ? str = #sct;
    strcpy(str, "");
    lm = 256;
    (src == 0) ? (src = expldwstr; lm = explavail-1; gmem[src+lm] = 0;);
    (gmem[src] == 'strx') ? (
        src += 1;
        ux = 0; vz = gmem[src];
        while ((vz != 0) && (lm > 0)) (
            str_setchar(str, -0.25, vz, 'uc');
            lm -= 1; ux +=1; vz = gmem[src+ux];
        );
    );
    str;
);

function setexpldstr(str, dst, siz)
local (ux, lg)
(
    (dst == 0) ? (dst = expldwstr; siz = explavail;);
    lg = min(siz - 1,strlen(str));
    gmem[dst] = 'strx'; ux = 0; dst += 1;
    loop (lg,
        gmem[dst+ux] = str_getchar(str, ux, 'uc');
        ux += 1;
    );
    gmem[dst+ux] = 0;
);


// Pack a string in a gmem array, 6 chard/word
function
mSL_g6packStr(dst, str, ptre, ptmx, flnl)
local (pt, nk, pkg, fct, ch)
(
    pt = 0; nk = 6; pkg = 0; fct = 1;
    while (((ch = str_getchar(str, pt, 'cu')) != 0) && (ptre < ptmx - 4))  (
        //sprintf(#s, "       >>>  %c  %x  %d", ch, ch, ch); mSL_log(SysLogBox, #s);
        (nk <= 0) ? (
            (pkg != 0) ? (gmem[dst+ptre] = pkg; ptre += 1;) ;
            nk = 6; pkg = 0; fct = 1;
        );
        pkg += ch * fct; nk -= 1; fct *= 256; pt += 1;
    );
    (pkg != 0) ? (gmem[dst+ptre] = pkg; ptre += 1;);
    (flnl != 0) ? (
        // 4: suppress trailing spaces
        while ((flnl & 4) && (gmem[dst+ptre-1] === ' ')) (ptre -= 1;);
        // 2: no more than 2 consecutive empty lines or single space line
        ((flnl & 2) && (gmem[dst+ptre-1] === ' ') && (gmem[dst+ptre-2] === '\n')
                    && (gmem[dst+ptre-3] === ' ') && (gmem[dst+ptre-4] === '\n')
                    && (gmem[dst+ptre-5] === ' ') && (gmem[dst+ptre-6] === '\n')) ? (ptre -= 2;);
        ((flnl & 2) && (gmem[dst+ptre-1] === '\n') && (gmem[dst+ptre-2] === '\n') && (gmem[dst+ptre-3] === '\n')) ? (ptre -= 1;);
        // 1: add a line feed after the string
        (flnl & 1) ? (gmem[dst+ptre] = '\n'; ptre += 1;);
    );
    gmem[dst+ptre] = 0;
    ptre;
);


// Unpack a string from a gmem array, 6 chars/word
function mSL_g6unpackArray(str, array, ptin)
local (src, ch)
(
    (str === 0) ? str = #;
    strcpy(str, "");
    while ((src = gmem[array+ptin]) != 0) (
        while (src != 0) (
            ch = src - 256 * floor(src / 256);
            str_setchar(str, -0.25, ch, 'cu');
            src = floor(src/256);
        );
        ptin += 1;
    );
    str;
);



//======================================================>

/*
   Protected "gmem[add] = val" operation
   signal if "add == 0"
*/
function gmset(add,val)
(
    (add == 0) ? (
        gmset_lg = min(23, strlen(#section));
        gmset_ix = 0;
        loop (gmset_lg,
            gmem[expldwstr+gmset_ix] = str_getchar(#section, gmset_ix, 'c');
            gmset_ix += 1;
        );
        gmem[expldwstr+gmset_ix] = 0;
        gmem[flagSubS] = SubSection;
    );
    gmem[add]=val;
);
// ---------- end of mSL_gmem_Strings.jsfx-inc ----------

gMemFree = UGDummy + UCBSize;



function detectProjectPath()
local(ws,st,lg,ls)
(
    // Is the path ending in "/Audio" ?
    st = "/Audio"; lg = strlen(st);
    GetProjectPath(#buf); ls = strlen(#buf);
    ws = #;
    strcpy_from(ws, #buf, ls - lg);
    (strcmp(ws, st) === 0) ? (
        // Suppress this part
        strncpy(ws, #buf, ls - lg);
        strcpy(#buf, ws);
    );
    #buf;
);

// Folder of the active project file (.RPP), from EnumProjects.
// If the project has never been saved (no file yet), falls back to detectProjectPath().
function projectDir()
local(ws,ls,i,c)
(
    EnumProjects(-1, #buf); ls = strlen(#buf);
    (ls > 0) ? (
        // remove the file name : keep up to the last '/' (or '\' on Windows)
        i = ls - 1;
        while ((i > 0) && ((c = str_getchar(#buf, i)) != '/') && (c != 92)) ( i -= 1; );
        (i > 0) ? (
            ws = #;
            strncpy(ws, #buf, i);
            strcpy(#buf, ws);
        );
    ) : (
        detectProjectPath();
    );
    #buf;
);

// the text at "array" (6 characters per word, see mSL_g6packStr), from the word "ptin" : at most 2000 words in "str" (a long
// text is written in several pieces) ; the index of the next word (a word 0 ends the text)
function g6chunk(str, array, ptin)
local (src, ch, n)
(
    strcpy(str, ""); n = 0;
    while ((n < 2000) && ((src = gmem[array+ptin]) != 0)) (
        while (src != 0) (
            ch = src - 256 * floor(src / 256);
            str_setchar(str, -0.25, ch, 'cu');
            src = floor(src/256);
        );
        ptin += 1; n += 1;
    );
    ptin;
);

// the folder of the file "ffn" is created if it does not exist, when the name of the file in the project ("lp" : the length
// of the folder of the project, without the separator) has a folder
function makeFileDir(ffn, lp)
local (i, ws)
(
    i = strlen(ffn) - 1;
    while ((i > lp) && (str_getchar(ffn, i) != '/')) ( i -= 1; );
    (i > lp) ? (
        ws = #;
        strncpy(ws, ffn, i);
        RecursiveCreateDirectory(ws, 0);
    );
);
//======================================================>

// Reset Script own global variables
repeatExec = 1;  // Repeat script flag
Cmd = 0; // global value

gmem[dateRqst] = gmem[dateCfrm] = gmem[versionGMScript] = 0;
gmem[dateStrt] = gmem[dateDone] = 0;
gmem[cmndKode] = gmem[cmndPar1] = gmem[cmndPar2] = gmem[cmndPar3] = 0;
gmem[scptTrcs] = 0;
gmem[workToDo] = 0;

sprintf(#st, "GMA %d.%d.%d started: %4d/%02d/%02d %2dh%02d'%02d\"\n",
    versionGMS >> 16, (versionGMS >> 8) & 0xff, versionGMS & 0xff,
    gmem[timeYear], gmem[timeMonth], gmem[timeDay], gmem[timeHour], gmem[timeMinute], gmem[timeSecond]);
ShowConsoleMsg(#st);
projectDir(); // folder of the .RPP file
strcpy(#ppath, #buf);
sprintf(#st, "Path %s\n", #buf);
ShowConsoleMsg(#st);
// Export path in gmem
setexpldstr(#buf, 0, 0);
//getexpldstr(0,0);
//sprintf(#st, "---- %s\n", #sct);
//ShowConsoleMsg(#st);
// Signal the project path is available
gmem[thrdRqst] = 'Path';
gmem[scptPar1] = expldwstr;


