     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc878_15101671" office:name="Opérations d’édition" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">4.1 Opérations d’édition</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc878_15101671" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">7</text:a></text:p>
     <text:p text:style-name="P1"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc880_15101671" office:name="La fenêtre graphique" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">5 La fenêtre graphique</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc880_15101671" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">9</text:a></text:p>
