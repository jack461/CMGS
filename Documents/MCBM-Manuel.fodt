     <text:p text:style-name="P1"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc852_15101671" office:name="Présentation" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">1 Présentation</text:a><text:tab/><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc852_15101671" text:style-name="Internet_20_link" text:visited-style-name="Internet_20_link">3</text:a></text:p>
