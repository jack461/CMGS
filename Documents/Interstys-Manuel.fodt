      <text:p text:style-name="Table_20_Contents">en s</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table9.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">limites de la région</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table9.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Loop position, Loop Length</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table9.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">en s</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table9.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">position et longueur de la région</text:p>
