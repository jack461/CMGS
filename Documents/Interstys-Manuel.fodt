     </table:table-cell>
     <table:table-cell table:style-name="Table17.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">montrer ou cacher les curseurs génériques dans le panneau de REAPER</text:p>
     </table:table-cell>
    </table:table-row>
