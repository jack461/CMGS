      <text:p text:style-name="Table_20_Contents">20 <text:span text:style-name="Source_5f_Text">[=]</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table7.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">lecture ↔ pause</text:p>
     </table:table-cell>
