   <text:p text:style-name="First_20_paragraph">En mode délai : <text:span text:style-name="T2">Play Volume</text:span> et <text:span text:style-name="T2">Delay Offset</text:span> (le retard, en s).</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2645_848753940"/><text:bookmark-start text:name="les-entrées-de-modulation-1"/>Les entrées de modulation<text:bookmark-end text:name="__RefHeading___Toc2645_848753940"/><text:bookmark-end text:name="les-entrées-de-modulation-1"/></text:h>
   <text:p text:style-name="First_20_paragraph">Une ligne de cellules sous le pad donne les cinq entrées de modulation du reader (en mode délai, seules Offset et Volume servent) :</text:p>
   <table:table table:name="Table10" table:style-name="Table10">
    <table:table-column table:style-name="Table10.A"/>
    <table:table-column table:style-name="Table10.B"/>
    <table:table-column table:style-name="Table10.C"/>
    <table:table-column table:style-name="Table10.D"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table10.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Entrée</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table10.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Mode</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table10.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Profondeur</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table10.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Unité</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Offset</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">tous</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 5000 (défaut 2)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">ms : le retard en mode délai ; le recul de la lecture dans les autres modes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Speed</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sur une ligne</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 32 (défaut 0,1)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">vitesse (en Stretch : la hauteur)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Volume</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les deux</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 2 (défaut 0,5)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">fraction du volume</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Loop spd</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sur une ligne</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 2 (défaut 0,1)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">s/s, ajoutés à Loop speed</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Desync</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sur une ligne</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 1 (défaut 0,01)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">s, ajoutées à Desync</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Clic droit : choisir la source ; Alt + clic droit : la loi ; Shift + clic gauche : son canal ; clic gauche : bypass.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2647_848753940"/><text:bookmark-start text:name="le-module-writer"/>Le module Writer<text:bookmark-end text:name="__RefHeading___Toc2647_848753940"/><text:bookmark-end text:name="le-module-writer"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un <text:span text:style-name="T2">writer</text:span> enregistre une source dans une ligne, en boucle. Il peut remplacer l’ancien contenu ou s’y ajouter (<text:span text:style-name="T1">overdub</text:span>), ce qui donne avec un reader en mode délai un écho avec retour.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2649_848753940"/><text:bookmark-start text:name="le-pad-2"/>Le pad<text:bookmark-end text:name="__RefHeading___Toc2649_848753940"/><text:bookmark-end text:name="le-pad-2"/></text:h>
   <table:table table:name="Table11" table:style-name="Table11">
    <table:table-column table:style-name="Table11.A"/>
    <table:table-column table:style-name="Table11.B"/>
    <table:table-column table:style-name="Table11.C"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table11.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Cellule</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table11.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table11.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Souris</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Writer <text:span text:style-name="T1">n</text:span> (et son instance)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : suivant ; droit : liste</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">état : Created, Ready, Paused, Writing</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : écriture ↔ pause ; droit : menu</text:p>
     </table:table-cell>
    </table:table-row>
