     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">mode : Overdub X-fade, Overdub Sum, W-Mix</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : le suivant ; Shift + clic : le précédent</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">3</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">ligne écrite</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : liste des lignes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">4</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">durée de la ligne</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">5</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre de canaux de la ligne</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">6</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">premier canal écrit dans la ligne</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : menu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">7</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre de canaux écrits (0 : tous)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : menu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">8</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sens d’écriture (X-fade, Sum) : Forward, Backward, Fwd &amp; Bwd</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : le suivant ; Shift + clic : le précédent ; droit : menu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">10</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">source</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : menu ; gauche : premier canal</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">11</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">position d’écriture (s)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">13</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">mode W-Mix : la phase du cycle et son temps restant</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">15</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Action</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : Copy, Paste, Clear, Rewind, Reset, Create, Activate, Show, Delete</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Un writer sans ligne ou sans source reste dans l’état <text:span text:style-name="T2">Created</text:span>.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2651_848753940"/><text:bookmark-start text:name="le-recouvrement-overdub"/>Le recouvrement (overdub)<text:bookmark-end text:name="__RefHeading___Toc2651_848753940"/><text:bookmark-end text:name="le-recouvrement-overdub"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le curseur <text:span text:style-name="T2">Overdub</text:span> (−150 à 150 %) règle la part de l’ancien contenu conservée à chaque passage :</text:p>
   <text:list text:style-name="L10">
    <text:list-item>
     <text:p text:style-name="P16"><text:span text:style-name="T2">X-fade</text:span> : <text:span text:style-name="T1">nouveau = gain × (ancien × overdub + source × (1 − min(1, |overdub|)))</text:span> ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P16"><text:span text:style-name="T2">Sum</text:span> : <text:span text:style-name="T1">nouveau = ancien × overdub + gain × source</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">(<text:span text:style-name="T1">overdub</text:span> est ici la valeur du curseur divisée par 100, <text:span text:style-name="T1">gain</text:span> le gain d’enregistrement.) À 0 %, le writer remplace le contenu. Une valeur négative inverse la polarité à chaque tour. Quand le gain de la boucle dépasse 1, le contenu croîtrait sans fin : une saturation douce (tanh) le limite.</text:p>
   <text:p text:style-name="Text_20_body">Le curseur <text:span text:style-name="T2">Record Gain</text:span> (−120 à 40 dB) règle le gain de la source.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc9003_848753940"/><text:bookmark-start text:name="le-sens-decriture"/>Le sens d’écriture<text:bookmark-end text:name="__RefHeading___Toc9003_848753940"/><text:bookmark-end text:name="le-sens-decriture"/></text:h>
   <text:p text:style-name="First_20_paragraph">En modes X-fade et Sum, le writer écrit vers l’avant (<text:span text:style-name="T2">Forward</text:span>, par défaut : au bout de la ligne, il reprend au début), vers l’arrière (<text:span text:style-name="T2">Backward</text:span>), ou en aller-retour (<text:span text:style-name="T2">Fwd &amp; Bwd</text:span> : il change de sens à chaque bout de la ligne). La cellule 8 est orange quand l’écriture va vers <text:soft-page-break/>l’arrière ; en aller-retour, elle est verte quand l’écriture va vers l’avant. Un reader en mode délai lit l’échantillon écrit « retard » plus tôt, sur le trajet réel de la tête. Une boucle ne peut suivre qu’un writer qui écrit vers l’avant.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc9004_848753940"/><text:bookmark-start text:name="le-mode-w-mix"/>Le mode W-Mix<text:bookmark-end text:name="__RefHeading___Toc9004_848753940"/><text:bookmark-end text:name="le-mode-w-mix"/></text:h>
   <text:p text:style-name="First_20_paragraph">En mode <text:span text:style-name="T2">W-Mix</text:span>, le writer ne fait pas de recouvrement : il écrit par cycles. Chaque cycle choisit une position au hasard dans la ligne et un sens (en avant avec la probabilité (1 + Direction) / 2), puis enchaîne un fondu d’entrée (la source remplace peu à peu la ligne), un plateau (la source remplace la ligne), un fondu de sortie, et une attente (la source est ignorée). Desync écarte chaque canal d’une position au hasard (jusqu’à « ± Desync / 2 % » de la ligne ; à 100 % : n’importe où). Chaque réglage est pris au début de sa phase ; la cellule 13 montre la phase et son temps restant ; un plateau ou une attente de 0 est sauté.</text:p>
   <table:table table:name="Table103" table:style-name="Table103">
    <table:table-column table:style-name="Table103.A"/>
    <table:table-column table:style-name="Table103.B"/>
    <table:table-column table:style-name="Table103.C"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table103.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Curseur</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table103.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Plage (défaut)</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table103.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Rôle</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Fade</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0,001 à 10 s (0,05 s)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">durée commune du fondu d’entrée et du fondu de sortie</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Plateau</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 100 s (1 s)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">durée du plateau</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Wait</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 100 s (1 s)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">durée de l’attente</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Direction</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">−1 à 1 (1)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sens : −1 toujours en arrière, 1 toujours en avant</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Desync</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 100 % (0)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table103.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">dispersion des canaux</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2653_848753940"/><text:bookmark-start text:name="les-entrées-de-modulation-2"/>Les entrées de modulation<text:bookmark-end text:name="__RefHeading___Toc2653_848753940"/><text:bookmark-end text:name="les-entrées-de-modulation-2"/></text:h>
   <table:table table:name="Table12" table:style-name="Table12">
    <table:table-column table:style-name="Table12.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table12.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Entrée</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table12.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Profondeur</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table12.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Unité</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Gain</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 60 (défaut 6)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">dB</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Overdub</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 150 (défaut 20)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">%</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Fade, Plateau, Wait</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 8 (défaut 1)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">octaves</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Dir.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 2 (défaut 0,5)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">ajouté à Direction</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Desync</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 100 (défaut 20)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table12.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">%</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Les cinq dernières entrées n’apparaissent qu’en mode W-Mix. Clic droit : choisir la source ; Alt + clic droit : la loi ; Shift + clic gauche : son canal ; clic gauche : bypass.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2655_848753940"/><text:bookmark-start text:name="le-module-effect"/>Le module Effect<text:bookmark-end text:name="__RefHeading___Toc2655_848753940"/><text:bookmark-end text:name="le-module-effect"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un <text:span text:style-name="T2">effet</text:span> lit une ou plusieurs sources, les traite, et écrit le résultat dans sa sortie. Chaque effet a un <text:span text:style-name="T2">type</text:span>, choisi en cellule 1 ; le pad change selon le type.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2657_848753940"/><text:bookmark-start text:name="la-partie-commune"/>La partie commune<text:bookmark-end text:name="__RefHeading___Toc2657_848753940"/><text:bookmark-end text:name="la-partie-commune"/></text:h>
   <table:table table:name="Table13" table:style-name="Table13">
    <table:table-column table:style-name="Table13.A"/>
    <table:table-column table:style-name="Table13.B"/>
    <table:table-column table:style-name="Table13.C"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table13.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Cellule</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table13.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table13.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Souris</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Effect <text:span text:style-name="T1">n</text:span> (et son instance)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : suivant ; droit : liste</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">type</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : menu (crée l’effet si besoin)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">phase : Std, Pre, Post</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : suivante ; droit : menu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">3</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">On, Off, Bypass</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : On ↔ Off ; droit : Bypass ↔ On</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">4</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre de canaux</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : menu (1 à 128)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">5</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">sortie : câble propre, <text:span text:style-name="Source_5f_Text">Out</text:span> ou un bus</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : menu ; gauche : premier canal</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">6</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">état : OK, erreur, <text:span text:style-name="Source_5f_Text">...</text:span> (pas encore vérifié)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">7</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Action</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : Copy, Paste, Clear, Auto gains, Create, Show, Delete</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">23</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">limiteur : Off, ou la réduction de gain en dB</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table13.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">clic : en service ou non</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:list text:style-name="L11">
    <text:list-item>
     <text:p text:style-name="P17"><text:span text:style-name="T2">Off</text:span> : l’effet n’est pas exécuté ; son câble propre devient silencieux.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P17"><text:span text:style-name="T2">Bypass</text:span> : la première source passe telle quelle vers la sortie (un LFO se tait).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P17">Le <text:span text:style-name="T2">limiteur automatique</text:span> (pas pour le LFO) protège la sortie : attaque 5 ms, relâchement 1,5 s. Il est en service par défaut pour une Saturation, une Matrix, un Flanger et un Chorus. La cellule passe au doré dès que la réduction dépasse 0,1 dB.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Le choix d’un nouveau type donne ses valeurs par défaut aux réglages du type (par exemple 1000 Hz, Q 0,707 et passe-bas pour un Filter).</text:p>
   <text:p text:style-name="Text_20_body">Les types Mover, Action et Script sont réservés : ils ne sont pas encore exécutés (erreur 2706).</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2659_848753940"/><text:bookmark-start text:name="mixer"/>Mixer<text:bookmark-end text:name="__RefHeading___Toc2659_848753940"/><text:bookmark-end text:name="mixer"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le <text:span text:style-name="T2">Mixer</text:span> additionne jusqu’à <text:span text:style-name="T2">8 sources</text:span>, chacune avec son gain.</text:p>
   <text:list text:style-name="L12">
    <text:list-item>
     <text:p text:style-name="P18">Ligne 1 (cellules 8 à 15) : les 8 sources. Clic droit : choisir la source ; clic gauche : son premier canal.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P18">Curseurs <text:span text:style-name="T2">Gain 1</text:span> à <text:span text:style-name="T2">Gain 8</text:span> (−120 à 20 dB), pour les sources branchées.</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2661_848753940"/><text:bookmark-start text:name="auto-mixer"/>Auto Mixer<text:bookmark-end text:name="__RefHeading___Toc2661_848753940"/><text:bookmark-end text:name="auto-mixer"/></text:h>
   <text:p text:style-name="First_20_paragraph">L’<text:span text:style-name="T2">Auto Mixer</text:span> est un Mixer dont les gains sont calculés : chacune des <text:span text:style-name="T1">N</text:span> sources branchées reçoit −20·log10(<text:span text:style-name="T1">N</text:span>) dB (−6,02 dB pour deux sources), si bien que la somme garde le niveau d’une source. Les gains sont recalculés à chaque changement de source ; l’action <text:span text:style-name="T2">Auto gains</text:span> du menu les recalcule aussi pour un Mixer.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2663_848753940"/><text:bookmark-start text:name="lfo"/>LFO<text:bookmark-end text:name="__RefHeading___Toc2663_848753940"/><text:bookmark-end text:name="lfo"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le <text:span text:style-name="T2">LFO</text:span> (oscillateur basse fréquence) n’a pas de source : il produit un signal de modulation <text:soft-page-break/>dans sa sortie, sur autant de canaux que voulu.</text:p>
   <text:list text:style-name="L13">
    <text:list-item>
     <text:p text:style-name="P19">Cellule 8 : la forme : Sine, Triangle, Saw up, Saw down, Square, Curve (clic gauche : la suivante ; clic droit : menu).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P19">Cellule 9 (forme Curve) : la courbe, du module Curves (clic gauche : la suivante ; clic droit : menu). Elle est lue en boucle, une période par cycle ; une courbe absente rend le LFO muet (cellule grise).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P19">Curseurs : <text:span text:style-name="T2">LFO Frequency</text:span> (0,001 à 10 000 Hz), <text:span text:style-name="T2">LFO Amplitude</text:span> (0 à 10), <text:span text:style-name="T2">LFO Offset</text:span> (−10 à 10, ajouté au signal), <text:span text:style-name="T2">LFO Phase spread</text:span> (0 à 1 : le décalage de phase entre deux canaux successifs, en tours).</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2665_848753940"/><text:bookmark-start text:name="filter"/>Filter<text:bookmark-end text:name="__RefHeading___Toc2665_848753940"/><text:bookmark-end text:name="filter"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le <text:span text:style-name="T2">Filter</text:span> filtre une source (cellule 8 : clic droit, la source ; clic gauche, son premier canal).</text:p>
   <text:list text:style-name="L14">
    <text:list-item>
     <text:p text:style-name="P20">Cellule 9 : le <text:span text:style-name="T2">mode</text:span> : LP 1 pole, HP 1 pole (filtres du premier ordre), Low pass, High pass, Band pass, Notch (biquads). Clic gauche : le suivant ; clic droit : menu.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P20">Cellule 10 : la <text:span text:style-name="T2">pente</text:span> : 1, 2, 4, 8, 16 ou 32 étages (6 à 192 dB/octave pour un premier ordre, 12 à 384 dB/octave pour un passe-bas ou passe-haut biquad ; clic gauche : plus raide ; clic droit : moins raide). Les passe-bas et passe-haut à plusieurs étages sont des Butterworth dont le dernier étage porte la résonance ; les premiers ordres ont aussi une résonance à partir de 4 étages. Le calcul coûte plus cher avec le nombre d’étages.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P20">Curseurs : <text:span text:style-name="T2">Cutoff</text:span> (1 à 20 000 Hz), <text:span text:style-name="T2">Resonance</text:span> (Q, 0,1 à 1000), <text:span text:style-name="T2">Gain 1</text:span> (gain d’entrée).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P20">Entrées de modulation (ligne 2) : <text:span text:style-name="T2">Cutoff</text:span> (en octaves, profondeur 0 à 10, défaut 2) et <text:span text:style-name="T2">Reso</text:span> (en octaves, profondeur 0 à 4, défaut 1).</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2667_848753940"/><text:bookmark-start text:name="saturation"/>Saturation<text:bookmark-end text:name="__RefHeading___Toc2667_848753940"/><text:bookmark-end text:name="saturation"/></text:h>
   <text:p text:style-name="First_20_paragraph">La <text:span text:style-name="T2">Saturation</text:span> déforme une source par une courbe non linéaire, avec suréchantillonnage et ADAA (« <text:span text:style-name="T10">Antiderivative Anti-Aliasing », </text:span>un antirepliement peu coûteux <text:span text:style-name="T10">en CPU</text:span>).</text:p>
   <text:list text:style-name="L15">
    <text:list-item>
     <text:p text:style-name="P21">Cellule 9 : le <text:span text:style-name="T2">mode</text:span> :</text:p>
    </text:list-item>
   </text:list>
   <table:table table:name="Table14" table:style-name="Table14">
    <table:table-column table:style-name="Table14.A"/>
    <table:table-column table:style-name="Table14.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table14.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Mode</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table14.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Courbe</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Soft (tanh)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">saturation douce</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Hard clip</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écrêtage à ±1</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Fold</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">repli triangulaire (<text:span text:style-name="T1">wavefolder</text:span>)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Sine fold</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">repli sinusoïdal</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">x − A sin(nx)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">½·(x − A·sin(n·x·π/2)) : ordre <text:span text:style-name="T1">n</text:span>, amplitude <text:span text:style-name="T1">A</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Chebyshev</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">polynôme de Tchebychev <text:span text:style-name="T1">T</text:span><text:span text:style-name="T11">n</text:span> (ordre réel <text:span text:style-name="T1">n</text:span>)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Cheb. sum</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">somme pondérée de <text:span text:style-name="T1">T</text:span><text:span text:style-name="T11">1</text:span> à <text:span text:style-name="T1">T</text:span><text:span text:style-name="T11">16</text:span>, étirée</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Curve</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">une courbe du module Curves (cellule 11)</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:list text:style-name="L16">
    <text:list-item>
     <text:p text:style-name="P22">Cellule 10 : le <text:span text:style-name="T2">suréchantillonnage</text:span> : 1, 2, 4 ou 8 fois. Une nouvelle Saturation est en 2x, avec l’ADAA.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 11 (mode Cheb. sum) : des <text:span text:style-name="T2">préréglages des harmoniques</text:span> : Fundamental only, Odd 1/k, All 1/k, Odd 1/k², Even 1/k, Random, Normalize, Clear.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 11 (mode Curve) : la courbe (clic gauche : la suivante ; clic droit : menu). Une enveloppe (Envelope, H-Envelope) ou une forme d’onde (Waveform) est la courbe de transfert sur [−1, 1] ; un quart ou une moitié d’onde (Q-Waveform, H-Waveform) se répète au-delà, comme un repli (une Q-Waveform droite redonne le mode Fold).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 12 : l’<text:span text:style-name="T2">ADAA</text:span> (On / Off, clic ; modes Soft, Hard, Fold, Sine fold, x − A sin ; grisée dans les autres) : la courbe est remplacée par sa moyenne entre deux <text:soft-page-break/>échantillons successifs, calculée par sa primitive ; le repliement des aigus diminue fortement, pour bien moins de calcul que le suréchantillonnage. Le filtre anti-repliement est alors d’ordre 4 (8 sans ADAA). Sans suréchantillonnage, l’ADAA atténue les aigus (−12 dB à 20 kHz à 48 kHz) : en 2x, −2 dB seulement.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Curseurs : <text:span text:style-name="T2">Drive</text:span> (0 à 96 dB), <text:span text:style-name="T2">Bias</text:span> (−4 à 4), <text:span text:style-name="T2">Mix</text:span> (0 à 100 % de son traité), <text:span text:style-name="T2">Output</text:span> (−48 à 24 dB), <text:span text:style-name="T2">Order</text:span> (modes x − A sin et Chebyshev, 0 à 32), <text:span text:style-name="T2">Sine amount</text:span> (<text:span text:style-name="T1">A</text:span>, −8 à 8), <text:span text:style-name="T2">Stretch</text:span> (mode Cheb. sum, 0 à 16), <text:span text:style-name="T2">Gain 1</text:span> (gain d’entrée).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">En mode Cheb. sum, une zone graphique montre les <text:span text:style-name="T2">16 poids</text:span> des harmoniques, entre −1 et 1 : clic gauche ou glissé pour régler un poids, clic droit pour le mettre à 0 ; le poids sous la souris est affiché.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Entrées de modulation : <text:span text:style-name="T2">Drive</text:span> (dB, profondeur 0 à 96), <text:span text:style-name="T2">Bias</text:span> (0 à 4), <text:span text:style-name="T2">Order</text:span> (l’ordre, ou l’étirement en mode Cheb. sum ; 0 à 32).</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Un filtre anti-repliement et un filtre de composante continue (10 Hz) suivent la courbe. Sans ADAA, la courbe Soft est une fraction rationnelle très proche de la tanh (écart inférieur à 0,0001).</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc9012_848753940"/><text:bookmark-start text:name="matrix"/>Matrix<text:bookmark-end text:name="__RefHeading___Toc9012_848753940"/><text:bookmark-end text:name="matrix"/></text:h>
   <text:p text:style-name="First_20_paragraph">La <text:span text:style-name="T2">Matrix</text:span> est un réseau de retards bouclés (FDN) : une ligne de retard par canal de l’effet (jusqu’à 128), dont les sorties repassent par une matrice avant de revenir dans les lignes. Le canal c de la source entre dans la ligne c, la sortie c est la ligne c : avec un haut-parleur par canal, chaque haut-parleur a sa ligne. Elle va de la réverbération dense aux résonances métalliques, aux échos qui tournent entre les haut-parleurs et aux masses qui enflent.</text:p>
   <text:list text:style-name="L15">
    <text:list-item>
     <text:p text:style-name="P21">Cellule 9 : la <text:span text:style-name="T2">matrice</text:span> (clic gauche : la suivante ; clic droit : menu) :</text:p>
    </text:list-item>
   </text:list>
   <table:table table:name="Table14b" table:style-name="Table14b">
    <table:table-column table:style-name="Table14b.A"/>
    <table:table-column table:style-name="Table14b.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table14b.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Matrice</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table14b.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table14b.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Householder</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14b.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">chaque ligne reçoit un peu des autres (2 / N) : avec beaucoup de canaux, chaque haut-parleur garde sa traîne, qui déborde lentement ; la diffusion règle ce couplage (0 : des peignes indépendants)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14b.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Hadamard</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14b.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">toutes les lignes mélangées à chaque passage : la traîne la plus dense ; le nombre de lignes est porté à la puissance de 2 supérieure (les lignes ajoutées sont internes, sans entrée ni sortie)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14b.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Ring</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14b.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">des rotations entre lignes voisines (c et c + 1, la dernière avec la première), sans perte : la diffusion règle l’angle ; à 2, le son passe à la ligne suivante à chaque passage, les échos tournent autour des haut-parleurs ; à −2, dans l’autre sens</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:list text:style-name="L16">
    <text:list-item>
     <text:p text:style-name="P22">Cellule 10 : la <text:span text:style-name="T2">boucle</text:span> (clic gauche : la suivante ; clic droit : menu) : <text:span text:style-name="T2">Decay</text:span> (−60 dB après la durée Decay), <text:span text:style-name="T2">Freeze</text:span> (sans perte et l’entrée coupée : le son se fige), <text:span text:style-name="T2">Grow</text:span> (+60 dB par durée Decay : la boucle enfle et sature).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 11 : le nombre de lignes et le retard le plus long possible : la mémoire est partagée entre les lignes, moins de lignes permettent des retards plus longs.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 12 : la <text:span text:style-name="T2">graine</text:span> des retards (clic gauche : +1 ; clic droit : −1) : un autre tirage.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 13 : la <text:span text:style-name="T2">répartition</text:span> des retards entre Delay min et Delay max (clic gauche : la suivante ; clic droit : menu) : Geometric, Linear, Random (des retards tous différents), Harmonic (des multiples du retard le plus court : un accord), Equal (toutes les lignes <text:soft-page-break/>au retard le plus court : un seul peigne, le plus métallique).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 14 : l’<text:span text:style-name="T2">entrée</text:span> (clic) : Input direct (le canal c dans la ligne c) ou Input spread (le canal 0 dans toutes les lignes, signes alternés : une source mono remplit tous les canaux).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 15 : « Loop sat. » quand la boucle peut croître (Grow, ou une diffusion hors de [0, 1] en Householder) : elle passe alors par une saturation (une tanh), qui la borne.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Curseurs : <text:span text:style-name="T2">Decay</text:span> (0,01 à 1000 s), <text:span text:style-name="T2">Damping</text:span> (un passe-bas dans la boucle : les aigus s’éteignent plus vite), <text:span text:style-name="T2">High pass</text:span> (un passe-haut dans la boucle : une traîne fine, qui siffle), <text:span text:style-name="T2">Mix</text:span> (0 à 100 % de son traité), <text:span text:style-name="T2">Delay min</text:span> et <text:span text:style-name="T2">Delay max</text:span> (0,02 ms à 20 s), <text:span text:style-name="T2">Diffusion</text:span> (−2 à 2 ; pas en Hadamard), <text:span text:style-name="T2">Wow</text:span> (la modulation des retards, 0 à 2000 ms), <text:span text:style-name="T2">Wow rate</text:span> (0,001 à 1000 Hz : à vitesse audio, des bandes latérales, comme une modulation de fréquence), <text:span text:style-name="T2">Wow spread</text:span> (le déphasage de la modulation d’une ligne à la suivante, en tours), <text:span text:style-name="T2">Glide</text:span> (le glissement d’un retard vers sa nouvelle valeur, 0 à 10 s), <text:span text:style-name="T2">Gain 1</text:span> (gain d’entrée).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Entrées de modulation : <text:span text:style-name="T2">Decay</text:span> et <text:span text:style-name="T2">Damping</text:span> (en octaves), <text:span text:style-name="T2">Diffusion</text:span> (pas en Hadamard).</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Le limiteur automatique est en service par défaut. Après un bypass, la Matrix repart du silence. Elle coûte une vingtaine d’opérations par ligne et par échantillon (Hadamard un peu plus) : 80 lignes restent légères. Les recettes de <text:span text:style-name="Source_5f_Text">Scripts/Algorithms</text:span> l’emploient directement (voir « La bibliothèque d’algorithmes »).</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc9014_848753940"/><text:bookmark-start text:name="flanger-et-chorus"/>Flanger et Chorus<text:bookmark-end text:name="__RefHeading___Toc9014_848753940"/><text:bookmark-end text:name="flanger-et-chorus"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le <text:span text:style-name="T2">Flanger</text:span> et le <text:span text:style-name="T2">Chorus</text:span> sont un même effet de retards modulés : une ligne de retard par canal de la source (jusqu’à 128), lue par une à seize voix dont le retard est balayé. Le Chorus n’en diffère que par ses valeurs par défaut : retard 15 ms, balayage 4 ms, 0,6 Hz, sans réinjection, 3 voix, Jitter 0,3 (le Flanger : 2 ms, 1,8 ms, 0,2 Hz, réinjection 0,7, une voix). Les plages sont très larges : du flanger classique aux peignes métalliques, aux balayages sans fin, aux transpositions en boucle et à la modulation de phase à vitesse audio.</text:p>
   <text:list text:style-name="L15">
    <text:list-item>
     <text:p text:style-name="P21">Cellule 9 : le <text:span text:style-name="T2">mode</text:span> (clic gauche : le suivant ; clic droit : menu) :</text:p>
    </text:list-item>
   </text:list>
   <table:table table:name="Table14c" table:style-name="Table14c">
    <table:table-column table:style-name="Table14c.A"/>
    <table:table-column table:style-name="Table14c.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table14c.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Mode</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table14c.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Effet</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table14c.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Classic</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14c.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le son direct plus la ligne lue au retard balayé : les creux du peigne glissent ; un Mix négatif inverse le son traité (d’autres creux)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14c.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Through-zero</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14c.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le son direct est lui-même la ligne lue au retard Delay ; les voix balaient autour de lui et le traversent : avec un Mix de −50 %, l’annulation est totale au passage (le « jet » des flangers à bandes) ; Sweep au plus égal à Delay : la traversée est complète</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table14c.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Barber up, Barber down</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table14c.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le retard de chaque voix (deux au moins) descend (up) ou monte (down) en rampe, dans une fenêtre qui s’ouvre et se ferme ; les fenêtres se relaient : un balayage qui monte ou descend sans fin. Avec des retards longs, c’est un transpositeur : le rapport de hauteur vaut 1 ± 2 × Sweep (s) × Rate ; dans la boucle (Feedback), chaque écho est transposé à nouveau</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:list text:style-name="L16">
    <text:list-item>
     <text:p text:style-name="P22"><text:soft-page-break/>Cellule 10 : la <text:span text:style-name="T2">forme</text:span> du balayage (clic gauche : la suivante ; clic droit : menu) : Sine, Triangle, Saw up, Saw down, Square, Curve (une courbe du module Curves, cellule 11), Random (une valeur au hasard à chaque période, rejointe en douceur), Hold (une valeur au hasard à chaque période, rejointe pendant le Glide : des sauts). Elle est grisée dans les modes barber (leurs rampes).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 11 : la courbe de la forme Curve (clic gauche : la suivante qui existe ; clic droit : menu).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 12 : le nombre de <text:span text:style-name="T2">voix</text:span> par canal, de 1 à 16 (clic gauche : +1 ; clic droit : −1) : le son traité est leur moyenne ; leurs phases sont décalées d’un N-ième de tour.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 13 : la <text:span text:style-name="T2">graine</text:span> des écarts entre les voix (Jitter ; clic gauche : +1 ; clic droit : −1).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 14 : le retard le plus long possible (la mémoire est partagée entre les canaux).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Cellule 15 : « Loop sat. » quand la boucle peut croître (Feedback de 1 ou plus, ou un mode barber avec du Jitter) : elle passe alors par une saturation (une tanh), qui la borne ; au-delà de 1, la boucle s’entretient et chante seule.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Curseurs : <text:span text:style-name="T2">Delay</text:span> (0,01 à 2000 ms), <text:span text:style-name="T2">Sweep</text:span> (l’amplitude du balayage, 0 à 2000 ms : le retard va de Delay − Sweep à Delay + Sweep, un échantillon au moins), <text:span text:style-name="T2">Rate</text:span> (0 à 5000 Hz : à vitesse audio, le balayage module la phase du son, des bandes latérales inharmoniques, un timbre de cloche), <text:span text:style-name="T2">Feedback</text:span> (−2 à 2), <text:span text:style-name="T2">Mix</text:span> (−100 à 100 % : (1 − |Mix|) son direct + Mix son traité ; à 100 %, le son traité seul : un vibrato), <text:span text:style-name="T2">Spread</text:span> (le déphasage du balayage d’un canal au suivant, en tours : il tourne entre les haut-parleurs), <text:span text:style-name="T2">Cross</text:span> (la part du canal suivant dans la réinjection, −1 à 1 ; négative : celle du précédent ; les échos passent d’un haut-parleur à l’autre), <text:span text:style-name="T2">Jitter</text:span> (0 à 1 : les écarts des vitesses, jusqu’à ±100 %, et des retards, jusqu’à ±50 %, entre les voix), <text:span text:style-name="T2">Damping</text:span> et <text:span text:style-name="T2">High pass</text:span> (dans la boucle ; Damping à 24000 Hz : aucun), <text:span text:style-name="T2">Glide</text:span> (le glissement du retard et du balayage vers leurs nouvelles valeurs, et celui des sauts de la forme Hold), <text:span text:style-name="T2">Gain 1</text:span> (gain d’entrée).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P22">Entrées de modulation : <text:span text:style-name="T2">Delay</text:span> et <text:span text:style-name="T2">Rate</text:span> (en octaves), <text:span text:style-name="T2">Feedback</text:span>.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Le limiteur automatique est en service par défaut. Après un bypass, l’effet repart du silence. Il coûte une quinzaine d’opérations par voix, par canal et par échantillon : seize voix sur beaucoup de canaux pèsent plus lourd. Les recettes <text:span text:style-name="Source_5f_Text">Flanger-…</text:span> et <text:span text:style-name="Source_5f_Text">Chorus-…</text:span> de <text:span text:style-name="Source_5f_Text">Scripts/Algorithms</text:span> l’emploient directement.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc9005_848753940"/><text:bookmark-start text:name="le-module-curves"/>Le module Curves<text:bookmark-end text:name="__RefHeading___Toc9005_848753940"/><text:bookmark-end text:name="le-module-curves"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le module <text:span text:style-name="T2">Curves</text:span> dessine des courbes : des <text:span text:style-name="T2">enveloppes</text:span> (y de 0 à 1) et des <text:span text:style-name="T2">formes d’onde</text:span> (y de −1 à 1), 64 au plus, de 2 à 128 points chacune. Elles servent à la forme Curve d’un LFO, au mode Curve d’une Saturation, à l’enveloppe des grains (mode Grains d’un reader) et à la forme Curve d’une loi de modulation. Huit vues, Curves A à H, montrent chacune la courbe de son choix (plusieurs vues peuvent montrer, <text:span text:style-name="T10">voire éditer,</text:span> la même). Les courbes sont sauvées avec le projet.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc9006_848753940"/><text:bookmark-start text:name="le-pad-curves"/>Le pad<text:bookmark-end text:name="__RefHeading___Toc9006_848753940"/><text:bookmark-end text:name="le-pad-curves"/></text:h>
   <table:table table:name="Table104" table:style-name="Table104">
    <table:table-column table:style-name="Table104.A"/>
    <table:table-column table:style-name="Table104.B"/>
    <table:table-column table:style-name="Table104.C"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table104.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Cellule</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table104.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table104.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Souris</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Curve n</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : suivante ; Shift : précédente ; droit : liste</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le nom de la courbe, ou (no name)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : saisir le nom</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le type</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : suivant ; Shift : précédent</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">3</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le nombre de points</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">4</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Periodic ou Not periodic (Envelope, Waveform)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : l’autre</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">5</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">la grille : No grid, 4, 8, 16, 32</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : la suivante ; Shift : la précédente</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">6</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Undo</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : annuler la dernière modification ; de nouveau : la refaire</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">7</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Action</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table104.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche ou droit : New envelope, New half envelope, New waveform, New quarter waveform, New half waveform, Dump in the log, Export to a file, Export all the curves, Sustain : the selected point, Sustain : none, Delete</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Sous le pad, la zone graphique montre la courbe ; une ligne de texte donne ensuite x et y sous la souris, ou ceux du point sélectionné. Le nom d’une courbe a de 1 à 31 caractères ; il est unique, et les majuscules comptent.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc9007_848753940"/><text:bookmark-start text:name="les-types-de-courbe"/>Les types<text:bookmark-end text:name="__RefHeading___Toc9007_848753940"/><text:bookmark-end text:name="les-types-de-courbe"/></text:h>
   <table:table table:name="Table105" table:style-name="Table105">
    <table:table-column table:style-name="Table105.A"/>
    <table:table-column table:style-name="Table105.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table105.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Type</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table105.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Partie dessinée</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Envelope (Env)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">toute l’enveloppe</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">H-Envelope (HEnv)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">la montée ; la descente est <text:span text:style-name="T10">automatiquement calculée comme </text:span>son miroir</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Waveform (Wave)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">toute la période</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Q-Waveform (QWave)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">un quart de période, à partir de (0, 0) ; le reste <text:span text:style-name="T10">est obtenu </text:span>par symétrie</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">H-Waveform (HWave)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table105.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">une demi-période, nulle aux deux bouts ; l’autre moitié par symétrie (−x, −y)</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Les points ont des x croissants, de 0 à 1 ; le premier et le dernier restent en x = 0 et x = 1 <text:span text:style-name="T10">respectivement</text:span>. Chaque point porte la courbure c (de −1 à 1) du segment qui part de lui : 0 donne un segment droit, c et −c des arcs symétriques. Une courbe périodique (Envelope, Waveform) finit au y de son début.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc9008_848753940"/><text:bookmark-start text:name="la-souris-curves"/><text:soft-page-break/>La souris<text:bookmark-end text:name="__RefHeading___Toc9008_848753940"/><text:bookmark-end text:name="la-souris-curves"/></text:h>
   <text:list text:style-name="L8">
    <text:list-item>
     <text:p text:style-name="P13">clic gauche sur un point : il est sélectionné et suit la souris tant que le bouton est enfoncé ; les points sélectionnés bougent ensemble (en x entre leurs voisins non sélectionnés ; le premier et le dernier, en y seulement) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">Shift + clic sur un point : ajoute à la sélection les points depuis le premier point sélectionné ; Cmd + clic : ajoute le point à la sélection, ou l’en retire ; Cmd + A : sélectionne tous les points ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">clic gauche près de la courbe, entre deux points, puis glissé vertical : la courbure du segment (un clic sans bouger : 0) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">clic gauche ailleurs : un nouveau point, sélectionné ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">clic droit sur un point : le supprime, ou toute la sélection s’il en fait partie (jamais le premier ni le dernier point) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">Shift pendant un déplacement : mouvement fin (1/10, sans grille).</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T2">Le point de sustain</text:span> (enveloppes seulement) sépare la montée (fade-in) de la descente (fade-out) ; s<text:span text:style-name="T12">a coordonnée</text:span> « y » est le niveau du plateau. La touche « s », ou « Action › Sustain : the selected point », en fait le point sélectionné (la touche « s » de nouveau : <text:span text:style-name="T10">suppression du point</text:span> de sustain). Un cadre orange et une ligne verticale le montrent.</text:p>
   <text:p text:style-name="Text_20_body">Touches, sous la souris : « d » écrit la courbe dans le journal (dans la syntaxe de la table), « s » choisit le point de sustain, Cmd + A sélectionne tous les points.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc9009_848753940"/><text:bookmark-start text:name="exporter-et-importer"/>Exporter et importer<text:bookmark-end text:name="__RefHeading___Toc9009_848753940"/><text:bookmark-end text:name="exporter-et-importer"/></text:h>
   <text:p text:style-name="First_20_paragraph">« Action › Export to a file » écrit la courbe dans un fichier du dossier du projet, <text:span text:style-name="Source_5f_Text">Curve-nom-date.mSL</text:span> (Export all the curves : <text:span text:style-name="Source_5f_Text">Curves-date.mSL</text:span>) ; GMAuxiliary.eel doit tourner. Ce fichier est un script mSL (une table) : déposé sur Interstys, il recrée les courbes, avec les mêmes noms (une courbe sans nom reprend son numéro).</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2669_848753940"/><text:bookmark-start text:name="le-module-globals"/>Le module Globals<text:bookmark-end text:name="__RefHeading___Toc2669_848753940"/><text:bookmark-end text:name="le-module-globals"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le module <text:span text:style-name="T2">Globals</text:span> regroupe les réglages généraux.</text:p>
   <table:table table:name="Table15" table:style-name="Table15">
    <table:table-column table:style-name="Table15.A"/>
    <table:table-column table:style-name="Table15.B"/>
    <table:table-column table:style-name="Table15.C"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table15.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Cellule</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table15.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table15.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Souris</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Globals</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre de canaux de la piste</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Track Samples : Merge (vert), Ignore (orange), Pass (bleu)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : suivant ; droit : menu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">3 à 6</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre de lignes, readers, writers, effets</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">7</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Action</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table15.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : Start all (relance les readers et les writers arrêtés ou en pause ; un reader arrêté repart de son début), Stop all, Pause all, Resume all (ceux en pause seulement), Rewind all, Mute all (les readers), Unmute all (supprime aussi tous les solos), Clear all, Delete all structures</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Curseurs : <text:span text:style-name="T2">Input Gain</text:span> (en mode Merge) et <text:span text:style-name="T2">Output Volume</text:span> (en modes Merge et Ignore), de −120 à 40 dB. Le sens des modes Merge, Ignore et Pass est décrit au chapitre « Principes ».</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T2">Delete all structures</text:span> supprime toutes les lignes, tous les readers, writers et effets.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2671_848753940"/><text:bookmark-start text:name="le-module-controls"/>Le module Controls<text:bookmark-end text:name="__RefHeading___Toc2671_848753940"/><text:bookmark-end text:name="le-module-controls"/></text:h>
   <text:p text:style-name="First_20_paragraph">Interstys déclare <text:span text:style-name="T2">64 curseurs automatisables</text:span> (sliders 1 à 64 de JSFX, ses seuls curseurs), <text:span text:style-name="T12">variant </text:span>de −1 à 1. Chacun écrit une cellule de contrôle, <text:span text:style-name="Source_5f_Text">Ctl 1</text:span> à <text:span text:style-name="Source_5f_Text">Ctl 64</text:span>, que les modules peuvent prendre comme source (menu des sources, sous-menu « Controls »). Ces curseurs peuvent être automatisés par des enveloppes de REAPER, appris par un contrôleur MIDI, ou pilotés par un autre plug-in.</text:p>
   <text:p text:style-name="Text_20_body">Le module <text:span text:style-name="T2">Controls</text:span> montre ces curseurs par pages de 8 : la cellule 0 porte le titre, les cellules suivantes choisissent la page (clic gauche). Un clic droit sur un curseur le remet à 0.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2673_848753940"/><text:bookmark-start text:name="le-module-patch"/>Le module Patch<text:bookmark-end text:name="__RefHeading___Toc2673_848753940"/><text:bookmark-end text:name="le-module-patch"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le module <text:span text:style-name="T2">Patch</text:span> montre l’état des câbles.</text:p>
   <text:list text:style-name="L17">
    <text:list-item>
     <text:p text:style-name="P23">Ligne 1 : les vues <text:span text:style-name="T2">In</text:span>, <text:span text:style-name="T2">Out</text:span>, <text:span text:style-name="T2">Buses</text:span>, <text:span text:style-name="T2">Controls</text:span>, <text:span text:style-name="T2">Cables</text:span> (clic gauche), la <text:span text:style-name="T2">page</text:span> (clic gauche : suivante ; clic droit : précédente), et le nombre de <text:span text:style-name="T2">problèmes</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P23">La grille : une cellule par entrée, par sortie, par bus, par contrôle ou par câble propre. Couleurs : <text:span text:style-name="T2">vert</text:span> écrit et lu, <text:span text:style-name="T2">orange</text:span> écrit mais pas lu, <text:span text:style-name="T2">rouge</text:span> lu mais jamais écrit (un bus), <text:span text:style-name="T2">gris</text:span> inutilisé.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P23">Le texte : pour la cellule sous la souris, sa valeur, qui l’écrit et qui la lit.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Les problèmes comptés sont : les connexions invalides, les bus lus mais jamais écrits, les câbles propres que personne ne lit.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2675_848753940"/><text:bookmark-start text:name="le-module-instances"/>Le module Instances<text:bookmark-end text:name="__RefHeading___Toc2675_848753940"/><text:bookmark-end text:name="le-module-instances"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le module <text:span text:style-name="T2">Instances</text:span> montre les instances d’algorithmes (voir « Les algorithmes »).</text:p>
   <text:list text:style-name="L18">
    <text:list-item>
     <text:p text:style-name="P24">Ligne 1 : le nombre d’instances et de modèles ; cellule 7, <text:span text:style-name="T2">Action</text:span> (clic droit) : <text:span text:style-name="T2">Dump all</text:span> (le Dump de chaque instance dans le journal), <text:span text:style-name="T2">Templates in the log</text:span> (chaque modèle avec ses déclarations), <text:span text:style-name="T2">Free all instances</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P24">La grille : une cellule par instance, à la place de son numéro, « nom : Modèle » (verte ; dorée si elle est sélectionnée). Clic gauche : sélectionner ; clic droit : <text:span text:style-name="T2">Dump</text:span> ou <text:span text:style-name="T2">Free</text:span> (supprime ses modules).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P24">Le texte : pour l’instance sous la souris (ou sélectionnée), son appel complet et le nombre de ses modules.</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc9011_848753940"/><text:bookmark-start text:name="les-modules-readers-writers-et-effects"/>Les modules Readers, Writers et Effects<text:bookmark-end text:name="__RefHeading___Toc9011_848753940"/><text:bookmark-end text:name="les-modules-readers-writers-et-effects"/></text:h>
   <text:p text:style-name="First_20_paragraph">Les modules <text:span text:style-name="T2">Readers</text:span>, <text:span text:style-name="T2">Writers</text:span> et <text:span text:style-name="T2">Effects</text:span> montrent d’un coup d’œil les readers, les writers ou les effets qui existent (jusqu’à 256 de chaque), et permettent de les piloter sans ouvrir leur module. Ils sont les premiers éléments des sous-menus Readers, Writers et Effects du menu des modules.</text:p>
   <text:list text:style-name="L18">
    <text:list-item>
     <text:p text:style-name="P24">Ligne 1 : le nom du module, le nombre d’objets (<text:span text:style-name="T2">Count</text:span>), puis leur nombre par état : <text:span text:style-name="T2">Reading</text:span>, <text:span text:style-name="T2">Paused</text:span>, <text:span text:style-name="T2">Ready</text:span> (Writers : <text:span text:style-name="T2">Writing</text:span>, <text:span text:style-name="T2">Paused</text:span>, <text:span text:style-name="T2">Ready</text:span> ; Effects : <text:span text:style-name="T2">On</text:span>, <text:span text:style-name="T2">Off</text:span>, <text:span text:style-name="T2">Bypass</text:span>). Un clic gauche sur Reading (Writing) met en pause tous ceux qui tournent, sur Paused les relance tous ; pour les effets, sur On : tous Off, sur Off ou sur Bypass : tous On. Readers : <text:span text:style-name="T2">Muted</text:span> et <text:span text:style-name="T2">Solo</text:span> comptent les readers muets et en solo (clic gauche : plus aucun). Dernière cellule : la <text:span text:style-name="T2">page</text:span> (clic gauche : suivante ; clic droit : précédente).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P24">La grille : 8 cellules par ligne, jusqu’à 8 lignes par page ; une cellule par objet, avec son numéro (« R12 », « W5 » ; les effets avec leur type : « E3 Filter »), colorée par son état comme dans son module : <text:span text:style-name="T2">vert</text:span> en marche (Reading, Writing, On), <text:span text:style-name="T2">orange</text:span> en pause (les effets : Off), <text:span text:style-name="T2">bleu clair</text:span> prêt (les effets en bypass : <text:span text:style-name="T2">doré</text:span>), gris s’il n’a ni ligne ni source. Readers : deux petits cercles à droite, mute (rouge) et solo (jaune), pleins quand ils sont actifs ; un anneau rouge : le reader est rendu muet par le solo d’un autre. Effects : un cercle rouge plein à droite signale une erreur (comme « Err: » dans le module Effect).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P24">Clic gauche sur une cellule : le reader ou le writer démarre (s’il est prêt ou en pause) ou se met en pause ; l’effet passe de On à Off, de Off ou Bypass à On. Readers : un clic sur un cercle active ou coupe mute ou solo. <text:span text:style-name="T2">Alt + clic gauche</text:span> : ouvre l’objet dans un module Reader, Writer ou Effect de l’onglet (celui qui le montre déjà, sinon le premier visible ; à défaut un module est ajouté sous le module de synthèse). Clic droit : un menu (les états ; Mute et Solo pour les readers ; <text:span text:style-name="T2">Open in a module</text:span> ; <text:span text:style-name="T2">Open in a new module</text:span>, qui ne prend pas un module montrant un autre objet).</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P24">Le texte : l’objet sous la souris (son état, son mode, sa ligne, l’instance à laquelle il appartient, son erreur), puis une ligne d’aide.</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2677_848753940"/><text:bookmark-start text:name="les-modules-système"/>Les modules système<text:bookmark-end text:name="__RefHeading___Toc2677_848753940"/><text:bookmark-end text:name="les-modules-système"/></text:h>
   <text:p text:style-name="First_20_paragraph">Ces modules sont communs aux plug-ins CMGS.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2679_848753940"/><text:bookmark-start text:name="main-infos"/>Main Infos<text:bookmark-end text:name="__RefHeading___Toc2679_848753940"/><text:bookmark-end text:name="main-infos"/></text:h>
   <text:p text:style-name="First_20_paragraph">L’état général du plug-in : version, mémoire, threads mSL, statistiques.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2681_848753940"/><text:bookmark-start text:name="system-log"/>System Log<text:bookmark-end text:name="__RefHeading___Toc2681_848753940"/><text:bookmark-end text:name="system-log"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le <text:span text:style-name="T2">journal</text:span> du système : messages, résultats des scripts, erreurs (« ERR: NNNN »). Sous la souris :</text:p>
   <table:table table:name="Table16" table:style-name="Table16">
    <table:table-column table:style-name="Table16.A"/>
    <table:table-column table:style-name="Table16.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table16.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Touche</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table16.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Action</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">p</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écrire le journal dans un fichier texte (<text:span text:style-name="Source_5f_Text">syslog-Interstys-date.txt</text:span>, dans le dossier du projet ; GMAuxiliary.eel doit tourner)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">P</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écrire le journal dans la console de GMAuxiliary.eel, <text:span text:style-name="T13">ce qui permet de</text:span> le copier</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">1</text:span> à <text:span text:style-name="Source_5f_Text">8</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre de colonnes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">j</text:span>, <text:span text:style-name="Source_5f_Text">k</text:span>, <text:span text:style-name="Source_5f_Text">↑</text:span>, <text:span text:style-name="Source_5f_Text">↓</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">faire défiler (1 ou 10 lignes)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">→</text:span>, <text:span text:style-name="Source_5f_Text">←</text:span>, <text:span text:style-name="Source_5f_Text">z</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">avancer de 100 lignes, revenir au début</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">m</text:span>, <text:span text:style-name="Source_5f_Text">l</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">augmenter ou réduire la hauteur</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">t</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écrire l’heure</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Entrée</text:span>, <text:span text:style-name="Source_5f_Text">Espace</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table16.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écrire une ligne vide</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Le journal est un anneau d’environ 800 lignes : les plus anciennes sont remplacées.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2683_848753940"/><text:bookmark-start text:name="memory-1-et-memory-2"/>Memory 1 et Memory 2<text:bookmark-end text:name="__RefHeading___Toc2683_848753940"/><text:bookmark-end text:name="memory-1-et-memory-2"/></text:h>
   <text:p text:style-name="First_20_paragraph">Deux inspecteurs de la mémoire (débogage) : ils montrent le contenu de la mémoire à partir d’une adresse, avec les flèches pour se déplacer (Shift : par pages).</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2685_848753940"/><text:bookmark-start text:name="scheduler-et-processes-manager"/>Scheduler et Processes Manager<text:bookmark-end text:name="__RefHeading___Toc2685_848753940"/><text:bookmark-end text:name="scheduler-et-processes-manager"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le <text:span text:style-name="T2">Scheduler</text:span> montre les tâches programmées des scripts mSL ; le <text:span text:style-name="T2">Processes Manager</text:span> montre les threads mSL en cours, avec leur état. La touche <text:span text:style-name="Source_5f_Text">k</text:span> (commande système) arrête tous les threads.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2687_848753940"/><text:bookmark-start text:name="le-clavier"/>Le clavier<text:bookmark-end text:name="__RefHeading___Toc2687_848753940"/><text:bookmark-end text:name="le-clavier"/></text:h>
   <text:p text:style-name="First_20_paragraph">Interstys suit le schéma de clavier commun à CMGS : une touche est d’abord proposée au module sous la souris, puis au panneau, aux commandes de l’onglet, aux commandes du plug-in, enfin aux commandes système. La liste complète est dans <text:span text:style-name="Source_5f_Text">Documents/CMGS-Keys.md</text:span>.</text:p>
   <table:table table:name="Table17" table:style-name="Table17">
    <table:table-column table:style-name="Table17.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table17.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Touche</text:p>
      </table:table-cell>
