      </table:table-cell>
      <table:table-cell table:style-name="Table22.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Sens</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2750</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">un bloc est attendu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2751</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">type de module incorrect après Dump, Check ou Free</text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2752</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">identificateur incorrect (ni numéro, ni nom)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2753</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">clé inconnue</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2754</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">valeur incorrecte ou hors bornes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2755</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">plus de module libre pour un nom</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2756</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le nom désigne un module d’un autre type</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2757</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nom inconnu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2758</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">la nouvelle ligne n’a pas assez de canaux pour un reader</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2759</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Check : une différence</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2762</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">trop de noms</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2763</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">ligne ou writer non défini (aussi le writer de <text:span text:style-name="Source_5f_Text">follow</text:span>)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2764</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">canaux en dehors de la ligne</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2765</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">retard plus long que la ligne</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2766</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">pas assez de mémoire pour le module</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2767</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">la clé n’a pas de sens pour ce type d’effet</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2768</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">l’effet est sa propre source</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2769</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le dossier du projet est inconnu (GMAuxiliary.eel)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2770</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le fichier ne peut pas être ouvert</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2774</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">reader : <text:span text:style-name="Source_5f_Text">mode Delay</text:span> avec une ligne, ou un mode sur une ligne avec un writer</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2775</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">reader : <text:span text:style-name="Source_5f_Text">follow</text:span> désigne un writer qui n’écrit pas la ligne du reader</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2792</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">courbe : identificateur incorrect (ni 1 à 64, ni un nom)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2793</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">trop de courbes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2794</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">courbe : points mal formés (leur nombre, ou des x qui ne vont pas de 0 à 1 en croissant)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2795</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">courbe : un y hors de [0, 1] ou de [−1, 1], selon le type</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2796</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">courbe : nom incorrect</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2797</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">courbe : pas assez de mémoire</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2798</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">export des courbes : texte trop long, rien n’est écrit</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2799</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">courbe : sustain incorrect (seulement pour une enveloppe, numéro de point)</text:p>
     </table:table-cell>
    </table:table-row>
