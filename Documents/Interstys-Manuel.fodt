     </table:table-cell>
     <table:table-cell table:style-name="Table102.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0 à 100 % (50 %)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
