    <table:table-column table:style-name="Table1.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Élément</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Nombre</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table1.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Remarque</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Lignes (mémoires audio)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">256</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">jusqu’à 128 canaux et 67 108 864 échantillons chacune</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Readers (lecteurs)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">256</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">modes Reader, Delay, Stretch, Brage et Grains</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Writers (enregistreurs)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">256</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">une source, un mode de recouvrement</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Effets</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">512</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Mixer, Auto Mixer, LFO, Filter, Saturation, Matrix (réseau de retards bouclés, jusqu’à 128 lignes), Flanger et Chorus (retards modulés, 1 à 16 voix par canal)</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Courbes</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">64</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">enveloppes et formes d’onde, jusqu’à 128 points chacune</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Canaux de la piste</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">256</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">entrées <text:span text:style-name="Source_5f_Text">In</text:span> et sortie <text:span text:style-name="Source_5f_Text">Out</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Bus utilisateur</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">64</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">largeur automatique</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Cellules de contrôle</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">64</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écrites par les 64 curseurs automatisables</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Instances d’algorithmes</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">64</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">et 32 modèles</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Ces nombres sont fixés au début du fichier <text:span text:style-name="Source_5f_Text">Interstys.jsfx</text:span> (<text:span text:style-name="Source_5f_Text">RD_CNT</text:span>, <text:span text:style-name="Source_5f_Text">WR_CNT</text:span>, <text:span text:style-name="Source_5f_Text">LN_CNT</text:span>, <text:span text:style-name="Source_5f_Text">FX_CNT</text:span>, <text:span text:style-name="Source_5f_Text">CH_NB</text:span>, <text:span text:style-name="Source_5f_Text">NB_BUS</text:span>, <text:span text:style-name="Source_5f_Text">NB_CTL</text:span>, <text:span text:style-name="Source_5f_Text">NB_GSL</text:span>). La mémoire du plug-in est de 128 millions de mots (<text:span text:style-name="Source_5f_Text">options:maxmem</text:span>) : une ligne de 10 s en 8 canaux à 48 kHz en occupe environ 3,8 millions.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2607_848753940"/><text:bookmark-start text:name="installation"/><text:soft-page-break/>Installation<text:bookmark-end text:name="__RefHeading___Toc2607_848753940"/><text:bookmark-end text:name="installation"/></text:h>
   <text:p text:style-name="First_20_paragraph">Interstys fonctionne avec <text:span text:style-name="T2">REAPER 7.25 ou plus récent</text:span>. Les fichiers <text:span text:style-name="Source_5f_Text">Interstys.jsfx</text:span> et le dossier <text:span text:style-name="Source_5f_Text">GM-Libs/</text:span> doivent se trouver dans le dossier <text:span text:style-name="Source_5f_Text">Effects/</text:span> de REAPER (dans la distribution CMGS, sous <text:span text:style-name="Source_5f_Text">Effects/CMGS/GameMaster/</text:span>). Le plug-in apparaît dans la liste des effets sous le nom <text:span text:style-name="T2">Interstys modular fractional delay</text:span>.</text:p>
   <text:p text:style-name="Text_20_body">Le script ReaScript <text:span text:style-name="Source_5f_Text">GMAuxiliary.eel</text:span>, s’il est lancé, rend deux services : il écrit le journal dans un fichier texte (touche <text:span text:style-name="Source_5f_Text">p</text:span>) et il donne à Interstys le dossier du projet, qui sert aux noms de fichiers relatifs des scripts.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2609_848753940"/><text:bookmark-start text:name="sauvegarde"/>Sauvegarde<text:bookmark-end text:name="__RefHeading___Toc2609_848753940"/><text:bookmark-end text:name="sauvegarde"/></text:h>
   <text:p text:style-name="First_20_paragraph">Tout ce qui est créé dans Interstys est sauvé avec le projet REAPER (ou un preset) :</text:p>
   <text:list text:style-name="L2">
    <text:list-item>
     <text:p text:style-name="P6">les lignes, readers, writers et effets, avec tous leurs réglages ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P6">l’organisation de la fenêtre (onglets, panneaux, modules affichés) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P6">les noms des fichiers son lus dans les lignes ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P6">les modèles et les instances d’algorithmes.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph"><text:span text:style-name="T2">Le contenu sonore des lignes n’est pas sauvé.</text:span> À l’ouverture du projet, chaque ligne qui avait été remplie par un fichier son relit ce fichier automatiquement ; le journal l’indique par « Lines : n file(s) read again, m error(s) ». Une ligne enregistrée par un writer revient vide.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2611_848753940"/><text:bookmark-start text:name="principes"/>Principes<text:bookmark-end text:name="__RefHeading___Toc2611_848753940"/><text:bookmark-end text:name="principes"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2613_848753940"/><text:bookmark-start text:name="les-cellules-et-les-câbles"/>Les cellules et les câbles<text:bookmark-end text:name="__RefHeading___Toc2613_848753940"/><text:bookmark-end text:name="les-cellules-et-les-câbles"/></text:h>
   <text:p text:style-name="First_20_paragraph">Toutes les données audio et de contrôle circulent dans un tableau de <text:span text:style-name="T2">cellules</text:span>. À chaque échantillon, chaque module lit des cellules et en écrit d’autres. Les cellules sont groupées ainsi :</text:p>
   <table:table table:name="Table2" table:style-name="Table2">
    <table:table-column table:style-name="Table2.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table2.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Groupe</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table2.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Notation</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table2.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Rôle</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Entrées</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">In:c</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">les canaux de la piste, lus au début de chaque échantillon</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Sortie</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Out:c</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le bus de sortie, rendu à la piste à la fin de l’échantillon</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Bus</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Bus n:c</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">64 bus utilisateur, numérotés à partir de 1</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Contrôles</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Ctl n</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">64 cellules de contrôle, numérotées à partir de 1</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Câbles propres</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Reader n:c</text:span>, <text:span text:style-name="Source_5f_Text">Effect n:c</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">la sortie d’un reader ou d’un effet</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Zéro</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table2.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">cellules toujours nulles : une entrée non branchée les lit</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Les canaux (<text:span text:style-name="Source_5f_Text">c</text:span>) sont numérotés <text:span text:style-name="T2">à partir de 0</text:span>, les modules, bus et contrôles <text:span text:style-name="T2">à partir de 1</text:span>, comme dans les pads. Un câble de plusieurs canaux est désigné par son premier canal : un effet de 2 canaux dont la source est <text:span text:style-name="Source_5f_Text">In:0</text:span> lit <text:span text:style-name="Source_5f_Text">In:0</text:span> et <text:span text:style-name="Source_5f_Text">In:1</text:span>.</text:p>
   <text:p text:style-name="Text_20_body">Deux règles, empruntées aux synthétiseurs modulaires :</text:p>
   <text:list text:style-name="L3">
    <text:list-item>
     <text:p text:style-name="P7"><text:span text:style-name="T2">un câble a une seule source.</text:span> Le câble propre d’un reader ou d’un effet n’est écrit que par lui ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P7"><text:span text:style-name="T2">les bus et </text:span><text:span text:style-name="Source_5f_Text">Out</text:span><text:span text:style-name="T2"> additionnent</text:span> toutes les sorties qui y sont envoyées. Ils sont remis à zéro à chaque échantillon. La largeur d’un bus est calculée automatiquement : c’est le plus grand « premier canal + nombre de canaux » demandé par ses utilisateurs.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Une sortie (d’un reader ou d’un effet) va soit dans son <text:span text:style-name="T2">câble propre</text:span> (« Own cable », la valeur par défaut), soit dans <text:span text:style-name="Source_5f_Text">Out</text:span>, soit dans un bus. Une source peut être <text:span text:style-name="Source_5f_Text">In</text:span>, <text:span text:style-name="Source_5f_Text">Out</text:span>, un bus, une cellule de contrôle, ou le câble propre d’un reader ou d’un effet.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2615_848753940"/><text:bookmark-start text:name="lordre-de-traitement"/>L’ordre de traitement<text:bookmark-end text:name="__RefHeading___Toc2615_848753940"/><text:bookmark-end text:name="lordre-de-traitement"/></text:h>
   <text:p text:style-name="First_20_paragraph">À chaque échantillon, Interstys exécute dans cet ordre :</text:p>
   <text:list text:style-name="L4">
    <text:list-item>
     <text:p text:style-name="P8">la lecture des entrées de la piste (<text:span text:style-name="Source_5f_Text">In</text:span>, multipliées par le gain d’entrée) ; <text:span text:style-name="Source_5f_Text">Out</text:span> et les bus sont remis à zéro ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P8">les effets de la phase <text:span text:style-name="T2">Pre</text:span> (avant les readers) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P8">les <text:span text:style-name="T2">readers</text:span> ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P8">les effets de la phase <text:span text:style-name="T2">Std</text:span> (phase standard) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P8">les <text:span text:style-name="T2">writers</text:span> ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P8">les effets de la phase <text:span text:style-name="T2">Post</text:span> (après les writers) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P8">l’écriture de <text:span text:style-name="Source_5f_Text">Out</text:span> dans la piste (multiplié par le volume de sortie).</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Dans chaque phase, les effets sont exécutés <text:span text:style-name="T2">dans l’ordre des câbles</text:span> : un effet passe après les effets dont il lit la sortie (câble propre, bus ou <text:span text:style-name="Source_5f_Text">Out</text:span>). Interstys calcule cet ordre lui-même chaque fois que le patch change. Les effets indépendants gardent l’ordre de leurs numéros. <text:soft-page-break/>Une boucle de rétroaction (un effet A lit B qui lit A) garde aussi l’ordre des numéros : le câble qui « remonte » la chaîne a un retard d’un échantillon.</text:p>
   <text:p text:style-name="Text_20_body">Pour les autres modules, un câble lu par un module placé plus loin dans cet ordre n’a pas de retard ; un câble lu par un module placé avant a un retard d’un échantillon.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2617_848753940"/><text:bookmark-start text:name="les-entrées-de-modulation"/>Les entrées de modulation<text:bookmark-end text:name="__RefHeading___Toc2617_848753940"/><text:bookmark-end text:name="les-entrées-de-modulation"/></text:h>
   <text:p text:style-name="First_20_paragraph">Certains réglages peuvent être modulés par un câble : la vitesse et le volume d’un reader, le gain d’un writer, la fréquence de coupure d’un filtre, etc. Une entrée de modulation a :</text:p>
   <text:list text:style-name="L5">
    <text:list-item>
     <text:p text:style-name="P9">une <text:span text:style-name="T2">source</text:span> (un câble, souvent un LFO ou une cellule de contrôle) et son canal ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9">une <text:span text:style-name="T2">profondeur</text:span> (<text:span text:style-name="T1">depth</text:span>), dans l’unité du réglage (octaves, dB, ms…) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9">un <text:span text:style-name="T2">atténuverteur</text:span> (<text:span text:style-name="T1">att</text:span>), entre −10 et 10 (1 à la connexion) : il multiplie la profondeur, et l’inverse s’il est négatif.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">La valeur effective suit la <text:span text:style-name="T2">loi</text:span> de l’entrée. Avec u = atténuverteur × valeur du câble, son <text:span text:style-name="T2">action</text:span> donne : <text:span text:style-name="T1">Add</text:span> réglage + profondeur × u ; <text:span text:style-name="T1">Scale</text:span> réglage × (1 + profondeur × u) ; <text:span text:style-name="T1">Octaves</text:span> réglage × 2^(profondeur × u) ; <text:span text:style-name="T1">Decibels</text:span> réglage × 10^(profondeur × u / 20). Chaque entrée a une action par défaut (Add pour la vitesse d’un reader, Scale pour son volume, Octaves pour la coupure d’un filtre, Decibels pour le gain d’un writer…) et ne propose que les actions qui ont un sens pour elle. Une entrée non branchée ne change rien, comme un jack normalisé. Une cellule de contrôle est lissée pour éviter les clics.</text:p>
   <text:p text:style-name="Text_20_body">Avant l’action, u peut passer par une <text:span text:style-name="T2">forme</text:span> : linéaire, Exp (u × |u|, plus fine près de 0), Log (plus vive près de 0), ou une courbe du module Curves (sa partie dessinée couvre la course du contrôle). En <text:span text:style-name="T2">unipolaire</text:span>, u va de 0 à 1 ((u + 1) / 2) : un curseur Ctl agit alors comme un fader, du réglage de base vers le réglage + profondeur. Alt + clic droit sur la cellule de l’entrée ouvre le menu de la loi (action, forme, courbe, polarité, bypass, curseurs affichés, loi par défaut) ; un clic gauche met l’entrée en <text:span text:style-name="T2">bypass</text:span> (le réglage sans sa modulation, « (off) » en orange), pour comparer avec et sans modulation. La cellule montre la loi quand elle n’est pas celle par défaut (« Speed: Ctl 50 oct exp »). Le décalage d’un reader en mode délai suit sa modulation par fondus enchaînés de 10 ms, comme son curseur : sans changement de hauteur ni craquement, même avec un contrôle qui avance par paliers (souris, automation, MIDI). L’élément <text:span text:style-name="T2">Doppler</text:span> du menu de la loi le rend continu : la hauteur varie avec le retard (vibrato, chorus, flanger avec un LFO). Dans les modes sur une ligne, l’entrée Offset recule la lecture de la valeur de sa modulation (en ms, sans réglage de base : l’action Add) : en mode Reader, la tête saute par fondus enchaînés, dans sa boucle si elle y est, sinon dans la ligne (Doppler : elle se déplace en continu) ; en Stretch, la progression des blocs saute ; en Brage et en Grains, les segments et les grains partent plus tôt. Un Ctl ou un LFO balaie ainsi la position de lecture.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2619_848753940"/><text:bookmark-start text:name="le-traitement-des-échantillons-de-la-piste"/>Le traitement des échantillons de la piste<text:bookmark-end text:name="__RefHeading___Toc2619_848753940"/><text:bookmark-end text:name="le-traitement-des-échantillons-de-la-piste"/></text:h>
   <text:p text:style-name="First_20_paragraph">Le module <text:span text:style-name="T2">Globals</text:span> choisit ce que fait Interstys du son de la piste (« Track Samples ») :</text:p>
   <table:table table:name="Table3" table:style-name="Table3">
    <table:table-column table:style-name="Table3.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table3.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Mode</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table3.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Entrées <text:span text:style-name="Source_5f_Text">In</text:span></text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table3.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Sortie de la piste</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="P10">Merge</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le son de la piste, multiplié par le gain d’entrée</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Out</text:span>, multiplié par le volume de sortie</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="P10">Ignore</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">muettes (le son de la piste n’est pas lu)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">Out</text:span>, multiplié par le volume de sortie</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="P10">Pass</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table3.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">le son de la piste, inchangé : Interstys ne traite rien</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph"><text:soft-page-break/>Dans les modes Merge et Ignore, la piste ne contient que ce qu’Interstys écrit dans <text:span text:style-name="Source_5f_Text">Out</text:span> : pour entendre aussi le son direct, il faut l’envoyer dans <text:span text:style-name="Source_5f_Text">Out</text:span> (par exemple par un Mixer dont une source est <text:span text:style-name="Source_5f_Text">In:0</text:span>).</text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="T2">Attention :</text:span> en mode Ignore, toute la chaîne qui part de <text:span text:style-name="Source_5f_Text">In</text:span> est muette.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2621_848753940"/><text:bookmark-start text:name="linterface"/>L’interface<text:bookmark-end text:name="__RefHeading___Toc2621_848753940"/><text:bookmark-end text:name="linterface"/></text:h>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2623_848753940"/><text:bookmark-start text:name="onglets-panneaux-et-modules"/>Onglets, panneaux et modules<text:bookmark-end text:name="__RefHeading___Toc2623_848753940"/><text:bookmark-end text:name="onglets-panneaux-et-modules"/></text:h>
   <text:p text:style-name="First_20_paragraph">La fenêtre d’Interstys <text:span text:style-name="T3">est modifiable en hauteur et en largeur à tout moment. Elle </text:span>est organisée en <text:span text:style-name="T2">onglets</text:span> (<text:span text:style-name="T3">dont la liste est affichée </text:span>en haut <text:span text:style-name="T3">de la fenêtre</text:span>). Chaque onglet contient de 1 à 4 <text:span text:style-name="T2">panneaux</text:span> (colonnes), et chaque panneau une pile de <text:span text:style-name="T2">modules</text:span>. Le menu <text:span text:style-name="T4">(shift-</text:span>clic droit<text:span text:style-name="T4">)</text:span> <text:span text:style-name="T4">d</text:span>es panneaux permet de :</text:p>
   <text:list text:style-name="L6">
    <text:list-item>
     <text:p text:style-name="P11">choisir les modules affichés (sous-menu <text:span text:style-name="T2">Modules</text:span>) : les cinq premiers groupes donnent huit vues des lignes (Line A à H), des readers et des writers, seize vues des effets (Effect A à P) et huit vues des courbes (Curves A à H) ; viennent ensuite les autres modules, par ordre alphabétique ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P11">déplacer, copier et coller un module ou un panneau, changer le nombre de panneaux, <text:span text:style-name="T3">leurs largeurs,</text:span> remettre <text:span text:style-name="T3">c</text:span>es largeurs à <text:span text:style-name="T3">une valeur par défaut</text:span>, vider un panneau ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P11">renommer un onglet, décaler les onglets ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P11">choisir un thème de couleurs, <text:span text:style-name="T3">ainsi qu’une taille</text:span> et un style d’affichage.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Les vues d’un même type (A à H ; A à P pour les effets) sont indépendantes : chacune montre le module de son choix (par exemple, Reader A montre le reader 1 et Reader B le reader 12). Le numéro montré par chaque vue est sauvé avec le projet. <text:span text:style-name="T3">La même vue peut être utilisée dans différents onglets et panneaux.</text:span></text:p>
   <text:p text:style-name="Text_20_body"><text:span text:style-name="Source_5f_Text">Tab</text:span> et <text:span text:style-name="Source_5f_Text">Shift+Tab</text:span> passent à l’onglet suivant ou précédent. <text:span text:style-name="Source_5f_Text">Shift+←</text:span> et <text:span text:style-name="Source_5f_Text">Shift+→</text:span> changent la largeur des panneaux sous la souris.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2625_848753940"/><text:bookmark-start text:name="les-pads"/>Les pads<text:bookmark-end text:name="__RefHeading___Toc2625_848753940"/><text:bookmark-end text:name="les-pads"/></text:h>
   <text:p text:style-name="First_20_paragraph">La plupart des modules présentent un <text:span text:style-name="T2">pad</text:span> : une grille de cellules (8 par ligne, <text:span text:style-name="T3">avec une ou plusieurs lignes</text:span>). Chaque cellule affiche une information et réagit à la souris :</text:p>
   <text:list text:style-name="L7">
    <text:list-item>
     <text:p text:style-name="P12"><text:span text:style-name="T2">clic gauche</text:span> : l’action la plus courante (élément suivant, marche/pause, choix du canal…) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P12"><text:span text:style-name="T2">Shift + clic gauche</text:span> : souvent l’action inverse (élément précédent) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P12"><text:span text:style-name="T2">clic droit</text:span> : un menu (choix d’une source, d’un mode, d’une action…).</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">La cellule 0 de chaque pad donne le numéro du module affiché : un clic gauche passe au suivant, Shift + clic gauche au précédent, un clic droit ouvre la liste. Si le module appartient à une instance d’algorithme, son nom est ajouté : « Reader 4 (e1) ».</text:p>
   <text:p text:style-name="Text_20_body">La dernière cellule de la première ligne, <text:span text:style-name="T2">Action</text:span>, ouvre au clic droit le menu des actions du module (Copy, Paste, Clear, Create, Show, Delete…). <text:span text:style-name="T2">Show</text:span> et la touche « <text:span text:style-name="Source_5f_Text">d</text:span><text:span text:style-name="T3"> »</text:span> écrivent le contenu brut du module dans le journal.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2627_848753940"/><text:bookmark-start text:name="les-curseurs"/>Les curseurs<text:bookmark-end text:name="__RefHeading___Toc2627_848753940"/><text:bookmark-end text:name="les-curseurs"/></text:h>
   <text:p text:style-name="First_20_paragraph">Sous le pad, les <text:span text:style-name="T2">curseurs</text:span> règlent les valeurs continues du module affiché. Un clic droit sur un curseur lui rend sa valeur par défaut. <text:span text:style-name="T3">Un clic gauche ouvre une fenêtre pour l’édition précise de sa valeur. </text:span>Les curseurs des entrées de modulation (profondeur, atténuverteur) n’apparaissent que si l’entrée est branchée : la profondeur seule à la connexion ; le menu de la loi (Alt + clic droit sur la cellule de l’entrée) choisit « aucun curseur », la « profondeur seule », ou la « profondeur et l’atténuverteur ». Dans un reader et un writer, ces curseurs sont <text:span text:style-name="T5">placés </text:span>juste sous la ligne des entrées, avant la forme d’onde ; la profondeur prend l’unité de l’action choisie.</text:p>
   <text:p text:style-name="Text_20_body">Les curseurs génériques <text:span text:style-name="Source_5f_Text">Ctl 1</text:span> à <text:span text:style-name="Source_5f_Text">Ctl 64</text:span> sont masqués dans le panneau de curseurs de <text:soft-page-break/>REAPER (en haut de la fenêtre de l’effet) : la touche <text:span text:style-name="Source_5f_Text">S</text:span> les montre ou les cache. Tous les réglages se font dans les modules.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2629_848753940"/><text:bookmark-start text:name="les-formes-donde"/>Les formes d’onde<text:bookmark-end text:name="__RefHeading___Toc2629_848753940"/><text:bookmark-end text:name="les-formes-donde"/></text:h>
   <text:p text:style-name="First_20_paragraph">Les modules Line, Reader et Writer montrent la forme d’onde de leur ligne, avec la position des têtes de lecture et d’écriture. Sous la souris :</text:p>
   <table:table table:name="Table4" table:style-name="Table4">
    <table:table-column table:style-name="Table4.A"/>
    <table:table-column table:style-name="Table4.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table4.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Touche</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table4.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Action</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">w</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">montrer ou cacher la forme d’onde</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">+</text:span>, <text:span text:style-name="Source_5f_Text">=</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">agrandir la forme d’onde</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">-</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">la réduire</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents"><text:span text:style-name="Source_5f_Text">v</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table4.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">superposer les canaux ou les séparer</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Le curseur <text:span text:style-name="T2">Zoom</text:span> du reader agrandit la forme d’onde horizontalement autour de la position de lecture.</text:p>
   <text:p text:style-name="Text_20_body">Dans le module Reader, la souris agit aussi sur la forme d’onde :</text:p>
   <text:list text:style-name="L8">
    <text:list-item>
     <text:p text:style-name="P13">un <text:span text:style-name="T2">clic gauche</text:span> amène la position de lecture à l’endroit cliqué, au relâchement du bouton (modes Reader et Stretch ; en pause, tout de suite) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">un <text:span text:style-name="T2">glissé</text:span> depuis une limite de la boucle (ou depuis sa marge de fondu) déplace cette limite ; passée l’autre limite, elles s’échangent, comme avec les curseurs ; la boucle garde au moins deux fondus ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13"><text:span text:style-name="T2">Alt + glissé</text:span> dans la boucle déplace la boucle, sa longueur gardée ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13"><text:span text:style-name="T2">Shift + clic</text:span> <text:span text:style-name="T5">agrandit</text:span> la boucle à toute la <text:span text:style-name="T5">longueur de la </text:span>ligne.</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Text_20_body">Pendant un glissé, la portion affichée ne bouge pas, et la souris peut sortir de la forme d’onde, et même de la fenêtre du plug-in : la limite ou la boucle continue de la suivre, à la même échelle, jusqu’aux bouts de la ligne ; quand la boucle traverse la fin de la ligne (voir « Les types de boucle »), elle suit la souris modulo la taille de la ligne. Quand la boucle suit un writer <text:span text:style-name="T5">pour fonctionner en mode « delay »</text:span>, ses limites ne se règlent pas à la souris : seul le clic déplace la lecture.</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2631_848753940"/><text:bookmark-start text:name="le-module-line"/>Le module Line<text:bookmark-end text:name="__RefHeading___Toc2631_848753940"/><text:bookmark-end text:name="le-module-line"/></text:h>
   <text:p text:style-name="First_20_paragraph">Une <text:span text:style-name="T2">ligne</text:span> est une mémoire audio : un tampon circulaire de un à 128 canaux. Les writers y enregistrent, les readers la lisent. Une ligne peut aussi être remplie par un fichier son.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2633_848753940"/><text:bookmark-start text:name="le-pad"/>Le pad<text:bookmark-end text:name="__RefHeading___Toc2633_848753940"/><text:bookmark-end text:name="le-pad"/></text:h>
   <table:table table:name="Table5" table:style-name="Table5">
    <table:table-column table:style-name="Table5.A" table:number-columns-repeated="3"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table5.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Cellule</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table5.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Contenu</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table5.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Souris</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Line <text:span text:style-name="T1">n</text:span> (et son instance)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gauche : suivante ; droit : liste</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">1</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">état : Undefined ou Ready</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit, ligne absente : Create</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">durée (s)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">3</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre d’échantillons</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">4</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">nombre de canaux</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit, ligne absente : le nombre de canaux à créer</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">5</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">fréquence d’enregistrement (Hz)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">6</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">erreur 2610 si la mémoire a manqué</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">—</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">7</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Action</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table5.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">droit : Clear, Create, Delete</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="First_20_paragraph">Pour créer une ligne : choisir sa durée (curseur <text:span text:style-name="T2">Line size</text:span>, Shift pour des secondes entières) et son nombre de canaux (cellule 4), puis <text:span text:style-name="T2">Create</text:span> (cellule 1 ou Action). Une ligne existante ne change pas de taille : il faut la supprimer (Delete) et la recréer. <text:span text:style-name="T2">Clear</text:span> remet son contenu à zéro.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2635_848753940"/><text:bookmark-start text:name="le-fichier-de-la-ligne"/>Le fichier de la ligne<text:bookmark-end text:name="__RefHeading___Toc2635_848753940"/><text:bookmark-end text:name="le-fichier-de-la-ligne"/></text:h>
   <text:p text:style-name="First_20_paragraph">Sous le pad, une cellule occupant toute la largeur montre le <text:span text:style-name="T2">fichier son</text:span> de la ligne (son nom, sans le dossier), ou « No file ».</text:p>
   <text:list text:style-name="L9">
    <text:list-item>
     <text:p text:style-name="P14"><text:span text:style-name="T2">Déposer un fichier son</text:span> (WAV, AIFF, FLAC, MP3, OGG) sur cette cellule le lit <text:span text:style-name="T2">dans cette ligne</text:span> : la ligne est créée, ou remplacée si sa durée ou son nombre de canaux diffèrent ; ses readers et ses writers la suivent. La fréquence du fichier est conservée (cellule 5) : les readers la compensent.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P14"><text:span text:style-name="T2">Clic gauche</text:span> : le chemin complet s’affiche pendant 20 secondes ; un deuxième clic <text:span text:style-name="T5">affiche</text:span> le nom <text:span text:style-name="T5">seul, sans son chemin complet</text:span>.</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P14"><text:span text:style-name="T2">Clic droit</text:span> : un menu : <text:span text:style-name="T2">Reload</text:span> (relire le fichier), <text:span text:style-name="T2">Forget the name</text:span> (oublier le nom sans toucher au son), <text:span text:style-name="T2">Path in the log</text:span> (écrire le chemin dans le journal).</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="First_20_paragraph">Un fichier déposé ailleurs dans le module est lu dans la ligne affichée si elle a la bonne taille, et sinon dans une nouvelle ligne.</text:p>
   <text:p text:style-name="Text_20_body">Le nom du fichier est effacé quand la ligne est supprimée, remise à zéro (Clear) ou remplacée. Il est sauvé avec le projet : à l’ouverture, la ligne relit son fichier. Si le fichier a disparu, le journal l’indique (erreur 2771) et la ligne garde le nom : il suffit de remettre le fichier en place et de faire <text:span text:style-name="T2">Reload</text:span>, <text:span text:style-name="T5">ou d’exécuter un nouveau glisser/déposer.</text:span></text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc2637_848753940"/><text:bookmark-start text:name="le-module-reader"/>Le module Reader<text:bookmark-end text:name="__RefHeading___Toc2637_848753940"/><text:bookmark-end text:name="le-module-reader"/></text:h>
   <text:p text:style-name="First_20_paragraph">Un <text:span text:style-name="T2">reader</text:span> lit une ligne et envoie le son lu vers une sortie. Il a cinq modes :</text:p>
   <text:list text:style-name="L8">
    <text:list-item>
     <text:p text:style-name="P13"><text:span text:style-name="T2">Reader</text:span> (mode lecture) : il parcourt la ligne à une <text:span text:style-name="T2">vitesse</text:span> quelconque (négative pour lire à l’envers), en boucle ou non, éventuellement sur une <text:span text:style-name="T2">région</text:span> ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13"><text:span text:style-name="T2">Delay</text:span> (mode délai) : il suit un <text:span text:style-name="T2">writer</text:span> avec un <text:span text:style-name="T2">retard</text:span> fixe ou modulé, pour faire des échos et des délais ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13"><text:span text:style-name="T2">Stretch</text:span> : il lit la ligne par blocs qui se recouvrent, pour changer la durée sans changer la hauteur (ou la hauteur sans changer la durée) ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13"><text:span text:style-name="T2">Brage</text:span> (brassage) : il lit des segments tirés au hasard dans la boucle, <text:span text:style-name="T5">en créant un flot audio continu</text:span> ;</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13"><text:span text:style-name="T2">Grains</text:span> : il joue des grains tirés au hasard dans la boucle (synthèse granulaire).</text:p>
    </text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc2639_848753940"/><text:bookmark-start text:name="le-pad-1"/>Le pad<text:bookmark-end text:name="__RefHeading___Toc2639_848753940"/><text:bookmark-end text:name="le-pad-1"/></text:h>
