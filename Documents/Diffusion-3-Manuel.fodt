     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">onglet suivant, précédent</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Shift+←, Shift+→</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">panneau</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">largeur des panneaux</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">S</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">plug-in</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">montrer ou cacher les curseurs natifs dans le panneau de REAPER</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">h</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">Space 3D</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">gains et niveaux en boules, ou en croix et halos</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">g, c, t, z, p…</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écran Live</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">voir « L’écran Live »</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">p</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">System Log</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">écrire le journal dans un fichier texte</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="Heading_20_1" text:outline-level="1"><text:bookmark-start text:name="__RefHeading___Toc1705_812396808"/><text:bookmark-start text:name="les-codes-derreur"/>Les codes d’erreur<text:bookmark-end text:name="__RefHeading___Toc1705_812396808"/><text:bookmark-end text:name="les-codes-derreur"/></text:h>
   <text:p text:style-name="First_20_paragraph">L’indicateur d’erreur apparaît dans la cellule Error du module Global (un clic gauche l’efface) ; les messages détaillés sont écrits dans le journal (module System Log).</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2"><text:bookmark-start text:name="__RefHeading___Toc1707_812396808"/><text:bookmark-start text:name="le-chargement-dun-fichier"/>Le chargement d’un fichier<text:bookmark-end text:name="__RefHeading___Toc1707_812396808"/><text:bookmark-end text:name="le-chargement-dun-fichier"/></text:h>
   <table:table table:name="Table11" table:style-name="Table11">
    <table:table-column table:style-name="Table11.A"/>
    <table:table-column table:style-name="Table11.B"/>
    <table:table-header-rows>
     <table:table-row>
      <table:table-cell table:style-name="Table11.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Code</text:p>
      </table:table-cell>
      <table:table-cell table:style-name="Table11.A1" office:value-type="string">
       <text:p text:style-name="Table_20_Heading">Sens</text:p>
      </table:table-cell>
     </table:table-row>
    </table:table-header-rows>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0100</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">numéro de fichier de configuration inconnu</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">0101</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">fichier de configuration non trouvé</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Table11.A1" office:value-type="string">
      <text:p text:style-name="Table_20_Contents">2407</text:p>
     </table:table-cell>
